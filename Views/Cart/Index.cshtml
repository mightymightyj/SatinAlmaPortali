@section Scripts {
    <script src="~/js/trendyol-vitrin.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            renderFullCartPage();
        });

        function renderFullCartPage() {
            const cart = getB2BCart();
            const emptyEl = document.getElementById('cartEmptyState');
            const contentEl = document.getElementById('cartContentGrid');
            const itemsContainer = document.getElementById('cartPageItemsTable');
            const headerCount = document.getElementById('cartTotalItemsHeader');

            if (!cart || cart.length === 0) {
                if (emptyEl) emptyEl.style.display = 'block';
                if (contentEl) contentEl.style.display = 'none';
                return;
            }

            if (emptyEl) emptyEl.style.display = 'none';
            if (contentEl) contentEl.style.display = 'grid';

            const totals = getCartTotals();
            if (headerCount) headerCount.textContent = `Sepetteki Kalemler (${totals.uniqueItemCount} Kalem / ${totals.totalCount} Adet)`;

            document.getElementById('cartSummarySubtotal').textContent = formatB2BMoney(totals.subtotal);
            document.getElementById('cartSummaryTax').textContent = formatB2BMoney(totals.tax);
            document.getElementById('cartSummaryGrandTotal').textContent = formatB2BMoney(totals.grandTotal);

            let html = '';
            cart.forEach(item => {
                const lineTotal = item.price * item.quantity;
                html += `
                    <div style="padding: 16px 20px; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
                        <img src="${item.image}" alt="${item.title}" style="width: 72px; height: 72px; object-fit: cover; border-radius: 8px; border: 1px solid #e2e8f0;" onerror="this.src='https://images.unsplash.com/photo-1581092160607-ee22621dd758?w=100&auto=format&fit=crop&q=80'" />
                        
                        <div style="flex: 1; min-width: 220px;">
                            <span style="font-size: 0.74rem; font-weight: 700; color: #0284c7; background: #e0f2fe; padding: 2px 8px; border-radius: 4px;">
                                ${item.seller || 'Onaylı Tedarikçi'}
                            </span>
                            <h4 style="font-size: 0.95rem; font-weight: 750; color: #0f172a; margin: 6px 0 3px 0;">
                                ${item.title}
                            </h4>
                            <div style="font-size: 0.78rem; color: #64748b;">
                                SKU: <code>${item.sku || 'SKU-000'}</code> | Kategori: <strong>${item.category || 'Endüstriyel'}</strong>
                            </div>
                        </div>

                        <div style="text-align: right; min-width: 110px;">
                            <div style="font-size: 0.92rem; font-weight: 700; color: #0f172a;">${formatB2BMoney(item.price)}</div>
                            <div style="font-size: 0.72rem; color: #64748b;">Birim Fiyat (+KDV)</div>
                        </div>

                        <div style="display: flex; align-items: center; border: 1px solid #cbd5e1; border-radius: 6px; overflow: hidden; background: #f8fafc;">
                            <button type="button" onclick="updateCartPageQty(${item.productId}, ${item.quantity - 1})" style="background: transparent; border: none; padding: 6px 12px; font-weight: 700; cursor: pointer; color: #0f172a;">-</button>
                            <span style="padding: 6px 12px; font-size: 0.88rem; font-weight: 800; min-width: 36px; text-align: center; background: #fff;">${item.quantity}</span>
                            <button type="button" onclick="updateCartPageQty(${item.productId}, ${item.quantity + 1})" style="background: transparent; border: none; padding: 6px 12px; font-weight: 700; cursor: pointer; color: #0f172a;">+</button>
                        </div>

                        <div style="text-align: right; min-width: 120px;">
                            <div style="font-size: 1.05rem; font-weight: 800; color: #0284c7;">${formatB2BMoney(lineTotal)}</div>
                            <div style="font-size: 0.72rem; color: #64748b;">Ara Toplam</div>
                        </div>

                        <div>
                            <button type="button" onclick="removeCartPageItem(${item.productId})" style="background: transparent; border: none; color: #ef4444; font-size: 1.1rem; cursor: pointer; padding: 6px;" title="Ürünü Sepetten Çıkar">
                                🗑️
                            </button>
                        </div>
                    </div>
                `;
            });

            if (itemsContainer) itemsContainer.innerHTML = html;
        }

        function updateCartPageQty(productId, newQty) {
            updateCartQty(productId, newQty);
            renderFullCartPage();
        }

        function removeCartPageItem(productId) {
            removeFromCart(productId);
            renderFullCartPage();
        }
    </script>
}
