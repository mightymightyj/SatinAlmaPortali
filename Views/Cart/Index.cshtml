                    <label class="block text-[11px] font-bold text-slate-700 mb-1">Teslimat Hızı</label>
                    <input type="number" id="successRateDelivery" class="w-full px-2.5 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-lg text-center font-bold text-slate-900" value="10" min="1" max="10" step="0.5" />
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-slate-700 mb-1">Ürün Kalitesi</label>
                    <input type="number" id="successRateQuality" class="w-full px-2.5 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-lg text-center font-bold text-slate-900" value="10" min="1" max="10" step="0.5" />
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-slate-700 mb-1">İletişim / Süreç</label>
                    <input type="number" id="successRateComm" class="w-full px-2.5 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-lg text-center font-bold text-slate-900" value="10" min="1" max="10" step="0.5" />
                </div>
            </div>

            <!-- Yorum -->
