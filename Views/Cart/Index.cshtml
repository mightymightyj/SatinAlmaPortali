@model satinalmaportali2.Models.CheckoutProfileDto
@{
    ViewData["Title"] = "Kurumsal Satınalma Sepetim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <!-- Tailwind CSS (Play CDN) & Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e',
                            950: '#082f49',
                        }
                    }
                }
            }
        };
    </script>
    <style>
        html {
            scroll-behavior: smooth;
        }

        .b2b-checkout-overlay {
            position: fixed;
            inset: 0;
            background-color: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(6px);
            z-index: 99999;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .b2b-checkout-overlay.show,
        .b2b-checkout-overlay.is-open {
            display: flex !important;
        }

        .b2b-paymethod-card.is-selected {
            border-color: #2563eb !important;
            background-color: #eff6ff !important;
            box-shadow: 0 0 0 1.5px #2563eb !important;
        }

        .btn-star-pick-success {
            background: none;
            border: none;
            cursor: pointer;
            padding: 2px;
            transition: transform 0.15s ease;
        }
        .btn-star-pick-success:hover {
            transform: scale(1.25);
        }
    </style>
}

<div class="font-sans antialiased bg-slate-50 text-slate-800 selection:bg-blue-500 selection:text-white min-h-screen pb-24 sm:pb-28 lg:pb-12">

    <!-- ==================== BÖLÜM 1: HERO HEADER ==================== -->
    <section class="relative overflow-hidden bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 text-white pt-10 pb-12 sm:pt-12 sm:pb-14 px-4 sm:px-6 lg:px-8 border-b border-slate-800/80">
        <!-- Radial Glow Efekti -->
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(37,99,235,0.25),rgba(255,255,255,0))] pointer-events-none"></div>

        <div class="relative max-w-7xl mx-auto">
            <!-- Breadcrumb Navigasyonu -->
            <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-400 mb-4 flex-wrap" aria-label="Breadcrumb">
                <a href="/" class="hover:text-blue-400 transition-colors flex items-center gap-1.5">
                    <i class="fa-solid fa-house text-xs"></i>
                    <span>Ana Sayfa</span>
                </a>
                <span class="text-slate-600">/</span>
                <a href="/#ihtiyaciniz-olan-urunler" class="hover:text-blue-400 transition-colors">B2B Vitrin</a>
                <span class="text-slate-600">/</span>
                <span class="text-slate-200 font-semibold">Kurumsal Sepetim</span>
            </nav>

            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">
                <div class="max-w-3xl">
                    <!-- Rozet -->
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-500/10 text-blue-400 border border-blue-500/20 mb-2.5 backdrop-blur-sm">
                        <i class="fa-solid fa-cart-shopping text-blue-400 text-xs"></i>
                        <span>B2B Satınalma Yönetimi</span>
                    </div>

                    <!-- Başlık -->
                    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-white leading-tight">
                        Kurumsal Satınalma Sepetim
                    </h1>
                    <p class="text-xs sm:text-sm text-slate-300 mt-2 leading-relaxed font-normal">
                        Seçtiğiniz endüstriyel ürünleri inceleyip resmi kurumsal e-fatura, doğrudan fabrika sevkiyatı ve güvenli havuz güvencesiyle tek adımda sipariş oluşturabilirsiniz.
                    </p>
                </div>

                <!-- Sağ Üst Hızlı Aksiyon Butonları -->
                <div class="flex items-center gap-3 shrink-0 flex-wrap">
                    <a href="/#ihtiyaciniz-olan-urunler" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs sm:text-sm font-bold shadow-md shadow-blue-600/20 transition-all hover:scale-[1.02]">
                        <i class="fa-solid fa-store text-xs"></i>
                        <span>B2B Vitrine Dön</span>
                    </a>
                    <a href="/Home/Iletisim" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-800/90 hover:bg-slate-700/90 text-slate-200 hover:text-white border border-slate-700 text-xs sm:text-sm font-semibold transition-all">
                        <i class="fa-solid fa-headset text-xs"></i>
                        <span>Müşteri Destek</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== BÖLÜM 2: ANA İÇERİK ALANI ==================== -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">

        @if (Model == null || !Model.IsAuthenticated)
        {
            <!-- Giriş Yapmamış Kullanıcılar İçin Bilgilendirme Bandı -->
            <div class="rounded-2xl border border-blue-200/90 bg-gradient-to-r from-blue-50 via-indigo-50/60 to-white p-5 sm:p-6 shadow-sm mb-8 flex flex-col md:flex-row md:items-center justify-between gap-5 backdrop-blur-sm">
                <div class="flex items-start sm:items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-blue-600/10 text-blue-600 flex items-center justify-center shrink-0 text-xl font-bold">
                        <i class="fa-solid fa-building"></i>
                    </div>
                    <div>
                        <strong class="text-sm sm:text-base font-extrabold text-blue-950 block">Kurumsal Satın Alma İçin Firma Hesabı Gereklidir</strong>
                        <p class="text-xs sm:text-sm text-slate-600 mt-0.5">
                            B2B e-fatura, VKN doğrulaması, fabrika teslimatı ve iyzico güvenli havuz korumasından yararlanmak için lütfen kurumsal hesabınızla giriş yapınız.
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-2.5 shrink-0 self-end md:self-center">
                    <a href="/Account/Login?returnUrl=/Cart" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-blue-600 hover:bg-blue-500 text-white shadow-md shadow-blue-500/20 transition-all">
                        Giriş Yap
                    </a>
                    <a href="/Account/Register?returnUrl=/Cart" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-white hover:bg-blue-50 text-blue-700 border border-blue-200 transition-all">
                        Firma Hesabı Aç
                    </a>
                </div>
            </div>
        }

        <!-- ==================== BOŞ SEPET GÖRÜNÜMÜ ==================== -->
        <div id="cartEmptyState" style="display: none;" class="max-w-2xl mx-auto py-6 sm:py-10">
            <div class="bg-white rounded-3xl border border-slate-200/90 p-8 sm:p-14 text-center shadow-sm relative overflow-hidden">
                <!-- Arka Plan Süs Efekti -->
                <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-80 h-80 bg-blue-50/60 rounded-full blur-3xl pointer-events-none"></div>

                <div class="relative">
                    <!-- İkon Alanı -->
                    <div class="w-20 h-20 mx-auto rounded-3xl bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-100 text-blue-600 flex items-center justify-center text-3xl mb-5 shadow-inner">
                        <i class="fa-solid fa-cart-shopping text-blue-600 text-3xl"></i>
                    </div>

                    <!-- Başlık & Açıklama -->
                    <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight mb-2.5">
                        Kurumsal Sepetinizde Ürün Bulunmuyor
                    </h2>
                    <p class="text-xs sm:text-sm text-slate-500 max-w-md mx-auto leading-relaxed mb-7">
                        B2B pazar yerimizdeki onaylı üretici ve distribütör ürünlerini inceleyebilir, ihtiyacınız olan endüstriyel malzemeleri ekleyerek tek kurumsal faturada doğrudan satın alabilirsiniz.
                    </p>

                    <!-- Aksiyon Butonları -->
                    <div class="flex flex-wrap items-center justify-center gap-3 mb-8">
                        <a href="/#ihtiyaciniz-olan-urunler" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold text-xs sm:text-sm shadow-md shadow-blue-500/20 transition-all hover:scale-[1.02]">
                            <i class="fa-solid fa-store text-xs"></i>
                            <span>B2B Ürün Vitrinine Git</span>
                            <i class="fa-solid fa-arrow-right text-xs"></i>
                        </a>
                        <a href="/Home/Fiyatlandirma" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs sm:text-sm transition-colors">
                            <i class="fa-solid fa-tags text-xs text-slate-500"></i>
                            <span>Fiyatlandırma &amp; Paketler</span>
                        </a>
                    </div>

                    <!-- Tek Satır Kompakt Güvence İpuçları -->
                    <div class="pt-6 border-t border-slate-100 flex flex-wrap items-center justify-center gap-5 sm:gap-7 text-xs text-slate-500">
                        <div class="flex items-center gap-1.5">
                            <i class="fa-solid fa-file-invoice text-blue-600 text-xs"></i>
                            <span class="font-medium text-slate-700">Resmi E-Fatura (VKN)</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <i class="fa-solid fa-shield-halved text-emerald-600 text-xs"></i>
                            <span class="font-medium text-slate-700">iyzico Güvenli Havuz</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <i class="fa-solid fa-truck-fast text-indigo-600 text-xs"></i>
                            <span class="font-medium text-slate-700">Fabrikadan Doğrudan Sevk</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ==================== DOLU SEPET DÜZENİ ==================== -->
        <div id="cartContentGrid" class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

            <!-- Sol Kolon: Ürün Listesi ve Güvence Şeritleri -->
            <div class="lg:col-span-7 xl:col-span-8 space-y-6">

                <!-- Sepetteki Kalemler Kartı -->
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                    <div class="px-5 sm:px-6 py-4 bg-slate-50/80 border-b border-slate-200 flex items-center justify-between">
                        <span id="cartTotalItemsHeader" class="font-extrabold text-slate-900 text-xs sm:text-sm flex items-center gap-2">
                            <i class="fa-solid fa-boxes-stacked text-blue-600"></i>
                            <span>Sepetteki Kalemler</span>
                        </span>
                        <button type="button" onclick="clearB2BCart()" class="text-rose-600 hover:text-rose-700 text-xs font-bold px-3 py-1.5 rounded-lg hover:bg-rose-50 transition-colors inline-flex items-center gap-1.5">
                            <i class="fa-regular fa-trash-can"></i>
                            <span>Tüm Sepeti Boşalt</span>
                        </button>
                    </div>

                    <!-- Dinamik Ürün Listesi -->
                    <div id="cartPageItemsTable" class="divide-y divide-slate-100">
                        <!-- JavaScript ile renderFullCartPage() fonksiyonu doldurur -->
                    </div>
                </div>

                <!-- Alt Güvence Şeritleri -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
                    <div class="p-3.5 sm:p-4 rounded-xl bg-white border border-slate-200 shadow-sm flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 text-sm">
                            <i class="fa-solid fa-file-invoice-dollar"></i>
                        </div>
                        <div class="min-w-0">
                            <strong class="text-xs font-bold text-slate-900 block truncate">Kurumsal E-Fatura</strong>
                            <span class="text-[11px] text-slate-500 block truncate">VKN &amp; Tevkifat uyumlu fatura</span>
                        </div>
                    </div>
                    <div class="p-3.5 sm:p-4 rounded-xl bg-white border border-slate-200 shadow-sm flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 text-sm">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <div class="min-w-0">
                            <strong class="text-xs font-bold text-slate-900 block truncate">Güvenli Havuz (Escrow)</strong>
                            <span class="text-[11px] text-slate-500 block truncate">iyzico güvenceli ödeme havuzu</span>
                        </div>
                    </div>
                    <div class="p-3.5 sm:p-4 rounded-xl bg-white border border-slate-200 shadow-sm flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0 text-sm">
                            <i class="fa-solid fa-truck-fast"></i>
                        </div>
                        <div class="min-w-0">
                            <strong class="text-xs font-bold text-slate-900 block truncate">Fabrikadan Doğrudan Sevk</strong>
                            <span class="text-[11px] text-slate-500 block truncate">Ambar ve paletli teslimat</span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Sağ Kolon: Sipariş Özeti & Ödemeye Geçiş (GENİŞ & FERAHLATILMIŞ) -->
            <div class="lg:col-span-5 xl:col-span-4 sticky top-6 space-y-6">
                <div class="bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-7 shadow-sm space-y-6">
                    <!-- Başlık Alanı -->
                    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                        <h3 class="text-base sm:text-lg font-black text-slate-900 flex items-center gap-2.5">
                            <i class="fa-solid fa-receipt text-blue-600 text-base"></i>
                            <span>Sipariş Özeti</span>
                        </h3>
                        <span class="text-xs font-bold text-blue-700 bg-blue-50 border border-blue-200/80 px-2.5 py-1 rounded-full">B2B Satınalma</span>
                    </div>

                    <!-- Hesap Dökümü -->
                    <div class="space-y-4 text-sm">
                        <div class="flex justify-between items-center text-slate-600">
                            <span class="text-slate-500 font-medium">Ürünler Ara Toplamı:</span>
                            <strong id="cartSummarySubtotal" class="font-bold text-slate-900 text-sm sm:text-base">0 ₺</strong>
                        </div>
                        <div class="flex justify-between items-center text-slate-600">
                            <span class="text-slate-500 font-medium">Hesaplanan KDV (%20):</span>
                            <span id="cartSummaryTax" class="font-semibold text-slate-800 text-sm">0 ₺</span>
                        </div>
                        <div class="flex justify-between items-center text-slate-600">
                            <span class="text-slate-500 font-medium">Sevkiyat / Lojistik:</span>
                            <span class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-200/70">
                                <i class="fa-solid fa-truck-fast text-[11px]"></i>
                                <span>Ücretsiz Standart Sevk</span>
                            </span>
                        </div>
                    </div>

                    <!-- Toplam Tutar Kutusu (Yazılar Üste, Tutar Alta) -->
                    <div class="p-5 rounded-2xl bg-gradient-to-br from-blue-50/80 via-indigo-50/40 to-slate-50 border border-blue-100/90 flex flex-col gap-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-700 tracking-wide uppercase">Ödenecek Toplam Tutar</span>
                            <span class="text-[11px] font-semibold text-slate-500 bg-white/90 border border-slate-200/80 px-2 py-0.5 rounded-md">KDV Dahil</span>
                        </div>
                        <div>
                            <strong id="cartSummaryGrandTotal" class="text-3xl sm:text-4xl font-black text-blue-600 tracking-tight block">0 ₺</strong>
                        </div>
                    </div>

                    <!-- Aksiyon Butonu (Tek Satır, Ferah) -->
                    <button type="button" onclick="openCheckoutModal()" class="w-full py-4 px-4 rounded-xl font-bold text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 shadow-lg shadow-blue-500/25 transition-all flex items-center justify-center gap-2 text-sm sm:text-base active:scale-[0.99] whitespace-nowrap">
                        <span>Kurumsal Siparişi Tamamla</span>
                        <i class="fa-solid fa-arrow-right text-xs"></i>
                    </button>

                    <!-- Alt Bilgilendirme ve Ödeme İpuçları -->
                    <div class="pt-4 border-t border-slate-100 text-center space-y-3">
                        <div class="inline-flex items-center gap-1.5 text-xs text-slate-500 font-medium">
                            <i class="fa-solid fa-shield-halved text-emerald-600 text-xs"></i>
                            <span>Güvenli Kurumsal Ödeme Altyapısı</span>
                        </div>
                        <div class="flex flex-wrap items-center justify-center gap-1.5 text-[11px] text-slate-500">
                            <span class="bg-slate-100/90 border border-slate-200/60 px-2.5 py-1 rounded-lg font-medium text-slate-600">Kredi Kartı / 3D</span>
                            <span class="bg-slate-100/90 border border-slate-200/60 px-2.5 py-1 rounded-lg font-medium text-slate-600">Havale / EFT</span>
                            <span class="bg-slate-100/90 border border-slate-200/60 px-2.5 py-1 rounded-lg font-medium text-slate-600">DBS</span>
                            <span class="bg-slate-100/90 border border-slate-200/60 px-2.5 py-1 rounded-lg font-medium text-slate-600">Vadeli Çek</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </main>

</div>

<!-- ==================== B2B KURUMSAL CHECKOUT / ÖDEME MODALI ==================== -->
<div id="b2bCheckoutModal" class="b2b-checkout-overlay" onclick="if(event.target===this)closeCheckoutModal()">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-2xl overflow-hidden relative max-h-[92vh] flex flex-col animate-in fade-in zoom-in-95 duration-200" role="dialog" aria-modal="true" aria-labelledby="b2bCartCheckoutModalTitle">

        <!-- Modal Başlık Alanı -->
        <div class="p-4 sm:p-6 sm:px-8 border-b border-slate-200 bg-slate-50 flex items-start justify-between">
            <div>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200/80 mb-1.5">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                        <polyline points="2 17 12 22 22 17"></polyline>
                        <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                    <span>B2B KURUMSAL CHECKOUT</span>
                </span>
                <h3 id="b2bCartCheckoutModalTitle" class="text-lg sm:text-xl font-black text-slate-900 tracking-tight">Siparişi Onayla &amp; Satın Al</h3>
                <p class="text-xs text-slate-500 mt-0.5 font-normal">Kurumsal fatura, fabrika teslimatı ve ödeme yöntemi bilgilerinizi tamamlayınız.</p>
            </div>
            <button type="button" class="text-slate-400 hover:text-slate-700 text-2xl font-bold p-1 leading-none rounded-lg hover:bg-slate-200 transition-colors" onclick="closeCheckoutModal()" title="Kapat">&times;</button>
        </div>

        <form id="corporateCheckoutForm" onsubmit="submitCorporateOrder(event); return false;" class="flex-1 overflow-y-auto p-4 sm:p-8 space-y-4 sm:space-y-6">

            <!-- Adım 1: Kurumsal Fatura Bilgileri -->
            <div class="rounded-xl border border-slate-200 bg-slate-50/50 p-4 sm:p-5">
                <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-200">
                    <h4 class="text-xs sm:text-sm font-bold text-slate-900 flex items-center gap-2">
                        <span class="w-5 h-5 rounded-full bg-blue-600 text-white text-[11px] font-extrabold flex items-center justify-center">1</span>
                        <span>Kurumsal Fatura Bilgileri</span>
                    </h4>
                    <span class="text-[11px] font-semibold text-blue-700 bg-blue-50 border border-blue-200/80 px-2 py-0.5 rounded-full">E-Fatura &amp; VKN Uyumlu</span>
                </div>

                <div class="mb-3">
                    <label class="flex justify-between items-center text-xs font-bold text-slate-700 mb-1" for="checkoutBuyerCompany">
                        <span>Satınalma Yapan Firma Ünvanı *</span>
                        <span class="text-rose-500 font-semibold text-[10px]">Zorunlu</span>
                    </label>
                    <input type="text" id="checkoutBuyerCompany" class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-medium" placeholder="Örn: Aselsan A.Ş. / Ege Kimya San. Tic. Ltd. Şti." value="@(Model?.CompanyName ?? Model?.CompanyOfficial)" required />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="flex justify-between items-center text-xs font-bold text-slate-700 mb-1" for="checkoutBuyerTaxNo">
                            <span>Vergi Kimlik / TC No</span>
                            <span id="checkoutTaxCounter" class="text-[10px] text-slate-400 font-mono">0/11 Hane</span>
                        </label>
                        <input type="text" id="checkoutBuyerTaxNo" class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-mono font-bold" placeholder="10 haneli VKN veya 11 haneli TCKN" maxlength="11" inputmode="numeric" oninput="formatTaxNumberInput(this)" value="@Model?.TaxNumber" />
                    </div>
                    <div>
                        <label class="flex justify-between items-center text-xs font-bold text-slate-700 mb-1" for="checkoutBuyerTaxOffice">
                            <span>Vergi Dairesi</span>
                            <span class="text-[10px] text-slate-400">İsteğe Bağlı</span>
                        </label>
                        <input type="text" id="checkoutBuyerTaxOffice" class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-medium" placeholder="Örn: Kadıköy VD / Ostim VD" value="@Model?.TaxOffice" />
                    </div>
                </div>
            </div>

            <!-- Adım 2: Sevkiyat ve Fabrika Teslimat Adresi -->
            <div class="rounded-xl border border-slate-200 bg-slate-50/50 p-4 sm:p-5">
                <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-200">
                    <h4 class="text-xs sm:text-sm font-bold text-slate-900 flex items-center gap-2">
                        <span class="w-5 h-5 rounded-full bg-blue-600 text-white text-[11px] font-extrabold flex items-center justify-center">2</span>
                        <span>Sevkiyat &amp; Fabrika Teslimat Adresi</span>
                    </h4>
                    <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full">Ambar &amp; Lojistik Sevk</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
                    <div>
                        <label class="flex justify-between items-center text-xs font-bold text-slate-700 mb-1" for="checkoutDeliveryCity">
                            <span>Teslimat İli / İlçe *</span>
                            <span class="text-rose-500 font-semibold text-[10px]">Zorunlu</span>
                        </label>
                        <input type="text" id="checkoutDeliveryCity" class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-medium" placeholder="Örn: Kocaeli / Dilovası İMES OSB" value="@Model?.DeliveryCity" required />
                    </div>
                    <div>
                        <label class="flex justify-between items-center text-xs font-bold text-slate-700 mb-1" for="checkoutReceiverPhone">
                            <span>Yetkili / Alıcı Telefonu</span>
                            <span id="checkoutPhoneCounter" class="text-[10px] text-slate-400 font-mono">0/10 Hane</span>
                        </label>
                        <div class="relative flex items-center">
                            <span class="absolute left-3 text-xs text-slate-500 font-semibold pointer-events-none">+90</span>
                            <input type="tel" id="checkoutReceiverPhone" class="w-full pl-11 pr-3 py-2 text-xs bg-white border border-slate-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-mono font-bold" placeholder="5XX XXX XX XX" maxlength="10" inputmode="numeric" oninput="formatPhoneInput(this)" value="@Model?.Phone" />
                        </div>
                    </div>
                </div>

                <div>
                    <label class="flex justify-between items-center text-xs font-bold text-slate-700 mb-1" for="checkoutDeliveryAddress">
                        <span>Fabrika / Depo / Şantiye Açık Adresi *</span>
                        <span class="text-rose-500 font-semibold text-[10px]">Zorunlu</span>
                    </label>
                    <textarea id="checkoutDeliveryAddress" rows="2" class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-medium" placeholder="Fabrika No, Blok, Mal Kabul Girişi veya Şantiye Adresi..." required>@Model?.DeliveryAddress</textarea>
                </div>
            </div>

            <!-- Adım 3: Kurumsal Ödeme Yöntemi -->
            <div class="rounded-xl border border-slate-200 bg-slate-50/50 p-4 sm:p-5">
                <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-200">
                    <h4 class="text-xs sm:text-sm font-bold text-slate-900 flex items-center gap-2">
                        <span class="w-5 h-5 rounded-full bg-blue-600 text-white text-[11px] font-extrabold flex items-center justify-center">3</span>
                        <span>Kurumsal Ödeme Yöntemi</span>
                    </h4>
                    <span class="text-[11px] font-semibold text-indigo-700 bg-indigo-50 border border-indigo-200 px-2 py-0.5 rounded-full">Güvenli 3D &amp; DBS Altyapı</span>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-4">
                    <label class="b2b-paymethod-card is-selected flex flex-col p-3 rounded-xl border border-blue-500 bg-blue-50/40 cursor-pointer text-center transition-all select-none" onclick="selectPaymentMethod('Kredi Kartı', this)">
                        <input type="radio" name="checkoutPaymentMethod" value="Kredi Kartı" checked onchange="togglePaymentFields(this.value)" class="sr-only" />
                        <span class="text-xs font-bold text-slate-900">Kredi Kartı</span>
                        <span class="text-[10px] text-slate-500 mt-0.5">3D Secure Onay</span>
                    </label>

                    <label class="b2b-paymethod-card flex flex-col p-3 rounded-xl border border-slate-200 bg-white hover:border-slate-300 cursor-pointer text-center transition-all select-none" onclick="selectPaymentMethod('Havale / EFT', this)">
                        <input type="radio" name="checkoutPaymentMethod" value="Havale / EFT" onchange="togglePaymentFields(this.value)" class="sr-only" />
                        <span class="text-xs font-bold text-slate-900">Havale / EFT</span>
                        <span class="text-[10px] text-slate-500 mt-0.5">Proforma Fatura</span>
                    </label>

                    <label class="b2b-paymethod-card flex flex-col p-3 rounded-xl border border-slate-200 bg-white hover:border-slate-300 cursor-pointer text-center transition-all select-none" onclick="selectPaymentMethod('Cari Hesap / Vadeli', this)">
                        <input type="radio" name="checkoutPaymentMethod" value="Cari Hesap / Vadeli" onchange="togglePaymentFields(this.value)" class="sr-only" />
                        <span class="text-xs font-bold text-slate-900">Vadeli Çek</span>
                        <span class="text-[10px] text-slate-500 mt-0.5">30-60 Gün Vade</span>
                    </label>

                    <label class="b2b-paymethod-card flex flex-col p-3 rounded-xl border border-slate-200 bg-white hover:border-slate-300 cursor-pointer text-center transition-all select-none" onclick="selectPaymentMethod('DBS', this)">
                        <input type="radio" name="checkoutPaymentMethod" value="DBS" onchange="togglePaymentFields(this.value)" class="sr-only" />
                        <span class="text-xs font-bold text-slate-900">DBS</span>
                        <span class="text-[10px] text-slate-500 mt-0.5">Banka Garantili</span>
                    </label>
                </div>

                <!-- Kredi Kartı Alanı -->
                <div id="paymentCreditCardFields" class="bg-white border border-slate-200 rounded-xl p-4">
                    <div class="flex items-center justify-between pb-2 mb-3 border-b border-slate-100">
                        <span class="text-xs font-bold text-slate-700">Kart Bilgileri</span>
                        <span id="cardTypeBadge" class="text-[10px] font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-200/60">3D SECURE &amp; İYZİCO HAVUZ</span>
                    </div>

                    <!-- iyzico Escrow Bilgilendirme Rozeti -->
                    <div class="bg-emerald-50/80 border border-emerald-200 rounded-lg p-3 mb-3 text-xs text-emerald-800 leading-relaxed flex items-start gap-2.5">
                        <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                        <div>
                            <strong class="text-emerald-900 block font-bold mb-0.5">B2B Güvenli Havuz (Escrow) Garantisi:</strong>
                            Ödemeniz satıcıya hemen aktarılmaz; ürün teslim edilip onaylayana kadar <strong>iyzico güvence havuzunda</strong> bloke edilir.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="block text-xs font-bold text-slate-700 mb-1">Kart Üzerindeki İsim</label>
                        <input type="text" id="checkoutCardHolder" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all uppercase font-medium" placeholder="Ad Soyad veya Şirket Ünvanı" oninput="formatCardHolderInput(this)" />
                    </div>

                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                        <div class="col-span-2">
                            <label class="block text-xs font-bold text-slate-700 mb-1">Kart Numarası (16 Hane)</label>
                            <input type="text" id="checkoutCardNumber" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-mono font-bold tracking-wider" placeholder="5528 7900 0000 0008" maxlength="19" inputmode="numeric" oninput="formatCardNumberInput(this)" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">SKT (AA/YY)</label>
                            <input type="text" id="checkoutCardExpiry" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-mono text-center font-bold" placeholder="12/28" maxlength="5" inputmode="numeric" oninput="formatExpiryInput(this)" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">CVV / CVC</label>
                            <input type="password" id="checkoutCardCvv" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-mono text-center font-bold" placeholder="***" maxlength="3" inputmode="numeric" oninput="formatCvvInput(this)" />
                        </div>
                    </div>
                </div>

                <!-- Havale/EFT Bilgilendirme Alanı -->
                <div id="paymentBankFields" class="hidden bg-blue-50 border border-blue-200 rounded-xl p-4 mt-3">
                    <div class="flex gap-3 items-start">
                        <div class="text-xs text-blue-800 leading-relaxed">
                            <strong class="text-blue-950 block mb-1 font-bold">Kurumsal Havale / EFT Talimatı</strong>
                            Sipariş onayınızın ardından resmi <strong>Proforma Fatura</strong> ve şirket banka IBAN hesaplarımız otomatik olarak sistem ve e-posta adresinize iletilecektir.
                        </div>
                    </div>
                </div>

                <!-- Vadeli Çek / DBS Bilgilendirme Alanı -->
                <div id="paymentCheckFields" class="hidden bg-amber-50 border border-amber-200 rounded-xl p-4 mt-3">
                    <div class="flex gap-3 items-start">
                        <div class="text-xs text-amber-800 leading-relaxed">
                            <strong class="text-amber-950 block mb-1 font-bold">Kurumsal Vadeli / DBS Süreci</strong>
                            Siparişiniz onaylandıktan sonra finans departmanımız firmanızın tanımlı kurumsal kredi/DBS limiti üzerinden cari işleminizi tamamlayacaktır.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sipariş Özeti ve Tutar Şeridi -->
            <div class="rounded-xl bg-slate-900 text-white p-4 sm:p-5 flex items-center justify-between">
                <div>
                    <span class="text-[11px] text-slate-400 block font-medium">Ödenecek Toplam Tutar (KDV Dahil):</span>
                    <strong id="checkoutModalGrandTotalText" class="text-xl sm:text-2xl font-black text-white tracking-tight">0 ₺</strong>
                </div>
                <div class="text-right text-xs">
                    <span id="checkoutModalItemCount" class="font-bold text-white block">0 Kalem</span>
                    <span class="inline-flex items-center gap-1 text-emerald-400 text-[11px] font-semibold">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        256-Bit SSL &amp; 3D Secure
                    </span>
                </div>
            </div>

            <!-- Aksiyon Butonları -->
            <div class="flex items-center gap-3 pt-2">
                <button type="button" class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 hover:bg-slate-100 text-slate-700 text-xs font-bold transition-colors" onclick="closeCheckoutModal()">Vazgeç</button>
                <button type="submit" id="btnSubmitOrder" class="flex-[2] inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold shadow-md shadow-blue-600/20 transition-all hover:-translate-y-0.5 active:scale-95">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Siparişi Onayla ve Satın Al</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ==================== SİPARİŞ BAŞARILI / ALINDI MODALI ==================== -->
<div id="b2bOrderSuccessModal" class="b2b-checkout-overlay" style="z-index: 999999;">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-md p-5 sm:p-8 text-center animate-in fade-in zoom-in-95 duration-200 max-h-[92vh] overflow-y-auto" role="dialog" aria-modal="true">
        <div class="w-14 h-14 mx-auto rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mb-4 shadow-sm">
            <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
        </div>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 mb-2">SİPARİŞİNİZ ALINDI</span>
