                <strong id="successModalTotal" class="text-sm font-black text-emerald-600">0 ₺</strong>
            </div>
            <div class="flex justify-between items-center text-slate-600">
                <span>Ödeme Yöntemi:</span>
                <span id="successModalPayMethod" class="font-bold text-slate-900">Kredi Kartı</span>
            </div>
            <div class="flex justify-between items-center text-slate-600">
                <span>Sipariş Tarihi:</span>
                <span id="successModalDate" class="text-slate-500">Bugün</span>
            </div>
            <div class="flex justify-between items-center text-slate-600 pt-2 border-t border-dashed border-slate-200">
                <span>Tahmini Fabrika Sevkiyatı:</span>
                <span class="text-blue-600 font-bold">1-3 İş Günü (Doğrudan Sevk)</span>
            </div>
        </div>

        <!-- Değerlendirme Aksiyon Alanı -->
        <div id="orderSuccessReviewActionWrap" class="mt-4 w-full">
            <button type="button" id="btnSuccessReviewSingle" class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold shadow-md shadow-amber-500/25 transition-all mb-2" style="display: none;" onclick="openSuccessSellerReviewModal()">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
