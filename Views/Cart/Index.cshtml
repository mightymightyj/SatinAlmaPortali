<!-- ==================== SİPARİŞ SONRASI SATICI DEĞERLENDİRME MODALI ==================== -->
<div id="orderSuccessRatingModal" class="ty-modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.7); backdrop-filter: blur(4px); z-index: 1000000; align-items: center; justify-content: center; padding: 1rem;" onclick="if(event.target===this)closeSuccessSellerReviewModal()">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-lg p-5 sm:p-8 animate-in fade-in zoom-in-95 duration-200 max-h-[92vh] overflow-y-auto">
        <div class="flex justify-between items-start mb-4">
            <div>
                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">DOĞRULANMIŞ SATINALMA</span>
                <h3 id="successRateModalSellerTitle" class="text-lg font-extrabold text-slate-900 mt-1">Satıcıyı Değerlendir</h3>
                <small class="text-xs text-slate-500">Bu değerlendirme satıcının onaylı kurumsal profiline ve karne istatistiklerine yansıyacaktır.</small>
            </div>
            <button type="button" onclick="closeSuccessSellerReviewModal()" class="text-slate-400 hover:text-slate-700 text-2xl font-bold p-1 leading-none rounded-lg hover:bg-slate-100 transition-colors">&times;</button>
        </div>

        <form id="successRateModalForm" onsubmit="submitSuccessSellerReview(event)" class="space-y-4">
            <input type="hidden" id="successRateModalOrderID" />
            <input type="hidden" id="successRateModalSupplierCompanyID" />
            <input type="hidden" id="successRateModalSupplierName" />
            <input type="hidden" id="successRateModalScore" value="10" />

            <!-- 10 Yıldız Seçici -->
            <div class="text-center p-4 rounded-xl bg-amber-500/5 border border-amber-500/20">
                <label class="block text-xs font-bold text-slate-900 mb-1.5">Satıcı Genel Memnuniyet Puanı (10 Yıldız)</label>
                <div class="flex justify-center gap-1" id="successStarPickerWrap">
                    @for (int i = 1; i <= 10; i++)
                    {
                        <button type="button" class="btn-star-pick-success text-amber-400 hover:text-amber-500 hover:scale-125 transition-transform p-0.5 leading-none" data-val="@i" onclick="pickSuccessScore(@i)" onmouseenter="previewSuccessScore(@i)" onmouseleave="restoreSuccessScore()">
                            <svg class="w-6 h-6 inline fill-current" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                        </button>
                    }
                </div>
                <div id="successScoreText" class="text-sm font-extrabold text-amber-600 mt-1.5">10.0 / 10 - Mükemmel</div>
            </div>

            <!-- Alt Kriterler -->
            <div class="grid grid-cols-3 gap-2.5">
