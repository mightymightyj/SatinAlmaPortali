                <textarea id="successRateComment" rows="3" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-medium" placeholder="Teslimat süreci, ambalaj ve şartnameye uygunluk nasıldı?"></textarea>
            </div>

            <div class="flex items-center gap-3 pt-2">
                <button type="button" class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 hover:bg-slate-100 text-slate-700 text-xs font-bold transition-colors" onclick="closeSuccessSellerReviewModal()">Vazgeç</button>
                <button type="submit" id="btnSubmitSuccessReview" class="flex-[2] px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold shadow-md shadow-amber-500/25 transition-all">
                    Değerlendir &amp; Gönder
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ==================== İYZİCO 3D SECURE MODALI ==================== -->
<div id="iyzico3DModal" class="b2b-checkout-overlay" style="display: none; z-index: 1000002;">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-hidden flex flex-col">
        <div class="px-6 py-4 bg-slate-950 text-white flex justify-between items-center border-b border-slate-800">
            <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <strong class="text-sm font-bold">Banka 3D Secure Doğrulama Ekranı</strong>
            </div>
            <button type="button" onclick="closeIyzico3DModal()" class="text-slate-400 hover:text-white text-xl font-bold p-1 leading-none rounded-lg hover:bg-slate-800 transition-colors">&times;</button>
        </div>
        <div id="iyzico3DFrameContainer" class="flex-1 min-h-[520px] w-full relative bg-slate-50">
            <!-- 3D Secure HTML form / iframe dinamik basılır -->
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/trendyol-vitrin.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            renderFullCartPage();
        });

        function renderFullCartPage() {
            const cart = getB2BCart();
            const emptyEl = document.getElementById('cartEmptyState');
            const contentEl = document.getElementById('cartContentGrid');
            const itemsContainer = document.getElementById('cartPageItemsTable');
            const headerCount = document.getElementById('cartTotalItemsHeader');

            if (!cart || cart.length === 0) {
                if (emptyEl) emptyEl.style.display = 'block';
                if (contentEl) contentEl.style.display = 'none';
                return;
            }

            if (emptyEl) emptyEl.style.display = 'none';
            if (contentEl) contentEl.style.display = 'grid';

            const totals = getCartTotals();
            if (headerCount) {
                headerCount.innerHTML = `
                    <i class="fa-solid fa-boxes-stacked text-blue-600"></i>
                    <span>Sepetteki Kalemler (${totals.uniqueItemCount} Kalem / ${totals.totalCount} Adet)</span>
                `;
            }

            const subtotalEl = document.getElementById('cartSummarySubtotal');
            const taxEl = document.getElementById('cartSummaryTax');
            const grandTotalEl = document.getElementById('cartSummaryGrandTotal');

            if (subtotalEl) subtotalEl.textContent = formatB2BMoney(totals.subtotal);
            if (taxEl) taxEl.textContent = formatB2BMoney(totals.tax);
            if (grandTotalEl) grandTotalEl.textContent = formatB2BMoney(totals.grandTotal);

            let html = '';
            cart.forEach(item => {
                const lineTotal = item.price * item.quantity;
                html += `
                    <div class="p-4 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 sm:gap-6 hover:bg-slate-50/70 transition-colors">
                        <!-- Sol: Ürün Görseli ve Detayları -->
                        <div class="flex items-start sm:items-center gap-4 flex-1 min-w-0 w-full sm:w-auto">
                            <img src="${item.image || '/images/default-product.svg'}" 
                                 alt="${item.title}" 
                                 class="w-16 h-16 sm:w-20 sm:h-20 object-cover rounded-xl border border-slate-200 shadow-sm shrink-0 bg-white" 
                                 onerror="this.src='/images/default-product.svg'" />
                            
                            <div class="min-w-0 flex-1">
                                <div class="flex flex-wrap items-center gap-2 mb-1">
                                    <span class="inline-flex items-center gap-1 text-[11px] font-bold text-blue-700 bg-blue-50 border border-blue-200/80 px-2 py-0.5 rounded-full">
                                        <i class="fa-regular fa-building text-[10px]"></i>
                                        ${item.seller || 'Onaylı Tedarikçi'}
                                    </span>
                                    <span class="text-[11px] text-slate-500 font-mono bg-slate-100 px-2 py-0.5 rounded-md">
                                        ${item.sku || 'SKU-000'}
                                    </span>
                                </div>
                                <h4 class="text-xs sm:text-sm font-bold text-slate-900 line-clamp-2 mb-1 leading-snug">
                                    ${item.title}
                                </h4>
                                <div class="text-xs text-slate-500 flex flex-wrap items-center gap-x-2 gap-y-0.5">
                                    <span>Kategori: <strong class="text-slate-700 font-semibold">${item.category || 'Endüstriyel'}</strong></span>
                                    <span class="text-slate-300">•</span>
                                    <span>Birim: <strong class="text-slate-800 font-bold">${formatB2BMoney(item.price)}</strong> <span class="text-[10px] text-slate-400 font-normal">(+KDV)</span></span>
                                </div>
                            </div>
                        </div>

                        <!-- Sağ: Adet Kontrolü, Ara Toplam ve Sil Butonu -->
                        <div class="flex items-center justify-between sm:justify-end gap-4 sm:gap-6 w-full sm:w-auto pt-3 sm:pt-0 border-t sm:border-t-0 border-slate-100">
                            <!-- Adet Seçici -->
                            <div class="flex items-center border border-slate-200 rounded-xl bg-slate-50 p-0.5 shadow-sm">
                                <button type="button" onclick="updateCartPageQty(${item.productId}, ${item.quantity - 1})" 
                                        class="w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center text-slate-600 hover:text-slate-900 hover:bg-white rounded-lg transition-all font-bold text-sm" title="Azalt">-</button>
                                <span class="px-2.5 sm:px-3 min-w-[32px] sm:min-w-[36px] text-center text-xs sm:text-sm font-extrabold text-slate-900">${item.quantity}</span>
                                <button type="button" onclick="updateCartPageQty(${item.productId}, ${item.quantity + 1})" 
                                        class="w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center text-slate-600 hover:text-slate-900 hover:bg-white rounded-lg transition-all font-bold text-sm" title="Artır">+</button>
                            </div>

                            <!-- Satır Ara Toplamı -->
                            <div class="text-right min-w-[100px] sm:min-w-[110px]">
                                <div class="text-[11px] text-slate-400 font-medium">Toplam Tutar</div>
                                <div class="text-sm sm:text-base font-black text-blue-600 tracking-tight">${formatB2BMoney(lineTotal)}</div>
                            </div>

                            <!-- Çöp Kutusu -->
                            <button type="button" onclick="removeCartPageItem(${item.productId})" 
                                    class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl flex items-center justify-center text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-all" 
                                    title="Ürünü Sepetten Çıkar">
                                <i class="fa-regular fa-trash-can text-sm"></i>
                            </button>
                        </div>
                    </div>
                `;
            });

            if (itemsContainer) itemsContainer.innerHTML = html;
        }

        function updateCartPageQty(productId, newQty) {
            updateCartQty(productId, newQty);
            renderFullCartPage();
        }

        function removeCartPageItem(productId) {
            removeFromCart(productId);
            renderFullCartPage();
        }
    </script>
}