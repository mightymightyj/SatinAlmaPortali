<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tedarik Portalı</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/satinalmaportali2.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
@{
    var currentCompId = User.FindFirst("CompanyID")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
    var currentCompName = User.FindFirst("CompanyName")?.Value ?? "";
}
<body data-current-company-id="@currentCompId" data-current-company-name="@currentCompName">
    <script>
        window.CURRENT_USER_COMPANY_ID = "@currentCompId";
        window.CURRENT_USER_COMPANY_NAME = "@Html.Raw(currentCompName)";
    </script>
    
    <!-- Top Navigation Header -->
    <header class="blue-top-header">
        <div class="header-container">
            <!-- Brand Logo -->
            <a class="brand-logo" href="~/">
                <span class="logo-badge">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                        <polyline points="2 17 12 22 22 17"></polyline>
                        <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                </span>
                <span class="logo-title">tedarik<span class="logo-blue-dot">.portal</span></span>
            </a>

            <!-- Navigation Links -->
            <nav class="center-nav">
                <a asp-controller="Home" asp-action="Kurumsal" class="nav-link">Kurumsal</a>
                <a asp-controller="Home" asp-action="UrunKategorileri" class="nav-link">Ürün Kategorileri</a>
                <a asp-controller="Home" asp-action="NedenPortal" class="nav-link">Neden Portal?</a>
                <a asp-controller="Home" asp-action="Fiyatlandirma" class="nav-link">Fiyatlandırma</a>
                <a asp-controller="Home" asp-action="MedyaDuyurular" class="nav-link">Medya & Duyurular</a>
                <a asp-controller="Home" asp-action="Iletisim" class="nav-link">İletişim</a>
            </nav>

            <!-- Header Right Actions -->
            <div class="right-actions">
                <a asp-controller="Cart" asp-action="Index" class="btn-cart-nav" title="Kurumsal Sepetim" id="headerCartNavBtn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    <span class="desktop-text">Sepetim</span>
                    <span id="navCartBadge" class="nav-cart-badge">0</span>
                </a>

                <a asp-controller="Dashboard" asp-action="Index" class="btn-royal-pill desktop-only-btn" title="Tedarik Portalı Paneli">
                    <span>Tedarik Portalı</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </a>

                <div class="lang-pill desktop-only-btn" title="Dil Seçimi">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-500">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="2" y1="12" x2="22" y2="12"></line>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                    </svg>
                    <span class="code">TR</span>
                </div>

                <div class="profile-dropdown-wrapper desktop-only-btn">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Account" asp-action="Profile" class="profile-avatar-btn" title="Hesabım" aria-label="Hesabım">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="8" r="4.5"></circle>
                                <path d="M4 21c0-4 3.5-6.5 8-6.5s8 2.5 8 6.5"></path>
                            </svg>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="profile-avatar-btn" title="Oturum İşlemleri" aria-label="Oturum Aç">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="8" r="4.5"></circle>
                                <path d="M4 21c0-4 3.5-6.5 8-6.5s8 2.5 8 6.5"></path>
                            </svg>
                        </a>
                    }

                    <div class="profile-dropdown-menu">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown-user-header">
                                <span class="user-email-badge">@User.Identity.Name</span>
                            </div>
                            <a asp-controller="Account" asp-action="Profile" class="dropdown-item btn-account">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="8" r="4.5"></circle>
                                    <path d="M4 21c0-4 3.5-6.5 8-6.5s8 2.5 8 6.5"></path>
                                </svg>
                                Hesabım &amp; Firma Bilgilerim
                            </a>
                            <a asp-controller="Dashboard" asp-action="Orders" class="dropdown-item btn-account">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                                </svg>
                                Siparişlerim (B2B)
                            </a>
                            <a asp-controller="Account" asp-action="Profile" asp-route-tab="reviews" class="dropdown-item btn-account">
                                <span style="color: #f59e0b; font-size: 0.95rem; line-height: 1;">★</span>
                                Değerlendirmeler &amp; Karne
                            </a>
                            <a asp-controller="Account" asp-action="Logout" class="dropdown-item btn-logout-red">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                    <polyline points="16 17 21 12 16 7"></polyline>
                                    <line x1="21" y1="12" x2="9" y2="12"></line>
                                </svg>
                                Oturum Kapat
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" asp-route-tab="user-login" class="dropdown-item btn-login">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                                    <polyline points="10 17 15 12 10 7"></polyline>
                                    <line x1="15" y1="12" x2="3" y2="12"></line>
                                </svg>
                                Oturum Aç
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="dropdown-item btn-register">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="8.5" cy="7" r="4"></circle>
                                    <line x1="20" y1="8" x2="20" y2="14"></line>
                                    <line x1="23" y1="11" x2="17" y2="11"></line>
                                </svg>
                                Üye Ol
                            </a>
                        }
                    </div>
                </div>

                <!-- Mobil Hamburger Menü Butonu -->
                <button type="button" class="btn-mobile-nav-toggle" id="btnMobileNavToggle" onclick="toggleMobileNavDrawer()" aria-label="Menüyü Aç" title="Menü">
                    <svg class="hamburger-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
            </div>
        </div>
    </header>

    <!-- Mobil Menü Offcanvas Çekmecesi & Karartma -->
    <div id="mobileNavDrawerOverlay" class="mobile-nav-overlay" onclick="closeMobileNavDrawer()"></div>
    <aside id="mobileNavDrawer" class="mobile-nav-drawer" aria-label="Mobil Gezinme Menüsü">
        <div class="mobile-nav-header">
            <div class="brand-logo">
                <span class="logo-badge">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                        <polyline points="2 17 12 22 22 17"></polyline>
                        <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                </span>
                <span class="logo-title">tedarik<span class="logo-blue-dot">.portal</span></span>
            </div>
            <button type="button" class="btn-mobile-nav-close" onclick="closeMobileNavDrawer()" aria-label="Kapat">&times;</button>
        </div>

        <div class="mobile-nav-body">
            <!-- Profil / Giriş Kartı -->
            <div class="mobile-user-card">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="mobile-user-info">
                        <div class="mobile-avatar">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="8" r="4.5"></circle>
                                <path d="M4 21c0-4 3.5-6.5 8-6.5s8 2.5 8 6.5"></path>
                            </svg>
                        </div>
                        <div class="mobile-user-details">
                            <span class="mobile-user-name">@User.Identity.Name</span>
                            <span class="mobile-user-company">@(currentCompName ?? "Kurumsal Firma")</span>
                        </div>
                    </div>
                    <div class="mobile-user-links">
                        <a asp-controller="Account" asp-action="Profile" class="mobile-sublink" onclick="closeMobileNavDrawer()">Hesabım &amp; Firma</a>
                        <a asp-controller="Dashboard" asp-action="Orders" class="mobile-sublink" onclick="closeMobileNavDrawer()">Siparişlerim</a>
                        <a asp-controller="Account" asp-action="Logout" class="mobile-sublink text-rose-600 font-bold" onclick="closeMobileNavDrawer()">Çıkış Yap</a>
                    </div>
                }
                else
                {
                    <div class="mobile-auth-actions">
                        <a asp-controller="Account" asp-action="Login" class="btn-mobile-auth-login" onclick="closeMobileNavDrawer()">
                            Oturum Aç
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn-mobile-auth-register" onclick="closeMobileNavDrawer()">
                            Üye Ol
                        </a>
                    </div>
                }
            </div>

            <!-- Hızlı Panel Linki -->
            <a asp-controller="Dashboard" asp-action="Index" class="mobile-dashboard-cta" onclick="closeMobileNavDrawer()">
                <div class="flex items-center gap-2.5">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                        <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                        <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                        <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                    </svg>
                    <span>Tedarik Portalı Paneli</span>
                </div>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
            </a>

            <!-- Gezinme Linkleri -->
            <div class="mobile-nav-section-title">MENÜ</div>
            <nav class="mobile-nav-links">
                <a asp-controller="Home" asp-action="Index" class="mobile-nav-item" onclick="closeMobileNavDrawer()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                    <span>Ana Sayfa</span>
                </a>
                <a asp-controller="Home" asp-action="Kurumsal" class="mobile-nav-item" onclick="closeMobileNavDrawer()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                    <span>Kurumsal</span>
                </a>
                <a href="javascript:void(0)" class="mobile-nav-item" onclick="closeMobileNavDrawer(); handleMobileBottomCategories();">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                    <span>Ürün Kategorileri</span>
                </a>
                <a asp-controller="Home" asp-action="NedenPortal" class="mobile-nav-item" onclick="closeMobileNavDrawer()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    <span>Neden Portal?</span>
                </a>
                <a asp-controller="Home" asp-action="Fiyatlandirma" class="mobile-nav-item" onclick="closeMobileNavDrawer()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    <span>Fiyatlandırma</span>
                </a>
                <a asp-controller="Home" asp-action="MedyaDuyurular" class="mobile-nav-item" onclick="closeMobileNavDrawer()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"></path><path d="M18 14h-8"></path><path d="M15 18h-5"></path><path d="M10 6h8v4h-8V6Z"></path></svg>
                    <span>Medya &amp; Duyurular</span>
                </a>
                <a asp-controller="Home" asp-action="Iletisim" class="mobile-nav-item" onclick="closeMobileNavDrawer()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                    <span>İletişim</span>
                </a>
            </nav>

            <div class="mobile-nav-footer">
                <div class="flex items-center justify-between text-xs text-slate-500 pt-4 border-t border-slate-200">
                    <span>Dil / Dil Seçimi</span>
                    <span class="font-bold text-slate-800 inline-flex items-center gap-1.5">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-500">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                        </svg>
                        Türkçe (TR)
                    </span>
                </div>
            </div>
        </div>
    </aside>

    <!-- Telefonlar İçin Sabit Mobil Alt Gezinme Barı (Mobile Bottom Bar) -->
    <nav class="mobile-bottom-bar" aria-label="Hızlı Gezinme">
        <a href="/" class="bottom-bar-item is-active" title="Ana Sayfa">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span>Ana Sayfa</span>
        </a>
        <button type="button" class="bottom-bar-item" onclick="handleMobileBottomCategories()" title="Kategoriler">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
            </svg>
            <span>Kategoriler</span>
        </button>
        <button type="button" class="bottom-bar-item bottom-bar-cta" onclick="handleMobileBottomAddListing()" title="İlan Ver">
            <div class="cta-circle">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
            </div>
            <span>İlan Ver</span>
        </button>
        <button type="button" class="bottom-bar-item relative" onclick="handleMobileBottomCart()" title="Sepetim">
            <div class="relative inline-flex">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                <span id="bottomNavCartBadge" class="mobile-bottom-badge">0</span>
            </div>
            <span>Sepetim</span>
        </button>
        <a asp-controller="Dashboard" asp-action="Index" class="bottom-bar-item" title="Panelim">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="8" r="4.5"></circle>
                <path d="M4 21c0-4 3.5-6.5 8-6.5s8 2.5 8 6.5"></path>
            </svg>
            <span>Panelim</span>
        </a>
    </nav>

    <div class="blue-portal-wrapper">
        @RenderBody()

        <!-- Floating Live Support Button -->
        <a href="#destek" class="blue-live-support-btn">
            <div class="support-circle">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
            </div>
            <span class="support-text">Canlı Destek</span>
        </a>

        <!-- Footer -->
        <footer class="dark-footer">
            <div class="footer-container">
                <div class="footer-left">
                    <div class="footer-logo">
                        <div class="logo-icon">T</div>
                        <span class="logo-text">Tedarik <span class="highlight">Portalı</span></span>
                    </div>
                    <p class="footer-desc">
                        Türkiye'nin 81 ilindeki kurumsal alıcılar ve doğrulanmış tedarikçileri tek çatı altında toplayan B2B satın alma portalı.
                    </p>
                </div>
                <div class="footer-right">
                    <div class="footer-links">
                        <a href="#">Kullanım Koşulları</a>
                        <a href="#">Gizlilik Sözleşmesi</a>
                        <a href="#">KVKK Aydınlatma</a>
                        <a href="#">Bize Ulaşın</a>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- GİRİŞ BAŞARILI MODAL -->
    @if (TempData["LoginSuccess"] != null)
    {
        <div id="loginSuccessModal" class="blur-modal-overlay">
            <div class="blur-modal-box">
                <div class="blur-modal-tag blur-tag-login">GİRİŞ BAŞARILI</div>
                <div class="blur-modal-icon-badge blur-modal-icon-badge-login">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                        <polyline points="10 17 15 12 10 7"></polyline>
                        <line x1="15" y1="12" x2="3" y2="12"></line>
                    </svg>
                </div>
                <h3 class="blur-modal-title">Tekrar Hoş Geldiniz!</h3>
                <p class="blur-modal-desc">
                    Portal hesabınıza başarıyla giriş yapıldı. İşletmeniz için tanımlı tüm satın alma taleplerini ve tedarik süreçlerini yönetmeye başlayabilirsiniz.
                </p>
                <button type="button" class="blur-modal-btn" onclick="closeModal('loginSuccessModal')">
                    Portala Devam Et
                </button>
            </div>
        </div>
    }

    <!-- KAYIT BAŞARILI MODAL -->
    @if (TempData["RegisterSuccess"] != null)
    {
        <div id="registerSuccessModal" class="blur-modal-overlay">
            <div class="blur-modal-box">
                <div class="blur-modal-tag">KURUMSAL ÜYELİK AKTİF</div>
                <div class="blur-modal-icon-badge">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <h3 class="blur-modal-title">Aramıza Hoş Geldiniz!</h3>
                <p class="blur-modal-desc">
                    Satın alma portalı hesabınız başarıyla oluşturuldu ve oturumunuz açıldı. Tüm tedarikçi ağına, teklif yönetimine ve dijital satın alma araçlarına anında erişebilirsiniz.
                </p>
                <button type="button" class="blur-modal-btn" onclick="closeModal('registerSuccessModal')">
                    Portalı Keşfetmeye Başla
                </button>
            </div>
        </div>
    }

    <!-- OTURUM KAPATILDI MODAL -->
    @if (TempData["LogoutSuccess"] != null)
    {
        <div id="logoutSuccessModal" class="blur-modal-overlay">
            <div class="blur-modal-box">
                <div class="blur-modal-tag blur-tag-logout">GÜVENLİ ÇIKIŞ</div>
                <div class="blur-modal-icon-badge blur-modal-icon-badge-logout">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        <path d="m9 12 2 2 4-4"></path>
                    </svg>
                </div>
                <h3 class="blur-modal-title">Oturumunuz Güvenle Kapatıldı</h3>
                <p class="blur-modal-desc">
                    Portal hesabınızdan başarıyla çıkış yapıldı. İşletmenizin tüm verileri ve oturum bilgileriniz koruma altındadır. Dilediğiniz zaman tekrar giriş yapabilirsiniz.
                </p>
                <button type="button" class="blur-modal-btn blur-modal-btn-dark" onclick="closeModal('logoutSuccessModal')">
                    Ana Sayfaya Dön
                </button>
            </div>
        </div>
    }

    <script>
        function closeModal(modalId) {
            var modal = document.getElementById(modalId);
            if (modal) {
                modal.style.opacity = "0";
                modal.style.transition = "opacity 0.3s ease";
                setTimeout(function () { modal.remove(); }, 300);
            }
        }
        setTimeout(function () {
            closeModal('loginSuccessModal');
            closeModal('registerSuccessModal');
            closeModal('logoutSuccessModal');
        }, 6000);

        // Mobil Gezinme Çekmecesi (Offcanvas)
        function toggleMobileNavDrawer() {
            var drawer = document.getElementById('mobileNavDrawer');
            var overlay = document.getElementById('mobileNavDrawerOverlay');
            if (!drawer || !overlay) return;
            var isOpen = drawer.classList.contains('is-open');
            if (isOpen) {
                closeMobileNavDrawer();
            } else {
                drawer.classList.add('is-open');
                overlay.classList.add('is-open');
                document.body.classList.add('mobile-nav-locked');
            }
        }

        function closeMobileNavDrawer() {
            var drawer = document.getElementById('mobileNavDrawer');
            var overlay = document.getElementById('mobileNavDrawerOverlay');
            if (drawer) drawer.classList.remove('is-open');
            if (overlay) overlay.classList.remove('is-open');
            document.body.classList.remove('mobile-nav-locked');
        }

        // Mobil Alt Bar (Bottom Bar) Eylemleri
        function handleMobileBottomCategories() {
            if (typeof openMobileCategoryModal === 'function') {
                openMobileCategoryModal();
            } else {
                window.location.href = '/?openCategories=1';
            }
        }

        function handleMobileBottomAddListing() {
            if (typeof openSellerOfferModal === 'function') {
                openSellerOfferModal();
            } else {
                window.location.href = '/Dashboard/Listings';
            }
        }

        function handleMobileBottomCart() {
            var drawerOverlay = document.getElementById('b2bCartDrawerOverlay');
            if (drawerOverlay && typeof openCartDrawer === 'function') {
                openCartDrawer();
            } else {
                window.location.href = '/Cart';
            }
        }
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/realtime-portal.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
