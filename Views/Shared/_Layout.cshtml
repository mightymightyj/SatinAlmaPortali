<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tedarik Portalı</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/satinalmaportali2.styles.css" asp-append-version="true" />
</head>
<body>
    
    <!-- Top Navigation Header -->
    <header class="blue-top-header">
        <div class="header-container">
            <!-- Brand Logo -->
            <a class="brand-logo" href="~/">
                <span class="logo-badge">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                        <polyline points="2 17 12 22 22 17"></polyline>
                        <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                </span>
                <span class="logo-title">tedarik<span class="logo-blue-dot">.portal</span></span>
            </a>

            <!-- Navigation Links -->
            <nav class="center-nav">
                <a asp-controller="Home" asp-action="Kurumsal" class="nav-link">Kurumsal</a>
                <a asp-controller="Home" asp-action="UrunKategorileri" class="nav-link">Ürün Kategorileri</a>
                <a asp-controller="Home" asp-action="NedenPortal" class="nav-link">Neden Portal?</a>
                <a asp-controller="Home" asp-action="Fiyatlandirma" class="nav-link">Fiyatlandırma</a>
                <a asp-controller="Home" asp-action="MedyaDuyurular" class="nav-link">Medya & Duyurular</a>
                <a asp-controller="Home" asp-action="Iletisim" class="nav-link">İletişim</a>
            </nav>

            <!-- Header Right Actions -->
            <div class="right-actions">
                <a href="#portal" class="btn-royal-pill">
                    Tedarik Portalı
                </a>

                <div class="lang-pill">
                    <span class="flag">🇹🇷</span>
                    <span class="code">TR</span>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M6 9l6 6 6-6"/>
                    </svg>
                </div>

                <a href="#auth-section" class="profile-avatar-btn" title="Hesabım">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <span>Hesabım</span>
                </a>
            </div>
        </div>
    </header>

    <div class="blue-portal-wrapper">

        <!-- Left Floating Vertical Icon Sidebar -->
        <aside class="floating-icon-bar">
            <div class="vertical-icon-pill">
                <button class="icon-nav-btn active" title="Tüm Kategoriler">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12.55a11 11 0 0 1 14.08 0"></path>
                        <path d="M1.42 9a16 16 0 0 1 21.16 0"></path>
                        <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
                        <line x1="12" y1="20" x2="12.01" y2="20"></line>
                    </svg>
                </button>
                <button class="icon-nav-btn" title="Kategori 1">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                    <line x1="8" y1="21" x2="16" y2="21"></line>
                    <line x1="12" y1="17" x2="12" y2="21"></line>
                </button>
                <button class="icon-nav-btn" title="Kategori 2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </button>
                <button class="icon-nav-btn" title="Kategori 3">
                    <polyline points="6 9 6 2 18 2 18 9"></polyline>
                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                    <rect x="6" y="14" width="12" height="8"></rect>
                </button>
                <button class="icon-nav-btn" title="Kategori 4">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01M6 12h.01M10 12h.01M14 12h.01M18 12h.01M6 16h12"></path>
                </button>
                <button class="icon-nav-btn" title="Kategori 5">
                    <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                    <line x1="12" y1="17" x2="12" y2="21"></line>
                    <line x1="8" y1="21" x2="16" y2="21"></line>
                </button>
                <button class="icon-nav-btn" title="Kategori 6">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </button>
                <button class="icon-nav-btn" title="Kategori 7">
                    <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                    <line x1="12" y1="18" x2="12.01" y2="18"></line>
                </button>
            </div>
        </aside>

        @RenderBody()

        <!-- Floating Live Support Button -->
        <a href="#destek" class="blue-live-support-btn">
            <div class="support-circle">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
            </div>
            <span class="support-text">Canlı Destek</span>
        </a>

        <!-- FOOTER -->
        <footer class="dark-footer">
            <div class="footer-container">
                <div class="footer-left">
                    <div class="footer-logo">
                        <div class="logo-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                <line x1="12" y1="22.08" x2="12" y2="12"></line>
                            </svg>
                        </div>
                        <h2>tedarik<span>.portal</span></h2>
                    </div>
                    <p class="footer-desc">
                        Türkiye'nin 81 ilindeki kurumsal alıcılar ve doğrulanmış tedarikçileri tek çatı altında toplayan B2B satın alma portalı.
                    </p>
                </div>
                <div class="footer-right">
                    <div class="footer-links">
                        <a href="#">Kullanım Koşulları</a>
                        <a href="#">Gizlilik Sözleşmesi</a>
                        <a href="#">KVKK Aydınlatma</a>
                        <a href="#">Bize Ulaşın</a>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
