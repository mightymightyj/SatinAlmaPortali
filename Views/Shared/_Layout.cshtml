<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tedarik Portalı</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/satinalmaportali2.styles.css" asp-append-version="true" />
</head>
<body>
    
    <!-- Top Navigation Header -->
    <header class="blue-top-header">
        <div class="header-container">
            <!-- Brand Logo -->
            <a class="brand-logo" href="~/">
                <span class="logo-badge">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                        <polyline points="2 17 12 22 22 17"></polyline>
                        <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                </span>
                <span class="logo-title">tedarik<span class="logo-blue-dot">.portal</span></span>
            </a>

            <!-- Navigation Links -->
            <nav class="center-nav">
                <a asp-controller="Home" asp-action="Kurumsal" class="nav-link">Kurumsal</a>
                <a asp-controller="Home" asp-action="UrunKategorileri" class="nav-link">Ürün Kategorileri</a>
                <a asp-controller="Home" asp-action="NedenPortal" class="nav-link">Neden Portal?</a>
                <a asp-controller="Home" asp-action="Fiyatlandirma" class="nav-link">Fiyatlandırma</a>
                <a asp-controller="Home" asp-action="MedyaDuyurular" class="nav-link">Medya & Duyurular</a>
                <a asp-controller="Home" asp-action="Iletisim" class="nav-link">İletişim</a>
            </nav>

            <!-- Header Right Actions -->
            <div class="right-actions">
                <a asp-controller="Cart" asp-action="Index" class="btn-cart-nav" title="Kurumsal Sepetim" style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.25); color: #fff; border-radius: 9999px; padding: 6px 14px; display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 0.85rem; cursor: pointer; text-decoration: none; transition: all 0.2s;">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    <span>Sepetim</span>
                    <span id="navCartBadge" class="nav-cart-badge" style="background: #ef4444; color: #fff; font-size: 0.72rem; padding: 1px 7px; border-radius: 9999px; font-weight: 800;">0</span>
                </a>

                <a asp-controller="Dashboard" asp-action="Index" class="btn-royal-pill">
                    Tedarik Portalı
                </a>

                <div class="lang-pill">
                    <span class="flag">🇹🇷</span>
                    <span class="code">TR</span>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M6 9l6 6 6-6"/>
                    </svg>
                </div>

                <div class="profile-dropdown-wrapper">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Account" asp-action="Profile" class="profile-avatar-btn" title="Hesabım" aria-label="Hesabım">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="8" r="4.5"></circle>
                                <path d="M4 21c0-4 3.5-6.5 8-6.5s8 2.5 8 6.5"></path>
                            </svg>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="profile-avatar-btn" title="Oturum İşlemleri" aria-label="Oturum Aç">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="8" r="4.5"></circle>
                                <path d="M4 21c0-4 3.5-6.5 8-6.5s8 2.5 8 6.5"></path>
                            </svg>
                        </a>
                    }

                    <div class="profile-dropdown-menu">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown-user-header">
                                <span class="user-email-badge">@User.Identity.Name</span>
                            </div>
                            <a asp-controller="Account" asp-action="Profile" class="dropdown-item btn-account">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="8" r="4.5"></circle>
                                    <path d="M4 21c0-4 3.5-6.5 8-6.5s8 2.5 8 6.5"></path>
                                </svg>
                                Hesabım
                            </a>
                            <a asp-controller="Account" asp-action="Logout" class="dropdown-item btn-logout-red">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                    <polyline points="16 17 21 12 16 7"></polyline>
                                    <line x1="21" y1="12" x2="9" y2="12"></line>
                                </svg>
                                Oturum Kapat
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" asp-route-tab="user-login" class="dropdown-item btn-login">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                                    <polyline points="10 17 15 12 10 7"></polyline>
                                    <line x1="15" y1="12" x2="3" y2="12"></line>
                                </svg>
                                Oturum Aç
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="dropdown-item btn-register">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="8.5" cy="7" r="4"></circle>
                                    <line x1="20" y1="8" x2="20" y2="14"></line>
                                    <line x1="23" y1="11" x2="17" y2="11"></line>
                                </svg>
                                Üye Ol
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="blue-portal-wrapper">
        @RenderBody()

        <!-- Floating Live Support Button -->
        <a href="#destek" class="blue-live-support-btn">
            <div class="support-circle">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
            </div>
            <span class="support-text">Canlı Destek</span>
        </a>

        <!-- Footer -->
        <footer class="dark-footer">
            <div class="footer-container">
                <div class="footer-left">
                    <div class="footer-logo">
                        <div class="logo-icon">T</div>
                        <span class="logo-text">Tedarik <span class="highlight">Portalı</span></span>
                    </div>
                    <p class="footer-desc">
                        Türkiye'nin 81 ilindeki kurumsal alıcılar ve doğrulanmış tedarikçileri tek çatı altında toplayan B2B satın alma portalı.
                    </p>
                </div>
                <div class="footer-right">
                    <div class="footer-links">
                        <a href="#">Kullanım Koşulları</a>
                        <a href="#">Gizlilik Sözleşmesi</a>
                        <a href="#">KVKK Aydınlatma</a>
                        <a href="#">Bize Ulaşın</a>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- GİRİŞ BAŞARILI MODAL -->
    @if (TempData["LoginSuccess"] != null)
    {
        <div id="loginSuccessModal" class="blur-modal-overlay">
            <div class="blur-modal-box">
                <div class="blur-modal-tag blur-tag-login">GİRİŞ BAŞARILI</div>
                <div class="blur-modal-icon-badge blur-modal-icon-badge-login">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                        <polyline points="10 17 15 12 10 7"></polyline>
                        <line x1="15" y1="12" x2="3" y2="12"></line>
                    </svg>
                </div>
                <h3 class="blur-modal-title">Tekrar Hoş Geldiniz!</h3>
                <p class="blur-modal-desc">
                    Portal hesabınıza başarıyla giriş yapıldı. İşletmeniz için tanımlı tüm satın alma taleplerini ve tedarik süreçlerini yönetmeye başlayabilirsiniz.
                </p>
                <button type="button" class="blur-modal-btn" onclick="closeModal('loginSuccessModal')">
                    Portala Devam Et
                </button>
            </div>
        </div>
    }

    <!-- KAYIT BAŞARILI MODAL -->
    @if (TempData["RegisterSuccess"] != null)
    {
        <div id="registerSuccessModal" class="blur-modal-overlay">
            <div class="blur-modal-box">
                <div class="blur-modal-tag">KURUMSAL ÜYELİK AKTİF</div>
                <div class="blur-modal-icon-badge">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <h3 class="blur-modal-title">Aramıza Hoş Geldiniz!</h3>
                <p class="blur-modal-desc">
                    Satın alma portalı hesabınız başarıyla oluşturuldu ve oturumunuz açıldı. Tüm tedarikçi ağına, teklif yönetimine ve dijital satın alma araçlarına anında erişebilirsiniz.
                </p>
                <button type="button" class="blur-modal-btn" onclick="closeModal('registerSuccessModal')">
                    Portalı Keşfetmeye Başla
                </button>
            </div>
        </div>
    }

    <!-- OTURUM KAPATILDI MODAL -->
    @if (TempData["LogoutSuccess"] != null)
    {
        <div id="logoutSuccessModal" class="blur-modal-overlay">
            <div class="blur-modal-box">
                <div class="blur-modal-tag blur-tag-logout">GÜVENLİ ÇIKIŞ</div>
                <div class="blur-modal-icon-badge blur-modal-icon-badge-logout">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        <path d="m9 12 2 2 4-4"></path>
                    </svg>
                </div>
                <h3 class="blur-modal-title">Oturumunuz Güvenle Kapatıldı</h3>
                <p class="blur-modal-desc">
                    Portal hesabınızdan başarıyla çıkış yapıldı. İşletmenizin tüm verileri ve oturum bilgileriniz koruma altındadır. Dilediğiniz zaman tekrar giriş yapabilirsiniz.
                </p>
                <button type="button" class="blur-modal-btn blur-modal-btn-dark" onclick="closeModal('logoutSuccessModal')">
                    Ana Sayfaya Dön
                </button>
            </div>
        </div>
    }

    <script>
        function closeModal(modalId) {
            var modal = document.getElementById(modalId);
            if (modal) {
                modal.style.opacity = "0";
                modal.style.transition = "opacity 0.3s ease";
                setTimeout(function () { modal.remove(); }, 300);
            }
        }
        setTimeout(function () {
            closeModal('loginSuccessModal');
            closeModal('registerSuccessModal');
            closeModal('logoutSuccessModal');
        }, 6000);
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
