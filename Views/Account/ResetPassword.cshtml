@{
    ViewData["Title"] = "Şifre Sıfırlama";
    Layout = "_Layout";
}

<div class="account-page-wrapper">
    <section id="auth-section" class="auth-section">
        <div class="auth-shell reset-password-shell">
            <!-- Üst İkon ve Başlık -->
            <div class="reset-header">
                <div class="reset-icon-wrap">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                </div>
                <h2 class="reset-title">Yeni Şifrenizi Belirleyin</h2>
                <p class="reset-subtitle">Hesabınız için güçlü ve güvenli bir şifre oluşturun.</p>
            </div>

            <div class="auth-panel active" id="reset-password-panel">
                @if (ViewData["ResetError"] != null)
                {
                    <div class="auth-error-msg">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                        <span>@ViewData["ResetError"]</span>
                    </div>
                }

                @if (ViewData["ResetSuccess"] != null)
                {
                    <div class="auth-success-msg">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                        <span>@ViewData["ResetSuccess"]</span>
                    </div>
                }

                <form class="auth-form" method="post" asp-action="ResetPasswordSubmit" id="resetPasswordForm">
                    <input type="hidden" name="token" value="@ViewData["Token"]" />
                    <input type="hidden" name="email" value="@ViewData["Email"]" />

                    <!-- Yeni Şifre -->
                    <div class="reset-field-group">
                        <label class="reset-label" for="resetPass">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            Yeni Şifre
                        </label>
                        <div class="reset-input-wrapper">
                            <input type="password" name="password" id="resetPass" placeholder="Yeni şifrenizi girin" required minlength="8" autocomplete="new-password" />
                            <button type="button" class="toggle-pass-btn" id="togglePass1" aria-label="Şifreyi göster/gizle">
                                <svg class="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                <svg class="eye-off-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <!-- Şifre Tekrar -->
                    <div class="reset-field-group">
                        <label class="reset-label" for="resetPassConfirm">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                            </svg>
                            Şifre Tekrar
                        </label>
                        <div class="reset-input-wrapper">
                            <input type="password" name="confirmPassword" id="resetPassConfirm" placeholder="Şifrenizi tekrar girin" required minlength="8" autocomplete="new-password" />
                            <button type="button" class="toggle-pass-btn" id="togglePass2" aria-label="Şifreyi göster/gizle">
                                <svg class="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                <svg class="eye-off-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            </button>
                        </div>
                        <div class="password-match-indicator" id="matchIndicator" style="display:none;">
                            <span class="match-icon" id="matchIcon"></span>
                            <span class="match-text" id="matchText"></span>
                        </div>
                    </div>

                    <!-- Şifre Güçlülük Göstergesi -->
                    <div class="password-strength-section">
                        <div class="strength-bar-container">
                            <div class="strength-bar" id="strengthBar"></div>
                        </div>
                        <span class="strength-label" id="strengthLabel">Şifre gücü</span>
                    </div>

                    <!-- Şifre Gereksinimleri -->
                    <div class="password-requirements">
                        <ul class="password-req-list">
                            <li id="req-length" class="req-item">
                                <span class="req-check">✗</span>
                                En az 8 karakter
                            </li>
                            <li id="req-upper" class="req-item">
                                <span class="req-check">✗</span>
                                En az 1 büyük harf (A-Z)
                            </li>
                            <li id="req-lower" class="req-item">
                                <span class="req-check">✗</span>
                                En az 1 küçük harf (a-z)
                            </li>
                            <li id="req-number" class="req-item">
                                <span class="req-check">✗</span>
                                En az 1 rakam (0-9)
                            </li>
                            <li id="req-special" class="req-item">
                                <span class="req-check">✗</span>
                                En az 1 özel karakter (!@@#$%^&amp;*)
                            </li>
                        </ul>
                    </div>

                    <!-- Şifreyi Değiştir Butonu -->
                    <button type="submit" class="auth-submit reset-submit-btn" id="resetSubmitBtn" disabled>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                            <polyline points="17 21 17 13 7 13 7 21"></polyline>
                            <polyline points="7 3 7 8 15 8"></polyline>
                        </svg>
                        Şifreyi Değiştir
                    </button>

                    <a asp-action="Login" class="auth-link reset-back-link">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="19" y1="12" x2="5" y2="12"></line>
                            <polyline points="12 19 5 12 12 5"></polyline>
                        </svg>
                        Giriş ekranına dön
                    </a>
                </form>
            </div>
        </div>
    </section>
</div>

<style>
    /* ========================================
       RESET PASSWORD - PROFESSIONAL STYLES
       ======================================== */
    .reset-password-shell {
        max-width: 480px;
    }

    .reset-header {
        text-align: center;
        margin-bottom: 28px;
    }

    .reset-icon-wrap {
        width: 64px;
        height: 64px;
        background: linear-gradient(135deg, #eff6ff, #dbeafe);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.1);
    }

    .reset-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0 0 6px;
    }

    .reset-subtitle {
        font-size: 0.9rem;
        color: #64748b;
        margin: 0;
    }

    /* Field Groups */
    .reset-field-group {
        margin-bottom: 18px;
    }

    .reset-label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        color: #334155;
        margin-bottom: 6px;
    }

    .reset-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .reset-input-wrapper input {
        width: 100%;
        padding: 12px 44px 12px 14px;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        font-size: 0.95rem;
        color: #1e293b;
        background: #f8fafc;
        transition: all 0.25s ease;
        outline: none;
    }

    .reset-input-wrapper input:focus {
        border-color: #3b82f6;
        background: #fff;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
    }

    .toggle-pass-btn {
        position: absolute;
        right: 10px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        transition: background 0.2s ease;
    }

    .toggle-pass-btn:hover {
        background: #f1f5f9;
    }

    /* Password Match Indicator */
    .password-match-indicator {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 6px;
        font-size: 0.8rem;
        font-weight: 500;
        transition: all 0.25s ease;
    }

    .password-match-indicator.match {
        color: #16a34a;
    }

    .password-match-indicator.no-match {
        color: #dc2626;
    }

    /* Strength Bar */
    .password-strength-section {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
    }

    .strength-bar-container {
        flex: 1;
        height: 6px;
        background: #e2e8f0;
        border-radius: 3px;
        overflow: hidden;
    }

    .strength-bar {
        height: 100%;
        width: 0%;
        border-radius: 3px;
        transition: width 0.4s ease, background 0.4s ease;
    }

    .strength-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #94a3b8;
        min-width: 70px;
        text-align: right;
        transition: color 0.3s ease;
    }

    /* Requirements */
    .password-requirements {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 14px 18px;
        margin-bottom: 20px;
    }

    .password-req-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .req-item {
        font-size: 0.82rem;
        color: #94a3b8;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: color 0.25s ease;
    }

    .req-check {
        width: 18px;
        height: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 0.65rem;
        font-weight: 700;
        background: #f1f5f9;
        color: #cbd5e1;
        border: 1.5px solid #e2e8f0;
        transition: all 0.25s ease;
        flex-shrink: 0;
    }

    .req-item.met .req-check {
        background: #dcfce7;
        color: #16a34a;
        border-color: #86efac;
    }

    .req-item.met {
        color: #16a34a;
    }

    .req-item.unmet .req-check {
        background: #fef2f2;
        color: #dc2626;
        border-color: #fecaca;
    }

    .req-item.unmet {
        color: #dc2626;
    }

    /* Submit Button */
    .reset-submit-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 14px 24px;
        font-size: 0.95rem;
        font-weight: 700;
        transition: all 0.3s ease;
    }

    .reset-submit-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
    }

    .reset-submit-btn:not(:disabled):hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(37, 99, 235, 0.3);
    }

    /* Back Link */
    .reset-back-link {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-top: 12px;
        font-size: 0.85rem;
        text-decoration: none;
    }

    .reset-back-link:hover svg {
        transform: translateX(-3px);
        transition: transform 0.2s ease;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var passInput = document.getElementById("resetPass");
        var confirmInput = document.getElementById("resetPassConfirm");
        var submitBtn = document.getElementById("resetSubmitBtn");
        var strengthBar = document.getElementById("strengthBar");
        var strengthLabel = document.getElementById("strengthLabel");
        var matchIndicator = document.getElementById("matchIndicator");
        var matchIcon = document.getElementById("matchIcon");
        var matchText = document.getElementById("matchText");

        // Toggle password visibility
        function setupToggle(btnId, inputId) {
            var btn = document.getElementById(btnId);
            var input = document.getElementById(inputId);
            var eyeIcon = btn.querySelector(".eye-icon");
            var eyeOffIcon = btn.querySelector(".eye-off-icon");

            btn.addEventListener("click", function () {
                if (input.type === "password") {
                    input.type = "text";
                    eyeIcon.style.display = "none";
                    eyeOffIcon.style.display = "block";
                } else {
                    input.type = "password";
                    eyeIcon.style.display = "block";
                    eyeOffIcon.style.display = "none";
                }
            });
        }

        setupToggle("togglePass1", "resetPass");
        setupToggle("togglePass2", "resetPassConfirm");

        // Requirements check functions
        var checks = [
            { id: "req-length", test: function (p) { return p.length >= 8; } },
            { id: "req-upper", test: function (p) { return /[A-Z]/.test(p); } },
            { id: "req-lower", test: function (p) { return /[a-z]/.test(p); } },
            { id: "req-number", test: function (p) { return /[0-9]/.test(p); } },
            { id: "req-special", test: function (p) { return /[!@@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(p); } }
        ];

        function validatePassword() {
            var pw = passInput.value;
            var metCount = 0;

            for (var i = 0; i < checks.length; i++) {
                var el = document.getElementById(checks[i].id);
                var checkSpan = el.querySelector(".req-check");

                if (checks[i].test(pw)) {
                    el.classList.add("met");
                    el.classList.remove("unmet");
                    checkSpan.textContent = "✓";
                    metCount++;
                } else {
                    el.classList.remove("met");
                    checkSpan.textContent = "✗";
                    if (pw.length > 0) {
                        el.classList.add("unmet");
                    } else {
                        el.classList.remove("unmet");
                    }
                }
            }

            // Strength bar update
            var percent = (metCount / checks.length) * 100;
            strengthBar.style.width = percent + "%";

            if (metCount === 0) {
                strengthBar.style.background = "#e2e8f0";
                strengthLabel.textContent = "Şifre gücü";
                strengthLabel.style.color = "#94a3b8";
            } else if (metCount <= 2) {
                strengthBar.style.background = "#ef4444";
                strengthLabel.textContent = "Zayıf";
                strengthLabel.style.color = "#ef4444";
            } else if (metCount <= 3) {
                strengthBar.style.background = "#f59e0b";
                strengthLabel.textContent = "Orta";
                strengthLabel.style.color = "#f59e0b";
            } else if (metCount <= 4) {
                strengthBar.style.background = "#22c55e";
                strengthLabel.textContent = "İyi";
                strengthLabel.style.color = "#22c55e";
            } else {
                strengthBar.style.background = "linear-gradient(90deg, #22c55e, #16a34a)";
                strengthLabel.textContent = "Güçlü";
                strengthLabel.style.color = "#16a34a";
            }

            // Match check
            validateMatch();
        }

        function validateMatch() {
            var pw = passInput.value;
            var confirmVal = confirmInput.value;

            if (confirmVal.length === 0) {
                matchIndicator.style.display = "none";
            } else {
                matchIndicator.style.display = "flex";
                if (pw === confirmVal) {
                    matchIndicator.className = "password-match-indicator match";
                    matchIcon.textContent = "✓";
                    matchText.textContent = "Şifreler eşleşiyor";
                } else {
                    matchIndicator.className = "password-match-indicator no-match";
                    matchIcon.textContent = "✗";
                    matchText.textContent = "Şifreler eşleşmiyor";
                }
            }

            // Enable/disable submit
            var allMet = true;
            for (var i = 0; i < checks.length; i++) {
                if (!checks[i].test(passInput.value)) {
                    allMet = false;
                    break;
                }
            }

            var passwordsMatch = pw.length > 0 && confirmVal.length > 0 && pw === confirmVal;
            submitBtn.disabled = !(allMet && passwordsMatch);
        }

        passInput.addEventListener("input", validatePassword);
        confirmInput.addEventListener("input", validateMatch);
        passInput.addEventListener("input", validateMatch);
    });
</script>
