    function filterProfileOrders() {
        const query = (document.getElementById('profileOrdersSearchInput')?.value || '').toLowerCase().trim();
        const cards = document.querySelectorAll('#profileOrdersListContainer .profile-order-card');

        cards.forEach(card => {
            const status = card.getAttribute('data-order-status') || '';
            const searchHaystack = (card.getAttribute('data-search-text') || '').toLowerCase();

            const matchesStatus = (currentOrderStatusFilter === 'all') || (status === currentOrderStatusFilter);
            const matchesQuery = !query || searchHaystack.includes(query);

            if (matchesStatus && matchesQuery) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    }

    function filterPurchasedProducts() {
        const query = (document.getElementById('purchasedProductsSearchInput')?.value || '').toLowerCase().trim();
        const cards = document.querySelectorAll('#purchasedProductsGrid .purchased-product-card');

        cards.forEach(card => {
            const title = (card.getAttribute('data-product-name') || '').toLowerCase();
            const sku = (card.getAttribute('data-sku') || '').toLowerCase();
            const supplier = (card.getAttribute('data-supplier') || '').toLowerCase();

            const matches = !query || title.includes(query) || sku.includes(query) || supplier.includes(query);
            card.style.display = matches ? 'flex' : 'none';
        });
    }

