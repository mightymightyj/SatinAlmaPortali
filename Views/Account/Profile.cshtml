                        <span class="text-lg">★</span>
                    </div>
                    <div>
                        <h2 class="text-base sm:text-lg font-bold text-slate-900">Firma İtibar Karnesi &amp; 10 Yıldızlı Değerlendirmeler</h2>
                        <span class="text-xs text-slate-500">Alıcı ve tedarikçi iş ortaklarınızın firmanız hakkında paylaştığı doğrulanmış 10★ puanlar</span>
                    </div>
                </div>

                <!-- Scorecard Banner -->
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-4 sm:p-5 rounded-xl bg-gradient-to-br from-amber-500/10 via-amber-50/60 to-orange-500/5 border border-amber-200/60 mb-5">
                    <div>
                        <span class="text-xs font-bold text-amber-700 uppercase tracking-wider block">Genel İtibar &amp; Memnuniyet Skoru</span>
                        <div class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight my-1 flex items-baseline gap-2">
                            <span class="text-amber-500">★</span> @Model.OverallScore.ToString("0.0")
                            <span class="text-sm sm:text-base font-bold text-slate-400">/ 10</span>
                        </div>
                        <div class="flex items-center gap-1 my-1.5">
                            @for (int i = 1; i <= 10; i++)
                            {
                                var filled = i <= Math.Round(Model.OverallScore);
                                <span class="text-lg sm:text-xl @(filled ? "text-amber-500" : "text-slate-200") select-none">★</span>
                            }
                        </div>
                        <span class="text-xs text-slate-500">Toplam @Model.ReceivedReviews.Count Doğrulanmış Değerlendirmeye Dayanıyor</span>
                    </div>

                    <div class="flex flex-col sm:items-end gap-2.5 shrink-0">
                        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold border border-emerald-200/60 shadow-xs">
                            <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                            Onaylı B2B Portal Üyesi
                        </span>
                        <a href="/Seller/@Model.CompanyID" target="_blank" class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-blue-600 hover:text-blue-700 hover:underline transition">
                            <span>Herkese Açık Satıcı Sayfasını Gör</span>
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                        </a>
                    </div>
                </div>

                @if (!Model.ReceivedReviews.Any())
                {
                    <div class="p-8 sm:p-12 rounded-2xl bg-slate-50/70 border-2 border-dashed border-slate-200 text-center flex flex-col items-center justify-center">
                        <div class="w-16 h-16 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center text-3xl mb-4 shadow-inner">
                            ★
                        </div>
                        <h3 class="text-base sm:text-lg font-bold text-slate-800 mb-1.5">Henüz Değerlendirmeniz Bulunmamaktadır</h3>
                        <p class="text-xs sm:text-sm text-slate-500 max-w-md">Tamamlanan satışlarınız veya satın alımlarınız sonrasında iş ortaklarınız değerlendirme yaptıkça 10 yıldızlı puanlar ve yorumlar burada listelenecektir.</p>
                    </div>
                }
                else
                {
                    <div class="space-y-4">
                        @foreach (var r in Model.ReceivedReviews)
                        {
                            var isBuyerToSeller = r.ReviewType == "BuyerToSeller";
                            <div class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-6 shadow-xs hover:shadow-md transition-all border-l-4 @(isBuyerToSeller ? "border-l-amber-500" : "border-l-blue-600")">
                                <!-- Üst Satır: Firma / Yetkili & Sağda 10 Yıldız Rozeti -->
                                <div class="flex items-start justify-between gap-3 pb-3 border-b border-slate-100 mb-3">
                                    <div class="min-w-0 flex-1">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <span class="text-sm sm:text-base font-bold text-slate-900 flex items-center gap-1.5">
                                                <span class="text-base">🏢</span>
                                                <span class="truncate">@r.ReviewerName</span>
                                            </span>
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] sm:text-xs font-bold shrink-0 @(isBuyerToSeller ? "bg-amber-100 text-amber-800" : "bg-blue-100 text-blue-800")">
                                                @(isBuyerToSeller ? "🛒 Alıcı Değerlendirmesi" : "📦 Tedarikçi Değerlendirmesi")
                                            </span>
                                        </div>
                                        <div class="flex flex-wrap items-center gap-x-2.5 gap-y-0.5 text-xs text-slate-400 mt-1.5">
                                            <span class="flex items-center gap-1">
                                                <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                                <span>@r.ReviewDate.ToString("dd.MM.yyyy HH:mm")</span>
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(r.OrderNumber))
                                            {
                                                <span class="text-blue-600 font-semibold font-mono">
                                                    • Sipariş: @r.OrderNumber
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <!-- 10 Yıldız Rozeti -->
                                    <div class="shrink-0">
                                        <div class="flex items-center gap-1 px-2.5 sm:px-3 py-1 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 font-extrabold text-xs sm:text-sm shadow-xs">
                                            <span class="text-amber-500">★</span>
                                            <span>@r.ReviewScore.ToString("0.0")</span>
                                            <span class="text-[10px] text-amber-600/70 font-semibold">/ 10</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Yorum Metni -->
                                @if (!string.IsNullOrWhiteSpace(r.ReviewText))
                                {
                                    <div class="p-3 sm:p-4 rounded-xl bg-slate-50/90 border border-slate-100 text-xs sm:text-sm text-slate-700 leading-relaxed italic flex items-start gap-2.5">
                                        <svg class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="currentColor"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
                                        <span class="flex-1">&ldquo;@r.ReviewText&rdquo;</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

    </div>
</main>

