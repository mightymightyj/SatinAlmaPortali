        <!-- ========================================================================= -->
        <!-- 3. GÜVENLİK & ŞİFRE YÖNETİMİ KARTI                                         -->
        <!-- ========================================================================= -->
        <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-5 sm:p-6 mt-6 hover:shadow-md transition-shadow">
            <div class="flex items-center gap-3 pb-4 border-b border-slate-100 mb-5">
                <div class="w-10 h-10 rounded-xl bg-rose-50 border border-rose-200/60 text-rose-600 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <div>
                    <h2 class="text-base sm:text-lg font-bold text-slate-900">Güvenlik &amp; Şifre Yönetimi</h2>
                    <span class="text-xs text-slate-500">Hesap şifrenizi ve e-posta doğrulama bağlantınızı yönetin</span>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
                <!-- Sol: Mevcut Şifre Durumu -->
                <div class="p-4 rounded-xl bg-slate-50/80 border border-slate-100 flex flex-col justify-between">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Mevcut Şifre Durumu</span>
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[11px] font-bold">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Korumalı
                        </span>
                    </div>
                    <div class="font-mono text-xl text-slate-700 tracking-widest my-1.5">••••••••••••</div>
                    <span class="text-[11px] text-slate-400">Şifreniz Salted SHA-256 algoritmasıyla şifrelenmiştir</span>
                </div>

                <!-- Sağ: Kayıtlı Güvenlik E-Postası -->
                <div class="p-4 rounded-xl bg-slate-50/80 border border-slate-100 flex flex-col justify-between">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Kayıtlı Güvenlik E-Postası</span>
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-800 text-[11px] font-bold">
                            Doğrulanmış
                        </span>
                    </div>
                    <div class="text-sm sm:text-base font-bold text-slate-900 break-all my-1.5">@(Model.CompanyMail ?? "—")</div>
                    <span class="text-[11px] text-slate-400">Şifre sıfırlama bağlantısı bu adrese iletilir</span>
                </div>
            </div>

            <!-- Şifre Sıfırlama Aksiyon Şeridi -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3.5 p-4 rounded-xl bg-blue-50/60 border border-blue-100">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center shrink-0">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    </div>
                    <div>
                        <strong class="text-xs sm:text-sm font-bold text-blue-950 block">Şifrenizi Değiştirmek mi İstiyorsunuz?</strong>
                        <p class="text-xs text-blue-800 mt-0.5">Şifre güvenliğiniz için e-posta adresinize tek kullanımlık şifre sıfırlama linki gönderilir.</p>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="RequestPasswordReset" method="post" onsubmit="handleRequestPasswordReset(event); return false;" class="shrink-0 w-full sm:w-auto">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs sm:text-sm shadow-sm shadow-blue-600/20 transition active:scale-95 cursor-pointer">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                        <span>Şifre Sıfırlama Bağlantısı Gönder</span>
                    </button>
                </form>
            </div>
        </div>
        </div> <!-- /profileTabPanel-profile -->

        <!-- ==================== SEKME: DEĞERLENDİRMELER & İTİBAR KARNESİ ==================== -->
