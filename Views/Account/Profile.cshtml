@model satinalmaportali2.Models.ProfileViewModel
@{
    ViewData["Title"] = "Hesabım";
}

<section class="profile-hero">
    <div class="profile-hero-inner">
        <div class="profile-avatar-circle">
            @{
                var initials = "";
                if (!string.IsNullOrEmpty(Model.CompanyName))
                {
                    var words = Model.CompanyName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                    initials = words.Length >= 2
                        ? $"{words[0][0]}{words[1][0]}".ToUpper()
                        : Model.CompanyName.Substring(0, Math.Min(2, Model.CompanyName.Length)).ToUpper();
                }
                else
                {
                    initials = "?";
                }
            }
            <span class="avatar-initials">@initials</span>
        </div>
        <h1 class="profile-hero-name">@(Model.CompanyName ?? "Firma Adı Belirtilmemiş")</h1>
        <div class="profile-hero-badges">
            <span class="profile-badge profile-badge-type">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                @(Model.CompanyTypeName ?? "Belirtilmemiş")
            </span>
            <span class="profile-badge profile-badge-member">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                @(Model.MembershipTypeName ?? "Standart Üyelik")
            </span>
        </div>
    </div>
</section>

<section class="profile-content-section">
    <div class="profile-container">

        @if (TempData["ProfileSuccess"] != null)
        {
            <div class="profile-alert profile-alert-success">
                <div class="alert-icon-box">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <span>@TempData["ProfileSuccess"]</span>
            </div>
        }

        @if (TempData["ProfileError"] != null)
        {
            <div class="profile-alert profile-alert-error">
                <div class="alert-icon-box">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                </div>
                <span>@TempData["ProfileError"]</span>
            </div>
        }

        <!-- Firma Bilgileri -->
        <div class="profile-card">
            <div class="profile-card-header">
                <div class="profile-card-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                </div>
                <h2>Firma Bilgileri</h2>
            </div>
            <div class="profile-card-body">
                <div class="profile-info-grid">
                    <div class="profile-info-item">
                        <span class="info-label">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                            Firma Adı
                        </span>
                        <span class="info-value">@(Model.CompanyName ?? "—")</span>
                    </div>
                    <div class="profile-info-item">
                        <span class="info-label">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            Firma Yetkilisi
                        </span>
                        <span class="info-value">@(Model.CompanyOfficial ?? "—")</span>
                    </div>
                    <div class="profile-info-item">
                        <span class="info-label">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                            Firma Türü
                        </span>
                        <span class="info-value">@(Model.CompanyTypeName ?? "—")</span>
                    </div>
                    <div class="profile-info-item">
                        <span class="info-label">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                            Üyelik Tipi
                        </span>
                        <span class="info-value">@(Model.MembershipTypeName ?? "—")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- İletişim Bilgileri -->
        <div class="profile-card">
            <div class="profile-card-header">
                <div class="profile-card-icon profile-card-icon-green">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <h2>İletişim Bilgileri</h2>
            </div>
            <div class="profile-card-body">
                <div class="profile-info-grid">
                    <div class="profile-info-item">
                        <span class="info-label">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                            E-posta Adresi
                        </span>
                        <span class="info-value info-value-mail">@(Model.CompanyMail ?? "—")</span>
                    </div>
                    <div class="profile-info-item">
                        <span class="info-label">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                            Telefon
                        </span>
                        <span class="info-value">@(Model.CompanyPhone ?? "—")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Resmi Bilgiler -->
        <div class="profile-card">
            <div class="profile-card-header">
                <div class="profile-card-icon profile-card-icon-amber">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                </div>
                <h2>Resmi Bilgiler</h2>
            </div>
            <div class="profile-card-body">
                <div class="profile-info-grid">
                    <div class="profile-info-item">
                        <span class="info-label">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            TC Kimlik No / Vergi No
                        </span>
                        <span class="info-value info-value-mono">@(Model.TCNO ?? "—")</span>
                    </div>
                    <div class="profile-info-item">
                        <span class="info-label">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                            Vergi Dairesi
                        </span>
                        <span class="info-value">@(Model.TaxOffice ?? "—")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Adres Bilgileri -->
        <div class="profile-card">
            <div class="profile-card-header">
                <div class="profile-card-icon profile-card-icon-purple">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <h2>Adres Bilgileri</h2>
            </div>
            <div class="profile-card-body">
                <div class="profile-info-grid">
                    <div class="profile-info-item profile-info-item-full">
                        <span class="info-label">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            Açık Adres
                        </span>
                        <span class="info-value">@(Model.AddressText ?? "—")</span>
                    </div>
                    <div class="profile-info-item">
                        <span class="info-label">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                            Ülke
                        </span>
                        <span class="info-value">@(Model.CountryName ?? "—")</span>
                    </div>
                    <div class="profile-info-item">
                        <span class="info-label">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                            Şehir
                        </span>
                        <span class="info-value">@(Model.TownName ?? "—")</span>
                    </div>
                    <div class="profile-info-item">
                        <span class="info-label">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            İlçe
                        </span>
                        <span class="info-value">@(Model.DistrictName ?? "—")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Firma Açıklaması -->
        @if (!string.IsNullOrWhiteSpace(Model.CompanyDetailText))
        {
            <div class="profile-card">
                <div class="profile-card-header">
                    <div class="profile-card-icon profile-card-icon-teal">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="17" y1="10" x2="3" y2="10"/><line x1="21" y1="6" x2="3" y2="6"/><line x1="21" y1="14" x2="3" y2="14"/><line x1="17" y1="18" x2="3" y2="18"/></svg>
                    </div>
                    <h2>Firma Açıklaması</h2>
                </div>
                <div class="profile-card-body">
                    <p class="profile-detail-text">@Model.CompanyDetailText</p>
                </div>
            </div>
        }

        <!-- Güvenlik & Şifre Yönetimi -->
        <div class="profile-card">
            <div class="profile-card-header">
                <div class="profile-card-icon profile-card-icon-red">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <div class="profile-header-text">
                    <h2>Güvenlik & Şifre Yönetimi</h2>
                    <span class="profile-header-subtitle">Hesap şifrenizi ve doğrulama ayarlarınızı yönetin</span>
                </div>
            </div>
            <div class="profile-card-body">
                <div class="security-grid-panel">
                    <!-- Sol: Mevcut Şifre Durumu -->
                    <div class="security-item-card">
                        <div class="security-item-top">
                            <div class="security-item-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            </div>
                            <span class="security-item-title">Mevcut Şifre</span>
                        </div>
                        <div class="security-item-value-box">
                            <span class="security-dots">••••••••••••</span>
                            <span class="security-status-tag">
                                <span class="tag-dot"></span> Korumalı
                            </span>
                        </div>
                        <span class="security-item-hint">Şifreniz SHA-256 algoritmasıyla şifrelenmiştir</span>
                    </div>

                    <!-- Sağ: Doğrulama E-Postası -->
                    <div class="security-item-card">
                        <div class="security-item-top">
                            <div class="security-item-icon security-icon-blue">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                            </div>
                            <span class="security-item-title">Kayıtlı Güvenlik E-Postası</span>
                        </div>
                        <div class="security-item-value-box">
                            <span class="security-mail-value">@(Model.CompanyMail ?? "—")</span>
                        </div>
                        <span class="security-item-hint">Şifre sıfırlama bağlantısı bu adrese gönderilir</span>
                    </div>
                </div>

                <!-- Alt Aksiyon Kutusu -->
                <div class="security-action-banner">
                    <div class="security-notice-left">
                        <div class="security-shield-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </div>
                        <div class="security-notice-text">
                            <strong>Şifrenizi Değiştirmek mi İstiyorsunuz?</strong>
                            <p>Butona tıkladığınızda e-posta adresinize 30 dakika geçerli tek kullanımlık güvenli bağlantı iletilecektir.</p>
                        </div>
                    </div>
                    <form asp-controller="Account" asp-action="RequestPasswordReset" method="post" class="security-action-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-security-reset">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                            <span>Şifre Sıfırlama Bağlantısı Gönder</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>

    </div>
</section>
