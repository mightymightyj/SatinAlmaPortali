    function formatFileSize(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
    }

    async function submitAdjustedProfilePhoto() {
        if (!selectedSingleFile || !cropImg.src) {
            showDynamicAlert('Lütfen bir görsel seçiniz.', 'error');
            closePhotoModal();
            return;
        }

        document.getElementById('uploadProgressBox').style.display = 'flex';
        document.getElementById('modalActionsGroup').style.display = 'none';
        document.getElementById('btnConfirmUpload').disabled = true;

        const OUTPUT_SIZE = 500;
        const outCanvas = document.createElement('canvas');
        outCanvas.width = OUTPUT_SIZE;
        outCanvas.height = OUTPUT_SIZE;
        const outCtx = outCanvas.getContext('2d');

        const exportRatio = OUTPUT_SIZE / CROP_CANVAS_SIZE;

        outCtx.save();
        outCtx.translate(OUTPUT_SIZE / 2 + (cropOffsetX * exportRatio), OUTPUT_SIZE / 2 + (cropOffsetY * exportRatio));
        outCtx.rotate((cropRotation * Math.PI) / 180);

        const totalScale = cropBaseScale * cropScale * exportRatio;
        const drawW = cropImg.width * totalScale;
        const drawH = cropImg.height * totalScale;

        outCtx.drawImage(cropImg, -drawW / 2, -drawH / 2, drawW, drawH);
        outCtx.restore();

        outCanvas.toBlob(async function(blob) {
            if (!blob) {
                showDynamicAlert('Görsel işlenirken bir hata oluştu.', 'error');
                closePhotoModal();
                return;
            }

            const formData = new FormData();
            formData.append('profilePhoto', blob, 'profile-photo.jpg');

            const tokenInput = document.querySelector('#hiddenPhotoUploadForm input[name="__RequestVerificationToken"]');
            if (tokenInput) {
                formData.append('__RequestVerificationToken', tokenInput.value);
            }

            try {
                const response = await fetch('/Account/UploadProfilePhoto', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    },
                    body: formData
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    closePhotoModal();
                    showDynamicAlert(result.message || 'Profil fotoğrafınız başarıyla güncellendi!', 'success');
                    updateAvatarUI(result.imageUrl);
                } else {
                    closePhotoModal();
                    showDynamicAlert(result.message || 'Görsel yüklenirken bir hata oluştu.', 'error');
                }
            } catch (err) {
                console.error('Yükleme hatası:', err);
                closePhotoModal();
                showDynamicAlert('Yükleme sırasında bağlantı hatası oluştu.', 'error');
            }
        }, 'image/jpeg', 0.92);
    }

