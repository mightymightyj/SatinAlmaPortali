                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <div class="profile-header-text">
                    <h2>Güvenlik & Şifre Yönetimi</h2>
                    <span class="profile-header-subtitle">Hesap şifrenizi ve e-posta doğrulama bağlantınızı yönetin</span>
                </div>
            </div>
            <div class="profile-card-body">
                <div class="security-grid-panel">
                    <!-- Sol: Mevcut Şifre Durumu -->
                    <div class="security-item-card">
                        <div class="security-item-top">
                            <div class="security-item-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            </div>
                            <span class="security-item-title">Mevcut Şifre</span>
                        </div>
                        <div class="security-item-value-box">
                            <span class="security-dots">••••••••••••</span>
                            <span class="security-status-tag">
                                <span class="tag-dot"></span> Korumalı
                            </span>
                        </div>
                        <span class="security-item-hint">Şifreniz Salted SHA-256 algoritmasıyla şifrelenmiştir</span>
                    </div>

                    <!-- Sağ: Doğrulama E-Postası -->
                    <div class="security-item-card">
                        <div class="security-item-top">
                            <div class="security-item-icon security-icon-blue">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                            </div>
                            <span class="security-item-title">Kayıtlı Güvenlik E-Postası</span>
                        </div>
                        <div class="security-item-value-box">
                            <span class="security-mail-value">@(Model.CompanyMail ?? "—")</span>
                        </div>
                        <span class="security-item-hint">Şifre sıfırlama bağlantısı bu adrese gönderilir</span>
                    </div>
                </div>

                <!-- Alt Aksiyon Kutusu -->
                <div class="security-action-banner">
                    <div class="security-notice-left">
                        <div class="security-shield-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </div>
                        <div class="security-notice-text">
                            <strong>Şifrenizi Değiştirmek mi İstiyorsunuz?</strong>
                            <p>Şifre güvenliğiniz için e-posta adresinize tek kullanımlık şifre sıfırlama linki gönderilir.</p>
                        </div>
                    </div>
                    <form asp-controller="Account" asp-action="RequestPasswordReset" method="post" class="security-action-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-security-reset">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                            <span>Şifre Sıfırlama Bağlantısı Gönder</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- Single File Input (NO multiple allowed) -->
<input type="file" id="profilePhotoInput" accept="image/jpeg, image/png, image/webp, image/gif, image/jpg" style="display: none;" onchange="handleSingleFileSelected(this)" />

<!-- Live Interactive Adjust & Upload Modal -->
<div id="photoPreviewModal" class="blur-modal-overlay" style="display: none;">
    <div class="blur-modal-box photo-preview-modal-box photo-adjust-modal-box">
        <div class="blur-modal-tag blur-tag-login">FOTOĞRAFI AYARLA & KIRP</div>
        
        <h3 class="blur-modal-title">Profil Fotoğrafını Konumlandır</h3>
        <p class="blur-modal-desc">Görseli daire içinde sürükleyerek hizalayabilir, yakınlaştırma ve döndürme araçlarıyla mükemmel açıyı ayarlayabilirsiniz.</p>

        <!-- Interactive Circular Cropper Viewport -->
        <div class="crop-viewport-wrapper">
            <div class="crop-viewport-container" id="cropContainer" title="Görseli sürükleyerek hareket ettirin">
                <canvas id="cropCanvas" width="240" height="240"></canvas>
                <div class="crop-circular-mask"></div>
                <div class="crop-grid-overlay" id="cropGridOverlay"></div>
                <div class="crop-drag-hint" id="cropDragHint">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="5 9 2 12 5 15"/><polyline points="9 5 12 2 15 5"/><polyline points="15 19 12 22 9 19"/><polyline points="19 9 22 12 19 15"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="12" y1="2" x2="12" y2="22"/></svg>
                    <span>Sürükleyip Konumlandırın</span>
                </div>
            </div>
        </div>

        <!-- Adjust Toolbar (Zoom Slider & Rotate / Reset) -->
        <div class="crop-toolbar">
            <div class="crop-zoom-group">
                <button type="button" class="btn-crop-tool" onclick="adjustZoom(-0.15)" title="Uzaklaştır">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
                <input type="range" id="cropZoomSlider" min="1" max="3.5" step="0.01" value="1" oninput="onZoomSliderChanged(this.value)" class="crop-slider" title="Yakınlaştırma" />
                <button type="button" class="btn-crop-tool" onclick="adjustZoom(0.15)" title="Yakınlaştır">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
            </div>

            <div class="crop-actions-row">
                <button type="button" class="btn-crop-action" onclick="rotateCropImage(90)" title="90° Saat Yönünde Döndür">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                    <span>90° Döndür</span>
                </button>
                <button type="button" class="btn-crop-action" onclick="resetCropTransform()" title="Varsayılan Konuma ve Boyuta Dön">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                    <span>Sıfırla</span>
                </button>
            </div>
        </div>

        <div class="photo-file-details">
            <div class="file-detail-item">
                <span class="file-detail-label">Dosya Adı:</span>
                <span class="file-detail-value" id="previewFileName">—</span>
            </div>
            <div class="file-detail-item">
                <span class="file-detail-label">Orijinal Boyut:</span>
                <span class="file-detail-value" id="previewFileSize">—</span>
            </div>
            <div class="file-detail-item">
                <span class="file-detail-label">Kayıt:</span>
                <span class="file-detail-value detail-value-cdn">Ayarlanmış Görsel (Cloudinary CDN)</span>
            </div>
        </div>

        <!-- Uploading Spinner Animation State -->
        <div id="uploadProgressBox" class="upload-progress-box" style="display: none;">
            <div class="upload-spinner-ring"></div>
            <span class="upload-progress-text">Görsel kırpılıyor, Cloudinary CDN'e aktarılıyor...</span>
        </div>

        <div class="photo-modal-actions" id="modalActionsGroup">
            <button type="button" class="btn-modal-cancel" onclick="closePhotoModal()">
                Vazgeç
            </button>
            <button type="button" class="btn-modal-upload-confirm" id="btnConfirmUpload" onclick="submitAdjustedProfilePhoto()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="17 8 12 3 7 8"></polyline>
                    <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                <span>Fotoğrafı Yükle & Kaydet</span>
            </button>
        </div>
    </div>
</div>

<form id="hiddenPhotoUploadForm" asp-controller="Account" asp-action="UploadProfilePhoto" method="post" enctype="multipart/form-data" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
<script>
    let isEditMode = false;

    function toggleEditProfileMode() {
        isEditMode = !isEditMode;
        const viewSec = document.getElementById('profileViewMode');
        const editSec = document.getElementById('profileEditMode');
        const toggleBtn = document.getElementById('btnToggleEditMode');
        const toggleText = document.getElementById('toggleEditText');

        if (isEditMode) {
            viewSec.style.display = 'none';
            editSec.style.display = 'block';
            toggleBtn.classList.add('is-editing');
            toggleText.textContent = 'Görüntüleme Modu';
            editSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
            editSec.style.display = 'none';
            viewSec.style.display = 'block';
            toggleBtn.classList.remove('is-editing');
            toggleText.textContent = 'Bilgileri Düzenle';
        }
    }

    let selectedSingleFile = null;
    let cropImg = new Image();
    let cropScale = 1.0;
    let cropBaseScale = 1.0;
    let cropOffsetX = 0;
    let cropOffsetY = 0;
    let cropRotation = 0; // 0, 90, 180, 270
    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;

    const CROP_CANVAS_SIZE = 240;

    function triggerSinglePhotoSelect() {
        const fileInput = document.getElementById('profilePhotoInput');
        fileInput.value = ''; // Reset previous selection
        fileInput.click();
    }

    function handleSingleFileSelected(input) {
        if (!input.files || input.files.length === 0) {
            return;
        }

        // Strict Single File Check
        if (input.files.length > 1) {
            showDynamicAlert('Lütfen sadece tek bir görsel dosyası seçiniz!', 'error');
            input.value = '';
            return;
        }

        const file = input.files[0];

        // Format validation
        const validTypes = ['image/jpeg', 'image/png', 'image/webp', 'image/gif', 'image/jpg'];
        if (!validTypes.includes(file.type)) {
            showDynamicAlert('Geçersiz dosya formatı! Sadece JPG, PNG, WEBP veya GIF formatında tek bir görsel seçebilirsiniz.', 'error');
            input.value = '';
            return;
        }

        // Size validation (5 MB max)
        const maxBytes = 5 * 1024 * 1024;
        if (file.size > maxBytes) {
            const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
            showDynamicAlert(`Dosya boyutu çok büyük (${sizeMb} MB). Maksimum izin verilen boyut 5 MB'dir.`, 'error');
            input.value = '';
            return;
        }

        selectedSingleFile = file;

        // Populate modal data
        document.getElementById('previewFileName').textContent = file.name;
        document.getElementById('previewFileSize').textContent = formatFileSize(file.size);

        // Load image into Canvas Cropper
        const reader = new FileReader();
        reader.onload = function(e) {
            cropImg = new Image();
            cropImg.onload = function() {
                initCropper();
                openPhotoModal();
            };
            cropImg.src = e.target.result;
        };
        reader.readAsDataURL(file);
    }

    function initCropper() {
        const isRotated90 = (cropRotation % 180 !== 0);
        const imgW = isRotated90 ? cropImg.height : cropImg.width;
        const imgH = isRotated90 ? cropImg.width : cropImg.height;

        cropBaseScale = Math.max(CROP_CANVAS_SIZE / imgW, CROP_CANVAS_SIZE / imgH);
        cropScale = 1.0;
        cropOffsetX = 0;
        cropOffsetY = 0;
        cropRotation = 0;

        const slider = document.getElementById('cropZoomSlider');
        if (slider) {
            slider.value = '1';
        }

        renderCropperCanvas();
    }

    function renderCropperCanvas() {
        const canvas = document.getElementById('cropCanvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');

        ctx.clearRect(0, 0, canvas.width, canvas.height);

        ctx.save();
        ctx.translate(canvas.width / 2 + cropOffsetX, canvas.height / 2 + cropOffsetY);
        ctx.rotate((cropRotation * Math.PI) / 180);

        const totalScale = cropBaseScale * cropScale;
        const drawW = cropImg.width * totalScale;
        const drawH = cropImg.height * totalScale;

        ctx.drawImage(cropImg, -drawW / 2, -drawH / 2, drawW, drawH);
        ctx.restore();
    }

    function onZoomSliderChanged(val) {
        cropScale = parseFloat(val);
        renderCropperCanvas();
    }

    function adjustZoom(delta) {
        const slider = document.getElementById('cropZoomSlider');
        let current = parseFloat(slider.value) + delta;
        current = Math.max(1, Math.min(3.5, current));
        slider.value = current;
        cropScale = current;
        renderCropperCanvas();
    }

    function rotateCropImage(degrees) {
        cropRotation = (cropRotation + degrees) % 360;
        
        const isRotated90 = (cropRotation % 180 !== 0);
        const imgW = isRotated90 ? cropImg.height : cropImg.width;
        const imgH = isRotated90 ? cropImg.width : cropImg.height;

        cropBaseScale = Math.max(CROP_CANVAS_SIZE / imgW, CROP_CANVAS_SIZE / imgH);
        renderCropperCanvas();
    }

    function resetCropTransform() {
        initCropper();
    }

    // Canvas Dragging / Panning
    const cropContainer = document.getElementById('cropContainer');
    if (cropContainer) {
        cropContainer.addEventListener('mousedown', function(e) {
            isDragging = true;
            dragStartX = e.clientX - cropOffsetX;
            dragStartY = e.clientY - cropOffsetY;
            cropContainer.classList.add('is-dragging');
            const hint = document.getElementById('cropDragHint');
            if (hint) hint.style.opacity = '0';
        });

        window.addEventListener('mousemove', function(e) {
            if (!isDragging) return;
            cropOffsetX = e.clientX - dragStartX;
            cropOffsetY = e.clientY - dragStartY;
            renderCropperCanvas();
        });

        window.addEventListener('mouseup', function() {
            if (isDragging) {
                isDragging = false;
                cropContainer.classList.remove('is-dragging');
            }
        });

        cropContainer.addEventListener('touchstart', function(e) {
            if (e.touches.length === 1) {
                isDragging = true;
                dragStartX = e.touches[0].clientX - cropOffsetX;
                dragStartY = e.touches[0].clientY - cropOffsetY;
                cropContainer.classList.add('is-dragging');
                const hint = document.getElementById('cropDragHint');
                if (hint) hint.style.opacity = '0';
            }
        }, { passive: true });

        window.addEventListener('touchmove', function(e) {
            if (!isDragging || e.touches.length !== 1) return;
            cropOffsetX = e.touches[0].clientX - dragStartX;
            cropOffsetY = e.touches[0].clientY - dragStartY;
            renderCropperCanvas();
        }, { passive: true });

        window.addEventListener('touchend', function() {
            if (isDragging) {
                isDragging = false;
                cropContainer.classList.remove('is-dragging');
            }
        });

        cropContainer.addEventListener('wheel', function(e) {
            e.preventDefault();
            const delta = e.deltaY < 0 ? 0.1 : -0.1;
            adjustZoom(delta);
        }, { passive: false });
    }

    function openPhotoModal() {
        const modal = document.getElementById('photoPreviewModal');
        modal.style.display = 'flex';
        modal.style.opacity = '1';
        document.getElementById('uploadProgressBox').style.display = 'none';
        document.getElementById('modalActionsGroup').style.display = 'flex';
        document.getElementById('btnConfirmUpload').disabled = false;
    }

    function closePhotoModal() {
        const modal = document.getElementById('photoPreviewModal');
        modal.style.opacity = '0';
        setTimeout(() => {
            modal.style.display = 'none';
            selectedSingleFile = null;
            document.getElementById('profilePhotoInput').value = '';
        }, 200);
    }

    function formatFileSize(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
    }

    async function submitAdjustedProfilePhoto() {
        if (!selectedSingleFile || !cropImg.src) {
            showDynamicAlert('Lütfen bir görsel seçiniz.', 'error');
            closePhotoModal();
            return;
        }

        document.getElementById('uploadProgressBox').style.display = 'flex';
        document.getElementById('modalActionsGroup').style.display = 'none';
        document.getElementById('btnConfirmUpload').disabled = true;

        const OUTPUT_SIZE = 500;
        const outCanvas = document.createElement('canvas');
        outCanvas.width = OUTPUT_SIZE;
        outCanvas.height = OUTPUT_SIZE;
        const outCtx = outCanvas.getContext('2d');

        const exportRatio = OUTPUT_SIZE / CROP_CANVAS_SIZE;

        outCtx.save();
        outCtx.translate(OUTPUT_SIZE / 2 + (cropOffsetX * exportRatio), OUTPUT_SIZE / 2 + (cropOffsetY * exportRatio));
        outCtx.rotate((cropRotation * Math.PI) / 180);

        const totalScale = cropBaseScale * cropScale * exportRatio;
        const drawW = cropImg.width * totalScale;
        const drawH = cropImg.height * totalScale;

        outCtx.drawImage(cropImg, -drawW / 2, -drawH / 2, drawW, drawH);
        outCtx.restore();

        outCanvas.toBlob(async function(blob) {
            if (!blob) {
                showDynamicAlert('Görsel işlenirken bir hata oluştu.', 'error');
                closePhotoModal();
                return;
            }

            const formData = new FormData();
            formData.append('profilePhoto', blob, 'profile-photo.jpg');

            const tokenInput = document.querySelector('#hiddenPhotoUploadForm input[name="__RequestVerificationToken"]');
            if (tokenInput) {
                formData.append('__RequestVerificationToken', tokenInput.value);
            }

            try {
                const response = await fetch('/Account/UploadProfilePhoto', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    },
                    body: formData
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    closePhotoModal();
                    showDynamicAlert(result.message || 'Profil fotoğrafınız başarıyla güncellendi!', 'success');
                    updateAvatarUI(result.imageUrl);
                } else {
                    closePhotoModal();
                    showDynamicAlert(result.message || 'Görsel yüklenirken bir hata oluştu.', 'error');
                }
            } catch (err) {
                console.error('Yükleme hatası:', err);
                closePhotoModal();
                showDynamicAlert('Yükleme sırasında bağlantı hatası oluştu.', 'error');
            }
        }, 'image/jpeg', 0.92);
    }

    function updateAvatarUI(imageUrl) {
        if (!imageUrl) return;

        const heroCircle = document.getElementById('profileAvatarDisplay');
        let heroImg = document.getElementById('heroAvatarImg');
        const heroInitials = document.getElementById('heroAvatarInitials');

        if (!heroImg) {
            if (heroInitials) heroInitials.remove();
            heroImg = document.createElement('img');
            heroImg.id = 'heroAvatarImg';
            heroImg.className = 'avatar-uploaded-img';
            heroCircle.insertBefore(heroImg, heroCircle.firstChild);
        }
        heroImg.src = imageUrl;

        const cardCircle = document.getElementById('cardAvatarDisplay');
        if (cardCircle) {
            let cardImg = document.getElementById('cardAvatarImg');
            const cardInitials = document.getElementById('cardAvatarInitials');
            if (!cardImg) {
                if (cardInitials) cardInitials.remove();
                cardImg = document.createElement('img');
                cardImg.id = 'cardAvatarImg';
                cardImg.className = 'avatar-mgmt-img';
                cardCircle.appendChild(cardImg);
            }
            cardImg.src = imageUrl;
        }

        const statusBadge = document.getElementById('avatarStatusBadge');
        if (statusBadge) {
            statusBadge.innerHTML = `
                <span class="avatar-status-pill status-active">
                    <span class="tag-dot"></span> Cloudinary Aktif
                </span>
            `;
        }

        if (!document.getElementById('deletePhotoForm')) {
            const buttonsContainer = document.querySelector('.avatar-mgmt-buttons');
            if (buttonsContainer) {
                const tokenInput = document.querySelector('#hiddenPhotoUploadForm input[name="__RequestVerificationToken"]');
                const tokenVal = tokenInput ? tokenInput.value : '';
                const formHtml = `
                    <form action="/Account/DeleteProfilePhoto" method="post" class="d-inline" id="deletePhotoForm" onsubmit="return confirm('Profil fotoğrafınızı silmek ve varsayılan baş harflere dönmek istediğinize emin misiniz?');">
                        <input type="hidden" name="__RequestVerificationToken" value="${tokenVal}" />
                        <button type="submit" class="btn-avatar-delete" title="Mevcut fotoğrafı kaldır">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                <line x1="10" y1="11" x2="10" y2="17"></line>
                                <line x1="14" y1="11" x2="14" y2="17"></line>
                            </svg>
                            <span>Fotoğrafı Kaldır</span>
                        </button>
                    </form>
                `;
                buttonsContainer.insertAdjacentHTML('beforeend', formHtml);
            }
        }
    }

    function showDynamicAlert(message, type) {
        const tempSuccess = document.getElementById('tempSuccessAlert');
        if (tempSuccess) tempSuccess.remove();
        const tempError = document.getElementById('tempErrorAlert');
        if (tempError) tempError.remove();

        const container = document.getElementById('dynamicAlertContainer');
        const alertClass = type === 'success' ? 'profile-alert-success' : 'profile-alert-error';
        const iconSvg = type === 'success'
            ? `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`
            : `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>`;

        const alertHtml = `
            <div class="profile-alert ${alertClass}">
                <div class="alert-icon-box">
                    ${iconSvg}
                </div>
                <span>${message}</span>
            </div>
        `;
        container.innerHTML = alertHtml;
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }
</script>
}
