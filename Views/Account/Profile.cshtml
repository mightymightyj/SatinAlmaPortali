    async function handleDeletePhoto(event) {
        if (event) {
            if (typeof event.preventDefault === 'function') event.preventDefault();
            if (typeof event.stopPropagation === 'function') event.stopPropagation();
        }
        if (!confirm('Profil fotoğrafınızı silmek ve varsayılan baş harflere dönmek istediğinize emin misiniz?')) return;

        try {
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const tokenVal = tokenInput ? tokenInput.value : '';
            const formData = new FormData();
            formData.append('__RequestVerificationToken', tokenVal);

            const response = await fetch('/Account/DeleteProfilePhoto', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                },
                body: formData
            });

            const result = await response.json();
            if (result.success) {
                showDynamicAlert('✓ ' + (result.message || 'Profil fotoğrafınız başarıyla kaldırıldı.'), 'success');
                if (typeof showRealtimeToast === 'function') showRealtimeToast('✓ ' + (result.message || 'Profil fotoğrafınız kaldırıldı.'), 'success');

                const heroImg = document.getElementById('heroAvatarImg');
                if (heroImg) heroImg.remove();
                const cardImg = document.getElementById('cardAvatarImg');
                if (cardImg) cardImg.remove();
                const deleteForm = document.getElementById('deletePhotoForm');
                if (deleteForm) deleteForm.remove();
                const statusBadge = document.getElementById('avatarStatusBadge');
                if (statusBadge) {
                    statusBadge.innerHTML = '<span class="avatar-status-pill status-neutral"><span class="tag-dot"></span> Baş Harf Modu</span>';
                }
            } else {
                showDynamicAlert('Hata: ' + (result.message || 'Fotoğraf kaldırılamadı.'), 'error');
            }
        } catch (err) {
            showDynamicAlert('Bağlantı hatası: ' + err.message, 'error');
        }
    }

