@using satinalmaportali2.Helpers
@model satinalmaportali2.Models.ProfileViewModel
@{
    ViewData["Title"] = "Hesabım & Profil";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var initials = "";
    if (!string.IsNullOrEmpty(Model.CompanyName))
    {
        var words = Model.CompanyName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = words.Length >= 2
            ? $"{words[0][0]}{words[1][0]}".ToUpper()
            : Model.CompanyName.Substring(0, Math.Min(2, Model.CompanyName.Length)).ToUpper();
    }
    else if (!string.IsNullOrEmpty(Model.CompanyOfficial))
    {
        var words = Model.CompanyOfficial.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = words.Length >= 2
            ? $"{words[0][0]}{words[1][0]}".ToUpper()
            : Model.CompanyOfficial.Substring(0, Math.Min(2, Model.CompanyOfficial.Length)).ToUpper();
    }
    else
    {
        initials = "?";
    }
}

@section Styles {
    <!-- Google Fonts Inter & Tailwind Play CDN -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e',
                            950: '#082f49',
                        }
                    }
                }
            }
        };
    </script>
    <style>
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        
        /* Tab Nav Button Active State */
        .profile-nav-tab.active {
            background: linear-gradient(135deg, #2563eb 0%, #4f46e5 100%) !important;
            color: #ffffff !important;
            box-shadow: 0 4px 14px -2px rgba(37, 99, 235, 0.35) !important;
            border-color: transparent !important;
        }
        .profile-nav-tab.active .tab-counter-badge {
            background: rgba(255, 255, 255, 0.25) !important;
            color: #ffffff !important;
        }

        /* Drag and Drop Active Ring */
        .is-dragover {
            border-color: #2563eb !important;
            background-color: #eff6ff !important;
            transform: scale(1.02);
            box-shadow: 0 8px 24px rgba(37, 99, 235, 0.18) !important;
        }

        /* Circular Cropper Viewport */
        .crop-viewport-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 16px 0 20px 0;
        }
        .crop-viewport-container {
            position: relative;
            width: 240px;
            height: 240px;
            border-radius: 50%;
            overflow: hidden;
            background: #0f172a;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3), inset 0 0 0 2px rgba(255, 255, 255, 0.2);
            cursor: grab;
            user-select: none;
            touch-action: none;
        }
        .crop-viewport-container.is-dragging {
            cursor: grabbing;
        }
        #cropCanvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 240px;
            height: 240px;
        }
        .crop-circular-mask {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            box-shadow: inset 0 0 0 3px rgba(37, 99, 235, 0.9);
            pointer-events: none;
        }
        .crop-grid-overlay {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background-image: 
                linear-gradient(to right, rgba(255, 255, 255, 0.15) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.15) 1px, transparent 1px);
            background-size: 80px 80px;
            pointer-events: none;
            opacity: 0.6;
        }
        .crop-drag-hint {
            position: absolute;
            bottom: 12px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(4px);
            color: #ffffff;
            font-size: 0.68rem;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 999px;
            pointer-events: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            white-space: nowrap;
            transition: opacity 0.2s;
        }

        /* Avatar Sürükle-Bırak Efektleri */
        .profile-avatar-circle.is-dragover {
            outline: 4px dashed #38bdf8 !important;
            outline-offset: 4px;
            transform: scale(1.08) !important;
            box-shadow: 0 0 25px rgba(56, 189, 248, 0.6) !important;
        }
        .profile-avatar-circle.is-dragover .avatar-hover-overlay {
            opacity: 1 !important;
        }
        .avatar-mgmt-current-circle {
            transition: transform 0.25s ease, box-shadow 0.25s ease, outline 0.2s ease;
        }
        .avatar-mgmt-current-circle:hover {
            transform: scale(1.03);
            box-shadow: 0 10px 28px rgba(37, 99, 235, 0.35);
        }
        .avatar-mgmt-current-circle.is-dragover {
            outline: 4px dashed #2563eb !important;
            outline-offset: 4px;
            transform: scale(1.08) !important;
            box-shadow: 0 0 25px rgba(37, 99, 235, 0.5) !important;
        }
    </style>
}

<!-- ==================== BÖLÜM 1: KOYU DEGRADE KAHRAMAN ALANI (HERO) ==================== -->
<section class="relative overflow-hidden bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 text-white py-10 sm:py-12 px-4 sm:px-6 lg:px-8 border-b border-slate-800/80 font-sans">
    <!-- Radial Glows & Grid Pattern -->
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-indigo-600/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:24px_24px] opacity-25 pointer-events-none"></div>
    
    <div class="relative max-w-5xl mx-auto flex flex-col items-center text-center z-10">
        <!-- Avatar Wrapper with Interactive Camera / Cloudinary Trigger -->
        <div class="relative inline-block mb-3.5 sm:mb-4">
            <div class="profile-avatar-circle w-24 h-24 sm:w-28 sm:h-28 rounded-full ring-4 ring-white/10 ring-offset-4 ring-offset-slate-950 shadow-2xl overflow-hidden cursor-pointer group relative bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center transition-all duration-300 hover:scale-105" id="profileAvatarDisplay" onclick="triggerSinglePhotoSelect()" title="Profil fotoğrafını değiştirmek için tıklayın">
                @if (!string.IsNullOrWhiteSpace(Model.CompanyLogo))
                {
                    <img src="@Model.CompanyLogo" alt="@Model.CompanyName" class="avatar-uploaded-img w-full h-full object-cover" id="heroAvatarImg" />
                }
                else
                {
                    <span class="avatar-initials text-2xl sm:text-3xl font-black text-white tracking-wider select-none" id="heroAvatarInitials">@initials</span>
                }
                
                <!-- Hover Overlay -->
                <div class="avatar-hover-overlay absolute inset-0 bg-slate-950/60 backdrop-blur-xs flex flex-col items-center justify-center text-white opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                    <svg class="w-5 h-5 mb-1 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                        <circle cx="12" cy="13" r="4"></circle>
                    </svg>
                    <span class="text-[10px] font-bold tracking-wide">Görsel Seç</span>
                </div>
            </div>

            <!-- Floating Camera Edit Badge Button -->
            <button type="button" class="avatar-edit-badge absolute -bottom-0.5 -right-0.5 w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-gradient-to-tr from-blue-600 to-indigo-500 text-white flex items-center justify-center shadow-lg shadow-blue-600/40 border-2 border-slate-900 hover:scale-110 active:scale-95 transition-all cursor-pointer" onclick="triggerSinglePhotoSelect()" title="Görsel Değiştir (Cloudinary)" aria-label="Görsel Değiştir">
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                    <circle cx="12" cy="13" r="4"></circle>
                </svg>
            </button>
        </div>

        <!-- Firma Adı & Yetkili -->
        <h1 class="hero-company-name text-xl sm:text-2xl lg:text-3xl font-black text-white tracking-tight">
            @(Model.CompanyName ?? Model.CompanyOfficial ?? "Firma Adı Belirtilmemiş")
        </h1>
        @if (!string.IsNullOrEmpty(Model.CompanyOfficial) && !string.IsNullOrEmpty(Model.CompanyName))
        {
            <p class="hero-user-name text-xs sm:text-sm text-slate-400 mt-1 font-medium">
                Yetkili: @Model.CompanyOfficial
            </p>
        }

        <!-- Rozetler Şeridi -->
        <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-2.5 mt-3.5">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-xs font-medium text-slate-200">
                <svg class="w-3.5 h-3.5 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Kurumsal Hesap (Alıcı &amp; Tedarikçi)
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-500/15 backdrop-blur-md border border-blue-400/30 text-xs font-semibold text-blue-300">
                <svg class="w-3.5 h-3.5 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                @(Model.MembershipTypeName ?? "Standart Üyelik")
            </span>
            <button type="button" class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-amber-500/15 hover:bg-amber-500/25 backdrop-blur-md border border-amber-400/35 text-xs font-bold text-amber-300 transition-all cursor-pointer" onclick="switchProfileTab('reviews')">
                <span class="text-amber-400">★</span> @Model.BuyerScore.ToString("0.0") / 10 Güvenilirlik
            </button>
        </div>

        <!-- Profil Düzenle Mod Butonu -->
        <div class="mt-5">
            <button type="button" class="btn-profile-edit-toggle inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-semibold text-xs sm:text-sm shadow-lg shadow-blue-600/30 hover:shadow-blue-600/40 transition-all duration-200 active:scale-95 cursor-pointer" id="btnToggleEditMode" onclick="toggleEditProfileMode()">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 20h9"></path>
                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                </svg>
                <span id="toggleEditText">Bilgileri Düzenle</span>
            </button>
        </div>
    </div>
</section>

<main class="bg-slate-50 min-h-screen py-6 sm:py-8 pb-28 sm:pb-32 lg:pb-20 font-sans">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Dinamik Bildirimler Kutusu -->
        <div id="dynamicAlertContainer"></div>

        @if (TempData["ProfileSuccess"] != null)
        {
            <div class="mb-6 flex items-center gap-3 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium shadow-sm animate-in fade-in duration-200" id="tempSuccessAlert">
                <div class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <span>@TempData["ProfileSuccess"]</span>
            </div>
        }

        @if (TempData["ProfileError"] != null)
        {
            <div class="mb-6 flex items-center gap-3 p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-medium shadow-sm animate-in fade-in duration-200" id="tempErrorAlert">
                <div class="w-8 h-8 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                </div>
                <span>@TempData["ProfileError"]</span>
            </div>
        }

        <!-- Üst Gezinme Sekmeleri -->
        <div class="mb-6 sm:mb-8">
            <div class="grid grid-cols-2 sm:inline-flex p-1 sm:p-1.5 bg-white rounded-2xl border border-slate-200/90 shadow-sm gap-1 sm:gap-1.5 w-full sm:w-auto" id="profileNavTabsScroll" role="tablist">
                <button type="button" class="profile-nav-tab inline-flex items-center justify-center gap-1.5 sm:gap-2 px-3 sm:px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold text-slate-600 hover:text-slate-900 hover:bg-slate-100/80 transition-all duration-200 cursor-pointer text-center @(Model.ActiveTab == "profile" || string.IsNullOrEmpty(Model.ActiveTab) || Model.ActiveTab == "orders" || Model.ActiveTab == "sales" || Model.ActiveTab == "purchased-items" ? "active" : "")" data-tab="profile" onclick="switchProfileTab('profile', this)">
                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <span>Firma Bilgilerim</span>
                </button>
                <button type="button" class="profile-nav-tab inline-flex items-center justify-center gap-1.5 sm:gap-2 px-2.5 sm:px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold text-slate-600 hover:text-slate-900 hover:bg-slate-100/80 transition-all duration-200 cursor-pointer text-center @(Model.ActiveTab == "reviews" ? "active" : "")" data-tab="reviews" onclick="switchProfileTab('reviews', this)">
                    <span class="text-amber-500 font-bold shrink-0">★</span>
                    <span>
                        <span class="hidden sm:inline">Değerlendirmeler &amp; Karne</span>
                        <span class="sm:hidden">Değerlendirmeler</span>
                    </span>
                    <span class="tab-counter-badge px-1.5 sm:px-2 py-0.5 rounded-full text-[10px] sm:text-xs font-bold bg-amber-100 text-amber-800 shrink-0">@Model.ReceivedReviews.Count</span>
                </button>
            </div>
        </div>

        <!-- ==================== SEKME 1: FİRMA & HESAP BİLGİLERİM ==================== -->
        <div id="profileTabPanel-profile" class="profile-tab-panel" style="@(Model.ActiveTab == "profile" || string.IsNullOrEmpty(Model.ActiveTab) || Model.ActiveTab == "orders" || Model.ActiveTab == "sales" || Model.ActiveTab == "purchased-items" ? "display: block;" : "display: none;")">
            
            <!-- Profil Fotoğrafı & Logo Yönetimi Kartı -->
            <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-5 sm:p-6 mb-6 transition-shadow hover:shadow-md">
                <!-- Kart Başlığı -->
                <div class="flex items-center gap-3 pb-4 border-b border-slate-100">
                    <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-200/60 text-blue-600 flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    </div>
                    <div>
                        <h2 class="text-base sm:text-lg font-bold text-slate-900">Profil Fotoğrafı &amp; Logo Yönetimi</h2>
                        <span class="text-xs text-slate-500">Cloudinary CDN altyapısıyla güvenli, yüksek hızlı ve optimize görsel saklama</span>
                    </div>
                </div>

                <!-- Kart Gövdesi: 2 Sütunlu Grid -->
                <div class="grid grid-cols-1 md:grid-cols-12 gap-5 items-start mt-5">
                    <!-- Sol Sütun: Önizleme Dairesi & Durum -->
                    <div class="col-span-12 md:col-span-4 lg:col-span-3 flex flex-col items-center text-center p-4 sm:p-5 bg-slate-50/70 rounded-2xl border border-slate-100">
                        <div class="avatar-mgmt-current-circle w-24 h-24 sm:w-28 sm:h-28 rounded-full ring-4 ring-white shadow-md overflow-hidden bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center relative cursor-pointer group transition-all duration-300 hover:scale-105" id="cardAvatarDisplay" onclick="triggerSinglePhotoSelect()" title="Fotoğraf değiştirmek için tıklayın veya yeni fotoğrafı buraya sürükleyin">
                            @if (!string.IsNullOrWhiteSpace(Model.CompanyLogo))
                            {
                                <img src="@Model.CompanyLogo" alt="Profil Fotoğrafı" class="avatar-mgmt-img w-full h-full object-cover" id="cardAvatarImg" />
                            }
                            else
                            {
                                <span class="avatar-mgmt-initials text-2xl sm:text-3xl font-black text-white tracking-wider" id="cardAvatarInitials">@initials</span>
                            }
                        </div>
                        <div class="mt-3.5" id="avatarStatusBadge">
                            @if (!string.IsNullOrWhiteSpace(Model.CompanyLogo))
                            {
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-semibold">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Cloudinary Aktif
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 text-slate-600 border border-slate-200 text-xs font-semibold">
                                    <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span> Varsayılan Baş Harfler
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Sağ Sütun: Kurallar, Dropzone & Aksiyonlar -->
                    <div class="col-span-12 md:col-span-8 lg:col-span-9 space-y-3.5">
                        <!-- Kurallar Kutusu -->
                        <div class="bg-blue-50/70 border border-blue-100 rounded-xl p-3.5 text-xs text-blue-900">
                            <div class="flex items-center gap-2 font-bold text-blue-950 mb-1.5">
                                <svg class="w-4 h-4 text-blue-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                                <span>Görsel Yükleme Kuralları</span>
                            </div>
                            <ul class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs text-blue-800">
                                <li class="flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                                    <span><strong>Tekil Seçim:</strong> Tek görsel.</span>
                                </li>
                                <li class="flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                                    <span><strong>Formatlar:</strong> JPG, PNG, WEBP, GIF.</span>
                                </li>
                                <li class="flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                                    <span><strong>Maksimum:</strong> 5 MB.</span>
                                </li>
                            </ul>
                        </div>

                        <!-- Sürükle & Bırak Dropzone -->
                        <div class="profile-photo-dropzone border-2 border-dashed border-slate-300 hover:border-blue-500 bg-slate-50/60 hover:bg-blue-50/40 rounded-xl p-5 transition-all duration-200 cursor-pointer flex flex-col items-center justify-center text-center group" id="profilePhotoDropzone" onclick="triggerSinglePhotoSelect()" title="Fotoğraf seçmek veya sürükleyip bırakmak için tıklayın">
                            <div class="w-10 h-10 rounded-xl bg-blue-100/80 text-blue-600 flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
                                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="17 8 12 3 7 8"></polyline>
                                    <line x1="12" y1="3" x2="12" y2="15"></line>
                                </svg>
                            </div>
                            <strong class="text-sm font-bold text-slate-800">Fotoğrafınızı buraya sürükleyip bırakın</strong>
                            <span class="text-xs text-slate-500 mt-0.5">veya cihazınızdan dosya seçmek için tıklayın (Maks 5 MB)</span>
                        </div>

                        <!-- Butonlar -->
                        <div class="avatar-mgmt-buttons flex flex-wrap items-center gap-2.5 pt-0.5">
                            <button type="button" class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs sm:text-sm font-semibold shadow-sm shadow-blue-600/20 transition-all active:scale-95 cursor-pointer" onclick="triggerSinglePhotoSelect()">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="17 8 12 3 7 8"></polyline>
                                    <line x1="12" y1="3" x2="12" y2="15"></line>
                                </svg>
                                <span>Yeni Tek Görsel Seç</span>
                            </button>

                            @if (!string.IsNullOrWhiteSpace(Model.CompanyLogo))
                            {
                                <form asp-controller="Account" asp-action="DeleteProfilePhoto" method="post" class="inline-block" id="deletePhotoForm" onsubmit="handleDeletePhoto(event); return false;">
                                    <button type="submit" class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 border border-rose-200 text-rose-700 text-xs sm:text-sm font-semibold transition-all active:scale-95 cursor-pointer" title="Mevcut fotoğrafı kaldır">
                                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                            <line x1="10" y1="11" x2="10" y2="17"></line>
                                            <line x1="14" y1="11" x2="14" y2="17"></line>
                                        </svg>
                                        <span>Fotoğrafı Kaldır</span>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>

        <!-- ========================================================================= -->
        <!-- 1. GÖRÜNTÜLEME MODU (VIEW MODE)                                           -->
        <!-- ========================================================================= -->
        <div id="profileViewMode" class="space-y-5">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
                
                <!-- Kart 1: Firma & Yetkili Bilgileri -->
                <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-5 sm:p-6 hover:shadow-md transition-shadow flex flex-col">
                    <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                            </div>
                            <h2 class="text-base font-bold text-slate-900">Firma &amp; Yetkili Bilgileri</h2>
                        </div>
                        <button type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-blue-600 bg-blue-50 hover:bg-blue-100 transition cursor-pointer" onclick="toggleEditProfileMode()" title="Bilgileri Düzenle">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                            <span>Düzenle</span>
                        </button>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 flex-1">
                        <div>
                            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1.5 mb-1">
                                <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                Firma Yetkilisi / Ad Soyad
                            </span>
                            <span class="text-sm font-bold text-slate-900">@(Model.CompanyOfficial ?? "—")</span>
                        </div>
                        <div>
                            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1.5 mb-1">
                                <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                                Firma / Kurum Adı
                            </span>
                            <span class="text-sm font-semibold text-slate-900">@(Model.CompanyName ?? "—")</span>
                        </div>
                        <div>
                            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1.5 mb-1">
                                <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                                Firma Türü
                            </span>
                            <span class="text-sm font-semibold text-slate-800">Kurumsal Hesap (Alıcı &amp; Tedarikçi)</span>
                        </div>
                        <div>
                            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1.5 mb-1">
                                <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                Üyelik Tipi
                            </span>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
                                @(Model.MembershipTypeName ?? "Standart Üyelik")
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Kart 2: İletişim Bilgileri -->
                <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-5 sm:p-6 hover:shadow-md transition-shadow flex flex-col">
                    <div class="flex items-center gap-3 pb-4 border-b border-slate-100 mb-4">
                        <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        </div>
                        <h2 class="text-base font-bold text-slate-900">İletişim Bilgileri</h2>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 flex-1">
                        <div>
                            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1.5 mb-1">
                                <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                                E-posta Adresi
                            </span>
                            <span class="text-sm font-semibold text-blue-600 break-all">@(Model.CompanyMail ?? "—")</span>
                        </div>
                        <div>
                            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1.5 mb-1">
                                <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                                Telefon Numarası
                            </span>
                            <span class="text-sm font-semibold text-slate-900">@(Model.CompanyPhone ?? "—")</span>
                        </div>
                        <div>
                            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1.5 mb-1">
                                <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                Hesap Doğrulama
                            </span>
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                <svg class="w-3 h-3 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                                E-Posta Doğrulandı
                            </span>
                        </div>
                        <div>
                            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1.5 mb-1">
                                <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                                Bildirim Tercihi
                            </span>
                            <span class="text-sm font-medium text-slate-800">E-Posta &amp; Sistem Bildirimleri</span>
                        </div>
                    </div>
                </div>

                <!-- Kart 3: Resmi & Vergi Bilgileri -->
                <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-5 sm:p-6 hover:shadow-md transition-shadow flex flex-col">
                    <div class="flex items-center gap-3 pb-4 border-b border-slate-100 mb-4">
                        <div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                        </div>
                        <h2 class="text-base font-bold text-slate-900">Resmi &amp; Vergi Bilgileri</h2>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 flex-1">
                        <div>
                            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1.5 mb-1">
                                <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                TC Kimlik No / Vergi No
                            </span>
                            <span class="inline-block font-mono text-sm font-bold text-slate-900 bg-slate-100 px-2.5 py-1 rounded-lg">@(Model.TCNO ?? "—")</span>
                        </div>
                        <div>
                            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1.5 mb-1">
                                <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                                Vergi Dairesi
                            </span>
                            <span class="text-sm font-semibold text-slate-900">@(Model.TaxOffice ?? "—")</span>
                        </div>
                        <div>
                            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1.5 mb-1">
                                <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1z"/></svg>
                                Kurumsal Fatura
                            </span>
                            <span class="text-sm font-medium text-slate-800">E-Fatura &amp; E-Arşiv</span>
                        </div>
                        <div>
                            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1.5 mb-1">
                                <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                Mükellef Durumu
                            </span>
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                Faal Mükellef
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Kart 4: Adres & Lokasyon Bilgileri -->
                <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-5 sm:p-6 hover:shadow-md transition-shadow flex flex-col">
                    <div class="flex items-center gap-3 pb-4 border-b border-slate-100 mb-4">
                        <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center shrink-0">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        </div>
                        <h2 class="text-base font-bold text-slate-900">Adres &amp; Lokasyon Bilgileri</h2>
                    </div>

                    <div class="space-y-3.5 flex-1">
                        <div>
                            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1.5 mb-1">
                                <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                Açık Adres
                            </span>
                            <p class="text-sm text-slate-800 leading-relaxed font-medium bg-slate-50 p-2.5 rounded-xl border border-slate-100">@(Model.AddressText ?? "—")</p>
                        </div>
                        <div class="grid grid-cols-3 gap-2.5">
                            <div>
                                <span class="text-[11px] font-semibold text-slate-400 uppercase">Ülke</span>
                                <div class="text-xs sm:text-sm font-bold text-slate-900 truncate">@(Model.CountryName ?? "Türkiye")</div>
                            </div>
                            <div>
                                <span class="text-[11px] font-semibold text-slate-400 uppercase">Şehir / İl</span>
                                <div class="text-xs sm:text-sm font-bold text-slate-900 truncate">@(Model.TownName ?? "—")</div>
                            </div>
                            <div>
                                <span class="text-[11px] font-semibold text-slate-400 uppercase">İlçe</span>
                                <div class="text-xs sm:text-sm font-bold text-slate-900 truncate">@(Model.DistrictName ?? "—")</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Kart 5: Firma Açıklaması (Geniş 2 Sütun) -->
                <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200/90 shadow-sm p-5 sm:p-6 hover:shadow-md transition-shadow">
                    <div class="flex items-center gap-3 pb-4 border-b border-slate-100 mb-4">
                        <div class="w-9 h-9 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center shrink-0">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="17" y1="10" x2="3" y2="10"/><line x1="21" y1="6" x2="3" y2="6"/><line x1="21" y1="14" x2="3" y2="14"/><line x1="17" y1="18" x2="3" y2="18"/></svg>
                        </div>
                        <h2 class="text-base font-bold text-slate-900">Firma / Profil Açıklaması</h2>
                    </div>
                    <p class="text-sm text-slate-700 leading-relaxed bg-slate-50/70 p-4 rounded-xl border border-slate-100 italic">
                        @(string.IsNullOrWhiteSpace(Model.CompanyDetailText) ? "Henüz bir açıklama eklenmemiş. 'Bilgileri Düzenle' butonunu kullanarak firmanız hakkında detaylı bilgi ekleyebilirsiniz." : Model.CompanyDetailText)
                    </p>
                </div>

                <!-- Kart 6: Tedarikçilerden Alınan 10 Yıldızlı Değerlendirmeler & Alıcı Güvenilirlik Karnesi -->
                <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200/90 shadow-sm p-5 sm:p-6 hover:shadow-md transition-shadow">
                    <div class="flex items-center gap-3 pb-4 border-b border-slate-100 mb-4">
                        <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 font-bold text-base">
                            ★
                        </div>
                        <div>
                            <h2 class="text-base font-bold text-slate-900">Tedarikçi Değerlendirmeleri &amp; Alıcı Güvenilirlik Skoru</h2>
                            <span class="text-xs text-slate-500">Sipariş verdiğiniz kurumsal tedarikçilerin firmanız hakkında verdiği 10 yıldızlı değerlendirmeler</span>
                        </div>
                    </div>

                    <!-- Skor Özet Panosu -->
                    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-4 sm:p-5 rounded-xl bg-gradient-to-r from-emerald-500/10 via-teal-500/5 to-transparent border border-emerald-200/60 mb-5">
                        <div>
                            <div class="text-xs font-bold text-emerald-700 uppercase tracking-wider">10 Yıldız Üzerinden Alıcı Skoru</div>
                            <div class="text-3xl sm:text-4xl font-black text-slate-900 my-1">
                                ★ @Model.BuyerScore.ToString("0.0") <span class="text-base font-bold text-slate-400">/ 10</span>
                            </div>
                            <div class="inline-flex gap-1 text-base my-1">
                                @for (int i = 1; i <= 10; i++)
                                {
                                    var filled = i <= Math.Round(Model.BuyerScore);
                                    <span class="@(filled ? "text-emerald-500" : "text-slate-300")">★</span>
                                }
                            </div>
                            <div class="text-xs text-slate-500">@Model.BuyerReviewCount Tedarikçi Değerlendirmesine Dayanıyor</div>
                        </div>
                        <div>
                            <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-emerald-100 text-emerald-800 text-xs sm:text-sm font-bold border border-emerald-200 shadow-xs">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                Onaylı &amp; Güvenilir Kurumsal Alıcı
                            </span>
                        </div>
                    </div>

                    @if (!Model.ReceivedReviews.Any())
                    {
                        <div class="p-8 text-center text-slate-500 text-sm bg-slate-50/70 rounded-2xl border border-dashed border-slate-200">
                            🛒 Sipariş verdiğiniz tedarikçiler mal kabul ve ödeme süreçlerinizi değerlendirdikçe 10 yıldızlı puanlarınız ve yorumlar burada listelenecektir.
                        </div>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var r in Model.ReceivedReviews)
                            {
                                <div class="p-4 sm:p-5 rounded-2xl bg-white border border-slate-200 shadow-xs hover:border-slate-300 transition border-l-4 border-l-emerald-500">
                                    <div class="flex items-start justify-between gap-3 pb-3 border-b border-slate-100 mb-3">
                                        <div class="min-w-0 flex-1">
                                            <div class="flex flex-wrap items-center gap-2">
                                                <strong class="text-sm sm:text-base font-bold text-slate-900 flex items-center gap-1.5">
                                                    <span>🏢</span>
                                                    <span class="truncate">@r.ReviewerName</span>
                                                </strong>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] sm:text-xs font-bold bg-emerald-100 text-emerald-800 shrink-0">
                                                    📦 Tedarikçi Değerlendirmesi
                                                </span>
                                            </div>
                                            <div class="flex flex-wrap items-center gap-x-2.5 gap-y-0.5 text-xs text-slate-400 mt-1">
                                                <span class="flex items-center gap-1">
                                                    <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                                    <span>@r.ReviewDate.ToString("dd.MM.yyyy HH:mm")</span>
                                                </span>
                                                @if (!string.IsNullOrWhiteSpace(r.OrderNumber))
                                                {
                                                    <span class="text-blue-600 font-semibold font-mono">
                                                        • Sipariş: @r.OrderNumber
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                        <div class="shrink-0">
                                            <span class="inline-flex items-center gap-1 px-2.5 sm:px-3 py-1 rounded-xl bg-emerald-50 text-emerald-700 font-black text-xs sm:text-sm border border-emerald-200 shadow-xs">
                                                <span class="text-emerald-500">★</span> @r.ReviewScore.ToString("0.0") <span class="text-[10px] text-emerald-600/70 font-semibold">/ 10</span>
                                            </span>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(r.ReviewText))
                                    {
                                        <div class="p-3 sm:p-4 rounded-xl bg-slate-50/90 border border-slate-100 text-xs sm:text-sm text-slate-700 leading-relaxed italic flex items-start gap-2.5">
                                            <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="currentColor"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
                                            <span class="flex-1">&ldquo;@r.ReviewText&rdquo;</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
