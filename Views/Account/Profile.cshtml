        <!-- 3. GÜVENLİK & ŞİFRE YÖNETİMİ                                              -->
        <!-- ========================================================================= -->
        <div class="profile-card">
            <div class="profile-card-header">
                <div class="profile-card-icon profile-card-icon-red">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <div class="profile-header-text">
                    <h2>Güvenlik & Şifre Yönetimi</h2>
                    <span class="profile-header-subtitle">Hesap şifrenizi ve e-posta doğrulama bağlantınızı yönetin</span>
                </div>
            </div>
            <div class="profile-card-body">
                <div class="security-grid-panel">
                    <!-- Sol: Mevcut Şifre Durumu -->
                    <div class="security-item-card">
                        <div class="security-item-top">
                            <div class="security-item-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            </div>
                            <span class="security-item-title">Mevcut Şifre</span>
                        </div>
                        <div class="security-item-value-box">
                            <span class="security-dots">••••••••••••</span>
                            <span class="security-status-tag">
                                <span class="tag-dot"></span> Korumalı
                            </span>
                        </div>
                        <span class="security-item-hint">Şifreniz Salted SHA-256 algoritmasıyla şifrelenmiştir</span>
                    </div>

                    <!-- Sağ: Doğrulama E-Postası -->
                    <div class="security-item-card">
                        <div class="security-item-top">
                            <div class="security-item-icon security-icon-blue">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                            </div>
                            <span class="security-item-title">Kayıtlı Güvenlik E-Postası</span>
                        </div>
                        <div class="security-item-value-box">
                            <span class="security-mail-value">@(Model.CompanyMail ?? "—")</span>
                        </div>
                        <span class="security-item-hint">Şifre sıfırlama bağlantısı bu adrese gönderilir</span>
                    </div>
                </div>

                <!-- Alt Aksiyon Kutusu -->
                <div class="security-action-banner">
                    <div class="security-notice-left">
                        <div class="security-shield-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </div>
                        <div class="security-notice-text">
                            <strong>Şifrenizi Değiştirmek mi İstiyorsunuz?</strong>
                            <p>Şifre güvenliğiniz için e-posta adresinize tek kullanımlık şifre sıfırlama linki gönderilir.</p>
                        </div>
                    </div>
                    <form asp-controller="Account" asp-action="RequestPasswordReset" method="post" class="security-action-form" onsubmit="handleRequestPasswordReset(event); return false;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-security-reset">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                            <span>Şifre Sıfırlama Bağlantısı Gönder</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
        </div> <!-- /profileTabPanel-profile -->

        <!-- ==================== SEKME: DEĞERLENDİRMELER & İTİBAR KARNESİ ==================== -->
        <div id="profileTabPanel-reviews" class="profile-tab-panel" style="@(Model.ActiveTab == "reviews" ? "display: block;" : "display: none;")">
            <div class="profile-card">
                <div class="profile-card-header">
                    <div class="profile-card-icon" style="background: rgba(245, 158, 11, 0.12); color: #d97706;">
