            <span class="text-xs sm:text-sm font-bold text-blue-900">Görsel kırpılıyor, Cloudinary CDN'e aktarılıyor...</span>
        </div>

        <div class="flex items-center justify-end gap-3" id="modalActionsGroup">
            <button type="button" class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs sm:text-sm transition cursor-pointer" onclick="closePhotoModal()">
