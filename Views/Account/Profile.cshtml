    function showDynamicAlert(message, type) {
        const tempSuccess = document.getElementById('tempSuccessAlert');
        if (tempSuccess) tempSuccess.remove();
        const tempError = document.getElementById('tempErrorAlert');
        if (tempError) tempError.remove();

        const container = document.getElementById('dynamicAlertContainer');
        const isSuccess = (type === 'success');
        const bgClass = isSuccess ? 'bg-emerald-50 border-emerald-200 text-emerald-800' : 'bg-rose-50 border-rose-200 text-rose-800';
        const iconBg = isSuccess ? 'bg-emerald-100 text-emerald-600' : 'bg-rose-100 text-rose-600';
        const iconSvg = isSuccess
            ? `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`
            : `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>`;

        const alertHtml = `
            <div class="mb-6 flex items-center gap-3 p-4 rounded-2xl border ${bgClass} text-sm font-medium shadow-sm animate-in fade-in duration-200">
                <div class="w-8 h-8 rounded-xl ${iconBg} flex items-center justify-center shrink-0">
                    ${iconSvg}
                </div>
                <span>${message}</span>
            </div>
        `;
        container.innerHTML = alertHtml;
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

