                <span>Fotoğrafı Yükle &amp; Kaydet</span>
            </button>
        </div>
    </div>
</div>

<form id="hiddenPhotoUploadForm" asp-controller="Account" asp-action="UploadProfilePhoto" method="post" enctype="multipart/form-data" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
<script>
    let isEditMode = false;

    function toggleEditProfileMode() {
        isEditMode = !isEditMode;
        const viewSec = document.getElementById('profileViewMode');
        const editSec = document.getElementById('profileEditMode');
        const toggleBtn = document.getElementById('btnToggleEditMode');
        const toggleText = document.getElementById('toggleEditText');

        if (isEditMode) {
            viewSec.style.display = 'none';
            editSec.style.display = 'block';
            toggleBtn.classList.add('is-editing');
            toggleText.textContent = 'Görüntüleme Modu';
            editSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
            editSec.style.display = 'none';
            viewSec.style.display = 'block';
            toggleBtn.classList.remove('is-editing');
            toggleText.textContent = 'Bilgileri Düzenle';
        }
    }

    let selectedSingleFile = null;
    let cropImg = new Image();
    let cropScale = 1.0;
    let cropBaseScale = 1.0;
    let cropOffsetX = 0;
    let cropOffsetY = 0;
    let cropRotation = 0; // 0, 90, 180, 270
    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;

    const CROP_CANVAS_SIZE = 240;

    function triggerSinglePhotoSelect() {
        const fileInput = document.getElementById('profilePhotoInput');
        fileInput.value = ''; // Reset previous selection
        fileInput.click();
    }

    function handleSingleFileSelected(input) {
        if (!input || !input.files || input.files.length === 0) {
            return;
        }

        const resetInput = () => {
            try { if (input.value !== undefined) input.value = ''; } catch(e) {}
            const realInput = document.getElementById('profilePhotoInput');
            if (realInput) realInput.value = '';
        };

        // Strict Single File Check
        if (input.files.length > 1) {
            showDynamicAlert('Lütfen sadece tek bir görsel dosyası seçiniz veya bırakınız!', 'error');
            resetInput();
            return;
        }

        const file = input.files[0];

        // Format validation
        const validTypes = ['image/jpeg', 'image/png', 'image/webp', 'image/gif', 'image/jpg'];
        if (!validTypes.includes(file.type)) {
            showDynamicAlert('Geçersiz dosya formatı! Sadece JPG, PNG, WEBP veya GIF formatında tek bir görsel seçebilirsiniz.', 'error');
            resetInput();
            return;
        }

        // Size validation (5 MB max)
        const maxBytes = 5 * 1024 * 1024;
        if (file.size > maxBytes) {
            const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
            showDynamicAlert(`Dosya boyutu çok büyük (${sizeMb} MB). Maksimum izin verilen boyut 5 MB'dir.`, 'error');
            resetInput();
            return;
        }

        selectedSingleFile = file;

        // Populate modal data
        document.getElementById('previewFileName').textContent = file.name;
        document.getElementById('previewFileSize').textContent = formatFileSize(file.size);

        // Load image into Canvas Cropper
        const reader = new FileReader();
        reader.onload = function(e) {
            cropImg = new Image();
            cropImg.onload = function() {
                initCropper();
                openPhotoModal();
            };
            cropImg.src = e.target.result;
        };
        reader.readAsDataURL(file);
    }

    function initCropper() {
        const isRotated90 = (cropRotation % 180 !== 0);
        const imgW = isRotated90 ? cropImg.height : cropImg.width;
        const imgH = isRotated90 ? cropImg.width : cropImg.height;

        cropBaseScale = Math.max(CROP_CANVAS_SIZE / imgW, CROP_CANVAS_SIZE / imgH);
        cropScale = 1.0;
        cropOffsetX = 0;
        cropOffsetY = 0;
        cropRotation = 0;

        const slider = document.getElementById('cropZoomSlider');
        if (slider) {
            slider.value = '1';
        }

        renderCropperCanvas();
    }

    function renderCropperCanvas() {
        const canvas = document.getElementById('cropCanvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');

        ctx.clearRect(0, 0, canvas.width, canvas.height);

        ctx.save();
        ctx.translate(canvas.width / 2 + cropOffsetX, canvas.height / 2 + cropOffsetY);
        ctx.rotate((cropRotation * Math.PI) / 180);

        const totalScale = cropBaseScale * cropScale;
        const drawW = cropImg.width * totalScale;
        const drawH = cropImg.height * totalScale;

        ctx.drawImage(cropImg, -drawW / 2, -drawH / 2, drawW, drawH);
        ctx.restore();
    }

    function onZoomSliderChanged(val) {
        cropScale = parseFloat(val);
        renderCropperCanvas();
    }

    function adjustZoom(delta) {
        const slider = document.getElementById('cropZoomSlider');
        let current = parseFloat(slider.value) + delta;
        current = Math.max(1, Math.min(3.5, current));
        slider.value = current;
        cropScale = current;
        renderCropperCanvas();
    }

    function rotateCropImage(degrees) {
        cropRotation = (cropRotation + degrees) % 360;
        
        const isRotated90 = (cropRotation % 180 !== 0);
        const imgW = isRotated90 ? cropImg.height : cropImg.width;
        const imgH = isRotated90 ? cropImg.width : cropImg.height;

        cropBaseScale = Math.max(CROP_CANVAS_SIZE / imgW, CROP_CANVAS_SIZE / imgH);
        renderCropperCanvas();
    }

    function resetCropTransform() {
        initCropper();
    }

    // Canvas Dragging / Panning
    const cropContainer = document.getElementById('cropContainer');
    if (cropContainer) {
        cropContainer.addEventListener('mousedown', function(e) {
            isDragging = true;
            dragStartX = e.clientX - cropOffsetX;
            dragStartY = e.clientY - cropOffsetY;
            cropContainer.classList.add('is-dragging');
            const hint = document.getElementById('cropDragHint');
            if (hint) hint.style.opacity = '0';
        });

        window.addEventListener('mousemove', function(e) {
            if (!isDragging) return;
            cropOffsetX = e.clientX - dragStartX;
            cropOffsetY = e.clientY - dragStartY;
            renderCropperCanvas();
        });

        window.addEventListener('mouseup', function() {
            if (isDragging) {
                isDragging = false;
                cropContainer.classList.remove('is-dragging');
            }
        });

        cropContainer.addEventListener('touchstart', function(e) {
            if (e.touches.length === 1) {
                isDragging = true;
                dragStartX = e.touches[0].clientX - cropOffsetX;
                dragStartY = e.touches[0].clientY - cropOffsetY;
                cropContainer.classList.add('is-dragging');
                const hint = document.getElementById('cropDragHint');
                if (hint) hint.style.opacity = '0';
            }
        }, { passive: true });

        window.addEventListener('touchmove', function(e) {
            if (!isDragging || e.touches.length !== 1) return;
            cropOffsetX = e.touches[0].clientX - dragStartX;
            cropOffsetY = e.touches[0].clientY - dragStartY;
            renderCropperCanvas();
        }, { passive: true });

        window.addEventListener('touchend', function() {
            if (isDragging) {
                isDragging = false;
                cropContainer.classList.remove('is-dragging');
            }
        });

        cropContainer.addEventListener('wheel', function(e) {
            e.preventDefault();
            const delta = e.deltaY < 0 ? 0.1 : -0.1;
            adjustZoom(delta);
        }, { passive: false });
    }

