                                ★ @Model.OverallScore.ToString("0.0") <small style="font-size: 1rem; color: #64748b; font-weight: 600;">/ 10</small>
                            </div>
                            <div style="display: inline-flex; gap: 3px; margin-bottom: 4px;">
                                @for (int i = 1; i <= 10; i++)
                                {
                                    var filled = i <= Math.Round(Model.OverallScore);
                                    <span style="font-size: 1rem; color: @(filled ? "#f59e0b" : "#cbd5e1");">★</span>
                                }
                            </div>
                            <div style="font-size: 0.8rem; color: #64748b;">Toplam @Model.ReceivedReviews.Count Doğrulanmış Değerlendirmeye Dayanıyor</div>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 6px; text-align: right;">
                            <span class="profile-badge" style="background: #ecfdf5; color: #059669; border: 1px solid rgba(16,185,129,0.3); padding: 6px 14px; font-size: 0.82rem; font-weight: 700; border-radius: 999px; display: inline-flex; align-items: center; gap: 6px;">
