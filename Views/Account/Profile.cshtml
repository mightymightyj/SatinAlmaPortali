        var modal = document.getElementById('profileRateModal');
        if (modal) {
            modal.style.setProperty('display', 'none', 'important');
            modal.style.setProperty('opacity', '0', 'important');
            modal.style.setProperty('pointer-events', 'none', 'important');
            modal.classList.remove('show');
        }
    }

    async function submitProfileRate(e) {
        e.preventDefault();
        const orderId = parseInt(document.getElementById('pRateOrderID').value);
        const score = parseFloat(document.getElementById('pRateScore').value);
        const delivery = parseFloat(document.getElementById('pRateDelivery').value);
        const quality = parseFloat(document.getElementById('pRateQuality').value);
        const comm = parseFloat(document.getElementById('pRateComm').value);
        const text = document.getElementById('pRateComment').value;

        try {
            const res = await fetch('/Review/SubmitBuyerReview', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    orderID: orderId,
                    reviewScore: score,
                    deliveryScore: delivery,
                    qualityScore: quality,
                    communicationScore: comm,
                    reviewText: text
                })
            });

            const data = await res.json();
            if (data.success) {
                closeProfileRateModal();
                alert(data.message);
                location.reload();
            } else {
                alert(data.message);
            }
        } catch (err) {
            alert('Değerlendirme kaydedilirken hata: ' + err);
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const urlParams = new URLSearchParams(window.location.search);
        const tabParam = urlParams.get('tab');
        const hash = window.location.hash.replace('#', '');

        if (tabParam) {
            switchProfileTab(tabParam);
        } else if (hash === 'siparislerim' || hash === 'orders') {
            switchProfileTab('orders');
        } else if (hash === 'satislarim' || hash === 'sales') {
            switchProfileTab('sales');
        } else if (hash === 'urunlerim' || hash === 'purchased-items') {
            switchProfileTab('purchased-items');
        } else if (hash === 'degerlendirmeler' || hash === 'reviews') {
            switchProfileTab('reviews');
        }

        setupProfileDropzones();
    });

    // ==================== PROFİL FOTOĞRAFI SÜRÜKLE-BIRAK BAĞLANTISI ====================
    function setupProfileDropzones() {
        const dropTargets = ['profilePhotoDropzone', 'cardAvatarDisplay', 'profileAvatarDisplay'];

        dropTargets.forEach(id => {
            const el = document.getElementById(id);
            if (!el || el.dataset.dndInit === 'true') return;
            el.dataset.dndInit = 'true';

            ['dragenter', 'dragover'].forEach(eventName => {
                el.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    el.classList.add('is-dragover');
                }, false);
            });

            ['dragleave', 'dragend'].forEach(eventName => {
                el.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    el.classList.remove('is-dragover');
                }, false);
            });

            el.addEventListener('drop', (e) => {
                e.preventDefault();
                e.stopPropagation();
                el.classList.remove('is-dragover');
                const dt = e.dataTransfer;
                if (dt && dt.files && dt.files.length > 0) {
                    handleSingleFileSelected({ files: dt.files });
                }
            }, false);
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupProfileDropzones);
    } else {
        setupProfileDropzones();
    }
</script>
}

