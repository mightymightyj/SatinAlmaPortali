@model satinalmaportali2.Models.ProfileViewModel
@{
    ViewData["Title"] = "Hesabım";
    
    var initials = "";
    if (!string.IsNullOrEmpty(Model.CompanyName))
    {
        var words = Model.CompanyName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = words.Length >= 2
            ? $"{words[0][0]}{words[1][0]}".ToUpper()
            : Model.CompanyName.Substring(0, Math.Min(2, Model.CompanyName.Length)).ToUpper();
    }
    else if (!string.IsNullOrEmpty(Model.CompanyOfficial))
    {
        var words = Model.CompanyOfficial.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = words.Length >= 2
            ? $"{words[0][0]}{words[1][0]}".ToUpper()
            : Model.CompanyOfficial.Substring(0, Math.Min(2, Model.CompanyOfficial.Length)).ToUpper();
    }
    else
    {
        initials = "?";
    }
}

<section class="profile-hero">
    <div class="profile-hero-inner">
        <!-- Avatar Wrapper with Interactive Camera / Cloudinary Trigger -->
        <div class="profile-avatar-wrapper">
            <div class="profile-avatar-circle" id="profileAvatarDisplay" onclick="triggerSinglePhotoSelect()" title="Profil fotoğrafını değiştirmek için tıklayın">
                @if (!string.IsNullOrWhiteSpace(Model.CompanyLogo))
                {
                    <img src="@Model.CompanyLogo" alt="@Model.CompanyName" class="avatar-uploaded-img" id="heroAvatarImg" />
                }
                else
                {
                    <span class="avatar-initials" id="heroAvatarInitials">@initials</span>
                }
                
                <!-- Hover Overlay -->
                <div class="avatar-hover-overlay">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                        <circle cx="12" cy="13" r="4"></circle>
                    </svg>
                    <span class="avatar-overlay-text">Görsel Seç</span>
                </div>
            </div>

            <!-- Floating Camera Badge Button -->
            <button type="button" class="avatar-edit-badge" onclick="triggerSinglePhotoSelect()" title="Görsel Değiştir (Cloudinary)" aria-label="Görsel Değiştir">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                    <circle cx="12" cy="13" r="4"></circle>
                </svg>
            </button>
        </div>

        <h1 class="profile-hero-name">@(Model.CompanyName ?? Model.CompanyOfficial ?? "Firma Adı Belirtilmemiş")</h1>
        
        <div class="profile-hero-badges">
            <span class="profile-badge profile-badge-type">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                @(Model.CompanyTypeName ?? "Belirtilmemiş")
            </span>
            <span class="profile-badge profile-badge-member">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                @(Model.MembershipTypeName ?? "Standart Üyelik")
            </span>
        </div>

        <!-- Profil Düzenle Aksiyon Butonu -->
        <div class="profile-hero-actions">
            <button type="button" class="btn-profile-edit-toggle" id="btnToggleEditMode" onclick="toggleEditProfileMode()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 20h9"></path>
                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                </svg>
                <span id="toggleEditText">Bilgileri Düzenle</span>
            </button>
        </div>
    </div>
</section>

<section class="profile-content-section">
    <div class="profile-container">

        <div id="dynamicAlertContainer"></div>

        @if (TempData["ProfileSuccess"] != null)
        {
            <div class="profile-alert profile-alert-success" id="tempSuccessAlert">
                <div class="alert-icon-box">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <span>@TempData["ProfileSuccess"]</span>
            </div>
        }

        @if (TempData["ProfileError"] != null)
        {
            <div class="profile-alert profile-alert-error" id="tempErrorAlert">
                <div class="alert-icon-box">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                </div>
                <span>@TempData["ProfileError"]</span>
            </div>
        }

        <!-- Profil Fotoğrafı & Logo Yönetimi Kartı -->
        <div class="profile-card profile-card-avatar-mgmt">
            <div class="profile-card-header">
                <div class="profile-card-icon profile-card-icon-blue">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                </div>
                <div class="profile-header-text">
                    <h2>Profil Fotoğrafı & Logo Yönetimi</h2>
                    <span class="profile-header-subtitle">Cloudinary CDN altyapısıyla güvenli, yüksek hızlı ve optimize görsel saklama</span>
                </div>
            </div>
            <div class="profile-card-body">
                <div class="avatar-mgmt-panel">
                    <div class="avatar-mgmt-preview-col">
                        <div class="avatar-mgmt-current-circle" id="cardAvatarDisplay">
                            @if (!string.IsNullOrWhiteSpace(Model.CompanyLogo))
                            {
                                <img src="@Model.CompanyLogo" alt="Profil Fotoğrafı" class="avatar-mgmt-img" id="cardAvatarImg" />
                            }
                            else
                            {
                                <span class="avatar-mgmt-initials" id="cardAvatarInitials">@initials</span>
                            }
                        </div>
                        <div class="avatar-mgmt-status" id="avatarStatusBadge">
                            @if (!string.IsNullOrWhiteSpace(Model.CompanyLogo))
                            {
                                <span class="avatar-status-pill status-active">
                                    <span class="tag-dot"></span> Cloudinary Aktif
                                </span>
                            }
                            else
                            {
                                <span class="avatar-status-pill status-default">
                                    <span class="tag-dot"></span> Varsayılan Baş Harfler
                                </span>
                            }
                        </div>
                    </div>

                    <div class="avatar-mgmt-controls-col">
                        <div class="avatar-rules-box">
                            <div class="rules-header">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                                <strong>Görsel Yükleme Kuralları</strong>
                            </div>
                            <ul class="rules-list">
                                <li><strong>Tekil Seçim:</strong> Sadece <strong>tek bir görsel</strong> dosyası seçebilirsiniz.</li>
                                <li><strong>Desteklenen Formatlar:</strong> JPG, JPEG, PNG, WEBP, GIF.</li>
                                <li><strong>Maksimum Boyut:</strong> 5 MB.</li>
                                <li><strong>Cloudinary Entegrasyonu:</strong> Yüklenen görsel Cloudinary CDN üzerinde otomatik ölçeklenir (500px) ve veritabanınıza güvenle kaydedilir.</li>
                            </ul>
                        </div>

                        <div class="avatar-mgmt-buttons">
                            <button type="button" class="btn-avatar-upload" onclick="triggerSinglePhotoSelect()">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="17 8 12 3 7 8"></polyline>
                                    <line x1="12" y1="3" x2="12" y2="15"></line>
                                </svg>
                                <span>Yeni Tek Görsel Seç</span>
                            </button>

                            @if (!string.IsNullOrWhiteSpace(Model.CompanyLogo))
                            {
                                <form asp-controller="Account" asp-action="DeleteProfilePhoto" method="post" class="d-inline" id="deletePhotoForm" onsubmit="return confirm('Profil fotoğrafınızı silmek ve varsayılan baş harflere dönmek istediğinize emin misiniz?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-avatar-delete" title="Mevcut fotoğrafı kaldır">
                                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                            <line x1="10" y1="11" x2="10" y2="17"></line>
                                            <line x1="14" y1="11" x2="14" y2="17"></line>
                                        </svg>
                                        <span>Fotoğrafı Kaldır</span>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ========================================================================= -->
        <!-- 1. GÖRÜNTÜLEME MODU (VIEW MODE)                                           -->
        <!-- ========================================================================= -->
        <div id="profileViewMode" class="profile-mode-section">

            <!-- Firma & Yetkili Bilgileri -->
            <div class="profile-card">
                <div class="profile-card-header">
                    <div class="profile-card-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    </div>
                    <div class="profile-header-text">
                        <h2>Firma & Yetkili Bilgileri</h2>
                    </div>
                    <button type="button" class="btn-card-edit-shortcut" onclick="toggleEditProfileMode()" title="Bilgileri Düzenle">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                        <span>Düzenle</span>
                    </button>
                </div>
                <div class="profile-card-body">
                    <div class="profile-info-grid">
                        <div class="profile-info-item">
                            <span class="info-label">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                Firma Yetkilisi / Ad Soyad
                            </span>
                            <span class="info-value font-semibold">@(Model.CompanyOfficial ?? "—")</span>
                        </div>
                        <div class="profile-info-item">
                            <span class="info-label">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                                Firma / Kurum Adı
                            </span>
                            <span class="info-value">@(Model.CompanyName ?? "—")</span>
                        </div>
                        <div class="profile-info-item">
                            <span class="info-label">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                                Firma Türü
                            </span>
                            <span class="info-value">@(Model.CompanyTypeName ?? "Belirtilmemiş")</span>
                        </div>
                        <div class="profile-info-item">
                            <span class="info-label">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                Üyelik Tipi
                            </span>
                            <span class="info-value">@(Model.MembershipTypeName ?? "Standart Üyelik")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- İletişim Bilgileri -->
            <div class="profile-card">
                <div class="profile-card-header">
                    <div class="profile-card-icon profile-card-icon-green">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    </div>
                    <div class="profile-header-text">
                        <h2>İletişim Bilgileri</h2>
                    </div>
                </div>
                <div class="profile-card-body">
                    <div class="profile-info-grid">
                        <div class="profile-info-item">
                            <span class="info-label">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                                E-posta Adresi
                            </span>
                            <span class="info-value info-value-mail">@(Model.CompanyMail ?? "—")</span>
                        </div>
                        <div class="profile-info-item">
                            <span class="info-label">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                                Telefon Numarası
                            </span>
                            <span class="info-value">@(Model.CompanyPhone ?? "—")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Resmi & Vergi Bilgileri -->
            <div class="profile-card">
                <div class="profile-card-header">
                    <div class="profile-card-icon profile-card-icon-amber">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                    </div>
                    <div class="profile-header-text">
                        <h2>Resmi & Vergi Bilgileri</h2>
                    </div>
                </div>
                <div class="profile-card-body">
                    <div class="profile-info-grid">
                        <div class="profile-info-item">
                            <span class="info-label">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                TC Kimlik No / Vergi No
                            </span>
                            <span class="info-value info-value-mono">@(Model.TCNO ?? "—")</span>
                        </div>
                        <div class="profile-info-item">
                            <span class="info-label">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                                Vergi Dairesi
                            </span>
                            <span class="info-value">@(Model.TaxOffice ?? "—")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Adres Bilgileri -->
            <div class="profile-card">
                <div class="profile-card-header">
                    <div class="profile-card-icon profile-card-icon-purple">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    </div>
                    <div class="profile-header-text">
                        <h2>Adres & Lokasyon Bilgileri</h2>
                    </div>
                </div>
                <div class="profile-card-body">
                    <div class="profile-info-grid">
                        <div class="profile-info-item profile-info-item-full">
                            <span class="info-label">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                Açık Adres
                            </span>
                            <span class="info-value">@(Model.AddressText ?? "—")</span>
                        </div>
                        <div class="profile-info-item">
                            <span class="info-label">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                                Ülke
                            </span>
                            <span class="info-value">@(Model.CountryName ?? "Türkiye")</span>
                        </div>
                        <div class="profile-info-item">
                            <span class="info-label">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                                Şehir / İl
                            </span>
                            <span class="info-value">@(Model.TownName ?? "—")</span>
                        </div>
                        <div class="profile-info-item">
                            <span class="info-label">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                İlçe
                            </span>
                            <span class="info-value">@(Model.DistrictName ?? "—")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Firma Açıklaması -->
            <div class="profile-card">
                <div class="profile-card-header">
                    <div class="profile-card-icon profile-card-icon-teal">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="17" y1="10" x2="3" y2="10"/><line x1="21" y1="6" x2="3" y2="6"/><line x1="21" y1="14" x2="3" y2="14"/><line x1="17" y1="18" x2="3" y2="18"/></svg>
                    </div>
                    <div class="profile-header-text">
                        <h2>Firma / Profil Açıklaması</h2>
                    </div>
                </div>
                <div class="profile-card-body">
                    <p class="profile-detail-text">@(string.IsNullOrWhiteSpace(Model.CompanyDetailText) ? "Henüz bir açıklama eklenmemiş. 'Bilgileri Düzenle' butonunu kullanarak firmanız hakkında detaylı bilgi ekleyebilirsiniz." : Model.CompanyDetailText)</p>
                </div>
            </div>

        </div>

        <!-- ========================================================================= -->
        <!-- 2. DÜZENLEME FORMU (EDIT MODE)                                            -->
        <!-- ========================================================================= -->
        <div id="profileEditMode" class="profile-mode-section" style="display: none;">
            <form asp-controller="Account" asp-action="UpdateProfile" method="post" id="updateProfileForm">
                @Html.AntiForgeryToken()

                <!-- Kişi ve Firma Bilgileri Düzenleme -->
                <div class="profile-card profile-card-editing">
                    <div class="profile-card-header">
                        <div class="profile-card-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </div>
                        <div class="profile-header-text">
                            <h2>Kişi & Firma Bilgilerini Düzenle</h2>
                            <span class="profile-header-subtitle">Ad, soyad, firma unvanı ve hesap türü ayarlarınız</span>
                        </div>
                    </div>
                    <div class="profile-card-body">
                        <div class="form-inputs-grid">
                            <div class="form-group-item">
                                <label class="form-item-label" for="editCompanyOfficial">
                                    <span>Firma Yetkilisi / Kişi Ad Soyad</span>
                                    <strong class="required-star">*</strong>
                                </label>
                                <div class="form-input-wrap">
                                    <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                    <input type="text" id="editCompanyOfficial" name="companyOfficial" value="@Model.CompanyOfficial" class="profile-form-control" placeholder="Örn: Ahmet Yılmaz" required />
                                </div>
                            </div>

                            <div class="form-group-item">
                                <label class="form-item-label" for="editCompanyName">
                                    <span>Firma / Kurum Adı</span>
                                    <strong class="required-star">*</strong>
                                </label>
                                <div class="form-input-wrap">
