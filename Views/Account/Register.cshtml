@{
    ViewData["Title"] = "Kurumsal Üye Ol";
}

<div class="account-page-wrapper">
    <section id="register-section" class="auth-section">
        <div class="auth-shell register-wizard-shell">
            
            <div class="auth-intro text-center">
                <span class="auth-badge">Kurumsal Kayıt</span>
                <h2>Tedarik Portalına Katılın</h2>
                <p>3 adımda kolayca hesabınızı oluşturun ve Türkiye genelindeki kurumsal satın alma ağına erişin.</p>
            </div>

            <!-- 3 ADIMLI PROGRESS BAR -->
            <div class="wizard-steps-bar">
                <div class="wizard-step active" id="step-tab-1">
                    <div class="step-num">1</div>
                    <span class="step-label">Hesap Bilgileri</span>
                </div>
                <div class="step-connector"></div>
                <div class="wizard-step" id="step-tab-2">
                    <div class="step-num">2</div>
                    <span class="step-label">Konum & Adres</span>
                </div>
                <div class="step-connector"></div>
                <div class="wizard-step" id="step-tab-3">
                    <div class="step-num">3</div>
                    <span class="step-label">Şirket & Vergi</span>
                </div>
            </div>

            @if (ViewData["ErrorMessage"] != null)
            {
                <div class="auth-error-msg">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    <span>@ViewData["ErrorMessage"]</span>
                </div>
            }

            <div id="regErrorAlert" class="auth-error-msg" style="display: none;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <span id="regErrorText">Lütfen gerekli alanları doldurunuz!</span>
            </div>

            <form class="auth-form register-wizard-form" id="registerWizardForm" method="post" asp-action="RegisterSubmit" novalidate>
                
                <!-- AŞAMA 1: TEMEL HESAP BİLGİLERİ -->
                <div class="wizard-pane active" id="pane-step-1">
                    <h4 class="pane-title">1. Aşama: Temel Hesap Bilgileri</h4>
                    
                    <label>
                        Ad Soyad / Firma Yetkilisi *
                        <input type="text" name="fullname" id="regFullname" placeholder="Ahmet Yılmaz" required />
                    </label>

                    <label>
                        E-posta Adresi *
                        <input type="email" name="email" id="regEmail" placeholder="ahmet@firma.com" required />
                    </label>

                    <label>
                        Şifre *
                        <input type="password" name="password" id="regPassword" placeholder="Örn: Pa$$word123" required />
                    </label>

                    <!-- ŞİFRE GÜVENLİK DUVARI -->
                    <div class="password-firewall-box">
                        <div class="firewall-header">
                            <span class="firewall-title">Güvenlik Seviyesi:</span>
                            <span class="firewall-status" id="strengthStatus">Henüz Girilmedi</span>
                        </div>
                        <div class="firewall-bar-track">
                            <div class="firewall-bar-fill" id="strengthBar"></div>
                        </div>
                        <ul class="firewall-rules-list">
                            <li id="rule-length" class="rule-item"><span class="rule-icon">✕</span> En az 8 karakter</li>
                            <li id="rule-upper" class="rule-item"><span class="rule-icon">✕</span> Büyük harf (A-Z)</li>
                            <li id="rule-lower" class="rule-item"><span class="rule-icon">✕</span> Küçük harf (a-z)</li>
                            <li id="rule-digit" class="rule-item"><span class="rule-icon">✕</span> Rakam (0-9)</li>
                            <li id="rule-symbol" class="rule-item"><span class="rule-icon">✕</span> Özel sembol (!@@#$%)</li>
                        </ul>
                    </div>

                    <label>
                        Şifreyi Tekrar Gir *
                        <input type="password" name="confirmPassword" id="regConfirmPassword" placeholder="Şifrenizi tekrar girin" required />
                    </label>

                    <div class="wizard-actions">
                        <button type="button" class="auth-submit btn-next" onclick="goToStep(2)">Devam Et (2. Adıma Geç) →</button>
