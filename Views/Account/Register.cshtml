        // =============================================
        // CASCADING ŞEHİR → İLÇE DROPDOWN (Vanilla JS)
        // =============================================
        var citySelect = document.getElementById("regCity");
        var districtSelect = document.getElementById("regDistrict");

        if (citySelect && districtSelect) {
            citySelect.addEventListener("change", function () {
                var selectedCity = this.value;
                districtSelect.innerHTML = "";

                if (!selectedCity || !turkiyeIlceleri[selectedCity]) {
                    var defaultOpt = document.createElement("option");
                    defaultOpt.value = "";
                    defaultOpt.textContent = "Önce şehir seçiniz";
                    districtSelect.appendChild(defaultOpt);
                    return;
                }

                var placeholder = document.createElement("option");
                placeholder.value = "";
                placeholder.textContent = "İlçe Seçiniz";
                districtSelect.appendChild(placeholder);

                var districts = turkiyeIlceleri[selectedCity];
                for (var i = 0; i < districts.length; i++) {
                    var opt = document.createElement("option");
                    opt.value = districts[i];
                    opt.textContent = districts[i];
                    districtSelect.appendChild(opt);
                }
            });
        }

        // STRICT INPUT RESTRICTION: Only allow digits 0-9 for TCNO and Phone
        [regTcno, regPhone].forEach(input => {
            if (input) {
                input.addEventListener("input", function () {
                    this.value = this.value.replace(/[^0-9]/g, '');
                });
            }
        });

        if (form) {
            form.addEventListener("submit", function (e) {
                e.preventDefault();
                const errorAlert = document.getElementById("regErrorAlert");
                const errorText = document.getElementById("regErrorText");

                if (errorAlert) errorAlert.style.display = "none";

                // Step 1 Validation
                const fullname = document.getElementById("regFullname");
                const email = document.getElementById("regEmail");
                const passInput = document.getElementById("regPassword");
                const confirmInput = document.getElementById("regConfirmPassword");

                if (!fullname || !fullname.value.trim() || !email || !email.value.trim()) {
                    goToStep(1);
                    if (errorAlert && errorText) {
                        errorText.textContent = "Lütfen 1. Adımdaki Ad Soyad ve E-posta alanlarını doldurun!";
                        errorAlert.style.display = "flex";
                    }
                    return;
                }

                const passVal = passInput ? passInput.value : "";
                const hasLength = passVal.length >= 8;
                const hasUpper = /[A-Z]/.test(passVal);
                const hasLower = /[a-z]/.test(passVal);
                const hasDigit = /[0-9]/.test(passVal);
                const hasSymbol = /[!@@#$%^&*()_+\-=\[\]{};':"\\|,.<>/?]/.test(passVal);

                if (!hasLength || !hasUpper || !hasLower || !hasDigit || !hasSymbol || passVal !== confirmInput?.value) {
                    goToStep(1);
                    if (errorAlert && errorText) {
                        errorText.textContent = passVal !== confirmInput?.value
                            ? "Şifreler birbiriyle uyuşmuyor!"
                            : "Lütfen 1. Adımda kurallara uygun güçlü bir şifre girin!";
                        errorAlert.style.display = "flex";
                    }
                    return;
                }

                // Step 2 Validation
                const city = document.getElementById("regCity");
                const district = document.getElementById("regDistrict");
                const address = document.getElementById("regAddressText");

                if (!city || !city.value || !district || !district.value || !address || !address.value.trim()) {
                    goToStep(2);
                    if (errorAlert && errorText) {
                        errorText.textContent = "Lütfen 2. Adımdaki Şehir, İlçe ve Açık Adres alanlarını doldurun!";
                        errorAlert.style.display = "flex";
                    }
                    return;
                }

                // Step 3 Validation
                const tcnoVal = regTcno ? regTcno.value.trim() : "";
                const phoneVal = regPhone ? regPhone.value.trim() : "";
                const taxOffice = document.getElementById("regTaxOffice");

                if (!tcnoVal || tcnoVal.length < 10 || tcnoVal.length > 11) {
                    goToStep(3);
                    if (errorAlert && errorText) {
                        errorText.textContent = "T.C. Kimlik / Vergi Kimlik No 10 veya 11 haneli olmalıdır!";
                        errorAlert.style.display = "flex";
                    }
                    if (regTcno) {
                        regTcno.classList.add("input-error", "shake-error");
                        setTimeout(() => regTcno.classList.remove("shake-error"), 500);
                    }
                    return;
                }

                if (!phoneVal || phoneVal.length < 10 || phoneVal.length > 11) {
                    goToStep(3);
                    if (errorAlert && errorText) {
                        errorText.textContent = "Telefon Numarası 10 veya 11 haneli olmalıdır (Örn: 05512345678 veya 5512345678)!";
                        errorAlert.style.display = "flex";
                    }
                    if (regPhone) {
                        regPhone.classList.add("input-error", "shake-error");
                        setTimeout(() => regPhone.classList.remove("shake-error"), 500);
                    }
                    return;
                }

                if (!taxOffice || !taxOffice.value.trim()) {
                    goToStep(3);
                    if (errorAlert && errorText) {
                        errorText.textContent = "Lütfen Vergi Dairesi alanını doldurun!";
                        errorAlert.style.display = "flex";
                    }
                    return;
                }

                // All validations passed! Submit form programmatically
                form.submit();
            });
        }

        function updateRule(elem, isValid) {
            if (!elem) return;
            const icon = elem.querySelector(".rule-icon");
            if (isValid) {
                elem.classList.add("rule-passed");
                if (icon) icon.textContent = "✓";
            } else {
                elem.classList.remove("rule-passed");
                if (icon) icon.textContent = "✕";
            }
        }

        if (passInput) {
            passInput.addEventListener("input", function () {
                const val = passInput.value;
                const hasLength = val.length >= 8;
                const hasUpper = /[A-Z]/.test(val);
                const hasLower = /[a-z]/.test(val);
                const hasDigit = /[0-9]/.test(val);
                const hasSymbol = /[!@@#$%^&*()_+\-=\[\]{};':"\\|,.<>/?]/.test(val);

                updateRule(ruleLength, hasLength);
                updateRule(ruleUpper, hasUpper);
                updateRule(ruleLower, hasLower);
                updateRule(ruleDigit, hasDigit);
                updateRule(ruleSymbol, hasSymbol);

                let score = 0;
                if (hasLength) score++;
                if (hasUpper) score++;
                if (hasLower) score++;
                if (hasDigit) score++;
                if (hasSymbol) score++;

                if (val.length === 0) {
                    if (strengthBar) { strengthBar.style.width = "0%"; strengthBar.className = "firewall-bar-fill"; }
                    if (strengthStatus) { strengthStatus.textContent = "Henüz Girilmedi"; strengthStatus.style.color = "#94a3b8"; }
                } else if (score <= 2) {
                    if (strengthBar) { strengthBar.style.width = "33%"; strengthBar.className = "firewall-bar-fill strength-weak"; }
                    if (strengthStatus) { strengthStatus.textContent = "Zayıf Şifre"; strengthStatus.style.color = "#ef4444"; }
                } else if (score <= 4) {
                    if (strengthBar) { strengthBar.style.width = "66%"; strengthBar.className = "firewall-bar-fill strength-medium"; }
                    if (strengthStatus) { strengthStatus.textContent = "Orta Güvenlik"; strengthStatus.style.color = "#f59e0b"; }
                } else {
                    if (strengthBar) { strengthBar.style.width = "100%"; strengthBar.className = "firewall-bar-fill strength-strong"; }
                    if (strengthStatus) { strengthStatus.textContent = "Güçlü Güvenlik Duvarı Geçildi ✓"; strengthStatus.style.color = "#16a34a"; }
                }
            });
        }
    });
</script>
