<script>
    let currentStep = 1;

    function goToStep(targetStep) {
        const errorAlert = document.getElementById("regErrorAlert");
        const errorText = document.getElementById("regErrorText");
        
        if (errorAlert) errorAlert.style.display = "none";

        // Validate Step 1 before proceeding to Step 2
        if (targetStep === 2 && currentStep === 1) {
            const fullname = document.getElementById("regFullname");
            const email = document.getElementById("regEmail");
            const passInput = document.getElementById("regPassword");
            const confirmInput = document.getElementById("regConfirmPassword");

            let hasError = false;
            let msg = "";

            if (!fullname.value || !email.value) {
                hasError = true;
                msg = "Lütfen Ad Soyad ve E-posta adresinizi doldurun.";
            } else {
                const val = passInput.value;
                const hasLength = val.length >= 8;
                const hasUpper = /[A-Z]/.test(val);
                const hasLower = /[a-z]/.test(val);
                const hasDigit = /[0-9]/.test(val);
                const hasSymbol = /[!@@#$%^&*()_+\-=\[\]{};':"\\|,.<>/?]/.test(val);

                if (!hasLength || !hasUpper || !hasLower || !hasDigit || !hasSymbol) {
                    hasError = true;
                    msg = "Lütfen tüm şifre güvenlik duvarı kurallarını karşılayan güçlü bir şifre belirleyin!";
                    passInput.classList.add("input-error", "shake-error");
                } else if (passInput.value !== confirmInput.value) {
                    hasError = true;
                    msg = "Şifreler birbiriyle uyuşmuyor! Lütfen tekrar kontrol edin.";
                    passInput.classList.add("input-error", "shake-error");
                    confirmInput.classList.add("input-error", "shake-error");
                }
            }

            if (hasError) {
                if (errorAlert && errorText) {
                    errorText.textContent = msg;
                    errorAlert.style.display = "flex";
                }
                setTimeout(() => {
                    if (passInput) passInput.classList.remove("shake-error");
                    if (confirmInput) confirmInput.classList.remove("shake-error");
                }, 500);
                return;
            }
        }

        // Validate Step 2 before proceeding to Step 3
        if (targetStep === 3 && currentStep === 2) {
            const city = document.getElementById("regCity");
            const district = document.getElementById("regDistrict");
            const address = document.getElementById("regAddressText");

            if (!city.value || !district.value || !address.value) {
                if (errorAlert && errorText) {
                    errorText.textContent = "Lütfen şehir, ilçe ve açık adres alanlarını eksiksiz doldurun.";
                    errorAlert.style.display = "flex";
                }
                return;
            }
        }

        // Update active pane & step indicator bar
        currentStep = targetStep;
        document.querySelectorAll(".wizard-pane").forEach((pane, idx) => {
            pane.classList.toggle("active", idx + 1 === currentStep);
        });

        document.querySelectorAll(".wizard-step").forEach((step, idx) => {
            if (idx + 1 < currentStep) {
                step.className = "wizard-step completed";
            } else if (idx + 1 === currentStep) {
                step.className = "wizard-step active";
            } else {
                step.className = "wizard-step";
            }
        });
    }

