                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1" for="sellerRateComment">Tedarikçi Görüşünüz (Opsiyonel)</label>
                    <textarea id="sellerRateComment" class="form-control w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all" rows="3" placeholder="Alıcı firmanın ödeme intizamı, teslim alma hızı ve işbirliği yaklaşımı nasıldı?"></textarea>
                </div>
            </div>

            <div class="px-6 py-3.5 border-t border-slate-100 bg-slate-50/80 flex items-center justify-end gap-2.5">
                <button type="button" class="btn-cancel px-4 py-2 rounded-lg text-xs font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 transition shadow-2xs cursor-pointer" onclick="closeSellerRateBuyerModal()">Vazgeç</button>
                <button type="submit" class="btn-primary px-4.5 py-2 rounded-lg text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 shadow-xs shadow-emerald-600/20 transition cursor-pointer">
                    Alıcıyı Değerlendir
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let currentSellerPickedScore = 10;

        function pickSellerRateScore(val) {
            currentSellerPickedScore = val;
            document.getElementById('sellerRateScore').value = val;
            updateSellerStarsDisplay(val);
        }

        function previewSellerRateScore(val) {
            updateSellerStarsDisplay(val);
        }

        function restoreSellerRateScore() {
            updateSellerStarsDisplay(currentSellerPickedScore);
        }

        function updateSellerStarsDisplay(val) {
            const stars = document.querySelectorAll('#sellerStarPickerWrap .btn-star-pick-supp');
            stars.forEach(btn => {
                const bVal = parseInt(btn.getAttribute('data-val'));
                if (bVal <= val) {
                    btn.style.color = '#10b981';
                    btn.style.opacity = '1';
                } else {
                    btn.style.color = '#cbd5e1';
                    btn.style.opacity = '0.7';
                }
            });

            const labels = {
                1: "★ 1.0 / 10 - Çok Güvensiz",
                2: "★ 2.0 / 10 - Sorunlu Süreç",
                3: "★ 3.0 / 10 - Gecikmeli Ödeme",
                4: "★ 4.0 / 10 - Yetersiz İşbirliği",
                5: "★ 5.0 / 10 - Orta Seviye",
                6: "★ 6.0 / 10 - Ortalama Alıcı",
                7: "★ 7.0 / 10 - İyi",
                8: "★ 8.0 / 10 - Güvenilir",
                9: "★ 9.0 / 10 - Çok İyi",
                10: "★ 10.0 / 10 - Mükemmel Kurumsal Alıcı"
            };
            document.getElementById('sellerScoreText').textContent = labels[val] || `★ ${val} / 10`;
        }

        function openSellerRateBuyerModal(orderId, buyerName) {
            document.getElementById('sellerRateOrderID').value = orderId;
            document.getElementById('sellerRateBuyerModalTitle').textContent = (buyerName ? buyerName + ' ' : '') + '10 Yıldız Değerlendir';
            pickSellerRateScore(10);
            document.getElementById('suppRateBuyerModal').style.display = 'flex';
        }

        function closeSellerRateBuyerModal() {
            document.getElementById('suppRateBuyerModal').style.display = 'none';
        }

        async function submitSellerRateBuyer(e) {
            e.preventDefault();
            const orderId = parseInt(document.getElementById('sellerRateOrderID').value);
            const score = parseFloat(document.getElementById('sellerRateScore').value);
            const payment = parseFloat(document.getElementById('sellerRatePayment').value);
            const comm = parseFloat(document.getElementById('sellerRateComm').value);
            const text = document.getElementById('sellerRateComment').value;

            try {
                const res = await fetch('/Review/SubmitSellerReview', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        orderID: orderId,
                        reviewScore: score,
                        paymentPunctualityScore: payment,
                        communicationScore: comm,
                        reviewText: text
                    })
                });

                const data = await res.json();
                if (data.success) {
                    closeSellerRateBuyerModal();
                    alert(data.message);
                    const btn = document.getElementById('btn-rate-buyer-' + orderId);
                    if (btn) {
                        btn.textContent = `Alıcı Değerlendirildi (★ ${score}/10)`;
                        btn.style.background = '#0f172a';
                        btn.style.boxShadow = 'none';
                    }
                } else {
                    alert(data.message);
                }
            } catch (err) {
                alert('Alıcı değerlendirmesi gönderilirken hata: ' + err);
            }
        }

        let currentSuppStatus = '@(Model.SelectedStatus ?? "Tümü")';
        let searchDebounceTimer = null;

        function setSuppStatusFilter(statusVal, btn) {
            currentSuppStatus = statusVal;
            const inputEl = document.getElementById('suppSelectedStatusInput');
            if (inputEl) inputEl.value = statusVal;

            const nav = btn ? btn.closest('.year-filter') : document.querySelector('.year-filter');
            if (nav) {
                nav.querySelectorAll('.year-pill').forEach(p => p.classList.remove('is-active'));
                if (btn) btn.classList.add('is-active');
            }

            applySuppOrdersFilter();
        }

        function onSuppSearchInput(val) {
            clearTimeout(searchDebounceTimer);
            searchDebounceTimer = setTimeout(() => {
                applySuppOrdersFilter();
            }, 120);
        }

        function resetSuppFilters() {
            const sInput = document.getElementById('suppSearchInput');
            if (sInput) sInput.value = '';
            const allBtn = document.querySelector('button[onclick*="\'Tümü\'"]');
            setSuppStatusFilter('Tümü', allBtn);
        }

        function applySuppOrdersFilter() {
            const search = (document.getElementById('suppSearchInput')?.value || '').trim().toLowerCase();
            const status = currentSuppStatus || 'Tümü';
            const rows = document.querySelectorAll('tr[id^="supp-order-row-"]');
            const mobileCards = document.querySelectorAll('.mobile-supp-order-card');
            let visibleCount = 0;
            let mobileVisibleCount = 0;

            // Desktop Tablo Satırlarını Filtrele
            rows.forEach(row => {
                const rowStatus = row.getAttribute('data-status') || '';
                const rowSearch = row.getAttribute('data-search') || '';

                let matchStatus = false;
                if (status === 'Tümü' || status === 'all' || !status) {
                    matchStatus = true;
                } else if (status === 'Onaylandı') {
                    matchStatus = (rowStatus === 'Onaylandı' || rowStatus === 'Yeni');
                } else if (status === 'Kargoya Verildi') {
                    matchStatus = (rowStatus === 'Kargoya Verildi' || rowStatus === 'Hazırlanıyor');
                } else if (status === 'Teslim Edildi') {
                    matchStatus = (rowStatus === 'Teslim Edildi' || rowStatus === 'Tamamlandı');
                } else {
                    matchStatus = (rowStatus.toLowerCase() === status.toLowerCase());
                }

                const matchSearch = (!search || rowSearch.includes(search));

                if (matchStatus && matchSearch) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            // Mobil Kartları Filtrele
            mobileCards.forEach(card => {
                const cardStatus = card.getAttribute('data-status') || '';
                const cardSearch = card.getAttribute('data-search') || '';

                let matchStatus = false;
                if (status === 'Tümü' || status === 'all' || !status) {
                    matchStatus = true;
                } else if (status === 'Onaylandı') {
                    matchStatus = (cardStatus === 'Onaylandı' || cardStatus === 'Yeni');
                } else if (status === 'Kargoya Verildi') {
                    matchStatus = (cardStatus === 'Kargoya Verildi' || cardStatus === 'Hazırlanıyor');
                } else if (status === 'Teslim Edildi') {
                    matchStatus = (cardStatus === 'Teslim Edildi' || cardStatus === 'Tamamlandı');
                } else {
                    matchStatus = (cardStatus.toLowerCase() === status.toLowerCase());
                }

                const matchSearch = (!search || cardSearch.includes(search));

                if (matchStatus && matchSearch) {
                    card.style.display = '';
                    mobileVisibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            const titleHeader = document.querySelector('article.card .head-with-icon h2');
            if (titleHeader) {
                const finalCount = rows.length > 0 ? visibleCount : mobileVisibleCount;
                titleHeader.textContent = `Gelen Müşteri Siparişleri (${finalCount})`;
            }

            const clearBtn = document.getElementById('suppClearFilterBtn');
            if (clearBtn) {
                clearBtn.style.display = (search !== '' || (status !== 'Tümü' && status !== '')) ? 'inline-flex' : 'none';
            }

            // Desktop boş durum
            let emptySearchRow = document.getElementById('suppOrdersEmptySearchRow');
            if (rows.length > 0 && visibleCount === 0) {
                if (!emptySearchRow) {
                    emptySearchRow = document.createElement('tr');
                    emptySearchRow.id = 'suppOrdersEmptySearchRow';
                    emptySearchRow.innerHTML = '<td colspan="7" style="text-align: center; padding: 40px 16px; color: var(--muted);"><strong style="color: var(--text);">Arama veya filtre kriterinize uygun sipariş bulunamadı.</strong><div style="font-size: 0.8rem; margin-top: 4px;">Farklı bir arama kelimesi deneyebilir veya filtreyi temizleyebilirsiniz.</div></td>';
                    const tbody = document.querySelector('.dash-table tbody');
                    if (tbody) tbody.appendChild(emptySearchRow);
                }
                emptySearchRow.style.display = '';
            } else if (emptySearchRow) {
                emptySearchRow.style.display = 'none';
            }

            // Mobil boş durum
            const mobileEmptyEl = document.getElementById('suppOrdersMobileEmptySearch');
            if (mobileEmptyEl) {
                mobileEmptyEl.style.display = (mobileCards.length > 0 && mobileVisibleCount === 0) ? 'block' : 'none';
            }

            // URL state güncellemesi
            try {
                const url = new URL(window.location.href);
                if (status && status !== 'Tümü') url.searchParams.set('status', status);
                else url.searchParams.delete('status');
                if (search) url.searchParams.set('search', search);
                else url.searchParams.delete('search');
                window.history.replaceState({}, '', url.toString());
            } catch (e) {}
        }

        // ==================== TEDARİKÇİ SİPARİŞ DETAY MODALI ====================
        function showSuppOrderDetailsModal(orderId) {
            const order = (window.suppOrdersDataMap || {})[orderId];
            if (!order) return;

            // Başlık ve Tarih
            document.getElementById('modalSuppOrderNo').textContent = '#' + order.orderNumber;
            document.getElementById('modalSuppOrderDate').textContent = 'Sipariş Tarihi: ' + order.orderDate;

            // Durum Rozeti
            const badgeEl = document.getElementById('modalSuppOverallBadge');
            const isCancelled = order.orderStatus.includes('İptal');
            const isDelivered = order.orderStatus === 'Teslim Edildi' || order.orderStatus === 'Tamamlandı';
            const isShipped = order.orderStatus === 'Kargoya Verildi';

            badgeEl.className = 'status-badge text-[11px] font-bold px-2.5 py-1 rounded-md ' + 
                (isCancelled ? 'bg-rose-50 text-rose-700 border border-rose-200' :
                (isDelivered ? 'badge-emerald' :
                (isShipped ? 'badge-amber' : 'badge-blue')));
            badgeEl.textContent = order.orderStatus;

            // Alıcı ve Teslimat Bilgileri
            document.getElementById('modalSuppBuyerCompany').textContent = order.buyerCompanyName || 'Kurumsal Alıcı';
            
            let receiverText = '';
            if (order.receiverName) receiverText += order.receiverName;
            if (order.receiverPhone) receiverText += (receiverText ? ' • Tel: ' : 'Tel: ') + order.receiverPhone;
            document.getElementById('modalSuppReceiverInfo').textContent = receiverText || 'Belirtilmedi';
            
            document.getElementById('modalSuppDeliveryAddress').textContent = order.deliveryAddress || 'Belirtilmedi';
            document.getElementById('modalSuppDeliveryCity').textContent = order.deliveryCity || 'İl Belirtilmedi';

            // Kalemler / Ürünler Listesi
            const itemsListEl = document.getElementById('modalSuppOrderItemsList');
            document.getElementById('modalSuppItemCountText').textContent = (order.items?.length || 0) + ' Kalem';
            
            if (order.items && order.items.length > 0) {
                itemsListEl.innerHTML = order.items.map(item => `
                    <div class="p-3 bg-slate-50/80 border border-slate-200/90 rounded-xl space-y-1.5">
                        <div class="flex items-start justify-between gap-2">
                            <div class="min-w-0 flex-1">
                                <div class="font-bold text-slate-800 text-xs sm:text-[13px]">${item.productName}</div>
                                <div class="flex items-center gap-2 mt-0.5 text-[11px] text-slate-400">
                                    <span class="font-mono bg-white px-1.5 py-0.5 rounded border border-slate-200 text-slate-600">${item.sku}</span>
                                    <span>•</span>
                                    <span>${item.categoryName}</span>
                                </div>
                            </div>
                            <div class="text-right shrink-0">
                                <span class="text-xs font-bold text-slate-900">${item.lineTotal}</span>
                                <div class="text-[10px] text-slate-400">${item.quantity} Adet × ${item.unitPrice}</div>
                            </div>
                        </div>
                    </div>
                `).join('');
            } else {
                itemsListEl.innerHTML = '<div class="text-center py-4 text-slate-400">Sipariş kalemi bulunamadı.</div>';
            }

            // Kargo / Sevkiyat Bilgileri
            const shippingBox = document.getElementById('modalSuppShippingInfo');
            if (order.trackingNumber && !isCancelled) {
                shippingBox.innerHTML = `
                    <div class="flex items-center justify-between gap-2 flex-wrap">
                        <div>
                            <span class="text-[11px] text-slate-400 block">Kargo / Taşıyıcı Firma</span>
                            <strong class="text-slate-800 font-bold">${order.shippingCarrier || 'Kargo'}</strong>
                        </div>
                        <div class="text-right">
                            <span class="text-[11px] text-slate-400 block">Takip / İrsaliye No</span>
                            <strong class="font-mono text-blue-600 font-bold">${order.trackingNumber}</strong>
                        </div>
                    </div>
                `;
            } else {
                shippingBox.innerHTML = `
                    <div class="text-slate-500 italic text-[11px]">
                        ${isCancelled ? 'Sipariş iptal edildiği için kargo sevkiyatı yapılmamıştır.' : 'Henüz kargo takip bilgisi girilmedi (Hazırlık aşamasında veya yeni sipariş).'}
                    </div>
                `;
            }

            // Escrow & Hak Ediş
            const escrowBadge = document.getElementById('modalSuppEscrowBadge');
            const escrowDesc = document.getElementById('modalSuppEscrowDesc');
            const payoutEl = document.getElementById('modalSuppPayoutAmount');

            if (order.hasSupplierPayout) {
                payoutEl.textContent = order.supplierPayoutAmount;
            } else {
                payoutEl.textContent = order.grandTotal;
            }

            if (order.escrowStatus === 'InEscrow') {
                escrowBadge.className = 'status-badge text-[11px] px-2.5 py-0.5 rounded-md font-bold';
                escrowBadge.style.cssText = 'background:#f0fdf4; color:#166534; border:1px solid #bbf7d0;';
                escrowBadge.textContent = '🛡️ Havuzda Bloke (Kargolayın)';
                escrowDesc.textContent = 'Ödeme kurumsal alıcı tarafından yapılmış ve iyzico B2B güvenli havuz hesabında bloke edilmiştir. Siparişi kargolayıp teslim edildiğinde tutar hak ediş hesabınıza aktarılacaktır.';
            } else if (order.escrowStatus === 'Released_ToSeller') {
                escrowBadge.className = 'status-badge badge-emerald text-[11px] px-2.5 py-0.5 rounded-md font-bold';
                escrowBadge.style.cssText = '';
                escrowBadge.textContent = '✓ Hesaba Aktarıldı';
                escrowDesc.textContent = 'Alıcı siparişi teslim aldı ve onayladı. Hak ediş tutarı banka/iyzico hesabınıza aktarılmıştır.';
            } else if (order.escrowStatus === 'Disputed') {
                escrowBadge.className = 'status-badge badge-amber text-[11px] px-2.5 py-0.5 rounded-md font-bold';
                escrowBadge.style.cssText = '';
                escrowBadge.textContent = '⚠️ İncelemede / İtiraz';
                escrowDesc.textContent = 'Alıcı bu siparişe itiraz veya iade talebinde bulunmuştur. Havuzdaki bloke inceleme bitene kadar devam eder.';
            } else if (order.escrowStatus === 'Refunded') {
                escrowBadge.className = 'status-badge text-[11px] px-2.5 py-0.5 rounded-md font-bold';
                escrowBadge.style.cssText = 'background:#fef2f2; color:#991b1b; border:1px solid #fecaca;';
                escrowBadge.textContent = '↩️ İade Edildi';
                escrowDesc.textContent = 'Sipariş bedeli alıcıya iade edilmiştir.';
            } else {
                escrowBadge.className = 'status-badge badge-emerald text-[11px] px-2.5 py-0.5 rounded-md font-bold';
                escrowBadge.style.cssText = '';
                escrowBadge.textContent = order.paymentStatus || 'Ödendi';
                escrowDesc.textContent = 'Ödeme başarıyla tahsil edilmiştir.';
            }

            // Finansal Değerler
            document.getElementById('modalSuppGrandTotal').textContent = order.grandTotal;
            document.getElementById('modalSuppSubTotal').textContent = order.totalAmount;
            document.getElementById('modalSuppTaxTotal').textContent = order.taxAmount;
            document.getElementById('modalSuppPaymentMethod').textContent = order.paymentMethod;

            // Aksiyon Butonları
            renderModalSuppActions(order);

            // Modalı Göster
            document.getElementById('suppOrderDetailModal').style.display = 'flex';
        }

        function closeSuppOrderDetailModal() {
            const modal = document.getElementById('suppOrderDetailModal');
            if (modal) modal.style.display = 'none';
        }

        function renderModalSuppActions(order) {
            const container = document.getElementById('modalSuppActionsContainer');
            if (!container) return;

            const isPreparing = order.orderStatus === 'Hazırlanıyor';
            const isShipped = order.orderStatus === 'Kargoya Verildi';
            const isDelivered = order.orderStatus === 'Teslim Edildi';
            const isCompleted = order.orderStatus === 'Tamamlandı';
            const isCancelled = order.orderStatus.includes('İptal');

            let html = '';

            if (isCancelled) {
                html = `
                    <span class="status-badge text-center py-2 px-3 w-full font-bold" style="background:#fef2f2; color:#991b1b; border:1px solid #fecaca; border-radius:8px;">
                        ✕ Bu Sipariş İptal Edilmiştir
                    </span>
                `;
            } else if (isCompleted) {
                html = `
                    <div class="flex items-center justify-between w-full flex-wrap gap-2">
                        <span class="status-badge badge-emerald py-2 px-3 font-bold rounded-lg">
                            ✓ Sipariş Başarıyla Tamamlandı
                        </span>
                        <button type="button" class="btn-primary px-3.5 py-2 rounded-lg text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 shadow-xs cursor-pointer inline-flex items-center gap-1" onclick="openSellerRateBuyerModal(${order.orderId}, '${order.buyerCompanyName}')">
                            ★ Alıcıyı Değerlendir
                        </button>
                    </div>
                `;
            } else if (isDelivered) {
                html = `
                    <div class="flex items-center justify-between w-full flex-wrap gap-2">
                        <span class="status-badge badge-emerald py-2 px-3 font-bold rounded-lg">
                            ✓ Teslim Edildi (Alıcı Onayı Bekleniyor)
                        </span>
                        <button type="button" class="btn-primary px-3.5 py-2 rounded-lg text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 shadow-xs cursor-pointer inline-flex items-center gap-1" onclick="openSellerRateBuyerModal(${order.orderId}, '${order.buyerCompanyName}')">
                            ★ Alıcıyı Değerlendir
                        </button>
                    </div>
                `;
            } else if (isShipped) {
                html = `
                    <div class="flex items-center justify-between w-full flex-wrap gap-2">
                        <button type="button" class="btn-primary px-4 py-2.5 rounded-lg text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 shadow-xs shadow-emerald-600/20 cursor-pointer flex-1 justify-center inline-flex items-center gap-1.5" onclick="advanceOrderToDeliveredFromModal(${order.orderId}, '${order.orderNumber}')">
                            ✅ Teslim Edildi Olarak İşaretle
                        </button>
                        <button type="button" class="btn-primary px-3.5 py-2.5 rounded-lg text-xs font-bold text-white bg-slate-900 hover:bg-slate-800 shadow-xs cursor-pointer inline-flex items-center gap-1" onclick="openSellerRateBuyerModal(${order.orderId}, '${order.buyerCompanyName}')">
                            ★ Alıcıyı Değerlendir
                        </button>
                    </div>
                `;
            } else if (isPreparing) {
                html = `
                    <div class="flex items-center justify-between w-full flex-wrap gap-2">
                        <div class="flex items-center gap-2 flex-1 min-w-[200px]">
                            <button type="button" class="btn-primary px-4 py-2.5 rounded-lg text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 shadow-xs shadow-blue-600/20 cursor-pointer flex-1 justify-center inline-flex items-center gap-1.5" onclick="openShipModalFromModal(${order.orderId}, '${order.orderNumber}', '${order.trackingNumber || ''}', '${order.shippingCarrier || ''}')">
                                🚚 Kargoya Ver
                            </button>
                            <button type="button" class="px-3 py-2.5 rounded-lg text-xs font-bold text-rose-600 bg-white border border-rose-200 hover:bg-rose-50 cursor-pointer" onclick="openCancelOrderModalFromModal(${order.orderId}, '${order.orderNumber}')">
                                ✕ İptal
                            </button>
                        </div>
                        <button type="button" class="btn-primary px-3 py-2.5 rounded-lg text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 shadow-xs cursor-pointer inline-flex items-center gap-1" onclick="openSellerRateBuyerModal(${order.orderId}, '${order.buyerCompanyName}')">
                            ★ Değerlendir
                        </button>
                    </div>
                `;
            } else {
                // Onaylandı / Yeni Sipariş
                html = `
                    <div class="flex items-center justify-between w-full flex-wrap gap-2">
                        <div class="flex items-center gap-2 flex-1 min-w-[200px]">
                            <button type="button" class="btn-primary px-4 py-2.5 rounded-lg text-xs font-bold text-white bg-sky-600 hover:bg-sky-700 shadow-xs shadow-sky-600/20 cursor-pointer flex-1 justify-center inline-flex items-center gap-1.5" onclick="advanceOrderToPreparingFromModal(${order.orderId}, '${order.orderNumber}')">
                                📦 Siparişi Hazırla
                            </button>
                            <button type="button" class="px-3 py-2.5 rounded-lg text-xs font-bold text-rose-600 bg-white border border-rose-200 hover:bg-rose-50 cursor-pointer" onclick="openCancelOrderModalFromModal(${order.orderId}, '${order.orderNumber}')">
                                ✕ İptal
                            </button>
                        </div>
                        <button type="button" class="btn-primary px-3 py-2.5 rounded-lg text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 shadow-xs cursor-pointer inline-flex items-center gap-1" onclick="openSellerRateBuyerModal(${order.orderId}, '${order.buyerCompanyName}')">
                            ★ Değerlendir
                        </button>
                    </div>
                `;
            }

            container.innerHTML = html;
        }

        function advanceOrderToPreparingFromModal(id, orderNumber) {
            advanceOrderToPreparing(id, orderNumber);
        }

        function openShipModalFromModal(id, orderNumber, tracking, carrier) {
            openShipModal(id, orderNumber, tracking, carrier);
        }

        function advanceOrderToDeliveredFromModal(id, orderNumber) {
            advanceOrderToDelivered(id, orderNumber);
        }

        function openCancelOrderModalFromModal(id, orderNumber) {
            openCancelOrderModal(id, orderNumber, 'seller');
        }

        // ==================== KADEMELİ ADIM ADIM SİPARİŞ DURUM YÖNETİMİ ====================

        // 1. Hazırlığa Başla (Onaylandı -> Hazırlanıyor)
        async function advanceOrderToPreparing(id, orderNumber) {
            const confirmed = confirm('#' + orderNumber + ' numaralı siparişin hazırlık sürecini başlatmak istiyor musunuz?\n\nDurum: Hazırlanıyor olarak güncellenecektir.');
            if (!confirmed) return;

            try {
                const response = await fetch('/Dashboard/UpdateOrderStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderID: id, orderStatus: 'Hazırlanıyor' })
                });

