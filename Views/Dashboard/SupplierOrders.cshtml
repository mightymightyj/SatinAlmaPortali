@using satinalmaportali2.Helpers
@model satinalmaportali2.Models.SupplierOrdersViewModel
@{
    ViewData["Title"] = "Gelen Siparişler & Sevkiyat Yönetimi";
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
    ViewBag.DashboardRole = "Supplier";
}

<!-- ==================== SAYFA BAŞLIĞI ==================== -->
<div class="page-head">
    <div>
        <div style="display: flex; align-items: center; gap: 8px;">
            <h1>Gelen Siparişler & Sevkiyat Yönetimi</h1>
            <span class="status-badge badge-emerald" style="font-size: 0.75rem; padding: 3px 10px;">
                <span class="status-dot"></span> Canlı Satış Akışı
            </span>
        </div>
        <p>
            <span>@Model.CompanyName mağazanıza gelen doğrudan kurumsal siparişler, hazırlık ve kargo sevk işlemleri</span>
        </p>
    </div>

    <div style="display: flex; gap: 10px; align-items: center;">
        <button type="button" class="btn-primary" onclick="openSubMerchantModal()" style="display: inline-flex; align-items: center; gap: 6px; background: #2563eb; padding: 10px 18px; font-size: 0.88rem; font-weight: 700; border-radius: 8px; border: none; color: #fff; cursor: pointer; box-shadow: 0 1px 3px rgba(37, 99, 235, 0.2);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
            </svg>
            <span>💳 iyzico Alt Üye İşyeri &amp; IBAN Tanımla</span>
        </button>
    </div>
</div>

<!-- ==================== 4 BÜYÜK KPI KARTI ==================== -->
<section class="kpi-row" aria-label="Tedarikçi Sipariş Göstergeleri" style="margin-bottom: 20px;">
    <!-- KPI 1: Gelen Sipariş Sayısı -->
    <article class="card kpi-card">
        <div class="kpi-top">
            <span class="kpi-label">Toplam Gelen Sipariş</span>
            <span class="kpi-icon accent">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                </svg>
            </span>
        </div>
        <p class="kpi-value">@Model.TotalOrderCount</p>
        <p class="kpi-delta is-good">
            <span>Mağazanıza ulaşan siparişler</span>
        </p>
    </article>

    <!-- KPI 2: Toplam Ciro -->
    <article class="card kpi-card">
        <div class="kpi-top">
            <span class="kpi-label">Toplam Sipariş Hacmi</span>
            <span class="kpi-icon good">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="1" x2="12" y2="23"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
            </span>
        </div>
        <p class="kpi-value">@Model.TotalRevenue.ToString("N0", ChartHelper.Tr) ₺</p>
        <p class="kpi-delta is-good">
            <span>Brüt satış hacmi</span>
        </p>
    </article>

    <!-- KPI 3: Sevkiyat Bekleyenler -->
    <article class="card kpi-card">
        <div class="kpi-top">
            <span class="kpi-label">Sevkiyat Bekleyenler</span>
            <span class="kpi-icon @(Model.PendingShipmentCount > 0 ? "warn" : "good")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                </svg>
            </span>
        </div>
        <p class="kpi-value">@Model.PendingShipmentCount</p>
        <p class="kpi-delta @(Model.PendingShipmentCount > 0 ? "is-bad" : "is-good")">
            <span>@(Model.PendingShipmentCount > 0 ? "Kargolanması gereken siparişler" : "Bekleyen sevkiyat yok")</span>
        </p>
    </article>

    <!-- KPI 4: Tamamlanan Teslimatlar -->
    <article class="card kpi-card">
        <div class="kpi-top">
            <span class="kpi-label">Tamamlanan Teslimatlar</span>
            <span class="kpi-icon good">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </span>
        </div>
        <p class="kpi-value">@Model.CompletedCount</p>
        <p class="kpi-delta is-good">
            <span>Müşteriye ulaştırılan siparişler</span>
        </p>
    </article>
</section>

<!-- ==================== FİLTRE & ARAMA ALANI ==================== -->
<!-- ==================== FİLTRE & ARAMA ALANI ==================== -->
<div class="card card-flush-mobile p-3 sm:p-4 mb-3 sm:mb-5">
    <form method="get" asp-action="SupplierOrders" id="suppOrdersFilterForm" onsubmit="event.preventDefault(); applySuppOrdersFilter(); return false;" class="flex flex-col sm:flex-row flex-wrap gap-3 items-stretch sm:items-center justify-between">
        <div class="flex flex-wrap gap-2.5 items-center flex-1 min-w-0">
            <div class="relative flex-1 min-w-0 w-full max-w-full sm:max-w-md">
                <input type="text" name="search" id="suppSearchInput" value="@Model.SearchQuery" class="form-control w-full" placeholder="Sipariş No, alıcı firma, ürün veya kargo takip no ara..." oninput="onSuppSearchInput(this.value)" style="padding-left: 36px; height: 42px; font-size: 0.88rem;" />
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" style="position: absolute; left: 12px; top: 13px; pointer-events: none;">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </div>
        </div>

        <nav class="year-filter status-grid-2x2 grid grid-cols-2 sm:flex sm:items-center gap-2 w-full sm:w-auto" aria-label="Tedarikçi sipariş durumu filtresi">
            <input type="hidden" name="status" id="suppSelectedStatusInput" value="@(Model.SelectedStatus ?? "Tümü")" />
            <button type="button" class="year-pill w-full justify-center text-center @(string.IsNullOrEmpty(Model.SelectedStatus) || Model.SelectedStatus == "Tümü" ? "is-active" : "")" 
                    onclick="setSuppStatusFilter('Tümü', this)">
                <span>Tümü</span>
                <span class="status-count-badge" id="suppCountAll">@Model.TotalOrderCount</span>
            </button>
            <button type="button" class="year-pill w-full justify-center text-center @(Model.SelectedStatus == "Onaylandı" ? "is-active" : "")" 
                    onclick="setSuppStatusFilter('Onaylandı', this)">
                <span class="status-indicator-dot dot-blue"></span>
                <span>Yeni Sipariş</span>
            </button>
            <button type="button" class="year-pill w-full justify-center text-center @(Model.SelectedStatus == "Kargoya Verildi" ? "is-active" : "")" 
                    onclick="setSuppStatusFilter('Kargoya Verildi', this)">
                <span class="status-indicator-dot dot-amber"></span>
                <span>Kargoda</span>
            </button>
            <button type="button" class="year-pill status-pill-in-stock w-full justify-center text-center @(Model.SelectedStatus == "Teslim Edildi" ? "is-active" : "")" 
                    onclick="setSuppStatusFilter('Teslim Edildi', this)">
                <span class="status-indicator-dot dot-green"></span>
                <span>Teslim Edildi</span>
            </button>

            <button type="button" id="suppClearFilterBtn" onclick="resetSuppFilters()" class="btn-cancel col-span-2 sm:col-span-1 w-full sm:w-auto justify-center" style="display: @(!string.IsNullOrWhiteSpace(Model.SearchQuery) || (!string.IsNullOrWhiteSpace(Model.SelectedStatus) && Model.SelectedStatus != "Tümü") ? "inline-flex" : "none"); padding: 7px 12px; font-size: 0.82rem; border-radius: 8px; align-items: center; gap: 4px; cursor: pointer;">
                Temizle
            </button>
        </nav>
    </form>
</div>

<!-- ==================== SİPARİŞLER TABLOSU ==================== -->
<article class="card card-flush-mobile p-2 sm:p-5">
    <header class="card-head px-2.5 pt-1.5 pb-2.5 sm:px-0 sm:pt-0 sm:pb-3 border-b sm:border-b-0 border-slate-100 mb-2 sm:mb-4">
        <div class="head-with-icon">
            <span class="blue-accent-x">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                </svg>
            </span>
            <h2 class="text-sm sm:text-base font-bold text-slate-900">Gelen Müşteri Siparişleri (@Model.Orders.Count)</h2>
        </div>
    </header>

    <!-- Desktop Tablo Görünümü (md ve üzeri ekranlar) -->
    <div class="hidden md:block table-scroll-wrap">
        <table class="dash-table">
            <thead>
                <tr>
                    <th>Sipariş No & Tarih</th>
                    <th>Satın Alan Alıcı Firma</th>
                    <th>Sipariş Kalemleri</th>
                    <th>Tutar</th>
                    <th>Ödeme Şekli</th>
                    <th>Sevkiyat Durumu</th>
                    <th class="text-right">Aksiyon</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Orders.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 48px 16px; color: var(--muted);">
                            <div style="margin-bottom: 12px;">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                                    <rect x="1" y="3" width="15" height="13"></rect>
                                    <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                                </svg>
                            </div>
                            <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 6px; color: var(--text);">Henüz gelen bir müşteri siparişi bulunmamaktadır</h3>
                            <p style="font-size: 0.85rem;">Katalogdaki ürünlerinizi vitrinde yayınlayarak kurumsal alıcılardan doğrudan sipariş alabilirsiniz.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var o in Model.Orders)
                    {
                        var isPreparing = o.OrderStatus == "Hazırlanıyor";
                        var isShipped = o.OrderStatus == "Kargoya Verildi";
                        var isDelivered = o.OrderStatus == "Teslim Edildi";
                        var isCompleted = o.OrderStatus == "Tamamlandı";
                        var isCancelled = o.OrderStatus == "İptal" || o.OrderStatus == "İptal Edildi" || o.OrderStatus.Contains("İptal");
                        var searchableText = $"{o.OrderNumber} {o.BuyerCompanyName} {o.DeliveryCity} {o.TrackingNumber} {string.Join(" ", o.OrderItems.Select(oi => oi.ProductName))}".ToLowerInvariant();
                        <tr id="supp-order-row-@o.OrderID" data-status="@o.OrderStatus" data-search="@searchableText">
                            <td>
                                <div class="req-title-cell">
                                    <strong style="font-size: 0.92rem; color: var(--text);">@o.OrderNumber</strong>
                                    <small class="req-code">@o.OrderDate.ToString("dd.MM.yyyy HH:mm")</small>
                                </div>
                            </td>
                            <td>
                                <strong>@o.BuyerCompanyName</strong>
                                <div style="font-size: 0.75rem; color: var(--muted);">@o.DeliveryCity</div>
                            </td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 2px;">
                                    @foreach (var item in o.OrderItems.Take(2))
                                    {
                                        <span style="font-size: 0.82rem; font-weight: 600;">
                                            • @item.ProductName <small style="color: var(--muted);">(@item.Quantity Adet)</small>
                                        </span>
                                    }
                                    @if (o.OrderItems.Count > 2)
                                    {
                                        <small style="color: var(--accent); font-weight: 600;">+ @(o.OrderItems.Count - 2) diğer kalem...</small>
                                    }
                                </div>
                            </td>
                            <td>
                                <strong style="font-size: 0.95rem; color: var(--text);">@o.GrandTotal.ToString("N2", ChartHelper.Tr) ₺</strong>
                                <div style="font-size: 0.72rem; color: var(--muted);">KDV Dahil</div>
                            </td>
                            <td>
                                <span style="font-size: 0.82rem; font-weight: 600;">@o.PaymentMethod</span>
                                <div style="display: flex; flex-direction: column; gap: 3px; margin-top: 3px;">
                                    @if (o.EscrowStatus == "InEscrow")
                                    {
                                        <span class="status-badge" style="background:#f0fdf4; color:#166534; border:1px solid #bbf7d0; font-size:0.68rem; padding:2px 6px;">🛡️ Havuzda Bloke (Kargolayın)</span>
                                    }
                                    else if (o.EscrowStatus == "Released_ToSeller")
                                    {
                                        <span class="status-badge badge-emerald" style="font-size:0.68rem; padding:2px 6px;">✓ Hesaba Aktarıldı</span>
                                    }
                                    else if (o.EscrowStatus == "Disputed")
                                    {
                                        <span class="status-badge badge-amber" style="font-size:0.68rem; padding:2px 6px;">⚠️ İncelemede / İtiraz</span>
                                    }
                                    else if (o.EscrowStatus == "Refunded")
                                    {
                                        <span class="status-badge" style="background:#fef2f2; color:#991b1b; border:1px solid #fecaca; font-size:0.68rem; padding:2px 6px;">↩️ İade Edildi</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge badge-emerald" style="font-size: 0.68rem; padding: 2px 6px;">@o.PaymentStatus</span>
                                    }

                                    @if (o.SupplierPayoutAmount > 0)
                                    {
                                        <small style="font-size: 0.72rem; color: #16a34a; font-weight: 700;">Hak Ediş: @o.SupplierPayoutAmount.ToString("N2", ChartHelper.Tr) ₺</small>
                                    }
                                </div>
                            </td>
                            <td>
                                <div>
                                    <span class="status-badge @(isCancelled ? "" : (isDelivered ? "badge-emerald" : (isShipped ? "badge-amber" : "badge-blue")))" style="font-size: 0.78rem; padding: 3px 8px; @(isCancelled ? "background:#fef2f2; color:#991b1b; border:1px solid #fecaca;" : "")" id="badge-order-@o.OrderID">
                                        <span class="status-dot"></span>
                                        @o.OrderStatus
                                    </span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(o.TrackingNumber) && !isCancelled)
                                {
                                    <div style="font-size: 0.75rem; margin-top: 4px; color: var(--muted);" id="tracking-order-@o.OrderID">
                                        <strong>@o.ShippingCarrier:</strong> @o.TrackingNumber
                                    </div>
                                }
                            </td>
                            <td class="text-right">
                                <div style="display: flex; flex-direction: column; gap: 6px; align-items: flex-end;" id="order-actions-wrap-@o.OrderID">
                                    @if (isCancelled)
                                    {
                                         <span class="status-badge" style="background:#fef2f2; color:#991b1b; border:1px solid #fecaca; font-size:0.75rem; padding:4px 8px; font-weight:700;">
                                             ✕ İptal Edildi
                                         </span>
                                    }
                                    else if (isCompleted)
                                    {
                                         <span class="status-badge badge-emerald" style="font-size:0.75rem; padding:4px 8px; font-weight:700;">
                                             ✓ Tamamlandı
                                         </span>
                                    }
                                    else if (isDelivered)
                                    {
                                         <span class="status-badge badge-emerald" style="font-size:0.75rem; padding:4px 8px; font-weight:700;">
                                             ✓ Teslim Edildi (Alıcı Onayı Bekleniyor)
                                         </span>
                                    }
                                    else if (isShipped)
                                    {
                                         <!-- Kargoya Verildi: 2 taraf da iptal yapamaz! Sadece 'Teslim Edildi Olarak İşaretle' -->
                                         <button type="button" class="btn-primary" style="padding: 6px 12px; font-size: 0.78rem; font-weight: 750; background: #059669; border: none; border-radius: 6px; box-shadow: 0 2px 6px rgba(5,150,105,0.3); cursor: pointer;" id="btn-deliver-@o.OrderID" onclick="advanceOrderToDelivered(@o.OrderID, '@Html.Raw(o.OrderNumber)')">
                                             ✅ Teslim Edildi Olarak İşaretle
                                         </button>
                                    }
                                    else if (isPreparing)
                                    {
                                         <!-- Hazırlanıyor: 'Kargoya Ver' ve gerekçeli 'İptal' -->
                                         <div style="display: flex; gap: 6px; align-items: center;" id="step-actions-@o.OrderID">
                                             <button type="button" class="btn-primary" style="padding: 6px 12px; font-size: 0.78rem; font-weight: 750; background: #2563eb; border: none; border-radius: 6px; box-shadow: 0 2px 6px rgba(37,99,235,0.3); cursor: pointer;" id="btn-ship-@o.OrderID" onclick="openShipModal(@o.OrderID, '@Html.Raw(o.OrderNumber)', '@Html.Raw(o.TrackingNumber)', '@Html.Raw(o.ShippingCarrier)')">
                                                 🚚 Kargoya Ver
                                             </button>
                                             <button type="button" style="padding: 5px 8px; font-size: 0.75rem; font-weight: 700; background: #fff; color: #dc2626; border: 1px solid #fecaca; border-radius: 6px; cursor: pointer;" title="Olumsuz durumda gerekçeli iptal et" onclick="openCancelOrderModal(@o.OrderID, '@Html.Raw(o.OrderNumber)', 'seller')">
                                                 ✕ İptal
                                             </button>
                                         </div>
                                    }
                                    else
                                    {
                                         <!-- Onaylandı / Yeni Sipariş: 'Siparişi Hazırla' ve gerekçeli 'İptal' -->
                                         <div style="display: flex; gap: 6px; align-items: center;" id="step-actions-@o.OrderID">
                                             <button type="button" class="btn-primary" style="padding: 6px 12px; font-size: 0.78rem; font-weight: 750; background: #0284c7; border: none; border-radius: 6px; box-shadow: 0 2px 6px rgba(2,132,199,0.3); cursor: pointer;" id="btn-prep-@o.OrderID" onclick="advanceOrderToPreparing(@o.OrderID, '@Html.Raw(o.OrderNumber)')">
                                                 📦 Siparişi Hazırla
                                             </button>
                                             <button type="button" style="padding: 5px 8px; font-size: 0.75rem; font-weight: 700; background: #fff; color: #dc2626; border: 1px solid #fecaca; border-radius: 6px; cursor: pointer;" title="Olumsuz durumda gerekçeli iptal et" onclick="openCancelOrderModal(@o.OrderID, '@Html.Raw(o.OrderNumber)', 'seller')">
                                                 ✕ İptal
                                             </button>
                                         </div>
                                    }
                                    @if (!isCancelled)
                                    {
                                        <button type="button" class="btn-primary" style="padding: 5px 11px; font-size: 0.76rem; font-weight: 700; background: linear-gradient(135deg, #059669 0%, #10b981 100%); border: none; border-radius: 6px; box-shadow: 0 2px 6px rgba(16, 185, 129, 0.3); cursor: pointer;" id="btn-rate-buyer-@o.OrderID" onclick="openSellerRateBuyerModal(@o.OrderID, '@Html.Raw(o.BuyerCompanyName?.Replace("'", "\\'"))')">
                                            ★ Alıcıyı Değerlendir
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>

                        <script>
                            window.suppOrdersDataMap = window.suppOrdersDataMap || {};
                            window.suppOrdersDataMap[@o.OrderID] = {
                                orderId: @o.OrderID,
                                orderNumber: '@Html.Raw(o.OrderNumber)',
                                orderDate: '@o.OrderDate.ToString("dd.MM.yyyy HH:mm")',
                                buyerCompanyName: '@Html.Raw(o.BuyerCompanyName?.Replace("'", "\\'"))',
                                receiverName: '@Html.Raw(o.ReceiverName?.Replace("'", "\\'"))',
                                receiverPhone: '@Html.Raw(o.ReceiverPhone)',
                                deliveryAddress: '@Html.Raw(o.DeliveryAddress?.Replace("'", "\\'").Replace("\r", "").Replace("\n", " "))',
                                deliveryCity: '@Html.Raw(o.DeliveryCity?.Replace("'", "\\'"))',
                                grandTotal: '@Html.Raw(o.GrandTotal.ToString("N2", ChartHelper.Tr)) ₺',
                                totalAmount: '@Html.Raw(o.TotalAmount.ToString("N2", ChartHelper.Tr)) ₺',
                                taxAmount: '@Html.Raw(o.TaxAmount.ToString("N2", ChartHelper.Tr)) ₺',
                                supplierPayoutAmount: '@Html.Raw(o.SupplierPayoutAmount.ToString("N2", ChartHelper.Tr)) ₺',
                                hasSupplierPayout: @(o.SupplierPayoutAmount > 0 ? "true" : "false"),
                                orderStatus: '@Html.Raw(o.OrderStatus)',
                                paymentMethod: '@Html.Raw(o.PaymentMethod)',
                                paymentStatus: '@Html.Raw(o.PaymentStatus)',
                                escrowStatus: '@Html.Raw(o.EscrowStatus)',
                                trackingNumber: '@Html.Raw(o.TrackingNumber?.Replace("'", "\\'"))',
                                shippingCarrier: '@Html.Raw(o.ShippingCarrier?.Replace("'", "\\'"))',
                                items: [
                                    @foreach (var item in o.OrderItems)
                                    {
                                        <text>{
                                            orderItemId: @item.OrderItemID,
                                            productName: '@Html.Raw(item.ProductName.Replace("'", "\\'"))',
                                            sku: '@Html.Raw(item.Sku ?? "SKU-B2B")',
                                            categoryName: '@Html.Raw(item.CategoryName ?? "Endüstriyel")',
                                            quantity: @item.Quantity,
                                            unitPrice: '@Html.Raw(item.UnitPrice.ToString("N2", ChartHelper.Tr)) ₺',
                                            lineTotal: '@Html.Raw(item.LineTotal.ToString("N2", ChartHelper.Tr)) ₺',
                                            itemStatus: '@Html.Raw(item.ItemStatus ?? o.OrderStatus)'
                                        },</text>
                                    }
                                ]
                            };
                        </script>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Mobil Kompakt Sipariş Listesi (Sadece ayırt edici bilgiler, basıldığında modal) -->
    <div class="block md:hidden p-0 space-y-2.5" id="suppOrdersMobileList">
        @if (!Model.Orders.Any())
        {
            <div class="text-center py-10 px-4 text-slate-400">
                <div class="mb-3 flex justify-center text-slate-300">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="1" y="3" width="15" height="13"></rect>
                        <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                    </svg>
                </div>
                <div class="text-sm font-bold text-slate-700 mb-1">Henüz gelen bir müşteri siparişi bulunmamaktadır</div>
                <p class="text-xs text-slate-500">Katalogdaki ürünlerinizi vitrinde yayınlayarak kurumsal alıcılardan doğrudan sipariş alabilirsiniz.</p>
            </div>
        }
        else
        {
            @foreach (var o in Model.Orders)
            {
                var isPreparing = o.OrderStatus == "Hazırlanıyor";
                var isShipped = o.OrderStatus == "Kargoya Verildi";
                var isDelivered = o.OrderStatus == "Teslim Edildi";
                var isCompleted = o.OrderStatus == "Tamamlandı";
                var isCancelled = o.OrderStatus == "İptal" || o.OrderStatus == "İptal Edildi" || o.OrderStatus.Contains("İptal");
                var searchableText = $"{o.OrderNumber} {o.BuyerCompanyName} {o.DeliveryCity} {o.TrackingNumber} {string.Join(" ", o.OrderItems.Select(oi => oi.ProductName))}".ToLowerInvariant();

                var firstItem = o.OrderItems.FirstOrDefault();
                int otherItemsCount = o.OrderItems.Count - 1;

                var badgeClass = isCancelled ? "bg-rose-50 text-rose-700 border-rose-200/80"
                    : (isDelivered || isCompleted ? "bg-emerald-50 text-emerald-700 border-emerald-200/80"
                    : (isShipped ? "bg-amber-50 text-amber-700 border-amber-200/80"
                    : "bg-blue-50 text-blue-700 border-blue-200/80"));

                <div class="mobile-supp-order-card w-full bg-white rounded-xl border border-slate-200/90 p-3.5 sm:p-4 shadow-2xs hover:border-blue-300 hover:shadow-xs active:scale-[0.99] transition cursor-pointer flex flex-col gap-2.5"
                     id="supp-mobile-order-@o.OrderID"
                     data-order-id="@o.OrderID"
                     data-status="@o.OrderStatus"
                     data-search="@searchableText"
                     onclick="showSuppOrderDetailsModal(@o.OrderID)">
                    
                    <!-- 1. Satır: Sipariş No, Tarih & Durum Rozeti -->
                    <div class="flex items-center justify-between gap-2">
                        <div class="flex items-center gap-1.5 min-w-0">
                            <span class="font-mono text-xs sm:text-[13px] font-bold text-blue-600 truncate">@o.OrderNumber</span>
                            <span class="text-[11px] text-slate-400 shrink-0">• @o.OrderDate.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                        <span id="mobile-supp-badge-@o.OrderID" class="status-badge shrink-0 inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold border @badgeClass">
                            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                            @o.OrderStatus
                        </span>
                    </div>

                    <!-- 2. Satır: Alıcı Firma & Varsa Kargo Rozeti -->
                    <div class="flex items-center justify-between gap-2 text-xs">
                        <div class="flex items-center gap-1.5 min-w-0 text-slate-600">
                            <span class="text-[11px] text-slate-400 shrink-0">Alıcı:</span>
                            <strong class="text-slate-800 font-semibold truncate">@o.BuyerCompanyName</strong>
                            @if (!string.IsNullOrWhiteSpace(o.DeliveryCity))
                            {
                                <span class="text-slate-400 text-[11px] truncate">(@o.DeliveryCity)</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(o.TrackingNumber) && !isCancelled)
                        {
                            <span class="text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200/70 shrink-0 flex items-center gap-1">
                                <span>📦</span> <span>Takipte</span>
                            </span>
                        }
                    </div>

                    <!-- 3. Satır: Kalem / Ürün Özeti -->
                    @if (firstItem != null)
                    {
                        <div class="text-xs text-slate-600 truncate">
                            <span class="font-semibold text-slate-800">• @firstItem.ProductName</span>
                            <span class="text-slate-400 text-[11px]">(@firstItem.Quantity Adet)</span>
                            @if (otherItemsCount > 0)
                            {
                                <span class="text-blue-600 font-semibold text-[11px]"> +@otherItemsCount diğer kalem</span>
                            }
                        </div>
                    }

                    <!-- 4. Satır: Sipariş Tutarı & Hak Ediş & Detay Gör -->
                    <div class="flex items-center justify-between pt-2.5 border-t border-slate-100 mt-0.5">
                        <div class="flex items-baseline gap-1.5 flex-wrap">
                            <strong class="text-[15px] font-black text-slate-900 tracking-tight">@o.GrandTotal.ToString("N2", ChartHelper.Tr) ₺</strong>
                            @if (o.SupplierPayoutAmount > 0)
                            {
                                <span class="text-[11px] font-bold text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200/60">
                                    Hak Ediş: @o.SupplierPayoutAmount.ToString("N2", ChartHelper.Tr) ₺
                                </span>
                            }
                        </div>
                        <span class="inline-flex items-center gap-1 text-xs font-bold text-blue-600 hover:text-blue-700 bg-blue-50/60 px-2.5 py-1 rounded-lg">
                            Detay Gör
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </span>
                    </div>
                </div>
            }

            <div id="suppOrdersMobileEmptySearch" style="display: none;" class="text-center py-8 text-slate-400 text-xs">
                <strong class="text-slate-700 block mb-1">Arama veya filtre kriterinize uygun sipariş bulunamadı.</strong>
                <span>Filtreyi temizleyebilir veya farklı bir arama kelimesi deneyebilirsiniz.</span>
            </div>
        }
    </div>
</article>

