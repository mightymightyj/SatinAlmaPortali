                    <label class="block text-xs font-semibold text-slate-700 mb-1" for="subMerchantIban">Hak Ediş Ödemesi İçin IBAN (26 Karakter) <span class="text-rose-500 font-bold">*</span></label>
                    <input type="text" id="subMerchantIban" class="form-control w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all font-mono font-bold tracking-wide" placeholder="TR320006200000000001234567" maxlength="32" required />
                    <small class="text-[11px] text-slate-500 mt-1 block">Örn Test IBAN: <code class="bg-slate-100 px-1 py-0.5 rounded text-slate-700">TR320006200000000001234567</code> (TR ile başlayan 26 haneli geçerli IBAN)</small>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1" for="subMerchantContactName">Yetkili Adı Soyadı</label>
                        <input type="text" id="subMerchantContactName" class="form-control w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all" placeholder="Ad Soyad" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1" for="subMerchantPhone">Telefon</label>
                        <input type="text" id="subMerchantPhone" class="form-control w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all" placeholder="5XX XXX XX XX" maxlength="11" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1" for="subMerchantEmail">E-Posta</label>
                    <input type="email" id="subMerchantEmail" class="form-control w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all" placeholder="finans@sirketiniz.com" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1" for="subMerchantAddress">Tebligat / Şirket Adresi</label>
                    <textarea id="subMerchantAddress" class="form-control w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all" rows="2" placeholder="Şirket merkez açık adresi..."></textarea>
                </div>
            </div>

            <div class="px-6 py-3.5 border-t border-slate-100 bg-slate-50/80 flex items-center justify-end gap-2.5">
                <button type="button" class="btn-cancel px-4 py-2 rounded-lg text-xs font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 transition shadow-2xs cursor-pointer" onclick="closeSubMerchantModal()">Vazgeç</button>
                <button type="submit" id="btnSubmitSubMerchant" class="btn-primary px-4.5 py-2 rounded-lg text-xs font-bold text-white bg-slate-900 hover:bg-slate-800 shadow-xs transition cursor-pointer">
                    Bilgileri Kaydet &amp; iyzico Hesabı Aç
                </button>
            </div>
        </form>
    </div>
</div>
