        // 2. Kargoya Ver Modalı Aç / Kapat / Gönder (Hazırlanıyor -> Kargoya Verildi)
        function openShipModal(id, orderNumber, tracking, carrier) {
            document.getElementById('shipOrderID').value = id;
            document.getElementById('shipModalTitle').textContent = '#' + orderNumber + ' - Kargoya Ver';
            if (carrier) document.getElementById('shipCarrierSelect').value = carrier;
            if (tracking && tracking !== 'null') document.getElementById('shipTrackingNumber').value = tracking;
            else document.getElementById('shipTrackingNumber').value = '';

            document.getElementById('suppShipModal').style.display = 'flex';
        }

        function closeShipModal() {
            document.getElementById('suppShipModal').style.display = 'none';
        }

        async function handleShipSubmit(e) {
            if (e) {
                if (typeof e.preventDefault === 'function') e.preventDefault();
                if (typeof e.stopPropagation === 'function') e.stopPropagation();
            }

            const id = parseInt(document.getElementById('shipOrderID').value, 10);
            const carrier = document.getElementById('shipCarrierSelect').value;
            const tracking = document.getElementById('shipTrackingNumber').value.trim();

            if (!carrier) {
                alert('Lütfen kargo firması seçiniz.');
                return false;
            }
            if (!tracking) {
                alert('Lütfen geçerli bir kargo takip numarası giriniz.');
                document.getElementById('shipTrackingNumber').focus();
                return false;
            }

            try {
                const response = await fetch('/Dashboard/UpdateOrderStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        orderID: id,
                        orderStatus: 'Kargoya Verildi',
                        shippingCarrier: carrier,
                        trackingNumber: tracking
                    })
                });

                const result = await response.json();
                if (result.success) {
                    closeShipModal();

                    // Veri Haritasını Güncelle
                    if (window.suppOrdersDataMap && window.suppOrdersDataMap[id]) {
                        window.suppOrdersDataMap[id].orderStatus = 'Kargoya Verildi';
                        window.suppOrdersDataMap[id].shippingCarrier = carrier;
                        window.suppOrdersDataMap[id].trackingNumber = tracking;
                    }

                    // Masaüstü Rozetini Kargoya Verildi yap
                    const badge = document.getElementById('badge-order-' + id);
                    if (badge) {
                        badge.className = 'status-badge badge-amber';
                        badge.innerHTML = '<span class="status-dot"></span>Kargoya Verildi';
                    }

                    // Mobil Rozetini Güncelle
                    const mBadge = document.getElementById('mobile-supp-badge-' + id);
                    if (mBadge) {
                        mBadge.className = 'status-badge shrink-0 inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold border bg-amber-50 text-amber-700 border-amber-200/80';
                        mBadge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-current"></span>Kargoya Verildi';
                    }

                    // Filtreleme için data-status güncelle
                    const dRow = document.getElementById('supp-order-row-' + id);
                    if (dRow) dRow.setAttribute('data-status', 'Kargoya Verildi');
                    const mCard = document.getElementById('supp-mobile-order-' + id);
                    if (mCard) mCard.setAttribute('data-status', 'Kargoya Verildi');

                    // Kargo Takip Bilgisi ekle
                    let trackingEl = document.getElementById('tracking-order-' + id);
                    if (!trackingEl && badge && badge.parentElement && badge.parentElement.parentElement) {
                        trackingEl = document.createElement('div');
                        trackingEl.id = 'tracking-order-' + id;
                        trackingEl.style.cssText = 'font-size: 0.75rem; margin-top: 4px; color: var(--muted);';
                        badge.parentElement.parentElement.appendChild(trackingEl);
                    }
                    if (trackingEl) {
                        trackingEl.style.display = '';
                        trackingEl.innerHTML = '<strong>' + carrier + ':</strong> ' + tracking;
                    }

                    // BUTONLARI GÜNCELLE: Kargoya verildiğinde İPTAL YOK! Yalnızca 'Teslim Edildi Olarak İşaretle'
                    const actionsWrap = document.getElementById('order-actions-wrap-' + id);
                    if (actionsWrap) {
                        actionsWrap.innerHTML = `
                            <button type="button" class="btn-primary" style="padding: 6px 12px; font-size: 0.78rem; font-weight: 750; background: #059669; border: none; border-radius: 6px; box-shadow: 0 2px 6px rgba(5,150,105,0.3); cursor: pointer;" id="btn-deliver-${id}" onclick="advanceOrderToDelivered(${id}, '${result.orderNumber || ''}')">
                                ✅ Teslim Edildi Olarak İşaretle
                            </button>
                            <button type="button" class="btn-primary" style="padding: 5px 11px; font-size: 0.76rem; font-weight: 700; background: linear-gradient(135deg, #059669 0%, #10b981 100%); border: none; border-radius: 6px; box-shadow: 0 2px 6px rgba(16, 185, 129, 0.3); cursor: pointer;" onclick="openSellerRateBuyerModal(${id}, '')">
                                ★ Alıcıyı Değerlendir
                            </button>
                        `;
                    }

                    // Eğer detay modalı açıksa yeniden güncelle
                    if (document.getElementById('suppOrderDetailModal')?.style.display === 'flex') {
                        showSuppOrderDetailsModal(id);
                    }

                    if (typeof showRealtimeToast === 'function') {
                        showRealtimeToast(result.message || 'Sipariş kargoya verildi olarak güncellendi.', 'success');
                    }
                } else {
                    alert('Hata: ' + (result.message || 'Kargoya verilemedi.'));
                }
            } catch (err) {
                alert('Bağlantı hatası: ' + err.message);
            }

            return false;
        }

        // 3. Teslimatı Tamamla (Kargoya Verildi -> Teslim Edildi)
        async function advanceOrderToDelivered(id, orderNumber) {
            const confirmed = confirm('#' + orderNumber + ' numaralı siparişin kargocu/taşıyıcı tarafından teslimatı yapıldı mı?\n\nBu işlem sipariş durumunu "Teslim Edildi" yapacak ve alıcının onay vermesini sağlayacaktır.');
            if (!confirmed) return;

            try {
                const response = await fetch('/Dashboard/UpdateOrderStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderID: id, orderStatus: 'Teslim Edildi' })
                });

                const result = await response.json();
                if (result.success) {
                    // Veri Haritasını Güncelle
                    if (window.suppOrdersDataMap && window.suppOrdersDataMap[id]) {
                        window.suppOrdersDataMap[id].orderStatus = 'Teslim Edildi';
                    }

                    // Masaüstü Rozeti
                    const badge = document.getElementById('badge-order-' + id);
                    if (badge) {
                        badge.className = 'status-badge badge-emerald';
                        badge.innerHTML = '<span class="status-dot"></span>Teslim Edildi';
                    }

                    // Mobil Rozeti
                    const mBadge = document.getElementById('mobile-supp-badge-' + id);
                    if (mBadge) {
                        mBadge.className = 'status-badge shrink-0 inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold border bg-emerald-50 text-emerald-700 border-emerald-200/80';
                        mBadge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-current"></span>Teslim Edildi';
                    }

                    // Filtreleme için data-status güncelle
                    const dRow = document.getElementById('supp-order-row-' + id);
                    if (dRow) dRow.setAttribute('data-status', 'Teslim Edildi');
                    const mCard = document.getElementById('supp-mobile-order-' + id);
                    if (mCard) mCard.setAttribute('data-status', 'Teslim Edildi');

                    const actionsWrap = document.getElementById('order-actions-wrap-' + id);
                    if (actionsWrap) {
                        actionsWrap.innerHTML = `
                            <span class="status-badge badge-emerald" style="font-size:0.75rem; padding:4px 8px; font-weight:700;">
                                ✓ Teslim Edildi (Alıcı Onayı Bekleniyor)
                            </span>
                            <button type="button" class="btn-primary" style="padding: 5px 11px; font-size: 0.76rem; font-weight: 700; background: linear-gradient(135deg, #059669 0%, #10b981 100%); border: none; border-radius: 6px; box-shadow: 0 2px 6px rgba(16, 185, 129, 0.3); cursor: pointer;" onclick="openSellerRateBuyerModal(${id}, '')">
                                ★ Alıcıyı Değerlendir
                            </button>
                        `;
                    }

                    // Eğer detay modalı açıksa yeniden güncelle
                    if (document.getElementById('suppOrderDetailModal')?.style.display === 'flex') {
                        showSuppOrderDetailsModal(id);
                    }

                    if (typeof showRealtimeToast === 'function') {
                        showRealtimeToast(result.message || 'Sipariş teslim edildi olarak işaretlendi.', 'success');
                    }
                } else {
                    alert('Hata: ' + (result.message || 'İşlem tamamlanamadı.'));
                }
            } catch (err) {
                alert('Bağlantı hatası: ' + err.message);
            }
        }

        // 4. Gerekçeli İptal Modalı Aç / Kapat / Gönder
        function openCancelOrderModal(id, orderNumber, role) {
            document.getElementById('cancelOrderID').value = id;
            document.getElementById('cancelOrderModalTitle').textContent = '#' + orderNumber + ' - Siparişi İptal Et';
            document.getElementById('cancelOrderReason').value = '';
            document.getElementById('orderCancelModal').style.display = 'flex';
        }

        function closeCancelOrderModal() {
            document.getElementById('orderCancelModal').style.display = 'none';
        }

        async function handleOrderCancelSubmit(e) {
            if (e) {
                if (typeof e.preventDefault === 'function') e.preventDefault();
                if (typeof e.stopPropagation === 'function') e.stopPropagation();
            }

            const id = parseInt(document.getElementById('cancelOrderID').value, 10);
            const reason = document.getElementById('cancelOrderReason').value.trim();

            if (!reason) {
                alert('Lütfen geçerli bir iptal gerekçesi belirtiniz.');
                document.getElementById('cancelOrderReason').focus();
                return false;
            }

            const confirmed = confirm('Bu siparişi kesin olarak iptal etmek istediğinizden emin misiniz?\n\nBu işlem geri alınamaz!');
            if (!confirmed) return false;

            try {
                const response = await fetch('/Dashboard/UpdateOrderStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        orderID: id,
                        orderStatus: 'İptal Edildi',
                        cancellationReason: reason
                    })
                });

                const result = await response.json();
                if (result.success) {
                    closeCancelOrderModal();

                    // Veri Haritasını Güncelle
                    if (window.suppOrdersDataMap && window.suppOrdersDataMap[id]) {
                        window.suppOrdersDataMap[id].orderStatus = 'İptal Edildi';
                    }

                    // Masaüstü Rozeti
                    const badge = document.getElementById('badge-order-' + id);
                    if (badge) {
                        badge.className = 'status-badge';
                        badge.style.background = '#fef2f2';
                        badge.style.color = '#991b1b';
                        badge.style.border = '1px solid #fecaca';
                        badge.innerHTML = '<span class="status-dot" style="background:#dc2626;"></span>İptal Edildi';
                    }

                    // Mobil Rozeti
                    const mBadge = document.getElementById('mobile-supp-badge-' + id);
                    if (mBadge) {
                        mBadge.className = 'status-badge shrink-0 inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold border bg-rose-50 text-rose-700 border-rose-200/80';
                        mBadge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-current"></span>İptal Edildi';
                    }

                    // Filtreleme için data-status güncelle
                    const dRow = document.getElementById('supp-order-row-' + id);
                    if (dRow) dRow.setAttribute('data-status', 'İptal Edildi');
                    const mCard = document.getElementById('supp-mobile-order-' + id);
                    if (mCard) mCard.setAttribute('data-status', 'İptal Edildi');

                    const trackingEl = document.getElementById('tracking-order-' + id);
                    if (trackingEl) trackingEl.style.display = 'none';

                    const actionsWrap = document.getElementById('order-actions-wrap-' + id);
                    if (actionsWrap) {
                        actionsWrap.innerHTML = `
                            <span class="status-badge" style="background:#fef2f2; color:#991b1b; border:1px solid #fecaca; font-size:0.75rem; padding:4px 8px; font-weight:700;">
                                ✕ İptal Edildi
                            </span>
                        `;
                    }

                    // Eğer detay modalı açıksa yeniden güncelle
                    if (document.getElementById('suppOrderDetailModal')?.style.display === 'flex') {
                        showSuppOrderDetailsModal(id);
                    }

                    if (typeof showRealtimeToast === 'function') {
                        showRealtimeToast(result.message || 'Sipariş başarıyla iptal edildi.', 'success');
                    }
                } else {
                    alert('Hata: ' + (result.message || 'Sipariş iptal edilemedi.'));
                }
            } catch (err) {
                alert('Bağlantı hatası: ' + err.message);
            }

            return false;
        }

        // ==================== İYZİCO ALT ÜYE İŞYERİ MODALI ====================
        async function openSubMerchantModal() {
            const modal = document.getElementById('subMerchantModal');
            if (!modal) return;

            // Mevcut durumu sunucudan yükle
            try {
                const res = await fetch('/Payment/GetSubMerchantStatus');
                const data = await res.json();
                if (data && data.isAuthenticated) {
                    if (data.legalCompanyTitle) document.getElementById('subMerchantLegalTitle').value = data.legalCompanyTitle;
                    if (data.identityNumber) document.getElementById('subMerchantIdentityNo').value = data.identityNumber;
                    if (data.taxOffice) document.getElementById('subMerchantTaxOffice').value = data.taxOffice;
                    if (data.iban) document.getElementById('subMerchantIban').value = data.iban;
                    if (data.subMerchantType) document.getElementById('subMerchantType').value = data.subMerchantType;
                    if (data.email) document.getElementById('subMerchantEmail').value = data.email;
                    if (data.phone) document.getElementById('subMerchantPhone').value = data.phone;

                    const statusBadge = document.getElementById('subMerchantStatusBadge');
                    if (statusBadge) {
                        if (data.isIyzicoApproved) {
                            statusBadge.className = 'status-badge badge-emerald';
                            statusBadge.textContent = '✓ iyzico Onaylı (Key: ' + (data.subMerchantKey || 'Aktif') + ')';
                        } else {
                            statusBadge.className = 'status-badge badge-amber';
                            statusBadge.textContent = '⚠️ Başvuru Bekleniyor';
                        }
                    }
                }
            } catch (e) {
                console.log('SubMerchant status fetch error:', e);
            }

            modal.style.display = 'flex';
        }

        function closeSubMerchantModal() {
            const modal = document.getElementById('subMerchantModal');
            if (modal) modal.style.display = 'none';
        }

        async function submitSubMerchantForm(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitSubMerchant');
            if (btn) { btn.disabled = true; btn.textContent = 'İşleniyor & iyzico Doğrulanıyor...'; }

            const payload = {
                subMerchantType: document.getElementById('subMerchantType').value,
                legalCompanyTitle: document.getElementById('subMerchantLegalTitle').value.trim(),
                identityNumber: document.getElementById('subMerchantIdentityNo').value.trim(),
                taxOffice: document.getElementById('subMerchantTaxOffice').value.trim(),
                iban: document.getElementById('subMerchantIban').value.trim(),
                contactName: document.getElementById('subMerchantContactName').value.trim(),
                email: document.getElementById('subMerchantEmail').value.trim(),
                phone: document.getElementById('subMerchantPhone').value.trim(),
                address: document.getElementById('subMerchantAddress').value.trim()
            };

            try {
                const res = await fetch('/Payment/RegisterSubMerchant', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    closeSubMerchantModal();
                    alert(data.message || 'iyzico Alt Üye İşyeri kaydınız başarıyla tamamlandı!');
                    location.reload();
                } else {
                    alert('iyzico Hatası: ' + (data.message || 'Kayıt yapılamadı.'));
                }
            } catch (err) {
                alert('Bağlantı hatası: ' + err.message);
            } finally {
                if (btn) { btn.disabled = false; btn.textContent = 'Bilgileri Kaydet & iyzico Hesabı Aç'; }
            }
        }
    </script>
}

