@using satinalmaportali2.Helpers
@model satinalmaportali2.Models.SupplierOrdersViewModel
@{
    ViewData["Title"] = "Gelen Siparişler & Sevkiyat Yönetimi";
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
    ViewBag.DashboardRole = "Supplier";
}

<!-- ==================== SAYFA BAŞLIĞI ==================== -->
<div class="page-head">
    <div>
        <div style="display: flex; align-items: center; gap: 8px;">
            <h1>Gelen Siparişler & Sevkiyat Yönetimi</h1>
            <span class="status-badge badge-emerald" style="font-size: 0.75rem; padding: 3px 10px;">
                <span class="status-dot"></span> Canlı Satış Akışı
            </span>
        </div>
        <p>
            <span>@Model.CompanyName mağazanıza gelen doğrudan kurumsal siparişler, hazırlık ve kargo sevk işlemleri</span>
        </p>
    </div>

    <div style="display: flex; gap: 10px; align-items: center;">
        <button type="button" class="btn-primary" onclick="openSubMerchantModal()" style="display: inline-flex; align-items: center; gap: 6px; background: #0f172a; padding: 10px 18px; font-size: 0.88rem; font-weight: 700; border-radius: 8px; border: none; color: #fff; cursor: pointer;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
            </svg>
            <span>💳 iyzico Alt Üye İşyeri &amp; IBAN Tanımla</span>
        </button>
    </div>
</div>

<!-- ==================== 4 BÜYÜK KPI KARTI ==================== -->
<section class="kpi-row" aria-label="Tedarikçi Sipariş Göstergeleri" style="margin-bottom: 20px;">
    <!-- KPI 1: Gelen Sipariş Sayısı -->
    <article class="card kpi-card">
        <div class="kpi-top">
            <span class="kpi-label">Toplam Gelen Sipariş</span>
            <span class="kpi-icon accent">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                </svg>
            </span>
        </div>
        <p class="kpi-value">@Model.TotalOrderCount</p>
        <p class="kpi-delta is-good">
            <span>Mağazanıza ulaşan siparişler</span>
        </p>
    </article>

    <!-- KPI 2: Toplam Ciro -->
    <article class="card kpi-card">
        <div class="kpi-top">
            <span class="kpi-label">Toplam Sipariş Hacmi</span>
            <span class="kpi-icon good">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="1" x2="12" y2="23"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
            </span>
        </div>
        <p class="kpi-value">@Model.TotalRevenue.ToString("N0", ChartHelper.Tr) ₺</p>
        <p class="kpi-delta is-good">
            <span>Brüt satış hacmi</span>
        </p>
    </article>

    <!-- KPI 3: Sevkiyat Bekleyenler -->
    <article class="card kpi-card">
        <div class="kpi-top">
            <span class="kpi-label">Sevkiyat Bekleyenler</span>
            <span class="kpi-icon @(Model.PendingShipmentCount > 0 ? "warn" : "good")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                </svg>
            </span>
        </div>
        <p class="kpi-value">@Model.PendingShipmentCount</p>
        <p class="kpi-delta @(Model.PendingShipmentCount > 0 ? "is-bad" : "is-good")">
            <span>@(Model.PendingShipmentCount > 0 ? "Kargolanması gereken siparişler" : "Bekleyen sevkiyat yok")</span>
        </p>
    </article>

    <!-- KPI 4: Tamamlanan Teslimatlar -->
    <article class="card kpi-card">
        <div class="kpi-top">
            <span class="kpi-label">Tamamlanan Teslimatlar</span>
            <span class="kpi-icon good">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </span>
        </div>
        <p class="kpi-value">@Model.CompletedCount</p>
        <p class="kpi-delta is-good">
            <span>Müşteriye ulaştırılan siparişler</span>
        </p>
    </article>
</section>

<!-- ==================== FİLTRE & ARAMA ALANI ==================== -->
<div class="card" style="margin-bottom: 20px; padding: 16px 20px;">
    <form method="get" asp-action="SupplierOrders" id="suppOrdersFilterForm" onsubmit="event.preventDefault(); applySuppOrdersFilter(); return false;" style="display: flex; flex-wrap: wrap; gap: 14px; align-items: center; justify-content: space-between;">
        <div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center; flex: 1; min-width: 300px;">
            <div style="position: relative; flex: 1; min-width: 240px; max-width: 420px;">
                <input type="text" name="search" id="suppSearchInput" value="@Model.SearchQuery" class="form-control" placeholder="Sipariş No, alıcı firma, ürün veya kargo takip no ara..." oninput="onSuppSearchInput(this.value)" style="padding-left: 36px; height: 40px; font-size: 0.88rem;" />
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" style="position: absolute; left: 12px; top: 12px; pointer-events: none;">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </div>
        </div>

        <nav class="year-filter" aria-label="Tedarikçi sipariş durumu filtresi">
            <input type="hidden" name="status" id="suppSelectedStatusInput" value="@(Model.SelectedStatus ?? "Tümü")" />
            <button type="button" class="year-pill @(string.IsNullOrEmpty(Model.SelectedStatus) || Model.SelectedStatus == "Tümü" ? "is-active" : "")" 
                    onclick="setSuppStatusFilter('Tümü', this)">
                <span>Tümü</span>
                <span class="status-count-badge" id="suppCountAll">@Model.TotalOrderCount</span>
            </button>
            <button type="button" class="year-pill @(Model.SelectedStatus == "Onaylandı" ? "is-active" : "")" 
                    onclick="setSuppStatusFilter('Onaylandı', this)">
                <span class="status-indicator-dot dot-blue"></span>
                <span>Yeni Sipariş</span>
            </button>
            <button type="button" class="year-pill @(Model.SelectedStatus == "Kargoya Verildi" ? "is-active" : "")" 
                    onclick="setSuppStatusFilter('Kargoya Verildi', this)">
                <span class="status-indicator-dot dot-amber"></span>
                <span>Kargoda</span>
            </button>
            <button type="button" class="year-pill status-pill-in-stock @(Model.SelectedStatus == "Teslim Edildi" ? "is-active" : "")" 
                    onclick="setSuppStatusFilter('Teslim Edildi', this)">
                <span class="status-indicator-dot dot-green"></span>
                <span>Teslim Edildi</span>
            </button>

            <button type="button" id="suppClearFilterBtn" onclick="resetSuppFilters()" class="btn-cancel" style="display: @(!string.IsNullOrWhiteSpace(Model.SearchQuery) || (!string.IsNullOrWhiteSpace(Model.SelectedStatus) && Model.SelectedStatus != "Tümü") ? "inline-flex" : "none"); padding: 7px 12px; font-size: 0.82rem; border-radius: 8px; align-items: center; gap: 4px; cursor: pointer;">
                Temizle
            </button>
        </nav>
    </form>
</div>

<!-- ==================== SİPARİŞLER TABLOSU ==================== -->
<article class="card">
    <header class="card-head">
        <div class="head-with-icon">
            <span class="blue-accent-x">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                </svg>
            </span>
            <h2>Gelen Müşteri Siparişleri (@Model.Orders.Count)</h2>
        </div>
    </header>

    <div class="table-scroll-wrap">
        <table class="dash-table">
            <thead>
                <tr>
                    <th>Sipariş No & Tarih</th>
                    <th>Satın Alan Alıcı Firma</th>
                    <th>Sipariş Kalemleri</th>
                    <th>Tutar</th>
                    <th>Ödeme Şekli</th>
                    <th>Sevkiyat Durumu</th>
                    <th class="text-right">Aksiyon</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Orders.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 48px 16px; color: var(--muted);">
                            <div style="margin-bottom: 12px;">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                                    <rect x="1" y="3" width="15" height="13"></rect>
                                    <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                                </svg>
                            </div>
                            <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 6px; color: var(--text);">Henüz gelen bir müşteri siparişi bulunmamaktadır</h3>
                            <p style="font-size: 0.85rem;">Katalogdaki ürünlerinizi vitrinde yayınlayarak kurumsal alıcılardan doğrudan sipariş alabilirsiniz.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var o in Model.Orders)
                    {
                        var isShipped = o.OrderStatus == "Kargoya Verildi";
                        var isDelivered = o.OrderStatus == "Teslim Edildi" || o.OrderStatus == "Tamamlandı";
                        var searchableText = $"{o.OrderNumber} {o.BuyerCompanyName} {o.DeliveryCity} {o.TrackingNumber} {string.Join(" ", o.OrderItems.Select(oi => oi.ProductName))}".ToLowerInvariant();
                        <tr id="supp-order-row-@o.OrderID" data-status="@o.OrderStatus" data-search="@searchableText">
                            <td>
                                <div class="req-title-cell">
                                    <strong style="font-size: 0.92rem; color: var(--text);">@o.OrderNumber</strong>
                                    <small class="req-code">@o.OrderDate.ToString("dd.MM.yyyy HH:mm")</small>
                                </div>
                            </td>
                            <td>
                                <strong>@o.BuyerCompanyName</strong>
                                <div style="font-size: 0.75rem; color: var(--muted);">@o.DeliveryCity</div>
                            </td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 2px;">
                                    @foreach (var item in o.OrderItems.Take(2))
                                    {
                                        <span style="font-size: 0.82rem; font-weight: 600;">
                                            • @item.ProductName <small style="color: var(--muted);">(@item.Quantity Adet)</small>
                                        </span>
                                    }
                                    @if (o.OrderItems.Count > 2)
                                    {
                                        <small style="color: var(--accent); font-weight: 600;">+ @(o.OrderItems.Count - 2) diğer kalem...</small>
                                    }
                                </div>
                            </td>
                            <td>
                                <strong style="font-size: 0.95rem; color: var(--text);">@o.GrandTotal.ToString("N2", ChartHelper.Tr) ₺</strong>
                                <div style="font-size: 0.72rem; color: var(--muted);">KDV Dahil</div>
                            </td>
                            <td>
                                <span style="font-size: 0.82rem; font-weight: 600;">@o.PaymentMethod</span>
                                <div style="display: flex; flex-direction: column; gap: 3px; margin-top: 3px;">
                                    @if (o.EscrowStatus == "InEscrow")
                                    {
                                        <span class="status-badge" style="background:#f0fdf4; color:#166534; border:1px solid #bbf7d0; font-size:0.68rem; padding:2px 6px;">🛡️ Havuzda Bloke (Kargolayın)</span>
                                    }
                                    else if (o.EscrowStatus == "Released_ToSeller")
                                    {
                                        <span class="status-badge badge-emerald" style="font-size:0.68rem; padding:2px 6px;">✓ Hesaba Aktarıldı</span>
                                    }
                                    else if (o.EscrowStatus == "Disputed")
                                    {
                                        <span class="status-badge badge-amber" style="font-size:0.68rem; padding:2px 6px;">⚠️ İncelemede / İtiraz</span>
                                    }
                                    else if (o.EscrowStatus == "Refunded")
                                    {
                                        <span class="status-badge" style="background:#fef2f2; color:#991b1b; border:1px solid #fecaca; font-size:0.68rem; padding:2px 6px;">↩️ İade Edildi</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge badge-emerald" style="font-size: 0.68rem; padding: 2px 6px;">@o.PaymentStatus</span>
                                    }

                                    @if (o.SupplierPayoutAmount > 0)
                                    {
                                        <small style="font-size: 0.72rem; color: #16a34a; font-weight: 700;">Hak Ediş: @o.SupplierPayoutAmount.ToString("N2", ChartHelper.Tr) ₺</small>
                                    }
                                </div>
                            </td>
                            <td>
                                <div>
                                    <span class="status-badge @(isDelivered ? "badge-emerald" : (isShipped ? "badge-amber" : "badge-blue"))" style="font-size: 0.78rem; padding: 3px 8px;" id="badge-order-@o.OrderID">
                                        <span class="status-dot"></span>
                                        @o.OrderStatus
                                    </span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(o.TrackingNumber))
                                {
                                    <div style="font-size: 0.75rem; margin-top: 4px; color: var(--muted);" id="tracking-order-@o.OrderID">
                                        <strong>@o.ShippingCarrier:</strong> @o.TrackingNumber
                                    </div>
                                }
                            </td>
                            <td class="text-right">
                                <div style="display: flex; flex-direction: column; gap: 6px; align-items: flex-end;">
                                    <button type="button" class="btn-primary" style="padding: 6px 12px; font-size: 0.8rem;" onclick="openShipmentModal(@o.OrderID, '@Html.Raw(o.OrderNumber)', '@Html.Raw(o.OrderStatus)', '@Html.Raw(o.TrackingNumber)', '@Html.Raw(o.ShippingCarrier)')">
                                        Sevkiyatı Yönet
                                    </button>
                                    <button type="button" class="btn-primary" style="padding: 5px 11px; font-size: 0.76rem; font-weight: 700; background: linear-gradient(135deg, #059669 0%, #10b981 100%); border: none; border-radius: 6px; box-shadow: 0 2px 6px rgba(16, 185, 129, 0.3); cursor: pointer;" id="btn-rate-buyer-@o.OrderID" onclick="openSellerRateBuyerModal(@o.OrderID, '@Html.Raw(o.BuyerCompanyName?.Replace("'", "\\'"))')">
                                        ★ Alıcıyı Değerlendir
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</article>

<!-- Modal: Sevkiyat ve Kargo Güncelleme -->
<div id="suppShipmentModal" class="ty-modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.65); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;" onclick="if(event.target===this)closeShipmentModal()">
    <div class="ty-modal-box" style="background: var(--card-bg, #ffffff); border: 1px solid var(--border-color, #e2e8f0); border-radius: 12px; width: 100%; max-width: 500px; padding: 24px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.2);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
            <div>
                <span class="status-badge badge-emerald" style="font-size: 0.72rem; padding: 2px 8px;">SEVKİYAT İŞLEMLERİ</span>
                <h3 id="shipmentModalTitle" style="font-size: 1.2rem; font-weight: 800; color: var(--text, #0f172a); margin-top: 6px; margin-bottom: 4px;">Sipariş Sevkiyatını Güncelle</h3>
            </div>
            <button type="button" class="modal-close-btn" onclick="closeShipmentModal()" style="border: none; background: transparent; font-size: 1.2rem; cursor: pointer; color: var(--muted);">✕</button>
        </div>

        <form id="suppShipmentForm" onsubmit="handleShipmentSubmit(event); return false;">
            <input type="hidden" id="shipmentOrderID" />

            <div class="form-group" style="margin-bottom: 12px;">
                <label class="form-label" style="display: block; font-size: 0.8rem; font-weight: 700; margin-bottom: 4px;">Sipariş Durumu</label>
                <select id="shipmentStatusSelect" class="form-control" style="font-size: 0.88rem;">
                    <option value="Hazırlanıyor">Hazırlanıyor / Paketleniyor</option>
                    <option value="Kargoya Verildi" selected>Kargoya Verildi / Sevk Edildi</option>
                    <option value="Teslim Edildi">Teslim Edildi / Mal Kabul Onaylı</option>
                    <option value="İptal">İptal Edildi</option>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 12px;">
                <label class="form-label" style="display: block; font-size: 0.8rem; font-weight: 700; margin-bottom: 4px;">Kargo / Lojistik Firması</label>
                <select id="shipmentCarrierSelect" class="form-control" style="font-size: 0.88rem;">
                    <option value="Yurtiçi Kargo">Yurtiçi Kargo</option>
                    <option value="MNG Kargo">MNG Kargo</option>
                    <option value="Aras Kargo">Aras Kargo</option>
                    <option value="Borusan Lojistik">Borusan Lojistik</option>
                    <option value="Özel Ambar / Kamyon">Özel Ambar / Kamyon Sevkiyatı</option>
                    <option value="Fabrikadan Teslim">Fabrikadan Doğrudan Teslim</option>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 16px;">
                <label class="form-label" style="display: block; font-size: 0.8rem; font-weight: 700; margin-bottom: 4px;">Kargo Takip No / İrsaliye No</label>
                <input type="text" id="shipmentTrackingNumber" class="form-control" placeholder="Örn: YRT-9823149812" style="font-size: 0.88rem;" />
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button type="button" class="btn-cancel" onclick="closeShipmentModal()">Vazgeç</button>
                <button type="submit" class="btn-primary" style="padding: 10px 18px; font-weight: 700;">
                    Kaydet & Müşteriye Bildir
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: 10 Yıldız Alıcı Değerlendirme Modalı (Satıcı -> Alıcı) -->
<div id="suppRateBuyerModal" class="ty-modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.65); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;" onclick="if(event.target===this)closeSellerRateBuyerModal()">
    <div class="ty-modal-box" style="background: var(--card-bg, #ffffff); border: 1px solid var(--border-color, #e2e8f0); border-radius: 14px; width: 100%; max-width: 520px; padding: 26px; box-shadow: 0 25px 35px -5px rgba(0,0,0,0.25);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
            <div>
                <span class="status-badge badge-emerald" style="font-size: 0.72rem; padding: 2px 8px;">İKİ TARAFLI DEĞERLENDİRME</span>
                <h3 id="sellerRateBuyerModalTitle" style="font-size: 1.2rem; font-weight: 800; color: var(--text, #0f172a); margin-top: 6px; margin-bottom: 2px;">Alıcı Firmayı Değerlendir</h3>
                <small style="color: var(--muted); font-size: 0.8rem;">Bu değerlendirme alıcı firmanın B2B güvenilirlik karnesine ve profil puanına yansır.</small>
            </div>
            <button type="button" onclick="closeSellerRateBuyerModal()" style="border: none; background: transparent; font-size: 1.3rem; cursor: pointer; color: var(--muted);">&times;</button>
        </div>

        <form id="sellerRateBuyerForm" onsubmit="submitSellerRateBuyer(event)">
            <input type="hidden" id="sellerRateOrderID" />
            <input type="hidden" id="sellerRateScore" value="10" />

            <!-- 10 Yıldız Seçici -->
            <div style="text-align: center; margin-bottom: 16px; background: rgba(16,185,129,0.06); padding: 14px; border-radius: 10px; border: 1px solid rgba(16,185,129,0.2);">
                <label style="display: block; font-size: 0.84rem; font-weight: 700; color: var(--text); margin-bottom: 6px;">Alıcı Genel Güvenilirlik Puanı (10 Yıldız)</label>
                <div style="display: flex; justify-content: center; gap: 4px;" id="sellerStarPickerWrap">
                    @for (int i = 1; i <= 10; i++)
                    {
                        <button type="button" class="btn-star-pick-supp" data-val="@i" onclick="pickSellerRateScore(@i)" onmouseenter="previewSellerRateScore(@i)" onmouseleave="restoreSellerRateScore()" style="background: none; border: none; font-size: 1.8rem; color: #10b981; cursor: pointer; padding: 2px; transition: transform 0.15s;">★</button>
                    }
                </div>
                <div id="sellerScoreText" style="font-size: 1.05rem; font-weight: 800; color: #059669; margin-top: 6px;">★ 10.0 / 10 - Mükemmel Alıcı</div>
            </div>

            <!-- Alt Kriterler (10 Üzerinden) -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px;">
                <div>
                    <label style="font-size: 0.74rem; font-weight: 700; display: block; margin-bottom: 4px;">Ödeme / Vadeli Süreç (1-10)</label>
                    <input type="number" id="sellerRatePayment" class="form-control" value="10" min="1" max="10" step="0.5" style="font-size: 0.85rem; padding: 6px 10px;" />
                </div>
                <div>
                    <label style="font-size: 0.74rem; font-weight: 700; display: block; margin-bottom: 4px;">Mal Kabul &amp; İletişim (1-10)</label>
                    <input type="number" id="sellerRateComm" class="form-control" value="10" min="1" max="10" step="0.5" style="font-size: 0.85rem; padding: 6px 10px;" />
                </div>
            </div>

            <!-- Yorum -->
            <div class="form-group" style="margin-bottom: 18px;">
                <label style="font-size: 0.82rem; font-weight: 700; display: block; margin-bottom: 4px;">Tedarikçi Görüşünüz (Opsiyonel)</label>
                <textarea id="sellerRateComment" class="form-control" rows="3" placeholder="Alıcı firmanın ödeme intizamı, teslim alma hızı ve işbirliği yaklaşımı nasıldı?" style="font-size: 0.85rem;"></textarea>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button type="button" class="btn-cancel" onclick="closeSellerRateBuyerModal()">Vazgeç</button>
                <button type="submit" class="btn-primary" style="padding: 10px 20px; font-weight: 700; background: linear-gradient(135deg, #059669 0%, #10b981 100%); border: none;">
                    Alıcıyı Değerlendir
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let currentSellerPickedScore = 10;

        function pickSellerRateScore(val) {
            currentSellerPickedScore = val;
            document.getElementById('sellerRateScore').value = val;
            updateSellerStarsDisplay(val);
        }

        function previewSellerRateScore(val) {
            updateSellerStarsDisplay(val);
        }

        function restoreSellerRateScore() {
            updateSellerStarsDisplay(currentSellerPickedScore);
        }

        function updateSellerStarsDisplay(val) {
            const stars = document.querySelectorAll('#sellerStarPickerWrap .btn-star-pick-supp');
            stars.forEach(btn => {
                const bVal = parseInt(btn.getAttribute('data-val'));
                if (bVal <= val) {
                    btn.style.color = '#10b981';
                    btn.style.opacity = '1';
                } else {
                    btn.style.color = '#cbd5e1';
                    btn.style.opacity = '0.7';
                }
            });

            const labels = {
                1: "★ 1.0 / 10 - Çok Güvensiz",
                2: "★ 2.0 / 10 - Sorunlu Süreç",
                3: "★ 3.0 / 10 - Gecikmeli Ödeme",
                4: "★ 4.0 / 10 - Yetersiz İşbirliği",
                5: "★ 5.0 / 10 - Orta Seviye",
                6: "★ 6.0 / 10 - Ortalama Alıcı",
                7: "★ 7.0 / 10 - İyi",
                8: "★ 8.0 / 10 - Güvenilir",
                9: "★ 9.0 / 10 - Çok İyi",
                10: "★ 10.0 / 10 - Mükemmel Kurumsal Alıcı"
            };
            document.getElementById('sellerScoreText').textContent = labels[val] || `★ ${val} / 10`;
        }

        function openSellerRateBuyerModal(orderId, buyerName) {
            document.getElementById('sellerRateOrderID').value = orderId;
            document.getElementById('sellerRateBuyerModalTitle').textContent = (buyerName ? buyerName + ' ' : '') + '10 Yıldız Değerlendir';
            pickSellerRateScore(10);
            document.getElementById('suppRateBuyerModal').style.display = 'flex';
        }

        function closeSellerRateBuyerModal() {
            document.getElementById('suppRateBuyerModal').style.display = 'none';
        }

        async function submitSellerRateBuyer(e) {
            e.preventDefault();
            const orderId = parseInt(document.getElementById('sellerRateOrderID').value);
            const score = parseFloat(document.getElementById('sellerRateScore').value);
            const payment = parseFloat(document.getElementById('sellerRatePayment').value);
            const comm = parseFloat(document.getElementById('sellerRateComm').value);
            const text = document.getElementById('sellerRateComment').value;

            try {
                const res = await fetch('/Review/SubmitSellerReview', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        orderID: orderId,
                        reviewScore: score,
                        paymentPunctualityScore: payment,
                        communicationScore: comm,
                        reviewText: text
                    })
                });

                const data = await res.json();
                if (data.success) {
                    closeSellerRateBuyerModal();
                    alert(data.message);
                    const btn = document.getElementById('btn-rate-buyer-' + orderId);
                    if (btn) {
                        btn.textContent = `Alıcı Değerlendirildi (★ ${score}/10)`;
                        btn.style.background = '#0f172a';
                        btn.style.boxShadow = 'none';
                    }
                } else {
                    alert(data.message);
                }
            } catch (err) {
                alert('Alıcı değerlendirmesi gönderilirken hata: ' + err);
            }
        }

        let currentSuppStatus = '@(Model.SelectedStatus ?? "Tümü")';
        let searchDebounceTimer = null;

        function setSuppStatusFilter(statusVal, btn) {
            currentSuppStatus = statusVal;
            const inputEl = document.getElementById('suppSelectedStatusInput');
            if (inputEl) inputEl.value = statusVal;

            const nav = btn ? btn.closest('.year-filter') : document.querySelector('.year-filter');
            if (nav) {
                nav.querySelectorAll('.year-pill').forEach(p => p.classList.remove('is-active'));
                if (btn) btn.classList.add('is-active');
            }

            applySuppOrdersFilter();
        }

        function onSuppSearchInput(val) {
            clearTimeout(searchDebounceTimer);
            searchDebounceTimer = setTimeout(() => {
                applySuppOrdersFilter();
            }, 120);
        }

        function resetSuppFilters() {
            const sInput = document.getElementById('suppSearchInput');
            if (sInput) sInput.value = '';
            const allBtn = document.querySelector('button[onclick*="\'Tümü\'"]');
            setSuppStatusFilter('Tümü', allBtn);
        }

        function applySuppOrdersFilter() {
            const search = (document.getElementById('suppSearchInput')?.value || '').trim().toLowerCase();
            const status = currentSuppStatus || 'Tümü';
            const rows = document.querySelectorAll('tr[id^="supp-order-row-"]');
            let visibleCount = 0;

            rows.forEach(row => {
                const rowStatus = row.getAttribute('data-status') || '';
                const rowSearch = row.getAttribute('data-search') || '';

                let matchStatus = false;
                if (status === 'Tümü' || status === 'all' || !status) {
                    matchStatus = true;
                } else if (status === 'Onaylandı') {
                    matchStatus = (rowStatus === 'Onaylandı' || rowStatus === 'Yeni');
                } else if (status === 'Kargoya Verildi') {
                    matchStatus = (rowStatus === 'Kargoya Verildi' || rowStatus === 'Hazırlanıyor');
                } else if (status === 'Teslim Edildi') {
                    matchStatus = (rowStatus === 'Teslim Edildi' || rowStatus === 'Tamamlandı');
                } else {
                    matchStatus = (rowStatus.toLowerCase() === status.toLowerCase());
                }

                const matchSearch = (!search || rowSearch.includes(search));

                if (matchStatus && matchSearch) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const titleHeader = document.querySelector('article.card .head-with-icon h2');
            if (titleHeader) {
                titleHeader.textContent = `Gelen Müşteri Siparişleri (${visibleCount})`;
            }

            const clearBtn = document.getElementById('suppClearFilterBtn');
            if (clearBtn) {
                clearBtn.style.display = (search !== '' || (status !== 'Tümü' && status !== '')) ? 'inline-flex' : 'none';
            }

            let emptySearchRow = document.getElementById('suppOrdersEmptySearchRow');
            if (rows.length > 0 && visibleCount === 0) {
                if (!emptySearchRow) {
                    emptySearchRow = document.createElement('tr');
                    emptySearchRow.id = 'suppOrdersEmptySearchRow';
                    emptySearchRow.innerHTML = '<td colspan="7" style="text-align: center; padding: 40px 16px; color: var(--muted);"><strong style="color: var(--text);">Arama veya filtre kriterinize uygun sipariş bulunamadı.</strong><div style="font-size: 0.8rem; margin-top: 4px;">Farklı bir arama kelimesi deneyebilir veya filtreyi temizleyebilirsiniz.</div></td>';
                    const tbody = document.querySelector('.dash-table tbody');
                    if (tbody) tbody.appendChild(emptySearchRow);
                }
                emptySearchRow.style.display = '';
            } else if (emptySearchRow) {
                emptySearchRow.style.display = 'none';
            }

            // URL state güncellemesi (sayfa yenilenmeden)
            try {
                const url = new URL(window.location.href);
                if (status && status !== 'Tümü') url.searchParams.set('status', status);
                else url.searchParams.delete('status');
                if (search) url.searchParams.set('search', search);
                else url.searchParams.delete('search');
                window.history.replaceState({}, '', url.toString());
            } catch (e) {}
        }

        function openShipmentModal(id, number, status, tracking, carrier) {
            document.getElementById('shipmentOrderID').value = id;
            document.getElementById('shipmentModalTitle').textContent = number + ' - Sevkiyat Güncelle';
            if (status) document.getElementById('shipmentStatusSelect').value = status;
            if (carrier) document.getElementById('shipmentCarrierSelect').value = carrier;
            if (tracking && tracking !== 'null') document.getElementById('shipmentTrackingNumber').value = tracking;
            else document.getElementById('shipmentTrackingNumber').value = '';

            document.getElementById('suppShipmentModal').style.display = 'flex';
        }

        function closeShipmentModal() {
            document.getElementById('suppShipmentModal').style.display = 'none';
        }

        async function handleShipmentSubmit(e) {
            if (e) {
                if (typeof e.preventDefault === 'function') e.preventDefault();
                if (typeof e.stopPropagation === 'function') e.stopPropagation();
            }

            const id = parseInt(document.getElementById('shipmentOrderID').value, 10);
            const status = document.getElementById('shipmentStatusSelect').value;
            const carrier = document.getElementById('shipmentCarrierSelect').value;
            const tracking = document.getElementById('shipmentTrackingNumber').value;

            try {
                const response = await fetch('/Dashboard/UpdateOrderStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        orderID: id,
                        orderStatus: status,
                        shippingCarrier: carrier,
                        trackingNumber: tracking
                    })
                });

                const result = await response.json();
                if (result.success) {
                    closeShipmentModal();

                    const badge = document.getElementById('badge-order-' + id);
                    if (badge) {
                        const isDel = status === "Teslim Edildi" || status === "Tamamlandı";
                        const isShip = status === "Kargoya Verildi";
                        badge.className = 'status-badge ' + (isDel ? 'badge-emerald' : (isShip ? 'badge-amber' : 'badge-blue'));
                        badge.innerHTML = '<span class="status-dot"></span>' + status;
                    }
                    let trackingEl = document.getElementById('tracking-order-' + id);
                    if (tracking && tracking.trim() !== '') {
                        if (!trackingEl && badge && badge.parentElement && badge.parentElement.parentElement) {
                            trackingEl = document.createElement('div');
                            trackingEl.id = 'tracking-order-' + id;
                            trackingEl.style.cssText = 'font-size: 0.75rem; margin-top: 4px; color: var(--muted);';
                            badge.parentElement.parentElement.appendChild(trackingEl);
                        }
                        if (trackingEl) {
                            trackingEl.innerHTML = '<strong>' + carrier + ':</strong> ' + tracking;
                        }
                    }

                    if (typeof showRealtimeToast === 'function') {
                        showRealtimeToast(result.message || 'Sipariş durumu güncellendi!', 'success');
                    }
                } else {
                    if (typeof showRealtimeToast === 'function') {
                        showRealtimeToast('Hata: ' + (result.message || 'Güncellenemedi.'), 'error');
                    } else {
                        alert("Hata: " + (result.message || "Güncellenemedi."));
                    }
                }
            } catch (err) {
                if (typeof showRealtimeToast === 'function') {
                    showRealtimeToast('Bağlantı hatası: ' + err.message, 'error');
                } else {
                    alert("Bağlantı hatası: " + err.message);
                }
            }

            return false;
        }

        // ==================== İYZİCO ALT ÜYE İŞYERİ MODALI ====================
        async function openSubMerchantModal() {
            const modal = document.getElementById('subMerchantModal');
            if (!modal) return;

            // Mevcut durumu sunucudan yükle
            try {
                const res = await fetch('/Payment/GetSubMerchantStatus');
                const data = await res.json();
                if (data && data.isAuthenticated) {
                    if (data.legalCompanyTitle) document.getElementById('subMerchantLegalTitle').value = data.legalCompanyTitle;
                    if (data.identityNumber) document.getElementById('subMerchantIdentityNo').value = data.identityNumber;
                    if (data.taxOffice) document.getElementById('subMerchantTaxOffice').value = data.taxOffice;
                    if (data.iban) document.getElementById('subMerchantIban').value = data.iban;
                    if (data.subMerchantType) document.getElementById('subMerchantType').value = data.subMerchantType;
                    if (data.email) document.getElementById('subMerchantEmail').value = data.email;
                    if (data.phone) document.getElementById('subMerchantPhone').value = data.phone;

                    const statusBadge = document.getElementById('subMerchantStatusBadge');
                    if (statusBadge) {
                        if (data.isIyzicoApproved) {
                            statusBadge.className = 'status-badge badge-emerald';
                            statusBadge.textContent = '✓ iyzico Onaylı (Key: ' + (data.subMerchantKey || 'Aktif') + ')';
                        } else {
                            statusBadge.className = 'status-badge badge-amber';
                            statusBadge.textContent = '⚠️ Başvuru Bekleniyor';
                        }
                    }
                }
            } catch (e) {
                console.log('SubMerchant status fetch error:', e);
            }

            modal.style.display = 'flex';
        }

        function closeSubMerchantModal() {
            const modal = document.getElementById('subMerchantModal');
            if (modal) modal.style.display = 'none';
        }

        async function submitSubMerchantForm(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitSubMerchant');
            if (btn) { btn.disabled = true; btn.textContent = 'İşleniyor & iyzico Doğrulanıyor...'; }

            const payload = {
                subMerchantType: document.getElementById('subMerchantType').value,
                legalCompanyTitle: document.getElementById('subMerchantLegalTitle').value.trim(),
                identityNumber: document.getElementById('subMerchantIdentityNo').value.trim(),
                taxOffice: document.getElementById('subMerchantTaxOffice').value.trim(),
                iban: document.getElementById('subMerchantIban').value.trim(),
                contactName: document.getElementById('subMerchantContactName').value.trim(),
                email: document.getElementById('subMerchantEmail').value.trim(),
                phone: document.getElementById('subMerchantPhone').value.trim(),
                address: document.getElementById('subMerchantAddress').value.trim()
            };

            try {
                const res = await fetch('/Payment/RegisterSubMerchant', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    closeSubMerchantModal();
                    alert(data.message || 'iyzico Alt Üye İşyeri kaydınız başarıyla tamamlandı!');
                    location.reload();
                } else {
                    alert('iyzico Hatası: ' + (data.message || 'Kayıt yapılamadı.'));
                }
            } catch (err) {
                alert('Bağlantı hatası: ' + err.message);
            } finally {
                if (btn) { btn.disabled = false; btn.textContent = 'Bilgileri Kaydet & iyzico Hesabı Aç'; }
            }
        }
    </script>
}

<!-- ==================== İYZİCO ALT ÜYE İŞYERİ MODALI ==================== -->
<div id="subMerchantModal" class="ty-modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.75); backdrop-filter: blur(5px); z-index: 100000; align-items: center; justify-content: center; padding: 20px;" onclick="if(event.target===this)closeSubMerchantModal()">
    <div class="ty-modal-box" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; width: 100%; max-width: 580px; max-height: 90vh; overflow-y: auto; padding: 26px; box-shadow: 0 25px 40px -5px rgba(0,0,0,0.3);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
            <div>
                <span id="subMerchantStatusBadge" class="status-badge badge-blue" style="font-size: 0.72rem; padding: 3px 8px; font-weight: 800;">İYZİCO PAZARYERİ ENTEGRASYONU</span>
                <h3 style="font-size: 1.25rem; font-weight: 800; color: #0f172a; margin-top: 6px; margin-bottom: 2px;">Alt Üye İşyeri &amp; IBAN Hesabı</h3>
                <small style="color: #64748b; font-size: 0.8rem;">Siparişlerden kazandığınız hak edişlerin iyzico tarafından banka hesabınıza aktarılması için gereklidir.</small>
            </div>
            <button type="button" onclick="closeSubMerchantModal()" style="border: none; background: transparent; font-size: 1.3rem; cursor: pointer; color: #64748b;">&times;</button>
        </div>

        <form id="subMerchantForm" onsubmit="submitSubMerchantForm(event)">
            <div style="margin-bottom: 12px;">
                <label style="font-size: 0.8rem; font-weight: 750; color: #334155; display: block; margin-bottom: 4px;">Şirket Türü *</label>
                <select id="subMerchantType" class="form-control" style="font-size: 0.85rem; border-radius: 8px;">
                    <option value="LIMITED_OR_JOINT_STOCK_COMPANY">Limited veya Anonim Şirket (A.Ş. / Ltd. Şti.)</option>
                    <option value="PERSONAL_COMPANY">Şahıs Şirketi (TCKN ile Kayıtlı)</option>
                    <option value="PRIVATE_COMPANY">Adi Ortaklık / Özel Şirket</option>
                </select>
            </div>

            <div style="margin-bottom: 12px;">
                <label style="font-size: 0.8rem; font-weight: 750; color: #334155; display: block; margin-bottom: 4px;">Resmi Ticari Unvan *</label>
                <input type="text" id="subMerchantLegalTitle" class="form-control" placeholder="Örn: Atlas Metal Sanayi ve Ticaret A.Ş." required style="font-size: 0.85rem; border-radius: 8px;" />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
                <div>
                    <label style="font-size: 0.8rem; font-weight: 750; color: #334155; display: block; margin-bottom: 4px;">VKN veya TC Kimlik No *</label>
                    <input type="text" id="subMerchantIdentityNo" class="form-control" placeholder="10 Haneli VKN veya 11 Haneli TCKN" maxlength="11" required style="font-size: 0.85rem; border-radius: 8px;" />
                </div>
                <div>
                    <label style="font-size: 0.8rem; font-weight: 750; color: #334155; display: block; margin-bottom: 4px;">Vergi Dairesi</label>
                    <input type="text" id="subMerchantTaxOffice" class="form-control" placeholder="Örn: Kadıköy VD" style="font-size: 0.85rem; border-radius: 8px;" />
                </div>
            </div>

            <div style="margin-bottom: 12px;">
                <label style="font-size: 0.8rem; font-weight: 750; color: #334155; display: block; margin-bottom: 4px;">Hak Ediş Ödemesi İçin IBAN (26 Karakter) *</label>
                <input type="text" id="subMerchantIban" class="form-control" placeholder="TR320006200000000001234567" maxlength="32" required style="font-size: 0.9rem; font-family: monospace; font-weight: 700; border-radius: 8px; letter-spacing: 0.05em;" />
                <small style="font-size: 0.72rem; color: #64748b;">Örn Test IBAN: <code>TR320006200000000001234567</code> (TR ile başlayan 26 haneli geçerli IBAN)</small>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
                <div>
                    <label style="font-size: 0.8rem; font-weight: 750; color: #334155; display: block; margin-bottom: 4px;">Yetkili Adı Soyadı</label>
                    <input type="text" id="subMerchantContactName" class="form-control" placeholder="Ad Soyad" style="font-size: 0.85rem; border-radius: 8px;" />
                </div>
                <div>
                    <label style="font-size: 0.8rem; font-weight: 750; color: #334155; display: block; margin-bottom: 4px;">Telefon</label>
                    <input type="text" id="subMerchantPhone" class="form-control" placeholder="5XX XXX XX XX" maxlength="11" style="font-size: 0.85rem; border-radius: 8px;" />
                </div>
            </div>

            <div style="margin-bottom: 12px;">
                <label style="font-size: 0.8rem; font-weight: 750; color: #334155; display: block; margin-bottom: 4px;">E-Posta</label>
                <input type="email" id="subMerchantEmail" class="form-control" placeholder="finans@sirketiniz.com" style="font-size: 0.85rem; border-radius: 8px;" />
            </div>

            <div style="margin-bottom: 18px;">
                <label style="font-size: 0.8rem; font-weight: 750; color: #334155; display: block; margin-bottom: 4px;">Tebligat / Şirket Adresi</label>
                <textarea id="subMerchantAddress" class="form-control" rows="2" placeholder="Şirket merkez açık adresi..." style="font-size: 0.85rem; border-radius: 8px;"></textarea>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button type="button" class="btn-cancel" onclick="closeSubMerchantModal()">Vazgeç</button>
                <button type="submit" id="btnSubmitSubMerchant" class="btn-primary" style="padding: 10px 20px; font-weight: 750; background: #0f172a; border: none; border-radius: 8px; color: #fff; cursor: pointer;">
                    Bilgileri Kaydet &amp; iyzico Hesabı Aç
                </button>
            </div>
        </form>
    </div>
</div>
