                                <button type="button" class="btn-primary" style="padding: 6px 12px; font-size: 0.78rem; font-weight: 750; background: #2563eb; border: none; border-radius: 6px; box-shadow: 0 2px 6px rgba(37,99,235,0.3); cursor: pointer;" id="btn-ship-${id}" onclick="openShipModal(${id}, '${orderNumber}', '', '')">
