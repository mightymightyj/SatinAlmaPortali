@using satinalmaportali2.Helpers
@model satinalmaportali2.Models.BuyerDashboardViewModel
@{
    ViewData["Title"] = "Satın Alma ve Talep Analitiği";
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
    ViewBag.DashboardRole = "Buyer";
}

<!-- ==================== SAYFA BAŞLIĞI ==================== -->
<div class="page-head flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
    <div>
        <h1 class="text-xl sm:text-2xl font-black tracking-tight text-slate-900">Satın Alma ve Talep Analitiği</h1>
        <p class="text-xs text-slate-500 mt-1">
            @if (Model.State == satinalmaportali2.Models.DataState.Ok) {
                <span>Gerçek zamanlı satın alma performansı ve talep analitiği</span>
            } else {
                <span>Veri kaynağı bağlı değil</span>
            }
        </p>
    </div>
</div>

<!-- ==================== 4 BÜYÜK KPI KARTI ==================== -->
<section class="kpi-row grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6" aria-label="Özet Göstergeler">

    <!-- KPI 1: Toplam Aktif Talep -->
    <article class="card kpi-card bg-white border border-slate-200/90 rounded-2xl p-5 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
        <div class="kpi-top flex items-center justify-between">
            <span class="kpi-label text-xs font-bold text-slate-500 uppercase tracking-wider">Toplam Aktif Talep</span>
            <span class="kpi-icon accent w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shadow-xs">
                <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
            </span>
        </div>
        <p class="kpi-value text-3xl font-black tracking-tight text-slate-900 my-2">@Model.Summary.TotalActiveRequests</p>
        <p class="kpi-delta text-xs font-medium flex items-center gap-1.5 @(Model.Summary.RequestChangePercent > 0 ? "is-good text-emerald-600 font-semibold" : "is-flat text-slate-500")">
            @if (Model.Summary.RequestChangePercent.HasValue) {
                <span aria-hidden="true" class="text-emerald-500">▲</span>
                <span>%@Model.Summary.RequestChangePercent.Value.ToString("0.0")</span>
                <span class="kpi-delta-note text-slate-400 font-normal">bu hafta +@Model.Summary.RequestsThisWeek talep</span>
            } else {
                <span class="kpi-delta-note text-slate-400 font-normal">karşılaştırılacak önceki dönem yok</span>
            }
        </p>
    </article>

    <!-- KPI 2: Bekleyen Onaylar -->
    <article class="card kpi-card bg-white border border-slate-200/90 rounded-2xl p-5 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
        <div class="kpi-top flex items-center justify-between">
            <span class="kpi-label text-xs font-bold text-slate-500 uppercase tracking-wider">Bekleyen Onaylar</span>
            <span class="kpi-icon w-10 h-10 rounded-xl flex items-center justify-center shadow-xs @(Model.Summary.PendingApprovals > 0 ? "warn bg-amber-50 text-amber-600" : "accent bg-blue-50 text-blue-600")">
                <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
            </span>
        </div>
        <p class="kpi-value text-3xl font-black tracking-tight text-slate-900 my-2">@Model.Summary.PendingApprovals</p>
        <p class="kpi-delta text-xs font-medium flex items-center gap-1.5 @(Model.Summary.UrgentApprovals > 0 ? "is-bad text-rose-600 font-semibold" : "is-flat text-slate-500")">
            @if (Model.Summary.UrgentApprovals > 0) {
                <span class="pulse-indicator w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
                <span>@Model.Summary.UrgentApprovals acil onay bekliyor</span>
            } else {
                <span class="kpi-delta-note text-slate-400 font-normal">tüm talepler güncel</span>
            }
        </p>
    </article>

    <!-- KPI 3: Mevcut Dönem Harcama -->
    <article class="card kpi-card bg-white border border-slate-200/90 rounded-2xl p-5 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
        <div class="kpi-top flex items-center justify-between">
            <span class="kpi-label text-xs font-bold text-slate-500 uppercase tracking-wider">Mevcut Dönem Harcama</span>
            <span class="kpi-icon accent w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shadow-xs">
                <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <line x1="12" y1="1" x2="12" y2="23"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
            </span>
        </div>
        <p class="kpi-value text-3xl font-black tracking-tight text-slate-900 my-2">@Model.Summary.CurrentPeriodSpend.ToString("N0", ChartHelper.Tr) ₺</p>
        <p class="kpi-delta text-xs font-medium flex items-center gap-1.5 @(Model.Summary.SpendChangePercent > 0 ? "is-good text-emerald-600 font-semibold" : "is-flat text-slate-500")">
            @if (Model.Summary.SpendChangePercent.HasValue) {
                <span aria-hidden="true" class="text-emerald-500">▲</span>
                <span>%@Model.Summary.SpendChangePercent.Value.ToString("0.0")</span>
                <span class="kpi-delta-note text-slate-400 font-normal">önceki döneme göre</span>
            } else {
                <span class="kpi-delta-note text-slate-400 font-normal">harcama bütçe dahilinde</span>
            }
        </p>
    </article>

    <!-- KPI 4: Tedarikçi Performansı -->
    <article class="card kpi-card bg-white border border-slate-200/90 rounded-2xl p-5 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
        <div class="kpi-top flex items-center justify-between">
            <span class="kpi-label text-xs font-bold text-slate-500 uppercase tracking-wider">Tedarikçi Performansı</span>
            <span class="kpi-icon good w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shadow-xs">
                <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
            </span>
        </div>
        <p class="kpi-value text-3xl font-black tracking-tight text-slate-900 my-2">
            @Model.Summary.SupplierPerformanceScore.ToString("0.0")
            <span class="kpi-max-score text-base text-slate-400 font-normal">/ 5.0</span>
        </p>
        <p class="kpi-delta text-xs font-medium is-flat text-slate-500">
            <span class="kpi-delta-note text-slate-400 font-normal">@Model.Summary.TotalReviews değerlendirmeye dayanıyor</span>
        </p>
    </article>

</section>

<!-- ==================== 2 BÜYÜK GÖRSEL MODÜL (HARCAMA TRENDİ & DURUM TABLOSU) ==================== -->
<section class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6" aria-label="Analiz Modülleri">

    <!-- MODÜL 1: Harcama Trendi Çizgi Grafiği -->
    <article class="card chart-card bg-white border border-slate-200/90 rounded-2xl p-3.5 sm:p-5 shadow-xs flex flex-col justify-between">
        <header class="card-head flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2.5 border-b border-slate-100 mb-1.5">
            <div>
                <h2 class="text-sm font-bold text-slate-800">Harcama Trendi</h2>
                <p class="card-subhead text-xs text-slate-400 mt-0.5">Aylık fiili harcama ve bütçe limiti analizi</p>
            </div>
            <div class="chart-legend-box flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500 font-medium">
                <span class="chart-legend-item flex items-center gap-1.5 whitespace-nowrap font-bold text-[11px]">
                    <span class="legend-swatch w-2.5 h-2.5 rounded-full bg-blue-600 shrink-0"></span> Fiili
                </span>
                <span class="chart-legend-item flex items-center gap-1.5 whitespace-nowrap font-bold text-[11px] text-slate-400">
                    <span class="legend-swatch w-3 h-0.5 border-t-2 border-dashed border-slate-400 shrink-0"></span> Bütçe
                </span>
            </div>
        </header>

        @{
            var months = Model.SpendTrend.Months;
            var spendValues = Model.SpendTrend.MonthlySpend;
            var budgetValues = Model.SpendTrend.MonthlyBudget;
            var maxVal = Model.SpendTrend.MaxSpendValue > 0 ? (double)Model.SpendTrend.MaxSpendValue : 250000.0;
            var tTop = ChartHelper.NiceCeiling(maxVal);

            const double svgW = 360, svgH = 140, padL = 28, padR = 12, padT = 20, padB = 20;
            var chartW = svgW - padL - padR;
            var chartH = svgH - padT - padB;

            int n = months.Count;
            var stepX = n > 1 ? chartW / (n - 1) : 0;
            Func<int, double> getX = i => padL + stepX * i;
            Func<double, double> getY = val => padT + chartH * (1.0 - (val / tTop));

            Func<double, string> formatAxisTick = val => {
                if (val <= 0) return "0";
                if (val >= 1000000) {
                    var m = val / 1000000.0;
                    return (m % 1 == 0 ? m.ToString("0") : m.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)) + "M";
                }
                if (val >= 1000) {
                    var k = val / 1000.0;
                    return (k % 1 == 0 ? k.ToString("0") : k.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)) + "K";
                }
                return val.ToString("0");
            };

            Func<decimal, string> formatCompactBadge = val => {
                if (val <= 0) return "0 ₺";
                if (val >= 1000000) {
                    var m = (double)val / 1000000.0;
                    return (m % 1 == 0 ? m.ToString("0") : m.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)) + "M ₺";
                }
                if (val >= 1000) {
                    var k = (double)val / 1000.0;
                    return (k % 1 == 0 ? k.ToString("0") : k.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)) + "K ₺";
                }
                return val.ToString("N0", ChartHelper.Tr) + " ₺";
            };

            var shortMonthNames = new string[] { "O", "Ş", "M", "N", "M", "H", "T", "A", "E", "E", "K", "A" };
            var fullMonthNames = new string[] { "Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık" };

            var spendPts = new List<(double X, double Y)>();
            var budgetPts = new List<(double X, double Y)>();

            int maxSpendIdx = 0;
            decimal maxSpendAmt = 0;
            decimal maxBudgetAmt = 0;

            for (int i = 0; i < n; i++)
            {
                decimal sVal = i < spendValues.Count ? spendValues[i] : 0;
                decimal bVal = i < budgetValues.Count ? budgetValues[i] : 0;

                if (sVal > maxSpendAmt)
                {
                    maxSpendAmt = sVal;
                    maxSpendIdx = i;
                    maxBudgetAmt = bVal;
                }

                double px = getX(i);
                double pySpend = getY((double)sVal);
                double pyBudget = getY((double)bVal);

                spendPts.Add((px, pySpend));
                budgetPts.Add((px, pyBudget));
            }

            if (maxBudgetAmt == 0 && maxSpendIdx < budgetValues.Count)
            {
                maxBudgetAmt = budgetValues[maxSpendIdx];
            }

            string maxMonthFull = maxSpendIdx < fullMonthNames.Length ? fullMonthNames[maxSpendIdx] : "Ağustos";

            // Sadece 3 ana seviye: Tavan, Orta, Taban
            var mainTicks = new double[] { tTop, tTop / 2.0, 0.0 };

            Func<List<(double X, double Y)>, string> makeSmoothPath = (pts) => {
                if (pts.Count == 0) return "";
                var sb = new System.Text.StringBuilder();
                sb.AppendFormat(System.Globalization.CultureInfo.InvariantCulture, "M {0:F1} {1:F1}", pts[0].X, pts[0].Y);
                for (int i = 0; i < pts.Count - 1; i++) {
                    var p0 = pts[i];
                    var p1 = pts[i + 1];
                    double dx = (p1.X - p0.X) * 0.45;
                    double cx1 = p0.X + dx;
                    double cy1 = p0.Y;
                    double cx2 = p1.X - dx;
                    double cy2 = p1.Y;
                    sb.AppendFormat(System.Globalization.CultureInfo.InvariantCulture, " C {0:F1} {1:F1}, {2:F1} {3:F1}, {4:F1} {5:F1}", cx1, cy1, cx2, cy2, p1.X, p1.Y);
                }
                return sb.ToString();
            };

            Func<List<(double X, double Y)>, double, string> makeSmoothAreaPath = (pts, baseY) => {
                if (pts.Count == 0) return "";
                var linePath = makeSmoothPath(pts);
                var sb = new System.Text.StringBuilder();
                sb.Append(linePath);
                sb.AppendFormat(System.Globalization.CultureInfo.InvariantCulture, " L {0:F1} {1:F1} L {2:F1} {3:F1} Z", pts[^1].X, baseY, pts[0].X, baseY);
                return sb.ToString();
            };

            string spendCurve = makeSmoothPath(spendPts);
            string spendArea = makeSmoothAreaPath(spendPts, padT + chartH);
            string budgetCurve = makeSmoothPath(budgetPts);
        }

        <!-- Dokunmatik & Etkileşimli Seçili Ay Bilgi Kutusu -->
        <div id="spendChartActiveInfo" class="flex items-center justify-between gap-2 px-3 py-1.5 bg-slate-50 border border-slate-200/80 rounded-xl text-xs my-2 transition-all">
            <div class="flex items-center gap-1.5 min-w-0">
                <span class="w-2 h-2 rounded-full bg-blue-600 shrink-0"></span>
                <strong id="spendActiveMonthName" class="text-slate-900 font-bold truncate">@maxMonthFull (Zirve)</strong>
            </div>
            <div class="flex items-center gap-2 shrink-0 text-xs">
                <span class="text-blue-600 font-extrabold" id="spendActiveAmount">@maxSpendAmt.ToString("N0", ChartHelper.Tr) ₺</span>
                <span class="text-slate-300">/</span>
                <span class="text-slate-500 font-medium" id="spendActiveBudget">Bütçe: @maxBudgetAmt.ToString("N0", ChartHelper.Tr) ₺</span>
            </div>
        </div>

        <div class="chart-body-container w-full my-1">
            <svg viewBox="0 0 @ChartHelper.N(svgW) @ChartHelper.N(svgH)" class="spend-svg-chart w-full h-36 sm:h-44 overflow-visible">
                <defs>
                    <linearGradient id="spendGradient" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#2563EB" stop-opacity="0.25" />
                        <stop offset="70%" stop-color="#3B82F6" stop-opacity="0.06" />
                        <stop offset="100%" stop-color="#3B82F6" stop-opacity="0.0" />
                    </linearGradient>
                </defs>

                <!-- Kılavuz Çizgileri & Y Ekseni (3 Ana Çizgi) -->
                @foreach (var tick in mainTicks)
                {
                    var yPos = getY(tick);
                    <line x1="@ChartHelper.N(padL)" y1="@ChartHelper.N(yPos)" x2="@ChartHelper.N(svgW - padR)" y2="@ChartHelper.N(yPos)" class="stroke-slate-100" stroke-width="1" stroke-dasharray="3 3" />
                    @ChartHelper.SvgText(padL - 4, yPos + 3.5, formatAxisTick(tick), "fill-slate-400 text-[9px] font-bold font-sans", "end")
                }

                <!-- Harcama Alan Doldurması (Yumuşak Bezier Eğrisi) -->
                @if (!string.IsNullOrEmpty(spendArea))
                {
                    <path d="@spendArea" fill="url(#spendGradient)" />
                }

                <!-- Bütçe Limiti (Kesikli Akıcı Çizgi) -->
                @if (!string.IsNullOrEmpty(budgetCurve))
                {
                    <path d="@budgetCurve" class="stroke-slate-400" stroke-width="1.5" stroke-dasharray="4 3" stroke-linecap="round" fill="none" />
                }

                <!-- Fiili Harcama Eğrisi (Kalın Bezier Eğrisi) -->
                @if (!string.IsNullOrEmpty(spendCurve))
                {
                    <path d="@spendCurve" class="stroke-blue-600" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                }

                <!-- Zirve Ay Vurgu Rozeti -->
                @if (maxSpendAmt > 0 && maxSpendIdx < spendPts.Count)
                {
                    var peakPt = spendPts[maxSpendIdx];
                    <g class="pointer-events-none">
                        <rect x="@ChartHelper.N(peakPt.X - 25)" y="@ChartHelper.N(peakPt.Y - 19)" width="50" height="15" rx="4" class="fill-slate-900 shadow-sm" />
                        <polygon points="@ChartHelper.N(peakPt.X - 3),@ChartHelper.N(peakPt.Y - 5) @ChartHelper.N(peakPt.X + 3),@ChartHelper.N(peakPt.Y - 5) @ChartHelper.N(peakPt.X),@ChartHelper.N(peakPt.Y - 1)" class="fill-slate-900" />
                        <text x="@ChartHelper.N(peakPt.X)" y="@ChartHelper.N(peakPt.Y - 8)" class="fill-white text-[9px] font-extrabold font-sans" text-anchor="middle">@formatCompactBadge(maxSpendAmt)</text>
                    </g>
                }

                <!-- Aylık Veri Noktaları & X Ekseni -->
                @for (int i = 0; i < n; i++)
                {
                    var pt = spendPts[i];
                    var val = i < spendValues.Count ? spendValues[i] : 0;
                    var bVal = i < budgetValues.Count ? budgetValues[i] : 0;
                    var isPeak = (i == maxSpendIdx && maxSpendAmt > 0);
                    var mLabel = isPeak ? "Ağu" : (i < shortMonthNames.Length ? shortMonthNames[i] : months[i]);
                    var mFullName = i < fullMonthNames.Length ? fullMonthNames[i] : months[i];
                    var colW = stepX > 0 ? stepX : 24;

                    <g class="chart-month-group focus:outline-none" tabindex="0">
                        <!-- X Ekseni Ay Etiketi -->
                        <text x="@ChartHelper.N(pt.X)" y="@ChartHelper.N(svgH - 6)" text-anchor="middle" class="@(isPeak ? "fill-blue-600 font-extrabold text-[10px]" : "fill-slate-400 font-bold text-[9px]") font-sans">@mLabel</text>

                        <!-- Veri Noktası -->
                        @if (isPeak)
                        {
                            <circle cx="@ChartHelper.N(pt.X)" cy="@ChartHelper.N(pt.Y)" r="6.5" class="fill-blue-500/20" />
                            <circle cx="@ChartHelper.N(pt.X)" cy="@ChartHelper.N(pt.Y)" r="3.5" class="fill-white stroke-blue-600 shadow-xs" stroke-width="2.5" />
                        }
                        else if (val > 0)
                        {
                            <circle cx="@ChartHelper.N(pt.X)" cy="@ChartHelper.N(pt.Y)" r="3" class="fill-white stroke-blue-600" stroke-width="2" />
                        }
                        else
                        {
                            <circle cx="@ChartHelper.N(pt.X)" cy="@ChartHelper.N(pt.Y)" r="1.8" class="fill-slate-300" />
                        }

                        <!-- Mobil ve Masaüstü Geniş Tıklama/Hover Alanı (Hitbox) -->
                        <rect x="@ChartHelper.N(pt.X - colW / 2)" y="0" width="@ChartHelper.N(colW)" height="@ChartHelper.N(svgH)"
                              class="fill-transparent hover:fill-blue-500/5 transition-colors cursor-pointer"
                              onclick="selectSpendMonth('@mFullName', '@val.ToString("N0", ChartHelper.Tr) ₺', '@bVal.ToString("N0", ChartHelper.Tr) ₺', @(isPeak ? "true" : "false"))"
                              onmouseenter="selectSpendMonth('@mFullName', '@val.ToString("N0", ChartHelper.Tr) ₺', '@bVal.ToString("N0", ChartHelper.Tr) ₺', @(isPeak ? "true" : "false"))" />
                    </g>
                }
            </svg>
        </div>

        <div class="chart-foot-summary flex items-center justify-between gap-2 pt-2 border-t border-slate-100 text-xs text-slate-500">
            <span class="chart-foot-item truncate">
                Toplam: <strong class="text-slate-900 font-bold ml-0.5">@Model.SpendTrend.MonthlySpend.Sum().ToString("N0", ChartHelper.Tr) ₺</strong>
            </span>
            <span class="chart-foot-item truncate text-right">
                Ortalama: <strong class="text-slate-900 font-bold ml-0.5">@((Model.SpendTrend.MonthlySpend.Sum() / 12m).ToString("N0", ChartHelper.Tr)) ₺</strong>
            </span>
        </div>
    </article>

    <!-- MODÜL 2: Son Talepler Gerçek Zamanlı Durum Tablosu & Mobil Liste -->
    <article class="card table-card bg-white border border-slate-200/90 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
        <header class="card-head flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 pb-3 border-b border-slate-100 mb-3">
            <div>
                <h2 class="text-sm font-bold text-slate-800">Son Talepler Durum Özeti</h2>
                <p class="card-subhead text-xs text-slate-400 mt-0.5">Gerçek zamanlı satın alma talepleri ve durumları</p>
            </div>
            <div class="table-filter-pills flex items-center gap-1 p-1 bg-slate-100 rounded-lg text-xs overflow-x-auto max-w-full">
                <button type="button" class="tab-pill px-2.5 py-1 rounded-md font-semibold text-slate-600 transition-all is-active bg-white text-blue-600 shadow-xs whitespace-nowrap" onclick="filterRequestTable('all', this)">Tümü</button>
                <button type="button" class="tab-pill px-2.5 py-1 rounded-md font-semibold text-slate-600 hover:text-slate-900 transition-all whitespace-nowrap" onclick="filterRequestTable('Açık', this)">Açık</button>
                <button type="button" class="tab-pill px-2.5 py-1 rounded-md font-semibold text-slate-600 hover:text-slate-900 transition-all whitespace-nowrap" onclick="filterRequestTable('Beklemede', this)">Beklemede</button>
                <button type="button" class="tab-pill px-2.5 py-1 rounded-md font-semibold text-slate-600 hover:text-slate-900 transition-all whitespace-nowrap" onclick="filterRequestTable('Kazanıldı', this)">Kazanıldı</button>
            </div>
        </header>

        <!-- Desktop Tablo Görünümü -->
        <div class="hidden md:block table-scroll-wrap overflow-x-auto">
            <table class="dash-table w-full text-left text-xs border-collapse" id="buyerRequestsTable">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-slate-500 font-semibold uppercase text-[11px]">
                        <th class="p-2.5">Talep / Ürün</th>
                        <th class="p-2.5">Kategori</th>
                        <th class="p-2.5">Bütçe</th>
                        <th class="p-2.5">Durum</th>
                        <th class="text-right p-2.5">Aksiyon</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (!Model.RecentRequests.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-8 text-slate-400">
                                Sistemde henüz kayıtlı bir satın alma talebi bulunmuyor.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var req in Model.RecentRequests)
                        {
                            var statusCls = req.Status switch {
                                "Açık" => "bg-blue-50 text-blue-700 border border-blue-200/60",
                                "Beklemede" => "bg-amber-50 text-amber-700 border border-amber-200/60",
                                "Kazanıldı" => "bg-emerald-50 text-emerald-700 border border-emerald-200/60",
                                "Onaylandı" => "bg-emerald-50 text-emerald-700 border border-emerald-200/60",
                                _ => "bg-slate-100 text-slate-600 border border-slate-200/60"
                            };

                            <tr data-status="@req.Status" class="hover:bg-slate-50/80 transition-colors">
                                <td class="p-2.5">
                                    <div class="req-title-cell flex flex-col gap-0.5">
                                        <span class="req-code text-[11px] font-mono text-slate-400">@req.RequestCode</span>
                                        <strong class="req-name text-xs font-bold text-slate-800 truncate max-w-xs" title="@req.ProductName">@req.ProductName</strong>
                                        <small class="req-date text-[11px] text-slate-400">@req.RequestDate.ToString("dd MMM yyyy")</small>
                                    </div>
                                </td>
                                <td class="p-2.5">
                                    <span class="category-tag px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 text-slate-700">@req.CategoryName</span>
                                </td>
                                <td class="p-2.5">
                                    <strong class="budget-amount text-xs font-bold text-slate-900">@req.EstimatedBudget.ToString("N0", ChartHelper.Tr) ₺</strong>
                                </td>
                                <td class="p-2.5">
                                    <span class="status-badge inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold @statusCls">
                                        <span class="status-dot w-1.5 h-1.5 rounded-full bg-current"></span>
                                        @req.Status
                                    </span>
                                </td>
                                <td class="text-right p-2.5">
                                    <a asp-controller="Requests" asp-action="Index" class="btn-table-action inline-flex items-center px-3 py-1 rounded-md text-xs font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 transition shadow-2xs">
                                        İncele
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobil Kompakt Liste Görünümü (Sadece ayırt edici bilgiler) -->
        <div class="block md:hidden space-y-2.5" id="buyerRequestsMobileList">
            @if (!Model.RecentRequests.Any())
            {
                <div class="text-center py-8 text-slate-400 text-xs">
                    Sistemde henüz kayıtlı bir satın alma talebi bulunmuyor.
                </div>
            }
            else
            {
                @foreach (var req in Model.RecentRequests)
                {
                    var statusCls = req.Status switch {
                        "Açık" => "bg-blue-50 text-blue-700 border border-blue-200/60",
                        "Beklemede" => "bg-amber-50 text-amber-700 border border-amber-200/60",
                        "Kazanıldı" => "bg-emerald-50 text-emerald-700 border border-emerald-200/60",
                        "Onaylandı" => "bg-emerald-50 text-emerald-700 border border-emerald-200/60",
                        _ => "bg-slate-100 text-slate-600 border border-slate-200/60"
                    };

                    <div data-status="@req.Status"
                         data-req-code="@req.RequestCode"
                         data-req-name="@req.ProductName"
                         data-req-category="@req.CategoryName"
                         data-req-budget="@req.EstimatedBudget.ToString("N0", ChartHelper.Tr) ₺"
                         data-req-status="@req.Status"
                         data-req-status-cls="@statusCls"
                         data-req-date="@req.RequestDate.ToString("dd MMM yyyy")"
                         onclick="openBuyerRequestQuickModalFromEl(this)"
                         class="mobile-request-card p-3 rounded-xl border border-slate-200/90 bg-slate-50/50 hover:bg-blue-50/40 hover:border-blue-200 active:scale-[0.99] transition cursor-pointer flex items-center justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="font-mono text-[11px] font-bold text-slate-500">@req.RequestCode</span>
                                <span class="text-[10px] text-slate-400">• @req.RequestDate.ToString("dd MMM yyyy")</span>
                            </div>
                            <div class="text-xs font-bold text-slate-800 truncate" title="@req.ProductName">
                                @req.ProductName
                            </div>
                            <div class="text-[11px] text-slate-500 mt-0.5 truncate">
                                @req.CategoryName
                            </div>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold @statusCls">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                                @req.Status
                            </span>
                            <svg class="w-4 h-4 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                            </svg>
                        </div>
                    </div>
                }
            }
        </div>
    </article>

</section>

<!-- ==================== SATIN ALINAN ÜRÜNLER & SİPARİŞ TAKİBİ ==================== -->
<section class="mb-6" aria-label="Satın Alınan Ürünler">
    <div class="card bg-white border border-slate-200/90 rounded-2xl p-5 shadow-xs">
        <header class="card-head flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100 mb-3">
            <div>
                <div class="flex flex-wrap items-center gap-2">
                    <h2 class="text-sm font-bold text-slate-800">
                        Satın Alınan Ürünler &amp; Siparişlerim
                    </h2>
                    @if (Model.PurchasedProducts.Any())
                    {
                        <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/60 whitespace-nowrap">
                            @Model.PurchasedProducts.Count Kalem Ürün
                        </span>
                        <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-700 border border-blue-200/60 whitespace-nowrap">
                            @Model.TotalPurchasedProductsSpend.ToString("N0", ChartHelper.Tr) ₺ Harcama
                        </span>
                    }
                </div>
                <p class="card-subhead text-xs text-slate-400 mt-0.5">B2B Vitrin üzerinden satın aldığınız kurumsal ürünler ve kargo durumları</p>
            </div>
            <div class="flex flex-wrap items-center gap-2.5">
                <a href="/#ihtiyaciniz-olan-urunler" class="btn-table-action inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-100 transition whitespace-nowrap">
                    Vitrinden Ürün Al
                </a>
                <a asp-controller="Dashboard" asp-action="Orders" class="link-all text-xs font-semibold text-blue-600 hover:underline whitespace-nowrap">
                    Tüm Siparişleri Görüntüle →
                </a>
            </div>
        </header>

        @if (Model.PurchasedProducts.Any())
        {
            <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-xl mb-3 border border-slate-200/80 overflow-x-auto">
                <nav class="year-filter flex items-center gap-1.5 shrink-0" aria-label="Satın alınan ürün durum filtresi">
                    <button type="button" class="year-pill px-3 py-1 rounded-lg text-xs font-semibold bg-blue-600 text-white shadow-xs is-active whitespace-nowrap" onclick="filterPurchasedTable('Tümü', this)">Tümü (@Model.PurchasedProducts.Count)</button>
                    <button type="button" class="year-pill px-3 py-1 rounded-lg text-xs font-semibold bg-white border border-slate-200 text-slate-600 hover:text-slate-900 whitespace-nowrap" onclick="filterPurchasedTable('Onaylandı', this)">
                        Onaylandı
                    </button>
                    <button type="button" class="year-pill px-3 py-1 rounded-lg text-xs font-semibold bg-white border border-slate-200 text-slate-600 hover:text-slate-900 whitespace-nowrap" onclick="filterPurchasedTable('Hazırlanıyor', this)">
                        Hazırlanıyor
                    </button>
                    <button type="button" class="year-pill px-3 py-1 rounded-lg text-xs font-semibold bg-white border border-slate-200 text-slate-600 hover:text-slate-900 whitespace-nowrap" onclick="filterPurchasedTable('Kargoda', this)">
                        Kargoda
                    </button>
                    <button type="button" class="year-pill px-3 py-1 rounded-lg text-xs font-semibold bg-white border border-slate-200 text-emerald-700 hover:bg-emerald-50 whitespace-nowrap" onclick="filterPurchasedTable('Teslim Edildi', this)">
                        Teslim Edildi
                    </button>
                </nav>
            </div>
        }

        <!-- Desktop Tablo Görünümü -->
        <div class="hidden md:block table-scroll-wrap overflow-x-auto">
            <table class="dash-table w-full text-left text-xs border-collapse" id="buyerPurchasedProductsTable">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-slate-500 font-semibold uppercase text-[11px]">
                        <th class="p-2.5">Ürün / Malzeme</th>
                        <th class="p-2.5">Tedarikçi Firma</th>
                        <th class="p-2.5">Miktar</th>
                        <th class="p-2.5">Birim Fiyat</th>
                        <th class="p-2.5">Toplam Tutar</th>
                        <th class="p-2.5">Sipariş No &amp; Tarih</th>
                        <th class="p-2.5">Durum &amp; Sevkiyat</th>
                        <th class="text-right p-2.5">Aksiyon</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (!Model.PurchasedProducts.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-12 text-slate-400">
                                <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <circle cx="9" cy="21" r="1"></circle>
                                        <circle cx="20" cy="21" r="1"></circle>
                                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                    </svg>
                                </div>
                                <h4 class="text-sm font-bold text-slate-800 mb-1">Henüz Satın Alınan Ürün Bulunmuyor</h4>
                                <p class="text-xs text-slate-500 max-w-sm mx-auto mb-4">
                                    B2B vitrinimizdeki onaylı üretici ürünlerinden doğrudan kurumsal sipariş oluşturabilirsiniz.
                                </p>
                                <a href="/#ihtiyaciniz-olan-urunler" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white shadow-xs transition">
                                    B2B Ürün Vitrinine Git →
                                </a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.PurchasedProducts)
                        {
                            var statusBadge = item.OrderStatus switch {
                                "Onaylandı" => "bg-emerald-50 text-emerald-700 border border-emerald-200/60",
                                "Hazırlanıyor" => "bg-amber-50 text-amber-700 border border-amber-200/60",
                                "Kargoya Verildi" => "bg-blue-50 text-blue-700 border border-blue-200/60",
                                "Teslim Edildi" => "bg-emerald-50 text-emerald-700 border border-emerald-200/60",
                                "Tamamlandı" => "bg-emerald-50 text-emerald-700 border border-emerald-200/60",
                                "İptal Edildi" => "bg-slate-100 text-slate-600 border border-slate-200/60",
                                _ => "bg-blue-50 text-blue-700 border border-blue-200/60"
                            };

                            <tr data-status="@item.OrderStatus" class="hover:bg-slate-50/80 transition-colors">
                                <td class="p-2.5">
                                    <div class="req-title-cell flex flex-col gap-0.5">
                                        <strong class="req-name text-xs font-bold text-slate-800 truncate max-w-xs" title="@item.ProductName">
                                            @item.ProductName
                                        </strong>
                                        <div class="flex items-center gap-1.5">
                                             <span class="text-[10px] font-mono text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded">
                                                @(item.Sku ?? $"SKU-{item.ItemID}")
                                            </span>
                                            <span class="category-tag text-[10px] px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 font-medium">
                                                @item.CategoryName
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <td class="p-2.5">
                                    <div class="flex items-center gap-1.5 text-xs text-slate-700 font-medium">
                                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                        @(item.SupplierCompanyName ?? "Onaylı Tedarikçi")
                                    </div>
                                </td>
                                <td class="p-2.5">
                                    <span class="px-2 py-0.5 rounded bg-slate-100 border border-slate-200 text-xs font-bold text-slate-800">
                                        @item.Quantity.ToString("0.##") @item.Unit
                                    </span>
                                </td>
                                <td class="p-2.5 text-xs text-slate-600">
                                    @item.UnitPrice.ToString("N2", ChartHelper.Tr) ₺
                                </td>
                                <td class="p-2.5">
                                    <strong class="text-xs font-extrabold text-emerald-700">
                                        @item.LineTotal.ToString("N2", ChartHelper.Tr) ₺
                                    </strong>
                                </td>
                                <td class="p-2.5">
                                    <div>
                                        <a asp-controller="Dashboard" asp-action="Orders" asp-route-search="@item.OrderNumber" class="font-mono text-xs font-bold text-blue-600 hover:underline">
                                            @item.OrderNumber
                                        </a>
                                        <div class="text-[11px] text-slate-400 mt-0.5">
                                            @item.OrderDate.ToString("dd.MM.yyyy HH:mm")
                                        </div>
                                    </div>
                                </td>
                                <td class="p-2.5">
                                    <span class="status-badge inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold @statusBadge">
                                        <span class="status-dot w-1.5 h-1.5 rounded-full bg-current"></span>
                                        @item.OrderStatus
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(item.TrackingNumber))
                                    {
                                        <div class="text-[11px] text-slate-500 mt-1" title="Kargo Takip No">
                                            <strong>@item.ShippingCarrier:</strong> <code class="bg-slate-100 px-1 rounded text-slate-700">@item.TrackingNumber</code>
                                        </div>
                                    }
                                </td>
                                <td class="text-right p-2.5">
                                    <a asp-controller="Dashboard" asp-action="Orders" asp-route-search="@item.OrderNumber" class="btn-table-action inline-flex items-center px-3 py-1 rounded-md text-xs font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 transition shadow-2xs">
                                        Takip Et →
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobil Kompakt Liste Görünümü (Sadece ayırt edici bilgiler) -->
        <div class="block md:hidden space-y-2.5" id="buyerPurchasedMobileList">
            @if (!Model.PurchasedProducts.Any())
            {
                <div class="text-center py-8 text-slate-400 text-xs">
                    Henüz satın alınan ürün bulunmuyor.
                </div>
            }
            else
            {
                @foreach (var item in Model.PurchasedProducts)
                {
                    var statusBadge = item.OrderStatus switch {
                        "Onaylandı" => "bg-emerald-50 text-emerald-700 border border-emerald-200/60",
                        "Hazırlanıyor" => "bg-amber-50 text-amber-700 border border-amber-200/60",
                        "Kargoya Verildi" => "bg-blue-50 text-blue-700 border border-blue-200/60",
                        "Teslim Edildi" => "bg-emerald-50 text-emerald-700 border border-emerald-200/60",
                        "Tamamlandı" => "bg-emerald-50 text-emerald-700 border border-emerald-200/60",
                        "İptal Edildi" => "bg-slate-100 text-slate-600 border border-slate-200/60",
                        _ => "bg-blue-50 text-blue-700 border border-blue-200/60"
                    };

                    <div data-status="@item.OrderStatus"
                         data-item-name="@item.ProductName"
                         data-item-sku="@(item.Sku ?? $"SKU-{item.ItemID}")"
                         data-item-category="@item.CategoryName"
                         data-item-supplier="@(item.SupplierCompanyName ?? "Onaylı Tedarikçi")"
                         data-item-qty="@item.Quantity.ToString("0.##") @item.Unit"
                         data-item-unitprice="@item.UnitPrice.ToString("N2", ChartHelper.Tr) ₺"
                         data-item-total="@item.LineTotal.ToString("N2", ChartHelper.Tr) ₺"
                         data-item-orderno="@item.OrderNumber"
                         data-item-orderdate="@item.OrderDate.ToString("dd.MM.yyyy HH:mm")"
                         data-item-status="@item.OrderStatus"
                         data-item-status-cls="@statusBadge"
                         data-item-carrier="@(item.ShippingCarrier ?? "")"
                         data-item-tracking="@(item.TrackingNumber ?? "")"
                         onclick="openBuyerPurchasedQuickModalFromEl(this)"
                         class="mobile-purchased-card p-3 rounded-xl border border-slate-200/90 bg-slate-50/50 hover:bg-blue-50/40 hover:border-blue-200 active:scale-[0.99] transition cursor-pointer flex items-center justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="text-[10px] font-mono text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded">@(item.Sku ?? $"SKU-{item.ItemID}")</span>
                                <span class="text-[11px] text-slate-500 font-medium truncate">● @(item.SupplierCompanyName ?? "Tedarikçi")</span>
                            </div>
                            <div class="text-xs font-bold text-slate-800 truncate" title="@item.ProductName">
                                @item.ProductName
                            </div>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold @statusBadge">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                                @item.OrderStatus
                            </span>
                            <svg class="w-4 h-4 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                            </svg>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- ==================== MOBİL TALEP HIZLI DETAY MODALI ==================== -->
<div id="buyerRequestQuickModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs transition-opacity" role="dialog" aria-modal="true" aria-labelledby="buyerReqModalTitle" onclick="if(event.target === this) closeBuyerRequestQuickModal()">
    <div class="relative w-full max-w-md rounded-2xl bg-white p-5 shadow-2xl border border-slate-100 transform transition-all">
        <!-- Başlık & Kapatma -->
        <div class="flex items-start justify-between pb-3 border-b border-slate-100">
            <div>
                <span id="buyerReqModalCode" class="font-mono text-xs font-bold text-blue-600 bg-blue-50 px-2 py-0.5 rounded">REQ-0000</span>
                <h3 id="buyerReqModalTitle" class="text-base font-bold text-slate-900 mt-1.5 leading-snug">Talep Başlığı</h3>
            </div>
            <button type="button" onclick="closeBuyerRequestQuickModal()" class="text-slate-400 hover:text-slate-700 p-1 rounded-lg hover:bg-slate-100 transition" aria-label="Kapat">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Detay İçeriği -->
        <div class="py-4 space-y-3 text-xs">
            <div class="grid grid-cols-2 gap-3 p-3 bg-slate-50 rounded-xl border border-slate-100">
                <div>
                    <span class="text-slate-400 block text-[11px]">Kategori</span>
                    <strong id="buyerReqModalCategory" class="text-slate-800 font-semibold text-xs mt-0.5 block">—</strong>
                </div>
                <div>
                    <span class="text-slate-400 block text-[11px]">Talep Tarihi</span>
                    <strong id="buyerReqModalDate" class="text-slate-800 font-semibold text-xs mt-0.5 block">—</strong>
                </div>
                <div>
                    <span class="text-slate-400 block text-[11px]">Tahmini Bütçe</span>
                    <strong id="buyerReqModalBudget" class="text-emerald-700 font-extrabold text-sm mt-0.5 block">—</strong>
                </div>
                <div>
                    <span class="text-slate-400 block text-[11px]">Durum</span>
                    <div class="mt-0.5">
                        <span id="buyerReqModalStatusBadge" class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-700 border border-blue-200/60">
                            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                            <span id="buyerReqModalStatus">Açık</span>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Aksiyonlar -->
        <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2">
            <button type="button" onclick="closeBuyerRequestQuickModal()" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 transition">
                Kapat
            </button>
            <a asp-controller="Requests" asp-action="Index" class="px-4 py-2 rounded-xl text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white shadow-xs transition">
                Talebi İncele →
            </a>
        </div>
    </div>
</div>

<!-- ==================== MOBİL SATIN ALINAN ÜRÜN HIZLI DETAY MODALI ==================== -->
<div id="buyerPurchasedQuickModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs transition-opacity" role="dialog" aria-modal="true" aria-labelledby="buyerPurchasedModalTitle" onclick="if(event.target === this) closeBuyerPurchasedQuickModal()">
    <div class="relative w-full max-w-md rounded-2xl bg-white p-5 shadow-2xl border border-slate-100 transform transition-all">
        <!-- Başlık & Kapatma -->
        <div class="flex items-start justify-between pb-3 border-b border-slate-100">
            <div class="min-w-0 pr-2">
                <div class="flex items-center gap-2">
                    <span id="buyerPurchasedModalSku" class="font-mono text-[11px] font-bold text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded">SKU</span>
                    <span id="buyerPurchasedModalCategory" class="text-[11px] text-slate-500 font-medium truncate">Kategori</span>
                </div>
                <h3 id="buyerPurchasedModalTitle" class="text-base font-bold text-slate-900 mt-1.5 leading-snug">Ürün Adı</h3>
            </div>
            <button type="button" onclick="closeBuyerPurchasedQuickModal()" class="text-slate-400 hover:text-slate-700 p-1 rounded-lg hover:bg-slate-100 transition shrink-0" aria-label="Kapat">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Detay İçeriği -->
        <div class="py-4 space-y-3 text-xs">
            <div class="grid grid-cols-2 gap-3 p-3 bg-slate-50 rounded-xl border border-slate-100">
                <div class="col-span-2 flex items-center justify-between pb-2 border-b border-slate-200/60">
                    <span class="text-slate-500 font-medium">Tedarikçi Firma</span>
                    <strong id="buyerPurchasedModalSupplier" class="text-slate-800 font-bold">—</strong>
                </div>
                <div>
                    <span class="text-slate-400 block text-[11px]">Sipariş No</span>
                    <strong id="buyerPurchasedModalOrderNo" class="font-mono text-blue-600 font-bold text-xs mt-0.5 block">—</strong>
                </div>
                <div>
                    <span class="text-slate-400 block text-[11px]">Sipariş Tarihi</span>
                    <strong id="buyerPurchasedModalDate" class="text-slate-800 font-semibold text-xs mt-0.5 block">—</strong>
                </div>
                <div>
                    <span class="text-slate-400 block text-[11px]">Miktar</span>
                    <strong id="buyerPurchasedModalQty" class="text-slate-800 font-bold text-xs mt-0.5 block">—</strong>
                </div>
                <div>
                    <span class="text-slate-400 block text-[11px]">Birim Fiyat</span>
                    <strong id="buyerPurchasedModalUnitPrice" class="text-slate-700 font-semibold text-xs mt-0.5 block">—</strong>
                </div>
                <div>
                    <span class="text-slate-400 block text-[11px]">Toplam Tutar</span>
                    <strong id="buyerPurchasedModalTotal" class="text-emerald-700 font-extrabold text-sm mt-0.5 block">—</strong>
                </div>
                <div>
                    <span class="text-slate-400 block text-[11px]">Durum</span>
                    <div class="mt-0.5">
                        <span id="buyerPurchasedModalStatusBadge" class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/60">
                            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                            <span id="buyerPurchasedModalStatus">Onaylandı</span>
                        </span>
                    </div>
                </div>
                <div id="buyerPurchasedModalShippingRow" class="col-span-2 pt-2 border-t border-slate-200/60 flex items-center justify-between text-[11px]">
                    <span class="text-slate-500 font-medium">Kargo / Takip</span>
                    <span id="buyerPurchasedModalTracking" class="font-mono text-slate-700 font-semibold">—</span>
                </div>
            </div>
        </div>

        <!-- Aksiyonlar -->
        <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2">
            <button type="button" onclick="closeBuyerPurchasedQuickModal()" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 transition">
                Kapat
            </button>
            <a id="buyerPurchasedModalActionBtn" href="/Dashboard/Orders" class="px-4 py-2 rounded-xl text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white shadow-xs transition">
                Siparişi Takip Et →
            </a>
        </div>
    </div>
</div>

<script>
    function openBuyerRequestQuickModalFromEl(el) {
        if (!el) return;
        var code = el.getAttribute('data-req-code') || '';
        var name = el.getAttribute('data-req-name') || '';
        var cat = el.getAttribute('data-req-category') || '';
        var budget = el.getAttribute('data-req-budget') || '';
        var status = el.getAttribute('data-req-status') || '';
        var statusCls = el.getAttribute('data-req-status-cls') || 'bg-slate-100 text-slate-700';
        var date = el.getAttribute('data-req-date') || '';

        document.getElementById('buyerReqModalCode').textContent = code;
        document.getElementById('buyerReqModalTitle').textContent = name;
        document.getElementById('buyerReqModalCategory').textContent = cat || 'Satın Alma';
        document.getElementById('buyerReqModalDate').textContent = date;
        document.getElementById('buyerReqModalBudget').textContent = budget;
        document.getElementById('buyerReqModalStatus').textContent = status;
        document.getElementById('buyerReqModalStatusBadge').className = 'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold ' + statusCls;

        var modal = document.getElementById('buyerRequestQuickModal');
        if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.classList.add('overflow-hidden');
        }
    }

    function closeBuyerRequestQuickModal() {
        var modal = document.getElementById('buyerRequestQuickModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.classList.remove('overflow-hidden');
        }
    }

    function openBuyerPurchasedQuickModalFromEl(el) {
        if (!el) return;
        var name = el.getAttribute('data-item-name') || '';
        var sku = el.getAttribute('data-item-sku') || '';
        var cat = el.getAttribute('data-item-category') || '';
        var supplier = el.getAttribute('data-item-supplier') || '';
        var qty = el.getAttribute('data-item-qty') || '';
        var unitPrice = el.getAttribute('data-item-unitprice') || '';
        var total = el.getAttribute('data-item-total') || '';
        var orderNo = el.getAttribute('data-item-orderno') || '';
        var orderDate = el.getAttribute('data-item-orderdate') || '';
        var status = el.getAttribute('data-item-status') || '';
        var statusCls = el.getAttribute('data-item-status-cls') || 'bg-slate-100 text-slate-700';
        var carrier = el.getAttribute('data-item-carrier') || '';
        var tracking = el.getAttribute('data-item-tracking') || '';

        document.getElementById('buyerPurchasedModalTitle').textContent = name;
        document.getElementById('buyerPurchasedModalSku').textContent = sku;
        document.getElementById('buyerPurchasedModalCategory').textContent = cat;
        document.getElementById('buyerPurchasedModalSupplier').textContent = supplier;
        document.getElementById('buyerPurchasedModalOrderNo').textContent = orderNo;
        document.getElementById('buyerPurchasedModalDate').textContent = orderDate;
        document.getElementById('buyerPurchasedModalQty').textContent = qty;
        document.getElementById('buyerPurchasedModalUnitPrice').textContent = unitPrice;
        document.getElementById('buyerPurchasedModalTotal').textContent = total;
        document.getElementById('buyerPurchasedModalStatus').textContent = status;
        document.getElementById('buyerPurchasedModalStatusBadge').className = 'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold ' + statusCls;

        var shippingRow = document.getElementById('buyerPurchasedModalShippingRow');
        var trackingEl = document.getElementById('buyerPurchasedModalTracking');
        if (tracking && tracking.trim() !== '') {
            trackingEl.textContent = (carrier ? carrier + ': ' : '') + tracking;
            shippingRow.style.display = 'flex';
        } else {
            shippingRow.style.display = 'none';
        }

        var actionBtn = document.getElementById('buyerPurchasedModalActionBtn');
        if (actionBtn && orderNo) {
            actionBtn.href = '/Dashboard/Orders?search=' + encodeURIComponent(orderNo);
        }

        var modal = document.getElementById('buyerPurchasedQuickModal');
        if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.classList.add('overflow-hidden');
        }
    }

    function closeBuyerPurchasedQuickModal() {
        var modal = document.getElementById('buyerPurchasedQuickModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.classList.remove('overflow-hidden');
        }
    }

    function selectSpendMonth(month, spend, budget, isPeak) {
        var monthEl = document.getElementById('spendActiveMonthName');
        var spendEl = document.getElementById('spendActiveAmount');
        var budgetEl = document.getElementById('spendActiveBudget');
        if (monthEl) monthEl.textContent = month + (isPeak ? ' (Zirve Ay)' : '');
        if (spendEl) spendEl.textContent = spend;
        if (budgetEl) budgetEl.textContent = budget;
    }
</script>


