@using satinalmaportali2.Helpers
@model satinalmaportali2.Models.BuyerDashboardViewModel
@{
    ViewData["Title"] = "Satın Alma ve Talep Analitiği";
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
    ViewBag.DashboardRole = "Buyer";
}

<!-- ==================== SAYFA BAŞLIĞI VE DÖNEM SEÇİMİ ==================== -->
<div class="page-head">
    <div>
        <h1>Satın Alma ve Talep Analitiği</h1>
        <p>
            @if (Model.State == satinalmaportali2.Models.DataState.Ok) {
                <span>@Model.SelectedYear dönemi · veriler doğrudan veritabanından okunur</span>
            } else {
                <span>Veri kaynağı bağlı değil</span>
            }
        </p>
    </div>

    @if (Model.AvailableYears.Count > 0) {
        <nav class="year-filter" aria-label="Dönem seçimi">
            @foreach (var year in Model.AvailableYears) {
                <a class="year-pill @(year == Model.SelectedYear ? "is-active" : "")"
                   asp-action="Buyer" asp-route-yil="@year"
                   onclick="switchDashboardYear('@year', event)"
                   aria-current="@(year == Model.SelectedYear ? "page" : null)">@year</a>
            }
        </nav>
    }
</div>

<!-- ==================== 4 BÜYÜK KPI KARTI (image_16df7c İLE BİREBİR) ==================== -->
<section class="kpi-row" aria-label="Özet Göstergeler">

    <!-- KPI 1: Toplam Aktif Talep -->
    <article class="card kpi-card">
        <div class="kpi-top">
            <span class="kpi-label">Toplam Aktif Talep</span>
            <span class="kpi-icon accent">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
            </span>
        </div>
        <p class="kpi-value">@Model.Summary.TotalActiveRequests</p>
        <p class="kpi-delta @(Model.Summary.RequestChangePercent > 0 ? "is-good" : "is-flat")">
            @if (Model.Summary.RequestChangePercent.HasValue) {
                <span aria-hidden="true">▲</span>
                <span>%@Model.Summary.RequestChangePercent.Value.ToString("0.0")</span>
                <span class="kpi-delta-note">bu hafta +@Model.Summary.RequestsThisWeek talep</span>
            } else {
                <span class="kpi-delta-note">karşılaştırılacak önceki dönem yok</span>
            }
        </p>
    </article>

    <!-- KPI 2: Bekleyen Onaylar -->
    <article class="card kpi-card">
        <div class="kpi-top">
            <span class="kpi-label">Bekleyen Onaylar</span>
            <span class="kpi-icon @(Model.Summary.PendingApprovals > 0 ? "warn" : "accent")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
            </span>
        </div>
        <p class="kpi-value">@Model.Summary.PendingApprovals</p>
        <p class="kpi-delta @(Model.Summary.UrgentApprovals > 0 ? "is-bad" : "is-flat")">
            @if (Model.Summary.UrgentApprovals > 0) {
                <span class="pulse-indicator"></span>
                <span>@Model.Summary.UrgentApprovals acil onay bekliyor</span>
            } else {
                <span class="kpi-delta-note">tüm talepler güncel</span>
            }
        </p>
    </article>

    <!-- KPI 3: Mevcut Dönem Harcama -->
    <article class="card kpi-card">
        <div class="kpi-top">
            <span class="kpi-label">Mevcut Dönem Harcama</span>
            <span class="kpi-icon accent">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <line x1="12" y1="1" x2="12" y2="23"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
            </span>
        </div>
        <p class="kpi-value">@Model.Summary.CurrentPeriodSpend.ToString("N0", ChartHelper.Tr) ₺</p>
        <p class="kpi-delta @(Model.Summary.SpendChangePercent > 0 ? "is-good" : "is-flat")">
            @if (Model.Summary.SpendChangePercent.HasValue) {
                <span aria-hidden="true">▲</span>
                <span>%@Model.Summary.SpendChangePercent.Value.ToString("0.0")</span>
                <span class="kpi-delta-note">önceki eşit döneme göre</span>
            } else {
                <span class="kpi-delta-note">harcama bütçe dahilinde</span>
            }
        </p>
    </article>

    <!-- KPI 4: Tedarikçi Performansı -->
    <article class="card kpi-card">
        <div class="kpi-top">
            <span class="kpi-label">Tedarikçi Performansı</span>
            <span class="kpi-icon good">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
            </span>
        </div>
        <p class="kpi-value">
            @Model.Summary.SupplierPerformanceScore.ToString("0.0")
            <span class="kpi-max-score">/ 5.0</span>
        </p>
        <p class="kpi-delta is-flat">
            <span class="kpi-delta-note">@Model.Summary.TotalReviews değerlendirmeye dayanıyor</span>
        </p>
    </article>

</section>

<!-- ==================== 2 BÜYÜK GÖRSEL MODÜL (HARCAMA TRENDİ & DURUM TABLOSU) ==================== -->
<section class="grid-equal mt-4" aria-label="Analiz Modülleri">

    <!-- MODÜL 1: Harcama Trendi Çizgi Grafiği -->
    <article class="card chart-card">
        <header class="card-head">
            <div>
                <h2>Harcama Trendi</h2>
                <p class="card-subhead">@Model.SelectedYear · aylık fiili harcama ve bütçe limiti</p>
            </div>
            <div class="chart-legend-box">
                <span class="chart-legend-item">
                    <span class="legend-swatch is-blue"></span> Fiili Harcama
                </span>
                <span class="chart-legend-item">
                    <span class="legend-swatch is-dashed"></span> Bütçe Limiti
                </span>
            </div>
        </header>

        <div class="chart-body-container">
            @{
                var months = Model.SpendTrend.Months;
                var spendValues = Model.SpendTrend.MonthlySpend;
                var budgetValues = Model.SpendTrend.MonthlyBudget;
                var maxVal = Model.SpendTrend.MaxSpendValue > 0 ? (double)Model.SpendTrend.MaxSpendValue : 250000.0;
                var tTop = ChartHelper.NiceCeiling(maxVal);

                const double svgW = 600, svgH = 220, padL = 50, padR = 20, padT = 20, padB = 35;
                var chartW = svgW - padL - padR;
                var chartH = svgH - padT - padB;

                int n = months.Count;
                var stepX = n > 1 ? chartW / (n - 1) : 0;
                Func<int, double> getX = i => padL + stepX * i;
                Func<double, double> getY = val => padT + chartH * (1.0 - (val / tTop));

                var spendPts = new List<(double X, double Y)>();
                var budgetPts = new List<(double X, double Y)>();
                var areaPts = new List<(double X, double Y)>();

                for (int i = 0; i < n; i++)
                {
                    double sVal = i < spendValues.Count ? (double)spendValues[i] : 0;
                    double bVal = i < budgetValues.Count ? (double)budgetValues[i] : 0;

                    double px = getX(i);
                    double pySpend = getY(sVal);
                    double pyBudget = getY(bVal);

                    spendPts.Add((px, pySpend));
                    budgetPts.Add((px, pyBudget));
                }

                if (spendPts.Count > 0)
                {
                    areaPts.Add((spendPts[0].X, padT + chartH));
                    areaPts.AddRange(spendPts);
                    areaPts.Add((spendPts[^1].X, padT + chartH));
                }
            }

            <svg viewBox="0 0 @ChartHelper.N(svgW) @ChartHelper.N(svgH)" class="spend-svg-chart" preserveAspectRatio="none">
                <defs>
                    <linearGradient id="spendGradient" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#2563EB" stop-opacity="0.25" />
                        <stop offset="100%" stop-color="#2563EB" stop-opacity="0.0" />
                    </linearGradient>
                </defs>

                <!-- Kılavuz Çizgileri & Y Ekseni -->
                @foreach (var tick in ChartHelper.Ticks(tTop, 4))
                {
                    var yPos = getY(tick);
                    <line x1="@ChartHelper.N(padL)" y1="@ChartHelper.N(yPos)" x2="@ChartHelper.N(svgW - padR)" y2="@ChartHelper.N(yPos)" class="svg-grid-line" />
                    @ChartHelper.SvgText(padL - 8, yPos + 4, tick >= 1000 ? (tick / 1000).ToString("0") + "k" : tick.ToString("0"), "svg-axis-text", "end")
                }

                <!-- Harcama Alan Doldurması -->
                @if (areaPts.Count > 0)
                {
                    <polygon points="@ChartHelper.PolylinePoints(areaPts)" fill="url(#spendGradient)" />
                }

                <!-- Bütçe Limiti (Kesikli Çizgi) -->
                @if (budgetPts.Count > 0)
                {
                    <polyline points="@ChartHelper.PolylinePoints(budgetPts)" class="svg-budget-line" fill="none" />
                }

                <!-- Fiili Harcama Eğrisi -->
                @if (spendPts.Count > 0)
                {
                    <polyline points="@ChartHelper.PolylinePoints(spendPts)" class="svg-spend-line" fill="none" />
                }

                <!-- Aylık Veri Noktaları & X Ekseni -->
                @for (int i = 0; i < n; i++)
                {
                    var pt = spendPts[i];
                    var val = i < spendValues.Count ? spendValues[i] : 0;
                    var mName = months[i];

                    <g class="chart-point-group" tabindex="0">
                        <circle cx="@ChartHelper.N(pt.X)" cy="@ChartHelper.N(pt.Y)" r="4" class="chart-point-circle" />
                        @ChartHelper.SvgText(pt.X, svgH - 8, mName, "svg-x-text", "middle")
                        
                        <!-- Tooltip -->
                        <g class="chart-tooltip-group">
                            <rect x="@ChartHelper.N(pt.X - 45)" y="@ChartHelper.N(pt.Y - 36)" width="90" height="24" rx="5" class="tooltip-bg" />
                            @ChartHelper.SvgText(pt.X, pt.Y - 20, val.ToString("N0", ChartHelper.Tr) + " ₺", "tooltip-text", "middle")
                        </g>
                    </g>
                }
            </svg>
        </div>

        <div class="chart-foot-summary">
            <span class="chart-foot-item">Toplam Harcama: <strong>@Model.SpendTrend.MonthlySpend.Sum().ToString("N0", ChartHelper.Tr) ₺</strong></span>
            <span class="chart-foot-item">Aylık Ortalama: <strong>@((Model.SpendTrend.MonthlySpend.Sum() / 12m).ToString("N0", ChartHelper.Tr)) ₺</strong></span>
        </div>
    </article>

    <!-- MODÜL 2: Son Talepler Gerçek Zamanlı Durum Tablosu -->
    <article class="card table-card">
        <header class="card-head">
            <div>
                <h2>Son Talepler Durum Özeti</h2>
                <p class="card-subhead">Gerçek zamanlı satın alma talepleri ve durumları</p>
            </div>
            <div class="table-filter-pills">
                <button type="button" class="tab-pill is-active" onclick="filterRequestTable('all', this)">Tümü</button>
                <button type="button" class="tab-pill" onclick="filterRequestTable('Açık', this)">Açık</button>
                <button type="button" class="tab-pill" onclick="filterRequestTable('Beklemede', this)">Beklemede</button>
                <button type="button" class="tab-pill" onclick="filterRequestTable('Kazanıldı', this)">Kazanıldı</button>
            </div>
        </header>

        <div class="table-scroll-wrap">
            <table class="dash-table" id="buyerRequestsTable">
                <thead>
                    <tr>
                        <th>Talep / Ürün</th>
                        <th>Kategori</th>
                        <th>Bütçe</th>
                        <th>Durum</th>
                        <th class="text-right">Aksiyon</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentRequests.Any())
                    {
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 36px 16px; color: var(--muted);">
                                Sistemde henüz kayıtlı bir satın alma talebi bulunmuyor.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var req in Model.RecentRequests)
                        {
                            var statusCls = req.Status switch {
                                "Açık" => "badge-blue",
                                "Beklemede" => "badge-amber",
                                "Kazanıldı" => "badge-emerald",
                                "Onaylandı" => "badge-emerald",
                                _ => "badge-gray"
                            };

                            <tr data-status="@req.Status">
                                <td>
                                    <div class="req-title-cell">
                                        <span class="req-code">@req.RequestCode</span>
                                        <strong class="req-name" title="@req.ProductName">@req.ProductName</strong>
                                        <small class="req-date">@req.RequestDate.ToString("dd MMM yyyy")</small>
                                    </div>
                                </td>
                                <td>
                                    <span class="category-tag">@req.CategoryName</span>
                                </td>
                                <td>
                                    <strong class="budget-amount">@req.EstimatedBudget.ToString("N0", ChartHelper.Tr) ₺</strong>
                                </td>
                                <td>
                                    <span class="status-badge @statusCls">
                                        <span class="status-dot"></span>
                                        @req.Status
                                    </span>
                                </td>
                                <td class="text-right">
                                    <a asp-controller="Requests" asp-action="Index" class="btn-table-action">
                                        İncele
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </article>

</section>

<!-- ==================== SATIN ALINAN ÜRÜNLER & SİPARİŞ TAKİBİ ==================== -->
<section class="mt-4" aria-label="Satın Alınan Ürünler">
    <div class="card">
        <header class="card-head">
            <div>
                <div style="display: flex; align-items: center; gap: 10px;">
                    <h2 style="margin: 0; display: flex; align-items: center; gap: 8px;">
                        Satın Alınan Ürünler &amp; Siparişlerim
                    </h2>
                    @if (Model.PurchasedProducts.Any())
                    {
                        <span class="status-badge badge-emerald" style="font-size: 0.76rem; padding: 2px 8px;">
                            @Model.PurchasedProducts.Count Kalem Ürün
                        </span>
                        <span class="status-badge badge-blue" style="font-size: 0.76rem; padding: 2px 8px;">
                            @Model.TotalPurchasedProductsSpend.ToString("N0", ChartHelper.Tr) ₺ Harcama
                        </span>
                    }
                </div>
                <p class="card-subhead">B2B Vitrin üzerinden satın aldığınız endüstriyel ürünler ve anlık kargo/sevkiyat durumları</p>
            </div>
            <div style="display: flex; align-items: center; gap: 12px;">
                <a href="/#ihtiyaciniz-olan-urunler" class="btn-table-action" style="text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                    Vitrinden Ürün Al
                </a>
                <a asp-controller="Dashboard" asp-action="Orders" class="link-all">
                    Tüm Siparişleri ve Sevkiyatı Görüntüle →
                </a>
            </div>
        </header>

        @if (Model.PurchasedProducts.Any())
        {
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px 16px; background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                <nav class="year-filter" style="margin: 0;" aria-label="Satın alınan ürün durum filtresi">
                    <button type="button" class="year-pill is-active" onclick="filterPurchasedTable('Tümü', this)">Tümü (@Model.PurchasedProducts.Count)</button>
                    <button type="button" class="year-pill" onclick="filterPurchasedTable('Onaylandı', this)">
                        <span class="status-indicator-dot dot-blue"></span> Onaylandı
                    </button>
                    <button type="button" class="year-pill" onclick="filterPurchasedTable('Hazırlanıyor', this)">
                        <span class="status-indicator-dot dot-amber"></span> Hazırlanıyor
                    </button>
                    <button type="button" class="year-pill" onclick="filterPurchasedTable('Kargoda', this)">
                        <span class="status-indicator-dot dot-amber"></span> Kargoda
                    </button>
                    <button type="button" class="year-pill status-pill-in-stock" onclick="filterPurchasedTable('Teslim Edildi', this)">
                        <span class="status-indicator-dot dot-green"></span> Teslim Edildi
                    </button>
                </nav>
            </div>
        }

        <div class="table-scroll-wrap">
            <table class="dash-table" id="buyerPurchasedProductsTable">
                <thead>
                    <tr>
                        <th>Ürün / Malzeme</th>
                        <th>Tedarikçi Firma</th>
                        <th>Miktar</th>
                        <th>Birim Fiyat</th>
                        <th>Toplam Tutar</th>
                        <th>Sipariş No &amp; Tarih</th>
                        <th>Durum &amp; Sevkiyat</th>
                        <th class="text-right">Aksiyon</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.PurchasedProducts.Any())
                    {
                        <tr>
                            <td colspan="8" style="text-align: center; padding: 48px 16px; color: var(--muted);">
                                <div style="margin-bottom: 8px;">
                                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                                        <circle cx="9" cy="21" r="1"></circle>
                                        <circle cx="20" cy="21" r="1"></circle>
                                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                    </svg>
                                </div>
                                <h4 style="font-size: 1.05rem; font-weight: 700; color: #0f172a; margin-bottom: 4px;">Henüz Satın Alınan Ürün Bulunmuyor</h4>
                                <p style="font-size: 0.84rem; color: #64748b; max-width: 440px; margin: 0 auto 16px;">
                                    B2B pazar yerimizdeki onaylı üretici ve distribütör ürünlerini sepetinize ekleyerek doğrudan kurumsal sipariş oluşturabilirsiniz.
                                </p>
                                <a href="/#ihtiyaciniz-olan-urunler" class="btn-dark-pill" style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
                                    B2B Ürün Vitrinine Git →
                                </a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.PurchasedProducts)
                        {
                            var statusBadge = item.OrderStatus switch {
                                "Onaylandı" => "badge-emerald",
                                "Hazırlanıyor" => "badge-amber",
                                "Kargoya Verildi" => "badge-blue",
                                "Teslim Edildi" => "badge-emerald",
                                "Tamamlandı" => "badge-emerald",
                                "İptal Edildi" => "badge-gray",
                                _ => "badge-blue"
                            };

                            <tr data-status="@item.OrderStatus">
                                <td>
                                    <div class="req-title-cell">
                                        <strong class="req-name" style="font-size: 0.92rem; color: #0f172a;" title="@item.ProductName">
                                            @item.ProductName
                                        </strong>
                                        <div style="display: flex; align-items: center; gap: 6px; margin-top: 2px;">
                                            <span style="font-size: 0.72rem; color: #64748b; font-family: monospace; background: #f1f5f9; padding: 1px 5px; border-radius: 4px;">
                                                @(item.Sku ?? $"SKU-{item.ItemID}")
                                            </span>
                                            <span class="category-tag" style="font-size: 0.7rem; padding: 1px 6px;">
                                                @item.CategoryName
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 6px;">
                                        <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #059669;"></span>
                                        <strong style="font-size: 0.85rem; color: #334155;">
                                            @(item.SupplierCompanyName ?? "Onaylı Tedarikçi")
                                        </strong>
                                    </div>
                                </td>
                                <td>
                                    <span style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 3px 8px; font-weight: 700; font-size: 0.84rem; color: #0f172a;">
                                        @item.Quantity.ToString("0.##") @item.Unit
                                    </span>
                                </td>
                                <td>
                                    <span style="font-size: 0.86rem; color: #64748b;">
                                        @item.UnitPrice.ToString("N2", ChartHelper.Tr) ₺
                                    </span>
                                </td>
                                <td>
                                    <strong style="font-size: 0.95rem; font-weight: 850; color: #059669;">
                                        @item.LineTotal.ToString("N2", ChartHelper.Tr) ₺
                                    </strong>
                                </td>
                                <td>
                                    <div>
                                        <a asp-controller="Dashboard" asp-action="Orders" asp-route-search="@item.OrderNumber" style="font-family: monospace; font-size: 0.82rem; font-weight: 700; color: #2563eb; text-decoration: none;">
                                            @item.OrderNumber
                                        </a>
                                        <div style="font-size: 0.74rem; color: #94a3b8; margin-top: 1px;">
                                            @item.OrderDate.ToString("dd.MM.yyyy HH:mm")
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="status-badge @statusBadge">
                                        <span class="status-dot"></span>
                                        @item.OrderStatus
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(item.TrackingNumber))
                                    {
                                        <div style="font-size: 0.72rem; color: #64748b; margin-top: 3px;" title="Kargo Takip No">
                                            <strong>@item.ShippingCarrier:</strong> <code>@item.TrackingNumber</code>
                                        </div>
                                    }
                                </td>
                                <td class="text-right">
                                    <a asp-controller="Dashboard" asp-action="Orders" asp-route-search="@item.OrderNumber" class="btn-table-action" style="text-decoration: none;">
                                        Takip Et →
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- ==================== BOŞ DURUM (EMPTY STATE) MODÜLÜ (image_16dfd3 İLE BİREBİR) ==================== -->
<section class="grid-equal mt-4" aria-label="Yeni Alış Talepleri ve Bütçe">

    <!-- Yeni Alış Talepleri Kartı -->
    <div class="card empty-container-card">
        <header class="card-head">
            <div class="head-with-icon">
                <span class="blue-accent-x">✕</span>
                <h2>Yeni Alış Talepleri</h2>
            </div>
            <a asp-controller="Requests" asp-action="Index" class="link-all">Tüm Talepler</a>
        </header>

        <!-- Boş Durum Alanı -->
        <div class="empty-state-body">
            <div class="empty-state-inner">
                <div class="empty-icon-circle">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="12" y1="18" x2="12" y2="12"></line>
                        <line x1="9" y1="15" x2="15" y2="15"></line>
                    </svg>
                </div>
                <h3>Bekleyen Yeni Alış Talebi Yok</h3>
                <p>
                    İhtiyaç duyduğunuz ürün veya hizmetler için hemen yeni bir satın alma talebi oluşturun.
                </p>
                <button type="button" class="btn-dark-pill" onclick="openRequestModal()">
                    <span class="plus-symbol">+</span> Yeni Talep Oluştur
                </button>
            </div>
        </div>
    </div>

    <!-- Kategori Bazlı Bütçe Tüketimi -->
    <div class="card budget-card">
        <header class="card-head">
            <div class="head-with-icon">
                <span class="blue-accent-x">✕</span>
                <h2>Kategoriye Göre Bütçe</h2>
            </div>
            <span class="badge-period">@Model.SelectedYear Bütçesi</span>
        </header>

        <div class="budget-bars-body">
            @foreach (var b in Model.BudgetCategories)
            {
                var isHigh = b.SpentPercent > 80;
                <div class="budget-row">
                    <div class="budget-meta">
                        <span class="budget-cat-title">@b.CategoryName</span>
                        <span class="budget-cat-val">@b.SpentAmount.ToString("N0", ChartHelper.Tr) ₺ / @b.AllocatedBudget.ToString("N0", ChartHelper.Tr) ₺</span>
                    </div>
                    <div class="progress-track">
                        <div class="progress-bar @(isHigh ? "is-warn" : "")" style="width: @Math.Min(b.SpentPercent, 100)%"></div>
                    </div>
                </div>
            }
        </div>
    </div>

</section>

<!-- ==================== TEDARİKÇİ KARNESİ ÖZETİ (image_16df7c / image_16df5a İLE BİREBİR) ==================== -->
<section class="mt-4" aria-label="Tedarikçi Karnesi">
    <div class="card" id="tedarikci-karnesi">
        <header class="card-head">
            <div>
                <h2>Tedarikçi Karnesi</h2>
                <p class="card-subhead">@Model.SelectedYear yılında aldığı talep sayısı ve puan ortalaması</p>
            </div>
            <a asp-controller="Dashboard" asp-action="Analytics" class="link-all">Tüm Tedarikçiler →</a>
        </header>

        <div class="table-scroll-wrap">
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>FİRMA</th>
                        <th>TİP / KATEGORİ</th>
                        <th>ALINAN TALEP</th>
                        <th>PUAN</th>
                        <th>DEĞERLENDİRME</th>
                        <th class="text-right">GÜVENİLİRLİK</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var vendor in Model.TopSuppliers)
                    {
                        <tr>
                            <td>
                                <div class="vendor-cell">
                                    <div class="vendor-avatar">@vendor.CompanyName.Substring(0, 2).ToUpper()</div>
                                    <strong class="vendor-name">@vendor.CompanyName</strong>
                                </div>
                            </td>
                            <td><span class="category-tag">@vendor.Category</span></td>
                            <td><strong>@vendor.CompletedOrders</strong></td>
                            <td><strong class="score-num">★ @vendor.Score.ToString("0.0")</strong></td>
                            <td><span class="text-muted">@vendor.ReviewCount değerlendirme</span></td>
                            <td class="text-right">
                                <span class="status-badge badge-emerald">
                                    <span class="status-dot"></span> Onaylı Firma
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
