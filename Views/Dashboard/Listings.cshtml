        function setDashCreateMainImage(idx) {
            if (idx < 0 || idx >= dashCreateUploadedImages.length) return;
            dashCreateUploadedImages.forEach((img, i) => {
                img.isMain = (i === idx);
            });
            renderDashCreateImages();
            if (typeof showRealtimeToast === 'function') {
                showRealtimeToast("Ana görsel güncellendi.", "info");
            }
        }

        function removeDashCreateImage(idx) {
            if (idx < 0 || idx >= dashCreateUploadedImages.length) return;
            const removed = dashCreateUploadedImages.splice(idx, 1)[0];
            if (removed && removed.previewUrl && removed.previewUrl.startsWith('blob:')) {
                try { URL.revokeObjectURL(removed.previewUrl); } catch(e) {}
            }
            if (removed && removed.isMain && dashCreateUploadedImages.length > 0) {
                dashCreateUploadedImages[0].isMain = true;
            }
            renderDashCreateImages();
            if (typeof showRealtimeToast === 'function') {
                showRealtimeToast("Görsel kaldırıldı.", "info");
            }
        }

