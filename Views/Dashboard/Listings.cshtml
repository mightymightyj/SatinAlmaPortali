        async function openEditListingModal(itemId) {
            if (!itemId) return;
            try {
                const res = await fetch('/Dashboard/GetProductDetails?id=' + itemId);
                if (!res.ok) {
                    const errText = await res.text();
                    console.error('GetProductDetails HTTP error:', res.status, errText);
                    throw new Error(`Sunucu hatası (${res.status})`);
                }
                const data = await res.json();
                if (!data.success || !data.product) {
                    if (typeof showRealtimeToast === 'function') showRealtimeToast(data.message || 'Ürün bilgileri alınamadı.', 'error');
                    else alert(data.message || 'Ürün bilgileri alınamadı.');
                    return;
                }

                const p = data.product;
                document.getElementById('dashEditItemId').value = p.itemId || itemId;
                document.getElementById('dashEditProductName').value = p.productName || p.itemName || '';
                document.getElementById('dashEditPrice').value = p.unitPrice ?? p.price ?? 0;
                document.getElementById('dashEditStock').value = p.stockQuantity ?? p.stock ?? 0;
                document.getElementById('dashEditDesc').value = p.itemDescription || p.description || '';

                (dashEditUploadedImages || []).forEach(img => {
                    if (img.previewUrl && img.previewUrl.startsWith('blob:')) {
                        try { URL.revokeObjectURL(img.previewUrl); } catch(e) {}
                    }
                });

                // Görselleri tüm olası format ve isimlendirmeleri destekleyerek çözümle
                dashEditUploadedImages = (p.images || []).map((img, i) => {
                    const url = typeof img === 'string' ? img : (img.imageUrl || img.ImageUrl || img.url || img.Url || '');
                    const imgId = typeof img === 'object' ? (img.imageID ?? img.imageId ?? 0) : 0;
                    const pubId = typeof img === 'object' ? (img.publicId || img.PublicId || '') : '';
                    const isMain = typeof img === 'object' ? Boolean(img.isMain || img.IsMain) : (i === 0);
                    const order = typeof img === 'object' ? (img.displayOrder ?? img.DisplayOrder ?? i) : i;

                    return {
                        isExisting: true,
                        imageID: imgId,
                        imageUrl: url,
                        publicId: pubId,
                        isMain: isMain,
                        displayOrder: order
                    };
                }).filter(img => img.imageUrl && img.imageUrl !== '/images/default-product.svg');

                // Fallback 1: Eğer p.images boş geldiyse fakat p.mainImageUrl tanımlıysa
                if (dashEditUploadedImages.length === 0 && p.mainImageUrl && p.mainImageUrl !== '/images/default-product.svg') {
                    dashEditUploadedImages.push({
                        isExisting: true,
                        imageID: 0,
                        imageUrl: p.mainImageUrl,
                        publicId: '',
                        isMain: true,
                        displayOrder: 0
                    });
                }

                // Fallback 2: Eğer hala boşsa, tablodaki satırın görselinden çek
                if (dashEditUploadedImages.length === 0) {
                    const rowImg = document.querySelector(`#listing-row-${itemId} td:first-child img`);
                    if (rowImg && rowImg.src && !rowImg.src.includes('default-product.svg')) {
                        dashEditUploadedImages.push({
                            isExisting: true,
                            imageID: 0,
                            imageUrl: rowImg.src,
                            publicId: '',
                            isMain: true,
                            displayOrder: 0
                        });
                    }
                }

                if (dashEditUploadedImages.length > 0 && !dashEditUploadedImages.some(x => x.isMain)) {
                    dashEditUploadedImages[0].isMain = true;
                }

                renderDashEditImages();
                setupDashboardDropzones();

                const modal = document.getElementById('dashEditListingModal');
                if (modal) {
                    document.getElementById('dashboardBottomBar')?.classList.add('hidden');
                    modal.style.display = 'flex';
                }
            } catch(err) {
                console.error('GetProductDetails error:', err);
                if (typeof showRealtimeToast === 'function') showRealtimeToast('Bağlantı hatası: ' + err.message, 'error');
            }
        }

        function closeEditListingModal() {
            const modal = document.getElementById('dashEditListingModal');
            if (modal) modal.style.display = 'none';
            document.getElementById('dashboardBottomBar')?.classList.remove('hidden');
            (dashEditUploadedImages || []).forEach(img => {
                if (img.previewUrl && img.previewUrl.startsWith('blob:')) {
                    try { URL.revokeObjectURL(img.previewUrl); } catch(e) {}
                }
            });
            dashEditUploadedImages = [];
            renderDashEditImages();
        }

        function handleDashEditImageFiles(files) {
            if (!files || files.length === 0) return;
            const validExts = ['image/jpeg', 'image/png', 'image/webp', 'image/gif', 'image/jpg'];
            const validFileExts = ['.jpg', '.jpeg', '.png', '.webp', '.gif'];

            const existingCount = (typeof dashEditExistingImages !== 'undefined') ? dashEditExistingImages.length : 0;
            if ((existingCount + dashEditUploadedImages.length) >= memMaxImages) {
                if (typeof showRealtimeToast === 'function') showRealtimeToast(`${memTierName} planınızda bir ürün için en fazla ${memMaxImages} görsel ekleyebilirsiniz.`, "warning");
                return;
            }

            let addedCount = 0;
            for (let i = 0; i < files.length; i++) {
                if ((existingCount + dashEditUploadedImages.length) >= memMaxImages) {
                    if (typeof showRealtimeToast === 'function') showRealtimeToast(`En fazla ${memMaxImages} görsel sınırına ulaşıldı. Kalan dosyalar eklenmedi.`, "warning");
                    break;
                }

                const file = files[i];
                if (file.size > 10 * 1024 * 1024) {
                    if (typeof showRealtimeToast === 'function') showRealtimeToast(`"${file.name}" 10MB sınırını aşıyor.`, 'error');
                    continue;
                }
                const ext = file.name ? file.name.substring(file.name.lastIndexOf('.')).toLowerCase() : '';
                if ((file.type && !validExts.includes(file.type.toLowerCase())) && !validFileExts.includes(ext)) {
                    if (typeof showRealtimeToast === 'function') showRealtimeToast(`"${file.name}" geçerli bir görsel formatı değil.`, 'error');
                    continue;
                }

                dashEditUploadedImages.push({
                    isExisting: false,
                    file: file,
                    previewUrl: URL.createObjectURL(file),
                    isMain: dashEditUploadedImages.length === 0,
                    displayOrder: dashEditUploadedImages.length
                });
                addedCount++;
            }

            renderDashEditImages();
            const fileInput = document.getElementById('dashEditImageInput');
            if (fileInput) fileInput.value = '';

            if (addedCount > 0 && typeof showRealtimeToast === 'function') {
                showRealtimeToast(`${addedCount} yeni görsel eklendi. 'Değişiklikleri Kaydet' dediğinizde yüklenecektir.`, 'info');
            }
        }

        function renderDashEditImages() {
            const grid = document.getElementById('dashEditThumbsGrid');
            const countEl = document.getElementById('dashEditImagesCount');
            if (countEl) countEl.textContent = dashEditUploadedImages.length;
            if (!grid) return;

            if (dashEditUploadedImages.length === 0) {
                grid.style.display = 'block';
                grid.innerHTML = `
                    <div class="b2b-thumbs-empty-notice">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="margin: 0 auto 6px; display: block; color: #94a3b8;">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            <circle cx="8.5" cy="8.5" r="1.5"></circle>
                            <polyline points="21 15 16 10 5 21"></polyline>
                        </svg>
                        Henüz ürün görseli bulunmuyor. Yukarıdaki alana tıklayarak veya sürükleyerek görsel ekleyebilirsiniz.
                    </div>
                `;
                return;
            }

            grid.style.display = 'flex';
            let cardsHtml = dashEditUploadedImages.map((img, idx) => `
                <div class="b2b-img-thumb-card ${img.isMain ? 'is-main' : ''}" data-index="${idx}" style="width: 76px !important; height: 76px !important; min-width: 76px !important; max-width: 76px !important; min-height: 76px !important; max-height: 76px !important; position: relative !important; border-radius: 8px !important; overflow: hidden !important; flex-shrink: 0 !important; background: #f1f5f9; border: 2px solid ${img.isMain ? '#10b981' : '#cbd5e1'} !important; box-shadow: ${img.isMain ? '0 0 0 2px rgba(16,185,129,0.35)' : '0 1px 2px rgba(0,0,0,0.05)'}; box-sizing: border-box !important;">
                    <img src="${img.previewUrl || img.imageUrl}" alt="Ürün Görseli ${idx+1}" style="width: 100% !important; height: 100% !important; max-width: 100% !important; max-height: 100% !important; min-width: 100% !important; min-height: 100% !important; object-fit: cover !important; display: block !important; border-radius: 6px;" onerror="this.src='/images/default-product.svg'" />
                    ${img.isMain ? '<span class="b2b-thumb-badge-main" style="position: absolute; top: 2px; left: 2px; background: #059669; color: #fff; font-size: 0.55rem; font-weight: 800; padding: 1px 4px; border-radius: 3px; z-index: 3; line-height: 1.1; pointer-events: none;">★ Ana</span>' : (!img.isExisting ? '<span class="b2b-thumb-badge-new" style="position: absolute; top: 2px; left: 2px; background: #0284c7; color: #fff; font-size: 0.55rem; font-weight: 800; padding: 1px 4px; border-radius: 3px; z-index: 3; line-height: 1.1; pointer-events: none;">Yeni</span>' : '')}
                    <button type="button" class="btn-remove-img" onclick="removeDashEditImage(${idx})" title="Bu görseli kaldır" style="position: absolute; top: 2px; right: 2px; width: 18px; height: 18px; border-radius: 50%; background: rgba(239,68,68,0.95); color: #fff; border: 1.5px solid #fff; font-size: 0.65rem; font-weight: 900; display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 5; padding: 0; line-height: 1;">✕</button>
                    ${img.isMain ? 
                        '<div class="btn-make-main active" title="Vitrin ve kartlarda ilk gösterilen ana görseldir" style="position: absolute; bottom: 0; left: 0; right: 0; background: #059669; color: #fff; font-size: 0.55rem; font-weight: 700; padding: 2px 1px; text-align: center; z-index: 4; cursor: default; line-height: 1.1;">★ Ana Görsel</div>' : 
                        `<button type="button" class="btn-make-main" onclick="setDashEditMainImage(${idx})" title="Ana görsel olarak belirle" style="position: absolute; bottom: 0; left: 0; right: 0; background: rgba(15,23,42,0.85); color: #fff; border: none; font-size: 0.55rem; font-weight: 700; padding: 2px 1px; text-align: center; z-index: 4; cursor: pointer; line-height: 1.1;">Ana Yap</button>`
                    }
                </div>
            `).join('');

            if (dashEditUploadedImages.length < 10) {
                cardsHtml += `
                    <div class="b2b-thumb-add-btn" onclick="document.getElementById('dashEditImageInput').click()" title="Yeni görsel ekle" style="width: 76px !important; height: 76px !important; min-width: 76px !important; max-width: 76px !important; min-height: 76px !important; max-height: 76px !important; border-radius: 8px; border: 2px dashed #cbd5e1; background: #f8fafc; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; color: #64748b; font-size: 0.65rem; font-weight: 700; gap: 1px; flex-shrink: 0; box-sizing: border-box !important;">
                        <span style="font-size: 1.2rem; line-height: 1;">+</span>
                        <span>Ekle</span>
                    </div>
                `;
            }

            grid.innerHTML = cardsHtml;
        }

        function setDashEditMainImage(idx) {
            if (idx < 0 || idx >= dashEditUploadedImages.length) return;
            dashEditUploadedImages.forEach((img, i) => {
                img.isMain = (i === idx);
            });
            renderDashEditImages();
            if (typeof showRealtimeToast === 'function') {
                showRealtimeToast("Ana görsel güncellendi.", "info");
            }
        }

        function removeDashEditImage(idx) {
            if (idx < 0 || idx >= dashEditUploadedImages.length) return;
            const removed = dashEditUploadedImages.splice(idx, 1)[0];
            if (removed && removed.previewUrl && removed.previewUrl.startsWith('blob:')) {
                try { URL.revokeObjectURL(removed.previewUrl); } catch(e) {}
            }
            if (removed && removed.isMain && dashEditUploadedImages.length > 0) {
                dashEditUploadedImages[0].isMain = true;
            }
            renderDashEditImages();
            if (typeof showRealtimeToast === 'function') {
                showRealtimeToast(removed.isExisting ? "Kayıtlı görsel kaldırıldı. 'Değişiklikleri Kaydet' dediğinizde silinecektir." : "Seçilen görsel listeden kaldırıldı.", "info");
            }
        }

        async function saveEditListing(e) {
            if (e && typeof e.preventDefault === 'function') e.preventDefault();

            const itemId = parseInt(document.getElementById('dashEditItemId')?.value || '0', 10);
            const productName = document.getElementById('dashEditProductName')?.value || '';
            const price = parseFloat(document.getElementById('dashEditPrice')?.value || '0');
            const stock = parseInt(document.getElementById('dashEditStock')?.value || '0', 10);
            const desc = document.getElementById('dashEditDesc')?.value || '';

            if (!itemId || !productName.trim() || isNaN(price) || price <= 0) {
                if (typeof showRealtimeToast === 'function') showRealtimeToast("Lütfen tüm zorunlu alanları doğru doldurunuz.", "error");
                else alert("Lütfen tüm zorunlu alanları doğru doldurunuz.");
                return false;
            }

            const submitBtn = document.getElementById('dashEditSubmitBtn');
            const origHtml = submitBtn ? submitBtn.innerHTML : '';
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span>⏳ Görseller yükleniyor ve güncelleniyor...</span>';
            }

            try {
                const formData = new FormData();
                formData.append('ItemID', itemId);
                formData.append('ProductName', productName.trim());
                formData.append('UnitPrice', price);
                formData.append('StockQuantity', stock);
                formData.append('ItemDescription', desc);

                // 1. Mevcut korunan görseller
                const existingKept = dashEditUploadedImages.filter(x => x.isExisting).map((img, i) => ({
                    imageID: img.imageID,
                    imageUrl: img.imageUrl,
                    publicId: img.publicId,
                    isMain: img.isMain,
                    displayOrder: i
                }));
                formData.append('ExistingImagesJson', JSON.stringify(existingKept));

                // 2. Yeni eklenen dosyalar
                const newItems = dashEditUploadedImages.filter(x => !x.isExisting);
                let mainIsNew = false;
                let mainNewIdx = 0;
                newItems.forEach((item, i) => {
                    if (item.file) {
                        formData.append('NewImageFiles', item.file);
                    }
                    if (item.isMain) {
                        mainIsNew = true;
                        mainNewIdx = i;
                    }
                });
                formData.append('MainImageIsNew', mainIsNew);
                formData.append('MainImageIndex', mainNewIdx);

                const response = await fetch('/Dashboard/UpdateProductListing', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                if (result.success) {
                    closeEditListingModal();
                    if (typeof showRealtimeToast === 'function') {
                        showRealtimeToast(result.message || "Ürün ve görselleri güncellendi!", "success");
                    }

                    // Tablodaki satırı anlık güncelle
                    const row = document.getElementById('listing-row-' + itemId);
                    if (row) {
                        const mainImg = result.mainImageUrl || (dashEditUploadedImages.find(x => x.isMain) || dashEditUploadedImages[0])?.imageUrl || '/images/default-product.svg';
                        const imgEl = row.querySelector('td:first-child img');
                        if (imgEl) imgEl.src = mainImg;

                        const nameEl = row.querySelector('.req-title-cell strong');
                        if (nameEl) nameEl.textContent = productName.trim();

                        const priceEl = row.querySelector('td:nth-child(4) strong');
                        if (priceEl) priceEl.textContent = (price.toLocaleString('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: 2 })) + ' ₺';

                        const stockEl = row.querySelector('td:nth-child(3) strong');
                        if (stockEl) {
                            stockEl.textContent = stock + ' Adet';
                            const isCrit = stock > 0 && stock <= 10;
                            const isOut = stock <= 0;
                            stockEl.className = isOut ? 'text-danger' : (isCrit ? 'text-warning' : '');
                            const badgeEl = row.querySelector('td:nth-child(3) .status-badge');
                            if (badgeEl) {
                                badgeEl.className = 'status-badge ' + (isOut ? 'badge-coral' : (isCrit ? 'badge-amber' : 'badge-emerald'));
                                badgeEl.innerHTML = '<span class="status-dot"></span>' + (isOut ? 'Tükendi' : (isCrit ? 'Kritik' : 'Stokta'));
                            }
                            row.setAttribute('data-status', isOut ? 'Tükendi' : (isCrit ? 'Kritik' : 'Stokta'));
                        }

                        const descEl = row.querySelector('td:nth-child(6) span');
                        if (descEl) {
                            descEl.textContent = desc.trim() || '-';
                            descEl.title = desc.trim();
                        }

                        row.classList.add('realtime-updated');
                        setTimeout(() => row.classList.remove('realtime-updated'), 2000);
                    }

                    // Mobil kartı da anlık güncelle
                    const mobileCard = document.getElementById('mobile-listing-card-' + itemId);
                    if (mobileCard) {
                        const mainImg = result.mainImageUrl || (dashEditUploadedImages.find(x => x.isMain) || dashEditUploadedImages[0])?.imageUrl || '/images/default-product.svg';
                        const imgEl = mobileCard.querySelector('img');
                        if (imgEl) imgEl.src = mainImg;

                        const nameEl = mobileCard.querySelector('h4');
                        if (nameEl) nameEl.textContent = productName.trim();

                        const priceEl = mobileCard.querySelector('strong.text-sm');
                        if (priceEl) priceEl.textContent = (price.toLocaleString('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: 2 })) + ' ₺';

                        const stockEl = mobileCard.querySelector('.text-xs.font-bold');
                        const isCrit = stock > 0 && stock <= 10;
                        const isOut = stock <= 0;
                        if (stockEl) {
                            stockEl.textContent = stock + ' Adet';
                            stockEl.className = 'text-xs font-bold ' + (isOut ? 'text-rose-600' : (isCrit ? 'text-amber-600' : 'text-slate-700'));
                        }

                        const statusBadge = mobileCard.querySelector('.status-badge');
                        if (statusBadge) {
                            statusBadge.className = 'status-badge ' + (isOut ? 'badge-coral' : (isCrit ? 'badge-amber' : 'badge-emerald')) + ' shrink-0 text-[11px] px-2 py-0.5 rounded-full font-bold';
                            statusBadge.innerHTML = '<span class="status-dot"></span>' + (isOut ? 'Tükendi' : (isCrit ? 'Kritik' : 'Stokta'));
                        }
                        mobileCard.setAttribute('data-status', isOut ? 'Tükendi' : (isCrit ? 'Kritik' : 'Stokta'));

                        mobileCard.classList.add('realtime-updated');
                        setTimeout(() => mobileCard.classList.remove('realtime-updated'), 2000);
                    }
                } else {
                    if (typeof showRealtimeToast === 'function') showRealtimeToast("Hata: " + (result.message || "Güncelleme başarısız."), "error");
                    else alert("Hata: " + (result.message || "Güncelleme başarısız."));
                }
            } catch (err) {
                console.error(err);
                if (typeof showRealtimeToast === 'function') showRealtimeToast("Bir hata oluştu: " + err.message, "error");
                else alert("Bir hata oluştu: " + err.message);
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = origHtml;
                }
            }

            return false;
        }

        async function deleteListing(id, name) {
            if (!confirm('"' + name + '" ürün ilanını silmek istediğinize emin misiniz?')) {
                return;
            }

            try {
                const response = await fetch('/Dashboard/DeleteProductListing?id=' + id, {
                    method: 'POST'
                });
                const result = await response.json();
                if (result.success) {
                    const row = document.getElementById('listing-row-' + id);
                    if (row) {
                        row.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                        row.style.opacity = '0';
                        row.style.transform = 'translateX(20px)';
                        setTimeout(function() {
                            row.remove();
                            window.ListingsManager.apply();
                        }, 300);
                    }

                    const mobileCard = document.getElementById('mobile-listing-card-' + id);
                    if (mobileCard) {
                        mobileCard.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                        mobileCard.style.opacity = '0';
                        mobileCard.style.transform = 'translateX(20px)';
                        setTimeout(function() {
                            mobileCard.remove();
                            window.ListingsManager.apply();
                        }, 300);
                    }

                    const kpiCount = document.getElementById('kpiTotalListings');
                    if (kpiCount) {
                        const curCount = parseInt(kpiCount.textContent.replace(/\D/g, '') || '0', 10);
                        if (curCount > 0) kpiCount.textContent = (curCount - 1).toString();
                    }

                    if (typeof showRealtimeToast === 'function') {
                        showRealtimeToast(result.message || 'Ürün ilanı silindi.', 'info');
                    }
                } else {
                    if (typeof showRealtimeToast === 'function') {
                        showRealtimeToast('Hata: ' + (result.message || 'İlan silinemedi.'), 'error');
                    } else {
                        alert("Hata: " + (result.message || "İlan silinemedi."));
                    }
                }
            } catch (err) {
                if (typeof showRealtimeToast === 'function') {
                    showRealtimeToast('Bağlantı hatası: ' + err.message, 'error');
                } else {
                    alert("Bağlantı hatası: " + err.message);
                }
            }
        }

        // =========================================================================
        // SÜRÜKLE-BIRAK (DRAG & DROP) OLAY YÖNETİCİSİ
        // =========================================================================
        function setupDashboardDropzones() {
            setupSingleDropzone('dashCreateDropzone', handleDashCreateImageFiles);
            setupSingleDropzone('dashEditDropzone', handleDashEditImageFiles);
        }

        function setupSingleDropzone(elementId, fileHandler) {
            const dropzone = document.getElementById(elementId);
            if (!dropzone || dropzone.dataset.dndInit === 'true') return;
            dropzone.dataset.dndInit = 'true';

            ['dragenter', 'dragover'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.add('is-dragover');
                }, false);
            });

            ['dragleave', 'dragend'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.remove('is-dragover');
                }, false);
            });

            dropzone.addEventListener('drop', (e) => {
                e.preventDefault();
                e.stopPropagation();
                dropzone.classList.remove('is-dragover');
                const dt = e.dataTransfer;
                if (dt && dt.files && dt.files.length > 0) {
                    fileHandler(dt.files);
                }
            }, false);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', setupDashboardDropzones);
        } else {
            setupDashboardDropzones();
        }
    </script>
}
