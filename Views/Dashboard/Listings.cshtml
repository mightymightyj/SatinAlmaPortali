@functions {
    public Microsoft.AspNetCore.Html.IHtmlContent RenderDashTree(satinalmaportali2.Controllers.HierarchicalCategoryItem node, int depth)
    {
        var sb = new System.Text.StringBuilder();
        var indent = depth * 16;
        var hasChildren = node.Children != null && node.Children.Any();
        var encodedName = System.Net.WebUtility.HtmlEncode(node.CategoryName ?? "");
        var safeJsName = (node.CategoryName ?? "").Replace("'", "\\'");
        
        sb.Append($"<div class=\"cat-tree-node level-{Math.Min(depth, 3)}\" style=\"margin-left: {indent}px; margin-bottom: 2px;\">");
        sb.Append($"<div class=\"cat-node-row {(depth == 0 ? "is-root" : "")}\" id=\"dashCatRow-{node.CategoryID}\" onclick=\"selectDashCategory({node.CategoryID}, '{safeJsName}')\" style=\"display: flex; align-items: center; padding: 6px 10px; border-radius: 6px; background: #ffffff; border: 1px solid #f1f5f9; cursor: pointer; transition: all 0.15s;\">");
        sb.Append("<div class=\"cat-node-left\" style=\"display: flex; align-items: center; gap: 8px;\">");
        sb.Append("<span class=\"cat-tree-bullet\" style=\"color: #94a3b8; font-size: 0.9rem;\">•</span>");
        sb.Append($"<span class=\"cat-node-title\" style=\"font-size: 0.84rem; font-weight: 600; color: #1e293b;\">{encodedName}</span>");
        sb.Append("</div>");
        sb.Append("</div>");

        if (hasChildren && node.Children != null)
        {
            foreach (var child in node.Children)
            {
                sb.Append(RenderDashTree(child, depth + 1).ToString());
            }
        }

        sb.Append("</div>");
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }
}

@section Scripts {
    <script>
        // =========================================================================
        // LISTINGS MANAGER (TEMİZ, GÜVENİLİR VE ANLIK FİLTRELEME YÖNETİCİSİ)
        // =========================================================================
        window.ListingsManager = {
            status: 'Tümü',
            category: 'Tümü',
            search: '',
            timer: null,

            setStatus: function(statusVal, btn) {
                this.status = statusVal || 'Tümü';
                const nav = document.getElementById('listingsStatusFilterNav');
                if (nav) {
                    nav.querySelectorAll('.year-pill').forEach(p => p.classList.remove('is-active'));
                    if (btn) {
                        btn.classList.add('is-active');
                    } else {
                        const target = nav.querySelector(`.year-pill[data-status="${this.status}"]`);
                        if (target) target.classList.add('is-active');
                    }
                }
                this.apply();
            },

            setCategory: function(catVal) {
                this.category = catVal || 'Tümü';
                this.apply();
            },

            onSearch: function(val) {
                clearTimeout(this.timer);
                this.timer = setTimeout(() => {
                    this.search = (val || '').trim().toLowerCase();
                    this.apply();
                }, 50);
            },

            reset: function() {
                this.status = 'Tümü';
                this.category = 'Tümü';
                this.search = '';

                const sInput = document.getElementById('listingsSearchInput');
                if (sInput) sInput.value = '';

                const cSelect = document.getElementById('listingsCategorySelect');
                if (cSelect) cSelect.value = 'Tümü';

                const nav = document.getElementById('listingsStatusFilterNav');
                if (nav) {
                    nav.querySelectorAll('.year-pill').forEach(p => p.classList.remove('is-active'));
                    const allBtn = nav.querySelector('.year-pill[data-status="Tümü"]');
                    if (allBtn) allBtn.classList.add('is-active');
                }

                this.apply();
            },

            apply: function() {
                const rows = document.querySelectorAll('#listingsTableBody tr[id^="listing-row-"]');
                let visibleCount = 0;

                const isAllDefault = (this.status === 'Tümü' || !this.status) &&
                                     (this.category === 'Tümü' || this.category === 'Tüm Kategoriler' || !this.category) &&
                                     !this.search;

                rows.forEach(row => {
                    if (isAllDefault) {
                        row.style.display = '';
                        visibleCount++;
                        return;
                    }

                    const rowStatus = (row.getAttribute('data-status') || '').trim().toLowerCase();
                    const rowCategory = (row.getAttribute('data-category') || '').trim().toLowerCase();

                    // 1. Status Filter
                    let matchStatus = false;
                    if (this.status === 'Tümü' || !this.status) {
                        matchStatus = true;
                    } else if (this.status.toLowerCase() === 'stokta') {
                        matchStatus = (rowStatus === 'stokta');
                    } else if (this.status.toLowerCase() === 'kritik') {
                        matchStatus = (rowStatus === 'kritik' || rowStatus === 'tükendi');
                    } else {
                        matchStatus = (rowStatus === this.status.toLowerCase());
                    }

                    // 2. Category Filter
                    let matchCategory = false;
                    if (this.category === 'Tümü' || this.category === 'Tüm Kategoriler' || !this.category) {
                        matchCategory = true;
                    } else {
                        matchCategory = (rowCategory === this.category.toLowerCase());
                    }

                    // 3. Search Filter
                    let matchSearch = true;
                    if (this.search) {
                        const rowText = (row.innerText || row.textContent || '').toLowerCase();
                        matchSearch = rowText.includes(this.search);
                    }

                    if (matchStatus && matchCategory && matchSearch) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                const headTitle = document.getElementById('listingsHeaderTitle');
                if (headTitle) {
                    headTitle.textContent = `Kayıtlı Ürün İlanları & Vitrin Listesi (${visibleCount})`;
                }

                const clearBtn = document.getElementById('listingsClearBtn');
                if (clearBtn) {
                    clearBtn.style.display = isAllDefault ? 'none' : 'inline-flex';
                }

                let emptyFilterRow = document.getElementById('listingsEmptyFilterRow');
                if (rows.length > 0 && visibleCount === 0) {
                    if (!emptyFilterRow) {
                        emptyFilterRow = document.createElement('tr');
                        emptyFilterRow.id = 'listingsEmptyFilterRow';
                        emptyFilterRow.innerHTML = '<td colspan="7" style="text-align: center; padding: 40px 16px; color: var(--muted);"><strong style="color: var(--text);">Arama veya filtre kriterinize uygun ürün ilanı bulunamadı.</strong><div style="font-size: 0.8rem; margin-top: 4px;">Farklı bir kategori veya arama kelimesi seçebilir, filtreleri temizleyebilirsiniz.</div></td>';
                        const tbody = document.getElementById('listingsTableBody');
                        if (tbody) tbody.appendChild(emptyFilterRow);
                    }
                    emptyFilterRow.style.display = '';
                } else if (emptyFilterRow) {
                    emptyFilterRow.style.display = 'none';
                }
            }
        };

        // =========================================================================
        // GÖRSEL YÖNETİMİ & MODAL FONKSİYONLARI (CLOUDINARY ENTEGRASYONU)
        // =========================================================================
        const memMaxImages = @(Model.MaxImagesPerProduct < int.MaxValue ? Model.MaxImagesPerProduct : 100);
        const memTierName = '@(Model.MembershipTypeName)';
        let dashCreateUploadedImages = [];
        let dashEditUploadedImages = [];

        // Yeni İlan Modalı Görsel Seçimi (Yerel önizleme; Cloudinary'ye ilan kaydedildiğinde yüklenir)
        function handleDashCreateImageFiles(files) {
            if (!files || files.length === 0) return;
            const validExts = ['image/jpeg', 'image/png', 'image/webp', 'image/gif', 'image/jpg'];
            const validFileExts = ['.jpg', '.jpeg', '.png', '.webp', '.gif'];

            if (dashCreateUploadedImages.length >= memMaxImages) {
                if (typeof showRealtimeToast === 'function') showRealtimeToast(`${memTierName} planınızda bir ürün için en fazla ${memMaxImages} görsel ekleyebilirsiniz.`, "warning");
                return;
            }

            let addedCount = 0;
            for (let i = 0; i < files.length; i++) {
                if (dashCreateUploadedImages.length >= memMaxImages) {
                    if (typeof showRealtimeToast === 'function') showRealtimeToast(`En fazla ${memMaxImages} görsel sınırına ulaşıldı. Kalan dosyalar eklenmedi.`, "warning");
                    break;
                }

                const file = files[i];
                if (file.size > 10 * 1024 * 1024) {
                    if (typeof showRealtimeToast === 'function') showRealtimeToast(`"${file.name}" 10MB sınırını aşıyor.`, 'error');
                    continue;
                }
                const ext = file.name ? file.name.substring(file.name.lastIndexOf('.')).toLowerCase() : '';
                if ((file.type && !validExts.includes(file.type.toLowerCase())) && !validFileExts.includes(ext)) {
                    if (typeof showRealtimeToast === 'function') showRealtimeToast(`"${file.name}" geçerli bir görsel formatı değil (JPG, PNG, WEBP, GIF desteklenir).`, 'error');
                    continue;
                }

                dashCreateUploadedImages.push({
                    file: file,
                    previewUrl: URL.createObjectURL(file),
                    isMain: dashCreateUploadedImages.length === 0,
                    displayOrder: dashCreateUploadedImages.length
                });
                addedCount++;
            }

            renderDashCreateImages();
            const fileInput = document.getElementById('dashCreateImageInput');
            if (fileInput) fileInput.value = '';

            if (addedCount > 0 && typeof showRealtimeToast === 'function') {
                showRealtimeToast(`${addedCount} yeni görsel eklendi. İlanı yayına aldığınızda yüklenecektir.`, 'info');
            }
        }

        function renderDashCreateImages() {
            const grid = document.getElementById('dashCreateThumbsGrid');
            const countEl = document.getElementById('dashCreateImagesCount');
            if (countEl) countEl.textContent = dashCreateUploadedImages.length;
            if (!grid) return;

            if (dashCreateUploadedImages.length === 0) {
                grid.style.display = 'none';
                grid.innerHTML = '';
                return;
            }

            grid.style.display = 'flex';
            let cardsHtml = dashCreateUploadedImages.map((img, idx) => `
                <div class="b2b-img-thumb-card ${img.isMain ? 'is-main' : ''}" data-index="${idx}" style="width: 76px !important; height: 76px !important; min-width: 76px !important; max-width: 76px !important; min-height: 76px !important; max-height: 76px !important; position: relative !important; border-radius: 8px !important; overflow: hidden !important; flex-shrink: 0 !important; background: #f1f5f9; border: 2px solid ${img.isMain ? '#10b981' : '#cbd5e1'} !important; box-shadow: ${img.isMain ? '0 0 0 2px rgba(16,185,129,0.35)' : '0 1px 2px rgba(0,0,0,0.05)'}; box-sizing: border-box !important;">
                    <img src="${img.previewUrl || img.imageUrl}" alt="Ürün Resmi ${idx+1}" style="width: 100% !important; height: 100% !important; max-width: 100% !important; max-height: 100% !important; min-width: 100% !important; min-height: 100% !important; object-fit: cover !important; display: block !important; border-radius: 6px;" onerror="this.src='/images/default-product.svg'" />
                    ${img.isMain ? '<span class="b2b-thumb-badge-main" style="position: absolute; top: 2px; left: 2px; background: #059669; color: #fff; font-size: 0.55rem; font-weight: 800; padding: 1px 4px; border-radius: 3px; z-index: 3; line-height: 1.1; pointer-events: none;">★ Ana</span>' : ''}
                    <button type="button" class="btn-remove-img" onclick="removeDashCreateImage(${idx})" title="Bu görseli kaldır" style="position: absolute; top: 2px; right: 2px; width: 18px; height: 18px; border-radius: 50%; background: rgba(239,68,68,0.95); color: #fff; border: 1.5px solid #fff; font-size: 0.65rem; font-weight: 900; display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 5; padding: 0; line-height: 1;">✕</button>
                    ${img.isMain ? 
                        '<div class="btn-make-main active" title="Vitrin ve kartlarda ilk gösterilen ana görseldir" style="position: absolute; bottom: 0; left: 0; right: 0; background: #059669; color: #fff; font-size: 0.55rem; font-weight: 700; padding: 2px 1px; text-align: center; z-index: 4; cursor: default; line-height: 1.1;">★ Ana Görsel</div>' : 
                        `<button type="button" class="btn-make-main" onclick="setDashCreateMainImage(${idx})" title="Ana görsel olarak belirle" style="position: absolute; bottom: 0; left: 0; right: 0; background: rgba(15,23,42,0.85); color: #fff; border: none; font-size: 0.55rem; font-weight: 700; padding: 2px 1px; text-align: center; z-index: 4; cursor: pointer; line-height: 1.1;">Ana Yap</button>`
                    }
                </div>
            `).join('');

            if (dashCreateUploadedImages.length < 10) {
                cardsHtml += `
                    <div class="b2b-thumb-add-btn" onclick="document.getElementById('dashCreateImageInput').click()" title="Yeni görsel ekle" style="width: 76px !important; height: 76px !important; min-width: 76px !important; max-width: 76px !important; min-height: 76px !important; max-height: 76px !important; border-radius: 8px; border: 2px dashed #cbd5e1; background: #f8fafc; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; color: #64748b; font-size: 0.65rem; font-weight: 700; gap: 1px; flex-shrink: 0; box-sizing: border-box !important;">
                        <span style="font-size: 1.2rem; line-height: 1;">+</span>
                        <span>Ekle</span>
                    </div>
                `;
            }

            grid.innerHTML = cardsHtml;
