@functions {
    public Microsoft.AspNetCore.Html.IHtmlContent RenderDashTree(satinalmaportali2.Controllers.HierarchicalCategoryItem node, int depth)
    {
        var sb = new System.Text.StringBuilder();
        var hasChildren = node.Children != null && node.Children.Any();
        var encodedName = System.Net.WebUtility.HtmlEncode(node.CategoryName ?? "");
        var safeJsName = (node.CategoryName ?? "").Replace("'", "\\'");
        var childCount = node.Children?.Count ?? 0;

        if (depth == 0)
        {
            // KÖK (ANA) KATEGORİ: Katlanabilir Akordeon Konteyner
            sb.Append($"<div class=\"cat-root-container mb-1\" id=\"dashCatRootContainer-{node.CategoryID}\">");
            sb.Append($"<div class=\"cat-node-row cat-root-row flex items-center justify-between p-2 rounded-lg bg-white border border-slate-200/90 hover:border-blue-300 hover:bg-blue-50/20 transition cursor-pointer\" id=\"dashCatRow-{node.CategoryID}\">");
            
            if (hasChildren)
            {
                // Sol: Açma/Kapama Oku + Başlık + Alt Adet
                sb.Append($"<div class=\"flex items-center gap-2 flex-1 min-w-0 pr-2\" onclick=\"toggleDashCategoryGroup({node.CategoryID}, event)\">");
                sb.Append($"<span class=\"cat-expand-arrow w-4 h-4 rounded flex items-center justify-center bg-slate-100 text-slate-600 text-[10px] font-bold shrink-0 transition-transform\" id=\"dashCatArrow-{node.CategoryID}\">▸</span>");
                sb.Append($"<span class=\"cat-node-title text-xs font-bold text-slate-800 truncate\">{encodedName}</span>");
                sb.Append($"<span class=\"text-[10px] text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded-full shrink-0\">{childCount}</span>");
                sb.Append("</div>");
                
                // Sağ: Doğrudan Bu Ana Kategoriyi Seç
                sb.Append($"<button type=\"button\" class=\"btn-select-cat shrink-0 text-[11px] font-bold text-blue-600 hover:text-white hover:bg-blue-600 border border-blue-200 px-2 py-0.5 rounded-md transition cursor-pointer\" onclick=\"selectDashCategory({node.CategoryID}, '{safeJsName}')\" title=\"Bu kategoriyi seç\">Seç</button>");
            }
            else
            {
                sb.Append($"<div class=\"flex items-center justify-between w-full\" onclick=\"selectDashCategory({node.CategoryID}, '{safeJsName}')\">");
                sb.Append($"<span class=\"cat-node-title text-xs font-bold text-slate-800 truncate\">📁 {encodedName}</span>");
                sb.Append($"<button type=\"button\" class=\"btn-select-cat shrink-0 text-[11px] font-bold text-blue-600 hover:text-white hover:bg-blue-600 border border-blue-200 px-2 py-0.5 rounded-md transition cursor-pointer\">Seç</button>");
                sb.Append("</div>");
            }
            
            sb.Append("</div>");

            // Alt Kategoriler Kutusu (Varsayılan Olarak KAPALI - hidden)
            if (hasChildren && node.Children != null)
            {
                sb.Append($"<div class=\"cat-children-box hidden pl-2.5 border-l-2 border-blue-100 ml-2.5 my-1 space-y-1\" id=\"dashCatChildren-{node.CategoryID}\">");
                foreach (var child in node.Children)
                {
                    sb.Append(RenderDashTree(child, depth + 1).ToString());
                }
                sb.Append("</div>");
            }

            sb.Append("</div>");
        }
        else
        {
            // ALT KATEGORİ (Seviye 1, 2, ...)
            var indent = Math.Max(0, (depth - 1) * 8);
            sb.Append($"<div class=\"cat-node-row flex items-center justify-between p-1.5 px-2 rounded-md bg-white border border-slate-100 hover:border-blue-200 hover:bg-blue-50/20 transition cursor-pointer\" id=\"dashCatRow-{node.CategoryID}\" onclick=\"selectDashCategory({node.CategoryID}, '{safeJsName}')\" style=\"margin-left: {indent}px;\">");
            sb.Append("<div class=\"flex items-center gap-1.5 min-w-0 pr-2\">");
            sb.Append("<span class=\"text-slate-300 text-[10px]\">•</span>");
            sb.Append($"<span class=\"cat-node-title text-[11.5px] font-medium text-slate-700 truncate\">{encodedName}</span>");
            sb.Append("</div>");
            sb.Append($"<span class=\"text-[10px] font-semibold text-blue-600 shrink-0\">Seç →</span>");
            sb.Append("</div>");

            if (hasChildren && node.Children != null)
            {
                sb.Append("<div class=\"space-y-1 my-0.5\">");
                foreach (var child in node.Children)
                {
                    sb.Append(RenderDashTree(child, depth + 1).ToString());
                }
                sb.Append("</div>");
            }
        }

        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }
}

@section Scripts {
    <script>
        // =========================================================================
        // LISTINGS MANAGER (TEMİZ, GÜVENİLİR VE ANLIK FİLTRELEME YÖNETİCİSİ)
        // =========================================================================
        window.ListingsManager = {
            status: 'Tümü',
            category: 'Tümü',
            search: '',
            timer: null,

            setStatus: function(statusVal, btn) {
                this.status = statusVal || 'Tümü';
                const nav = document.getElementById('listingsStatusFilterNav');
                if (nav) {
                    nav.querySelectorAll('.year-pill').forEach(p => p.classList.remove('is-active'));
                    if (btn) {
                        btn.classList.add('is-active');
                    } else {
                        const target = nav.querySelector(`.year-pill[data-status="${this.status}"]`);
                        if (target) target.classList.add('is-active');
                    }
                }
                this.apply();
            },

            setCategory: function(catVal) {
                this.category = catVal || 'Tümü';
                this.apply();
            },

            onSearch: function(val) {
                clearTimeout(this.timer);
                this.timer = setTimeout(() => {
                    this.search = (val || '').trim().toLowerCase();
                    this.apply();
                }, 50);
            },

            reset: function() {
                this.status = 'Tümü';
                this.category = 'Tümü';
                this.search = '';

                const sInput = document.getElementById('listingsSearchInput');
                if (sInput) sInput.value = '';

                const cSelect = document.getElementById('listingsCategorySelect');
                if (cSelect) cSelect.value = 'Tümü';

                const nav = document.getElementById('listingsStatusFilterNav');
                if (nav) {
                    nav.querySelectorAll('.year-pill').forEach(p => p.classList.remove('is-active'));
                    const allBtn = nav.querySelector('.year-pill[data-status="Tümü"]');
                    if (allBtn) allBtn.classList.add('is-active');
                }

                this.apply();
            },

            apply: function() {
                const rows = document.querySelectorAll('#listingsTableBody tr[id^="listing-row-"]');
                let visibleCount = 0;

                const isAllDefault = (this.status === 'Tümü' || !this.status) &&
                                     (this.category === 'Tümü' || this.category === 'Tüm Kategoriler' || !this.category) &&
                                     !this.search;

                const cards = document.querySelectorAll('#listingsMobileList .listing-mobile-card');

                rows.forEach(row => {
                    if (isAllDefault) {
                        row.style.display = '';
                        visibleCount++;
                        return;
                    }

                    const rowStatus = (row.getAttribute('data-status') || '').trim().toLowerCase();
                    const rowCategory = (row.getAttribute('data-category') || '').trim().toLowerCase();

                    // 1. Status Filter
                    let matchStatus = false;
                    if (this.status === 'Tümü' || !this.status) {
                        matchStatus = true;
                    } else if (this.status.toLowerCase() === 'stokta') {
                        matchStatus = (rowStatus === 'stokta');
                    } else if (this.status.toLowerCase() === 'kritik') {
                        matchStatus = (rowStatus === 'kritik' || rowStatus === 'tükendi');
                    } else {
                        matchStatus = (rowStatus === this.status.toLowerCase());
                    }

                    // 2. Category Filter
                    let matchCategory = false;
                    if (this.category === 'Tümü' || this.category === 'Tüm Kategoriler' || !this.category) {
                        matchCategory = true;
                    } else {
                        matchCategory = (rowCategory === this.category.toLowerCase());
                    }

                    // 3. Search Filter
                    let matchSearch = true;
                    if (this.search) {
                        const rowText = (row.innerText || row.textContent || '').toLowerCase();
                        matchSearch = rowText.includes(this.search);
                    }

                    if (matchStatus && matchCategory && matchSearch) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                // Mobil Kartları Senkronize Filtrele
                cards.forEach(card => {
                    if (isAllDefault) {
                        card.style.display = '';
                        return;
                    }

                    const cardStatus = (card.getAttribute('data-status') || '').trim().toLowerCase();
                    const cardCategory = (card.getAttribute('data-category') || '').trim().toLowerCase();

                    let matchStatus = false;
                    if (this.status === 'Tümü' || !this.status) {
                        matchStatus = true;
                    } else if (this.status.toLowerCase() === 'stokta') {
                        matchStatus = (cardStatus === 'stokta');
                    } else if (this.status.toLowerCase() === 'kritik') {
                        matchStatus = (cardStatus === 'kritik' || cardStatus === 'tükendi');
                    } else {
                        matchStatus = (cardStatus === this.status.toLowerCase());
                    }

                    let matchCategory = false;
                    if (this.category === 'Tümü' || this.category === 'Tüm Kategoriler' || !this.category) {
                        matchCategory = true;
                    } else {
                        matchCategory = (cardCategory === this.category.toLowerCase());
                    }

                    let matchSearch = true;
                    if (this.search) {
                        const cardText = (card.innerText || card.textContent || '').toLowerCase();
                        matchSearch = cardText.includes(this.search);
                    }

                    if (matchStatus && matchCategory && matchSearch) {
                        card.style.display = '';
                    } else {
                        card.style.display = 'none';
                    }
                });

                const mobileEmptyState = document.getElementById('listingsMobileEmptyState');
                if (mobileEmptyState) {
                    if (cards.length > 0 && visibleCount === 0) {
                        mobileEmptyState.style.display = 'block';
                    } else {
                        mobileEmptyState.style.display = 'none';
                    }
                }

                const headTitle = document.getElementById('listingsHeaderTitle');
                if (headTitle) {
                    headTitle.textContent = `Kayıtlı Ürün İlanları & Vitrin Listesi (${visibleCount})`;
                }

                const clearBtn = document.getElementById('listingsClearBtn');
                if (clearBtn) {
                    clearBtn.style.display = isAllDefault ? 'none' : 'inline-flex';
                }

                let emptyFilterRow = document.getElementById('listingsEmptyFilterRow');
                if (rows.length > 0 && visibleCount === 0) {
                    if (!emptyFilterRow) {
                        emptyFilterRow = document.createElement('tr');
                        emptyFilterRow.id = 'listingsEmptyFilterRow';
                        emptyFilterRow.innerHTML = '<td colspan="7" style="text-align: center; padding: 40px 16px; color: var(--muted);"><strong style="color: var(--text);">Arama veya filtre kriterinize uygun ürün ilanı bulunamadı.</strong><div style="font-size: 0.8rem; margin-top: 4px;">Farklı bir kategori veya arama kelimesi seçebilir, filtreleri temizleyebilirsiniz.</div></td>';
                        const tbody = document.getElementById('listingsTableBody');
                        if (tbody) tbody.appendChild(emptyFilterRow);
                    }
                    emptyFilterRow.style.display = '';
                } else if (emptyFilterRow) {
                    emptyFilterRow.style.display = 'none';
                }
            }
        };

        // =========================================================================
        // GÖRSEL YÖNETİMİ & MODAL FONKSİYONLARI (CLOUDINARY ENTEGRASYONU)
        // =========================================================================
        const memMaxImages = @(Model.MaxImagesPerProduct < int.MaxValue ? Model.MaxImagesPerProduct : 100);
        const memTierName = '@(Model.MembershipTypeName)';
        let dashCreateUploadedImages = [];
        let dashEditUploadedImages = [];

        // Yeni İlan Modalı Görsel Seçimi (Yerel önizleme; Cloudinary'ye ilan kaydedildiğinde yüklenir)
        function handleDashCreateImageFiles(files) {
            if (!files || files.length === 0) return;
            const validExts = ['image/jpeg', 'image/png', 'image/webp', 'image/gif', 'image/jpg'];
            const validFileExts = ['.jpg', '.jpeg', '.png', '.webp', '.gif'];

            if (dashCreateUploadedImages.length >= memMaxImages) {
                if (typeof showRealtimeToast === 'function') showRealtimeToast(`${memTierName} planınızda bir ürün için en fazla ${memMaxImages} görsel ekleyebilirsiniz.`, "warning");
                return;
            }

            let addedCount = 0;
            for (let i = 0; i < files.length; i++) {
                if (dashCreateUploadedImages.length >= memMaxImages) {
                    if (typeof showRealtimeToast === 'function') showRealtimeToast(`En fazla ${memMaxImages} görsel sınırına ulaşıldı. Kalan dosyalar eklenmedi.`, "warning");
                    break;
                }

                const file = files[i];
                if (file.size > 10 * 1024 * 1024) {
                    if (typeof showRealtimeToast === 'function') showRealtimeToast(`"${file.name}" 10MB sınırını aşıyor.`, 'error');
                    continue;
                }
                const ext = file.name ? file.name.substring(file.name.lastIndexOf('.')).toLowerCase() : '';
                if ((file.type && !validExts.includes(file.type.toLowerCase())) && !validFileExts.includes(ext)) {
                    if (typeof showRealtimeToast === 'function') showRealtimeToast(`"${file.name}" geçerli bir görsel formatı değil (JPG, PNG, WEBP, GIF desteklenir).`, 'error');
                    continue;
                }

                dashCreateUploadedImages.push({
                    file: file,
                    previewUrl: URL.createObjectURL(file),
                    isMain: dashCreateUploadedImages.length === 0,
                    displayOrder: dashCreateUploadedImages.length
                });
                addedCount++;
            }

            renderDashCreateImages();
            const fileInput = document.getElementById('dashCreateImageInput');
            if (fileInput) fileInput.value = '';

            if (addedCount > 0 && typeof showRealtimeToast === 'function') {
                showRealtimeToast(`${addedCount} yeni görsel eklendi. İlanı yayına aldığınızda yüklenecektir.`, 'info');
            }
        }

        function renderDashCreateImages() {
            const grid = document.getElementById('dashCreateThumbsGrid');
            const countEl = document.getElementById('dashCreateImagesCount');
            if (countEl) countEl.textContent = dashCreateUploadedImages.length;
            if (!grid) return;

            if (dashCreateUploadedImages.length === 0) {
                grid.style.display = 'none';
                grid.innerHTML = '';
                return;
            }

            grid.style.display = 'flex';
            let cardsHtml = dashCreateUploadedImages.map((img, idx) => `
                <div class="b2b-img-thumb-card ${img.isMain ? 'is-main' : ''}" data-index="${idx}" style="width: 76px !important; height: 76px !important; min-width: 76px !important; max-width: 76px !important; min-height: 76px !important; max-height: 76px !important; position: relative !important; border-radius: 8px !important; overflow: hidden !important; flex-shrink: 0 !important; background: #f1f5f9; border: 2px solid ${img.isMain ? '#10b981' : '#cbd5e1'} !important; box-shadow: ${img.isMain ? '0 0 0 2px rgba(16,185,129,0.35)' : '0 1px 2px rgba(0,0,0,0.05)'}; box-sizing: border-box !important;">
                    <img src="${img.previewUrl || img.imageUrl}" alt="Ürün Resmi ${idx+1}" style="width: 100% !important; height: 100% !important; max-width: 100% !important; max-height: 100% !important; min-width: 100% !important; min-height: 100% !important; object-fit: cover !important; display: block !important; border-radius: 6px;" onerror="this.src='/images/default-product.svg'" />
                    ${img.isMain ? '<span class="b2b-thumb-badge-main" style="position: absolute; top: 2px; left: 2px; background: #059669; color: #fff; font-size: 0.55rem; font-weight: 800; padding: 1px 4px; border-radius: 3px; z-index: 3; line-height: 1.1; pointer-events: none;">★ Ana</span>' : ''}
                    <button type="button" class="btn-remove-img" onclick="removeDashCreateImage(${idx})" title="Bu görseli kaldır" style="position: absolute; top: 2px; right: 2px; width: 18px; height: 18px; border-radius: 50%; background: rgba(239,68,68,0.95); color: #fff; border: 1.5px solid #fff; font-size: 0.65rem; font-weight: 900; display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 5; padding: 0; line-height: 1;">✕</button>
                    ${img.isMain ? 
                        '<div class="btn-make-main active" title="Vitrin ve kartlarda ilk gösterilen ana görseldir" style="position: absolute; bottom: 0; left: 0; right: 0; background: #059669; color: #fff; font-size: 0.55rem; font-weight: 700; padding: 2px 1px; text-align: center; z-index: 4; cursor: default; line-height: 1.1;">★ Ana Görsel</div>' : 
                        `<button type="button" class="btn-make-main" onclick="setDashCreateMainImage(${idx})" title="Ana görsel olarak belirle" style="position: absolute; bottom: 0; left: 0; right: 0; background: rgba(15,23,42,0.85); color: #fff; border: none; font-size: 0.55rem; font-weight: 700; padding: 2px 1px; text-align: center; z-index: 4; cursor: pointer; line-height: 1.1;">Ana Yap</button>`
                    }
                </div>
            `).join('');

            if (dashCreateUploadedImages.length < 10) {
                cardsHtml += `
                    <div class="b2b-thumb-add-btn" onclick="document.getElementById('dashCreateImageInput').click()" title="Yeni görsel ekle" style="width: 76px !important; height: 76px !important; min-width: 76px !important; max-width: 76px !important; min-height: 76px !important; max-height: 76px !important; border-radius: 8px; border: 2px dashed #cbd5e1; background: #f8fafc; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; color: #64748b; font-size: 0.65rem; font-weight: 700; gap: 1px; flex-shrink: 0; box-sizing: border-box !important;">
                        <span style="font-size: 1.2rem; line-height: 1;">+</span>
                        <span>Ekle</span>
                    </div>
                `;
            }

            grid.innerHTML = cardsHtml;
        }

        function setDashCreateMainImage(idx) {
            if (idx < 0 || idx >= dashCreateUploadedImages.length) return;
            dashCreateUploadedImages.forEach((img, i) => {
                img.isMain = (i === idx);
            });
            renderDashCreateImages();
            if (typeof showRealtimeToast === 'function') {
                showRealtimeToast("Ana görsel güncellendi.", "info");
            }
        }

        function removeDashCreateImage(idx) {
            if (idx < 0 || idx >= dashCreateUploadedImages.length) return;
            const removed = dashCreateUploadedImages.splice(idx, 1)[0];
            if (removed && removed.previewUrl && removed.previewUrl.startsWith('blob:')) {
                try { URL.revokeObjectURL(removed.previewUrl); } catch(e) {}
            }
            if (removed && removed.isMain && dashCreateUploadedImages.length > 0) {
                dashCreateUploadedImages[0].isMain = true;
            }
            renderDashCreateImages();
            if (typeof showRealtimeToast === 'function') {
                showRealtimeToast("Görsel kaldırıldı.", "info");
            }
        }

        // =========================================================================
        // ÜRÜN DETAY MODALI (MOBİL DETAY GÖRÜNTÜLEME & HIZLI AKSİYONLAR)
        // =========================================================================
        let currentDetailListingId = null;

        function openListingDetailModal(itemId) {
            if (!itemId) return;
            currentDetailListingId = itemId;

            const modal = document.getElementById('listingDetailModal');
            const loading = document.getElementById('listingDetailModalLoading');
            const content = document.getElementById('listingDetailModalContent');
            if (!modal) return;

            document.getElementById('dashboardBottomBar')?.classList.add('hidden');
            modal.style.display = 'flex';
            if (loading) loading.style.display = 'block';
            if (content) content.classList.add('hidden');

            // 1. Önce DOM'daki kart veya tablodan anında ön bilgileri doldur (gecikmesiz his)
            populateListingDetailFromDom(itemId);

            // 2. Sunucudan tam ve güncel verileri çek (Çoklu Cloudinary görselleri, detaylar vb.)
            fetch('/Dashboard/GetProductDetails?id=' + itemId)
                .then(res => {
                    if (!res.ok) throw new Error('Ürün verisi yüklenemedi');
                    return res.json();
                })
                .then(data => {
                    if (data && data.success && data.product) {
                        populateListingDetailModal(data.product);
                    }
                })
                .catch(err => {
                    console.warn('Detay modalı sunucu verisi uyarısı:', err);
                })
                .finally(() => {
                    if (loading) loading.style.display = 'none';
                    if (content) content.classList.remove('hidden');
                });
        }

        function closeListingDetailModal() {
            const modal = document.getElementById('listingDetailModal');
            if (modal) modal.style.display = 'none';
            currentDetailListingId = null;
            document.getElementById('dashboardBottomBar')?.classList.remove('hidden');
        }

        function populateListingDetailFromDom(itemId) {
            const card = document.getElementById('mobile-listing-card-' + itemId);
            const row = document.getElementById('listing-row-' + itemId);

            let name = '', sku = '', brand = '', category = '', price = 0, stock = 0, status = 'Stokta', desc = '-', imgUrl = '';

            if (card) {
                sku = card.querySelector('.font-mono')?.textContent?.trim() || '';
                brand = card.querySelector('.truncate')?.textContent?.trim() || '';
                status = (card.getAttribute('data-status') || '').trim();
                category = (card.getAttribute('data-category') || '').trim();
                name = card.querySelector('h4')?.textContent?.trim() || '';
                imgUrl = card.querySelector('img')?.getAttribute('src') || '';
                const priceText = card.querySelector('strong.text-sm')?.textContent || '';
                price = parseFloat(priceText.replace(/[^\d.,]/g, '').replace(/\./g, '').replace(',', '.')) || 0;
                const stockText = card.querySelector('.text-xs.font-bold')?.textContent || '';
                stock = parseInt(stockText.replace(/\D/g, ''), 10) || 0;
            } else if (row) {
                name = row.querySelector('.req-title-cell strong')?.textContent?.trim() || '';
                sku = row.querySelector('.req-code')?.textContent?.trim() || '';
                brand = row.querySelector('.req-title-cell small:last-child')?.textContent?.trim() || '';
                category = (row.getAttribute('data-category') || '').trim();
                status = (row.getAttribute('data-status') || '').trim();
                imgUrl = row.querySelector('img')?.getAttribute('src') || '';
                desc = row.querySelector('td:nth-child(6) span')?.textContent?.trim() || '-';
                const stockText = row.querySelector('td:nth-child(3) strong')?.textContent || '';
                stock = parseInt(stockText.replace(/\D/g, ''), 10) || 0;
                const priceText = row.querySelector('td:nth-child(4) strong')?.textContent || '';
                price = parseFloat(priceText.replace(/[^\d.,]/g, '').replace(/\./g, '').replace(',', '.')) || 0;
            }

            populateListingDetailModal({
                itemId: itemId,
                itemName: name,
                sku: sku,
                brand: brand,
                categoryName: category,
                status: status,
                unitPrice: price,
                stock: stock,
                itemDescription: desc,
                mainImageUrl: imgUrl,
                images: imgUrl ? [{ imageUrl: imgUrl, isMain: true }] : []
            });
        }

        function populateListingDetailModal(p) {
            const itemId = p.itemId || currentDetailListingId;
            const name = p.productName || p.itemName || 'Ürün';
            const sku = p.sku || '-';
            const brand = p.brand || '';
            const category = p.categoryName || '-';
            const unitPrice = Number(p.unitPrice ?? p.price ?? 0);
            const stock = Number(p.stockQuantity ?? p.stock ?? 0);
            const desc = (p.itemDescription || p.description || '').trim();

            const isOut = stock <= 0;
            const isCrit = stock > 0 && stock <= 10;
            const statusText = p.status || (isOut ? 'Tükendi' : (isCrit ? 'Kritik' : 'Stokta'));
            const statusBadgeCls = isOut ? 'badge-coral' : (isCrit ? 'badge-amber' : 'badge-emerald');

            // Başlık ve Rozetler
            const headTitle = document.getElementById('listingDetailHeaderTitle');
            if (headTitle) headTitle.textContent = name;

            const catBadge = document.getElementById('listingDetailCatBadge');
            if (catBadge) catBadge.textContent = '📁 ' + category;

            const titleEl = document.getElementById('listingDetailTitle');
            if (titleEl) titleEl.textContent = name;

            const skuEl = document.getElementById('listingDetailSku');
            if (skuEl) skuEl.textContent = sku;

            const brandEl = document.getElementById('listingDetailBrand');
            if (brandEl) {
                if (brand) {
                    brandEl.textContent = '🏷️ ' + brand;
                    brandEl.style.display = 'inline-block';
                } else {
                    brandEl.style.display = 'none';
                }
            }

            const statusEl = document.getElementById('listingDetailStatusBadge');
            if (statusEl) {
                statusEl.className = 'status-badge ' + statusBadgeCls + ' text-[11px] font-bold px-2 py-0.5 rounded-full';
                statusEl.innerHTML = '<span class="status-dot"></span> ' + statusText;
            }

            // Finans ve Stok
            const priceEl = document.getElementById('listingDetailUnitPrice');
            if (priceEl) {
                priceEl.textContent = (typeof formatCurrency === 'function' ? formatCurrency(unitPrice) : (unitPrice.toLocaleString('tr-TR') + ' ₺'));
            }

            const kdvPrice = unitPrice * 1.20;
            const kdvEl = document.getElementById('listingDetailPriceWithKdv');
            if (kdvEl) {
                kdvEl.textContent = '+ %20 KDV: ' + (typeof formatCurrency === 'function' ? formatCurrency(kdvPrice) : (kdvPrice.toLocaleString('tr-TR') + ' ₺'));
            }

            const stockEl = document.getElementById('listingDetailStock');
            if (stockEl) {
                stockEl.textContent = stock.toLocaleString('tr-TR') + ' Adet';
                stockEl.className = 'text-base font-black ' + (isOut ? 'text-rose-600' : (isCrit ? 'text-amber-600' : 'text-blue-700')) + ' mt-0.5';
            }

            const stockStateEl = document.getElementById('listingDetailStockState');
            if (stockStateEl) {
                stockStateEl.textContent = isOut ? '⚠️ Stok Tükendi (Satışa Kapalı)' : (isCrit ? '⚠️ Kritik Stok Seviyesi' : '✅ Hızlı Sevkiyata Uygun');
                stockStateEl.className = 'text-[11px] font-medium block mt-0.5 ' + (isOut ? 'text-rose-600' : (isCrit ? 'text-amber-600' : 'text-blue-600'));
            }

            const totalValue = unitPrice * stock;
            const totalValEl = document.getElementById('listingDetailTotalValue');
            if (totalValEl) {
                totalValEl.textContent = typeof formatCurrency === 'function' ? formatCurrency(totalValue) : (totalValue.toLocaleString('tr-TR') + ' ₺');
            }

            // Açıklama / Şartname
            const descEl = document.getElementById('listingDetailDesc');
            if (descEl) {
                descEl.textContent = desc || 'Bu ürün için özel bir teslimat veya şartname notu girilmemiştir.';
            }

            // Görseller & Galeri
            const mainImg = document.getElementById('listingDetailMainImg');
            const galleryStrip = document.getElementById('listingDetailGalleryStrip');
            const images = p.images || [];

            let mainUrl = p.mainImageUrl || (images.length > 0 ? (images.find(x => x.isMain)?.imageUrl || images[0].imageUrl) : '/images/default-product.svg');
            if (mainImg) mainImg.src = mainUrl || '/images/default-product.svg';

            if (galleryStrip) {
                if (images.length > 1) {
                    galleryStrip.classList.remove('hidden');
                    galleryStrip.innerHTML = images.map((img, idx) => `
                        <div class="relative w-12 h-12 rounded-lg border-2 ${img.imageUrl === mainUrl ? 'border-blue-600' : 'border-slate-200'} bg-white overflow-hidden shrink-0 cursor-pointer hover:opacity-90 transition-all p-0.5"
                             onclick="switchListingDetailMainImage('${img.imageUrl}', this)"
                             title="Görseli Büyüt">
                            <img src="${img.imageUrl}" alt="Görsel ${idx+1}" class="w-full h-full object-contain" onerror="this.src='/images/default-product.svg'" />
                        </div>
                    `).join('');
                } else {
                    galleryStrip.classList.add('hidden');
                    galleryStrip.innerHTML = '';
                }
            }

            // Aksiyon Butonları Bağlantıları
            const editBtn = document.getElementById('listingDetailEditBtn');
            if (editBtn) {
                editBtn.onclick = function() {
                    closeListingDetailModal();
                    openEditListingModal(itemId);
                };
            }

            const delBtn = document.getElementById('listingDetailDeleteBtn');
            if (delBtn) {
                delBtn.onclick = function() {
                    closeListingDetailModal();
                    deleteListing(itemId, name);
                };
            }
        }

        function switchListingDetailMainImage(url, thumbEl) {
            const mainImg = document.getElementById('listingDetailMainImg');
            if (mainImg && url) {
                mainImg.src = url;
            }
            if (thumbEl) {
                const strip = document.getElementById('listingDetailGalleryStrip');
                if (strip) {
                    strip.querySelectorAll('div').forEach(d => {
                        d.classList.remove('border-blue-600');
                        d.classList.add('border-slate-200');
                    });
                }
                thumbEl.classList.remove('border-slate-200');
                thumbEl.classList.add('border-blue-600');
            }
        }

        // Yeni İlan Modalı Aç / Kapa
        function openCreateListingModal() {
            var isIyzicoApproved = @(Model.IsIyzicoApproved ? "true" : "false");
            if (!isIyzicoApproved) {
                if (typeof showRealtimeToast === 'function') {
                    showRealtimeToast("⚠️ Ürün satışa koyabilmek için lütfen önce iyzico Satıcı (Alt Üye İşyeri) kaydınızı tamamlayınız.", "warning");
                } else {
                    alert("⚠️ Ürün satışa koyabilmek için lütfen önce iyzico Satıcı (Alt Üye İşyeri) kaydınızı tamamlayınız.");
                }
                setTimeout(function() {
                    window.location.href = '/Dashboard/SupplierOrders';
                }, 1200);
                return;
            }

            (dashCreateUploadedImages || []).forEach(img => {
                if (img.previewUrl && img.previewUrl.startsWith('blob:')) {
                    try { URL.revokeObjectURL(img.previewUrl); } catch(e) {}
                }
            });
            dashCreateUploadedImages = [];
            renderDashCreateImages();
            setupDashboardDropzones();

            var modal = document.getElementById('dashCreateListingModal');
            if (modal) {
                document.getElementById('dashboardBottomBar')?.classList.add('hidden');
                modal.style.display = 'flex';
                document.getElementById('dashListingProductName')?.focus();
            }
        }

        function closeCreateListingModal() {
            var modal = document.getElementById('dashCreateListingModal');
            if (modal) modal.style.display = 'none';
            document.getElementById('dashboardBottomBar')?.classList.remove('hidden');
            (dashCreateUploadedImages || []).forEach(img => {
                if (img.previewUrl && img.previewUrl.startsWith('blob:')) {
                    try { URL.revokeObjectURL(img.previewUrl); } catch(e) {}
                }
            });
            dashCreateUploadedImages = [];
            renderDashCreateImages();
        }

        function toggleDashCatPicker(forceState) {
            const panel = document.getElementById('dashCatPickerPanel');
            const chevron = document.getElementById('dashCatChevron');
            if (!panel) return;

            const isCurrentlyOpen = !panel.classList.contains('hidden');
            const shouldOpen = typeof forceState === 'boolean' ? forceState : !isCurrentlyOpen;

            if (shouldOpen) {
                panel.classList.remove('hidden');
                if (chevron) chevron.style.transform = 'rotate(180deg)';
                const searchInput = document.getElementById('dashCatSearchInput');
                if (searchInput) setTimeout(() => searchInput.focus(), 60);
            } else {
                panel.classList.add('hidden');
                if (chevron) chevron.style.transform = 'rotate(0deg)';
            }
        }

        function toggleDashCategoryGroup(categoryId, e) {
            if (e) e.stopPropagation();
            const childrenBox = document.getElementById('dashCatChildren-' + categoryId);
            const arrow = document.getElementById('dashCatArrow-' + categoryId);
            if (!childrenBox) return;

            const isHidden = childrenBox.classList.contains('hidden');
            if (isHidden) {
                childrenBox.classList.remove('hidden');
                childrenBox.dataset.manuallyExpanded = 'true';
                if (arrow) arrow.textContent = '▾';
            } else {
                childrenBox.classList.add('hidden');
                delete childrenBox.dataset.manuallyExpanded;
                if (arrow) arrow.textContent = '▸';
            }
        }

        function filterDashCategories(query) {
            const q = (query || '').trim().toLowerCase();
            const rootContainers = document.querySelectorAll('#dashCatTreeBox .cat-root-container');

            if (!q) {
                // Arama kutusu temizlendiğinde: Kökleri aç, alt grupları eski kapalı durumuna getir
                rootContainers.forEach(container => {
                    container.style.display = '';
                    const rows = container.querySelectorAll('.cat-node-row');
                    rows.forEach(r => r.style.display = '');

                    const childrenBox = container.querySelector('.cat-children-box');
                    const arrow = container.querySelector('.cat-expand-arrow');
                    if (childrenBox && !childrenBox.dataset.manuallyExpanded) {
                        childrenBox.classList.add('hidden');
                        if (arrow) arrow.textContent = '▸';
                    }
                });
                return;
            }

            // Arama yapılıyorsa: Eşleşenleri anında filtrele ve görünür kıl
            rootContainers.forEach(container => {
                let hasMatch = false;
                const rows = container.querySelectorAll('.cat-node-row');

                rows.forEach(row => {
                    const title = (row.querySelector('.cat-node-title')?.textContent || '').toLowerCase();
                    if (title.includes(q)) {
                        row.style.display = '';
                        hasMatch = true;
                    } else {
                        row.style.display = 'none';
                    }
                });

                const childrenBox = container.querySelector('.cat-children-box');
                const arrow = container.querySelector('.cat-expand-arrow');

                if (hasMatch) {
                    container.style.display = '';
                    if (childrenBox) {
                        childrenBox.classList.remove('hidden');
                        if (arrow) arrow.textContent = '▾';
                    }
                } else {
                    container.style.display = 'none';
                }
            });
        }

