@using satinalmaportali2.Helpers
@model DashboardViewModel
@{
    ViewData["Title"] = "Genel Bakış";
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";

    // Seri renkleri: doğrulanmış referans paletin slotları. Durum renkleri
    // (yeşil/kırmızı) asla seri rengi olarak kullanılmaz.
    var series = new[] { "#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#8a94a3" };
    var sliceInks = new[] { "#ffffff", "#ffffff", "#ffffff", "#0b0b0b", "#ffffff" };
}

<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

<div class="page-head flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
        <h1 class="text-xl sm:text-2xl font-black tracking-tight text-slate-900">Satın Alma ve Talep Analitiği</h1>
        <p class="text-xs text-slate-500 mt-1">
            @if (Model.State == DataState.Ok) {
                <span>@Model.SelectedYear dönemi · veriler doğrudan veritabanından okunur</span>
            } else {
                <span>Veri kaynağı bağlı değil</span>
            }
        </p>
    </div>

    @if (Model.State == DataState.Ok && Model.AvailableYears.Count > 0) {
        <nav class="year-filter flex items-center gap-1.5 p-1 bg-white border border-slate-200/90 rounded-xl shadow-xs" aria-label="Dönem seçimi">
            @foreach (var year in Model.AvailableYears) {
                <a class="year-pill px-3 py-1.5 rounded-lg text-xs font-semibold transition-all @(year == Model.SelectedYear ? "is-active bg-blue-600 text-white shadow-xs" : "text-slate-600 hover:text-slate-900 hover:bg-slate-50")"
                   asp-action="Index" asp-route-yil="@year"
                   aria-current="@(year == Model.SelectedYear ? "page" : null)">@year</a>
            }
        </nav>
    }
</div>

@if (Model.State != DataState.Ok) {
    <section class="card state-card is-@(Model.State == DataState.NotConfigured ? "setup" : "error")">
        <h2>@(Model.State == DataState.NotConfigured ? "Veritabanı bağlantısı tanımlı değil" : "Veriye ulaşılamadı")</h2>
        <p>@Model.StateMessage</p>

        @if (Model.State == DataState.NotConfigured) {
            <div class="code-block">
<pre>"ConnectionStrings": {
  "@satinalmaportali2.Controllers.DashboardController.ConnectionName":
    "Host=SUNUCU;Port=5432;Database=VERITABANI;Username=KULLANICI;Password=PAROLA;"
}</pre>
            </div>
            <p class="state-note">
                Panel PostgreSQL veritabanına bağlanır ve verileri güvenli şekilde görüntüler.
            </p>
        }

        @if (!string.IsNullOrEmpty(Model.StateDetail)) {
            <div class="code-block"><pre>@Model.StateDetail</pre></div>
        }
    </section>
} else if (Model.IsEmpty) {
    <section class="card state-card is-setup">
        <h2>Bağlantı çalışıyor, ancak gösterilecek kayıt yok</h2>
        <p>
            Veritabanına ulaşıldı fakat @Model.SelectedYear yılı için talep, ürün veya
            değerlendirme kaydı bulunamadı. Kayıtlar girildikçe kartlar ve grafikler
            kendiliğinden dolacak.
        </p>
    </section>
} else {

    <!-- ============ GÖSTERGE KARTLARI ============ -->
    <section class="kpi-row" aria-label="Özet göstergeler">

        <article class="card kpi-card">
            <div class="kpi-top">
                <span class="kpi-label">Toplam Talep</span>
                <span class="kpi-icon accent">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                    </svg>
                </span>
            </div>
            <p class="kpi-value">@Model.Summary.CurrentRequests.ToString("N0", ChartHelper.Tr)</p>
            @if (Model.Summary.RequestChangePercent is decimal change) {
                var cls = change > 0 ? "is-good" : change < 0 ? "is-bad" : "is-flat";
                <p class="kpi-delta @cls">
                    <span aria-hidden="true">@(change > 0 ? "▲" : change < 0 ? "▼" : "■")</span>
                    @ChartHelper.SignedPercent(change)
                    <span class="kpi-delta-note">önceki eşit döneme göre</span>
                </p>
            } else {
                <p class="kpi-delta is-flat"><span class="kpi-delta-note">karşılaştırılacak önceki dönem yok</span></p>
            }
        </article>

        <article class="card kpi-card">
            <div class="kpi-top">
                <span class="kpi-label">Ortalama Tedarikçi Puanı</span>
                <span class="kpi-icon good">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                </span>
            </div>
            <p class="kpi-value">@(Model.Summary.AvgScore is decimal s ? ChartHelper.Score((double)s) : "—")</p>
            <p class="kpi-delta is-flat">
                <span class="kpi-delta-note">
                    @Model.Summary.ReviewCount.ToString("N0", ChartHelper.Tr) değerlendirmeye dayanıyor
                </span>
            </p>
        </article>

        <article class="card kpi-card">
            <div class="kpi-top">
                <span class="kpi-label">Katalog Stok Değeri</span>
                <span class="kpi-icon accent">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                    </svg>
                </span>
            </div>
            <p class="kpi-value">@(Model.Summary.StockValue is decimal v ? ChartHelper.Compact(v) : "—")</p>
            @* Bu bir harcama değil: elde duran katalogun ItemPrice x Quantity toplamı. *@
            <p class="kpi-delta is-flat">
                <span class="kpi-delta-note">
                    @Model.Summary.ItemCount.ToString("N0", ChartHelper.Tr) ürün · harcama değil, katalog değeri
                </span>
            </p>
        </article>

        <article class="card kpi-card">
            <div class="kpi-top">
                <span class="kpi-label">Kayıtlı Firma</span>
                <span class="kpi-icon accent">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                    </svg>
                </span>
            </div>
            <p class="kpi-value">@Model.Summary.CompanyCount.ToString("N0", ChartHelper.Tr)</p>
            <p class="kpi-delta is-flat">
                <span class="kpi-delta-note">
                    @if (!string.IsNullOrEmpty(Model.Summary.TopMembershipName)) {
                        <span>en yaygın üyelik: @Model.Summary.TopMembershipName (@Model.Summary.TopMembershipCount)</span>
                    } else {
                        <span>üyelik kırılımı yok</span>
                    }
                </span>
            </p>
        </article>
    </section>

    <!-- ============ TALEP TRENDİ + TÜR DAĞILIMI ============ -->
    <section class="grid-wide-narrow">

        <article class="card chart-card">
            <div class="card-head">
                <div>
                    <h2>Talep Trendi</h2>
                    <p class="card-sub">@Model.SelectedYear · aylık adet, talep türüne göre</p>
                </div>
                @if (Model.TrendSeriesList.Count > 1) {
                    <div class="legend">
                        @for (var i = 0; i < Model.TrendSeriesList.Count; i++) {
                            <span class="legend-item">
                                <span class="legend-dot" style="background:@series[i % series.Length]"></span>
                                @Model.TrendSeriesList[i].Name
                            </span>
                        }
                    </div>
                }
            </div>

            @{
                var periods = Model.TrendPeriods;
                const double tW = 720, tH = 290, tPadL = 58, tPadR = 16, tPadT = 16, tPadB = 42;
                var tPlotW = tW - tPadL - tPadR;
                var tPlotH = tH - tPadT - tPadB;
                var tMaxValue = Model.TrendSeriesList.Count == 0 || periods.Count == 0
                    ? 0.0
                    : Model.TrendSeriesList.Max(sr => sr.Values.Count == 0 ? 0 : sr.Values.Max());
                var tTop = ChartHelper.NiceCeiling(tMaxValue);
                var tStepX = periods.Count > 1 ? tPlotW / (periods.Count - 1) : 0;
                Func<int, double> tX = i => tPadL + tStepX * i;
                Func<double, double> tY = val => tPadT + tPlotH * (1 - val / tTop);
            }

            <div class="chart-frame">
                <svg class="chart-svg" viewBox="0 0 @ChartHelper.N(tW) @ChartHelper.N(tH)"
                     preserveAspectRatio="xMidYMid meet" role="img"
                     aria-label="@Model.SelectedYear yılında aylık talep adedi">

                    @foreach (var tick in ChartHelper.Ticks(tTop)) {
                        <line class="grid-line" x1="@ChartHelper.N(tPadL)" x2="@ChartHelper.N(tPadL + tPlotW)"
                              y1="@ChartHelper.N(tY(tick))" y2="@ChartHelper.N(tY(tick))" />
                        @ChartHelper.SvgText(tPadL - 10, tY(tick) + 4, ((int)Math.Round(tick)).ToString("N0", ChartHelper.Tr), "axis-text", "end")
                    }

                    <line class="axis-line" x1="@ChartHelper.N(tPadL)" x2="@ChartHelper.N(tPadL + tPlotW)"
                          y1="@ChartHelper.N(tY(0))" y2="@ChartHelper.N(tY(0))" />

                    @for (var si = 0; si < Model.TrendSeriesList.Count; si++) {
                        var line = Model.TrendSeriesList[si];
                        var color = series[si % series.Length];
                        var points = line.Values
                            .Select((val, i) => (X: tX(i), Y: tY(val)))
                            .ToList();

                        <polyline points="@ChartHelper.PolylinePoints(points)" fill="none"
                                  stroke="@color" stroke-width="2"
                                  stroke-linecap="round" stroke-linejoin="round" />

                        @if (points.Count > 0) {
                            <circle cx="@ChartHelper.N(points[^1].X)" cy="@ChartHelper.N(points[^1].Y)" r="4"
                                    fill="@color" stroke="var(--surface)" stroke-width="2" />
                        }
                    }

                    @for (var i = 0; i < periods.Count; i++) {
                        var bandW = periods.Count > 1 ? tStepX : tPlotW;
                        var bandX = periods.Count > 1 ? tX(i) - bandW / 2 : tPadL;

                        @ChartHelper.SvgText(tX(i), tPadT + tPlotH + 20, ChartHelper.MonthLabel(periods[i].Month), "axis-text")

                        var tipRows = string.Join("|", Model.TrendSeriesList.Select((sr, si2) =>
                            $"{series[si2 % series.Length]};{sr.Name};{(i < sr.Values.Count ? sr.Values[i] : 0)}"));

                        <rect class="hit-area" x="@ChartHelper.N(Math.Max(bandX, tPadL))" y="@ChartHelper.N(tPadT)"
                              width="@ChartHelper.N(bandW)" height="@ChartHelper.N(tPlotH)"
                              data-tip-title="@ChartHelper.MonthYear(DateOnly.FromDateTime(periods[i]))"
                              data-tip-rows="@tipRows" />
                    }
                </svg>
            </div>

            <details class="table-view">
                <summary>Tablo görünümü</summary>
                <div class="table-scroll">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Ay</th>
                                @foreach (var line in Model.TrendSeriesList) { <th class="num">@line.Name</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < periods.Count; i++) {
                                <tr>
                                    <td>@ChartHelper.MonthYear(DateOnly.FromDateTime(periods[i]))</td>
                                    @foreach (var line in Model.TrendSeriesList) {
                                        <td class="num">@(i < line.Values.Count ? line.Values[i] : 0)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        </article>

        <article class="card chart-card">
            <div class="card-head">
                <div>
                    <h2>Talep Türü Dağılımı</h2>
                    <p class="card-sub">@Model.SelectedYear toplamının kırılımı</p>
                </div>
            </div>

            @{
                var types = Model.RequestTypes;
                const double dSize = 250, dOuter = 104, dInner = 66, dGap = 1.6;
                var dCenter = dSize / 2;
                var typeTotal = types.Sum(t => t.RequestCount);
                var sweepStart = 0.0;
            }

            <div class="donut-wrap">
                <svg class="donut-svg" viewBox="0 0 @ChartHelper.N(dSize) @ChartHelper.N(dSize)"
                     role="img" aria-label="Talep türlerinin dağılımı">

                    @for (var i = 0; i < types.Count; i++) {
                        var row = types[i];
                        var share = typeTotal <= 0 ? 0 : (double)row.RequestCount / typeTotal;
                        var sweep = share * 360.0;
                        var color = series[i % series.Length];
                        var arcStart = sweepStart + dGap / 2;
                        var arcEnd = sweepStart + sweep - dGap / 2;
                        var label = string.IsNullOrWhiteSpace(row.RequestType) ? "Belirtilmemiş" : row.RequestType!;

                        if (arcEnd > arcStart) {
                            <path fill="@color"
                                  d="@ChartHelper.DonutArc(dCenter, dCenter, dOuter, dInner, arcStart, arcEnd)"
                                  data-tip-title="@label"
                                  data-tip-rows="@($"{color};Talep;{row.RequestCount.ToString("N0", ChartHelper.Tr)}|{color};Pay;{ChartHelper.Percent((double)row.SharePercent, 1)}")" />
                        }

                        if (sweep >= 28) {
                            var mid = sweepStart + sweep / 2;
                            var pt = ChartHelper.PointOnCircle(dCenter, dCenter, (dOuter + dInner) / 2, mid);
                            <g class="slice-label" style="fill:@sliceInks[i % sliceInks.Length]">
                                @ChartHelper.SvgText(pt.X, pt.Y + 4, ChartHelper.Percent((double)row.SharePercent, 0), "slice-label-text")
                            </g>
                        }

                        sweepStart += sweep;
                    }

                    @ChartHelper.SvgText(dCenter, dCenter - 4, typeTotal.ToString("N0", ChartHelper.Tr), "donut-center-value")
                    @ChartHelper.SvgText(dCenter, dCenter + 16, "toplam talep", "donut-center-label")
                </svg>

                <ul class="donut-legend">
                    @for (var i = 0; i < types.Count; i++) {
                        var row = types[i];
                        <li>
                            <span class="legend-dot" style="background:@series[i % series.Length]"></span>
                            <span class="legend-name">@(string.IsNullOrWhiteSpace(row.RequestType) ? "Belirtilmemiş" : row.RequestType)</span>
                            <span class="legend-value">@row.RequestCount.ToString("N0", ChartHelper.Tr)</span>
                            <span class="legend-share">@ChartHelper.Percent((double)row.SharePercent, 1)</span>
                        </li>
                    }
                </ul>
            </div>
        </article>
    </section>

    <!-- ============ KATEGORİ + ŞİRKET KIRILIMI ============ -->
    <section class="grid-equal">

        <article class="card chart-card">
            <div class="card-head">
                <div>
                    <h2>Kategoriye Göre Katalog</h2>
                    <p class="card-sub">Kategori kırılımı · stok değeri sırasıyla</p>
                </div>
            </div>

            @{
                var cats = Model.Categories;
                const double cW = 720, cRowH = 46, cNameW = 172, cValueW = 104, cBarH = 12;
                var cTrackW = cW - cNameW - cValueW;
                var cHeight = Math.Max(1, cats.Count) * cRowH;
                var cMax = cats.Count == 0 ? 1.0 : Math.Max(1.0, cats.Max(x => (double)(x.StockValue ?? 0)));
            }

            <div class="chart-frame">
                <svg class="chart-svg" viewBox="0 0 @ChartHelper.N(cW) @ChartHelper.N(cHeight)"
                     preserveAspectRatio="xMidYMid meet" role="img"
                     aria-label="Kategorilere göre katalog stok değeri">
                    @for (var i = 0; i < cats.Count; i++) {
                        var row = cats[i];
                        var rowTop = i * cRowH;
                        var barW = cTrackW * (double)(row.StockValue ?? 0) / cMax;

                        @ChartHelper.SvgText(0, rowTop + 26, row.CategoryName ?? "—", "mark-name", "start")
                        <path fill="@series[0]" d="@ChartHelper.BarPath(cNameW, rowTop + 15, Math.Max(barW, 0.5), cBarH, 3)" />
                        @ChartHelper.SvgText(cW, rowTop + 26, ChartHelper.Compact(row.StockValue ?? 0), "mark-value", "end")

                        <rect class="hit-area" x="0" y="@ChartHelper.N(rowTop)"
                              width="@ChartHelper.N(cW)" height="@ChartHelper.N(cRowH)"
                              data-tip-title="@row.CategoryName"
                              data-tip-rows="@($"{series[0]};Stok değeri;{ChartHelper.Money(row.StockValue ?? 0)}|{series[0]};Ürün;{row.ItemCount.ToString("N0", ChartHelper.Tr)}")" />
                    }
                </svg>
            </div>

            <details class="table-view">
                <summary>Fiyat istatistikleri</summary>
                <div class="table-scroll">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Kategori</th>
                                <th class="num">Ürün</th>
                                <th class="num">Stok Adedi</th>
                                <th class="num">En Düşük</th>
                                <th class="num">Ortalama</th>
                                <th class="num">En Yüksek</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in cats) {
                                <tr>
                                    <td>@row.CategoryName</td>
                                    <td class="num">@row.ItemCount.ToString("N0", ChartHelper.Tr)</td>
                                    <td class="num">@((row.TotalQuantity ?? 0).ToString("N0", ChartHelper.Tr))</td>
                                    <td class="num">@ChartHelper.Money(row.MinPrice ?? 0)</td>
                                    <td class="num">@ChartHelper.Money(row.AvgPrice ?? 0)</td>
                                    <td class="num">@ChartHelper.Money(row.MaxPrice ?? 0)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        </article>

        <article class="card chart-card">
            <div class="card-head">
                <div>
                    <h2>Şirket Tipi ve Üyelik</h2>
                    <p class="card-sub">Her şirket tipinde üyelik dağılımı</p>
                </div>
                <div class="legend">
                    @{ var memberships = Model.MembershipNames; }
                    @for (var i = 0; i < memberships.Count; i++) {
                        <span class="legend-item">
                            <span class="legend-dot" style="background:@series[i % series.Length]"></span>
                            @memberships[i]
                        </span>
                    }
                </div>
            </div>

            @{
                var compTypes = Model.CompanyTypeNames;
                const double gW = 720, gNameW = 172, gValueW = 60, gBarH = 10, gBarGap = 2;
                var gTrackW = gW - gNameW - gValueW;
                var gRowH = 22 + memberships.Count * (gBarH + gBarGap);
                var gHeight = Math.Max(1, compTypes.Count) * gRowH;
                var gMax = Model.CompanyMix.Count == 0 ? 1.0 : Math.Max(1.0, Model.CompanyMix.Max(m => (double)m.CompanyCount));
            }

            <div class="chart-frame">
                <svg class="chart-svg" viewBox="0 0 @ChartHelper.N(gW) @ChartHelper.N(gHeight)"
                     preserveAspectRatio="xMidYMid meet" role="img"
                     aria-label="Şirket tipi ve üyelik tipine göre firma sayıları">
                    @for (var ti = 0; ti < compTypes.Count; ti++) {
                        var typeName = compTypes[ti];
                        var rowTop = ti * gRowH;

                        @ChartHelper.SvgText(0, rowTop + 16, typeName, "mark-name", "start")

                        for (var mi = 0; mi < memberships.Count; mi++) {
                            var cell = Model.CompanyMix.FirstOrDefault(m =>
                                (m.CompanyTypeName ?? "—") == typeName && (m.MembershipTypeName ?? "—") == memberships[mi]);
                            var count = cell?.CompanyCount ?? 0;
                            var barY = rowTop + 8 + mi * (gBarH + gBarGap);
                            var barW = gTrackW * count / gMax;

                            <path fill="@series[mi % series.Length]"
                                  d="@ChartHelper.BarPath(gNameW, barY, Math.Max(barW, 0.5), gBarH, 3)" />

                            <rect class="hit-area" x="@ChartHelper.N(gNameW)" y="@ChartHelper.N(barY - 1)"
                                  width="@ChartHelper.N(gTrackW + gValueW)" height="@ChartHelper.N(gBarH + 2)"
                                  data-tip-title="@typeName"
                                  data-tip-rows="@($"{series[mi % series.Length]};{memberships[mi]};{count.ToString("N0", ChartHelper.Tr)}")" />
                        }
                    }
                </svg>
            </div>
        </article>
    </section>

    <!-- ============ TEDARİKÇİ KARNESİ ============ -->
    <section class="card">
        <div class="card-head">
            <div>
                <h2>Tedarikçi Karnesi</h2>
                <p class="card-sub">
                    @Model.SelectedYear yılında aldığı talep sayısı ve tüm zamanların puan ortalaması.
                    En az @VendorScorecardRow.MinReviewsForRanking değerlendirmesi olmayanlar
                    &quot;yetersiz veri&quot; olarak işaretlenir.
                </p>
            </div>
        </div>

        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Firma</th>
                        <th>Tip</th>
                        <th class="num">Alınan Talep</th>
                        <th class="num">Puan</th>
                        <th class="num">Değerlendirme</th>
                        <th>Güvenilirlik</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Vendors) {
                        <tr>
                            <td><span class="req-id">@row.CompanyName</span></td>
                            <td>@(row.CompanyTypeName ?? "—")</td>
                            <td class="num">@row.ReceivedRequests.ToString("N0", ChartHelper.Tr)</td>
                            <td class="num">@(row.AvgScore is decimal sc ? ChartHelper.Score((double)sc) : "—")</td>
                            <td class="num">@row.ReviewCount.ToString("N0", ChartHelper.Tr)</td>
                            <td>
                                @if (row.HasReliableScore) {
                                    <span class="status-chip is-approved">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                        Yeterli
                                    </span>
                                } else {
                                    <span class="status-chip is-neutral">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                                            <circle cx="12" cy="12" r="9"></circle>
                                            <line x1="12" y1="8" x2="12" y2="13"></line>
                                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                        </svg>
                                        Yetersiz veri
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- ============ MARKA + BÖLGE ============ -->
    <section class="grid-equal">

        <article class="card chart-card">
            <div class="card-head">
                <div>
                    <h2>Marka Dağılımı</h2>
                    <p class="card-sub">Ürün adedine göre ilk @Model.Brands.Count marka</p>
                </div>
            </div>

            @{
                var brands = Model.Brands;
                const double bW = 720, bRowH = 40, bNameW = 190, bValueW = 90, bBarH = 11;
                var bTrackW = bW - bNameW - bValueW;
                var bHeight = Math.Max(1, brands.Count) * bRowH;
                var bMax = brands.Count == 0 ? 1.0 : Math.Max(1.0, brands.Max(x => (double)x.ItemCount));
            }

            <div class="chart-frame">
                <svg class="chart-svg" viewBox="0 0 @ChartHelper.N(bW) @ChartHelper.N(bHeight)"
                     preserveAspectRatio="xMidYMid meet" role="img" aria-label="Markalara göre ürün adedi">
                    @for (var i = 0; i < brands.Count; i++) {
                        var row = brands[i];
                        var rowTop = i * bRowH;
                        var barW = bTrackW * row.ItemCount / bMax;

                        @ChartHelper.SvgText(0, rowTop + 24, row.Brand ?? "—", "mark-name", "start")
                        <path fill="@series[0]" d="@ChartHelper.BarPath(bNameW, rowTop + 14, Math.Max(barW, 0.5), bBarH, 3)" />
                        @ChartHelper.SvgText(bW, rowTop + 24, row.ItemCount.ToString("N0", ChartHelper.Tr), "mark-value", "end")

                        <rect class="hit-area" x="0" y="@ChartHelper.N(rowTop)"
                              width="@ChartHelper.N(bW)" height="@ChartHelper.N(bRowH)"
                              data-tip-title="@row.Brand"
                              data-tip-rows="@($"{series[0]};Ürün;{row.ItemCount.ToString("N0", ChartHelper.Tr)}|{series[0]};Stok değeri;{ChartHelper.Money(row.StockValue ?? 0)}")" />
                    }
                </svg>
            </div>
        </article>

        <article class="card chart-card">
            <div class="card-head">
                <div>
                    <h2>Bölgesel Dağılım</h2>
                    <p class="card-sub">
                        Adres kaydı olan firmalar · ülke ve şehir
                        <span class="partial-flag">koordinat sütunu yok, harita çizilemiyor</span>
                    </p>
                </div>
            </div>

            @{
                var regions = Model.Regions.Take(10).ToList();
                const double rW = 720, rRowH = 40, rNameW = 220, rValueW = 70, rBarH = 11;
                var rTrackW = rW - rNameW - rValueW;
                var rHeight = Math.Max(1, regions.Count) * rRowH;
                var rMax = regions.Count == 0 ? 1.0 : Math.Max(1.0, regions.Max(x => (double)x.CompanyCount));
            }

            <div class="chart-frame">
                <svg class="chart-svg" viewBox="0 0 @ChartHelper.N(rW) @ChartHelper.N(rHeight)"
                     preserveAspectRatio="xMidYMid meet" role="img" aria-label="Bölgelere göre firma sayısı">
                    @for (var i = 0; i < regions.Count; i++) {
                        var row = regions[i];
                        var rowTop = i * rRowH;
                        var barW = rTrackW * row.CompanyCount / rMax;
                        var placeName = $"{row.TownName} · {row.CountryName}";

                        @ChartHelper.SvgText(0, rowTop + 24, placeName, "mark-name", "start")
                        <path fill="@series[2]" d="@ChartHelper.BarPath(rNameW, rowTop + 14, Math.Max(barW, 0.5), rBarH, 3)" />
                        @ChartHelper.SvgText(rW, rowTop + 24, row.CompanyCount.ToString("N0", ChartHelper.Tr), "mark-value", "end")

                        <rect class="hit-area" x="0" y="@ChartHelper.N(rowTop)"
                              width="@ChartHelper.N(rW)" height="@ChartHelper.N(rRowH)"
                              data-tip-title="@placeName"
                              data-tip-rows="@($"{series[2]};Firma;{row.CompanyCount.ToString("N0", ChartHelper.Tr)}")" />
                    }
                </svg>
            </div>
        </article>
    </section>

    <!-- ============ AKIŞ + FORMLAR ============ -->
    <section class="grid-equal">

        <article class="card">
            <div class="card-head">
                <div>
                    <h2>Alıcı → Satıcı Akışı</h2>
                    <p class="card-sub">@Model.SelectedYear yılında en çok talep trafiği olan firma çiftleri</p>
                </div>
            </div>

            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr><th>Gönderen</th><th>Alan</th><th class="num">Talep</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Flows) {
                            <tr>
                                <td>@row.SenderName</td>
                                <td>@row.ReceiverName</td>
                                <td class="num">@row.RequestCount.ToString("N0", ChartHelper.Tr)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </article>

        <article class="card">
            <div class="card-head">
                <div>
                    <h2>Gelen Formlar</h2>
                    <p class="card-sub">@Model.SelectedYear · konuya göre</p>
                </div>
            </div>

            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr><th>Konu</th><th class="num">Adet</th><th>Son Gelen</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.FormTopics) {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(row.Topic) ? "Belirtilmemiş" : row.Topic)</td>
                                <td class="num">@row.FormCount.ToString("N0", ChartHelper.Tr)</td>
                                <td>@(row.LastReceived is DateTime d ? ChartHelper.ShortDate(DateOnly.FromDateTime(d)) : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </article>
    </section>

    <!-- ============ KATEGORİ YÖNETİMİ & HİYERARŞİ LİSTESİ (N-SEVİYE) ============ -->
    <section class="grid-wide-narrow category-mgmt-wrapper" id="kategori-yonetimi" style="grid-template-columns: 1fr; margin-top: 24px;">

        <article class="card chart-card">
            <div class="card-head" style="align-items: center;">
                <div>
                    <h2>Kategori Hiyerarşisi (Sınırsız Alt Kategori Derinliği)</h2>
                    <p class="card-sub">
                        @{
                            var totalCount = Model.AllCategories?.Count ?? 0;
                            var rootCount = Model.CategoryTree?.Count ?? 0;
                        }
                        Sistemde toplam <strong>@totalCount Kategori</strong> (<strong>@rootCount Kök Kategori</strong>) tanımlı. Altına kategori eklemek istediğiniz elemanın üzerine veya <code>+ Alt Kategori</code> butonuna tıklayın.
                    </p>
                </div>

                <div style="display: flex; align-items: center; gap: 12px;">
                    <!-- ARAMA KUTUSU -->
                    <div class="cat-search-box" style="margin-bottom: 0;">
                        <svg class="cat-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input type="text" id="catSearchInput" onkeyup="filterCatTree()" placeholder="Kategori ara..." class="cat-search-input" style="width: 200px;" />
                    </div>

                    <!-- KÖK KATEGORİ EKLE BUTONU (SAĞ ÜST) -->
                    <button type="button" class="btn-primary" onclick="openCatModal(null, 'Kök Kategori')" style="height: 36px; padding: 0 14px; font-size: 0.85rem; flex: none;">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        + Kök Kategori Ekle
                    </button>
                </div>
            </div>

            @if (TempData["CategorySuccess"] != null)
            {
                <div class="alert alert-success" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.35); color: #34D399; padding: 10px 14px; border-radius: 8px; margin: 0 0 16px 0; font-size: 0.88rem; font-weight: 500;">
                    @TempData["CategorySuccess"]
                </div>
            }
            @if (TempData["CategoryError"] != null)
            {
                <div class="alert alert-danger" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.35); color: #F87171; padding: 10px 14px; border-radius: 8px; margin: 0 0 16px 0; font-size: 0.88rem; font-weight: 500;">
                    @TempData["CategoryError"]
                </div>
            }

            <!-- RECURSIVE TREE RENDERER -->
            <div class="cat-tree-container" style="max-height: 520px;">
                @if (Model.CategoryTree == null || Model.CategoryTree.Count == 0)
                {
                    <div style="text-align: center; color: #64748B; padding: 50px 0; font-size: 0.92rem;">
                        Henüz veritabanında kategori bulunmuyor.<br />
                        Sağ üstteki <strong>+ Kök Kategori Ekle</strong> butonuna basarak ilk kategorinizi oluşturabilirsiniz.
                    </div>
                }
                else
                {
                    @foreach (var root in Model.CategoryTree)
                    {
                        <partial name="_CategoryNodePartial" model="(Node: root, Level: 0)" />
                    }
                }
            </div>
        </article>
    </section>

    <!-- ============ POPUP KUTUCUK (MODAL DIALOG) FOR KATEGORİ OLUŞTURMA ============ -->
    <div class="cat-modal-backdrop fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4 sm:p-6 md:p-8 overflow-y-auto transition-opacity" id="categoryModal" onclick="if(event.target === this) closeCatModal();">
        <div class="cat-modal-dialog my-auto relative bg-white rounded-2xl shadow-2xl border border-slate-200/90 w-full max-w-md max-h-[88vh] overflow-hidden transform transition-all">
            <div class="cat-modal-header px-6 pt-6 pb-5 sm:px-7 sm:pt-7 sm:pb-5 border-b border-slate-100 flex items-start justify-between bg-slate-50/80">
                <div>
                    <div class="mb-2">
                        <span class="status-badge badge-blue text-[11px] font-bold px-2 py-0.5 rounded-md">KATEGORİ AĞACI</span>
                    </div>
                    <h3 class="cat-modal-title text-base font-extrabold text-slate-900" id="modalTitleText">Yeni Kategori Ekle</h3>
                </div>
                <button type="button" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-200/60 transition-colors cursor-pointer text-base leading-none shrink-0 ml-4 -mt-1 -mr-1" onclick="closeCatModal()">&times;</button>
            </div>

            <form asp-controller="Dashboard" asp-action="CreateCategory" method="post" id="modalCategoryForm" onsubmit="handleCategorySubmit(event); return false;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="parentCategoryId" id="modalParentCategoryId" value="" />

                <div class="cat-modal-body p-6 space-y-4 text-xs">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1.5" for="modalCategoryNameInput">
                            Kategori Adı <span class="text-rose-500 font-bold">*</span>
                        </label>
                        <input type="text" name="categoryName" id="modalCategoryNameInput" required placeholder="Kategori adını girin..." class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all" />
                    </div>

                    <div class="p-3.5 bg-blue-50/70 border border-blue-200/80 rounded-xl text-xs text-blue-900 leading-relaxed">
                        <span id="modalHelpText">Üst kategori seçilmedi. Bu kayıt <code class="bg-white px-1.5 py-0.5 rounded border border-blue-200 font-mono text-[11px] font-semibold text-blue-800">ParentCategoryID = NULL</code> (Kök Kategori) olarak eklenecektir.</span>
                    </div>
                </div>

                <div class="cat-modal-footer px-6 py-3.5 border-t border-slate-100 bg-slate-50/80 flex items-center justify-end gap-2.5">
                    <button type="button" class="btn-cancel px-4 py-2 rounded-lg text-xs font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 transition shadow-2xs cursor-pointer" onclick="closeCatModal()">İptal</button>
                    <button type="submit" class="btn-primary px-4.5 py-2 rounded-lg text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 shadow-xs shadow-blue-600/20 transition cursor-pointer">
                        Kategori Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openCatModal(parentId, parentName) {
            var modal = document.getElementById('categoryModal');
            var inputParentId = document.getElementById('modalParentCategoryId');
            var titleText = document.getElementById('modalTitleText');
            var helpText = document.getElementById('modalHelpText');
            var inputName = document.getElementById('modalCategoryNameInput');

            if (parentId) {
                inputParentId.value = parentId;
                titleText.innerHTML = "'" + parentName + "' Altına Kategori Ekle";
                helpText.innerHTML = "Yeni eklenecek kategori <strong>" + parentName + "</strong> (ID: " + parentId + ") kategorisinin alt kategorisi (<code>ParentCategoryID = " + parentId + "</code>) olacaktır.";
                inputName.placeholder = parentName + " altına eklenecek kategori adı...";
            } else {
                inputParentId.value = "";
                titleText.innerHTML = "Yeni Kök Kategori Ekle";
                helpText.innerHTML = "Üst kategori seçilmedi. Bu kayıt <code>ParentCategoryID = NULL</code> (Kök Kategori) olarak kaydedilecektir.";
                inputName.placeholder = "Örn: Sanayi Hammaddeleri, Otomasyon...";
            }

            inputName.value = "";
            modal.classList.add('is-open');
            setTimeout(function() { inputName.focus(); }, 150);
        }

        function closeCatModal() {
            var modal = document.getElementById('categoryModal');
            modal.classList.remove('is-open');
        }

        async function handleCategorySubmit(event) {
            if (event) {
                if (typeof event.preventDefault === 'function') event.preventDefault();
                if (typeof event.stopPropagation === 'function') event.stopPropagation();
            }

            const form = event.target;
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalText = submitBtn ? submitBtn.innerHTML : 'Kategori Kaydet';
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = 'Kaydediliyor...';
            }

            try {
                const formData = new FormData(form);
                const response = await fetch('/Dashboard/CreateCategory', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    },
                    body: formData
                });

                const result = await response.json();
                if (result.success) {
                    closeCatModal();
                    form.reset();
                    if (typeof showRealtimeToast === 'function') {
                        showRealtimeToast(result.message || 'Kategori başarıyla eklendi!', 'success');
                    } else if (typeof showAppToast === 'function') {
                        showAppToast(result.message || 'Kategori başarıyla eklendi!', true);
                    }
                } else {
                    if (typeof showRealtimeToast === 'function') {
                        showRealtimeToast('Hata: ' + (result.message || 'Kategori eklenemedi.'), 'error');
                    } else {
                        alert('Hata: ' + result.message);
                    }
                }
            } catch (err) {
                if (typeof showRealtimeToast === 'function') {
                    showRealtimeToast('Bağlantı hatası: ' + err.message, 'error');
                } else {
                    alert('Bağlantı hatası: ' + err.message);
                }
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            }
        }

        function filterCatTree() {
            var filter = document.getElementById('catSearchInput').value.toLowerCase();
            var cards = document.querySelectorAll('.cat-tree-card');
            cards.forEach(function (card) {
                var text = card.textContent.toLowerCase();
                if (text.indexOf(filter) > -1) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        }
    </script>
}
