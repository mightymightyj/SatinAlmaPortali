@model satinalmaportali2.Models.UserFeedbackViewModel
@{
    ViewData["Title"] = "Geri Bildirim & Destek Talebi";
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
}

<style>
    .fb-container {
        display: flex;
        flex-direction: column;
        gap: 22px;
        color: #0F172A;
    }

    .fb-header {
        background: linear-gradient(135deg, #1E293B 0%, #0F172A 100%);
        border-radius: 14px;
        padding: 24px 28px;
        color: #FFFFFF;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        box-shadow: 0 4px 15px -3px rgba(15, 23, 42, 0.15);
    }

    .fb-header-info h1 {
        font-size: 1.45rem;
        font-weight: 700;
        margin: 0 0 6px 0;
        display: flex;
        align-items: center;
        gap: 10px;
        letter-spacing: -0.01em;
    }

    .fb-header-info p {
        margin: 0;
        font-size: 0.86rem;
        color: #94A3B8;
        display: flex;
        align-items: center;
        gap: 8px;
        line-height: 1.5;
    }

    .fb-grid {
        display: grid;
        grid-template-columns: 1.3fr 1fr;
        gap: 22px;
        align-items: start;
    }

    @@media (max-width: 992px) {
        .fb-grid {
            grid-template-columns: 1fr;
        }
    }

    .fb-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }

    .fb-card-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #0F172A;
        margin: 0 0 4px 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .fb-card-subtitle {
        font-size: 0.82rem;
        color: #64748B;
        margin: 0 0 20px 0;
    }

    .fb-form-group {
        margin-bottom: 18px;
    }

    .fb-form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        margin-bottom: 18px;
    }

    @@media (max-width: 640px) {
        .fb-form-row {
            grid-template-columns: 1fr;
        }
    }

    .fb-label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: #334155;
        margin-bottom: 6px;
    }

    .fb-input, .fb-select, .fb-textarea {
        width: 100%;
        padding: 9px 13px;
        font-size: 0.88rem;
        border: 1px solid #CBD5E1;
        border-radius: 8px;
        background: #FFFFFF;
        color: #0F172A;
        box-sizing: border-box;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .fb-input:focus, .fb-select:focus, .fb-textarea:focus {
        border-color: #2563EB;
        outline: none;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    .fb-textarea {
        min-height: 120px;
        resize: vertical;
    }

    .fb-rating-group {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .fb-rating-btn {
        flex: 1;
        padding: 9px 6px;
        text-align: center;
        border: 1px solid #E2E8F0;
        background: #F8FAFC;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        color: #475569;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .fb-rating-btn:hover {
        background: #F1F5F9;
        border-color: #CBD5E1;
    }

    .fb-rating-btn.active {
        background: #2563EB;
        color: #FFFFFF;
        border-color: #1D4ED8;
    }

    .fb-submit-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 22px;
        background: #2563EB;
        color: #FFFFFF;
        border: none;
        border-radius: 8px;
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .fb-submit-btn:hover {
        background: #1D4ED8;
    }

    .fb-submit-btn:disabled {
        opacity: 0.65;
        cursor: not-allowed;
    }

    /* Geçmiş Geri Bildirimler */
    .fb-past-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-height: 520px;
        overflow-y: auto;
        padding-right: 4px;
    }

    .fb-item-card {
        padding: 14px;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        background: #F8FAFC;
        transition: background 0.15s ease;
    }

    .fb-item-card:hover {
        background: #F1F5F9;
    }

    .fb-item-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 6px;
    }

    .fb-item-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 8px;
        border-radius: 12px;
        font-size: 0.72rem;
        font-weight: 600;
        background: #E0E7FF;
        color: #3730A3;
    }

    .fb-item-date {
        font-size: 0.74rem;
        color: #94A3B8;
        font-weight: 500;
    }

    .fb-item-text {
        font-size: 0.82rem;
        color: #475569;
        line-height: 1.45;
        white-space: pre-wrap;
    }

    .fb-empty-state {
        text-align: center;
        padding: 36px 16px;
        color: #64748B;
    }

    .fb-empty-state svg {
        margin-bottom: 10px;
        color: #94A3B8;
    }

    .fb-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 0.72rem;
        font-weight: 600;
        background: #DEF7EC;
        color: #03543F;
    }

    .fb-alert-box {
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 500;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .fb-alert-success {
        background: #ECFDF5;
        border: 1px solid #A7F3D0;
        color: #065F46;
    }

    .fb-alert-error {
        background: #FEF2F2;
        border: 1px solid #FECACA;
        color: #991B1B;
    }
</style>

<div class="fb-container">

    <!-- ÜST BAŞLIK -->
    <div class="fb-header">
        <div class="fb-header-info">
            <h1>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                </svg>
                Geri Bildirim &amp; Destek Merkezi
            </h1>
            <p>
                Platform deneyimini iyileştirmemiz, hata bildirimi veya önerilerinizi doğrudan sistem yöneticilerine iletmeniz için bu kanalı kullanabilirsiniz.
            </p>
        </div>
    </div>

    @if (TempData["FeedbackSuccess"] != null)
    {
        <div class="fb-alert-box fb-alert-success">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>@TempData["FeedbackSuccess"]</span>
        </div>
    }

    @if (TempData["FeedbackError"] != null)
    {
        <div class="fb-alert-box fb-alert-error">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span>@TempData["FeedbackError"]</span>
        </div>
    }

    <div id="liveFeedbackToast" style="display: none;" class="fb-alert-box fb-alert-success">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span id="liveFeedbackToastText"></span>
    </div>

    <div class="fb-grid">
        <!-- SOL: GERİ BİLDİRİM FORMU -->
        <div class="fb-card">
            <h2 class="fb-card-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
                Yeni Geri Bildirim veya Talep Oluştur
            </h2>
            <p class="fb-card-subtitle">
                Görüşleriniz teknik ve operasyonel ekiplerimiz tarafından düzenli olarak incelenir.
            </p>

            <form id="feedbackForm" asp-controller="Dashboard" asp-action="SubmitFeedback" method="post">
                @Html.AntiForgeryToken()

                <div class="fb-form-row">
                    <div class="fb-form-group" style="margin-bottom: 0;">
                        <label class="fb-label" for="categorySelect">Bildirim Kategorisi *</label>
                        <select id="categorySelect" name="Category" class="fb-select" required>
                            <option value="Hata Bildirimi">Hata Bildirimi (Teknik Aksaklık / Bug)</option>
                            <option value="Yeni Özellik / Öneri">Yeni Özellik / İşlev Önerisi</option>
                            <option value="Satın Alma &amp; İhale">Satın Alma &amp; İhale Süreçleri</option>
                            <option value="Arayüz &amp; Kullanılabilirlik">Arayüz &amp; Kullanılabilirlik (UX)</option>
                            <option value="Üyelik &amp; Faturalandırma">Üyelik, Paketler &amp; Faturalandırma</option>
                            <option value="Genel Geri Bildirim" selected>Genel Geri Bildirim</option>
                        </select>
                    </div>

                    <div class="fb-form-group" style="margin-bottom: 0;">
                        <label class="fb-label" for="subjectInput">Konu Başlığı</label>
                        <input type="text" id="subjectInput" name="Subject" class="fb-input" placeholder="Örn: Teklif geçerlilik süresi hk." />
                    </div>
                </div>

                <div class="fb-form-group">
                    <label class="fb-label">Platform Deneyimi / Memnuniyet Puanı (İsteğe Bağlı)</label>
                    <div class="fb-rating-group">
                        <input type="hidden" id="ratingInput" name="Rating" value="" />
                        <button type="button" class="fb-rating-btn" onclick="selectRating(1)">1 - Çok Düşük</button>
                        <button type="button" class="fb-rating-btn" onclick="selectRating(2)">2 - Düşük</button>
                        <button type="button" class="fb-rating-btn" onclick="selectRating(3)">3 - Orta</button>
                        <button type="button" class="fb-rating-btn" onclick="selectRating(4)">4 - İyi</button>
                        <button type="button" class="fb-rating-btn" onclick="selectRating(5)">5 - Mükemmel</button>
                    </div>
                </div>

                <div class="fb-form-group">
                    <label class="fb-label" for="messageText">Mesajınız / Detaylı Açıklama *</label>
                    <textarea id="messageText" name="Message" class="fb-textarea" placeholder="Lütfen karşılaştığınız durumu, beklentinizi veya önerinizi detaylıca belirtin..." required></textarea>
                </div>

                <div style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; padding: 12px 16px; margin-top: 14px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <div style="width: 32px; height: 32px; border-radius: 6px; background: #EFF6FF; color: #2563EB; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.82rem;">
                            @(string.IsNullOrWhiteSpace(Model.CompanyName) ? "B2B" : Model.CompanyName.Substring(0, Math.Min(2, Model.CompanyName.Length)).ToUpperInvariant())
                        </div>
                        <div>
                            <div style="font-size: 0.86rem; font-weight: 700; color: #0F172A;">@Model.CompanyName</div>
                            <div style="font-size: 0.76rem; color: #64748B;">Yetkili: @Model.OfficialName · E-Posta: @Model.Email</div>
                        </div>
                    </div>
                    <span style="font-size: 0.74rem; color: #059669; background: #ECFDF5; border: 1px solid #A7F3D0; padding: 3px 9px; border-radius: 12px; font-weight: 600;">
                        Kayıtlı Kurumsal Profil
                    </span>
                </div>

                <div style="margin-top: 20px; display: flex; align-items: center; justify-content: flex-end;">
                    <button type="submit" id="btnSubmitFeedback" class="fb-submit-btn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <line x1="22" y1="2" x2="11" y2="13"></line>
                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                        </svg>
                        <span>Geri Bildirimi İlet</span>
                    </button>
                </div>
            </form>
        </div>

        <!-- SAĞ: GEÇMİŞ BİLDİRİMLER & BİLGİ -->
        <div style="display: flex; flex-direction: column; gap: 20px;">
            <div class="fb-card">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                    <h3 class="fb-card-title" style="margin: 0;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="1 4 1 10 7 10"></polyline>
                            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                        </svg>
                        Önceki Bildirimleriniz
                    </h3>
                    <span class="fb-status-badge">
                        <span id="pastFeedbackCount">@(Model.PastFeedbacks?.Count ?? 0)</span> Kayıt
                    </span>
                </div>

                <div id="pastFeedbacksContainer" class="fb-past-list">
                    @if (Model.PastFeedbacks != null && Model.PastFeedbacks.Any())
                    {
                        foreach (var fb in Model.PastFeedbacks)
                        {
                            <div class="fb-item-card">
                                <div class="fb-item-top">
                                    <span class="fb-item-badge">@fb.Topic</span>
                                    <span class="fb-item-date">
                                        @(fb.FormDate.HasValue ? fb.FormDate.Value.ToString("dd.MM.yyyy HH:mm") : "-")
                                    </span>
                                </div>
                                <div class="fb-item-text">@fb.FormText</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div id="emptyPastState" class="fb-empty-state">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                            </svg>
                            <p style="margin: 0; font-size: 0.85rem; font-weight: 500;">Henüz kayıtlı bir geri bildiriminiz bulunmuyor.</p>
                            <p style="margin: 4px 0 0 0; font-size: 0.75rem; color: #94A3B8;">Sol taraftaki formu doldurarak ilk bildiriminizi gönderebilirsiniz.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- BİLGİ KARTI -->
            <div class="fb-card" style="background: #F8FAFC; border-color: #E2E8F0;">
                <h4 style="font-size: 0.92rem; font-weight: 700; color: #1E293B; margin: 0 0 8px 0; display: flex; align-items: center; gap: 8px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                    Nasıl Çalışır?
                </h4>
                <ul style="margin: 0; padding-left: 18px; font-size: 0.8rem; color: #64748B; line-height: 1.6;">
                    <li>Gönderilen tüm formlar Süper Admin kontrol paneline anlık olarak aktarılır.</li>
                    <li>Teknik arıza bildirimleri öncelikli olarak değerlendirilir.</li>
                    <li>Geri bildirimleriniz için gerek duyulduğunda profilinizdeki iletişim bilgileri üzerinden geri dönüş yapılır.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script>
    function selectRating(val) {
        document.getElementById('ratingInput').value = val;
        const btns = document.querySelectorAll('.fb-rating-btn');
        btns.forEach((b, idx) => {
            if (idx + 1 === val) {
                b.classList.add('active');
            } else {
                b.classList.remove('active');
            }
        });
    }

    document.getElementById('feedbackForm').addEventListener('submit', async function (e) {
        e.preventDefault();

        const submitBtn = document.getElementById('btnSubmitFeedback');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = 'İletiliyor...';

        try {
            const formData = new FormData(this);
            const response = await fetch(this.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            const result = await response.json();

            if (result.success) {
                // Toast göster
                const toast = document.getElementById('liveFeedbackToast');
                document.getElementById('liveFeedbackToastText').textContent = result.message;
                toast.style.display = 'flex';
                setTimeout(() => { toast.style.display = 'none'; }, 6000);

                // Listeye yeni kaydı ekle
                if (result.item) {
                    const emptyState = document.getElementById('emptyPastState');
                    if (emptyState) emptyState.remove();

                    const container = document.getElementById('pastFeedbacksContainer');
                    const newCard = document.createElement('div');
                    newCard.className = 'fb-item-card';
                    newCard.style.borderLeft = '3px solid #2563EB';
                    newCard.innerHTML = `
                        <div class="fb-item-top">
                            <span class="fb-item-badge">${escapeHtml(result.item.topic)}</span>
                            <span class="fb-item-date">${escapeHtml(result.item.date)}</span>
                        </div>
                        <div class="fb-item-text">${escapeHtml(result.item.text)}</div>
                    `;
                    container.insertBefore(newCard, container.firstChild);

                    const countElem = document.getElementById('pastFeedbackCount');
                    if (countElem) {
                        const current = parseInt(countElem.textContent || '0', 10);
                        countElem.textContent = (current + 1).toString();
                    }
                }

                // Mesaj ve konu alanını temizle
                document.getElementById('messageText').value = '';
                document.getElementById('subjectInput').value = '';
                document.getElementById('ratingInput').value = '';
                document.querySelectorAll('.fb-rating-btn').forEach(b => b.classList.remove('active'));
            } else {
                alert(result.message || 'Geri bildirim gönderilemedi.');
            }
        } catch (err) {
            console.error(err);
            alert('İstek gönderilirken bir iletişim hatası oluştu.');
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        }
    });

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }
</script>
