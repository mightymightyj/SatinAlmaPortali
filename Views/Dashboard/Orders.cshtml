@using satinalmaportali2.Helpers
@model satinalmaportali2.Models.BuyerOrdersViewModel
@{
    ViewData["Title"] = "Verilen Siparişlerim & Sevkiyat Takibi";
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
    ViewBag.DashboardRole = "Buyer";
}

<!-- ==================== SAYFA BAŞLIĞI ==================== -->
<div class="page-head">
    <div>
        <div style="display: flex; align-items: center; gap: 8px;">
            <h1>Verilen Siparişlerim & Sevkiyat Takibi</h1>
            <span class="status-badge badge-emerald" style="font-size: 0.75rem; padding: 3px 10px;">
                <span class="status-dot"></span> Canlı Takip
            </span>
        </div>
        <p>
            <span>@Model.CompanyName tarafından verilen kurumsal doğrudan satınalma siparişleri ve kargo durumları</span>
        </p>
    </div>

    <div style="display: flex; gap: 10px; align-items: center;">
        <a href="/#b2b-vitrin" class="btn-primary" style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none; padding: 10px 18px; font-size: 0.88rem; font-weight: 700;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            + Vitrinden Yeni Sipariş Ver
        </a>
    </div>
</div>

@if (TempData["PaymentSuccess"] != null)
{
    <div style="background: #ecfdf5; border: 1px solid #10b981; border-radius: 12px; padding: 16px 20px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; color: #065f46; box-shadow: 0 4px 6px -1px rgba(16, 185, 129, 0.1);">
        <div style="display: flex; align-items: center; gap: 12px;">
            <span style="font-size: 1.6rem;">🛡️</span>
            <div>
                <strong style="font-size: 0.98rem; display: block;">Ödeme Güvence Havuzunda Alındı!</strong>
                <span style="font-size: 0.88rem;">@TempData["PaymentSuccess"]</span>
            </div>
        </div>
        <button type="button" onclick="this.parentElement.remove()" style="background: none; border: none; font-size: 1.3rem; color: #065f46; cursor: pointer;">&times;</button>
    </div>
}

@if (TempData["PaymentError"] != null)
{
    <div style="background: #fef2f2; border: 1px solid #ef4444; border-radius: 12px; padding: 16px 20px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; color: #991b1b; box-shadow: 0 4px 6px -1px rgba(239, 68, 68, 0.1);">
        <div style="display: flex; align-items: center; gap: 12px;">
            <span style="font-size: 1.6rem;">⚠️</span>
            <div>
                <strong style="font-size: 0.98rem; display: block;">Ödeme İşlemi Bildirimi</strong>
                <span style="font-size: 0.88rem;">@TempData["PaymentError"]</span>
            </div>
        </div>
        <button type="button" onclick="this.parentElement.remove()" style="background: none; border: none; font-size: 1.3rem; color: #991b1b; cursor: pointer;">&times;</button>
    </div>
}

<!-- ==================== 4 BÜYÜK KPI KARTI ==================== -->
<section class="kpi-row" aria-label="Sipariş Göstergeleri" style="margin-bottom: 20px;">
    <!-- KPI 1: Toplam Sipariş -->
    <article class="card kpi-card">
        <div class="kpi-top">
            <span class="kpi-label">Toplam Verilen Sipariş</span>
            <span class="kpi-icon accent">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
            </span>
        </div>
        <p class="kpi-value">@Model.TotalOrderCount</p>
        <p class="kpi-delta is-good">
            <span>Kurumsal doğrudan satın alımlar</span>
        </p>
    </article>

    <!-- KPI 2: Toplam Satınalma Harcaması -->
    <article class="card kpi-card">
        <div class="kpi-top">
            <span class="kpi-label">Toplam Harcama Tutarı</span>
            <span class="kpi-icon good">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="1" x2="12" y2="23"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
            </span>
        </div>
        <p class="kpi-value">@Model.TotalSpent.ToString("N0", ChartHelper.Tr) ₺</p>
        <p class="kpi-delta is-good">
            <span>KDV dahil gerçekleşen siparişler</span>
        </p>
    </article>

    <!-- KPI 3: Yoldaki Sevkiyatlar -->
    <article class="card kpi-card">
        <div class="kpi-top">
            <span class="kpi-label">Yoldaki / Hazırlanan Sevkiyatlar</span>
            <span class="kpi-icon @(Model.ActiveShipmentCount > 0 ? "warn" : "accent")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
            </span>
        </div>
        <p class="kpi-value">@Model.ActiveShipmentCount</p>
        <p class="kpi-delta is-good">
            <span>Teslimat bekleyen siparişler</span>
        </p>
    </article>

    <!-- KPI 4: Tamamlanan / Teslim Alınanlar -->
    <article class="card kpi-card">
        <div class="kpi-top">
            <span class="kpi-label">Teslim Alınan Siparişler</span>
            <span class="kpi-icon good">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </span>
        </div>
        <p class="kpi-value">@Model.CompletedCount</p>
        <p class="kpi-delta is-good">
            <span>Mal kabulü tamamlanan alımlar</span>
        </p>
    </article>
</section>

<!-- ==================== FİLTRE & ARAMA ALANI ==================== -->
<div class="card card-flush-mobile p-3 sm:p-4 mb-3 sm:mb-5">
    <form method="get" asp-action="Orders" id="ordersFilterForm" onsubmit="event.preventDefault(); applyBuyerOrdersFilter(); return false;" class="flex flex-col sm:flex-row flex-wrap gap-3 items-stretch sm:items-center justify-between">
        <div class="flex flex-wrap gap-2.5 items-center flex-1 min-w-0">
            <div class="relative flex-1 min-w-0 w-full max-w-full sm:max-w-md">
                <input type="text" name="search" id="buyerOrderSearchInput" value="@Model.SearchQuery" class="form-control w-full" placeholder="Sipariş No, satıcı firma, ürün veya kargo takip no ara..." oninput="onBuyerOrderSearchInput(this.value)" style="padding-left: 36px; height: 42px; font-size: 0.88rem;" />
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" style="position: absolute; left: 12px; top: 13px; pointer-events: none;">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </div>
        </div>

        <nav class="year-filter status-grid-2x2 grid grid-cols-2 sm:flex sm:items-center gap-2 w-full sm:w-auto" aria-label="Sipariş durumu filtresi">
            <input type="hidden" name="status" id="selectedStatusInput" value="@(Model.SelectedStatus ?? "Tümü")" />
            <button type="button" class="year-pill w-full justify-center text-center @(string.IsNullOrEmpty(Model.SelectedStatus) || Model.SelectedStatus == "Tümü" ? "is-active" : "")" 
                    onclick="setStatusFilter('Tümü', this)">
                <span>Tümü</span>
                <span class="status-count-badge" id="buyerCountAll">@Model.TotalOrderCount</span>
            </button>
            <button type="button" class="year-pill w-full justify-center text-center @(Model.SelectedStatus == "Onaylandı" ? "is-active" : "")" 
                    onclick="setStatusFilter('Onaylandı', this)">
                <span class="status-indicator-dot dot-blue"></span>
                <span>Onaylandı</span>
            </button>
            <button type="button" class="year-pill w-full justify-center text-center @(Model.SelectedStatus == "Kargoya Verildi" ? "is-active" : "")" 
                    onclick="setStatusFilter('Kargoya Verildi', this)">
                <span class="status-indicator-dot dot-amber"></span>
                <span>Kargoda</span>
            </button>
            <button type="button" class="year-pill status-pill-in-stock w-full justify-center text-center @(Model.SelectedStatus == "Teslim Edildi" ? "is-active" : "")" 
                    onclick="setStatusFilter('Teslim Edildi', this)">
                <span class="status-indicator-dot dot-green"></span>
                <span>Teslim Edildi</span>
            </button>

            <button type="button" id="buyerClearFilterBtn" onclick="resetBuyerFilters()" class="btn-cancel col-span-2 sm:col-span-1 w-full sm:w-auto justify-center" style="display: @(!string.IsNullOrWhiteSpace(Model.SearchQuery) || (!string.IsNullOrWhiteSpace(Model.SelectedStatus) && Model.SelectedStatus != "Tümü") ? "inline-flex" : "none"); padding: 7px 12px; font-size: 0.82rem; border-radius: 8px; align-items: center; gap: 4px; cursor: pointer;">
                Temizle
            </button>
        </nav>
    </form>
</div>

<!-- ==================== SİPARİŞLER TABLOSU ==================== -->
<article class="card card-flush-mobile p-2 sm:p-5">
    <header class="card-head px-2.5 pt-1.5 pb-2.5 sm:px-0 sm:pt-0 sm:pb-3 border-b sm:border-b-0 border-slate-100 mb-2 sm:mb-4">
        <div class="head-with-icon">
            <span class="blue-accent-x">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
            </span>
            <h2 class="text-sm sm:text-base font-bold text-slate-900">Sipariş Geçmişi & Sevkiyat Takibi (@Model.Orders.Count)</h2>
        </div>
    </header>

    <!-- Desktop Tablo Görünümü (md ve üzeri ekranlar) -->
    <div class="hidden md:block table-scroll-wrap">
        <table class="dash-table">
            <thead>
                <tr>
                    <th>Sipariş No & Tarih</th>
                    <th>Satıcı Tedarikçi</th>
                    <th>Ürünler / Kalemler</th>
                    <th>Toplam Tutar</th>
                    <th>Ödeme Şekli</th>
                    <th>Durum & Kargo</th>
                    <th class="text-right">Aksiyon</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Orders.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 48px 16px; color: var(--muted);">
                            <div style="margin-bottom: 12px;">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                            </div>
                            <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 6px; color: var(--text);">Henüz verilmiş bir siparişiniz bulunmamaktadır</h3>
                            <p style="font-size: 0.85rem; margin-bottom: 16px;">B2B kurumsal vitrinimizdeki hazır stoklu ürünleri doğrudan sepetinize ekleyip satın alabilirsiniz.</p>
                            <a href="/#b2b-vitrin" class="btn-primary" style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none; margin: 0 auto;">
                                Vitrine Git & Alışverişe Başla
                            </a>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var o in Model.Orders)
                    {
                        var activeItems = o.OrderItems.Where(oi => oi.ItemStatus != "İptal" && oi.ItemStatus != "İptal Edildi").ToList();
                        bool allDelivered = (activeItems.Any() && activeItems.All(oi => oi.ItemStatus == "Teslim Edildi" || oi.ItemStatus == "Tamamlandı")) || o.OrderStatus == "Teslim Edildi";
                        bool partialDelivered = !allDelivered && activeItems.Any(oi => oi.ItemStatus == "Teslim Edildi");
                        int deliveredCount = activeItems.Count(oi => oi.ItemStatus == "Teslim Edildi" || oi.ItemStatus == "Tamamlandı");
                        int totalActiveCount = activeItems.Count;

                        var isPreparing = o.OrderStatus == "Hazırlanıyor";
                        var isShipped = o.OrderStatus == "Kargoya Verildi" || (activeItems.Any(oi => oi.ItemStatus == "Kargoya Verildi"));
                        var isDelivered = allDelivered;
                        var isCompleted = o.OrderStatus == "Tamamlandı";
                        var isCancelled = o.OrderStatus == "İptal" || o.OrderStatus == "İptal Edildi" || o.OrderStatus.Contains("İptal");
                        var searchableText = $"{o.OrderNumber} {o.SupplierCompanyName} {o.DeliveryCity} {o.TrackingNumber} {string.Join(" ", o.OrderItems.Select(oi => oi.ProductName))}".ToLowerInvariant();

                        var distinctSellers = o.OrderItems
                            .Where(oi => !string.IsNullOrWhiteSpace(oi.SupplierCompanyName))
                            .GroupBy(oi => (oi.SupplierCompanyID ?? 0, oi.SupplierCompanyName!.Trim()))
                            .Select(g => new
                            {
                                CompanyId = g.Key.Item1,
                                CompanyName = g.Key.Item2,
                                ItemCount = g.Count()
                            })
                            .ToList();

                        if (!distinctSellers.Any() && !string.IsNullOrWhiteSpace(o.SupplierCompanyName))
                        {
                            distinctSellers.Add(new
                            {
                                CompanyId = o.SupplierCompanyID ?? 0,
                                CompanyName = o.SupplierCompanyName.Trim(),
                                ItemCount = o.OrderItems.Count
                            });
                        }

                        <tr id="buyer-order-row-@o.OrderID" data-order-id="@o.OrderID" data-status="@o.OrderStatus" data-search="@searchableText">
                            <td>
                                <div class="req-title-cell">
                                    <strong style="font-size: 0.92rem; color: var(--text);">@o.OrderNumber</strong>
                                    <small class="req-code">@o.OrderDate.ToString("dd.MM.yyyy HH:mm")</small>
                                </div>
                            </td>
                            <td>
                                @if (distinctSellers.Count > 1)
                                {
                                    <div style="display: flex; flex-direction: column; gap: 4px;">
                                        @foreach (var s in distinctSellers)
                                        {
                                            <div style="font-size: 0.82rem; font-weight: 700; color: #0f172a;">
                                                @s.CompanyName
                                                @if (s.CompanyId > 0)
                                                {
                                                    <a href="/Seller/@s.CompanyId" target="_blank" style="font-size: 0.72rem; color: #2563eb; margin-left: 4px;" title="Satıcı Profili">↗</a>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    var single = distinctSellers.FirstOrDefault();
                                    var sellerName = single?.CompanyName ?? o.SupplierCompanyName ?? "Onaylı Tedarikçi";
                                    var sellerId = single?.CompanyId ?? o.SupplierCompanyID;

                                    <strong>@sellerName</strong>
                                    <div style="font-size: 0.75rem; color: var(--muted);">@o.DeliveryCity</div>
                                }
                            </td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 2px;">
                                    @foreach (var item in o.OrderItems.Take(2))
                                    {
                                        <span style="font-size: 0.82rem; font-weight: 600;">
                                            • @item.ProductName <small style="color: var(--muted);">(@item.Quantity Adet)</small>
                                        </span>
                                    }
                                    @if (o.OrderItems.Count > 2)
                                    {
                                        <small style="color: var(--accent); font-weight: 600;">+ @(o.OrderItems.Count - 2) diğer kalem...</small>
                                    }
                                </div>
                            </td>
                            <td>
                                <strong style="font-size: 0.95rem; color: var(--text);">@o.GrandTotal.ToString("N2", ChartHelper.Tr) ₺</strong>
                                <div style="font-size: 0.72rem; color: var(--muted);">KDV Dahil</div>
                            </td>
                            <td>
                                <span style="font-size: 0.82rem; font-weight: 600; color: var(--text);">@o.PaymentMethod</span>
                                <div style="display: flex; gap: 4px; flex-wrap: wrap; margin-top: 3px;">
                                    @if (o.EscrowStatus == "InEscrow")
                                    {
                                        <span class="status-badge" style="background:#f0fdf4; color:#166534; border:1px solid #bbf7d0; font-size:0.68rem; padding:2px 6px;">🛡️ Havuzda Bloke</span>
                                    }
                                    else if (o.EscrowStatus == "Released_ToSeller")
                                    {
                                        <span class="status-badge badge-emerald" style="font-size:0.68rem; padding:2px 6px;">✓ Aktarıldı</span>
                                    }
                                    else if (o.EscrowStatus == "Disputed")
                                    {
                                        <span class="status-badge badge-amber" style="font-size:0.68rem; padding:2px 6px;">⚠️ İtirazda</span>
                                    }
                                    else if (o.EscrowStatus == "Refunded")
                                    {
                                        <span class="status-badge" style="background:#fef2f2; color:#991b1b; border:1px solid #fecaca; font-size:0.68rem; padding:2px 6px;">↩️ İade Edildi</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge badge-emerald" style="font-size: 0.68rem; padding: 2px 6px;">@o.PaymentStatus</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div>
                                    <span class="status-badge @(isCancelled ? "" : (isDelivered ? "badge-emerald" : (isShipped ? "badge-amber" : "badge-blue")))" style="font-size: 0.78rem; padding: 3px 8px; @(isCancelled ? "background:#fef2f2; color:#991b1b; border:1px solid #fecaca;" : "")">
                                        <span class="status-dot" style="@(isCancelled ? "background:#dc2626;" : "")"></span>
                                        @o.OrderStatus
                                    </span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(o.TrackingNumber) && !isCancelled)
                                {
                                    <div style="font-size: 0.75rem; margin-top: 4px; color: var(--muted);">
                                        <strong>@o.ShippingCarrier:</strong> @o.TrackingNumber
                                    </div>
                                }
                            </td>
                            <td class="text-right">
                                <div style="display: flex; flex-direction: column; gap: 5px; align-items: flex-end;" id="buyer-actions-wrap-@o.OrderID">
                                    @if (allDelivered && !isCompleted && !isCancelled)
                                    {
                                        <!-- Teslim Edildi: Teslim aldım tuşu AKTİF! -->
                                        <button type="button" class="btn-primary" style="font-size: 0.78rem; padding: 6px 12px; border-radius: 7px; font-weight: 750; background: #16a34a; border: none; cursor: pointer; box-shadow: 0 2px 6px rgba(22,163,74,0.3); color: #fff;" onclick="confirmReleaseEscrowDirect(@o.OrderID, '@Html.Raw(o.OrderNumber)')">
                                            @(distinctSellers.Count > 1 ? $"✓ Tümünü Teslim Aldım ({distinctSellers.Count} Satıcı)" : "✓ Teslim Aldım")
                                        </button>
                                    }
                                    else if (partialDelivered && !isCompleted && !isCancelled)
                                    {
                                        <!-- Kısmi Teslimat: Bazı satıcılar teslim etti ama diğerleri yolda -->
                                        <span class="status-badge badge-amber" style="font-size: 0.73rem; padding: 4px 8px; font-weight: 700; border-radius: 6px;" title="Bu siparişteki satıcılardan bazıları teslimatı gerçekleştirdi, diğerleri bekleniyor.">
                                            ⏳ Kısmi Teslim (@deliveredCount/@totalActiveCount)
                                        </span>
                                    }
                                    else if (!isShipped && !allDelivered && !isCompleted && !isCancelled)
                                    {
                                        <!-- Onaylandı veya Hazırlanıyor: Alıcı iptal edebilir -->
                                        <button type="button" style="font-size: 0.74rem; padding: 4px 8px; border-radius: 6px; font-weight: 600; background: #fff; color: #dc2626; border: 1px solid #fecaca; cursor: pointer;" onclick="openBuyerCancelModal(@o.OrderID, '@Html.Raw(o.OrderNumber)')">
                                            ✕ İptal Et
                                        </button>
                                    }
                                    @if ((allDelivered || isCompleted) && !isCancelled)
                                    {
                                        var primarySellerName = o.SupplierCompanyName ?? (o.OrderItems.FirstOrDefault()?.SupplierCompanyName ?? "Satıcı Firma");
                                        var primarySellerId = o.SupplierCompanyID ?? o.OrderItems.FirstOrDefault(oi => oi.SupplierCompanyID.HasValue)?.SupplierCompanyID;
                                        <button type="button" class="btn-primary" style="font-size: 0.76rem; padding: 5px 10px; border-radius: 6px; font-weight: 700; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border: none; cursor: pointer; color: #fff; box-shadow: 0 2px 5px rgba(245,158,11,0.25);" onclick="openBuyerReviewModalForOrder(@o.OrderID, '@Html.Raw(primarySellerName?.Replace("'", "\\'"))', @(primarySellerId.HasValue ? primarySellerId.Value.ToString() : "null"))">
                                            ★ Satıcıyı Değerlendir
                                        </button>
                                    }
                                    <button type="button" class="btn-table-action" style="font-size: 0.8rem; padding: 5px 12px; border-radius: 7px; font-weight: 600;" onclick="showOrderDetailsModal(@o.OrderID)">
                                        Detay Gör
                                    </button>
                                </div>
                            </td>
                        </tr>

                        <script>
                            window.ordersDataMap = window.ordersDataMap || {};
                            window.ordersDataMap[@o.OrderID] = {
                                orderId: @o.OrderID,
                                orderNumber: '@Html.Raw(o.OrderNumber)',
                                orderDate: '@Html.Raw(o.OrderDate.ToString("dd MMMM yyyy, HH:mm"))',
                                grandTotal: '@Html.Raw(o.GrandTotal.ToString("N2", ChartHelper.Tr)) ₺',
                                totalAmount: '@Html.Raw(o.TotalAmount.ToString("N2", ChartHelper.Tr)) ₺',
                                taxAmount: '@Html.Raw(o.TaxAmount.ToString("N2", ChartHelper.Tr)) ₺',
                                orderStatus: '@Html.Raw(o.OrderStatus)',
                                paymentMethod: '@Html.Raw(o.PaymentMethod)',
                                paymentStatus: '@Html.Raw(o.PaymentStatus)',
                                escrowStatus: '@Html.Raw(o.EscrowStatus)',
                                isEscrowApproved: @(o.IsEscrowApproved ? "true" : "false"),
                                deliveryCity: '@Html.Raw(o.DeliveryCity)',
                                deliveryAddress: '@Html.Raw(o.DeliveryAddress?.Replace("'", "\\'").Replace("\r", "").Replace("\n", " "))',
                                receiverName: '@Html.Raw(o.ReceiverName?.Replace("'", "\\'"))',
                                receiverPhone: '@Html.Raw(o.ReceiverPhone)',
                                trackingNumber: '@Html.Raw(o.TrackingNumber)',
                                shippingCarrier: '@Html.Raw(o.ShippingCarrier)',
                                distinctSellerCount: @distinctSellers.Count,
                                items: [
                                    @foreach (var item in o.OrderItems)
                                    {
                                        var itemSellerName = item.SupplierCompanyName ?? o.SupplierCompanyName ?? "Onaylı Tedarikçi";
                                        var itemSellerId = item.SupplierCompanyID ?? o.SupplierCompanyID ?? 0;
                                        var itemStatus = !string.IsNullOrWhiteSpace(item.ItemStatus) ? item.ItemStatus : o.OrderStatus;
                                        var itemTracking = !string.IsNullOrWhiteSpace(item.TrackingNumber) ? item.TrackingNumber : (o.TrackingNumber ?? "");
                                        var itemCarrier = !string.IsNullOrWhiteSpace(item.ShippingCarrier) ? item.ShippingCarrier : (o.ShippingCarrier ?? "");
                                        <text>{
                                            orderItemId: @item.OrderItemID,
                                            productName: '@Html.Raw(item.ProductName.Replace("'", "\\'"))',
                                            sku: '@Html.Raw(item.Sku ?? "SKU-B2B")',
                                            categoryName: '@Html.Raw(item.CategoryName ?? "Endüstriyel")',
                                            quantity: @item.Quantity,
                                            unitPrice: '@Html.Raw(item.UnitPrice.ToString("N2", ChartHelper.Tr)) ₺',
                                            lineTotal: '@Html.Raw(item.LineTotal.ToString("N2", ChartHelper.Tr)) ₺',
                                            supplierName: '@Html.Raw(itemSellerName.Replace("'", "\\'"))',
                                            supplierCompanyId: @itemSellerId,
                                            status: '@Html.Raw(itemStatus)',
                                            trackingNumber: '@Html.Raw(itemTracking)',
                                            shippingCarrier: '@Html.Raw(itemCarrier)'
                                        },</text>
                                    }
                                ]
                            };
                        </script>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Mobil Kompakt Sipariş Listesi (Genişletilmiş liste elemanları, basıldığında detay modalı) -->
    <div class="block md:hidden p-0 space-y-2.5" id="buyerOrdersMobileList">
        @if (!Model.Orders.Any())
        {
            <div class="text-center py-10 px-4 text-slate-400">
                <div class="mb-3 flex justify-center text-slate-300">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                </div>
                <div class="text-sm font-bold text-slate-700 mb-1">Henüz verilmiş bir siparişiniz bulunmamaktadır</div>
                <p class="text-xs text-slate-500 mb-3">B2B kurumsal vitrinimizdeki hazır stoklu ürünleri doğrudan sepetinize ekleyip satın alabilirsiniz.</p>
                <a href="/#b2b-vitrin" class="btn-primary inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700">
                    Vitrine Git &amp; Alışverişe Başla
                </a>
            </div>
        }
        else
        {
            @foreach (var o in Model.Orders)
            {
                var activeItems = o.OrderItems.Where(oi => oi.ItemStatus != "İptal" && oi.ItemStatus != "İptal Edildi").ToList();
                bool allDelivered = (activeItems.Any() && activeItems.All(oi => oi.ItemStatus == "Teslim Edildi" || oi.ItemStatus == "Tamamlandı")) || o.OrderStatus == "Teslim Edildi";
                var isShipped = o.OrderStatus == "Kargoya Verildi" || (activeItems.Any(oi => oi.ItemStatus == "Kargoya Verildi"));
                var isCancelled = o.OrderStatus == "İptal" || o.OrderStatus == "İptal Edildi" || o.OrderStatus.Contains("İptal");
                var searchableText = $"{o.OrderNumber} {o.SupplierCompanyName} {o.DeliveryCity} {o.TrackingNumber} {string.Join(" ", o.OrderItems.Select(oi => oi.ProductName))}".ToLowerInvariant();

                var distinctSellers = o.OrderItems
                    .Where(oi => !string.IsNullOrWhiteSpace(oi.SupplierCompanyName))
                    .GroupBy(oi => (oi.SupplierCompanyID ?? 0, oi.SupplierCompanyName!.Trim()))
                    .Select(g => new { CompanyId = g.Key.Item1, CompanyName = g.Key.Item2, ItemCount = g.Count() })
                    .ToList();

                if (!distinctSellers.Any() && !string.IsNullOrWhiteSpace(o.SupplierCompanyName))
                {
                    distinctSellers.Add(new { CompanyId = o.SupplierCompanyID ?? 0, CompanyName = o.SupplierCompanyName.Trim(), ItemCount = o.OrderItems.Count });
                }

                string sellerDisplay = distinctSellers.Count > 1 
                    ? $"{distinctSellers.First().CompanyName} (+{distinctSellers.Count - 1} Satıcı)" 
                    : (distinctSellers.FirstOrDefault()?.CompanyName ?? o.SupplierCompanyName ?? "Onaylı Tedarikçi");

                var firstItem = o.OrderItems.FirstOrDefault();
                int otherItemsCount = o.OrderItems.Count - 1;

                var badgeClass = isCancelled ? "bg-rose-50 text-rose-700 border-rose-200/80"
                    : (allDelivered ? "bg-emerald-50 text-emerald-700 border-emerald-200/80"
                    : (isShipped ? "bg-amber-50 text-amber-700 border-amber-200/80"
                    : "bg-blue-50 text-blue-700 border-blue-200/80"));

                <div class="mobile-order-card w-full bg-white rounded-xl border border-slate-200/90 p-3.5 sm:p-4 shadow-2xs hover:border-blue-300 hover:shadow-xs active:scale-[0.99] transition cursor-pointer flex flex-col gap-2.5"
                     id="buyer-mobile-order-@o.OrderID"
                     data-order-id="@o.OrderID"
                     data-status="@o.OrderStatus"
                     data-search="@searchableText"
                     onclick="showOrderDetailsModal(@o.OrderID)">
                    
                    <!-- 1. Satır: Sipariş No, Tarih & Durum Rozeti -->
                    <div class="flex items-center justify-between gap-2">
                        <div class="flex items-center gap-1.5 min-w-0">
                            <span class="font-mono text-xs sm:text-[13px] font-bold text-blue-600 truncate">@o.OrderNumber</span>
                            <span class="text-[11px] text-slate-400 shrink-0">• @o.OrderDate.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                        <span class="status-badge shrink-0 inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold border @badgeClass">
                            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                            @o.OrderStatus
                        </span>
                    </div>

                    <!-- 2. Satır: Satıcı ve Kargo Takip Rozeti -->
                    <div class="flex items-center justify-between gap-2 text-xs">
                        <div class="flex items-center gap-1.5 min-w-0 text-slate-600">
                            <span class="text-[11px] text-slate-400 shrink-0">Satıcı:</span>
                            <strong class="text-slate-800 font-semibold truncate">@sellerDisplay</strong>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(o.TrackingNumber) && !isCancelled)
                        {
                            <span class="text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200/70 shrink-0 flex items-center gap-1">
                                <span>📦</span> <span>Takipte</span>
                            </span>
                        }
                    </div>

                    <!-- 3. Satır: Kalem / Ürün Özeti -->
                    @if (firstItem != null)
                    {
                        <div class="text-xs text-slate-600 truncate">
                            <span class="font-semibold text-slate-800">• @firstItem.ProductName</span>
                            <span class="text-slate-400 text-[11px]">(@firstItem.Quantity Adet)</span>
                            @if (otherItemsCount > 0)
                            {
                                <span class="text-blue-600 font-semibold text-[11px]"> +@otherItemsCount diğer kalem</span>
                            }
                        </div>
                    }

                    <!-- 4. Satır: Toplam Tutar & Detay Butonu -->
                    <div class="flex items-center justify-between pt-2.5 border-t border-slate-100 mt-0.5">
                        <div class="flex items-baseline gap-1.5">
                            <strong class="text-[15px] font-black text-emerald-600 tracking-tight">@o.GrandTotal.ToString("N2", ChartHelper.Tr) ₺</strong>
                            <span class="text-[11px] text-slate-400 font-normal">(KDV Dahil)</span>
                        </div>
                        <span class="inline-flex items-center gap-1 text-xs font-bold text-blue-600 hover:text-blue-700 bg-blue-50/60 px-2.5 py-1 rounded-lg">
                            Detay Gör
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </span>
                    </div>
                </div>
            }

            <div id="buyerOrdersMobileEmptySearch" style="display: none;" class="text-center py-8 text-slate-400 text-xs">
                <strong class="text-slate-700 block mb-1">Arama veya filtre kriterinize uygun sipariş bulunamadı.</strong>
                <span>Filtreyi temizleyebilir veya farklı bir arama kelimesi deneyebilirsiniz.</span>
            </div>
        }
    </div>
</article>

<!-- Modal: Kapsamlı Sipariş Detayı (Her Ürünün ve Satıcının Durumu Ayrı) -->
<div id="buyerOrderDetailModal" class="ty-modal-overlay fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-3 sm:p-6 md:p-8 overflow-y-auto" style="display: none;" onclick="if(event.target===this)closeOrderDetailModal()">
    <div class="ty-modal-box my-auto relative bg-white rounded-2xl shadow-2xl border border-slate-200/90 w-full max-w-2xl max-h-[92vh] sm:max-h-[88vh] flex flex-col overflow-hidden transform transition-all">
        
        <!-- Modal Başlık Çubuğu -->
        <div class="px-4 pt-4 pb-3.5 sm:px-7 sm:pt-7 sm:pb-5 border-b border-slate-100 flex items-start justify-between bg-slate-50/80">
            <div>
                <div class="flex items-center gap-2 flex-wrap mb-2">
                    <span class="status-badge badge-emerald text-[11px] font-bold px-2 py-0.5 rounded-md">KURUMSAL SİPARİŞ</span>
                    <span id="modalOverallBadge" class="status-badge badge-blue text-[11px] font-bold px-2 py-0.5 rounded-md"></span>
                </div>
                <h3 id="modalOrderNo" class="text-lg font-extrabold text-slate-900 font-mono tracking-tight"></h3>
                <div class="text-xs text-slate-500 mt-1" id="modalOrderDate"></div>
            </div>
            <button type="button" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-200/60 transition-colors cursor-pointer text-base leading-none shrink-0 ml-4 -mt-1 -mr-1" onclick="closeOrderDetailModal()" aria-label="Kapat">✕</button>
        </div>

        <!-- Modal Kaydırılabilir Gövde -->
        <div class="p-4 sm:p-6 overflow-y-auto space-y-3.5 sm:space-y-4 text-xs">
            
            <!-- Çoklu Satıcı Bilgilendirme Kutusu -->
            <div id="modalMultiSellerAlert" class="hidden p-3.5 bg-blue-50/80 border border-blue-200/80 rounded-xl text-xs text-blue-900 leading-relaxed"></div>

            <!-- Ürünler ve Durumları Bölümü -->
            <div>
                <div class="flex justify-between items-center mb-2.5">
                    <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wide">
                        Sipariş Kalemleri &amp; Ürün Bazlı Durumlar
                    </h4>
                    <span class="text-[11px] text-slate-500 font-medium" id="modalItemCountText"></span>
                </div>

                <div id="modalOrderItemsList" class="space-y-2.5">
                    <!-- JS Tarafından doldurulacak -->
                </div>
            </div>

            <!-- iyzico B2B Güvenli Havuz (Escrow) ve Onay Kutusu -->
