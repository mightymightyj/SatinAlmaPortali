                <div class="flex justify-between items-start flex-wrap gap-2">
                    <div class="flex items-center gap-2.5">
                        <span class="text-xl">🛡️</span>
                        <div>
                            <strong class="text-xs font-bold text-emerald-900 block">iyzico Güvenli Havuz (Escrow) Durumu</strong>
                            <span class="text-[11px] text-emerald-700 leading-tight block" id="modalEscrowStatusText">Ödeme güvence havuzunda bloke tutulmaktadır.</span>
                        </div>
                    </div>
                    <span id="modalEscrowBadge" class="status-badge bg-emerald-100 text-emerald-800 font-bold text-[11px] px-2.5 py-1 rounded-md"></span>
                </div>

                <div id="modalEscrowActions" class="flex gap-2 flex-wrap pt-2.5 border-t border-dashed border-emerald-300/80">
                    <button type="button" id="btnReleaseEscrow" class="btn-primary inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 shadow-xs shadow-emerald-600/20 transition cursor-pointer" onclick="confirmReleaseEscrow()">
                        <span>✓ Ürünü Teslim Aldım &amp; Ödemeyi Satıcıya Aktar</span>
                    </button>
                    <button type="button" id="btnOpenDispute" class="btn-cancel inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-semibold bg-white border border-rose-300 text-rose-700 hover:bg-rose-50 transition cursor-pointer" onclick="openDisputeModalFromDetail()">
                        <span>⚠️ İade / İtiraz Bildir</span>
                    </button>
                    <button type="button" id="btnCancelFromDetail" class="btn-cancel inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-semibold bg-white border border-rose-300 text-rose-700 hover:bg-rose-50 transition cursor-pointer hidden" onclick="openBuyerCancelModalFromDetail()">
                        <span>✕ Siparişi İptal Et</span>
                    </button>
                </div>
            </div>

            <!-- Teslimat & İletişim Bilgileri -->
            <div class="p-3.5 sm:p-4 bg-slate-50 border border-slate-200/80 rounded-xl space-y-2">
                <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wide">Teslimat ve Alıcı Bilgileri</h4>
                <div class="text-xs text-slate-600 space-y-1">
                    <div><strong class="font-semibold text-slate-800">Alıcı:</strong> <span id="modalReceiverInfo" class="text-slate-700"></span></div>
                    <div><strong class="font-semibold text-slate-800">Teslimat Adresi:</strong> <span id="modalDeliveryAddress" class="text-slate-700"></span></div>
                    <div><strong class="font-semibold text-slate-800">Ödeme Şekli:</strong> <span id="modalPaymentMethod" class="text-slate-700"></span></div>
                </div>
            </div>

            <!-- Finansal Özet -->
            <div class="p-3.5 sm:p-4 bg-emerald-50/50 border border-emerald-200/80 rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
                <div>
                    <span class="text-[11px] font-bold uppercase tracking-wide text-slate-500">Toplam Ödenen Tutar (KDV Dahil)</span>
                    <div id="modalGrandTotal" class="text-xl font-black text-emerald-600 tracking-tight"></div>
                </div>
                <div class="sm:text-right text-xs text-slate-500 space-y-0.5 pt-2 sm:pt-0 border-t sm:border-t-0 border-emerald-200/60">
                    <div>Ara Toplam: <strong id="modalSubTotal" class="text-slate-800 font-bold"></strong></div>
                    <div>KDV (%20): <strong id="modalTaxTotal" class="text-slate-800 font-bold"></strong></div>
                </div>
            </div>

        </div>

        <!-- Modal Alt Çubuk -->
        <div class="px-4 sm:px-6 py-3 border-t border-slate-100 bg-slate-50/80 flex justify-end">
            <button type="button" class="btn-cancel px-4 py-2 rounded-lg text-xs font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 transition shadow-2xs cursor-pointer" onclick="closeOrderDetailModal()">Kapat</button>
        </div>
    </div>
</div>

<!-- Modal: İade ve Uyuşmazlık (Dispute) Bildirimi -->
<div id="orderDisputeModal" class="ty-modal-overlay fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4 sm:p-6 md:p-8 overflow-y-auto" style="display: none;" onclick="if(event.target===this)closeDisputeModal()">
    <div class="ty-modal-box my-auto relative bg-white rounded-2xl shadow-2xl border border-slate-200/90 w-full max-w-lg max-h-[88vh] overflow-hidden transform transition-all">
        <div class="px-6 pt-6 pb-5 sm:px-7 sm:pt-7 sm:pb-5 border-b border-slate-100 flex items-start justify-between bg-slate-50/80">
            <div>
                <div class="mb-2">
                    <span class="status-badge bg-rose-50 text-rose-700 border border-rose-200 text-[11px] font-bold px-2 py-0.5 rounded-md">HAVUZ KORUMASI / İADE TALEBİ</span>
                </div>
                <h3 class="text-base font-extrabold text-slate-900">Sipariş İade &amp; İtiraz Talebi</h3>
                <p class="text-xs text-slate-500 mt-1">Talebiniz incelenene kadar havuzdaki ödeme satıcıya aktarılmaz, bloke devam eder.</p>
            </div>
            <button type="button" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-200/60 transition-colors cursor-pointer text-base leading-none shrink-0 ml-4 -mt-1 -mr-1" onclick="closeDisputeModal()" aria-label="Kapat">✕</button>
        </div>

        <form id="disputeForm" onsubmit="submitDisputeForm(event)">
            <input type="hidden" id="disputeOrderID" />
            
            <div class="p-6 space-y-4 text-xs">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5" for="disputeReason">İtiraz / İade Nedeni <span class="text-rose-500 font-bold">*</span></label>
                    <select id="disputeReason" class="form-control w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all" required>
                        <option value="Ayıplı / Kusurlu Ürün">Ayıplı / Kusurlu Ürün</option>
                        <option value="Yanlış Ürün Gönderimi">Yanlış Ürün Gönderimi</option>
                        <option value="Eksik Adet / Parça Teslimatı">Eksik Adet / Parça Teslimatı</option>
                        <option value="Kargo Hasarı">Kargo Sırasında Hasar Görmüş</option>
                        <option value="Ürün Teslim Edilmedi">Kargo Ulaşmadı / Teslim Edilmedi</option>
                        <option value="Diğer Şartname Uyumsuzluğu">Diğer Teknik Şartname Uyumsuzluğu</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5" for="disputeDescription">Detaylı Açıklama <span class="text-rose-500 font-bold">*</span></label>
                    <textarea id="disputeDescription" class="form-control w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all" rows="4" placeholder="Üründeki sorunu, sevk irsaliyesi veya hasar detayını açıklayınız..." required></textarea>
                </div>
            </div>

            <div class="px-6 py-3.5 border-t border-slate-100 bg-slate-50/80 flex items-center justify-end gap-2.5">
                <button type="button" class="btn-cancel px-4 py-2 rounded-lg text-xs font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 transition shadow-2xs cursor-pointer" onclick="closeDisputeModal()">Vazgeç</button>
                <button type="submit" id="btnSubmitDispute" class="btn-primary px-4.5 py-2 rounded-lg text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 shadow-xs shadow-rose-600/20 transition cursor-pointer">
                    İtirazı Kaydet &amp; Havuzu Dondur
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Alıcı Gerekçeli Sipariş İptali -->
<div id="buyerCancelOrderModal" class="ty-modal-overlay fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4 sm:p-6 md:p-8 overflow-y-auto" style="display: none;" onclick="if(event.target===this)closeBuyerCancelModal()">
