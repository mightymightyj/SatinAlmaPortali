@using satinalmaportali2.Helpers
@model satinalmaportali2.Models.BuyerOrdersViewModel
@{
    ViewData["Title"] = "Verilen Siparişlerim & Sevkiyat Takibi";
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
    ViewBag.DashboardRole = "Buyer";
}

<!-- ==================== SAYFA BAŞLIĞI ==================== -->
<div class="page-head">
    <div>
        <div style="display: flex; align-items: center; gap: 8px;">
            <h1>Verilen Siparişlerim & Sevkiyat Takibi</h1>
            <span class="status-badge badge-emerald" style="font-size: 0.75rem; padding: 3px 10px;">
                <span class="status-dot"></span> Canlı Takip
            </span>
        </div>
        <p>
            <span>@Model.CompanyName tarafından verilen kurumsal doğrudan satınalma siparişleri ve kargo durumları</span>
        </p>
    </div>

    <div style="display: flex; gap: 10px; align-items: center;">
        <a href="/#b2b-vitrin" class="btn-primary" style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none; padding: 10px 18px; font-size: 0.88rem; font-weight: 700;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            + Vitrinden Yeni Sipariş Ver
        </a>
    </div>
</div>

<!-- ==================== 4 BÜYÜK KPI KARTI ==================== -->
<section class="kpi-row" aria-label="Sipariş Göstergeleri" style="margin-bottom: 20px;">
    <!-- KPI 1: Toplam Sipariş -->
    <article class="card kpi-card">
        <div class="kpi-top">
            <span class="kpi-label">Toplam Verilen Sipariş</span>
            <span class="kpi-icon accent">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
            </span>
        </div>
        <p class="kpi-value">@Model.TotalOrderCount</p>
        <p class="kpi-delta is-good">
            <span>Kurumsal doğrudan satın alımlar</span>
        </p>
    </article>

    <!-- KPI 2: Toplam Satınalma Harcaması -->
    <article class="card kpi-card">
        <div class="kpi-top">
            <span class="kpi-label">Toplam Harcama Tutarı</span>
            <span class="kpi-icon good">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="1" x2="12" y2="23"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
            </span>
        </div>
        <p class="kpi-value">@Model.TotalSpent.ToString("N0", ChartHelper.Tr) ₺</p>
        <p class="kpi-delta is-good">
            <span>KDV dahil gerçekleşen siparişler</span>
        </p>
    </article>

    <!-- KPI 3: Yoldaki Sevkiyatlar -->
    <article class="card kpi-card">
        <div class="kpi-top">
            <span class="kpi-label">Yoldaki / Hazırlanan Sevkiyatlar</span>
            <span class="kpi-icon @(Model.ActiveShipmentCount > 0 ? "warn" : "accent")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
            </span>
        </div>
        <p class="kpi-value">@Model.ActiveShipmentCount</p>
        <p class="kpi-delta is-good">
            <span>Teslimat bekleyen siparişler</span>
        </p>
    </article>

    <!-- KPI 4: Tamamlanan / Teslim Alınanlar -->
    <article class="card kpi-card">
        <div class="kpi-top">
            <span class="kpi-label">Teslim Alınan Siparişler</span>
            <span class="kpi-icon good">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </span>
        </div>
        <p class="kpi-value">@Model.CompletedCount</p>
        <p class="kpi-delta is-good">
            <span>Mal kabulü tamamlanan alımlar</span>
        </p>
    </article>
</section>

<!-- ==================== FİLTRE & ARAMA ALANI ==================== -->
<div class="card" style="margin-bottom: 20px; padding: 16px 20px;">
    <form method="get" asp-action="Orders" id="ordersFilterForm" style="display: flex; flex-wrap: wrap; gap: 14px; align-items: center; justify-content: space-between;">
        <div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center; flex: 1; min-width: 300px;">
            <div style="position: relative; flex: 1; min-width: 240px; max-width: 420px;">
                <input type="text" name="search" value="@Model.SearchQuery" class="form-control" placeholder="Sipariş No, ürün veya kargo takip no ara..." style="padding-left: 36px; height: 40px; font-size: 0.88rem;" />
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" style="position: absolute; left: 12px; top: 12px; pointer-events: none;">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </div>
        </div>

        <div style="display: flex; gap: 6px; align-items: center;">
            <input type="hidden" name="status" id="selectedStatusInput" value="@(Model.SelectedStatus ?? "Tümü")" />
            <button type="button" class="btn-tree-tool @(string.IsNullOrEmpty(Model.SelectedStatus) || Model.SelectedStatus == "Tümü" ? "is-active" : "")" 
                    onclick="setStatusFilter('Tümü')" style="padding: 7px 14px; font-size: 0.82rem; font-weight: 600; border-radius: 6px;">
                Tümü (@Model.TotalOrderCount)
            </button>
            <button type="button" class="btn-tree-tool @(Model.SelectedStatus == "Onaylandı" ? "is-active" : "")" 
                    onclick="setStatusFilter('Onaylandı')" style="padding: 7px 14px; font-size: 0.82rem; font-weight: 600; border-radius: 6px; color: #3b82f6;">
                Onaylandı
            </button>
            <button type="button" class="btn-tree-tool @(Model.SelectedStatus == "Kargoya Verildi" ? "is-active" : "")" 
                    onclick="setStatusFilter('Kargoya Verildi')" style="padding: 7px 14px; font-size: 0.82rem; font-weight: 600; border-radius: 6px; color: #f59e0b;">
                🚚 Kargoda
            </button>
            <button type="button" class="btn-tree-tool @(Model.SelectedStatus == "Teslim Edildi" ? "is-active" : "")" 
                    onclick="setStatusFilter('Teslim Edildi')" style="padding: 7px 14px; font-size: 0.82rem; font-weight: 600; border-radius: 6px; color: #10b981;">
                ✓ Teslim Edildi
            </button>

            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery) || (!string.IsNullOrWhiteSpace(Model.SelectedStatus) && Model.SelectedStatus != "Tümü"))
            {
                <a asp-action="Orders" class="btn-cancel" style="padding: 7px 12px; font-size: 0.82rem; text-decoration: none;">✕ Temizle</a>
            }
        </div>
    </form>
</div>

<!-- ==================== SİPARİŞLER TABLOSU ==================== -->
<article class="card">
    <header class="card-head">
        <div class="head-with-icon">
            <span class="blue-accent-x">🛒</span>
            <h2>Sipariş Geçmişi & Sevkiyat Takibi (@Model.Orders.Count)</h2>
        </div>
    </header>

    <div class="table-scroll-wrap">
        <table class="dash-table">
            <thead>
                <tr>
                    <th>Sipariş No & Tarih</th>
                    <th>Satıcı Tedarikçi</th>
                    <th>Ürünler / Kalemler</th>
                    <th>Toplam Tutar</th>
                    <th>Ödeme Şekli</th>
                    <th>Durum & Kargo</th>
                    <th class="text-right">Aksiyon</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Orders.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 48px 16px; color: var(--muted);">
                            <div style="font-size: 2.5rem; margin-bottom: 12px;">🛒</div>
                            <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 6px; color: var(--text);">Henüz verilmiş bir siparişiniz bulunmamaktadır</h3>
                            <p style="font-size: 0.85rem; margin-bottom: 16px;">B2B kurumsal vitrinimizdeki hazır stoklu ürünleri doğrudan sepetinize ekleyip satın alabilirsiniz.</p>
                            <a href="/#b2b-vitrin" class="btn-primary" style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none; margin: 0 auto;">
                                Vitrine Git & Alışverişe Başla
                            </a>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var o in Model.Orders)
                    {
                        var isShipped = o.OrderStatus == "Kargoya Verildi";
                        var isDelivered = o.OrderStatus == "Teslim Edildi" || o.OrderStatus == "Tamamlandı";
                        <tr id="buyer-order-row-@o.OrderID" data-order-id="@o.OrderID">
                            <td>
                                <div class="req-title-cell">
                                    <strong style="font-size: 0.92rem; color: var(--text);">@o.OrderNumber</strong>
                                    <small class="req-code">📅 @o.OrderDate.ToString("dd.MM.yyyy HH:mm")</small>
                                </div>
                            </td>
                            <td>
                                <strong>@o.SupplierCompanyName</strong>
                                <div style="font-size: 0.75rem; color: var(--muted);">📍 @o.DeliveryCity</div>
                                @{
                                    var suppId = o.SupplierCompanyID ?? o.OrderItems.FirstOrDefault(oi => oi.SupplierCompanyID.HasValue)?.SupplierCompanyID;
                                }
                                @if (suppId.HasValue && suppId.Value > 0)
                                {
                                    <a href="/Seller/@suppId.Value" target="_blank" style="font-size: 0.74rem; color: #2563eb; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 3px; margin-top: 3px;">
                                        ★ Satıcı Karnesi (10★) →
                                    </a>
                                }
                                else if (!string.IsNullOrWhiteSpace(o.SupplierCompanyName))
                                {
                                    <a href="/Seller/Detail?name=@Uri.EscapeDataString(o.SupplierCompanyName)" target="_blank" style="font-size: 0.74rem; color: #2563eb; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 3px; margin-top: 3px;">
                                        ★ Satıcı Karnesi (10★) →
                                    </a>
                                }
                            </td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 2px;">
                                    @foreach (var item in o.OrderItems.Take(2))
                                    {
                                        <span style="font-size: 0.82rem; font-weight: 600;">
                                            • @item.ProductName <small style="color: var(--muted);">(@item.Quantity Adet)</small>
                                        </span>
                                    }
                                    @if (o.OrderItems.Count > 2)
                                    {
                                        <small style="color: var(--accent); font-weight: 600;">+ @(o.OrderItems.Count - 2) diğer kalem...</small>
                                    }
                                </div>
                            </td>
                            <td>
                                <strong style="font-size: 0.95rem; color: var(--text);">@o.GrandTotal.ToString("N2", ChartHelper.Tr) ₺</strong>
                                <div style="font-size: 0.72rem; color: var(--muted);">KDV Dahil</div>
                            </td>
                            <td>
                                <span style="font-size: 0.82rem; font-weight: 600; color: var(--text);">@o.PaymentMethod</span>
                                <div>
                                    <span class="status-badge badge-emerald" style="font-size: 0.68rem; padding: 2px 6px;">@o.PaymentStatus</span>
                                </div>
                            </td>
                            <td>
                                <div>
                                    <span class="status-badge @(isDelivered ? "badge-emerald" : (isShipped ? "badge-amber" : "badge-blue"))" style="font-size: 0.78rem; padding: 3px 8px;">
                                        <span class="status-dot"></span>
                                        @o.OrderStatus
                                    </span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(o.TrackingNumber))
                                {
                                    <div style="font-size: 0.75rem; margin-top: 4px; color: var(--muted);">
                                        📦 <strong>@o.ShippingCarrier:</strong> @o.TrackingNumber
                                    </div>
                                }
                            </td>
                            <td class="text-right">
                                <div style="display: flex; flex-direction: column; gap: 6px; align-items: flex-end;">
                                    <button type="button" class="btn-primary" style="padding: 6px 14px; font-size: 0.78rem; font-weight: 700; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border: none; border-radius: 6px; box-shadow: 0 2px 8px rgba(245, 158, 11, 0.35); cursor: pointer;" id="btn-rate-order-@o.OrderID" onclick="openBuyerReviewModalForOrder(@o.OrderID, this.getAttribute('data-seller-name'))" data-seller-name="@(o.SupplierCompanyName ?? "Onaylı Tedarikçi")">
                                        ★ Satıcıyı Değerlendir
                                    </button>
                                    <button type="button" class="btn-table-action" style="font-size: 0.75rem; padding: 5px 10px;" onclick="showOrderDetailsModal(@o.OrderID, '@o.OrderNumber', '@o.GrandTotal.ToString("N2", ChartHelper.Tr) ₺', '@o.OrderStatus', '@o.PaymentMethod', '@o.DeliveryCity - @o.DeliveryAddress?.Replace("'", "\\'") ', '@o.TrackingNumber', '@o.ShippingCarrier')">
                                        Detay Gör
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</article>

<!-- Modal: Sipariş Detayı -->
<div id="buyerOrderDetailModal" class="ty-modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.65); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;" onclick="if(event.target===this)closeOrderDetailModal()">
    <div class="ty-modal-box" style="background: var(--card-bg, #ffffff); border: 1px solid var(--border-color, #e2e8f0); border-radius: 12px; width: 100%; max-width: 520px; padding: 24px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.2);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
            <div>
                <span class="status-badge badge-emerald" style="font-size: 0.72rem; padding: 2px 8px;">SİPARİŞ DETAYI</span>
                <h3 id="modalOrderNo" style="font-size: 1.2rem; font-weight: 800; color: var(--text, #0f172a); margin-top: 6px; margin-bottom: 4px;"></h3>
            </div>
            <button type="button" class="modal-close-btn" onclick="closeOrderDetailModal()" style="border: none; background: transparent; font-size: 1.2rem; cursor: pointer; color: var(--muted);">✕</button>
        </div>

        <div style="background: rgba(0,0,0,0.02); border: 1px solid var(--border-color, #e2e8f0); border-radius: 8px; padding: 14px; margin-bottom: 16px; font-size: 0.85rem; display: flex; flex-direction: column; gap: 8px;">
            <div><strong>Durum:</strong> <span id="modalOrderStatus"></span></div>
            <div><strong>Toplam Tutar:</strong> <span id="modalGrandTotal" style="font-weight: 700; color: var(--accent);"></span></div>
            <div><strong>Ödeme Yöntemi:</strong> <span id="modalPaymentMethod"></span></div>
            <div><strong>Teslimat Adresi:</strong> <span id="modalDeliveryAddress"></span></div>
            <div id="modalTrackingWrap" style="display: none;"><strong>Kargo Takip:</strong> <span id="modalTracking"></span></div>
        </div>

        <div style="display: flex; justify-content: flex-end;">
            <button type="button" class="btn-cancel" onclick="closeOrderDetailModal()">Kapat</button>
        </div>
    </div>
</div>

<!-- Modal: 10 Yıldız Satıcı Değerlendirme Modalı (Alıcı -> Satıcı) -->
<div id="buyerRateOrderModal" class="ty-modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.65); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;" onclick="if(event.target===this)closeBuyerRateOrderModal()">
    <div class="ty-modal-box" style="background: var(--card-bg, #ffffff); border: 1px solid var(--border-color, #e2e8f0); border-radius: 14px; width: 100%; max-width: 520px; padding: 26px; box-shadow: 0 25px 35px -5px rgba(0,0,0,0.25);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
            <div>
                <span class="status-badge badge-emerald" style="font-size: 0.72rem; padding: 2px 8px;">DOĞRULANMIŞ SATIN ALIM</span>
                <h3 id="rateModalSellerTitle" style="font-size: 1.25rem; font-weight: 800; color: var(--text, #0f172a); margin-top: 6px; margin-bottom: 2px;">Satıcıyı Değerlendir</h3>
                <small style="color: var(--muted); font-size: 0.8rem;">Bu değerlendirme satıcının onaylı profiline ve karne istatistiklerine yansıyacaktır.</small>
            </div>
            <button type="button" onclick="closeBuyerRateOrderModal()" style="border: none; background: transparent; font-size: 1.3rem; cursor: pointer; color: var(--muted);">&times;</button>
        </div>

        <form id="buyerRateOrderForm" onsubmit="submitBuyerRateOrder(event)">
            <input type="hidden" id="rateModalOrderID" />
            <input type="hidden" id="rateModalScore" value="10" />

            <!-- 10 Yıldız Seçici -->
            <div style="text-align: center; margin-bottom: 16px; background: rgba(245,158,11,0.05); padding: 14px; border-radius: 10px; border: 1px solid rgba(245,158,11,0.15);">
                <label style="display: block; font-size: 0.84rem; font-weight: 700; color: var(--text); margin-bottom: 6px;">Satıcı Genel Memnuniyet Puanı (10 Yıldız)</label>
                <div style="display: flex; justify-content: center; gap: 4px;" id="buyerStarPickerWrap">
                    @for (int i = 1; i <= 10; i++)
                    {
                        <button type="button" class="btn-star-pick" data-val="@i" onclick="pickBuyerScore(@i)" onmouseenter="previewBuyerScore(@i)" onmouseleave="restoreBuyerScore()" style="background: none; border: none; font-size: 1.8rem; color: #f59e0b; cursor: pointer; padding: 2px; transition: transform 0.15s;">★</button>
                    }
                </div>
                <div id="buyerScoreText" style="font-size: 1.05rem; font-weight: 800; color: #d97706; margin-top: 6px;">★ 10.0 / 10 - Mükemmel</div>
            </div>

            <!-- Alt Kriterler (10 Üzerinden) -->
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-bottom: 14px;">
                <div>
                    <label style="font-size: 0.74rem; font-weight: 700; display: block; margin-bottom: 4px;">🚚 Teslimat Hızı</label>
                    <input type="number" id="rateModalDelivery" class="form-control" value="10" min="1" max="10" step="0.5" style="font-size: 0.85rem; padding: 6px 10px;" />
                </div>
                <div>
                    <label style="font-size: 0.74rem; font-weight: 700; display: block; margin-bottom: 4px;">📦 Ürün Kalitesi</label>
                    <input type="number" id="rateModalQuality" class="form-control" value="10" min="1" max="10" step="0.5" style="font-size: 0.85rem; padding: 6px 10px;" />
                </div>
                <div>
                    <label style="font-size: 0.74rem; font-weight: 700; display: block; margin-bottom: 4px;">💬 İletişim / Süreç</label>
                    <input type="number" id="rateModalComm" class="form-control" value="10" min="1" max="10" step="0.5" style="font-size: 0.85rem; padding: 6px 10px;" />
                </div>
            </div>

            <!-- Yorum -->
            <div class="form-group" style="margin-bottom: 18px;">
                <label style="font-size: 0.82rem; font-weight: 700; display: block; margin-bottom: 4px;">Yorumunuz (Opsiyonel)</label>
                <textarea id="rateModalComment" class="form-control" rows="3" placeholder="Teslimat süreci, ambalaj ve şartnameye uygunluk nasıldı?" style="font-size: 0.85rem;"></textarea>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button type="button" class="btn-cancel" onclick="closeBuyerRateOrderModal()">Vazgeç</button>
                <button type="submit" class="btn-primary" style="padding: 10px 20px; font-weight: 700; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border: none;">
                    Değerlendir &amp; Gönder
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let currentPickedScore = 10;

        function pickBuyerScore(val) {
            currentPickedScore = val;
            document.getElementById('rateModalScore').value = val;
            updateBuyerStarsDisplay(val);
        }

        function previewBuyerScore(val) {
            updateBuyerStarsDisplay(val);
        }

        function restoreBuyerScore() {
            updateBuyerStarsDisplay(currentPickedScore);
        }

        function updateBuyerStarsDisplay(val) {
            const stars = document.querySelectorAll('#buyerStarPickerWrap .btn-star-pick');
            stars.forEach(btn => {
                const bVal = parseInt(btn.getAttribute('data-val'));
                if (bVal <= val) {
                    btn.style.color = '#f59e0b';
                    btn.style.opacity = '1';
                } else {
                    btn.style.color = '#cbd5e1';
                    btn.style.opacity = '0.7';
                }
            });

            const labels = {
                1: "★ 1.0 / 10 - Çok Zayıf",
                2: "★ 2.0 / 10 - Yetersiz",
                3: "★ 3.0 / 10 - Zayıf",
                4: "★ 4.0 / 10 - Geliştirilmeli",
                5: "★ 5.0 / 10 - Orta Seviye",
                6: "★ 6.0 / 10 - Ortalama",
                7: "★ 7.0 / 10 - Başarılı",
                8: "★ 8.0 / 10 - İyi",
                9: "★ 9.0 / 10 - Çok İyi",
                10: "★ 10.0 / 10 - Mükemmel"
            };
            document.getElementById('buyerScoreText').textContent = labels[val] || `★ ${val} / 10`;
        }

        function openBuyerReviewModalForOrder(orderId, sellerName) {
            const modal = document.getElementById('buyerRateOrderModal');
            if (!modal) return;
            document.getElementById('rateModalOrderID').value = orderId;
            const title = document.getElementById('rateModalSellerTitle');
            if (title) {
                const cleanSeller = (sellerName && sellerName.trim() !== '') ? sellerName.trim() + ' - ' : '';
                title.textContent = cleanSeller + 'Satıcıyı Değerlendir';
            }
            pickBuyerScore(10);
            modal.style.setProperty('display', 'flex', 'important');
            modal.style.setProperty('opacity', '1', 'important');
            modal.style.setProperty('pointer-events', 'auto', 'important');
            modal.classList.add('show');
        }

        function closeBuyerRateOrderModal() {
            const modal = document.getElementById('buyerRateOrderModal');
            if (modal) {
                modal.style.setProperty('display', 'none', 'important');
                modal.style.setProperty('opacity', '0', 'important');
                modal.style.setProperty('pointer-events', 'none', 'important');
                modal.classList.remove('show');
            }
        }

        async function submitBuyerRateOrder(e) {
            e.preventDefault();
            const orderId = parseInt(document.getElementById('rateModalOrderID').value);
            const score = parseFloat(document.getElementById('rateModalScore').value);
            const delivery = parseFloat(document.getElementById('rateModalDelivery').value);
            const quality = parseFloat(document.getElementById('rateModalQuality').value);
            const comm = parseFloat(document.getElementById('rateModalComm').value);
            const text = document.getElementById('rateModalComment').value;

            try {
                const res = await fetch('/Review/SubmitBuyerReview', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        orderID: orderId,
                        reviewScore: score,
                        deliveryScore: delivery,
                        qualityScore: quality,
                        communicationScore: comm,
                        reviewText: text
                    })
                });

                const data = await res.json();
                if (data.success) {
                    closeBuyerRateOrderModal();
                    alert(data.message);
                    const btn = document.getElementById('btn-rate-order-' + orderId);
                    if (btn) {
                        btn.textContent = `✓ Değerlendirildi (★ ${score}/10)`;
                        btn.style.background = '#059669';
                        btn.style.boxShadow = 'none';
                    }
                } else {
                    alert(data.message);
                }
            } catch (err) {
                alert('Değerlendirme gönderilirken hata oluştu: ' + err);
            }
        }

        function setStatusFilter(statusVal) {
            document.getElementById('selectedStatusInput').value = statusVal;
            document.getElementById('ordersFilterForm').submit();
        }

        function showOrderDetailsModal(id, number, total, status, payMethod, address, tracking, carrier) {
            document.getElementById('modalOrderNo').textContent = number;
            document.getElementById('modalOrderStatus').textContent = status;
            document.getElementById('modalGrandTotal').textContent = total;
            document.getElementById('modalPaymentMethod').textContent = payMethod;
            document.getElementById('modalDeliveryAddress').textContent = address;

            const trackWrap = document.getElementById('modalTrackingWrap');
            if (tracking && tracking !== 'null' && tracking.trim() !== '') {
                trackWrap.style.display = 'block';
                document.getElementById('modalTracking').textContent = (carrier ? carrier + ' - ' : '') + tracking;
            } else {
                trackWrap.style.display = 'none';
            }

            document.getElementById('buyerOrderDetailModal').style.display = 'flex';
        }

        function closeOrderDetailModal() {
            document.getElementById('buyerOrderDetailModal').style.display = 'none';
        }
    </script>
}
