                <div class="mb-2">
                    <span class="status-badge bg-rose-50 text-rose-700 border border-rose-200 text-[11px] font-bold px-2 py-0.5 rounded-md">SİPARİŞ İPTAL TALEBİ</span>
                </div>
                <h3 id="buyerCancelOrderModalTitle" class="text-base font-extrabold text-slate-900">Siparişi İptal Et</h3>
