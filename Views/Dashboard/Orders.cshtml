                    <label class="block text-xs font-semibold text-slate-700 mb-1.5" for="buyerCancelOrderReason">İptal Gerekçesi (Zorunlu) <span class="text-rose-500 font-bold">*</span></label>
                    <textarea id="buyerCancelOrderReason" class="form-control w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all" rows="3" placeholder="Örn: Yanlış ürün seçimi yaptım / Satın almaktan vazgeçtim." required></textarea>
                </div>
            </div>

            <div class="px-6 py-3.5 border-t border-slate-100 bg-slate-50/80 flex items-center justify-end gap-2.5">
                <button type="button" class="btn-cancel px-4 py-2 rounded-lg text-xs font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 transition shadow-2xs cursor-pointer" onclick="closeBuyerCancelModal()">Vazgeç</button>
                <button type="submit" id="btnSubmitBuyerCancel" class="btn-primary px-4.5 py-2 rounded-lg text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 shadow-xs shadow-rose-600/20 transition cursor-pointer">
                    Siparişi İptal Et &amp; İade Al
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: 10 Yıldız Satıcı Değerlendirme Modalı (Alıcı -> Satıcı) -->
<div id="buyerRateOrderModal" class="ty-modal-overlay fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4 sm:p-6 md:p-8 overflow-y-auto" style="display: none;" onclick="if(event.target===this)closeBuyerRateOrderModal()">
    <div class="ty-modal-box my-auto relative bg-white rounded-2xl shadow-2xl border border-slate-200/90 w-full max-w-lg max-h-[88vh] overflow-hidden transform transition-all">
        <div class="px-6 pt-6 pb-5 sm:px-7 sm:pt-7 sm:pb-5 border-b border-slate-100 flex items-start justify-between bg-slate-50/80">
            <div>
                <div class="mb-2">
                    <span class="status-badge badge-emerald text-[11px] font-bold px-2 py-0.5 rounded-md">DOĞRULANMIŞ SATIN ALIM</span>
                </div>
                <h3 id="rateModalSellerTitle" class="text-base font-extrabold text-slate-900">Satıcıyı Değerlendir</h3>
                <p class="text-xs text-slate-500 mt-1">Bu değerlendirme satıcının onaylı profiline ve karne istatistiklerine yansıyacaktır.</p>
            </div>
            <button type="button" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-200/60 transition-colors cursor-pointer text-base leading-none shrink-0 ml-4 -mt-1 -mr-1" onclick="closeBuyerRateOrderModal()" aria-label="Kapat">✕</button>
        </div>

        <form id="buyerRateOrderForm" onsubmit="submitBuyerRateOrder(event)">
            <input type="hidden" id="rateModalOrderID" />
            <input type="hidden" id="rateModalSupplierCompanyID" />
            <input type="hidden" id="rateModalSupplierCompanyName" />
            <input type="hidden" id="rateModalScore" value="10" />

            <div class="p-6 space-y-4 text-xs">
                <!-- 10 Yıldız Seçici -->
                <div class="text-center p-4 bg-amber-50/60 border border-amber-200/80 rounded-xl space-y-1.5">
                    <label class="block text-xs font-bold text-slate-800">Satıcı Genel Memnuniyet Puanı (10 Yıldız)</label>
                    <div class="flex justify-center gap-1 py-1" id="buyerStarPickerWrap">
                        @for (int i = 1; i <= 10; i++)
                        {
                            <button type="button" class="btn-star-pick text-2xl text-amber-500 hover:scale-110 transition-transform p-0.5 cursor-pointer bg-transparent border-none leading-none" data-val="@i" onclick="pickBuyerScore(@i)" onmouseenter="previewBuyerScore(@i)" onmouseleave="restoreBuyerScore()">★</button>
                        }
                    </div>
                    <div id="buyerScoreText" class="text-sm font-extrabold text-amber-600">★ 10.0 / 10 - Mükemmel</div>
                </div>

                <!-- Alt Kriterler (10 Üzerinden) -->
                <div class="grid grid-cols-3 gap-3">
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 mb-1" for="rateModalDelivery">Teslimat Hızı</label>
                        <input type="number" id="rateModalDelivery" class="form-control w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-800 focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all font-semibold text-center" value="10" min="1" max="10" step="0.5" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 mb-1" for="rateModalQuality">Ürün Kalitesi</label>
                        <input type="number" id="rateModalQuality" class="form-control w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-800 focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all font-semibold text-center" value="10" min="1" max="10" step="0.5" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 mb-1" for="rateModalComm">İletişim &amp; Süreç</label>
                        <input type="number" id="rateModalComm" class="form-control w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-800 focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all font-semibold text-center" value="10" min="1" max="10" step="0.5" />
                    </div>
                </div>

                <!-- Yorum -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1" for="rateModalComment">Yorumunuz (Opsiyonel)</label>
                    <textarea id="rateModalComment" class="form-control w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all" rows="3" placeholder="Teslimat süreci, ambalaj ve şartnameye uygunluk nasıldı?"></textarea>
                </div>
            </div>

            <div class="px-6 py-3.5 border-t border-slate-100 bg-slate-50/80 flex items-center justify-end gap-2.5">
                <button type="button" class="btn-cancel px-4 py-2 rounded-lg text-xs font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 transition shadow-2xs cursor-pointer" onclick="closeBuyerRateOrderModal()">Vazgeç</button>
                <button type="submit" id="btnSubmitBuyerRate" class="btn-primary px-4.5 py-2 rounded-lg text-xs font-bold text-white bg-amber-500 hover:bg-amber-600 shadow-xs shadow-amber-500/20 transition cursor-pointer">
                    Değerlendir &amp; Gönder
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let currentPickedScore = 10;

        function pickBuyerScore(val) {
            currentPickedScore = val;
            document.getElementById('rateModalScore').value = val;
            updateBuyerStarsDisplay(val);
        }

        function previewBuyerScore(val) {
            updateBuyerStarsDisplay(val);
        }

        function restoreBuyerScore() {
            updateBuyerStarsDisplay(currentPickedScore);
        }

        function updateBuyerStarsDisplay(val) {
            const stars = document.querySelectorAll('#buyerStarPickerWrap .btn-star-pick');
            stars.forEach(btn => {
                const bVal = parseInt(btn.getAttribute('data-val'));
                if (bVal <= val) {
                    btn.style.color = '#f59e0b';
                    btn.style.opacity = '1';
                } else {
                    btn.style.color = '#cbd5e1';
                    btn.style.opacity = '0.7';
                }
            });

            const labels = {
                1: "★ 1.0 / 10 - Çok Zayıf",
                2: "★ 2.0 / 10 - Yetersiz",
                3: "★ 3.0 / 10 - Zayıf",
                4: "★ 4.0 / 10 - Geliştirilmeli",
                5: "★ 5.0 / 10 - Orta Seviye",
                6: "★ 6.0 / 10 - Ortalama",
                7: "★ 7.0 / 10 - Başarılı",
                8: "★ 8.0 / 10 - İyi",
                9: "★ 9.0 / 10 - Çok İyi",
                10: "★ 10.0 / 10 - Mükemmel"
            };
            document.getElementById('buyerScoreText').textContent = labels[val] || `★ ${val} / 10`;
        }

        function openBuyerReviewModalForOrder(orderId, sellerName, sellerCompanyId) {
            const modal = document.getElementById('buyerRateOrderModal');
            if (!modal) return;
            document.getElementById('rateModalOrderID').value = orderId;
            document.getElementById('rateModalSupplierCompanyID').value = sellerCompanyId || '';
            document.getElementById('rateModalSupplierCompanyName').value = sellerName || '';

            const title = document.getElementById('rateModalSellerTitle');
            if (title) {
                const cleanSeller = (sellerName && sellerName.trim() !== '') ? sellerName.trim() + ' - ' : '';
                title.textContent = cleanSeller + 'Satıcıyı Değerlendir';
            }
            pickBuyerScore(10);
            modal.style.setProperty('display', 'flex', 'important');
            modal.style.setProperty('opacity', '1', 'important');
            modal.style.setProperty('pointer-events', 'auto', 'important');
            modal.classList.add('show');
        }

        function closeBuyerRateOrderModal() {
            const modal = document.getElementById('buyerRateOrderModal');
            if (modal) {
                modal.style.setProperty('display', 'none', 'important');
                modal.style.setProperty('opacity', '0', 'important');
                modal.style.setProperty('pointer-events', 'none', 'important');
                modal.classList.remove('show');
            }
        }

        async function submitBuyerRateOrder(e) {
            e.preventDefault();
            const orderId = parseInt(document.getElementById('rateModalOrderID').value);
            const sellerCompId = parseInt(document.getElementById('rateModalSupplierCompanyID').value) || null;
            const sellerName = document.getElementById('rateModalSupplierCompanyName').value || '';
            const score = parseFloat(document.getElementById('rateModalScore').value);
            const delivery = parseFloat(document.getElementById('rateModalDelivery').value);
            const quality = parseFloat(document.getElementById('rateModalQuality').value);
            const comm = parseFloat(document.getElementById('rateModalComm').value);
            const text = document.getElementById('rateModalComment').value;

            const submitBtn = document.getElementById('btnSubmitBuyerRate');
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = 'Gönderiliyor...';
            }

            try {
                const res = await fetch('/Review/SubmitBuyerReview', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        orderID: orderId,
                        targetSupplierCompanyID: sellerCompId,
                        targetSupplierCompanyName: sellerName,
                        reviewScore: score,
                        deliveryScore: delivery,
                        qualityScore: quality,
                        communicationScore: comm,
                        reviewText: text
                    })
                });

                const data = await res.json();
                if (data.success) {
                    closeBuyerRateOrderModal();
                    alert(data.message || "Değerlendirmeniz başarıyla kaydedildi.");
                    location.reload();
                } else {
                    alert(data.message || "Değerlendirme kaydedilemedi.");
                }
            } catch (err) {
                alert('Değerlendirme gönderilirken hata oluştu: ' + err);
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Değerlendir & Gönder';
                }
            }
        }

        let currentBuyerStatus = '@(Model.SelectedStatus ?? "Tümü")';
        let buyerSearchTimer = null;

        function setStatusFilter(statusVal, btn) {
            currentBuyerStatus = statusVal;
            const inputEl = document.getElementById('selectedStatusInput');
            if (inputEl) inputEl.value = statusVal;

            const nav = btn ? btn.closest('.year-filter') : document.querySelector('.year-filter');
            if (nav) {
                nav.querySelectorAll('.year-pill').forEach(p => p.classList.remove('is-active'));
                if (btn) btn.classList.add('is-active');
            }

            applyBuyerOrdersFilter();
        }

        function onBuyerOrderSearchInput(val) {
            clearTimeout(buyerSearchTimer);
            buyerSearchTimer = setTimeout(() => {
                applyBuyerOrdersFilter();
            }, 120);
        }

        function resetBuyerFilters() {
            const sInput = document.getElementById('buyerOrderSearchInput');
            if (sInput) sInput.value = '';
            const allBtn = document.querySelector('button[onclick*="\'Tümü\'"]');
            setStatusFilter('Tümü', allBtn);
        }

        function applyBuyerOrdersFilter() {
            const search = (document.getElementById('buyerOrderSearchInput')?.value || '').trim().toLowerCase();
            const status = currentBuyerStatus || 'Tümü';
            const rows = document.querySelectorAll('tr[id^="buyer-order-row-"]');
            const mobileCards = document.querySelectorAll('.mobile-order-card');
            let visibleCount = 0;

            function isMatch(itemStatus, itemSearch) {
                let matchStatus = false;
                if (status === 'Tümü' || status === 'all' || !status) {
                    matchStatus = true;
                } else if (status === 'Onaylandı') {
                    matchStatus = (itemStatus === 'Onaylandı' || itemStatus === 'Yeni');
                } else if (status === 'Kargoya Verildi') {
                    matchStatus = (itemStatus === 'Kargoya Verildi' || itemStatus === 'Hazırlanıyor');
                } else if (status === 'Teslim Edildi') {
                    matchStatus = (itemStatus === 'Teslim Edildi' || itemStatus === 'Tamamlandı');
                } else {
                    matchStatus = (itemStatus.toLowerCase() === status.toLowerCase());
                }

                const matchSearch = (!search || itemSearch.includes(search));
                return matchStatus && matchSearch;
            }

            rows.forEach(row => {
                const rowStatus = row.getAttribute('data-status') || '';
                const rowSearch = row.getAttribute('data-search') || '';

                if (isMatch(rowStatus, rowSearch)) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            // Mobil kartları da senkronize filtrele
            mobileCards.forEach(card => {
                const cardStatus = card.getAttribute('data-status') || '';
                const cardSearch = card.getAttribute('data-search') || '';

                if (isMatch(cardStatus, cardSearch)) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });

            // Eğer masaüstü satır yoksa ama mobil kart varsa sayaç mobil kartlardan alınsın
            if (rows.length === 0 && mobileCards.length > 0) {
                let mobileVisible = 0;
                mobileCards.forEach(c => { if (c.style.display !== 'none') mobileVisible++; });
                visibleCount = mobileVisible;
            }

            const titleHeader = document.querySelector('article.card .head-with-icon h2');
            if (titleHeader) {
                titleHeader.textContent = `Sipariş Geçmişi & Sevkiyat Takibi (${visibleCount})`;
            }

            const clearBtn = document.getElementById('buyerClearFilterBtn');
            if (clearBtn) {
                clearBtn.style.display = (search !== '' || (status !== 'Tümü' && status !== '')) ? 'inline-flex' : 'none';
            }

            // Desktop boş arama durumu
            let emptySearchRow = document.getElementById('buyerOrdersEmptySearchRow');
            if (rows.length > 0 && visibleCount === 0) {
                if (!emptySearchRow) {
                    emptySearchRow = document.createElement('tr');
                    emptySearchRow.id = 'buyerOrdersEmptySearchRow';
                    emptySearchRow.innerHTML = '<td colspan="7" style="text-align: center; padding: 40px 16px; color: var(--muted);"><strong style="color: var(--text);">Arama veya filtre kriterinize uygun sipariş bulunamadı.</strong><div style="font-size: 0.8rem; margin-top: 4px;">Farklı bir arama kelimesi deneyebilir veya filtreyi temizleyebilirsiniz.</div></td>';
                    const tbody = document.querySelector('.dash-table tbody');
                    if (tbody) tbody.appendChild(emptySearchRow);
                }
                emptySearchRow.style.display = '';
            } else if (emptySearchRow) {
                emptySearchRow.style.display = 'none';
            }

            // Mobil boş arama durumu
            const mobileEmptySearch = document.getElementById('buyerOrdersMobileEmptySearch');
            if (mobileEmptySearch) {
                mobileEmptySearch.style.display = (mobileCards.length > 0 && visibleCount === 0) ? 'block' : 'none';
            }

            // URL state güncellemesi (sayfa yenilenmeden)
            try {
                const url = new URL(window.location.href);
                if (status && status !== 'Tümü') url.searchParams.set('status', status);
                else url.searchParams.delete('status');
                if (search) url.searchParams.set('search', search);
                else url.searchParams.delete('search');
                window.history.replaceState({}, '', url.toString());
            } catch (e) {}
        }

        function showOrderDetailsModal(orderId) {
            const data = (window.ordersDataMap && window.ordersDataMap[orderId]) ? window.ordersDataMap[orderId] : null;
            if (!data) return;

            // Başlık & Genel Bilgiler
            const noEl = document.getElementById('modalOrderNo');
            if (noEl) noEl.textContent = '#' + data.orderNumber;

            const dateEl = document.getElementById('modalOrderDate');
            if (dateEl) dateEl.textContent = 'Sipariş Tarihi: ' + data.orderDate;

            const overallBadge = document.getElementById('modalOverallBadge');
            if (overallBadge) {
                overallBadge.textContent = data.orderStatus;
                if (data.orderStatus === 'Teslim Edildi' || data.orderStatus === 'Tamamlandı') {
                    overallBadge.className = 'status-badge badge-emerald';
                } else if (data.orderStatus === 'Kargoya Verildi') {
                    overallBadge.className = 'status-badge badge-amber';
                } else {
                    overallBadge.className = 'status-badge badge-blue';
                }
            }

            // Çoklu Tedarikçi Uyarısı
            const multiAlert = document.getElementById('modalMultiSellerAlert');
            if (multiAlert) {
                if (data.distinctSellerCount > 1) {
                    multiAlert.style.display = 'flex';
                    multiAlert.innerHTML = `
                        <div>
                            <strong>Çoklu Tedarikçi Siparişi (${data.distinctSellerCount} Farklı Satıcı):</strong>
                            <div>Bu siparişteki ürünler farklı satıcı firmalar tarafından bağımsız olarak paketlenip sevk edilmektedir. Aşağıdaki listeden her ürünün tedarikçisini ve hazırlık/kargo durumunu ayrı ayrı takip edebilirsiniz.</div>
                        </div>
                    `;
                } else {
                    multiAlert.style.display = 'none';
                }
            }

            // Kalem Sayısı Metni
            const countText = document.getElementById('modalItemCountText');
            if (countText) {
                countText.textContent = `Toplam ${data.items ? data.items.length : 0} Kalem Ürün`;
            }

            // Ürünler & Durumlar Listesi
            const itemsContainer = document.getElementById('modalOrderItemsList');
            if (itemsContainer && data.items) {
                itemsContainer.innerHTML = '';
                data.items.forEach((item, index) => {
                    const isDelivered = item.status === 'Teslim Edildi' || item.status === 'Tamamlandı';
                    const isShipped = item.status === 'Kargoya Verildi';
                    const isPreparing = item.status === 'Hazırlanıyor';
                    const isCancelled = item.status === 'İptal';

                    let badgeClass = 'badge-blue';
                    if (isDelivered) { badgeClass = 'badge-emerald'; }
                    else if (isShipped) { badgeClass = 'badge-amber'; }
                    else if (isPreparing) { badgeClass = 'badge-blue'; }
                    else if (isCancelled) { badgeClass = 'badge-red'; }

                    const sellerLink = (item.supplierCompanyId && item.supplierCompanyId > 0)
                        ? `/Seller/${item.supplierCompanyId}`
                        : `/Seller/Detail?name=${encodeURIComponent(item.supplierName || '')}`;

                    let trackingHtml = '';
                    if (item.trackingNumber && item.trackingNumber.trim() !== '' && item.trackingNumber !== 'null') {
                        trackingHtml = `
                            <div class="mt-2 p-2 bg-emerald-50/70 rounded-lg text-xs flex items-center justify-between border border-dashed border-emerald-300">
                                <span class="text-emerald-800"><strong class="font-bold">${item.shippingCarrier || 'Kargo'}:</strong> <code class="bg-white px-1.5 py-0.5 rounded text-[11px] font-bold border border-emerald-200 text-emerald-900">${item.trackingNumber}</code></span>
                                <span class="text-emerald-700 font-bold text-[11px]">Kargo Takipte</span>
                            </div>
                        `;
                    }

                    const itemCard = document.createElement('div');
                    itemCard.className = 'order-detail-item-card p-3.5 bg-white border border-slate-200/90 rounded-xl shadow-2xs space-y-2.5';
                    
                    itemCard.innerHTML = `
                        <div class="flex justify-between items-start flex-wrap gap-2 pb-2 border-b border-slate-100">
                            <div class="flex items-center gap-1.5 text-xs">
                                <span class="font-bold text-slate-700">Satıcı:</span>
                                <a href="${sellerLink}" target="_blank" class="font-semibold text-blue-600 hover:text-blue-700 hover:underline inline-flex items-center gap-0.5" title="Satıcı Profilini İncele">
                                    ${item.supplierName} ↗
                                </a>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <span class="status-badge ${badgeClass} text-[11px] font-bold px-2 py-0.5 rounded-md">
                                    ${item.status}
                                </span>
                                <button type="button" class="px-2 py-1 text-[11px] font-bold text-white bg-amber-500 hover:bg-amber-600 rounded-md shadow-2xs transition cursor-pointer" onclick="openBuyerReviewModalForOrder(${data.orderId}, '${(item.supplierName || '').replace(/'/g, "\\'")}', ${item.supplierCompanyId || 0})">
                                    ★ Satıcıyı Değerlendir
                                </button>
                            </div>
                        </div>

                        <div class="flex justify-between items-center gap-3">
                            <div>
                                <div class="text-xs font-bold text-slate-900">${item.productName}</div>
                                <div class="text-[11px] text-slate-500 mt-0.5">
                                    Stok Kodu: <span class="font-mono font-semibold text-slate-700">${item.sku}</span> | Kategori: <span class="text-slate-600">${item.categoryName}</span>
                                </div>
                            </div>
                            <div class="text-right whitespace-nowrap">
                                <div class="text-[11px] text-slate-500">${item.quantity} Adet × ${item.unitPrice}</div>
                                <strong class="text-xs font-extrabold text-emerald-600">= ${item.lineTotal}</strong>
                            </div>
                        </div>

                        ${trackingHtml}
                    `;
                    itemsContainer.appendChild(itemCard);
                });
            }

            // Teslimat ve Alıcı Bilgileri
            const receiverEl = document.getElementById('modalReceiverInfo');
            if (receiverEl) receiverEl.textContent = (data.receiverName || 'Yetkili') + (data.receiverPhone ? ' (' + data.receiverPhone + ')' : '');

            const addrEl = document.getElementById('modalDeliveryAddress');
            if (addrEl) addrEl.textContent = (data.deliveryCity ? data.deliveryCity + ' - ' : '') + (data.deliveryAddress || '');

            const payEl = document.getElementById('modalPaymentMethod');
            if (payEl) payEl.textContent = data.paymentMethod + ' (' + data.paymentStatus + ')';

            // Mali Özet
            const subEl = document.getElementById('modalSubTotal');
            if (subEl) subEl.textContent = data.totalAmount;

            const taxEl = document.getElementById('modalTaxTotal');
            if (taxEl) taxEl.textContent = data.taxAmount;

            const grandEl = document.getElementById('modalGrandTotal');
            if (grandEl) grandEl.textContent = data.grandTotal;

            // iyzico Escrow (Havuz) Durumu ve Butonları
            currentActiveDetailOrderId = data.orderId;
            const escrowBadge = document.getElementById('modalEscrowBadge');
            const escrowText = document.getElementById('modalEscrowStatusText');
            const btnRelease = document.getElementById('btnReleaseEscrow');
            const btnDispute = document.getElementById('btnOpenDispute');
            const escrowActions = document.getElementById('modalEscrowActions');

            // Çok satıcılı teslimat ve onay hesaplama
            const activeItems = (data.items || []).filter(it => it.status !== 'İptal' && it.status !== 'İptal Edildi');
            const totalActive = activeItems.length;
            const deliveredItems = activeItems.filter(it => it.status === 'Teslim Edildi' || it.status === 'Tamamlandı');
            const deliveredCount = deliveredItems.length;
            const distinctSellerCount = data.distinctSellerCount || 1;

            const allItemsDelivered = (totalActive > 0 && deliveredCount === totalActive) || data.orderStatus === 'Teslim Edildi';
            const isPartiallyDelivered = !allItemsDelivered && deliveredCount > 0;
            const isShipped = data.orderStatus === 'Kargoya Verildi' || activeItems.some(it => it.status === 'Kargoya Verildi');
            const isPreparingOrConfirmed = !allItemsDelivered && !isPartiallyDelivered && !isShipped && (data.orderStatus === 'Onaylandı' || data.orderStatus === 'Hazırlanıyor' || data.orderStatus === 'Ödeme Bekleniyor');
            const btnCancelDetail = document.getElementById('btnCancelFromDetail');

            if (data.escrowStatus === 'Released_ToSeller' || data.isEscrowApproved || data.orderStatus === 'Tamamlandı') {
                if (escrowBadge) { escrowBadge.textContent = '✓ Ödeme Satıcıya Aktarıldı'; escrowBadge.className = 'status-badge badge-emerald'; }
                if (escrowText) escrowText.textContent = 'Alıcı onayı ile havuzdaki ödeme tedarikçi IBAN hesabına aktarılmıştır.';
                if (btnRelease) btnRelease.style.display = 'none';
                if (btnDispute) btnDispute.style.display = 'none';
                if (btnCancelDetail) btnCancelDetail.style.display = 'none';
                if (escrowActions) escrowActions.style.display = 'none';
            } else if (data.escrowStatus === 'Disputed') {
                if (escrowBadge) { escrowBadge.textContent = '⚠️ İtiraz / İncelemede'; escrowBadge.className = 'status-badge badge-amber'; }
                if (escrowText) escrowText.textContent = 'Bu sipariş için itiraz talebi açılmıştır. Havuzdaki bakiye dondurulmuştur.';
                if (btnRelease) btnRelease.style.display = 'none';
                if (btnDispute) btnDispute.style.display = 'none';
                if (btnCancelDetail) btnCancelDetail.style.display = 'none';
                if (escrowActions) escrowActions.style.display = 'none';
            } else if (data.escrowStatus === 'Refunded' || data.orderStatus === 'İptal Edildi') {
                if (escrowBadge) { escrowBadge.textContent = '↩️ İade Edildi / İptal'; escrowBadge.className = 'status-badge badge-red'; }
                if (escrowText) escrowText.textContent = 'Sipariş bedeli alıcı firmanın kartına kesintisiz iade edilmiştir.';
                if (btnRelease) btnRelease.style.display = 'none';
                if (btnDispute) btnDispute.style.display = 'none';
                if (btnCancelDetail) btnCancelDetail.style.display = 'none';
                if (escrowActions) escrowActions.style.display = 'none';
            } else {
                if (escrowBadge) { escrowBadge.textContent = '🛡️ Havuzda Güvence Altında'; escrowBadge.className = 'status-badge badge-emerald'; }
                if (escrowActions) escrowActions.style.display = 'flex';

                // İptal Butonu: Yalnızca hiçbir ürün kargoya verilmemişken görünür
                if (btnCancelDetail) {
                    btnCancelDetail.style.display = isPreparingOrConfirmed ? 'inline-flex' : 'none';
                }

                // İtiraz Butonu: Teslim edildiğinde, kısmi teslimatta veya kargodayken görünür
                if (btnDispute) {
                    btnDispute.style.display = (allItemsDelivered || isPartiallyDelivered || isShipped) ? 'inline-flex' : 'none';
                }

                // Teslim Aldım Butonu: ÇOK SATICILI SİPARİŞ KONTROLÜ
                if (allItemsDelivered) {
                    if (distinctSellerCount > 1) {
                        if (escrowText) escrowText.textContent = `Tüm tedarikçiler (${distinctSellerCount} Farklı Tedarikçi) siparişinizdeki ürünleri teslim etti. Ürünlerinizi kontrol ettiyseniz onay vererek havuzdaki ödemeyi satıcılara aktarabilirsiniz.`;
                        if (btnRelease) {
                            btnRelease.style.display = 'inline-flex';
                            btnRelease.disabled = false;
                            btnRelease.style.background = '#16a34a';
                            btnRelease.style.cursor = 'pointer';
                            btnRelease.style.opacity = '1';
                            btnRelease.title = '';
                            btnRelease.innerHTML = `<span>✓ Tüm Ürünleri Teslim Aldım &amp; Ödemeyi Aktar (${distinctSellerCount} Satıcı)</span>`;
                        }
                    } else {
                        if (escrowText) escrowText.textContent = 'Kargocu/tedarikçi siparişinizi teslim etti. Ürünü kontrol ettiyseniz onay vererek ödemeyi satıcıya aktarabilirsiniz.';
                        if (btnRelease) {
                            btnRelease.style.display = 'inline-flex';
                            btnRelease.disabled = false;
                            btnRelease.style.background = '#16a34a';
                            btnRelease.style.cursor = 'pointer';
                            btnRelease.style.opacity = '1';
                            btnRelease.title = '';
                            btnRelease.innerHTML = '<span>✓ Ürünü Teslim Aldım &amp; Ödemeyi Satıcıya Aktar</span>';
                        }
                    }
                } else if (isPartiallyDelivered) {
                    if (escrowText) escrowText.textContent = `Bu siparişiniz ${distinctSellerCount} farklı tedarikçiden oluşmaktadır. Şu ana kadar ${deliveredCount}/${totalActive} ürün teslim edildi, diğer tedarikçilerin teslimatı beklenmektedir. Siparişinizdeki tüm ürünler teslim edildiğinde onay butonu aktifleşecektir.`;
                    if (btnRelease) {
                        btnRelease.style.display = 'inline-flex';
                        btnRelease.disabled = true;
                        btnRelease.style.background = '#f59e0b';
                        btnRelease.style.cursor = 'not-allowed';
                        btnRelease.style.opacity = '0.95';
                        btnRelease.title = `Kalan ${totalActive - deliveredCount} ürünün teslimatı bekleniyor.`;
                        btnRelease.innerHTML = `<span>⏳ Kısmi Teslimat (${deliveredCount}/${totalActive} Ürün Teslim Edildi)</span>`;
                    }
                } else if (isShipped) {
                    if (escrowText) escrowText.textContent = 'Siparişiniz kargoya verildi ve yolda. Ürünler size ulaşıp kargo teslim edildikten sonra teslim alma onay butonu aktif olacaktır.';
                    if (btnRelease) {
                        btnRelease.style.display = 'inline-flex';
                        btnRelease.disabled = true;
                        btnRelease.style.background = '#94a3b8';
                        btnRelease.style.cursor = 'not-allowed';
                        btnRelease.style.opacity = '0.75';
                        btnRelease.title = 'Kargocu teslimatı gerçekleştirdiğinde onay butonu aktif olacaktır.';
                        btnRelease.innerHTML = '<span>⏳ Kargo Teslimatı Bekleniyor (Yolda)</span>';
                    }
                } else {
                    if (escrowText) escrowText.textContent = 'Ödemeniz iyzico güvence havuzunda bloke tutulmaktadır. Tedarikçiler hazırlık ve kargo teslimatını tamamlayana kadar onay butonu aktif olmaz.';
                    if (btnRelease) {
                        btnRelease.style.display = 'inline-flex';
                        btnRelease.disabled = true;
                        btnRelease.style.background = '#94a3b8';
                        btnRelease.style.cursor = 'not-allowed';
                        btnRelease.style.opacity = '0.7';
                        btnRelease.title = 'Tedarikçi firma henüz siparişi sevk veya teslim etmedi.';
                        btnRelease.innerHTML = '<span>⏳ Tedarikçi Hazırlığı / Sevkiyatı Bekleniyor</span>';
                    }
                }
            }

            // Modal Aç
            const modal = document.getElementById('buyerOrderDetailModal');
            if (modal) {
                modal.style.setProperty('display', 'flex', 'important');
                modal.style.setProperty('opacity', '1', 'important');
                modal.style.setProperty('pointer-events', 'auto', 'important');
                modal.classList.add('show');
            }
        }

        function closeOrderDetailModal() {
            const modal = document.getElementById('buyerOrderDetailModal');
            if (modal) {
                modal.style.setProperty('display', 'none', 'important');
                modal.style.setProperty('opacity', '0', 'important');
                modal.style.setProperty('pointer-events', 'none', 'important');
                modal.classList.remove('show');
            }
        }

        let currentActiveDetailOrderId = 0;

        async function confirmReleaseEscrow() {
            if (!currentActiveDetailOrderId) return;
            const data = (window.ordersDataMap && window.ordersDataMap[currentActiveDetailOrderId]) ? window.ordersDataMap[currentActiveDetailOrderId] : null;
            const isShippedOrDelivered = data && (data.orderStatus === 'Teslim Edildi' || data.orderStatus === 'Kargoya Verildi' || data.orderStatus === 'Tamamlandı');
            if (!isShippedOrDelivered) {
                alert('Tedarikçi firma henüz siparişi sevk veya teslim etmedi. Sevkiyat/teslimat gerçekleşmeden onay verilemez.');
                return;
            }

            const sellerCount = data ? (data.distinctSellerCount || 1) : 1;
            const promptMsg = sellerCount > 1
                ? `Bu siparişte ${sellerCount} farklı tedarikçi bulunmaktadır.\n\nTÜM tedarikçilerden ürünlerinizi eksiksiz teslim aldığınızı ve havuzdaki ödemenin satıcılara aktarılmasını onaylıyor musunuz?`
                : 'Ürünü eksiksiz teslim aldığınızı ve havuzdaki ödemenin satıcı firmaya aktarılmasını onaylıyor musunuz?';

            if (!confirm(promptMsg)) {
                return;
            }
            const btn = document.getElementById('btnReleaseEscrow');
            if (btn) { btn.disabled = true; btn.innerHTML = '<span>⏳ Onaylanıyor...</span>'; }
            try {
                const res = await fetch('/Payment/ApproveEscrowRelease', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderID: currentActiveDetailOrderId })
                });
                const data = await res.json();
                if (data.success) {
                    alert(data.message || 'Ödeme başarıyla satıcıya aktarıldı.');
                    location.reload();
                } else {
                    alert('Hata: ' + (data.message || 'Onay verilemedi.'));
                }
            } catch (err) {
                alert('Bağlantı hatası: ' + err.message);
            } finally {
                if (btn) { btn.disabled = false; btn.innerHTML = '<span>✓ Ürünü Teslim Aldım &amp; Ödemeyi Satıcıya Aktar</span>'; }
            }
        }

        function openDisputeModalFromDetail() {
            if (!currentActiveDetailOrderId) return;
            closeOrderDetailModal();
            const modal = document.getElementById('orderDisputeModal');
            if (modal) {
                document.getElementById('disputeOrderID').value = currentActiveDetailOrderId;
                document.getElementById('disputeDescription').value = '';
                modal.style.setProperty('display', 'flex', 'important');
            }
        }

        function closeDisputeModal() {
            const modal = document.getElementById('orderDisputeModal');
            if (modal) modal.style.setProperty('display', 'none', 'important');
        }

        async function submitDisputeForm(e) {
            e.preventDefault();
            const orderId = parseInt(document.getElementById('disputeOrderID').value);
            const reason = document.getElementById('disputeReason').value;
            const desc = document.getElementById('disputeDescription').value;

            const btn = document.getElementById('btnSubmitDispute');
            if (btn) { btn.disabled = true; btn.textContent = 'Kaydediliyor...'; }

            try {
                const res = await fetch('/Payment/CreateDispute', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderID: orderId, reason: reason, description: desc })
                });
                const data = await res.json();
                if (data.success) {
                    closeDisputeModal();
                    alert(data.message || 'İtiraz talebiniz alındı.');
                    location.reload();
                } else {
                    alert('Hata: ' + (data.message || 'İtiraz oluşturulamadı.'));
                }
            } catch (err) {
                alert('Bağlantı hatası: ' + err.message);
            } finally {
                if (btn) { btn.disabled = false; btn.textContent = 'İtirazı Kaydet & Havuzu Dondur'; }
            }
        }

        // ==================== ALICI TESLİM ALMA & İPTAL FONKSİYONLARI ====================

        async function confirmReleaseEscrowDirect(orderId, orderNumber) {
            const data = (window.ordersDataMap && window.ordersDataMap[orderId]) ? window.ordersDataMap[orderId] : null;
            const sellerCount = data ? (data.distinctSellerCount || 1) : 1;

            const promptMsg = sellerCount > 1
                ? `#${orderNumber} numaralı siparişinizde ${sellerCount} farklı tedarikçi bulunmaktadır.\n\nTÜM tedarikçilerden ürünlerinizi eksiksiz teslim aldığınızı ve havuzdaki ödemenin satıcılara aktarılmasını onaylıyor musunuz?`
                : `#${orderNumber} numaralı siparişin ürünlerini eksiksiz teslim aldığınızı ve havuzdaki bakiyenin satıcıya aktarılmasını onaylıyor musunuz?`;

            const confirmed = confirm(promptMsg);
            if (!confirmed) return;

            try {
                const res = await fetch('/Payment/ApproveEscrowRelease', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderID: orderId })
                });
                const data = await res.json();
                if (data.success) {
                    alert('🎉 ' + (data.message || 'Ödeme onayı verildi! Siparişiniz tamamlandı.'));
                    location.reload();
                } else {
                    alert('Hata: ' + (data.message || 'İşlem tamamlanamadı.'));
                }
            } catch(err) {
                alert('Bağlantı hatası: ' + err.message);
            }
        }

        function openBuyerCancelModal(orderId, orderNumber) {
            document.getElementById('buyerCancelOrderID').value = orderId;
            document.getElementById('buyerCancelOrderModalTitle').textContent = '#' + orderNumber + ' - Siparişi İptal Et';
            document.getElementById('buyerCancelOrderReason').value = '';
            const modal = document.getElementById('buyerCancelOrderModal');
            if (modal) modal.style.setProperty('display', 'flex', 'important');
        }

        function closeBuyerCancelModal() {
            const modal = document.getElementById('buyerCancelOrderModal');
            if (modal) modal.style.setProperty('display', 'none', 'important');
        }

        function openBuyerCancelModalFromDetail() {
            if (!currentActiveDetailOrderId) return;
            closeOrderDetailModal();
            const data = (window.ordersDataMap && window.ordersDataMap[currentActiveDetailOrderId]) || {};
            openBuyerCancelModal(currentActiveDetailOrderId, data.orderNumber || currentActiveDetailOrderId);
        }

        async function submitBuyerCancelOrder(e) {
            if (e) {
                if (typeof e.preventDefault === 'function') e.preventDefault();
                if (typeof e.stopPropagation === 'function') e.stopPropagation();
            }

            const id = parseInt(document.getElementById('buyerCancelOrderID').value, 10);
            const reason = document.getElementById('buyerCancelOrderReason').value.trim();

            if (!reason) {
                alert('Lütfen siparişi iptal etme gerekçenizi belirtiniz.');
                document.getElementById('buyerCancelOrderReason').focus();
                return false;
            }

            const confirmed = confirm('Bu siparişi kesin olarak iptal etmek istediğinizden emin misiniz?\n\nBu işlem geri alınamaz, sipariş iptal edilecek ve havuzdaki ödemeniz kartınıza iade edilecektir.');
            if (!confirmed) return false;

            const btn = document.getElementById('btnSubmitBuyerCancel');
            if (btn) { btn.disabled = true; btn.textContent = 'İptal Ediliyor...'; }

            try {
                const res = await fetch('/Dashboard/CancelOrderByBuyer', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderID: id, reason: reason })
                });

                const data = await res.json();
                if (data.success) {
                    closeBuyerCancelModal();
                    alert('✓ ' + (data.message || 'Siparişiniz başarıyla iptal edildi.'));
                    location.reload();
                } else {
                    alert('Hata: ' + (data.message || 'Sipariş iptal edilemedi.'));
                }
            } catch(err) {
                alert('Bağlantı hatası: ' + err.message);
            } finally {
                if (btn) { btn.disabled = false; btn.textContent = 'Siparişi İptal Et & İade Al'; }
            }

            return false;
        }
    </script>
}
