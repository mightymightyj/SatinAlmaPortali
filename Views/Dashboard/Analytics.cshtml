    </div>
</div>

@section Scripts {
    <script>
        // =========================================================================
        // CHART.JS GRAFİK BAŞLATMA (MOBİL VE DESKTOP UYUMLU)
        // =========================================================================
        document.addEventListener('DOMContentLoaded', function () {
            var isMobile = window.innerWidth < 640;

            // 1. AYLIK TALEP TREND GRAFİĞİ
            var trendCanvas = document.getElementById('trendChartCanvas');
            if (trendCanvas) {
                var periodLabels = @Html.Raw(JsonSerializer.Serialize(periods.Select(p => ChartHelper.MonthLabel(p.Month) + " " + p.Year)));
                var seriesRaw = @Html.Raw(JsonSerializer.Serialize(trendSeries.Select(s => new { name = s.Name, values = s.Values })));
                var colors = ['#2563EB', '#059669', '#D97706', '#7C3AED', '#DB2777'];
                var bgColors = [
                    'rgba(37, 99, 235, 0.08)',
                    'rgba(5, 150, 105, 0.08)',
                    'rgba(217, 119, 6, 0.08)',
                    'rgba(124, 58, 237, 0.08)',
                    'rgba(219, 39, 119, 0.08)'
                ];

                var datasets = seriesRaw.map(function (sr, idx) {
                    return {
                        label: sr.name,
                        data: sr.values,
                        borderColor: colors[idx % colors.length],
                        backgroundColor: bgColors[idx % bgColors.length],
                        fill: true,
                        tension: 0.35,
                        borderWidth: isMobile ? 1.8 : 2.2,
                        pointRadius: isMobile ? 2 : 3,
                        pointHoverRadius: 5,
                        pointBackgroundColor: colors[idx % colors.length]
                    };
                });

                new Chart(trendCanvas, {
                    type: 'line',
                    data: {
                        labels: periodLabels,
                        datasets: datasets
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: {
                                    boxWidth: isMobile ? 8 : 12,
                                    padding: isMobile ? 6 : 10,
                                    font: { family: 'inherit', size: isMobile ? 10 : 12, weight: 600 },
                                    color: '#475569'
                                }
                            },
                            tooltip: {
                                backgroundColor: '#0F172A',
                                titleFont: { family: 'inherit', size: 12, weight: 700 },
                                bodyFont: { family: 'inherit', size: 11 },
                                padding: 10,
                                cornerRadius: 8,
                                callbacks: {
                                    title: function (tooltipItems) {
                                        var fullMonths = ["Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık"];
                                        var idx = tooltipItems[0].dataIndex;
                                        return (fullMonths[idx] || tooltipItems[0].label) + ' @Model.SelectedYear';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: {
                                    color: '#64748B',
                                    font: { family: 'inherit', size: isMobile ? 9 : 11 },
                                    maxRotation: 45,
                                    minRotation: isMobile ? 45 : 0,
                                    autoSkip: false
                                }
                            },
                            y: {
                                beginAtZero: true,
                                grid: { color: '#F1F5F9' },
                                ticks: {
                                    precision: 0,
                                    color: '#64748B',
                                    font: { family: 'inherit', size: isMobile ? 9 : 11 }
                                }
                            }
                        }
                    }
                });
            }

            // 2. TALEP TÜRÜ DOUGHNUT GRAFİĞİ
            var donutCanvas = document.getElementById('typeDonutCanvas');
            if (donutCanvas) {
                var typeLabels = @Html.Raw(JsonSerializer.Serialize(types.Select(t => string.IsNullOrWhiteSpace(t.RequestType) ? "Belirtilmemiş" : t.RequestType)));
                var typeCounts = @Html.Raw(JsonSerializer.Serialize(types.Select(t => t.RequestCount)));
                var donutColors = ['#2563EB', '#059669', '#D97706', '#7C3AED', '#DB2777', '#0891B2', '#475569'];

                new Chart(donutCanvas, {
                    type: 'doughnut',
                    data: {
                        labels: typeLabels,
                        datasets: [{
                            data: typeCounts,
                            backgroundColor: donutColors.slice(0, typeLabels.length),
                            borderWidth: 2,
                            borderColor: '#FFFFFF',
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '72%',
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: '#0F172A',
                                padding: 10,
                                cornerRadius: 8,
                                callbacks: {
                                    label: function (ctx) {
                                        var total = ctx.dataset.data.reduce(function (a, b) { return a + b; }, 0);
                                        var val = ctx.raw;
                                        var pct = total > 0 ? ((val / total) * 100).toFixed(1) : 0;
                                        return ctx.label + ': ' + val + ' Talep (%' + pct + ')';
                                    }
                                }
                            }
                        }
                    }
                });
            }
        });

        // =========================================================================
        // TEDARİKÇİ KARNESİ CANLI ARAMA & GÜVENİLİRLİK FİLTRESİ
        // (HEM MASAÜSTÜ TABLOYU HEM MOBİL KARTLARI FİLTRELER)
        // =========================================================================
        function filterVendorTable(searchTerm) {
            var searchVal = (searchTerm !== undefined ? searchTerm : document.getElementById('vendorScoreSearchInput')?.value || '').toLowerCase().trim();
            var reliableFilter = document.getElementById('vendorReliableFilter')?.value || 'all';

            // 1. Masaüstü Tablo Satırları
            var rows = document.querySelectorAll('.vendor-data-row');
            rows.forEach(function (row) {
                var name = row.getAttribute('data-name') || '';
                var rel = row.getAttribute('data-reliable') || '';
                var matchName = !searchVal || name.includes(searchVal);
                var matchRel = reliableFilter === 'all' || rel === reliableFilter;
                row.style.display = (matchName && matchRel) ? '' : 'none';
            });

            // 2. Mobil Kartlar
            var cards = document.querySelectorAll('.vendor-mobile-card');
            var visibleCardCount = 0;
            cards.forEach(function (card) {
                var name = card.getAttribute('data-name') || '';
                var rel = card.getAttribute('data-reliable') || '';
                var matchName = !searchVal || name.includes(searchVal);
                var matchRel = reliableFilter === 'all' || rel === reliableFilter;
                if (matchName && matchRel) {
                    card.style.display = '';
                    visibleCardCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            var emptyState = document.getElementById('vendorMobileEmptyState');
            if (emptyState) {
                emptyState.classList.toggle('hidden', visibleCardCount > 0);
            }
        }

        // =========================================================================
        // MOBİL HIZLI DETAY MODALLARI VE ETKİLEŞİM YÖNETİMİ
        // =========================================================================

        // --- KATEGORİ MODALI ---
        function openCategoryQuickModalFromEl(el) {
            if (!el) return;
            var name = el.getAttribute('data-cat-name') || '';
            var items = el.getAttribute('data-cat-items') || '0';
            var qty = el.getAttribute('data-cat-qty') || '0';
            var avg = el.getAttribute('data-cat-avg') || '0';
            var val = el.getAttribute('data-cat-val') || '0';

            document.getElementById('catModalName').textContent = name;
            document.getElementById('catModalItems').textContent = items + ' Ürün Çeşidi';
            document.getElementById('catModalQty').textContent = qty + ' Adet Depoda';
            document.getElementById('catModalAvg').textContent = avg;
            document.getElementById('catModalVal').textContent = val;

            var modal = document.getElementById('analyticsCategoryQuickModal');
            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.classList.add('overflow-hidden');
                document.getElementById('dashboardBottomBar')?.classList.add('hidden');
            }
        }

        function closeCategoryQuickModal() {
            var modal = document.getElementById('analyticsCategoryQuickModal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                document.body.classList.remove('overflow-hidden');
                document.getElementById('dashboardBottomBar')?.classList.remove('hidden');
            }
        }

        // --- TEDARİKÇİ KARNESİ MODALI ---
        function openVendorQuickModalFromEl(el) {
            if (!el) return;
            var name = el.getAttribute('data-vendor-name') || '';
            var type = el.getAttribute('data-vendor-type') || '';
            var reqs = el.getAttribute('data-vendor-requests') || '0';
            var score = el.getAttribute('data-vendor-score') || '—';
            var reviews = el.getAttribute('data-vendor-reviews') || '0';
            var isRel = el.getAttribute('data-vendor-reliable') === 'true';

            document.getElementById('vendorModalInitial').textContent = name.length > 0 ? name.charAt(0).toUpperCase() : 'F';
            document.getElementById('vendorModalName').textContent = name;
            document.getElementById('vendorModalType').textContent = type;
            document.getElementById('vendorModalRequests').textContent = reqs + ' Satın Alma Talebi';
            document.getElementById('vendorModalScore').textContent = '★ ' + score + ' / 5.0';
            document.getElementById('vendorModalReviews').textContent = reviews + ' Onaylı Yorum';

            var relBadge = document.getElementById('vendorModalReliableBadge');
            var relDesc = document.getElementById('vendorModalReliableDesc');
            if (isRel) {
                relBadge.className = 'inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200';
                relBadge.innerHTML = '✓ Güvenilir Tedarikçi';
                relDesc.textContent = 'Bu tedarikçi düzenli talep karşılama performansı ve yüksek müşteri memnuniyet skoruna sahiptir.';
            } else {
                relBadge.className = 'inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200';
                relBadge.innerHTML = '● İnceleme Aşamasında';
                relDesc.textContent = 'Bu tedarikçi henüz değerlendirme eşiğine ulaşmamıştır; platform verileri biriktikçe güvenilirlik rozeti güncellenecektir.';
            }

            var modal = document.getElementById('analyticsVendorQuickModal');
            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.classList.add('overflow-hidden');
                document.getElementById('dashboardBottomBar')?.classList.add('hidden');
            }
        }

        function closeVendorQuickModal() {
            var modal = document.getElementById('analyticsVendorQuickModal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                document.body.classList.remove('overflow-hidden');
                document.getElementById('dashboardBottomBar')?.classList.remove('hidden');
            }
        }

        // --- MARKA ANALİZİ MODALI ---
        function openBrandQuickModalFromEl(el) {
            if (!el) return;
            var brand = el.getAttribute('data-brand-name') || '';
            var rank = el.getAttribute('data-brand-rank') || '';
            var items = el.getAttribute('data-brand-items') || '0';
            var val = el.getAttribute('data-brand-val') || '0';
            var pct = el.getAttribute('data-brand-pct') || '0';

            document.getElementById('brandModalName').textContent = brand;
            document.getElementById('brandModalRank').textContent = rank + ' Sırada';
            document.getElementById('brandModalItems').textContent = items + ' Çeşit Ürün';
            document.getElementById('brandModalVal').textContent = val;
            document.getElementById('brandModalPct').textContent = '%' + pct + ' Katalog Ağırlığı';
            document.getElementById('brandModalBar').style.width = pct + '%';

            var modal = document.getElementById('analyticsBrandQuickModal');
            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.classList.add('overflow-hidden');
                document.getElementById('dashboardBottomBar')?.classList.add('hidden');
            }
        }

        function closeBrandQuickModal() {
            var modal = document.getElementById('analyticsBrandQuickModal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                document.body.classList.remove('overflow-hidden');
                document.getElementById('dashboardBottomBar')?.classList.remove('hidden');
            }
        }

        // ESC Tuşu ile Modalları Kapatma
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closeCategoryQuickModal();
                closeVendorQuickModal();
                closeBrandQuickModal();
            }
        });
    </script>
}
