@using satinalmaportali2.Helpers
@using System.Text.Json
@model DashboardViewModel
@{
    ViewData["Title"] = "Sistem Analitiği & İş Zekası (BI)";
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";

    // Kurumsal renk paleti
    var palette = new[] { "#2563EB", "#059669", "#D97706", "#7C3AED", "#DB2777", "#0891B2", "#475569" };

    var periods = Model.TrendPeriods;
    var trendSeries = Model.TrendSeriesList;
    var types = Model.RequestTypes;
    var categories = Model.Categories;
    var vendors = Model.Vendors;
    var brands = Model.Brands;
    var regions = Model.Regions;

    var typeTotal = types.Sum(t => t.RequestCount);
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    /* Donut Grafik İçi Merkez İstatistik */
    .donut-canvas-wrap {
        position: relative;
        width: 180px;
        height: 180px;
        margin: 0 auto;
    }
    @@media (max-width: 640px) {
        .donut-canvas-wrap {
            width: 150px;
            height: 150px;
        }
    }
    .donut-center-stat {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        pointer-events: none;
    }

    /* Mobil Tablo ve Liste İyileştirmeleri */
    @@media (max-width: 767.98px) {
        .dash-table {
            font-size: 11px;
        }
    }

    /* Yazdırma / PDF Ayarları */
    @@media print {
        .app-sidebar, .app-topbar, .bi-actions, .bi-nav-tabs, .year-filter {
            display: none !important;
        }
        .app-shell { margin-left: 0 !important; }
        .card { box-shadow: none !important; border: 1px solid #CBD5E1 !important; page-break-inside: avoid; }
    }
</style>

<div class="analytics-container space-y-6">

    <!-- ==================== 1. SAYFA BAŞLIĞI ==================== -->
    <div class="page-head pb-1">
        <div class="flex items-center justify-between gap-3">
            <h1 class="text-xl sm:text-2xl font-black tracking-tight text-slate-900 leading-tight">
                Sistem Analitiği &amp; BI
            </h1>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-2xs whitespace-nowrap shrink-0">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Canlı Veri
            </span>
        </div>
        <p class="text-xs text-slate-500 mt-1 font-medium">
            Gerçek zamanlı satın alma performansı, ihale ve tedarikçi dinamikleri
        </p>
    </div>

    @if (Model.State != DataState.Ok) {
        <section class="card bg-white border border-rose-200 rounded-2xl p-6 shadow-xs text-center">
            <h2 class="text-base font-bold text-rose-700">@(Model.State == DataState.NotConfigured ? "Veritabanı bağlantısı tanımlı değil" : "Veriye ulaşılamadı")</h2>
            <p class="text-xs text-slate-500 mt-1">@Model.StateMessage</p>
            @if (!string.IsNullOrEmpty(Model.StateDetail)) {
                <div class="mt-3 p-3 bg-slate-50 rounded-lg text-left text-xs font-mono text-slate-700 overflow-x-auto"><pre>@Model.StateDetail</pre></div>
            }
        </section>
    } else if (Model.IsEmpty) {
        <section class="card bg-white border border-slate-200/90 rounded-2xl p-8 shadow-xs text-center">
            <h2 class="text-base font-bold text-slate-800">Bağlantı aktif, ancak gösterilecek kayıt bulunamadı</h2>
            <p class="text-xs text-slate-500 mt-2 max-w-md mx-auto">
                Veritabanına erişildi fakat sistemde henüz talep, ürün veya
                değerlendirme kaydı bulunmuyor. Yeni talepler açıldıkça bu ekran otomatik olarak güncellenecektir.
            </p>
        </section>
    } else {

        <!-- ==================== 2. 4 STRATEJİK KPI KARTI ==================== -->
        <section class="kpi-row grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-4 bi-section-el" id="sec-kpis">
            <!-- Toplam Talep -->
            <article class="card kpi-card bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
                <div class="kpi-top flex items-center justify-between">
                    <span class="kpi-label text-xs font-bold text-slate-500 uppercase tracking-wider">Toplam Satın Alma Talebi</span>
                    <span class="kpi-icon w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shadow-xs">
                        <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                        </svg>
                    </span>
                </div>
                <p class="kpi-value text-2xl sm:text-3xl font-black tracking-tight text-slate-900 my-2">@Model.Summary.CurrentRequests.ToString("N0", ChartHelper.Tr)</p>
                <p class="kpi-delta text-xs font-medium flex items-center gap-1.5">
                    @if (Model.Summary.RequestChangePercent is decimal change) {
                        var isGood = change > 0;
                        var isBad = change < 0;
                        <span class="@(isGood ? "text-emerald-600 font-semibold" : isBad ? "text-rose-600 font-semibold" : "text-slate-500") flex items-center gap-1">
                            <span>@(isGood ? "▲" : isBad ? "▼" : "■")</span>
                            <span>@ChartHelper.SignedPercent(change)</span>
                            <span class="text-slate-400 font-normal">önceki döneme kıyasla</span>
                        </span>
                    } else {
                        <span class="text-slate-400 font-normal">karşılaştırma verisi yok</span>
                    }
                </p>
            </article>

            <!-- Tedarikçi Memnuniyeti -->
            <article class="card kpi-card bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
                <div class="kpi-top flex items-center justify-between">
                    <span class="kpi-label text-xs font-bold text-slate-500 uppercase tracking-wider">Tedarikçi Memnuniyet Skoru</span>
                    <span class="kpi-icon w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shadow-xs">
                        <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </span>
                </div>
                <p class="kpi-value text-2xl sm:text-3xl font-black tracking-tight text-slate-900 my-2">
                    @(Model.Summary.AvgScore is decimal s ? ChartHelper.Score((double)s) : "—")
                    <span class="text-base font-semibold text-slate-400">/ 5.0</span>
                </p>
                <p class="kpi-delta text-xs font-medium text-emerald-600 flex items-center gap-1">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 font-semibold border border-emerald-100">
                        @Model.Summary.ReviewCount.ToString("N0", ChartHelper.Tr) Değerlendirme
                    </span>
                </p>
            </article>

            <!-- Katalog Stok Hacmi -->
            <article class="card kpi-card bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
                <div class="kpi-top flex items-center justify-between">
                    <span class="kpi-label text-xs font-bold text-slate-500 uppercase tracking-wider">Katalog &amp; Stok Hacmi</span>
                    <span class="kpi-icon w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shadow-xs">
                        <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                        </svg>
                    </span>
                </div>
                <p class="kpi-value text-2xl sm:text-3xl font-black tracking-tight text-slate-900 my-2">@(Model.Summary.StockValue is decimal v ? ChartHelper.Compact(v) : "—")</p>
                <p class="kpi-delta text-xs font-medium text-slate-500 flex items-center gap-1">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 font-semibold">
                        @Model.Summary.ItemCount.ToString("N0", ChartHelper.Tr) Aktif Ürün
                    </span>
                </p>
            </article>

            <!-- Kayıtlı Kurumsal Firma -->
            <article class="card kpi-card bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
                <div class="kpi-top flex items-center justify-between">
                    <span class="kpi-label text-xs font-bold text-slate-500 uppercase tracking-wider">Kayıtlı Kurumsal Firma</span>
                    <span class="kpi-icon w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center shadow-xs">
                        <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                        </svg>
                    </span>
                </div>
                <p class="kpi-value text-2xl sm:text-3xl font-black tracking-tight text-slate-900 my-2">@Model.Summary.CompanyCount.ToString("N0", ChartHelper.Tr)</p>
                <p class="kpi-delta text-xs font-medium text-slate-500 flex items-center gap-1">
                    <span class="text-slate-500">Lider Paket: <strong class="text-slate-800 font-bold">@(Model.Summary.TopMembershipName ?? "Bedava")</strong> (@Model.Summary.TopMembershipCount)</span>
                </p>
            </article>
        </section>

        <!-- ==================== 3. TALEP & TREND ANALİTİĞİ ==================== -->
        <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 bi-section-el" id="sec-trend">

            <!-- SOL: AYLIK TALEP TRENDİ (CHART.JS) -->
            <article class="lg:col-span-7 card bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs flex flex-col justify-between">
                <div class="flex items-center justify-between pb-3 mb-3 sm:mb-4 border-b border-slate-100">
                    <div>
                        <div class="flex items-center gap-2">
                            <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                                <svg class="w-4 h-4 text-blue-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
                                <span>Aylık Talep ve İhale Dinamikleri</span>
                            </h2>
                            <span class="px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 font-bold text-[11px]">@Model.SelectedYear</span>
                        </div>
                        <p class="text-xs text-slate-500 mt-0.5">@Model.SelectedYear dönemi aylık talep yoğunluğu ve yöntemlere göre hacim dağılımı</p>
                    </div>
                </div>

                <!-- Grafik Alanı (Mobilde Yükseklik ve Boyut Optimize Edildi) -->
                <div class="w-full h-64 sm:h-72 md:h-80 relative">
                    <canvas id="trendChartCanvas"></canvas>
                </div>

                <!-- Detaylı Veri Tablosu (Açılır/Kapanır) -->
                <details class="mt-4 pt-3 border-t border-slate-100 group">
                    <summary class="text-xs font-bold text-blue-600 hover:text-blue-700 cursor-pointer flex items-center gap-1.5 list-none">
                        <span class="transition-transform group-open:rotate-90">▶</span>
                        <span>Sayısal Tablo Görünümünü Aç / Kapat</span>
                    </summary>
                    <div class="overflow-x-auto mt-2 border border-slate-200/80 rounded-xl">
                        <table class="dash-table w-full text-left text-xs" style="min-width: 440px;">
                            <thead class="bg-slate-50 text-slate-500 font-bold uppercase tracking-wider text-[11px]">
                                <tr>
                                    <th class="py-2.5 px-3">Dönem</th>
                                    @foreach (var line in trendSeries) {
                                        <th class="py-2.5 px-3 text-right">@line.Name</th>
                                    }
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-slate-700 font-medium">
                                @for (var i = 0; i < periods.Count; i++) {
                                    <tr class="hover:bg-slate-50/80 transition-colors">
                                        <td class="py-2.5 px-3 font-semibold text-slate-900">@ChartHelper.MonthYear(DateOnly.FromDateTime(periods[i]))</td>
                                        @foreach (var line in trendSeries) {
                                            <td class="py-2.5 px-3 text-right">@(i < line.Values.Count ? line.Values[i] : 0)</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            </article>

            <!-- SAĞ: TALEP TÜRÜ DAĞILIMI (DOUGHNUT) -->
            <article class="lg:col-span-5 card bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs flex flex-col justify-between">
                <div class="flex items-center justify-between pb-3 mb-3 sm:mb-4 border-b border-slate-100">
                    <div>
                        <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                            <svg class="w-4 h-4 text-blue-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a10 10 0 0 1 10 10h-10z"></path></svg>
                            <span>Talep Türü &amp; Metot Dağılımı</span>
                        </h2>
                        <p class="text-xs text-slate-500 mt-0.5">Taleplerin yöntemlerine göre oransal ağırlığı</p>
                    </div>
                </div>

                <div class="flex flex-col items-center gap-4">
                    <div class="donut-canvas-wrap">
                        <canvas id="typeDonutCanvas"></canvas>
                        <div class="donut-center-stat">
                            <span class="block text-lg sm:text-xl font-extrabold text-slate-900">@typeTotal.ToString("N0", ChartHelper.Tr)</span>
                            <span class="text-[10px] sm:text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Toplam Talep</span>
                        </div>
                    </div>

                    <div class="w-full space-y-2 mt-2">
                        @for (var i = 0; i < types.Count; i++) {
                            var row = types[i];
                            var color = palette[i % palette.Length];
                            var label = string.IsNullOrWhiteSpace(row.RequestType) ? "Belirtilmemiş" : row.RequestType;

                            <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200/80">
                                <div class="flex items-center justify-between text-xs mb-1">
                                    <div class="flex items-center gap-2 font-semibold text-slate-700 min-w-0">
                                        <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background: @color;"></span>
                                        <span class="truncate">@label</span>
                                    </div>
                                    <div class="font-bold text-slate-900 shrink-0 ml-2">
                                        @row.RequestCount.ToString("N0", ChartHelper.Tr)
                                        <span class="text-[11px] font-normal text-slate-400 ml-1">(@ChartHelper.Percent((double)row.SharePercent, 1))</span>
                                    </div>
                                </div>
                                <div class="w-full h-1.5 bg-slate-200 rounded-full overflow-hidden">
                                    <div class="h-full rounded-full transition-all" style="width: @((double)row.SharePercent)%; background: @color;"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </article>
        </section>

        <!-- ==================== 4. KATALOG, KATEGORİ & MARKA ANALİZİ ==================== -->
        <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 bi-section-el" id="sec-catalog">

            <!-- SOL: KATEGORİ KIRILIMI & FİYAT ANALİZİ -->
            <article class="lg:col-span-7 card bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs flex flex-col justify-between">
                <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
                    <div>
                        <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                            <svg class="w-4 h-4 text-blue-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
                            <span>Kategori Bazında Portföy &amp; Fiyat İstatistikleri</span>
                        </h2>
                        <p class="text-xs text-slate-500 mt-0.5">Kategorilerin stok değerleri, ürün adetleri ve fiyat aralıkları</p>
                    </div>
                </div>

                <!-- Masaüstü Tablo Görünümü (>= 768px) -->
                <div class="hidden md:block overflow-x-auto border border-slate-200/80 rounded-xl">
                    <table class="dash-table w-full text-left text-xs" id="categoriesAnalyticsTable">
                        <thead class="bg-slate-50 text-slate-500 font-bold uppercase tracking-wider text-[11px]">
                            <tr>
                                <th class="py-3 px-3.5">Kategori</th>
                                <th class="py-3 px-3.5 text-right">Ürün Çeşidi</th>
                                <th class="py-3 px-3.5 text-right">Stok Hacmi</th>
                                <th class="py-3 px-3.5 text-right">Ortalama Fiyat</th>
                                <th class="py-3 px-3.5 text-right">Portföy Değeri</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-slate-700">
                            @foreach (var cat in categories) {
                                <tr class="hover:bg-slate-50/80 transition-colors">
                                    <td class="py-3 px-3.5 font-bold text-slate-900">@cat.CategoryName</td>
                                    <td class="py-3 px-3.5 text-right">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 font-semibold text-[11px]">
                                            @cat.ItemCount.ToString("N0", ChartHelper.Tr) Ürün
                                        </span>
                                    </td>
                                    <td class="py-3 px-3.5 text-right font-medium">@((cat.TotalQuantity ?? 0).ToString("N0", ChartHelper.Tr)) Adet</td>
                                    <td class="py-3 px-3.5 text-right font-semibold text-blue-600">@ChartHelper.Money(cat.AvgPrice ?? 0)</td>
                                    <td class="py-3 px-3.5 text-right font-bold text-emerald-600">@ChartHelper.Money(cat.StockValue ?? 0)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Mobil Kompakt Liste Görünümü (< 768px - Sadece Ayırt Edici Bilgiler) -->
                <div class="block md:hidden space-y-2" id="categoriesMobileList">
                    @foreach (var cat in categories) {
                        <div class="category-mobile-card p-3 rounded-xl bg-slate-50 hover:bg-blue-50/50 border border-slate-200/80 transition-all cursor-pointer active:scale-[0.99]"
                             onclick="openCategoryQuickModalFromEl(this)"
                             data-cat-name="@cat.CategoryName"
                             data-cat-items="@cat.ItemCount.ToString("N0", ChartHelper.Tr)"
                             data-cat-qty="@((cat.TotalQuantity ?? 0).ToString("N0", ChartHelper.Tr))"
                             data-cat-avg="@ChartHelper.Money(cat.AvgPrice ?? 0)"
                             data-cat-val="@ChartHelper.Money(cat.StockValue ?? 0)">
                            <div class="flex items-center justify-between gap-2">
                                <div class="flex items-center gap-2.5 min-w-0">
                                    <div class="w-8 h-8 rounded-lg bg-blue-100/80 text-blue-700 flex items-center justify-center shrink-0 text-sm font-bold">
                                        📁
                                    </div>
                                    <div class="min-w-0">
                                        <h3 class="text-xs font-bold text-slate-900 truncate">@cat.CategoryName</h3>
                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-slate-200/70 text-slate-700 mt-0.5">
                                            @cat.ItemCount.ToString("N0", ChartHelper.Tr) Çeşit
                                        </span>
                                    </div>
                                </div>
                                <div class="text-right shrink-0">
                                    <span class="block text-xs font-bold text-emerald-600">@ChartHelper.Money(cat.StockValue ?? 0)</span>
                                    <span class="text-[10px] font-semibold text-blue-600 flex items-center justify-end gap-0.5 mt-0.5">
                                        Detay <span>→</span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                    @if (categories.Count == 0) {
                        <div class="p-4 text-center text-xs text-slate-400 bg-slate-50 rounded-xl border border-dashed border-slate-200">
                            Kayıtlı kategori verisi bulunmuyor.
                        </div>
                    }
                </div>
            </article>

            <!-- SAĞ: EN POPÜLER MARKALAR -->
            <article class="lg:col-span-5 card bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs flex flex-col justify-between">
                <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
                    <div>
                        <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                            <svg class="w-4 h-4 text-blue-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                            <span>Marka Dağılımı &amp; Lider Üreticiler</span>
                        </h2>
                        <p class="text-xs text-slate-500 mt-0.5">Katalogdaki en yüksek ürün adedine sahip ilk @brands.Count marka</p>
                    </div>
                </div>

                <div class="space-y-2.5">
                    @{
                        var maxBrandItems = brands.Count > 0 ? brands.Max(b => b.ItemCount) : 1;
                        if (maxBrandItems <= 0) maxBrandItems = 1;
                    }
                    @for (var i = 0; i < brands.Count; i++) {
                        var b = brands[i];
                        var pct = Math.Round((double)b.ItemCount / maxBrandItems * 100);
                        var rankBg = i == 0 ? "bg-amber-100 text-amber-800" : i == 1 ? "bg-slate-200 text-slate-800" : i == 2 ? "bg-orange-100 text-orange-800" : "bg-slate-100 text-slate-600";
                        var brandName = string.IsNullOrWhiteSpace(b.Brand) ? "Markasız / Diğer" : b.Brand;

                        <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200/80 hover:bg-slate-100/60 transition-colors cursor-pointer active:scale-[0.99]"
                             onclick="openBrandQuickModalFromEl(this)"
                             data-brand-name="@brandName"
                             data-brand-rank="#@(i + 1)"
                             data-brand-items="@b.ItemCount.ToString("N0", ChartHelper.Tr)"
                             data-brand-val="@ChartHelper.Compact(b.StockValue ?? 0)"
                             data-brand-pct="@pct">
                            <div class="flex items-center justify-between text-xs mb-1.5">
                                <div class="flex items-center gap-2 min-w-0">
                                    <span class="inline-flex items-center justify-center w-5 h-5 rounded-md text-[11px] font-extrabold shrink-0 @rankBg">#@(i + 1)</span>
                                    <strong class="text-slate-900 font-bold truncate">@brandName</strong>
                                </div>
                                <div class="text-right shrink-0">
                                    <span class="font-bold text-blue-600">@b.ItemCount Adet</span>
                                    <span class="text-[11px] text-slate-400 ml-1">(@ChartHelper.Compact(b.StockValue ?? 0))</span>
                                </div>
                            </div>
                            <div class="w-full h-1.5 bg-slate-200 rounded-full overflow-hidden">
                                <div class="h-full bg-blue-600 rounded-full transition-all" style="width: @pct%;"></div>
                            </div>
                        </div>
                    }
                </div>
            </article>
        </section>

        <!-- ==================== 5. TEDARİKÇİ KARNESİ ==================== -->
        <section class="card bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs bi-section-el" id="sec-vendors">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 mb-4 border-b border-slate-100">
                <div>
                    <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                        <svg class="w-4 h-4 text-blue-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
                        <span>Tedarikçi Başarı Karnesi &amp; Güvenilirlik Skoru</span>
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">
                        Firmaların talep karşılama performansı, değerlendirme ortalamaları ve güvenilirlik durumu.
                    </p>
                </div>

                <div class="flex items-center gap-2 flex-wrap w-full sm:w-auto">
                    <!-- Arama Çubuğu -->
                    <div class="relative flex-1 sm:flex-initial">
                        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-slate-400 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <input type="text" id="vendorScoreSearchInput" placeholder="Tedarikçi firma ara..." class="w-full sm:w-48 pl-8 pr-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all" oninput="filterVendorTable(this.value)" />
                    </div>

                    <!-- Güvenilirlik Filtresi -->
                    <select id="vendorReliableFilter" onchange="filterVendorTable()" class="px-2.5 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold text-slate-700 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all">
                        <option value="all">Tüm Durumlar</option>
                        <option value="reliable">Güvenilir</option>
                        <option value="insufficient">İncelemede</option>
                    </select>
                </div>
            </div>

            <!-- Masaüstü Tablo (>= 768px) -->
            <div class="hidden md:block overflow-x-auto border border-slate-200/80 rounded-xl">
                <table class="dash-table w-full text-left text-xs" id="vendorScorecardTable">
                    <thead class="bg-slate-50 text-slate-500 font-bold uppercase tracking-wider text-[11px]">
                        <tr>
                            <th class="py-3 px-3.5">Firma Unvanı</th>
                            <th class="py-3 px-3.5">Kurumsal Tür</th>
                            <th class="py-3 px-3.5 text-right">Alınan Talep</th>
                            <th class="py-3 px-3.5 text-right">Puan Ortalaması</th>
                            <th class="py-3 px-3.5 text-right">Değerlendirme</th>
                            <th class="py-3 px-3.5">Güvenilirlik Durumu</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        @foreach (var row in vendors) {
                            <tr class="vendor-data-row hover:bg-slate-50/80 transition-colors" data-name="@(row.CompanyName?.ToLowerInvariant() ?? "")" data-reliable="@(row.HasReliableScore ? "reliable" : "insufficient")">
                                <td class="py-3 px-3.5">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-7 h-7 rounded-lg bg-blue-50 text-blue-600 font-extrabold text-xs flex items-center justify-center shrink-0">
                                            @((row.CompanyName?.Length > 0 ? row.CompanyName.Substring(0, 1).ToUpperInvariant() : "F"))
                                        </div>
                                        <strong class="text-slate-900 font-bold">@row.CompanyName</strong>
                                    </div>
                                </td>
                                <td class="py-3 px-3.5 text-slate-500 font-medium">@(row.CompanyTypeName ?? "—")</td>
                                <td class="py-3 px-3.5 text-right font-bold text-blue-600">@row.ReceivedRequests.ToString("N0", ChartHelper.Tr)</td>
                                <td class="py-3 px-3.5 text-right">
                                    @if (row.AvgScore is decimal sc) {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-amber-50 text-amber-700 border border-amber-200 font-bold text-[11px]">
                                            ★ @ChartHelper.Score((double)sc) / 5.0
                                        </span>
                                    } else {
                                        <span class="text-slate-400">—</span>
                                    }
                                </td>
                                <td class="py-3 px-3.5 text-right font-medium text-slate-600">
                                    @row.ReviewCount.ToString("N0", ChartHelper.Tr) Yorum
                                </td>
                                <td class="py-3 px-3.5">
                                    @if (row.HasReliableScore) {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <svg class="w-3 h-3 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                            Güvenilir
                                        </span>
                                    } else {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                                            <svg class="w-3 h-3 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="9"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                                            İncelemede
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobil Kompakt Kartlar (< 768px - Sadece Ayırt Edici Bilgiler) -->
            <div class="block md:hidden space-y-2.5" id="vendorScorecardMobileList">
                @foreach (var row in vendors) {
                    <div class="vendor-mobile-card p-3 rounded-xl bg-slate-50 hover:bg-blue-50/50 border border-slate-200/80 transition-all cursor-pointer active:scale-[0.99]"
                         data-name="@(row.CompanyName?.ToLowerInvariant() ?? "")"
                         data-reliable="@(row.HasReliableScore ? "reliable" : "insufficient")"
                         onclick="openVendorQuickModalFromEl(this)"
                         data-vendor-name="@row.CompanyName"
                         data-vendor-type="@(row.CompanyTypeName ?? "Belirtilmemiş")"
                         data-vendor-requests="@row.ReceivedRequests.ToString("N0", ChartHelper.Tr)"
                         data-vendor-score="@(row.AvgScore is decimal sc ? ChartHelper.Score((double)sc) : "—")"
                         data-vendor-reviews="@row.ReviewCount.ToString("N0", ChartHelper.Tr)"
                         data-vendor-reliable="@(row.HasReliableScore ? "true" : "false")">
                        <div class="flex items-center justify-between gap-2">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <div class="w-8 h-8 rounded-lg bg-blue-600 text-white font-black text-xs flex items-center justify-center shrink-0 shadow-xs">
                                    @((row.CompanyName?.Length > 0 ? row.CompanyName.Substring(0, 1).ToUpperInvariant() : "F"))
                                </div>
                                <div class="min-w-0">
                                    <h3 class="text-xs font-bold text-slate-900 truncate">@row.CompanyName</h3>
                                    <div class="flex items-center gap-1.5 mt-0.5">
                                        @if (row.AvgScore is decimal sc2) {
                                            <span class="inline-flex items-center px-1.5 py-0.2 rounded text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                                ★ @ChartHelper.Score((double)sc2)
                                            </span>
                                        }
                                        <span class="text-[10px] text-slate-400">@row.ReceivedRequests Talep</span>
                                    </div>
                                </div>
                            </div>
                            <div class="text-right shrink-0">
                                @if (row.HasReliableScore) {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        <svg class="w-2.5 h-2.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                        Güvenilir
                                    </span>
                                } else {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                                        İncelemede
                                    </span>
                                }
                                <span class="text-[10px] font-semibold text-blue-600 flex items-center justify-end gap-0.5 mt-1">
                                    Detay <span>→</span>
                                </span>
                            </div>
                        </div>
                    </div>
                }
                <div id="vendorMobileEmptyState" class="hidden p-4 text-center text-xs text-slate-400 bg-slate-50 rounded-xl border border-dashed border-slate-200">
                    Arama kriterine uygun tedarikçi bulunamadı.
                </div>
            </div>
        </section>

        <!-- ==================== 6. BÖLGESEL DAĞILIM ==================== -->
        <section class="bi-section-el" id="sec-corporate">
            <!-- BÖLGESEL / COĞRAFİ DAĞILIM -->
            <article class="card bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs flex flex-col justify-between">
                <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
                    <div>
                        <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                            <svg class="w-4 h-4 text-blue-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                            <span>Bölgesel &amp; Coğrafi Firma Dağılımı</span>
                        </h2>
                        <p class="text-xs text-slate-500 mt-0.5">Platformda kayıtlı kurumsal firmaların şehir ve ülke bazındaki yoğunluğu</p>
                    </div>
                </div>

                <div class="space-y-2">
                    @{
                        var topRegions = regions.Take(8).ToList();
                        var maxRegCount = topRegions.Count > 0 ? topRegions.Max(r => r.CompanyCount) : 1;
                        if (maxRegCount <= 0) maxRegCount = 1;
                    }
                    @if (topRegions.Count == 0) {
                        <p class="text-xs text-slate-400 text-center py-6">Kayıtlı bölge verisi bulunamadı.</p>
                    } else {
                        @foreach (var reg in topRegions) {
                            var pct = Math.Round((double)reg.CompanyCount / maxRegCount * 100);
                            <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200/80">
                                <div class="flex items-center justify-between text-xs mb-1">
                                    <div class="flex items-center gap-1.5 font-semibold text-slate-800 min-w-0">
                                        <svg class="w-3.5 h-3.5 text-blue-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                        <span class="truncate">@(string.IsNullOrWhiteSpace(reg.TownName) ? "Belirtilmemiş Şehir" : reg.TownName) · @(reg.CountryName ?? "Türkiye")</span>
                                    </div>
                                    <span class="font-bold text-emerald-600 shrink-0 ml-2">@reg.CompanyCount.ToString("N0", ChartHelper.Tr) Firma</span>
                                </div>
                                <div class="w-full h-1.5 bg-slate-200 rounded-full overflow-hidden">
                                    <div class="h-full bg-emerald-600 rounded-full transition-all" style="width: @pct%;"></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </article>
        </section>
    }
</div>

