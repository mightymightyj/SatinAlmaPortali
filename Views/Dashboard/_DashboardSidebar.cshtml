@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    var activeCompany = User.FindFirst("CompanyName")?.Value ?? (User.Identity?.IsAuthenticated == true ? User.Identity.Name : "HEB");

    var isGenelBakis = currentController == "Dashboard" && (currentAction == "Index" || currentAction == "Buyer" || currentAction == "Supplier");
    var isOrders = currentController == "Dashboard" && currentAction == "Orders";
    var isSupplierOrders = currentController == "Dashboard" && currentAction == "SupplierOrders";
    var isRequests = currentController == "Requests";
    var isListings = currentController == "Dashboard" && currentAction == "Listings";
    var isAnalytics = currentController == "Dashboard" && currentAction == "Analytics";
    var isFeedback = currentController == "Dashboard" && currentAction == "Feedback";
    var isProfile = currentController == "Account" && currentAction == "Profile";
}

<!-- Mobil Kenar Çubuğu Karartma Arka Planı (Backdrop) -->
<div id="sidebarBackdrop" class="sidebar-backdrop fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-40 hidden md:hidden transition-opacity duration-300 opacity-0 pointer-events-none" onclick="closeDashboardSidebar()" aria-hidden="true"></div>

<!-- ==================== SOL KENAR ÇUBUĞU (DOLGUN & OKUNABİLİR SIDEBAR) ==================== -->
<aside id="dashboardSidebar" class="app-sidebar fixed inset-y-0 left-0 z-50 w-64 bg-white border-r border-slate-200/90 flex flex-col h-screen shadow-lg md:shadow-xs -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out" aria-label="Panel menüsü">
    <!-- Logo & Üst Başlık -->
    <div class="side-brand-container px-4 pt-5 pb-3 border-b border-slate-100 flex flex-col gap-3">
        <div class="flex items-center justify-between">
            <a class="side-brand flex items-center gap-2.5 text-decoration-none group" asp-controller="Home" asp-action="Index">
                <span class="side-brand-mark w-9 h-9 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-700 text-white flex items-center justify-center shadow-sm shadow-blue-500/25 group-hover:scale-105 transition-transform shrink-0">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" aria-hidden="true">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                </span>
                <span class="side-brand-text text-[17px] font-extrabold tracking-tight text-slate-900">
                    tedarik<span class="text-blue-600 font-black">.portal</span>
                </span>
            </a>
            <!-- Mobil Kapatma Butonu -->
            <button type="button" class="md:hidden p-1.5 -mr-1 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors cursor-pointer" onclick="closeDashboardSidebar()" aria-label="Menüyü Kapat" title="Kapat">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <!-- Şirket Bilgi Rozeti -->
        <div class="side-company-pill px-3 py-2 rounded-lg bg-slate-50 border border-slate-200/90 flex items-center gap-2 text-xs text-slate-700 font-semibold" title="Aktif Şirket: @activeCompany">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="text-blue-600 shrink-0" aria-hidden="true">
                <path d="M3 21h18M3 7v14M21 7v14M6 3h12v4H6zM9 11h2v2H9zM13 11h2v2h-2zM9 15h2v2H9zM13 15h2v2h-2z"></path>
            </svg>
            <span class="company-name-text font-bold truncate tracking-tight text-slate-800">@activeCompany</span>
        </div>
    </div>

    <!-- ==================== MENÜ LİNKLERİ ==================== -->
    <nav class="side-nav flex-1 px-3 py-3 space-y-1 overflow-y-auto">
        <a class="side-link group flex items-center gap-3 px-3 py-2.5 rounded-lg text-[13.5px] transition-all @(isGenelBakis ? "is-active bg-blue-50 text-blue-700 font-bold shadow-xs" : "text-slate-700 font-semibold hover:text-slate-900 hover:bg-slate-100/90")" 
           asp-controller="Dashboard" asp-action="Index">
            <svg class="w-[18px] h-[18px] shrink-0 transition-colors @(isGenelBakis ? "text-blue-600" : "text-slate-500 group-hover:text-slate-800")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            <span>Genel Bakış</span>
        </a>

        <a class="side-link group flex items-center gap-3 px-3 py-2.5 rounded-lg text-[13.5px] transition-all @(isOrders ? "is-active bg-blue-50 text-blue-700 font-bold shadow-xs" : "text-slate-700 font-semibold hover:text-slate-900 hover:bg-slate-100/90")" 
           asp-controller="Dashboard" asp-action="Orders">
            <svg class="w-[18px] h-[18px] shrink-0 transition-colors @(isOrders ? "text-blue-600" : "text-slate-500 group-hover:text-slate-800")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            <span>Siparişlerim &amp; Satın Alınanlar</span>
        </a>

        <a class="side-link group flex items-center gap-3 px-3 py-2.5 rounded-lg text-[13.5px] transition-all @(isSupplierOrders ? "is-active bg-blue-50 text-blue-700 font-bold shadow-xs" : "text-slate-700 font-semibold hover:text-slate-900 hover:bg-slate-100/90")" 
           asp-controller="Dashboard" asp-action="SupplierOrders">
            <svg class="w-[18px] h-[18px] shrink-0 transition-colors @(isSupplierOrders ? "text-blue-600" : "text-slate-500 group-hover:text-slate-800")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="1" y="3" width="15" height="13"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
            <span>Gelen Siparişler &amp; Sevkiyat</span>
        </a>

        <a class="side-link group flex items-center gap-3 px-3 py-2.5 rounded-lg text-[13.5px] transition-all @(isRequests ? "is-active bg-blue-50 text-blue-700 font-bold shadow-xs" : "text-slate-700 font-semibold hover:text-slate-900 hover:bg-slate-100/90")" 
           asp-controller="Requests" asp-action="Index">
            <svg class="w-[18px] h-[18px] shrink-0 transition-colors @(isRequests ? "text-blue-600" : "text-slate-500 group-hover:text-slate-800")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="9" y1="15" x2="15" y2="15"></line>
            </svg>
            <span>Talepler &amp; İhaleler</span>
        </a>

        <a class="side-link group flex items-center gap-3 px-3 py-2.5 rounded-lg text-[13.5px] transition-all @(isListings ? "is-active bg-blue-50 text-blue-700 font-bold shadow-xs" : "text-slate-700 font-semibold hover:text-slate-900 hover:bg-slate-100/90")" 
           asp-controller="Dashboard" asp-action="Listings">
            <svg class="w-[18px] h-[18px] shrink-0 transition-colors @(isListings ? "text-blue-600" : "text-slate-500 group-hover:text-slate-800")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
            <span>Ürün İlanlarım</span>
        </a>
        
        <a class="side-link group flex items-center gap-3 px-3 py-2.5 rounded-lg text-[13.5px] transition-all @(isAnalytics ? "is-active bg-blue-50 text-blue-700 font-bold shadow-xs" : "text-slate-700 font-semibold hover:text-slate-900 hover:bg-slate-100/90")" 
           asp-controller="Dashboard" asp-action="Analytics">
            <svg class="w-[18px] h-[18px] shrink-0 transition-colors @(isAnalytics ? "text-blue-600" : "text-slate-500 group-hover:text-slate-800")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
            <span>Sistem Analitiği</span>
        </a>

        <a class="side-link group flex items-center gap-3 px-3 py-2.5 rounded-lg text-[13.5px] transition-all @(isFeedback ? "is-active bg-blue-50 text-blue-700 font-bold shadow-xs" : "text-slate-700 font-semibold hover:text-slate-900 hover:bg-slate-100/90")" 
           asp-controller="Dashboard" asp-action="Feedback">
            <svg class="w-[18px] h-[18px] shrink-0 transition-colors @(isFeedback ? "text-blue-600" : "text-slate-500 group-hover:text-slate-800")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            <span>Geri Bildirim</span>
        </a>

        <a class="side-link group flex items-center gap-3 px-3 py-2.5 rounded-lg text-[13.5px] transition-all @(isProfile ? "is-active bg-blue-50 text-blue-700 font-bold shadow-xs" : "text-slate-700 font-semibold hover:text-slate-900 hover:bg-slate-100/90")" 
           asp-controller="Account" asp-action="Profile">
            <svg class="w-[18px] h-[18px] shrink-0 transition-colors @(isProfile ? "text-blue-600" : "text-slate-500 group-hover:text-slate-800")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
            <span>Hesabım &amp; Ayarlar</span>
        </a>
    </nav>

    <!-- Alt Bağlantı -->
    <div class="side-foot p-3 border-t border-slate-100 mt-auto">
        <a class="side-link group flex items-center gap-3 px-3 py-2.5 rounded-lg text-[13.5px] font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-100/90 transition-colors" asp-controller="Home" asp-action="Index">
            <svg class="w-[18px] h-[18px] shrink-0 text-slate-500 group-hover:text-slate-800 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M19 12H5"></path>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Siteye Dön</span>
        </a>
    </div>
</aside>
