@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentTab = Context.Request.Query["tab"].ToString();

    var activeCompany = User.FindFirst("CompanyName")?.Value ?? (User.Identity?.IsAuthenticated == true ? User.Identity.Name : "HEB");
    var activeUser = User.Identity?.Name ?? "HEB (user)";
    var userType = User.FindFirst("UserType")?.Value ?? "user";
    var avatarInitials = !string.IsNullOrEmpty(activeCompany) && activeCompany.Length >= 2 
        ? activeCompany.Substring(0, 2).ToUpper() 
        : (!string.IsNullOrEmpty(activeCompany) ? activeCompany.ToUpper() : "HE");
    var currentCompanyId = User.FindFirst("CompanyID")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
}
<!DOCTYPE html>
<html lang="tr" class="bg-slate-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tedarik Portalı</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <!-- Tailwind CSS CDN & Custom Config -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e',
                            950: '#082f49',
                        }
                    },
                    boxShadow: {
                        'xs': '0 1px 2px 0 rgba(0, 0, 0, 0.04)',
                        'card': '0 1px 3px 0 rgba(0, 0, 0, 0.05), 0 1px 2px -1px rgba(0, 0, 0, 0.05)',
                        'lift': '0 4px 12px 0 rgba(15, 23, 42, 0.05), 0 1px 3px 0 rgba(15, 23, 42, 0.05)',
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="app-body bg-slate-50 text-slate-700 antialiased font-sans min-h-screen" data-current-company-id="@currentCompanyId" data-current-company-name="@activeCompany">
    <script>
        window.CURRENT_USER_COMPANY_ID = "@currentCompanyId";
        window.CURRENT_USER_COMPANY_NAME = "@Html.Raw((activeCompany ?? "").Replace("\"", "\\\""))";
    </script>

    <a class="skip-link sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-blue-600 focus:text-white focus:rounded-lg focus:shadow-lg" href="#dash-main">İçeriğe atla</a>

    <!-- ==================== SOL KENAR ÇUBUĞU (PARTIAL VIEW) ==================== -->
    <partial name="~/Views/Shared/_DashboardSidebar.cshtml" />

    <div class="app-shell flex-1 flex flex-col min-w-0 bg-slate-50 min-h-screen md:ml-64">

        <!-- ==================== ÜST ÇUBUK (LIGHT & BLUR TOPBAR) ==================== -->
        <header class="app-topbar sticky top-0 z-30 h-16 bg-white/90 backdrop-blur-md border-b border-slate-200/80 px-3 sm:px-6 lg:px-8 flex items-center justify-between gap-2.5 sm:gap-4 shadow-xs">
            <div class="flex items-center gap-2 sm:gap-3 flex-1 max-w-md min-w-0">
                <!-- Mobil Hamburger Menü Butonu -->
                <button type="button" 
                        class="md:hidden p-2 -ml-1 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500/20 transition-colors shrink-0 cursor-pointer" 
                        onclick="toggleDashboardSidebar()" 
                        aria-label="Menüyü Aç" 
                        title="Menüyü Aç">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>

                <!-- Arama Alanı -->
                <form class="top-search relative w-full flex items-center" role="search" onsubmit="return false;">
                    <svg class="absolute left-3 w-4 h-4 text-slate-400 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="search" 
                           id="topSearchInput"
                           class="w-full pl-9 pr-3 py-1.5 bg-slate-50/90 hover:bg-slate-100/90 focus:bg-white border border-slate-200 rounded-lg text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
                           placeholder="Talep veya sipariş ara..." 
                           aria-label="Ara" />
                </form>
            </div>

            <!-- Sağ Aksiyonlar & Profil -->
            <div class="top-actions flex items-center gap-2 sm:gap-3 shrink-0">
                <!-- Bildirim Zili -->
                <button class="top-icon-btn p-2 rounded-lg text-slate-500 hover:text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500/20 transition-colors relative cursor-pointer" type="button" aria-label="Bildirimler" onclick="toggleNotificationDropdown()" title="Bildirimler">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                </button>

                <!-- Ana CTA Butonu (Mobilde alt mobil barda vurgulu buton olarak yer alır) -->
                <button class="btn-primary hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white text-xs font-bold shadow-xs shadow-blue-600/20 transition-all cursor-pointer" type="button" onclick="openRequestModal()">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span>+ Yeni Talep Oluştur</span>
                </button>

                <!-- Profil Alanı (Tıklanabilir Bağlantı) -->
                <a asp-controller="Account" asp-action="Profile" class="top-profile flex items-center gap-2 pl-2.5 sm:pl-3 border-l border-slate-200 text-decoration-none group" title="Hesap ve Profil Ayarları">
                    <span class="top-avatar w-8 h-8 rounded-lg bg-gradient-to-tr from-blue-600 to-indigo-600 text-white font-bold text-xs flex items-center justify-center shadow-xs group-hover:scale-105 transition-transform" aria-hidden="true">@avatarInitials</span>
                    <span class="top-profile-text hidden sm:flex flex-col text-left">
                        <strong class="text-xs font-semibold text-slate-800 leading-tight group-hover:text-blue-600 transition-colors">@activeCompany</strong>
                        <small class="text-[11px] text-slate-400 font-normal">@activeUser (@userType)</small>
                    </span>
                </a>
            </div>
        </header>

        <!-- ==================== ANA İÇERİK ALANI ==================== -->
        <main class="app-content flex-1 px-3 sm:px-6 lg:px-8 py-5 sm:py-6 pb-24 md:pb-8 w-full min-w-0" id="dash-main">
            @RenderBody()
        </main>
    </div>

    <!-- ==================== DASHBOARD MOBİL ALT GEZİNME BARI (BOTTOM NAVIGATION BAR) ==================== -->
    <nav id="dashboardBottomBar" class="dashboard-bottom-bar fixed bottom-0 inset-x-0 z-30 bg-white/95 backdrop-blur-md border-t border-slate-200 shadow-[0_-4px_16px_rgba(0,0,0,0.06)] md:hidden flex items-center justify-around px-2 py-1.5 safe-area-pb" aria-label="Mobil Hızlı Menü">
        <!-- 1. Genel Bakış -->
        <a asp-controller="Dashboard" asp-action="Index" 
           class="dash-bottom-item flex flex-col items-center justify-center flex-1 py-1 text-slate-500 hover:text-blue-600 transition-colors @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" && (ViewContext.RouteData.Values["action"]?.ToString() == "Index" || ViewContext.RouteData.Values["action"]?.ToString() == "Buyer" || ViewContext.RouteData.Values["action"]?.ToString() == "Supplier") ? "is-active text-blue-600 font-bold" : "text-slate-500 font-medium")" 
           title="Genel Bakış">
            <svg class="w-5 h-5 mb-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
            </svg>
            <span class="text-[10px] leading-tight">Genel Bakış</span>
        </a>

        <!-- 2. Talepler -->
        <a asp-controller="Requests" asp-action="Index" 
           class="dash-bottom-item flex flex-col items-center justify-center flex-1 py-1 text-slate-500 hover:text-blue-600 transition-colors @(ViewContext.RouteData.Values["controller"]?.ToString() == "Requests" ? "is-active text-blue-600 font-bold" : "text-slate-500 font-medium")" 
           title="Talepler &amp; İhaleler">
            <svg class="w-5 h-5 mb-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="9" y1="15" x2="15" y2="15"></line>
            </svg>
            <span class="text-[10px] leading-tight">Talepler</span>
        </a>

        <!-- 3. Orta Vurgulu Aksiyon Butonu (+ Yeni Talep) -->
        <button type="button" 
                class="dash-bottom-cta flex flex-col items-center justify-center -mt-5 px-2.5 py-0.5 text-white group cursor-pointer focus:outline-none" 
                onclick="openRequestModal()" 
                title="Yeni Satın Alma Talebi Oluştur" 
                aria-label="Yeni Talep Oluştur">
            <div class="cta-bubble w-12 h-12 rounded-full bg-gradient-to-tr from-blue-600 to-indigo-600 text-white flex items-center justify-center shadow-lg shadow-blue-600/35 group-hover:scale-105 group-active:scale-95 transition-transform">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
            </div>
            <span class="cta-label text-[10px] font-bold text-blue-600 mt-1">Yeni Talep</span>
        </button>

        <!-- 4. Siparişler -->
        <a asp-controller="Dashboard" asp-action="Orders" 
           class="dash-bottom-item flex flex-col items-center justify-center flex-1 py-1 text-slate-500 hover:text-blue-600 transition-colors @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" && (ViewContext.RouteData.Values["action"]?.ToString() == "Orders" || ViewContext.RouteData.Values["action"]?.ToString() == "SupplierOrders") ? "is-active text-blue-600 font-bold" : "text-slate-500 font-medium")" 
           title="Siparişler">
            <svg class="w-5 h-5 mb-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            <span class="text-[10px] leading-tight">Siparişler</span>
        </a>

        <!-- 5. Menü (Çekmece Açıcı) -->
        <button type="button" 
                class="dash-bottom-item flex flex-col items-center justify-center flex-1 py-1 text-slate-500 hover:text-blue-600 transition-colors font-medium cursor-pointer" 
                onclick="toggleDashboardSidebar()" 
                title="Tüm Menü" 
                aria-label="Tüm Menü">
            <svg class="w-5 h-5 mb-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
            <span class="text-[10px] leading-tight">Menü</span>
        </button>
    </nav>

    <!-- ==================== YENİ SATIN ALMA TALEBİ MODALI (DİNAMİK İSTENİLENLER LİSTESİ) ==================== -->
    <div id="requestModal" class="app-modal fixed inset-0 z-50 overflow-y-auto" aria-hidden="true" role="dialog" aria-modal="true">
        <div class="modal-backdrop fixed inset-0 bg-slate-900/50 backdrop-blur-xs transition-opacity" onclick="closeRequestModal()"></div>
        <div class="min-h-full flex items-center justify-center p-2 sm:p-4 md:p-8">
            <div class="modal-card is-extra-wide my-auto relative bg-white rounded-2xl shadow-2xl border border-slate-200/90 max-w-5xl w-full max-h-[92vh] sm:max-h-[88vh] flex flex-col overflow-hidden transform transition-all z-10">
                <div class="modal-head px-6 pt-6 pb-5 sm:px-8 sm:pt-7 sm:pb-5 border-b border-slate-100 flex items-start justify-between bg-slate-50/80">
                    <div class="modal-title-wrap flex items-start gap-3">
                        <span class="modal-badge-icon w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shadow-2xs shrink-0 mt-0.5">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                        </span>
                        <div>
                            <div class="mb-1.5">
                                <span class="status-badge badge-blue text-[11px] font-bold px-2 py-0.5 rounded-md">YENİ TALEP</span>
                            </div>
                            <h3 class="text-base font-extrabold text-slate-900">Satın Alma Talebi &amp; İstenilenler Listesi Oluştur</h3>
                        </div>
                    </div>
                    <button type="button" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-200/60 transition-colors cursor-pointer text-base leading-none shrink-0 ml-4 -mt-1 -mr-1" onclick="closeRequestModal()" aria-label="Kapat">✕</button>
                </div>
                <form id="buyerRequestForm" onsubmit="handleCreateRequestSubmit(event)" class="flex flex-col flex-1 min-h-0 overflow-hidden">
                    @Html.AntiForgeryToken()
                    <div class="modal-body p-6 overflow-y-auto space-y-4 text-xs min-h-0">
                        <!-- 1. TALEP BAŞLIĞI, KATEGORİ VE TERMİN -->
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-3">
                            <div class="form-group md:col-span-6">
                                <label class="form-label block text-xs font-semibold text-slate-700 mb-1.5" for="reqProductName">Talep Başlığı / Proje Adı <span class="req-star text-rose-500 font-bold">*</span></label>
                                <input type="text" id="reqProductName" class="form-control w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all" placeholder="Örn: Fabrika Elektrik & Bakım Malzemeleri Alımı" required />
                            </div>

                            <div class="form-group md:col-span-3">
                                <label class="form-label block text-xs font-semibold text-slate-700 mb-1.5" for="reqCategory">Kategori / Talep Tipi <span class="req-star text-rose-500 font-bold">*</span></label>
                                <select id="reqCategory" class="form-control w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all" required>
                                    <option value="Satın Alma">Satın Alma</option>
                                    <option value="Hammadde & Malzeme">Hammadde &amp; Malzeme</option>
                                    <option value="Makine & Yedek Parça">Makine &amp; Yedek Parça</option>
                                    <option value="Otomasyon & Elektrik">Otomasyon &amp; Elektrik</option>
                                    <option value="Lojistik & Ambalaj">Lojistik &amp; Ambalaj</option>
                                    <option value="Hizmet Tedariği">Hizmet Tedariği</option>
                                    <option value="Bilişim & Donanım">Bilişim &amp; Donanım</option>
                                </select>
                            </div>

                            <div class="form-group md:col-span-3">
                                <label class="form-label block text-xs font-semibold text-slate-700 mb-1.5" for="reqDeadline">Son Teklif / Termin</label>
                                <input type="date" id="reqDeadline" class="form-control w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" />
                            </div>
                        </div>

                        <!-- 2. DİNAMİK İSTENİLENLER LİSTESİ (KALEMLER TABLOSU) -->
                        <div class="items-builder-container border border-slate-200/90 rounded-xl bg-white shadow-2xs">
                            <div class="items-builder-header px-4 py-3 bg-slate-50/90 border-b border-slate-200 flex flex-wrap items-center justify-between gap-2">
                                <div>
                                    <div class="items-builder-title text-xs font-bold text-slate-800">
                                        <span>Talep Edilen Malzeme ve Hizmet Kalemleri (İstenilenler Listesi)</span>
                                    </div>
                                    <!-- Hızlı Şablonlar -->
                                    <div class="quick-templates-bar flex items-center gap-1.5 mt-1">
                                        <span class="text-[11px] text-slate-500">Örnek Yükle:</span>
                                        <button type="button" class="btn-quick-tpl px-2 py-0.5 rounded text-[11px] bg-slate-100 hover:bg-slate-200 text-slate-700 transition cursor-pointer" onclick="loadDashSampleTemplate('elektrik')">Elektrik &amp; Otomasyon</button>
                                        <button type="button" class="btn-quick-tpl px-2 py-0.5 rounded text-[11px] bg-slate-100 hover:bg-slate-200 text-slate-700 transition cursor-pointer" onclick="loadDashSampleTemplate('ofis')">Ofis &amp; Sarf</button>
                                        <button type="button" class="btn-quick-tpl px-2 py-0.5 rounded text-[11px] bg-slate-100 hover:bg-slate-200 text-slate-700 transition cursor-pointer" onclick="loadDashSampleTemplate('hirdavat')">Hırdavat &amp; Mekanik</button>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button type="button" class="btn-quick-tpl px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 transition cursor-pointer" onclick="addDashMultipleRequestItemRows(3)">+ 3 Satır Ekle</button>
                                    <button type="button" class="btn-add-item-row inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white shadow-xs transition cursor-pointer" onclick="addDashRequestItemRow()">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                            <line x1="12" y1="5" x2="12" y2="19"></line>
                                            <line x1="5" y1="12" x2="19" y2="12"></line>
                                        </svg>
                                        Yeni Kalem Ekle
                                    </button>
                                </div>
                            </div>

                            <!-- Kalemler Tablosu -->
                            <div class="items-table-scroll">
                                <table class="items-builder-table w-full text-left text-xs border-collapse" id="dashRequestItemsTable">
                                    <thead>
                                        <tr class="bg-slate-50 border-b border-slate-200 text-slate-600 font-semibold uppercase text-[11px]">
                                            <th class="w-8 text-center p-2.5">#</th>
                                            <th class="p-2.5">Malzeme / Hizmet Adı <span class="text-rose-500 font-bold">*</span></th>
                                            <th class="p-2.5 w-28">Miktar <span class="text-rose-500 font-bold">*</span></th>
                                            <th class="p-2.5 w-32">Tahmini Fiyat (₺)</th>
                                            <th class="p-2.5 w-32">Kalem Tutarı</th>
                                            <th class="p-2.5">Açıklama / Şartname</th>
                                            <th class="w-12 text-center p-2.5">Sil</th>
                                        </tr>
                                    </thead>
                                    <tbody id="dashRequestItemsTableBody" class="divide-y divide-slate-100">
                                        <!-- JavaScript ile doldurulacak -->
                                    </tbody>
                                </table>
                            </div>

                            <!-- Kalemler Özet Çubuğu -->
                            <div class="items-summary-strip px-4 py-2.5 bg-slate-50 border-t border-slate-200 flex flex-wrap items-center justify-between text-xs text-slate-600">
                                <div class="items-summary-metric">
                                    <span>Toplam Kalem:</span>
                                    <strong id="dashSummaryTotalItems" class="text-slate-800 ml-1 font-bold">0 Kalem</strong>
                                </div>
                                <div class="items-summary-metric">
                                    <span>Toplam Miktar:</span>
                                    <strong id="dashSummaryTotalQty" class="text-slate-800 ml-1 font-bold">0 Adet</strong>
                                </div>
                                <div class="items-summary-metric">
                                    <span>Tahmini Bütçe:</span>
                                    <strong id="dashSummaryTotalBudget" class="text-emerald-600 font-extrabold text-sm ml-1">0,00 ₺</strong>
                                </div>
                            </div>
                        </div>

                        <!-- 3. GENEL TEKNİK ŞARTNAME & NOTLAR -->
                        <div class="form-group">
                            <label class="form-label block text-xs font-semibold text-slate-700 mb-1.5" for="reqNotes">Genel Teknik Şartname &amp; Teslimat / Ödeme Koşulları</label>
                            <textarea id="reqNotes" class="form-control w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all" rows="2" placeholder="Tedarikçilerin teklif verirken dikkat etmesi gereken genel şartlar, nakliye/montaj durumu, garanti ve teslimat şartları..."></textarea>
                        </div>
                    </div>
                    <div class="modal-foot px-6 py-3.5 border-t border-slate-100 bg-slate-50/80 flex items-center justify-end gap-2.5">
                        <button type="button" class="btn-cancel px-4 py-2 rounded-lg text-xs font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 transition shadow-2xs cursor-pointer" onclick="closeRequestModal()">Vazgeç</button>
                        <button type="submit" id="dashCreateSubmitBtn" class="btn-primary px-4.5 py-2 rounded-lg text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white shadow-xs shadow-blue-600/20 transition cursor-pointer">Talebi Yayınla</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ==================== HIZLI FİYAT GÜNCELLEME MODALI (SUPPLIER) ==================== -->
    <div id="priceModal" class="app-modal fixed inset-0 z-50 overflow-y-auto" aria-hidden="true" role="dialog" aria-modal="true">
        <div class="modal-backdrop fixed inset-0 bg-slate-900/50 backdrop-blur-xs transition-opacity" onclick="closePriceModal()"></div>
        <div class="min-h-full flex items-center justify-center p-2 sm:p-4 md:p-8">
            <div class="modal-card my-auto relative bg-white rounded-2xl shadow-2xl border border-slate-200/90 max-w-lg w-full max-h-[92vh] sm:max-h-[88vh] flex flex-col overflow-hidden transform transition-all z-10">
                <div class="modal-head px-6 pt-6 pb-5 sm:px-7 sm:pt-7 sm:pb-5 border-b border-slate-100 flex items-start justify-between bg-slate-50/80">
                    <div class="modal-title-wrap flex items-start gap-3">
                        <span class="modal-badge-icon w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shadow-2xs shrink-0 mt-0.5">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                            </svg>
                        </span>
                        <div>
                            <div class="mb-1.5">
                                <span class="status-badge badge-blue text-[11px] font-bold px-2 py-0.5 rounded-md">HIZLI FİYAT</span>
                            </div>
                            <h3 class="text-base font-extrabold text-slate-900">Katalog Ürün Fiyatı Güncelle</h3>
                        </div>
                    </div>
                    <button type="button" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-200/60 transition-colors cursor-pointer text-base leading-none shrink-0 ml-4 -mt-1 -mr-1" onclick="closePriceModal()" aria-label="Kapat">✕</button>
                </div>
                <form id="supplierPriceForm" onsubmit="handlePriceUpdateSubmit(event)">
                    <input type="hidden" id="priceProductId" />
                    <div class="modal-body p-6 space-y-3.5 text-xs">
                        <div class="form-group">
                            <label class="form-label block text-xs font-semibold text-slate-700 mb-1.5" for="priceProductSelect">Ürün Seçin <span class="req-star text-rose-500 font-bold">*</span></label>
                            <select id="priceProductSelect" class="form-control w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all" required onchange="handleProductPriceSelect(this)">
                                <option value="" disabled selected>Katalogdan bir ürün seçin...</option>
                            </select>
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div class="form-group">
                                <label class="form-label block text-xs font-semibold text-slate-700 mb-1.5" for="newUnitPrice">Yeni Birim Fiyat (₺) <span class="req-star text-rose-500 font-bold">*</span></label>
                                <input type="number" id="newUnitPrice" class="form-control w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all font-semibold" placeholder="0.00" min="0.01" step="any" required />
                            </div>
                            <div class="form-group">
                                <label class="form-label block text-xs font-semibold text-slate-700 mb-1.5" for="newStockQty">Güncel Stok Adedi</label>
                                <input type="number" id="newStockQty" class="form-control w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all" placeholder="0" min="0" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label block text-xs font-semibold text-slate-700 mb-1.5" for="priceChangeNote">Güncelleme Gerekçesi / Not</label>
                            <input type="text" id="priceChangeNote" class="form-control w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all" placeholder="Örn: Hammadde maliyet artışı revizyonu" />
                        </div>
                    </div>
                    <div class="modal-foot px-6 py-3.5 border-t border-slate-100 bg-slate-50/80 flex items-center justify-end gap-2.5">
                        <button type="button" class="btn-cancel px-4 py-2 rounded-lg text-xs font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 transition shadow-2xs cursor-pointer" onclick="closePriceModal()">İptal</button>
                        <button type="submit" class="btn-primary px-4.5 py-2 rounded-lg text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white shadow-xs shadow-blue-600/20 transition cursor-pointer">Fiyatı Güncelle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ==================== GENEL TEDARİKÇİ ÇOKLU KALEM TEKLİF VERME MODALI ==================== -->
    <div class="custom-modal-backdrop fixed inset-0 z-50 overflow-y-auto" id="supplierBidModal" onclick="if(event.target === this) closeBidModal();">
        <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs transition-opacity" onclick="closeBidModal()"></div>
        <div class="min-h-full flex items-center justify-center p-2 sm:p-4 md:p-8">
            <div class="custom-modal-dialog is-extra-wide my-auto relative bg-white rounded-2xl shadow-2xl border border-slate-200/90 max-w-5xl w-full max-h-[92vh] sm:max-h-[88vh] flex flex-col overflow-hidden transform transition-all z-10">
                <div class="custom-modal-header px-6 pt-6 pb-5 sm:px-8 sm:pt-7 sm:pb-5 border-b border-slate-100 flex items-start justify-between bg-slate-50/80">
                    <div>
                        <div class="mb-2">
                            <span class="status-badge badge-emerald text-[11px] font-bold px-2 py-0.5 rounded-md">RFQ TEKLİF VERME</span>
                        </div>
                        <h3 class="custom-modal-title text-base font-extrabold text-slate-900 flex items-center gap-2">
                            <span id="bidModalTitleText">Talebe Kalem Bazlı Fiyat Teklifi Ver</span>
                        </h3>
                    </div>
                    <button type="button" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-200/60 transition-colors cursor-pointer text-base leading-none shrink-0 ml-4 -mt-1 -mr-1" onclick="closeBidModal()">&times;</button>
                </div>

                <form id="submitOfferForm" onsubmit="handleBidSubmit(event)" class="flex flex-col flex-1 overflow-hidden">
                    <input type="hidden" name="RequestID" id="bidRequestID" />
                    <input type="hidden" name="OfferedPrice" id="bidOfferedPrice" value="0" />

                    <div class="custom-modal-body p-6 overflow-y-auto space-y-4 text-xs">
                        <!-- Talep Üst Bilgi Kartı -->
                        <div class="p-4 bg-slate-50 border border-slate-200/90 rounded-xl flex items-center justify-between flex-wrap gap-2">
                            <div>
                                <span class="text-[11px] font-bold text-blue-600 uppercase tracking-wide" id="bidReqCodeBadge">Talep #REQ-0000</span>
                                <h4 id="bidProductTitle" class="text-slate-900 font-extrabold text-sm mt-0.5"></h4>
                                <div id="bidBuyerInfoSub" class="text-xs text-slate-500 mt-0.5"></div>
                            </div>
                            <div class="text-right">
                                <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wide">Hedef Teslim / Bütçe</span>
                                <div id="bidDeadlineBudgetSub" class="text-xs font-extrabold text-blue-600 mt-0.5"></div>
                            </div>
                        </div>

                        <!-- KALEM BAZLI FİYATLANDIRMA TABLOSU -->
                        <div class="bid-items-grid-container space-y-2">
                            <div class="flex items-center justify-between flex-wrap gap-2">
                                <span class="text-xs font-bold text-slate-800 flex items-center gap-1.5">
                                    Talep Edilen Malzemeler &amp; Kalem Birim Fiyat Teklifiniz (<span id="bidItemsCountBadge" class="text-blue-600 font-semibold">0 Kalem</span>)
                                </span>
                                <span class="text-[11px] text-slate-500">Her kalem için birim fiyat giriniz, toplam tutar otomatik hesaplanacaktır</span>
                            </div>

                            <div class="border border-slate-200/90 rounded-xl bg-white overflow-x-auto max-h-60 shadow-2xs">
                                <table class="bid-items-table w-full text-left text-xs border-collapse min-w-[620px]" id="bidItemsTable">
                                    <thead>
                                        <tr class="bg-slate-50 text-slate-600 border-b border-slate-200 font-semibold uppercase text-[11px]">
                                            <th class="w-8 text-center p-2.5">#</th>
                                            <th class="p-2.5">Talep Edilen Malzeme &amp; Şartname</th>
                                            <th class="p-2.5 w-24">Miktar</th>
                                            <th class="p-2.5 w-28">Alıcı Ref. Fiyat</th>
                                            <th class="p-2.5 w-36">Teklif B. Fiyat (₺) <span class="text-rose-500 font-bold">*</span></th>
                                            <th class="p-2.5 w-28">Kalem Tutarı</th>
                                            <th class="p-2.5">Kalem Notu / Stok</th>
                                        </tr>
                                    </thead>
                                    <tbody id="bidItemsTableBody" class="divide-y divide-slate-100">
                                        <!-- JavaScript ile doldurulacak -->
                                    </tbody>
                                </table>
                            </div>

                            <!-- Otomatik Hesaplanmış Toplam Teklif Hero Kartı -->
                            <div class="bid-summary-hero bg-emerald-50/70 border border-emerald-200/90 rounded-xl p-3.5 flex items-center justify-between text-xs">
                                <div>
                                    <span class="text-[11px] font-bold text-emerald-800 uppercase tracking-wide">Fiyatlandırılan Kalemler:</span>
                                    <div class="text-xs font-bold text-emerald-800 mt-0.5" id="bidPricedItemsSummary">0 / 0 Kalem Fiyatlandırıldı</div>
                                </div>
                                <div class="text-right">
                                    <span class="text-[11px] font-bold text-emerald-800 uppercase tracking-wide">Otomatik Genel Toplam (KDV Hariç):</span>
                                    <div class="bid-total-big-val text-base font-black text-emerald-700" id="bidCalculatedTotal">0,00 ₺</div>
                                </div>
                            </div>
                        </div>

                        <!-- 2. TESLİMAT SÜRESİ, GEÇERLİLİK VE TİCARİ ŞARTLAR -->
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-3">
                            <div class="form-group md:col-span-3">
                                <label class="modal-form-label block text-xs font-semibold text-slate-700 mb-1.5">
                                    Teslimat Süresi (Gün) <span class="text-rose-500 font-bold">*</span>
                                </label>
                                <input type="number" name="DeliveryDays" id="bidDeliveryDays" required min="1" max="365" value="7" class="form-control w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all font-semibold" />
                            </div>

                            <div class="form-group md:col-span-3">
                                <label class="modal-form-label block text-xs font-semibold text-slate-700 mb-1.5">
                                    Teklif Geçerlilik (Gün) <span class="text-rose-500 font-bold">*</span>
                                </label>
                                <input type="number" name="ValidityDays" id="bidValidityDays" required min="1" max="365" value="30" placeholder="Örn: 30" class="form-control w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all font-semibold" />
                            </div>

                            <div class="form-group md:col-span-6">
                                <label class="modal-form-label block text-xs font-semibold text-slate-700 mb-1.5">Tedarikçi Açıklaması &amp; Ticari Şartlar</label>
                                <textarea name="SupplierNotes" id="bidSupplierNotes" rows="2" placeholder="Nakliye firmamıza ait, 2 yıl garanti, peşin veya 30 gün vade..." class="form-control w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="modal-foot px-6 py-3.5 border-t border-slate-100 bg-slate-50/80 flex items-center justify-end gap-2.5">
                        <button type="button" class="btn-cancel px-4 py-2 rounded-lg text-xs font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 transition shadow-2xs cursor-pointer" onclick="closeBidModal()">Vazgeç</button>
                        <button type="submit" id="bidSubmitBtn" class="btn-primary px-4.5 py-2 rounded-lg text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-xs shadow-emerald-600/20 transition cursor-pointer">
                            Teklifi İlet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Toast Bildirim Kutusu -->
    <div id="appToast" class="app-toast fixed bottom-5 right-5 z-50 max-w-sm pointer-events-none transition-all duration-300 transform" role="alert" aria-live="polite"></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    <script src="~/js/realtime-portal.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
