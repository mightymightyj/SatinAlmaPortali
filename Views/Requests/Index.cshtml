    function exportCompareModalToCSV() {
        var table = document.getElementById('cmpModalTable');
        if (!table) return;

        var csv = [];
        for (var i = 0; i < table.rows.length; i++) {
            var row = [], cols = table.rows[i].querySelectorAll('td, th');
            for (var j = 0; j < cols.length - 1; j++) {
                var data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, ' ').replace(/"/g, '""').trim();
                row.push('"' + data + '"');
            }
            csv.push(row.join(';'));
        }

        var csvString = "\uFEFF" + csv.join('\n');
        var blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
        var link = document.createElement("a");
        var url = URL.createObjectURL(blob);
        link.setAttribute("href", url);
        link.setAttribute("download", "Tedarikci_Fiyat_Kiyaslama_Raporu.csv");
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    function escapeHtml(text) {
        if (!text) return '';
        var map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.replace(/[&<>"']/g, function(m) { return map[m]; });
    }
