    // =========================================================================
    // 4. TEDARİKÇİ FİYAT KIYASLAMA MODALI İŞLEMLERİ (AJAX & CHART.JS)
    // =========================================================================
    var cmpChartInstance = null;

    async function openCompareModal(requestId) {
        var modal = document.getElementById('priceCompareModal');
        var loading = document.getElementById('cmpLoading');
        var content = document.getElementById('cmpContent');
        var empty = document.getElementById('cmpEmpty');
        var tableBody = document.getElementById('cmpTableBody');

        if (!modal) return;

        modal.classList.add('is-open');
        loading.style.display = 'block';
        content.style.display = 'none';
        empty.style.display = 'none';
        tableBody.innerHTML = '';

        try {
            var response = await fetch('/Requests/GetComparisonData/' + requestId);
            var data = await response.json();

            if (!data.success) {
                alert('Kıyaslama verileri yüklenemedi: ' + data.message);
                closeCompareModal();
                return;
            }

            // 1. Talep Özet Şeridi Doldur
            document.getElementById('cmpReqCode').textContent = data.requestCode;
            document.getElementById('cmpProductName').textContent = data.productName;
            document.getElementById('cmpReqCategory').textContent = 'Kategori: ' + data.requestType;
            document.getElementById('cmpQuantity').textContent = data.quantity.toLocaleString('tr-TR') + ' Adet';
            document.getElementById('cmpBudget').textContent = data.estimatedBudgetFormatted;

            var statusBadge = document.getElementById('cmpStatusBadge');
            if (data.isApproved) {
                statusBadge.innerHTML = '<span class="badge-status is-approved" style="font-size: 0.82rem; padding: 4px 8px; font-weight: 700;">✓ Onaylandı (' + escapeHtml(data.winningSupplierName) + ')</span>';
            } else {
                statusBadge.innerHTML = '<span class="badge-status is-pending" style="font-size: 0.82rem; padding: 4px 8px; font-weight: 700;">⏳ ' + escapeHtml(data.status) + '</span>';
            }

            var notesWrap = document.getElementById('cmpNotesWrap');
            if (data.notes) {
                notesWrap.style.display = 'block';
                document.getElementById('cmpNotesText').textContent = data.notes;
            } else {
                notesWrap.style.display = 'none';
            }

            // Teklifler Var mı?
            if (!data.offers || data.offers.length === 0) {
                loading.style.display = 'none';
                empty.style.display = 'block';
                return;
            }

            // 2. KPI Rozetleri Doldur
            document.getElementById('cmpKpiLowestPrice').textContent = data.lowestPriceFormatted;
            document.getElementById('cmpKpiLowestSupplier').textContent = data.lowestSupplierName;

            document.getElementById('cmpKpiFastestDays').textContent = data.fastestDays + ' Gün';
            document.getElementById('cmpKpiFastestSupplier').textContent = data.fastestSupplierName;

            document.getElementById('cmpKpiSavings').textContent = data.budgetSavingsFormatted;
            document.getElementById('cmpKpiSavingsSub').textContent = data.hasBudget ? 'Hedef bütçeye kıyasla fark' : 'En pahalı teklife kıyasla tasarruf';

            document.getElementById('cmpKpiOfferCount').textContent = data.offerCount + ' Teklif';
            document.getElementById('cmpKpiAvgPrice').textContent = data.avgPriceFormatted;
            document.getElementById('cmpKpiUnitAvg').textContent = 'Kalem Başına: ~' + data.unitAvgPriceFormatted;

            document.getElementById('cmpTableMeta').textContent = data.offerCount + ' Tedarikçi Teklifi';

            // 3. Kıyaslama Tablosunu Doldur
            var tableHtml = '';
            data.offers.forEach(function(o) {
                var rowCls = o.isLowestPrice ? 'is-best-row' : '';
                tableHtml += '<tr class="' + rowCls + '">';

                // Tedarikçi
                var initial = o.supplierName && o.supplierName.length >= 2 ? o.supplierName.substring(0, 2).toUpperCase() : 'TF';
                tableHtml += '  <td>';
                tableHtml += '    <div style="display: flex; align-items: center; gap: 10px;">';
                tableHtml += '      <div class="cmp-sup-avatar">' + initial + '</div>';
                tableHtml += '      <div>';
                tableHtml += '        <strong style="color: #0F172A; font-size: 0.88rem; display: block;">' + escapeHtml(o.supplierName) + '</strong>';
                if (o.supplierOfficial) {
                    tableHtml += '        <div style="font-size: 0.74rem; color: #64748B;">Yetkili: ' + escapeHtml(o.supplierOfficial) + '</div>';
                }
                if (o.supplierPhone || o.supplierMail) {
                    tableHtml += '        <div style="font-size: 0.72rem; color: #94A3B8;">' + escapeHtml(o.supplierPhone || o.supplierMail) + '</div>';
                }
                if (o.isRevised) {
                    tableHtml += '        <div style="display: inline-flex; align-items: center; gap: 4px; background: #FEF3C7; color: #92400E; border: 1px solid #FCD34D; font-size: 0.70rem; font-weight: 700; padding: 1px 6px; border-radius: 4px; margin-top: 3px;" title="Reddedilen teklif tedarikçi tarafından güncellendi. ' + (o.previousPriceFormatted ? 'Önceki: ' + escapeHtml(o.previousPriceFormatted) : '') + '">🔄 Revize Edildi' + (o.previousPriceFormatted ? ' (<del>' + escapeHtml(o.previousPriceFormatted) + '</del>)' : '') + '</div>';
                }
                tableHtml += '      </div>';
                tableHtml += '    </div>';
                tableHtml += '  </td>';

                // Toplam Teklif
                var priceCls = o.isLowestPrice ? 'price-main-modal is-green' : 'price-main-modal';
                tableHtml += '  <td>';
                tableHtml += '    <div class="' + priceCls + '">' + o.offeredPriceFormatted + '</div>';
                tableHtml += '    <div style="display: flex; gap: 4px; margin-top: 4px;">';
                if (o.isLowestPrice) {
                    tableHtml += '      <span class="badge-lowest-modal">🟢 En Uygun</span>';
                }
                if (o.isFastestDelivery) {
                    tableHtml += '      <span class="badge-fastest-modal">⚡ En Hızlı</span>';
                }
                tableHtml += '    </div>';
                tableHtml += '  </td>';

                // Birim Fiyat
                tableHtml += '  <td>';
                tableHtml += '    <strong style="color: #0F172A; font-size: 0.86rem;">' + o.unitPriceFormatted + '</strong>';
                tableHtml += '    <div style="font-size: 0.72rem; color: #64748B;">/ Adet</div>';
                tableHtml += '  </td>';

                // Teslimat
                tableHtml += '  <td>';
                tableHtml += '    <div style="display: inline-flex; align-items: center; gap: 4px; background: #F1F5F9; padding: 3px 8px; border-radius: 6px; font-weight: 700; color: #334155; font-size: 0.80rem;">';
                tableHtml += '      <span>⏱️ ' + o.deliveryDays + ' Gün</span>';
                tableHtml += '    </div>';
                tableHtml += '  </td>';

                // Geçerlilik
                tableHtml += '  <td><span style="font-weight: 600; color: #475569;">' + o.validityDays + ' Gün</span></td>';

                // Bütçe Sapması
                var varColor = (o.budgetVariance !== null && o.budgetVariance <= 0) ? '#059669' : '#DC2626';
                var varBg = (o.budgetVariance !== null && o.budgetVariance <= 0) ? '#ECFDF5' : '#FEF2F2';
                var varBorder = (o.budgetVariance !== null && o.budgetVariance <= 0) ? 'rgba(16,185,129,0.3)' : 'rgba(239,68,68,0.3)';
                tableHtml += '  <td>';
                if (o.budgetVarianceFormatted !== '—') {
                    tableHtml += '    <span style="display: inline-block; padding: 2px 8px; border-radius: 6px; font-size: 0.76rem; font-weight: 700; background: ' + varBg + '; color: ' + varColor + '; border: 1px solid ' + varBorder + ';">' + o.budgetVarianceFormatted + '</span>';
                } else {
                    tableHtml += '    <span style="color: #94A3B8;">—</span>';
                }
                tableHtml += '  </td>';

                // Notlar & Red Gerekçesi
                var notesHtml = '';
                if (o.supplierNotes) {
                    notesHtml += '<div>' + escapeHtml(o.supplierNotes) + '</div>';
                }
                if (o.isRejected && o.rejectionReason) {
                    notesHtml += '<div style="font-size: 0.74rem; color: #DC2626; font-weight: 600; margin-top: 2px;">🚫 Red Sebebi: ' + escapeHtml(o.rejectionReason) + '</div>';
                }
                if (!notesHtml) {
                    notesHtml = '<span style="color: #94A3B8;">Belirtilmedi</span>';
                }
                tableHtml += '  <td style="max-width: 200px; font-size: 0.78rem; color: #475569; line-height: 1.4;">' + notesHtml + '</td>';

                // Durum
                tableHtml += '  <td>';
                if (o.isAccepted) {
                    tableHtml += '    <span class="badge-status is-approved" style="font-size: 0.78rem; font-weight: 700;">✓ Onaylandı</span>';
                } else if (o.isRejected) {
                    tableHtml += '    <span class="badge-status is-rejected" style="font-size: 0.78rem; font-weight: 700;" title="' + escapeHtml(o.rejectionReason || 'Reddedildi') + '">✕ Reddedildi</span>';
                } else {
                    tableHtml += '    <span class="badge-status is-pending" style="font-size: 0.78rem; font-weight: 700;">⏳ ' + escapeHtml(o.status) + '</span>';
                }
                tableHtml += '  </td>';

                // Karar & İşlem Butonları
                tableHtml += '  <td style="text-align: right;">';
                if (data.isOwner) {
                    if (o.status === 'Beklemede' && !data.isApproved) {
                        tableHtml += '    <div style="display: inline-flex; gap: 5px;">';
                        tableHtml += '      <button type="button" class="btn-cmp-accept" onclick="handleAcceptOfferFromCompareModal(' + o.offerId + ', ' + data.requestId + ', \'' + escapeHtml(o.supplierName) + '\', \'' + escapeHtml(o.offeredPriceFormatted) + '\')" title="Teklifi Kabul Et ve Talebi Onayla">✓ Kabul Et</button>';
                        tableHtml += '      <button type="button" class="btn-cmp-reject" onclick="handleRejectOfferFromCompareModal(' + o.offerId + ', ' + data.requestId + ', \'' + escapeHtml(o.supplierName) + '\')" title="Teklifi Reddet">✕</button>';
                        tableHtml += '    </div>';
                    } else if (o.isAccepted) {
                        tableHtml += '    <span style="display: inline-flex; align-items: center; gap: 4px; background: #ECFDF5; color: #065F46; border: 1px solid #10B981; font-weight: 800; font-size: 0.78rem; padding: 4px 10px; border-radius: 6px;">✓ Kazanan Teklif</span>';
                    } else {
                        tableHtml += '    <span style="color: #94A3B8; font-size: 0.75rem;">Kapalı</span>';
                    }
                } else {
                    tableHtml += '    <span style="color: #64748B; font-size: 0.75rem;">İnceleme</span>';
                }
                tableHtml += '  </td>';

                tableHtml += '</tr>';
            });

            tableBody.innerHTML = tableHtml;

            // 4. Chart.js Karşılaştırma Grafiği Çiz
            renderCompareModalChart(data.offers, data.lowestPrice);

            loading.style.display = 'none';
            content.style.display = 'flex';
        } catch (err) {
            loading.innerHTML = '<span style="color: red;">Kıyaslama yüklenirken hata oluştu: ' + err.message + '</span>';
        }
    }

    function closeCompareModal() {
        var modal = document.getElementById('priceCompareModal');
        if (modal) {
            modal.classList.remove('is-open');
        }
    }

    function renderCompareModalChart(offers, lowestPrice) {
        var canvas = document.getElementById('cmpModalChartCanvas');
        if (!canvas) return;

        if (cmpChartInstance) {
            cmpChartInstance.destroy();
            cmpChartInstance = null;
        }

        var labels = offers.map(function (o) { return o.supplierName.split(' ')[0] + ' ' + (o.supplierName.split(' ')[1] || ''); });
        var dataPrices = offers.map(function (o) { return o.offeredPrice; });

        var bgColors = dataPrices.map(function (p) {
            return p === lowestPrice ? 'rgba(16, 185, 129, 0.88)' : 'rgba(59, 130, 246, 0.80)';
        });

        var borderColors = dataPrices.map(function (p) {
            return p === lowestPrice ? '#059669' : '#1D4ED8';
        });

        cmpChartInstance = new Chart(canvas, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Teklif Tutarı (₺)',
                    data: dataPrices,
                    backgroundColor: bgColors,
                    borderColor: borderColors,
                    borderWidth: 1.5,
                    borderRadius: 8,
                    maxBarThickness: 50
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0F172A',
                        padding: 10,
                        titleFont: { size: 12, weight: '700' },
                        bodyFont: { size: 12 },
                        cornerRadius: 8,
                        displayColors: false,
                        callbacks: {
                            label: function (ctx) {
                                return '💰 Toplam Teklif: ' + Number(ctx.raw).toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' ₺';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function (val) {
                                return Number(val).toLocaleString('tr-TR') + ' ₺';
                            },
                            font: { size: 11, weight: '500' },
                            color: '#64748B'
                        },
                        grid: { color: '#F1F5F9' }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { font: { size: 11, weight: '700' }, color: '#334155' }
                    }
                }
            }
        });
    }

