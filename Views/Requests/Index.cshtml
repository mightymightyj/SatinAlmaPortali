<!-- 4. TEDARİKÇİ FİYAT KIYASLAMA & TEKLİF ANALİZİ MODALI (BUYER)               -->
<!-- ========================================================================= -->
<div class="custom-modal-backdrop" id="priceCompareModal" onclick="if(event.target === this) closeCompareModal();">
    <div class="custom-modal-dialog is-extra-wide">
        
        <!-- Modal Header -->
        <div class="cmp-header-gradient">
            <div style="display: flex; align-items: center; gap: 14px;">
                <div class="cmp-header-icon-box">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>
                    </svg>
                </div>
                <div>
                    <h3 class="custom-modal-title" style="color: #0F172A; font-size: 1.15rem; font-weight: 800; letter-spacing: -0.2px;">
                        Tedarikçi Fiyat Kıyaslama & Teklif Analizi
                    </h3>
                    <p style="font-size: 0.78rem; color: #64748B; margin: 2px 0 0 0;">
                        Gelen tüm teklifleri birim fiyat, teslimat ve ticari şartlarla yan yana kıyaslayın.
                    </p>
                </div>
            </div>

            <div style="display: flex; align-items: center; gap: 8px;">
                <button type="button" class="btn-cmp-action" onclick="exportCompareModalToCSV()" title="Excel / CSV Formatında İndir">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="12" y1="18" x2="12" y2="12"></line>
                        <line x1="9" y1="15" x2="15" y2="15"></line>
                    </svg>
                    <span>Excel İndir</span>
                </button>
                <button type="button" class="btn-cmp-action" onclick="window.print()" title="Yazdır veya PDF Kaydet">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2.2">
                        <polyline points="6 9 6 2 18 2 18 9"></polyline>
                        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                        <rect x="6" y="14" width="12" height="8"></rect>
                    </svg>
                    <span>Yazdır</span>
                </button>
                <button type="button" class="custom-modal-close" onclick="closeCompareModal()" style="font-size: 1.4rem; padding: 0 8px; margin-left: 4px;">&times;</button>
            </div>
        </div>

        <!-- Modal Body (Scrollable) -->
        <div class="custom-modal-body" style="padding: 20px 24px; overflow-y: auto; max-height: calc(90vh - 120px); background: #F8FAFC;">
            
            <!-- Loading Spinner -->
            <div id="cmpLoading" style="text-align: center; padding: 60px 20px; color: #64748B;">
                <div style="width: 44px; height: 44px; border: 3px solid #E2E8F0; border-top-color: #2563EB; border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto 14px auto;"></div>
                <strong style="color: #0F172A; display: block; font-size: 0.95rem;">Teklif ve Analiz Verileri Hesaplanıyor...</strong>
                <span style="font-size: 0.80rem; color: #64748B;">Tedarikçi fiyatları ve birim maliyetler taranıyor</span>
            </div>

            <!-- Content Container -->
            <div id="cmpContent" style="display: none; flex-direction: column; gap: 16px;">
                
                <!-- 1. Talep Özet Şeridi -->
                <div class="cmp-req-banner">
                    <div class="cmp-req-col">
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <span class="cmp-badge-code" id="cmpReqCode">#REQ-0000</span>
                            <span style="font-size: 0.76rem; color: #64748B;" id="cmpReqCategory">Kategori</span>
                        </div>
                        <h4 style="margin: 4px 0 0 0; color: #0F172A; font-size: 1.1rem; font-weight: 800;" id="cmpProductName"></h4>
                    </div>
                    <div class="cmp-req-col">
                        <span class="req-meta">Hedef Miktar</span>
                        <div style="font-weight: 800; color: #0F172A; font-size: 1.05rem;" id="cmpQuantity"></div>
                    </div>
                    <div class="cmp-req-col">
                        <span class="req-meta">Referans Bütçe</span>
                        <div style="font-weight: 800; color: #2563EB; font-size: 1.05rem;" id="cmpBudget"></div>
                    </div>
                    <div class="cmp-req-col" style="text-align: right; align-items: flex-end;">
                        <span class="req-meta">Talep Durumu</span>
                        <div id="cmpStatusBadge" style="margin-top: 2px;"></div>
                    </div>
                </div>

                <!-- Şartname / Not Kutusu -->
                <div id="cmpNotesWrap" style="display: none; background: #FFFFFF; padding: 12px 16px; border-radius: 10px; border: 1px solid #E2E8F0; font-size: 0.82rem; color: #475569; box-shadow: 0 1px 2px rgba(0,0,0,0.02);">
                    <div style="display: flex; align-items: flex-start; gap: 8px;">
                        <span style="color: #2563EB; font-size: 1rem;">📝</span>
                        <div>
                            <strong style="color: #0F172A;">Teknik Şartname & Notlar:</strong>
                            <span id="cmpNotesText" style="margin-left: 4px;"></span>
                        </div>
                    </div>
                </div>

                <!-- 2. KPI Rozetleri Grid (4 Kart) -->
                <div class="modal-kpi-grid">
                    
                    <!-- En Düşük Fiyat -->
                    <div class="modal-kpi-card is-lowest">
                        <div class="kpi-label-text">
                            <span>🟢 En Düşük Fiyat Teklifi</span>
                            <span class="badge-lowest-modal">En Uygun</span>
                        </div>
                        <div class="kpi-val-text" id="cmpKpiLowestPrice">0,00 ₺</div>
                        <div class="kpi-sub-text" id="cmpKpiLowestSupplier">Firma</div>
                    </div>

                    <!-- En Hızlı Teslimat -->
                    <div class="modal-kpi-card is-fastest">
                        <div class="kpi-label-text">
                            <span>⚡ En Hızlı Teslimat</span>
                            <span class="badge-fastest-modal">En Hızlı</span>
                        </div>
                        <div class="kpi-val-text" id="cmpKpiFastestDays">0 Gün</div>
                        <div class="kpi-sub-text" id="cmpKpiFastestSupplier">Firma</div>
                    </div>

                    <!-- Bütçe Tasarrufu -->
                    <div class="modal-kpi-card is-savings">
                        <div class="kpi-label-text">
                            <span>💰 Bütçeye Göre Tasarruf</span>
                            <span style="font-size: 0.70rem; font-weight: 800; color: #D97706; background: #FEF3C7; padding: 2px 6px; border-radius: 4px;">Kazanç</span>
                        </div>
                        <div class="kpi-val-text" id="cmpKpiSavings">0,00 ₺</div>
                        <div class="kpi-sub-text" id="cmpKpiSavingsSub">Hedef bütçeye kıyasla net fark</div>
                    </div>

                    <!-- Ortalama Teklif -->
                    <div class="modal-kpi-card is-average">
                        <div class="kpi-label-text">
                            <span>📈 Ortalama Teklif Tutarı</span>
                            <span style="font-size: 0.70rem; font-weight: 700; color: #7C3AED; background: #EDE9FE; padding: 2px 6px; border-radius: 4px;" id="cmpKpiOfferCount">0 Teklif</span>
                        </div>
                        <div class="kpi-val-text" id="cmpKpiAvgPrice">0,00 ₺</div>
                        <div class="kpi-sub-text" id="cmpKpiUnitAvg">Kalem Başına: ~0 ₺ / Adet</div>
                    </div>

                </div>

                <!-- 3. Yan Yana Karşılaştırma Matrisi Tablosu -->
                <div class="cmp-table-wrapper">
                    <div class="cmp-table-top-bar">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <strong style="color: #0F172A; font-size: 0.94rem; font-weight: 800;">Tedarikçi Teklif Karşılaştırma Matrisi</strong>
                            <span style="font-size: 0.75rem; background: #EFF6FF; color: #2563EB; font-weight: 700; padding: 2px 8px; border-radius: 999px;" id="cmpTableMeta"></span>
                        </div>
                        <span style="font-size: 0.75rem; color: #64748B;">En ucuz teklif otomatik olarak yeşil ile vurgulanır</span>
                    </div>

                    <div style="overflow-x: auto; width: 100%;">
                        <table class="modal-compare-table" id="cmpModalTable">
                            <thead>
                                <tr>
                                    <th>Tedarikçi Firma</th>
                                    <th>Toplam Teklif (₺)</th>
                                    <th>Birim Fiyat (₺/Adet)</th>
                                    <th>Teslimat Süresi</th>
                                    <th>Geçerlilik</th>
                                    <th>Bütçe Sapması</th>
                                    <th>Tedarikçi Notları</th>
                                    <th>Durum</th>
                                    <th style="text-align: right;">Karar & İşlem</th>
                                </tr>
                            </thead>
                            <tbody id="cmpTableBody">
                                <!-- JavaScript ile doldurulacak -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 4. Grafik Kartı -->
                <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 14px; padding: 18px 20px; box-shadow: 0 2px 6px rgba(0,0,0,0.02);">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
                        <div>
                            <h4 style="margin: 0; font-size: 0.92rem; font-weight: 800; color: #0F172A;">
                                Tedarikçi Teklif Tutarları Karşılaştırma Grafiği (₺)
                            </h4>
                            <span style="font-size: 0.75rem; color: #64748B;">Yeşil sütun en uygun fiyatı, mavi sütunlar diğer alternatifleri temsil eder.</span>
                        </div>
                    </div>
                    <div style="height: 230px; position: relative; width: 100%;">
                        <canvas id="cmpModalChartCanvas"></canvas>
                    </div>
                </div>

            </div>

            <!-- Empty State -->
            <div id="cmpEmpty" style="display: none; text-align: center; padding: 50px 20px; color: #64748B;">
                <div style="font-size: 2.5rem; margin-bottom: 10px;">⏳</div>
                <h4 style="color: #0F172A; font-weight: 800; margin: 0 0 6px 0; font-size: 1.05rem;">Bu Talep İçin Henüz Teklif Bulunmuyor</h4>
                <p style="font-size: 0.84rem; color: #64748B; max-width: 440px; margin: 0 auto; line-height: 1.5;">
                    Tedarikçiler satın alma talebinize fiyat teklifi verdikçe burada otomatik kıyaslama tablosu, KPI kartları ve fiyat grafiği oluşacaktır.
                </p>
            </div>

        </div>

        <!-- Modal Footer -->
        <div class="custom-modal-footer" style="padding: 14px 24px; background: #FFFFFF; border-top: 1px solid #E2E8F0;">
            <button type="button" class="btn-modal-cancel" onclick="closeCompareModal()">Kapat</button>
        </div>

    </div>
</div>

<!-- ============ JAVASCRIPT MODAL VE AJAX İŞLEMLERİ ============ -->
<script>
    // 1. Yeni Talep Modalı
    function openCreateModal() {
        document.getElementById('createRequestModal').classList.add('is-open');
    }

    function closeCreateModal() {
        document.getElementById('createRequestModal').classList.remove('is-open');
    }

    async function handleCreateRequestFormSubmit(event) {
        event.preventDefault();
        var form = event.target;
        var submitBtn = form.querySelector('button[type="submit"]');
        var originalText = submitBtn ? submitBtn.innerHTML : 'Talebi Yayınla';

        var productName = form.querySelector('[name="ProductName"]')?.value || '';
        var requestType = form.querySelector('[name="RequestType"]')?.value || 'Satın Alma';
        var quantity = parseInt(form.querySelector('[name="Quantity"]')?.value || '1', 10);
        var budgetVal = form.querySelector('[name="EstimatedBudget"]')?.value;
        var estimatedBudget = budgetVal ? parseFloat(budgetVal) : null;
        var targetDeliveryDate = form.querySelector('[name="TargetDeliveryDate"]')?.value || null;
        var notes = form.querySelector('[name="Notes"]')?.value || '';

        if (!productName.trim()) {
            if (typeof showRealtimeToast === 'function') {
                showRealtimeToast('Lütfen ürün veya hizmet adını giriniz.', 'error');
            } else {
                alert('Lütfen ürün veya hizmet adını giriniz.');
            }
            return;
        }

        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '⏳ Yayınlanıyor...';
        }

        try {
            var response = await fetch('/Requests/CreateAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    productName: productName,
                    requestType: requestType,
                    quantity: quantity,
                    estimatedBudget: estimatedBudget,
                    targetDeliveryDate: targetDeliveryDate,
                    notes: notes
                })
            });

            var result = await response.json();
            if (result.success) {
                closeCreateModal();
                form.reset();
                if (typeof showRealtimeToast === 'function') {
                    showRealtimeToast('✓ ' + (result.message || 'Talebiniz başarıyla yayınlandı!'), 'success');
                }
            } else {
                if (typeof showRealtimeToast === 'function') {
                    showRealtimeToast('Hata: ' + (result.message || 'Talep kaydedilemedi.'), 'error');
                } else {
                    alert('Hata: ' + result.message);
                }
            }
        } catch (err) {
            if (typeof showRealtimeToast === 'function') {
                showRealtimeToast('Sunucu bağlantı hatası: ' + err.message, 'error');
            } else {
                alert('Sunucu hatası: ' + err.message);
            }
        } finally {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        }
    }

    async function handleDeleteRequest(requestId, event) {
        if (event) {
            if (typeof event.preventDefault === 'function') event.preventDefault();
            if (typeof event.stopPropagation === 'function') event.stopPropagation();
        }
        if (!confirm('#REQ-' + requestId + ' numaralı talebinizi silmek istediğinize emin misiniz?')) {
            return;
        }

        try {
            var response = await fetch('/Requests/Delete?id=' + requestId, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                }
            });

            var result = await response.json();
            if (result.success) {
                if (typeof showRealtimeToast === 'function') {
                    showRealtimeToast('✓ ' + (result.message || 'Talep başarıyla silindi.'), 'info');
                }
                var row = document.querySelector('tr[data-request-id="' + requestId + '"]');
                if (row) {
                    row.style.transition = 'all 0.35s ease';
                    row.style.opacity = '0';
                    row.style.transform = 'scale(0.96)';
                    setTimeout(function () { row.remove(); }, 350);
                }
            } else {
                if (typeof showRealtimeToast === 'function') {
                    showRealtimeToast('Hata: ' + (result.message || 'Silme işlemi başarısız.'), 'error');
                } else {
                    alert('Hata: ' + result.message);
                }
            }
        } catch (err) {
            if (typeof showRealtimeToast === 'function') {
                showRealtimeToast('Sunucu hatası: ' + err.message, 'error');
            } else {
                alert('Sunucu hatası: ' + err.message);
            }
        }
    }

    // 2. Tedarikçi Teklif Verme / Revize Etme Modalı
    function openOfferModal(requestId, productName, currentBid, currentDays, currentNotes) {
        var modal = document.getElementById('supplierBidModal');
        if (!modal) return;

        var reqInput = document.getElementById('bidRequestID');
        var prodTitle = document.getElementById('bidProductTitle');
        var priceInput = document.getElementById('bidOfferedPrice');
        var daysInput = document.getElementById('bidDeliveryDays');
        var notesInput = document.getElementById('bidSupplierNotes');
        var titleText = document.getElementById('bidModalTitleText');
        var submitBtn = document.getElementById('bidSubmitBtn');

        if (reqInput) reqInput.value = requestId;
        if (prodTitle) prodTitle.textContent = productName || ('Talep #' + requestId);
        if (priceInput) priceInput.value = currentBid ? parseFloat(currentBid) : '';
        if (daysInput) daysInput.value = currentDays ? parseInt(currentDays) : 7;
        if (notesInput) notesInput.value = currentNotes || '';

        if (currentBid && currentBid !== '') {
            if (titleText) titleText.textContent = 'Teklifi Revize Et / Düzenle';
            if (submitBtn) submitBtn.textContent = 'Teklifi Güncelle & Gönder';
        } else {
            if (titleText) titleText.textContent = 'Talebe Fiyat Teklifi Ver';
            if (submitBtn) submitBtn.textContent = 'Teklifi İlet';
        }

        modal.classList.add('is-open');
        if (priceInput) setTimeout(function () { priceInput.focus(); }, 50);
    }

    function closeBidModal() {
        var modal = document.getElementById('supplierBidModal');
        if (modal) {
            modal.classList.remove('is-open');
        }
    }

    async function handleBidSubmit(event) {
        event.preventDefault();
        var form = event.target;
        var submitBtn = document.getElementById('bidSubmitBtn') || form.querySelector('button[type="submit"]');
        var originalText = submitBtn ? submitBtn.innerHTML : 'Teklifi İlet';

        var reqId = parseInt(document.getElementById('bidRequestID')?.value || '0', 10);
        var price = parseFloat(document.getElementById('bidOfferedPrice')?.value || '0');
        var days = parseInt(document.getElementById('bidDeliveryDays')?.value || '7', 10);
        var valDays = parseInt(document.getElementById('bidValidityDays')?.value || '30', 10);
        var notes = document.getElementById('bidSupplierNotes')?.value || '';

        if (reqId <= 0) {
            if (typeof showRealtimeToast === 'function') {
                showRealtimeToast('Hata: Talep referansı tespit edilemedi.', 'error');
            } else {
                alert('Hata: Talep referansı tespit edilemedi.');
            }
            return;
        }

        if (isNaN(price) || price <= 0) {
            if (typeof showRealtimeToast === 'function') {
                showRealtimeToast('Lütfen geçerli bir teklif tutarı giriniz.', 'error');
            } else {
                alert('Lütfen geçerli bir teklif tutarı giriniz.');
            }
            return;
        }

        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '⏳ İletiliyor...';
        }

        try {
            var response = await fetch('/Requests/SubmitOfferAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    requestId: reqId,
                    offeredPrice: price,
                    deliveryDays: days,
                    validityDays: valDays,
                    supplierNotes: notes
                })
            });

            var result = await response.json();
            if (result.success) {
                closeBidModal();

                if (typeof updatePortalDomForOfferSubmitted === 'function') {
                    updatePortalDomForOfferSubmitted({
                        requestId: reqId,
                        offeredPrice: price,
                        offeredPriceFormatted: Number(price).toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' ₺',
                        deliveryDays: days,
                        validityDays: valDays,
                        supplierNotes: notes,
                        isMyBid: true
                    });
                }

                if (typeof showRealtimeToast === 'function') {
                    showRealtimeToast('✓ ' + (result.message || 'Teklifiniz başarıyla iletildi!'), 'success');
                }

                // Eğer Talep Detay Modalı o an açıksa canlı güncelle
                var detailModal = document.getElementById('detailRequestModal');
                if (detailModal && detailModal.classList.contains('is-open')) {
                    openDetailModal(reqId);
                }

                // Eğer Kıyaslama Modalı açıksa canlı güncelle
                var cmpModal = document.getElementById('priceCompareModal');
                if (cmpModal && cmpModal.classList.contains('is-open')) {
                    openCompareModal(reqId);
                }
            } else {
                if (typeof showRealtimeToast === 'function') {
                    showRealtimeToast('Teklif iletilemedi: ' + (result.message || 'Bilinmeyen hata.'), 'error');
                } else {
                    alert('Teklif iletilemedi: ' + result.message);
                }
            }
        } catch (err) {
            if (typeof showRealtimeToast === 'function') {
                showRealtimeToast('Sunucu bağlantı hatası: ' + err.message, 'error');
            } else {
                alert('Sunucu hatası: ' + err.message);
            }
        } finally {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        }
    }

    // 3. Talep Detay ve Teklifleri İnceleme Modalı
    async function openDetailModal(requestId) {
        var modal = document.getElementById('detailRequestModal');
        var loading = document.getElementById('detailLoading');
        var content = document.getElementById('detailContent');
        var container = document.getElementById('offersListContainer');
        var footer = document.getElementById('detailModalFooter');

        if (!modal) return;

        modal.setAttribute('data-active-request-id', requestId);
        modal.classList.add('is-open');
        loading.style.display = 'block';
        content.style.display = 'none';
        container.innerHTML = '';

        try {
            if (window.portalHubConnection && window.portalHubConnection.state === 'Connected') {
                window.portalHubConnection.invoke('JoinRequestGroup', parseInt(requestId)).catch(function(e) { console.warn(e); });
            }
        } catch (e) { }

        try {
            var response = await fetch('/Requests/GetRequestDetails/' + requestId);
            var data = await response.json();

            if (!data.success) {
                alert('Talep detayları yüklenemedi: ' + data.message);
                closeDetailModal();
                return;
            }

            // Temel Bilgileri Doldur
            document.getElementById('detailReqCode').textContent = data.requestCode + ' · ' + data.requestDate;
            document.getElementById('detailProductName').textContent = data.productName;
            document.getElementById('detailBuyerInfo').textContent = 'Alıcı: ' + data.buyerInfo + ' (' + data.requestType + ')';
            document.getElementById('detailQtyBudget').textContent = data.quantity.toLocaleString('tr-TR') + ' Adet · Bütçe: ' + data.estimatedBudgetFormatted;
            document.getElementById('detailDeadline').textContent = 'Termin: ' + data.targetDeliveryDate;

            var notesContainer = document.getElementById('detailNotesContainer');
            if (data.notes) {
                notesContainer.style.display = 'block';
                document.getElementById('detailNotesText').textContent = data.notes;
            } else {
                notesContainer.style.display = 'none';
            }

            document.getElementById('detailOfferCount').textContent = data.offerCount;

            // Footer Butonları (Tedarikçi ise duruma göre Teklif Ver / Düzenle / Kilitli rozeti göster)
            if (footer) {
                if (!data.isOwner && data.status !== 'Onaylandı' && data.status !== 'Kabul Edildi' && data.status !== 'Tamamlandı' && data.status !== 'İptal Edildi') {
                    var myOfferStatus = data.myOffer ? data.myOffer.status : null;
                    if (myOfferStatus === 'Kabul Edildi' || myOfferStatus === 'Onaylandı') {
                        footer.innerHTML = '<span class="badge-status is-approved" style="margin-right: auto; padding: 6px 12px; font-weight: 700; background: #ECFDF5; color: #065F46; border-radius: 6px; font-size: 0.85rem;">✓ Teklifiniz Onaylandı (Kilitli)</span><button type="button" class="btn-modal-cancel" onclick="closeDetailModal()">Kapat</button>';
                    } else if (myOfferStatus === 'Reddedildi') {
                        var myRej = data.myOffer && data.myOffer.rejectionReason ? data.myOffer.rejectionReason : 'Talep için başka bir teklif onaylandı.';
                        var myBidVal = data.myOffer ? data.myOffer.offeredPrice : '';
                        var myDaysVal = data.myOffer ? data.myOffer.deliveryDays : 7;
                        var myNotesVal = data.myOffer ? (data.myOffer.supplierNotes || '') : '';
                        footer.innerHTML = '<div style="margin-right: auto; text-align: left;"><span class="badge-status is-rejected" style="padding: 5px 10px; font-weight: 700; background: #FEF2F2; color: #991B1B; border-radius: 6px; font-size: 0.82rem; display: inline-block;">✕ Teklifiniz Reddedildi</span><span style="font-size: 0.76rem; color: #DC2626; margin-left: 8px; font-weight: 600;">🚫 Sebep: ' + escapeHtml(myRej) + '</span></div>' +
                            '<button type="button" class="btn-modal-cancel" onclick="closeDetailModal()">Kapat</button>' +
                            '<button type="button" class="btn-primary" style="background: #2563EB; border-color: #2563EB;" onclick="closeDetailModal(); openOfferModal(' + data.requestId + ', \'' + escapeHtml(data.productName) + '\', \'' + myBidVal + '\', \'' + myDaysVal + '\', \'' + escapeHtml(myNotesVal) + '\');">✏️ Teklifi Revize Et</button>';
                    } else {
                        var myBidVal = data.myOffer ? data.myOffer.offeredPrice : '';
                        var myDaysVal = data.myOffer ? data.myOffer.deliveryDays : 7;
                        var myNotesVal = data.myOffer ? (data.myOffer.supplierNotes || '') : '';
                        var btnLabel = data.myOffer ? '✏️ Teklifi Düzenle' : '➕ Teklif Ver';
                        footer.innerHTML = '<button type="button" class="btn-modal-cancel" onclick="closeDetailModal()">Kapat</button>' +
                            '<button type="button" class="btn-primary" style="background: #10B981; border-color: #10B981;" onclick="closeDetailModal(); openOfferModal(' + data.requestId + ', \'' + escapeHtml(data.productName) + '\', \'' + myBidVal + '\', \'' + myDaysVal + '\', \'' + escapeHtml(myNotesVal) + '\');">' + btnLabel + '</button>';
                    }
                } else if (data.isOwner) {
                    footer.innerHTML = '<span style="color: #64748B; font-size: 0.82rem; margin-right: auto;">ℹ️ Bu talep firmanıza aittir.</span><button type="button" class="btn-modal-cancel" onclick="closeDetailModal()">Kapat</button>';
                } else {
                    var myOfferStatus = data.myOffer ? data.myOffer.status : null;
                    var badge = '';
                    if (myOfferStatus === 'Kabul Edildi' || myOfferStatus === 'Onaylandı') {
                        badge = '<span class="badge-status is-approved" style="margin-right: auto; padding: 6px 12px; font-weight: 700; background: #ECFDF5; color: #065F46; border-radius: 6px; font-size: 0.85rem;">✓ Teklifiniz Onaylandı</span>';
                    } else if (myOfferStatus === 'Reddedildi') {
                        var myRej = data.myOffer && data.myOffer.rejectionReason ? data.myOffer.rejectionReason : 'Talep için başka bir teklif onaylandı.';
                        badge = '<div style="margin-right: auto; text-align: left;"><span class="badge-status is-rejected" style="padding: 5px 10px; font-weight: 700; background: #FEF2F2; color: #991B1B; border-radius: 6px; font-size: 0.82rem; display: inline-block;">✕ Teklifiniz Reddedildi</span><span style="font-size: 0.76rem; color: #DC2626; margin-left: 8px; font-weight: 600;">🚫 Sebep: ' + escapeHtml(myRej) + '</span></div>';
                    }
                    footer.innerHTML = badge + '<button type="button" class="btn-modal-cancel" onclick="closeDetailModal()">Kapat</button>';
                }
            }

            // Teklifleri Listele
            if (data.offers && data.offers.length > 0) {
                var html = '';
                data.offers.forEach(function(o) {
                    var isAcc = o.status === 'Kabul Edildi';
                    var isRej = o.status === 'Reddedildi';
                    var cardCls = isAcc ? 'offer-card-item is-accepted' : (isRej ? 'offer-card-item is-rejected' : 'offer-card-item');

                    html += '<div class="' + cardCls + '">';
                    html += '  <div class="offer-supplier-info">';
                    html += '    <span class="offer-supplier-name">' + escapeHtml(o.supplierName) + '</span>';
                    html += '    <span class="offer-meta">' + o.deliveryDays + ' Gün Teslimat · ' + o.validityDays + ' Gün Geçerli · ' + o.offerDate + '</span>';
                    if (o.supplierNotes) {
                        html += '    <span style="font-size: 0.78rem; color: #475569; margin-top: 3px;">💬 ' + escapeHtml(o.supplierNotes) + '</span>';
                    }
                    if (o.isRevised) {
                        html += '    <div style="font-size: 0.76rem; color: #92400E; background: #FFFBEB; border: 1px solid #FCD34D; border-radius: 6px; padding: 4px 8px; margin-top: 5px; font-weight: 600; display: flex; align-items: center; justify-content: space-between; gap: 6px;">';
                        html += '      <span>🔄 <strong>Revize Teklif:</strong> Reddedilen teklif tedarikçi tarafından güncellenerek tekrar iletildi.</span>';
                        if (o.previousPriceFormatted) {
                            html += '      <span style="color: #B45309; font-size: 0.72rem; white-space: nowrap;">(Önceki: <del>' + escapeHtml(o.previousPriceFormatted) + '</del>)</span>';
                        }
                        html += '    </div>';
                    }
                    if (isRej && o.rejectionReason) {
                        html += '    <div style="font-size: 0.75rem; color: #991B1B; background: #FEF2F2; border: 1px solid rgba(239, 68, 68, 0.25); border-radius: 4px; padding: 3px 8px; margin-top: 4px; font-weight: 600; display: inline-flex; align-items: gap: 4px; width: fit-content;">🚫 <strong>Red Sebebi:</strong> ' + escapeHtml(o.rejectionReason) + '</div>';
                    }
                    html += '  </div>';

                    html += '  <div class="offer-price-box">';
                    html += '    <span class="offer-price-val">' + o.offeredPriceFormatted + '</span>';

                    // Alıcı onay butonları
                    if (data.isOwner) {
                        if (o.status === 'Beklemede' && data.status !== 'Onaylandı') {
                            html += '    <div style="display: flex; gap: 6px; margin-top: 4px;">';
                            html += '      <button type="button" class="btn-accept-offer" onclick="handleAcceptOffer(' + o.offerId + ', ' + data.requestId + ', \'' + escapeHtml(o.supplierName) + '\', \'' + escapeHtml(o.offeredPriceFormatted) + '\')">✓ Kabul Et</button>';
                            html += '      <button type="button" class="btn-reject-offer" onclick="handleRejectOffer(' + o.offerId + ', ' + data.requestId + ', \'' + escapeHtml(o.supplierName) + '\')">✕ Reddet</button>';
                            html += '    </div>';
                        } else if (isAcc) {
                            html += '    <span style="display: inline-block; background: #10B981; color: #FFFFFF; font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: 6px; margin-top: 4px;">✓ KABUL EDİLDİ (ONAYLANDI)</span>';
                        } else if (isRej) {
                            html += '    <span style="display: inline-block; background: #FEF2F2; color: #EF4444; border: 1px solid rgba(239, 68, 68, 0.3); font-size: 0.75rem; font-weight: 700; padding: 3px 8px; border-radius: 6px; margin-top: 4px;" title="' + escapeHtml(o.rejectionReason || 'Reddedildi') + '">✕ REDDEDİLDİ</span>';
                        }
                    } else {
                        if (isAcc) {
                            html += '    <span style="display: inline-block; background: #ECFDF5; color: #059669; border: 1px solid #10B981; font-weight: 700; font-size: 0.78rem; padding: 3px 8px; border-radius: 6px;">✓ Onaylanan Teklif</span>';
                        } else if (isRej) {
                            html += '    <span style="display: inline-block; background: #FEF2F2; color: #EF4444; font-size: 0.78rem; padding: 3px 8px; border-radius: 6px;" title="' + escapeHtml(o.rejectionReason || 'Reddedildi') + '">✕ Reddedildi</span>';
