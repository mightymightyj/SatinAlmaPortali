                            <div style="margin-top: 4px;">
                                <button type="submit" class="btn-primary" style="width: 100%; justify-content: center; padding: 11px; background: #16A34A; border-color: #16A34A; font-size: 0.95rem;">
                                    Seçilen Firma Adına Teklif Gönder
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

            </div>

            <!-- 1. CANLI VİTRİN & KATALOG SATIŞ İLANLARI TABLOSU -->
            <div class="content-card" style="margin-bottom: 24px;">
                <div class="card-toolbar">
                    <div class="toolbar-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--primary);"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                        Canlı Vitrin &amp; Satış İlanları Listesi
                        <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">(@Model.RecentListings.Count ürün ilanı)</span>
                    </div>
                    <div class="toolbar-actions">
                        <a href="/#ihtiyaciniz-olan-urunler" target="_blank" class="btn-secondary" style="font-size: 0.8rem; text-decoration: none;">
                            Vitrine Git ↗
                        </a>
                    </div>
                </div>

                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width: 80px;">Ürün No</th>
                                <th>Ürün Adı</th>
                                <th>Satıcı Firma / Marka</th>
                                <th>Kategori</th>
                                <th style="text-align: right;">Birim Fiyat</th>
                                <th style="text-align: right;">Stok</th>
                                <th style="text-align: center;">Durum</th>
                                <th style="text-align: right; width: 150px;">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentListings.Any())
                            {
                                @foreach (var item in Model.RecentListings)
                                {
                                    <tr id="listing-row-@item.ItemID">
                                        <td><strong style="color: var(--primary);">#ITEM-@item.ItemID</strong></td>
                                        <td>
                                            <div style="display: flex; align-items: center; gap: 8px;">
                                                @if (!string.IsNullOrWhiteSpace(item.ItemImage))
                                                {
                                                    <img src="@item.ItemImage" alt="@item.ItemName" style="width: 32px; height: 32px; border-radius: 6px; object-fit: cover; border: 1px solid #E2E8F0;" />
                                                }
                                                else
                                                {
                                                    <div style="width: 32px; height: 32px; border-radius: 6px; background: #F1F5F9; display: flex; align-items: center; justify-content: center; color: var(--text-muted);">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
                                                    </div>
                                                }
                                                <strong style="color: var(--text-heading);">@item.ItemName</strong>
                                            </div>
                                        </td>
                                        <td><span class="badge badge-both">@item.Brand</span></td>
                                        <td>@item.CategoryName</td>
                                        <td style="text-align: right; font-weight: 700; color: var(--text-heading);">@item.UnitPrice.ToString("N0") ₺</td>
                                        <td style="text-align: right;">@item.Quantity Adet</td>
                                        <td style="text-align: center;">
                                            <span class="badge badge-root">Yayında</span>
                                        </td>
                                        <td style="text-align: right;">
                                            <div style="display: flex; gap: 6px; justify-content: flex-end;">
                                                <a href="/#ihtiyaciniz-olan-urunler" target="_blank" class="btn-table-action" title="Ana sayfada ürünü görüntüle">
                                                    Vitrin ↗
                                                </a>
                                                <button type="button" class="btn-table-action" style="color: #DC2626; border-color: #FCA5A5;" title="İlanı Sil" onclick="handleDeleteListing(@item.ItemID, '@Html.Raw(item.ItemName.Replace("'", "\\'"))', event)">
                                                    Sil
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="empty-state">Henüz eklenmiş bir ürün ilanı bulunmuyor. Yukarıdaki formdan ilk satış ilanını oluşturabilirsiniz.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 2. MEVCUT AÇIK TALEPLER TABLOSU (HIZLI SEÇİM) -->
            <div class="content-card">
                <div class="card-toolbar">
                    <div class="toolbar-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--primary);"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                        Mevcut Satın Alma Talepleri ve Teklif Durumu
                        <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">(@Model.OpenRequests.Count talep)</span>
                    </div>
                </div>

                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width: 80px;">Talep No</th>
                                <th>Ürün / Hizmet Adı</th>
                                <th>Talep Sahibi (Alıcı)</th>
                                <th>Miktar</th>
                                <th>Tahmini Bütçe</th>
                                <th>Teklif Sayısı</th>
                                <th>Durum</th>
                                <th style="text-align: right; width: 140px;">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.OpenRequests.Any())
                            {
                                @foreach (var r in Model.OpenRequests)
                                {
                                    <tr>
                                        <td><strong style="color: var(--primary);">#REQ-@r.RequestID</strong></td>
                                        <td><strong style="color: var(--text-heading);">@r.ProductName</strong></td>
                                        <td>@r.BuyerInfo</td>
                                        <td>@r.Quantity Adet</td>
                                        <td>@(r.EstimatedBudget.HasValue ? $"{r.EstimatedBudget.Value:N0} ₺" : "—")</td>
                                        <td>
                                            <span class="badge @(r.OfferCount > 0 ? "badge-supplier" : "badge-sub")">
                                                @r.OfferCount Teklif
                                            </span>
                                        </td>
                                        <td>
                                            @if (r.Status == "Onaylandı" || r.Status == "Kabul Edildi")
                                            {
                                                <span class="badge badge-root">@r.Status</span>
                                            }
                                            else if (r.Status == "Reddedildi")
                                            {
                                                <span class="badge badge-super">@r.Status</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-both">@r.Status</span>
                                            }
                                        </td>
                                        <td style="text-align: right;">
                                            <button type="button" class="btn-table-action" onclick="selectRequestForOffer(@r.RequestID)" title="Bu talebe simülasyon formuyla teklif ver">
                                                Teklif Seç
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="empty-state">Henüz açık bir talep bulunmuyor. Yukarıdaki formdan ilk talebi oluşturabilirsiniz.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ==================== SEKME: DEĞERLENDİRMELER & İTİBAR TESTİ ==================== -->
        @if (Model.ActiveTab == "reviews")
        {
            <!-- 4 KPI KARTI -->
            <div class="kpi-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-bottom: 24px;">
                <div class="kpi-card">
                    <div class="kpi-label">Toplam Değerlendirme</div>
                    <div class="kpi-value" style="color: #D97706;">@Model.Stats.TotalReviews</div>
                    <div class="kpi-desc">Sistemdeki tüm onaylı incelemeler</div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-label">Ortalama Platform Skoru</div>
                    <div class="kpi-value" style="color: #16A34A;">@Model.Stats.AveragePlatformScore.ToString("0.0") <small style="font-size: 0.9rem; color: var(--text-muted);">/ 10</small></div>
                    <div class="kpi-desc">10 Puanlık İtibar Ortalaması</div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-label">Satıcı Karneleri (Alıcı -> Satıcı)</div>
                    <div class="kpi-value" style="color: #2563EB;">@Model.Stats.BuyerToSellerReviewsCount</div>
                    <div class="kpi-desc">Ürün, sevkiyat ve malzeme değerlendirmeleri</div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-label">Alıcı Karneleri (Satıcı -> Alıcı)</div>
                    <div class="kpi-value" style="color: #7C3AED;">@Model.Stats.SellerToBuyerReviewsCount</div>
                    <div class="kpi-desc">Ödeme dakikliği ve mal kabul değerlendirmeleri</div>
                </div>
            </div>

            <!-- DEĞERLENDİRME TEST SİMÜLASYONU FORMU & DEMO VERİ BUTONU -->
            <div style="display: grid; grid-template-columns: 1fr 340px; gap: 20px; margin-bottom: 24px;">
                <div class="content-card" style="margin-bottom: 0;">
                    <div class="card-toolbar">
                        <div class="toolbar-title">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #D97706;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                            10 Puanlık Test Değerlendirmesi Ekle
                        </div>
                    </div>
                    <form asp-action="SimulateReview" method="post" id="simulateReviewForm" style="padding: 20px;" onsubmit="handleSimulateReviewSubmit(event); return false;">
                        @Html.AntiForgeryToken()
                        <div style="display: flex; flex-direction: column; gap: 14px;">
                            
                            <div class="form-field-grid">
                                <div class="form-field">
                                    <label class="form-label" for="simRevTarget">Değerlendirilen Hedef Firma (Puanı Alan) *</label>
                                    <select id="simRevTarget" name="TargetCompanyID" class="form-select" required>
                                        <option value="">— Hedef Firmayı Seçin —</option>
                                        @foreach (var comp in Model.Companies.Where(c => !c.IsSuperAdmin))
                                        {
                                            <option value="@comp.CompanyID">
                                                #@comp.CompanyID - @comp.CompanyName [Yetkili: @comp.CompanyOfficial]
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="form-field">
                                    <label class="form-label" for="simRevType">Değerlendirme Türü *</label>
                                    <select id="simRevType" name="ReviewType" class="form-select" required onchange="handleReviewTypeChange(this)">
                                        <option value="BuyerToSeller">Alıcı -> Satıcı (Ürün, Sevkiyat &amp; Malzeme Kalitesi)</option>
                                        <option value="SellerToBuyer">Satıcı -> Alıcı (Ödeme Dakikliği &amp; Mal Kabul)</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-field-grid">
                                <div class="form-field">
                                    <label class="form-label" for="simRevReviewer">Değerlendiren Firma (Opsiyonel)</label>
                                    <select id="simRevReviewer" name="ReviewerCompanyID" class="form-select" onchange="handleReviewerCompChange(this)">
                                        <option value="">— Sistemdeki Bir Firmayı Seçin (Veya Alt Alana Yazın) —</option>
                                        @foreach (var comp in Model.Companies.Where(c => !c.IsSuperAdmin))
                                        {
                                            <option value="@comp.CompanyID" data-name="@comp.CompanyName">
                                                #@comp.CompanyID - @comp.CompanyName
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="form-field">
                                    <label class="form-label" for="simRevReviewerName">Değerlendiren Firma / Yetkili Adı</label>
                                    <input type="text" id="simRevReviewerName" name="ReviewerName" class="form-input" placeholder="Örn: Atlas Endüstri A.Ş. (Doğrulanmış Alıcı)" />
                                </div>
                            </div>

                            <div class="form-field-grid">
                                <div class="form-field">
                                    <label class="form-label" for="simRevOrder">İlişkili Sipariş (Opsiyonel)</label>
                                    <select id="simRevOrder" name="OrderID" class="form-select">
                                        <option value="">— Sipariş Seçimi Yok (Bağımsız Değerlendirme) —</option>
                                        @foreach (var ord in Model.AvailableOrders)
                                        {
                                            <option value="@ord.OrderID">
                                                #@ord.OrderNumber — @ord.BuyerCompanyName -> @ord.SupplierCompanyName (@ord.GrandTotal.ToString("N0") ₺)
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="form-field">
                                    <label class="form-label" for="simRevScore">Genel Puan: <strong id="simRevScoreDisplay" style="color: #D97706; font-size: 1rem;">10.0 / 10</strong></label>
                                    <input type="range" id="simRevScore" name="ReviewScore" min="1.0" max="10.0" step="0.5" value="10.0" class="form-input" style="padding: 4px;" oninput="document.getElementById('simRevScoreDisplay').textContent = parseFloat(this.value).toFixed(1) + ' / 10'" />
                                </div>
                            </div>

                            <div class="form-field-grid" style="grid-template-columns: 1fr 1fr 1fr 1fr;" id="simRevSubScoresGrid">
                                <div class="form-field">
                                    <label class="form-label" for="simRevDelivery" id="lblDelivery">Teslimat / Dakiklik (1-10)</label>
                                    <input type="number" id="simRevDelivery" name="DeliveryScore" min="1" max="10" step="0.5" value="10.0" class="form-input" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label" for="simRevQuality" id="lblQuality">Kalite / Şartname (1-10)</label>
                                    <input type="number" id="simRevQuality" name="QualityScore" min="1" max="10" step="0.5" value="10.0" class="form-input" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label" for="simRevComm">İletişim Skoru (1-10)</label>
                                    <input type="number" id="simRevComm" name="CommunicationScore" min="1" max="10" step="0.5" value="10.0" class="form-input" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label" for="simRevPayment" id="lblPayment">Ödeme Dakikliği (1-10)</label>
                                    <input type="number" id="simRevPayment" name="PaymentPunctualityScore" min="1" max="10" step="0.5" value="10.0" class="form-input" />
                                </div>
                            </div>

                            <div class="form-field">
                                <label class="form-label" for="simRevText">Değerlendirme Yorumu</label>
                                <textarea id="simRevText" name="ReviewText" class="form-textarea" rows="2" placeholder="Örn: Siparişimiz tam zamanında teslim edildi. Ürün malzeme kalitesi ve teknik desteği kusursuz..."></textarea>
                            </div>

                            <div style="display: flex; gap: 10px; align-items: center; justify-content: flex-end;">
                                <button type="submit" class="btn-primary" style="background: #16A34A; border-color: #16A34A;">
                                    Test Değerlendirmesini Kaydet
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- HIZLI DEMO VE BİLGİ PANELİ -->
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div class="content-card" style="padding: 20px; margin-bottom: 0;">
                        <h4 style="font-size: 0.92rem; font-weight: 700; color: var(--text-heading); margin-bottom: 8px;">
                            Tek Tıkla Demo Test Verisi
                        </h4>
                        <p style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 14px;">
                            Sistemdeki kurumsal firmalara otomatik olarak gerçekçi 10 puan üzerinden teslimat metrikleri ve alıcı/satıcı yorumları ekler.
                        </p>
                        <form asp-action="GenerateDemoReviews" method="post" id="generateDemoReviewsForm" onsubmit="handleGenerateDemoReviewsSubmit(event); return false;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-primary" style="width: 100%; justify-content: center; background: #D97706; border-color: #D97706;">
                                Otomatik Demo Değerlendirmeler Üret
                            </button>
                        </form>
                    </div>

                    <div class="content-card" style="padding: 20px; margin-bottom: 0; background: #F8FAFC;">
                        <h4 style="font-size: 0.88rem; font-weight: 700; color: var(--text-heading); margin-bottom: 8px;">
                            Değerlendirme Sistemi Nasıl Çalışır?
                        </h4>
                        <ul style="font-size: 0.78rem; color: var(--text-muted); line-height: 1.6; padding-left: 16px;">
                            <li><strong>Alıcı -> Satıcı:</strong> Tedarikçinin 10 puanlık karnesini ve <code>/Seller/{id}</code> profilindeki rozetleri besler.</li>
                            <li><strong>Satıcı -> Alıcı:</strong> Alıcının güvenilirlik skorunu ve <code>/Account/Profile</code> panelindeki karnesini oluşturur.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- CANLI DEĞERLENDİRMELER TABLOSU -->
            <div class="content-card">
                <div class="card-toolbar">
                    <div class="toolbar-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #D97706;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                        Canlı Sistem Değerlendirmeleri Listesi
                        <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">(@Model.Reviews.Count değerlendirme)</span>
                    </div>
                </div>

                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width: 80px;">No</th>
                                <th>Hedef Firma (Puan Alan)</th>
                                <th>Değerlendiren</th>
                                <th>Tür</th>
                                <th style="text-align: center;">Puan (10)</th>
                                <th>Kriter Dökümü</th>
                                <th>Yorum Özeti</th>
                                <th>Tarih</th>
                                <th style="text-align: right; width: 140px;">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Reviews.Any())
                            {
                                @foreach (var rev in Model.Reviews)
                                {
                                    var isBuyerToSeller = rev.ReviewType == "BuyerToSeller";
                                    <tr id="review-row-@rev.ReviewID">
                                        <td><strong style="color: var(--primary);">#REV-@rev.ReviewID</strong></td>
                                        <td>
                                            <strong style="color: var(--text-heading);">@rev.TargetCompanyName</strong>
                                            @if (rev.CompanyID.HasValue)
                                            {
                                                <a href="/Seller/@rev.CompanyID.Value" target="_blank" style="font-size: 0.72rem; color: #2563EB; margin-left: 6px; text-decoration: none;">
                                                    Profil ↗
                                                </a>
                                            }
                                        </td>
                                        <td>
                                            <span style="font-size: 0.82rem; color: var(--text-body);">@rev.ReviewerName</span>
                                            @if (!string.IsNullOrWhiteSpace(rev.OrderNumber))
                                            {
                                                <div style="font-size: 0.72rem; color: var(--text-muted);">Sipariş: #@rev.OrderNumber</div>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @(isBuyerToSeller ? "badge-both" : "badge-supplier")">
                                                @(isBuyerToSeller ? "Alıcı -> Satıcı" : "Satıcı -> Alıcı")
                                            </span>
                                        </td>
                                        <td style="text-align: center;">
                                            <span style="font-weight: 800; color: #D97706; background: #FEF3C7; padding: 2px 8px; border-radius: 6px; font-size: 0.84rem;">
                                                @rev.ReviewScore.ToString("0.0")
                                            </span>
                                        </td>
                                        <td>
                                            <div style="font-size: 0.74rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 2px;">
                                                @if (isBuyerToSeller)
                                                {
                                                    <span>Teslimat: <strong>@(rev.DeliveryScore?.ToString("0.0") ?? "-")</strong></span>
                                                    <span>Kalite: <strong>@(rev.QualityScore?.ToString("0.0") ?? "-")</strong></span>
                                                    <span>İletişim: <strong>@(rev.CommunicationScore?.ToString("0.0") ?? "-")</strong></span>
                                                }
                                                else
                                                {
                                                    <span>Ödeme: <strong>@(rev.PaymentPunctualityScore?.ToString("0.0") ?? rev.DeliveryScore?.ToString("0.0") ?? "-")</strong></span>
                                                    <span>Mal Kabul: <strong>@(rev.QualityScore?.ToString("0.0") ?? "-")</strong></span>
                                                    <span>İletişim: <strong>@(rev.CommunicationScore?.ToString("0.0") ?? "-")</strong></span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <span style="font-size: 0.8rem; color: var(--text-body); max-width: 220px; display: inline-block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@rev.ReviewText">
                                                @(string.IsNullOrWhiteSpace(rev.ReviewText) ? "—" : rev.ReviewText)
                                            </span>
                                        </td>
                                        <td style="font-size: 0.78rem; color: var(--text-muted);">
                                            @rev.ReviewDate.ToString("dd.MM.yyyy HH:mm")
                                        </td>
                                        <td style="text-align: right;">
                                            <div style="display: flex; gap: 6px; justify-content: flex-end;">
                                                @if (rev.CompanyID.HasValue)
                                                {
                                                    <a href="/Seller/@rev.CompanyID.Value" target="_blank" class="btn-table-action" title="Satıcı Vitrininde Gör">
                                                        Vitrin ↗
                                                    </a>
                                                }
                                                <button type="button" class="btn-table-action danger" style="color: #DC2626; border-color: #FCA5A5;" title="Değerlendirmeyi Sil" onclick="handleDeleteReview(@rev.ReviewID, event)">
                                                    Sil
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="empty-state">
                                        Henüz kayıtlı bir değerlendirme bulunmuyor. Yukarıdaki formdan test değerlendirmesi ekleyebilir veya otomatik demo üret butonunu kullanabilirsiniz.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ==================== SEKME 4: SİSTEM AYARLARI ==================== -->
        @if (Model.ActiveTab == "settings")
        {
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 20px;">
                <div class="content-card" style="padding: 22px;">
                    <h3 style="font-size: 1rem; font-weight: 700; color: var(--text-heading); margin-bottom: 8px;">
                        Veritabanı Referans Tablolarını Eşitle
                    </h3>
                    <p style="font-size: 0.84rem; color: var(--text-muted); margin-bottom: 18px; line-height: 1.5;">
                        Firma hesapları (Kurumsal Alıcı & Tedarikçi, Süper Admin), üyelik seviyeleri ve Türkiye 81 il/ilçe veritabanı tablolarını denetleyip eksik kayıtları otomatik oluşturur.
                    </p>
                    <form asp-action="SeedSystemDefaults" method="post" id="seedDefaultsForm" onsubmit="handleSeedSystemDefaultsSubmit(event); return false;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-primary">
                            Tabloları Senkronize Et
                        </button>
                    </form>
                </div>

                <div class="content-card" style="padding: 22px;">
                    <h3 style="font-size: 1rem; font-weight: 700; color: var(--text-heading); margin-bottom: 8px;">
                        Erişim ve Güvenlik
                    </h3>
                    <ul style="font-size: 0.84rem; color: var(--text-muted); line-height: 1.7; padding-left: 18px;">
                        <li>Bu sayfaya yalnızca <strong>Süper Admin (Firma Tipi = 4)</strong> yetkisine sahip hesaplar doğrudan <code>/SuperAdmin</code> veya <code>/Admin</code> URL'i üzerinden erişebilir.</li>
                        <li>Normal kullanıcı arayüzlerinde bu yönetim merkezine yönlendiren bir buton veya bağlantı yer almaz.</li>
                    </ul>
                </div>
            </div>
        }

        <!-- ==================== SEKME 5: GERİ BİLDİRİMLER & DESTEK ==================== -->
        @if (Model.ActiveTab == "feedbacks")
        {
            var bugCount = Model.Feedbacks.Count(f => f.Category == "Hata Bildirimi");
            var suggestionCount = Model.Feedbacks.Count(f => f.Category == "Yeni Özellik / Öneri");
            var ratedFeedbacks = Model.Feedbacks.Where(f => f.Rating.HasValue && f.Rating > 0).ToList();
            var avgRating = ratedFeedbacks.Any() ? Math.Round(ratedFeedbacks.Average(f => f.Rating!.Value), 1) : 5.0;

            <!-- KPI ÖZET KARTLARI -->
            <div class="kpi-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-bottom: 24px;">
                <div class="kpi-card">
                    <div class="kpi-label">Toplam Geri Bildirim</div>
                    <div class="kpi-value" style="color: var(--primary);">@Model.TotalFeedbacksCount <small style="font-size: 0.8rem; color: var(--text-muted);">kayıt</small></div>
                    <div class="kpi-desc">Kullanıcı ve firmalardan iletilen toplam talep</div>
                </div>

                <div class="kpi-card" style="border-left: 4px solid #DC2626;">
                    <div class="kpi-label">Hata Bildirimleri</div>
                    <div class="kpi-value" style="color: #DC2626;">@bugCount <small style="font-size: 0.8rem; color: var(--text-muted);">hata</small></div>
                    <div class="kpi-desc">İncelenmesi gereken teknik arıza bildirimleri</div>
                </div>

                <div class="kpi-card" style="border-left: 4px solid #7C3AED;">
                    <div class="kpi-label">Öneri &amp; Yeni Özellikler</div>
                    <div class="kpi-value" style="color: #7C3AED;">@suggestionCount <small style="font-size: 0.8rem; color: var(--text-muted);">öneri</small></div>
                    <div class="kpi-desc">Platform geliştirme ve modül tavsiyeleri</div>
                </div>

                <div class="kpi-card" style="border-left: 4px solid #D97706;">
                    <div class="kpi-label">Ortalama Memnuniyet</div>
                    <div class="kpi-value" style="color: #D97706;">@avgRating.ToString("0.0") <small style="font-size: 0.82rem; color: var(--text-muted);">/ 5.0</small></div>
                    <div class="kpi-desc">Toplam @ratedFeedbacks.Count puanlanmış değerlendirme</div>
                </div>
            </div>

            <!-- GERİ BİLDİRİM LİSTESİ TABLOSU -->
            <div class="content-card">
                <div class="card-toolbar">
                    <div class="toolbar-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--primary);">
                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                        </svg>
                        Geri Bildirimler &amp; Destek Talepleri
                        <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;" id="fbVisibleCount">
                            (@Model.Feedbacks.Count kayıt listeleniyor)
                        </span>
                    </div>

                    <div class="toolbar-actions">
                        <form method="get" asp-action="Index" id="fbFilterForm" style="display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                            <input type="hidden" name="tab" value="feedbacks" />

                            <div class="search-input-wrap">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                                <input type="text" id="fbSearchInput" name="search" class="input-search" 
                                       placeholder="Firma, yetkili, konu, mesaj ara..." 
                                       value="@Model.SearchQuery"
                                       oninput="filterFeedbacksTable()" />
                            </div>

                            <select name="category" id="fbCategoryFilter" class="select-filter" onchange="filterFeedbacksTable(); this.form.submit();">
                                <option value="">— Tüm Kategoriler —</option>
                                <option value="Hata Bildirimi" selected="@(Model.FilterFeedbackCategory == "Hata Bildirimi")">Hata Bildirimi</option>
                                <option value="Yeni Özellik / Öneri" selected="@(Model.FilterFeedbackCategory == "Yeni Özellik / Öneri")">Yeni Özellik / Öneri</option>
                                <option value="Satın Alma & İhale" selected="@(Model.FilterFeedbackCategory == "Satın Alma & İhale")">Satın Alma &amp; İhale</option>
                                <option value="Arayüz & Kullanılabilirlik" selected="@(Model.FilterFeedbackCategory == "Arayüz & Kullanılabilirlik")">Arayüz &amp; UX</option>
                                <option value="Üyelik & Faturalandırma" selected="@(Model.FilterFeedbackCategory == "Üyelik & Faturalandırma")">Üyelik &amp; Fatura</option>
                                <option value="Genel Geri Bildirim" selected="@(Model.FilterFeedbackCategory == "Genel Geri Bildirim")">Genel Geri Bildirim</option>
                            </select>

                            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery) || !string.IsNullOrWhiteSpace(Model.FilterFeedbackCategory))
                            {
                                <a href="@Url.Action("Index", "SuperAdmin", new { tab = "feedbacks" })" class="btn-table-action" title="Filtreyi Temizle">Temizle</a>
                            }
                        </form>
                    </div>
                </div>

                <div class="data-table-wrap">
                    <table class="data-table" id="feedbacksTable">
                        <thead>
                            <tr>
                                <th style="width: 85px;">ID / Tarih</th>
                                <th style="width: 240px;">Kayıtlı Firma &amp; Yetkili</th>
                                <th style="width: 190px;">İletişim</th>
                                <th style="width: 200px;">Kategori &amp; Puan</th>
                                <th>Mesaj İçeriği</th>
                                <th style="width: 130px; text-align: right;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Feedbacks.Any())
                            {
                                foreach (var fb in Model.Feedbacks)
                                {
                                    string catBadgeClass = fb.Category switch {
                                        "Hata Bildirimi" => "badge-danger",
                                        "Yeni Özellik / Öneri" => "badge-purple",
                                        "Satın Alma & İhale" => "badge-warning",
                                        "Arayüz & Kullanılabilirlik" => "badge-info",
                                        _ => "badge-gray"
                                    };

                                    string tierBadgeClass = fb.MembershipTypeID switch {
                                        3 => "badge-kurumsal",
                                        2 => "badge-pro",
                                        _ => "badge-free"
                                    };

                                    <tr class="feedback-row" id="feedback-row-@fb.FormId"
                                        data-search="@fb.FormId @fb.CompanyName.ToLowerInvariant() @fb.OfficialName.ToLowerInvariant() @fb.Email.ToLowerInvariant() @fb.Phone.ToLowerInvariant() @fb.Category.ToLowerInvariant() @(fb.Subject?.ToLowerInvariant() ?? "") @fb.Message.ToLowerInvariant()"
                                        data-category="@fb.Category">
                                        <td>
                                            <div style="font-weight: 700; color: var(--text-heading); font-size: 0.86rem;">#@fb.FormId</div>
                                            <div style="font-size: 0.74rem; color: var(--text-muted); white-space: nowrap; margin-top: 2px;">
                                                @(fb.FormDate.HasValue ? fb.FormDate.Value.ToString("dd.MM.yyyy") : "—")
                                            </div>
                                        </td>
                                        <td>
                                            <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                                                <span style="font-weight: 600; color: var(--text-heading); font-size: 0.86rem;">@fb.CompanyName</span>
                                                @if (fb.IsRegisteredCompany)
                                                {
                                                    <span class="badge @tierBadgeClass">@fb.MembershipTypeName</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-gray" style="font-size: 0.65rem;">Kayıtsız</span>
                                                }
                                            </div>
                                            <div style="font-size: 0.76rem; color: var(--text-muted); margin-top: 2px;">
                                                Yetkili: <span style="color: var(--text-body); font-weight: 500;">@fb.OfficialName</span>
                                                @if (fb.IsRegisteredCompany && fb.CompanyID.HasValue)
                                                {
                                                    <span> · <a href="javascript:void(0)" onclick="openEditCompanyModal(@fb.CompanyID.Value)" style="color: var(--primary); text-decoration: none; font-weight: 500;">(Firma #@fb.CompanyID)</a></span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <div style="display: flex; flex-direction: column; gap: 3px;">
                                                @if (!string.IsNullOrWhiteSpace(fb.Email) && fb.Email != "-")
                                                {
                                                    <a href="mailto:@fb.Email" style="color: var(--primary); font-size: 0.82rem; font-weight: 500; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;" title="E-Posta Gönder">
                                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                                                        @fb.Email
                                                    </a>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(fb.Phone) && fb.Phone != "-")
                                                {
                                                    <span style="font-size: 0.76rem; color: var(--text-muted); display: inline-flex; align-items: center; gap: 4px;">
                                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                                                        @fb.Phone
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <div style="display: flex; flex-direction: column; gap: 4px;">
                                                <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                                                    <span class="badge @catBadgeClass">@fb.Category</span>
                                                    @if (fb.Rating.HasValue && fb.Rating.Value > 0)
                                                    {
                                                        <span class="badge badge-warning" style="font-weight: 700;">
                                                            ★ @fb.Rating/5
                                                        </span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(fb.Subject))
                                                {
                                                    <div style="font-size: 0.81rem; font-weight: 600; color: var(--text-heading); line-height: 1.3;">
                                                        @fb.Subject
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <div class="feedback-preview-box" 
                                                 data-id="@fb.FormId"
                                                 data-company-id="@(fb.CompanyID?.ToString() ?? "")"
                                                 data-name="@fb.CompanyName"
                                                 data-surname="@fb.OfficialName"
                                                 data-membership="@fb.MembershipTypeName"
                                                 data-email="@fb.Email"
                                                 data-phone="@fb.Phone"
                                                 data-category="@fb.Category"
                                                 data-subject="@fb.Subject"
                                                 data-rating="@(fb.Rating?.ToString() ?? "")"
                                                 data-date="@(fb.FormDate.HasValue ? fb.FormDate.Value.ToString("dd.MM.yyyy") : "-")"
                                                 data-text="@fb.Message"
                                                 onclick="openFeedbackDetail(this)"
                                                 title="Tam mesajı görüntülemek için tıklayın">
                                                @fb.Message
                                            </div>
                                        </td>
                                        <td style="text-align: right; white-space: nowrap;">
                                            <div class="actions-group">
                                                <button type="button" class="btn-table-action"
                                                        data-id="@fb.FormId"
                                                        data-company-id="@(fb.CompanyID?.ToString() ?? "")"
                                                        data-name="@fb.CompanyName"
                                                        data-surname="@fb.OfficialName"
                                                        data-membership="@fb.MembershipTypeName"
                                                        data-email="@fb.Email"
                                                        data-phone="@fb.Phone"
                                                        data-category="@fb.Category"
                                                        data-subject="@fb.Subject"
                                                        data-rating="@(fb.Rating?.ToString() ?? "")"
                                                        data-date="@(fb.FormDate.HasValue ? fb.FormDate.Value.ToString("dd.MM.yyyy") : "-")"
                                                        data-text="@fb.Message"
                                                        onclick="openFeedbackDetail(this)"
                                                        title="Geri Bildirim Detaylarını İncele">
                                                    İncele
                                                </button>
                                                <button type="button" class="btn-table-action danger" 
                                                        onclick="handleDeleteFeedbackClick(@fb.FormId)"
                                                        title="Bu Bildirimi Kalıcı Olarak Sil">
                                                    Sil
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" style="text-align: center; padding: 48px 16px; color: var(--text-muted);">
                                        <div style="font-size: 0.95rem; font-weight: 600; margin-bottom: 4px;">Kayıtlı geri bildirim veya destek talebi bulunamadı.</div>
                                        <div style="font-size: 0.82rem;">Kullanıcılar Dashboard üzerinden geri bildirim gönderdiğinde burada listelenecektir.</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

    </main>

    <!-- ==================== MODAL: YENİ KATEGORİ EKLE ==================== -->
    <div id="addCategoryModal" class="modal-backdrop-wrap" aria-hidden="true">
        <div class="modal-panel" style="max-width: 540px;">
            <div class="modal-header">
                <h3 class="modal-title">Yeni Kategori Ekle</h3>
                <button type="button" class="modal-close-btn" onclick="closeModal('addCategoryModal')">&times;</button>
            </div>
            <form asp-action="CreateCategory" method="post" id="addCategoryForm" onsubmit="handleAddCategorySubmit(event); return false;">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="form-field">
                        <label class="form-label" for="newCatName">Kategori Adı *</label>
                        <input type="text" id="newCatName" name="categoryName" class="form-input" placeholder="Örn: Elektrik & Otomasyon" required />
                    </div>

                    <div class="form-field">
                        <label class="form-label" for="newCatParent">Üst Kategori (İsteğe Bağlı)</label>
                        <select id="newCatParent" name="parentCategoryId" class="form-select" onchange="toggleCatIconField('new')">
                            <option value="">— Yok (Ana / Kök Kategori Olarak Ekle) —</option>
                            @foreach (var parent in Model.AvailableParentCategories)
                            {
                                <option value="@parent.CategoryID">@parent.FormattedName</option>
                            }
                        </select>
                        <span class="field-hint" style="font-size:0.75rem; color:var(--text-muted); margin-top:4px; display:block;">
                            Eğer ana kategori oluşturuyorsanız simge seçimi zorunludur.
                        </span>
                    </div>

                    <!-- KÖK KATEGORİ SİMGE SEÇİCİ (Yalnızca Ana/Kök Kategoriler için) -->
                    <div class="form-field" id="newCatIconGroup">
                        <label class="form-label" for="newCatIcon">
                            Kök Kategori Simgesi (Font Awesome) <span style="color:#ef4444;">*</span>
                        </label>
                        <div class="icon-selector-control">
                            <div class="icon-preview-box">
                                <i id="newCatIconPreview" class="fa-solid fa-folder-tree"></i>
                            </div>
                            <input type="text" id="newCatIcon" name="icon" class="form-input" placeholder="Örn: fa-solid fa-microchip" value="fa-solid fa-folder-tree" oninput="updateIconPreview('new')" required />
                        </div>
                        <div class="icon-picker-hints">
                            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; gap: 8px;">
                                <span class="hint-label" style="margin-bottom: 0;">Simgelerden Seçin (175+ Simge):</span>
                                <input type="text" id="newCatIconFilter" class="form-input" placeholder="Simge ara... (robot, kaynak, tır...)" style="max-width: 220px; font-size: 0.76rem; padding: 4px 8px; height: 28px;" oninput="filterIconChips('new', this.value)" />
                            </div>
                            <div class="icon-chips-grid" id="newCatIconChips">
                                <!-- JS ile dinamik doldurulacak -->
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="closeModal('addCategoryModal')">Vazgeç</button>
                    <button type="submit" class="btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ==================== MODAL: KATEGORİ DÜZENLE ==================== -->
    <div id="editCategoryModal" class="modal-backdrop-wrap" aria-hidden="true">
        <div class="modal-panel" style="max-width: 540px;">
            <div class="modal-header">
                <h3 class="modal-title">Kategoriyi Düzenle</h3>
                <button type="button" class="modal-close-btn" onclick="closeModal('editCategoryModal')">&times;</button>
            </div>
            <form asp-action="UpdateCategory" method="post" id="editCategoryForm" onsubmit="handleEditCategorySubmit(event); return false;">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editCatId" name="CategoryID" />
                <div class="modal-body">
                    <div class="form-field">
                        <label class="form-label" for="editCatName">Kategori Adı *</label>
                        <input type="text" id="editCatName" name="CategoryName" class="form-input" required />
                    </div>

                    <div class="form-field">
                        <label class="form-label" for="editCatParent">Üst Kategori</label>
                        <select id="editCatParent" name="ParentCategoryID" class="form-select" onchange="toggleCatIconField('edit')">
                            <option value="">— Yok (Ana / Kök Kategori) —</option>
                            @foreach (var parent in Model.AvailableParentCategories)
                            {
                                <option value="@parent.CategoryID">@parent.FormattedName</option>
                            }
                        </select>
                        <span class="field-hint" style="font-size:0.75rem; color:var(--text-muted); margin-top:4px; display:block;">
                            Kök kategori ise bir simge belirlenmesi zorunludur.
                        </span>
                    </div>

                    <!-- KÖK KATEGORİ SİMGE SEÇİCİ -->
                    <div class="form-field" id="editCatIconGroup">
                        <label class="form-label" for="editCatIcon">
                            Kök Kategori Simgesi (Font Awesome) <span style="color:#ef4444;">*</span>
                        </label>
                        <div class="icon-selector-control">
                            <div class="icon-preview-box">
                                <i id="editCatIconPreview" class="fa-solid fa-folder-tree"></i>
                            </div>
                            <input type="text" id="editCatIcon" name="Icon" class="form-input" placeholder="Örn: fa-solid fa-microchip" oninput="updateIconPreview('edit')" />
                        </div>
                        <div class="icon-picker-hints">
                            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; gap: 8px;">
                                <span class="hint-label" style="margin-bottom: 0;">Simgelerden Seçin (175+ Simge):</span>
                                <input type="text" id="editCatIconFilter" class="form-input" placeholder="Simge ara... (robot, kaynak, tır...)" style="max-width: 220px; font-size: 0.76rem; padding: 4px 8px; height: 28px;" oninput="filterIconChips('edit', this.value)" />
                            </div>
                            <div class="icon-chips-grid" id="editCatIconChips">
                                <!-- JS ile dinamik doldurulacak -->
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="closeModal('editCategoryModal')">Vazgeç</button>
                    <button type="submit" class="btn-primary">Değişiklikleri Kaydet</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ==================== MODAL: FİRMA BİLGİLERİNİ DÜZENLE ==================== -->
    <div id="editCompanyModal" class="modal-backdrop-wrap" aria-hidden="true">
        <div class="modal-panel" style="max-width: 620px;">
            <div class="modal-header">
                <h3 class="modal-title">Firma Bilgilerini Düzenle</h3>
                <button type="button" class="modal-close-btn" onclick="closeModal('editCompanyModal')">&times;</button>
            </div>
            <form asp-action="UpdateCompany" method="post" id="editCompanyForm" onsubmit="handleEditCompanySubmit(event); return false;">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editCompId" name="CompanyID" />
                <div class="modal-body">
                    <div class="form-field-grid">
                        <div class="form-field">
                            <label class="form-label" for="editCompName">Firma Adı / Unvanı *</label>
                            <input type="text" id="editCompName" name="CompanyName" class="form-input" required />
                        </div>
                        <div class="form-field">
                            <label class="form-label" for="editCompOfficial">Yetkili Kişi *</label>
                            <input type="text" id="editCompOfficial" name="CompanyOfficial" class="form-input" required />
                        </div>
                    </div>

                    <div class="form-field-grid">
                        <div class="form-field">
                            <label class="form-label" for="editCompMail">E-posta Adresi *</label>
                            <input type="email" id="editCompMail" name="CompanyMail" class="form-input" required />
                        </div>
                        <div class="form-field">
                            <label class="form-label" for="editCompPhone">Telefon</label>
                            <input type="text" id="editCompPhone" name="CompanyPhone" class="form-input" placeholder="05XXXXXXXXX" />
                        </div>
                    </div>

                    <div class="form-field-grid">
                        <div class="form-field">
                            <label class="form-label" for="editCompType">Hesap Türü (Rol) *</label>
                            <select id="editCompType" name="CompanyTypeID" class="form-select">
                                <option value="3">Kurumsal Firma (Alıcı & Tedarikçi)</option>
                                <option value="4">Süper Admin</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label" for="editCompMember">Üyelik Seviyesi *</label>
                            <select id="editCompMember" name="MembershipTypeID" class="form-select">
                                @foreach (var mt in Model.AvailableMembershipTypes)
                                {
                                    string desc = mt.MembershipTypeID switch
                                    {
                                        1 => "Bedava (10 Talep, 10 Ürün, 3 Resim - Ücretsiz)",
                                        2 => "Pro (100 Talep, 100 Ürün, 20 Resim - 990 ₺/Ay)",
                                        3 => "Kurumsal (Sınırsız Talep, Ürün, Resim - 2.990 ₺/Ay)",
                                        _ => mt.MembershipTypeName ?? "Standart"
                                    };
                                    <option value="@mt.MembershipTypeID">@desc</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-field-grid">
                        <div class="form-field">
                            <label class="form-label" for="editCompTc">T.C. / Vergi Kimlik No</label>
                            <input type="text" id="editCompTc" name="TCNO" class="form-input" />
                        </div>
                        <div class="form-field">
                            <label class="form-label" for="editCompTax">Vergi Dairesi</label>
                            <input type="text" id="editCompTax" name="TaxOffice" class="form-input" />
                        </div>
                    </div>

                    <div class="form-field">
                        <label class="form-label" for="editCompAddress">Adres</label>
                        <input type="text" id="editCompAddress" name="AddressText" class="form-input" placeholder="Açık adres bilgisi..." />
                    </div>

                    <div class="form-field">
                        <label class="form-label" for="editCompDetail">Firma Açıklama / Faaliyet Alanı</label>
                        <textarea id="editCompDetail" name="CompanyDetailText" class="form-textarea" rows="2" placeholder="Firma hakkında kısa not..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="closeModal('editCompanyModal')">Vazgeç</button>
                    <button type="submit" class="btn-primary">Güncelle</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ==================== MODAL: ŞİFRE SIFIRLA ==================== -->
    <div id="resetPasswordModal" class="modal-backdrop-wrap" aria-hidden="true">
        <div class="modal-panel" style="max-width: 440px;">
            <div class="modal-header">
                <h3 class="modal-title">Şifre Sıfırla</h3>
                <button type="button" class="modal-close-btn" onclick="closeModal('resetPasswordModal')">&times;</button>
            </div>
            <form asp-action="ResetCompanyPassword" method="post" id="resetPasswordForm" onsubmit="handleResetPasswordSubmit(event); return false;">
                @Html.AntiForgeryToken()
                <input type="hidden" id="resetCompId" name="CompanyID" />
                <div class="modal-body">
                    <p id="resetCompNameDisplay" style="font-size: 0.88rem; color: var(--text-heading); font-weight: 600;"></p>
                    <div class="form-field">
                        <label class="form-label" for="newPasswordInput">Yeni Şifre (En az 6 karakter) *</label>
                        <input type="password" id="newPasswordInput" name="NewPassword" class="form-input" placeholder="Yeni şifre giriniz..." required minlength="6" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="closeModal('resetPasswordModal')">Vazgeç</button>
                    <button type="submit" class="btn-primary">Şifreyi Kaydet</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ==================== MODAL: SİPARİŞ & ÇOKLU SEVKİYAT YÖNETİMİ ==================== -->
    <div id="adminOrderModal" class="modal-backdrop-wrap" aria-hidden="true">
        <div class="modal-panel" style="max-width: 860px;">
            <div class="modal-header">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--primary);">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                    </svg>
                    <h3 class="modal-title" id="adminOrderModalTitle">Sipariş &amp; Sevkiyat Yönetimi</h3>
                </div>
                <button type="button" class="modal-close-btn" onclick="closeModal('adminOrderModal')">&times;</button>
            </div>
            
            <div class="modal-body" style="padding: 20px;">
                <!-- Üst Bilgi Kartı -->
