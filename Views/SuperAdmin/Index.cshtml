        function renderCategoryIconChips(mode, filterQuery) {
            const container = document.getElementById(mode + 'CatIconChips');
            if (!container) return;
            container.innerHTML = '';

            const q = (filterQuery || '').trim().toLowerCase();
            const filtered = q
                ? CATEGORIES_PRESET_ICONS.filter(item =>
                    item.label.toLowerCase().includes(q) ||
                    item.icon.toLowerCase().includes(q) ||
                    (item.cat && item.cat.toLowerCase().includes(q))
                )
                : CATEGORIES_PRESET_ICONS;

            if (filtered.length === 0) {
                const empty = document.createElement('div');
                empty.style.gridColumn = '1 / -1';
                empty.style.textAlign = 'center';
                empty.style.color = '#94A3B8';
                empty.style.fontSize = '0.78rem';
                empty.style.padding = '14px 4px';
                empty.textContent = '"' + filterQuery + '" ile eşleşen simge bulunamadı.';
                container.appendChild(empty);
                return;
            }

            const currentVal = (document.getElementById(mode + 'CatIcon')?.value || '').trim();

            filtered.forEach(item => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'icon-chip-btn' + (item.icon === currentVal ? ' is-active' : '');
                btn.title = item.label;
                btn.innerHTML = `<i class="${item.icon}"></i>`;
                btn.onclick = () => selectCategoryIcon(mode, item.icon);
                container.appendChild(btn);
            });
        }

        function filterIconChips(mode, query) {
            renderCategoryIconChips(mode, query);
        }

        function initCategoryIconPickers(targetMode) {
            const modes = targetMode ? [targetMode] : ['new', 'edit'];
            modes.forEach(mode => {
                const filterInput = document.getElementById(mode + 'CatIconFilter');
                if (filterInput) filterInput.value = '';
                renderCategoryIconChips(mode, '');
            });
        }

        function selectCategoryIcon(mode, iconClass) {
            const input = document.getElementById(mode + 'CatIcon');
            if (input) {
                input.value = iconClass;
                updateIconPreview(mode);
            }
        }

        function updateIconPreview(mode) {
            const input = document.getElementById(mode + 'CatIcon');
            const preview = document.getElementById(mode + 'CatIconPreview');
            const chips = document.querySelectorAll(`#${mode}CatIconChips .icon-chip-btn`);
            const val = input ? input.value.trim() : '';
            if (preview) {
                preview.className = val || 'fa-solid fa-folder-tree';
            }
            chips.forEach(chip => {
                const iconEl = chip.querySelector('i');
                if (iconEl && iconEl.className === val) {
                    chip.classList.add('is-active');
                } else {
                    chip.classList.remove('is-active');
                }
            });
        }

        function toggleCatIconField(mode) {
            const parentSelect = document.getElementById(mode + 'CatParent');
            const group = document.getElementById(mode + 'CatIconGroup');
            const input = document.getElementById(mode + 'CatIcon');
            const isRoot = !parentSelect || !parentSelect.value;
            if (group) {
                group.style.display = isRoot ? 'block' : 'none';
            }
            if (input) {
                if (isRoot) {
                    input.setAttribute('required', 'required');
                    if (!input.value.trim()) {
                        input.value = 'fa-solid fa-folder-tree';
                        updateIconPreview(mode);
                    }
                } else {
                    input.removeAttribute('required');
                }
            }
        }

        function openAddCategoryModal(parentCatId) {
            initCategoryIconPickers('new');
            document.getElementById('newCatName').value = '';
            const parentSelect = document.getElementById('newCatParent');
            if (parentSelect) parentSelect.value = parentCatId || '';
            const iconInput = document.getElementById('newCatIcon');
            if (iconInput) iconInput.value = 'fa-solid fa-folder-tree';
            toggleCatIconField('new');
            updateIconPreview('new');
            openModal('addCategoryModal');
        }

        async function openEditCategoryModal(catId) {
            try {
                initCategoryIconPickers('edit');
                var response = await fetch('/SuperAdmin/GetCategory/' + catId);
                var data = await response.json();
                if (data.success) {
                    document.getElementById('editCatId').value = data.categoryId;
                    document.getElementById('editCatName').value = data.categoryName;
                    var parentSelect = document.getElementById('editCatParent');
                    if (parentSelect) parentSelect.value = data.parentCategoryId || '';
                    var iconInput = document.getElementById('editCatIcon');
                    if (iconInput) iconInput.value = data.icon || 'fa-solid fa-folder-tree';
                    toggleCatIconField('edit');
                    updateIconPreview('edit');
                    openModal('editCategoryModal');
                } else {
                    alert('Kategori bilgisi alınamadı.');
                }
            } catch (err) {
                alert('Bağlantı hatası: ' + err.message);
            }
        }

