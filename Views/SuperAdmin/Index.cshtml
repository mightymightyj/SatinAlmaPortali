        function removeSimRequestItemRow(btn) {
            const tbody = document.getElementById('simReqItemsTbody');
            if (!tbody) return;
            const rows = tbody.querySelectorAll('.sim-req-item-row');
            if (rows.length <= 1) {
                showAdminToast('Talebin en az 1 kalemi olmalıdır.', 'error');
                return;
            }
            const row = btn.closest('tr');
            if (row) row.remove();
            reindexSimRequestRows();
            recalculateSimRequestTotals();
        }

        function reindexSimRequestRows() {
            const tbody = document.getElementById('simReqItemsTbody');
            if (!tbody) return;
            const rows = tbody.querySelectorAll('.sim-req-item-row');
            rows.forEach((r, idx) => {
                const tdIndex = r.querySelector('td:first-child');
                if (tdIndex) tdIndex.textContent = (idx + 1);
            });
            const badge = document.getElementById('simReqItemsBadge');
            if (badge) badge.textContent = `${rows.length} Kalem`;
        }

        function recalculateSimRequestTotals() {
            const tbody = document.getElementById('simReqItemsTbody');
            if (!tbody) return;
            const rows = tbody.querySelectorAll('.sim-req-item-row');
            let totalQty = 0;
            let totalBudget = 0;
            rows.forEach(r => {
                const q = parseFloat(r.querySelector('.sim-it-qty')?.value) || 0;
                const p = parseFloat(r.querySelector('.sim-it-price')?.value) || 0;
                totalQty += q;
                totalBudget += (q * p);
            });

            const qtyInput = document.getElementById('simQuantity');
            if (qtyInput) qtyInput.value = totalQty;
            const qtyDisp = document.getElementById('simReqTotalQtyDisplay');
            if (qtyDisp) qtyDisp.textContent = `${totalQty} Birim`;

            const budgetInput = document.getElementById('simBudget');
            if (budgetInput && totalBudget > 0) budgetInput.value = totalBudget.toFixed(2);
            const budgetDisp = document.getElementById('simReqTotalBudgetDisplay');
            if (budgetDisp) {
                budgetDisp.textContent = totalBudget > 0 ? (totalBudget.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺') : 'Belirtilmedi';
            }
        }

        // --- TEKLİF SİMÜLASYONU KALEM YÖNETİMİ ---
        let currentSimOfferRequestItems = [];

        async function loadSimOfferRequestItems(reqId) {
            const container = document.getElementById('simOfferItemsContainer');
            const tbody = document.getElementById('simOfferItemsTbody');
            const badge = document.getElementById('simOfferItemsCountBadge');
            
            if (!reqId || reqId <= 0) {
                if (container) container.style.display = 'none';
                currentSimOfferRequestItems = [];
                return;
            }

            try {
                if (tbody) tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 12px; color: #64748B;">⏳ Talep kalemleri yükleniyor...</td></tr>';
                if (container) container.style.display = 'block';

                const response = await fetch(`/SuperAdmin/GetRequestDetailsForSim?id=${reqId}`, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
                });
                const data = await response.json();

                if (!data.success || !data.items || data.items.length === 0) {
                    if (tbody) tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 12px; color: #64748B;">Kalem bulunamadı. Genel tutar girebilirsiniz.</td></tr>';
                    currentSimOfferRequestItems = [];
                    return;
                }

                currentSimOfferRequestItems = data.items;
                if (badge) badge.textContent = `${data.items.length} Kalem`;

                let html = '';
                data.items.forEach((it, idx) => {
                    const estUPrice = it.estimatedUnitPrice || 0;
                    const estUPriceFormatted = it.estimatedUnitPriceFormatted || '-';
                    const defaultOfferUnitPrice = estUPrice > 0 ? (estUPrice * 0.95).toFixed(2) : '';
                    const defaultLineTotal = estUPrice > 0 ? (estUPrice * 0.95 * it.quantity).toFixed(2) : '0.00';

                    html += `
                        <tr class="sim-offer-item-row" data-item-id="${it.requestItemId}" data-qty="${it.quantity}" data-est-price="${estUPrice}">
                            <td style="text-align: center; font-weight: 700; color: #64748B;">${idx + 1}</td>
                            <td>
                                <div style="font-weight: 600; color: #0F172A;">${it.itemName}</div>
                                ${it.itemDescription ? `<div style="font-size: 0.72rem; color: #64748B;">${it.itemDescription}</div>` : ''}
                            </td>
                            <td style="text-align: center; font-weight: 600; color: #0284C7;">${it.quantity} ${it.unit}</td>
                            <td style="text-align: right; color: #64748B; font-size: 0.76rem;">${estUPriceFormatted}</td>
                            <td style="text-align: right;">
                                <input type="number" step="0.01" class="sim-off-unitprice form-input" style="padding: 4px 6px; font-size: 0.80rem; text-align: right; width: 100px; font-weight: 600; color: #15803D;" placeholder="0,00" value="${defaultOfferUnitPrice}" required oninput="recalculateSimOfferTotals()" />
                            </td>
                            <td style="text-align: right; font-weight: 700; color: #166534;" class="sim-off-linetotal">
                                ${parseFloat(defaultLineTotal).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ₺
                            </td>
                            <td>
                                <input type="text" class="sim-off-itemnote form-input" style="padding: 4px 6px; font-size: 0.75rem;" placeholder="Marka/stok notu..." />
                            </td>
                        </tr>
                    `;
                });

                if (tbody) tbody.innerHTML = html;
                recalculateSimOfferTotals();

            } catch (err) {
                if (tbody) tbody.innerHTML = `<tr><td colspan="7" style="text-align: center; color: #EF4444; padding: 8px;">Yükleme hatası: ${err.message}</td></tr>`;
            }
        }

        function fillSimOfferPrices(discountPercent = 0) {
            const tbody = document.getElementById('simOfferItemsTbody');
            if (!tbody) return;
            const rows = tbody.querySelectorAll('.sim-offer-item-row');
            rows.forEach(r => {
                const est = parseFloat(r.getAttribute('data-est-price')) || 0;
                const input = r.querySelector('.sim-off-unitprice');
                if (input && est > 0) {
                    const price = est * (1 - (discountPercent / 100));
                    input.value = price.toFixed(2);
                }
            });
            recalculateSimOfferTotals();
        }

        function recalculateSimOfferTotals() {
            const tbody = document.getElementById('simOfferItemsTbody');
            let grandTotal = 0;
            if (tbody) {
                const rows = tbody.querySelectorAll('.sim-offer-item-row');
                rows.forEach(r => {
                    const qty = parseFloat(r.getAttribute('data-qty')) || 1;
                    const uPriceInput = r.querySelector('.sim-off-unitprice');
                    const uPrice = uPriceInput ? (parseFloat(uPriceInput.value) || 0) : 0;
                    const lineTot = qty * uPrice;
                    grandTotal += lineTot;

                    const lineTotCell = r.querySelector('.sim-off-linetotal');
                    if (lineTotCell) {
                        lineTotCell.textContent = lineTot.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
                    }
                });
            }

            const totalDisplay = document.getElementById('simOfferCalculatedTotal');
            if (totalDisplay) {
                totalDisplay.textContent = grandTotal.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
            }

            const offerPriceInput = document.getElementById('simOfferPrice');
            if (offerPriceInput && grandTotal > 0) {
                offerPriceInput.value = grandTotal.toFixed(2);
            }
        }

        // 8. Simülasyon: Talep Oluştur AJAX
        async function handleSimRequestSubmit(event) {
            if (event) { event.preventDefault(); event.stopPropagation(); }
            const form = event.target;
            const submitBtn = form.querySelector('button[type="submit"]');
            const origText = submitBtn ? submitBtn.innerHTML : 'Seçilen Firma Adına Talebi Yayınla';
            if (submitBtn) { submitBtn.disabled = true; submitBtn.innerHTML = '⏳ Yayınlanıyor...'; }

            try {
                // Kalemleri topla
                const items = [];
                const rows = form.querySelectorAll('#simReqItemsTbody .sim-req-item-row');
                rows.forEach(r => {
                    const name = r.querySelector('.sim-it-name')?.value?.trim();
                    const qty = parseFloat(r.querySelector('.sim-it-qty')?.value) || 1;
                    const unit = r.querySelector('.sim-it-unit')?.value || 'Adet';
                    const price = parseFloat(r.querySelector('.sim-it-price')?.value) || null;
                    const desc = r.querySelector('.sim-it-desc')?.value?.trim() || null;
                    if (name) {
                        items.push({
                            itemName: name,
                            quantity: qty,
                            unit: unit,
                            estimatedUnitPrice: price,
                            itemDescription: desc
                        });
                    }
                });

                const payload = {
                    senderCompanyID: parseInt(form.querySelector('#simSenderComp')?.value) || 0,
                    productName: form.querySelector('#simProdName')?.value?.trim() || '',
                    requestType: form.querySelector('#simReqType')?.value || 'Satın Alma',
                    categoryID: parseInt(form.querySelector('#simCategory')?.value) || null,
                    quantity: parseInt(form.querySelector('#simQuantity')?.value) || 1,
                    estimatedBudget: parseFloat(form.querySelector('#simBudget')?.value) || null,
                    targetDeliveryDate: form.querySelector('#simDeliveryDate')?.value || null,
                    notes: form.querySelector('#simNotes')?.value?.trim() || null,
                    items: items
                };

                const response = await fetch('/SuperAdmin/SimulateCreateRequest', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest', 
                        'Accept': 'application/json' 
                    },
                    body: JSON.stringify(payload)
                });
                const result = await response.json();
                if (result.success) {
                    form.reset();
                    // Teklif dropdown'ına yeni talebi dinamik ekle
                    if (result.requestId) {
                        const offerReqSelect = document.getElementById('simOfferReq');
                        if (offerReqSelect) {
                            const newOpt = document.createElement('option');
                            newOpt.value = result.requestId;
                            newOpt.textContent = `#REQ-${result.requestId}: ${result.productName} (${payload.quantity} Birim, ${result.itemCount || 1} Kalem)`;
                            offerReqSelect.appendChild(newOpt);
                            offerReqSelect.value = result.requestId;
                            loadSimOfferRequestItems(result.requestId);
                        }
                    }
                    showAdminToast('✓ ' + (result.message || 'Talep yayınlandı!'), 'success');
                } else {
                    showAdminToast('Hata: ' + (result.message || 'Talep oluşturulamadı.'), 'error');
                }
            } catch (err) {
                showAdminToast('Bağlantı hatası: ' + err.message, 'error');
            } finally {
                if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = origText; }
            }
        }

        // 9. Simülasyon: Teklif Gönder AJAX
        async function handleSimOfferSubmit(event) {
            if (event) { event.preventDefault(); event.stopPropagation(); }
            const form = event.target;
            const submitBtn = form.querySelector('button[type="submit"]');
            const origText = submitBtn ? submitBtn.innerHTML : 'Seçilen Firma Adına Teklif Gönder';
            if (submitBtn) { submitBtn.disabled = true; submitBtn.innerHTML = '⏳ Gönderiliyor...'; }

            try {
                // Kalem bazlı teklifleri topla
                const items = [];
                const rows = form.querySelectorAll('#simOfferItemsTbody .sim-offer-item-row');
                rows.forEach(r => {
                    const reqItemId = parseInt(r.getAttribute('data-item-id')) || 0;
                    const uPrice = parseFloat(r.querySelector('.sim-off-unitprice')?.value);
                    const note = r.querySelector('.sim-off-itemnote')?.value?.trim() || null;
                    if (!isNaN(uPrice)) {
                        items.push({
                            requestItemID: reqItemId,
                            unitPrice: uPrice,
                            notes: note
                        });
                    }
                });

                const payload = {
                    requestID: parseInt(form.querySelector('#simOfferReq')?.value) || 0,
                    supplierCompanyID: parseInt(form.querySelector('#simOfferSupplier')?.value) || 0,
                    offeredPrice: parseFloat(form.querySelector('#simOfferPrice')?.value) || 0,
                    deliveryDays: parseInt(form.querySelector('#simDeliveryDays')?.value) || 7,
                    validityDays: parseInt(form.querySelector('#simValidityDays')?.value) || 30,
                    supplierNotes: form.querySelector('#simSupplierNotes')?.value?.trim() || null,
                    items: items
                };

                const response = await fetch('/SuperAdmin/SimulateCreateOffer', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest', 
                        'Accept': 'application/json' 
                    },
                    body: JSON.stringify(payload)
                });
                const result = await response.json();
                if (result.success) {
                    form.reset();
                    const container = document.getElementById('simOfferItemsContainer');
                    if (container) container.style.display = 'none';
                    showAdminToast('✓ ' + (result.message || 'Teklif başarıyla iletildi!'), 'success');
                } else {
                    showAdminToast('Hata: ' + (result.message || 'Teklif iletilemedi.'), 'error');
                }
            } catch (err) {
                showAdminToast('Bağlantı hatası: ' + err.message, 'error');
            } finally {
                if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = origText; }
            }
        }

        // 10. İlan Sil AJAX
        async function handleDeleteListing(itemId, itemName, event) {
            if (event) { event.preventDefault(); event.stopPropagation(); }
            if (!confirm(`'${itemName}' ürün ilanını vitrinden silmek istediğinize emin misiniz?`)) return;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const formData = new FormData();
                formData.append('id', itemId);
                formData.append('__RequestVerificationToken', token);

                const response = await fetch('/SuperAdmin/DeleteListing?id=' + itemId, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
                    body: formData
                });
                const result = await response.json();
                if (result.success) {
                    showAdminToast('✓ ' + (result.message || 'İlan kaldırıldı.'), 'success');
                    const row = document.getElementById('listing-row-' + itemId);
                    if (row) {
                        row.style.transition = 'all 0.3s ease';
                        row.style.opacity = '0';
                        row.style.transform = 'scale(0.96)';
                        setTimeout(() => row.remove(), 300);
                    }
                } else {
                    showAdminToast('Hata: ' + (result.message || 'İlan silinemedi.'), 'error');
                }
            } catch (err) {
                showAdminToast('Bağlantı hatası: ' + err.message, 'error');
            }
        }

        // 11. Sistem Tablolarını Senkronize Et AJAX
        async function handleSeedSystemDefaultsSubmit(event) {
            if (event) { event.preventDefault(); event.stopPropagation(); }
            if (!confirm('Varsayılan referans verileri senkronize edilsin mi?')) return;
            const form = event.target;
