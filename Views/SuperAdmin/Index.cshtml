                formData.append('__RequestVerificationToken', token);

                const response = await fetch('/SuperAdmin/DeleteReview?id=' + reviewId, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
                    body: formData
                });
                const result = await response.json();
                if (result.success) {
                    showAdminToast(result.message || 'Değerlendirme silindi.', 'success');
                    const row = document.getElementById('review-row-' + reviewId);
                    if (row) {
                        row.style.transition = 'all 0.3s ease';
                        row.style.opacity = '0';
                        row.style.transform = 'scale(0.96)';
                        setTimeout(() => row.remove(), 300);
                    }
                } else {
                    showAdminToast('Hata: ' + (result.message || 'Değerlendirme silinemedi.'), 'error');
                }
            } catch (err) {
                showAdminToast('Bağlantı hatası: ' + err.message, 'error');
            }
        }

        // 15. Demo Değerlendirmeler Üret AJAX
        async function handleGenerateDemoReviewsSubmit(event) {
            if (event) { event.preventDefault(); event.stopPropagation(); }
            if (!confirm('Sistemdeki tüm kurumsal firmalar için otomatik demo değerlendirmeler üretilsin mi?')) return;
            const form = event.target;
            const submitBtn = form.querySelector('button[type="submit"]');
            const origText = submitBtn ? submitBtn.innerHTML : 'Demo Üret';
            if (submitBtn) { submitBtn.disabled = true; submitBtn.innerHTML = 'Üretiliyor...'; }

            try {
                const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const formData = new FormData();
                formData.append('__RequestVerificationToken', token);

                const response = await fetch('/SuperAdmin/GenerateDemoReviews', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
                    body: formData
                });
                const result = await response.json();
                if (result.success) {
                    showAdminToast(result.message || 'Demo değerlendirmeler üretildi.', 'success');
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    showAdminToast('Hata: ' + (result.message || 'Üretim hatası.'), 'error');
                }
            } catch (err) {
                showAdminToast('Bağlantı hatası: ' + err.message, 'error');
            } finally {
                if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = origText; }
            }
        }

        // 16. Geri Bildirim Tablosu Filtreleme (Anlık İstemci Filtresi)
        function filterFeedbacksTable() {
            var search = (document.getElementById('fbSearchInput')?.value || '').toLowerCase().trim();
            var category = (document.getElementById('fbCategoryFilter')?.value || '').toLowerCase().trim();
            var rows = document.querySelectorAll('.feedback-row');
            var visible = 0;

            rows.forEach(function(row) {
                var searchData = (row.getAttribute('data-search') || '').toLowerCase();
                var catData = (row.getAttribute('data-category') || '').toLowerCase();

                var matchesSearch = !search || searchData.indexOf(search) > -1;
                var matchesCat = !category || catData.indexOf(category) > -1;

                if (matchesSearch && matchesCat) {
                    row.style.display = '';
                    visible++;
                } else {
                    row.style.display = 'none';
                }
            });

            var countEl = document.getElementById('fbVisibleCount');
            if (countEl) {
                countEl.textContent = '(' + visible + ' kayıt listeleniyor)';
            }
        }

        // 17. Geri Bildirim Detay Modalı ve Silme
        function openFeedbackDetail(btn) {
            if (!btn) return;
            var id = btn.getAttribute('data-id') || '';
            var name = btn.getAttribute('data-name') || 'Kurumsal Kullanıcı';
            var surname = btn.getAttribute('data-surname') || '';
            var membership = btn.getAttribute('data-membership') || '';
            var email = btn.getAttribute('data-email') || '-';
            var phone = btn.getAttribute('data-phone') || '-';
            var category = btn.getAttribute('data-category') || 'Genel';
            var subject = btn.getAttribute('data-subject') || '';
            var rating = btn.getAttribute('data-rating') || '';
            var date = btn.getAttribute('data-date') || '-';
            var text = btn.getAttribute('data-text') || '';

            document.getElementById('fbModalTitle').textContent = 'Geri Bildirim #' + id;
            document.getElementById('fbModalSender').textContent = name;
            document.getElementById('fbModalOfficial').textContent = 'Yetkili: ' + (surname || '-');
            
            var memBadge = document.getElementById('fbModalMembershipBadge');
            if (membership) {
                memBadge.textContent = membership;
                var memClass = membership === 'Kurumsal' ? 'badge-kurumsal' : (membership === 'Pro' ? 'badge-pro' : 'badge-free');
                memBadge.className = 'badge ' + memClass;
                memBadge.style.display = 'inline-block';
            } else {
                memBadge.style.display = 'none';
            }

            document.getElementById('fbModalEmail').textContent = email;
            document.getElementById('fbModalPhone').textContent = phone;
            document.getElementById('fbModalDate').textContent = 'Tarih: ' + date;

            var catBadge = document.getElementById('fbModalCategoryBadge');
            catBadge.textContent = category;
            var catClass = 'badge-gray';
            if (category === 'Hata Bildirimi') catClass = 'badge-danger';
            else if (category.indexOf('Öneri') > -1) catClass = 'badge-purple';
            else if (category.indexOf('İhale') > -1) catClass = 'badge-warning';
            else if (category.indexOf('Arayüz') > -1) catClass = 'badge-info';
            catBadge.className = 'badge ' + catClass;

            document.getElementById('fbModalSubject').textContent = subject ? ('— ' + subject) : '';

            var ratingWrap = document.getElementById('fbModalRatingWrap');
            var ratingEl = document.getElementById('fbModalRating');
            if (rating && rating !== '0') {
                ratingWrap.style.display = 'block';
                ratingEl.textContent = '★ ' + rating + ' / 5';
            } else {
                ratingWrap.style.display = 'none';
            }

            document.getElementById('fbModalMessage').textContent = text;

            var replyLink = document.getElementById('fbModalReplyMail');
            if (email && email !== '-') {
                replyLink.href = 'mailto:' + email + '?subject=' + encodeURIComponent('RE: ' + (category + (subject ? ' - ' + subject : '')));
                replyLink.style.display = 'inline-flex';
            } else {
                replyLink.style.display = 'none';
            }

            openModal('feedbackDetailModal');
        }

        async function handleDeleteFeedbackClick(formId) {
            if (!confirm('Bu geri bildirim veya destek talebini kalıcı olarak silmek istediğinize emin misiniz?')) {
                return;
            }

            try {
                var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                var formData = new FormData();
                formData.append('formId', formId);
                formData.append('__RequestVerificationToken', token);

                var response = await fetch('/SuperAdmin/DeleteFeedback', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
                    body: formData
                });
                var result = await response.json();
                if (result.success) {
                    showAdminToast(result.message || 'Geri bildirim silindi.', 'success');
                    var row = document.getElementById('feedback-row-' + formId);
                    if (row) row.remove();
                } else {
                    showAdminToast('Hata: ' + (result.message || 'Silme işlemi başarısız.'), 'error');
                }
            } catch (err) {
                showAdminToast('Bağlantı hatası: ' + err.message, 'error');
            }
        }

        // ESC tuşu ile açık modalları kapat
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.modal-backdrop-wrap.is-open').forEach(function(m) {
                    m.classList.remove('is-open');
                });
            }
        });
    </script>
</body>
</html>
