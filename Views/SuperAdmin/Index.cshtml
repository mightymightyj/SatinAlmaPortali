@model satinalmaportali2.Models.SuperAdminDashboardViewModel
@{
    ViewData["Title"] = "Sistem Yönetim Paneli (Süper Admin)";
    Layout = null; // Bağımsız, sade ve modern kurumsal yönetim paneli
    var activeUser = User.Identity?.Name ?? "Yönetici";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tedarik Portalı</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-page: #F8FAFC;
            --bg-surface: #FFFFFF;
            --bg-muted: #F1F5F9;
            --border: #E2E8F0;
            --border-subtle: #EDF2F7;
            --text-heading: #0F172A;
            --text-body: #334155;
            --text-muted: #64748B;
            --text-subtle: #94A3B8;
            --primary: #2563EB;
            --primary-hover: #1D4ED8;
            --primary-light: #EFF6FF;
            --success: #16A34A;
            --success-light: #F0FDF4;
            --warning: #D97706;
            --warning-light: #FFFBEB;
            --danger: #DC2626;
            --danger-light: #FEF2F2;
            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 14px;
            --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
            --shadow-card: 0 1px 3px rgba(0, 0, 0, 0.06), 0 1px 2px rgba(0, 0, 0, 0.04);
            --shadow-modal: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--bg-page);
            color: var(--text-body);
            line-height: 1.5;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            -webkit-font-smoothing: antialiased;
        }

        /* HEADER */
        .admin-header {
            background: var(--bg-surface);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .header-container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 0 24px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .brand-wrap {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: var(--text-heading);
        }

        .brand-icon {
            width: 36px;
            height: 36px;
            border-radius: var(--radius-md);
            background: #0F172A;
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.95rem;
        }

        .brand-text {
            display: flex;
            flex-direction: column;
        }

        .brand-title {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text-heading);
            letter-spacing: -0.01em;
        }

        .brand-tag {
            font-size: 0.72rem;
            color: var(--text-muted);
            font-weight: 500;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .admin-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #EFF6FF;
            color: #1E40AF;
            border: 1px solid #DBEAFE;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .admin-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #2563EB;
        }

        .btn-link-site {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 12px;
            border-radius: var(--radius-sm);
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-body);
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 500;
            transition: background 0.15s ease, border-color 0.15s ease;
        }

        .btn-link-site:hover {
            background: var(--bg-muted);
            border-color: #CBD5E1;
        }

        /* MAIN WRAPPER */
        .main-container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 28px 24px 48px;
            width: 100%;
            flex: 1;
        }

        /* PAGE HEADER */
        .page-header {
            margin-bottom: 24px;
        }

        .page-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-heading);
            letter-spacing: -0.02em;
            margin-bottom: 4px;
        }

        .page-subtitle {
            font-size: 0.88rem;
            color: var(--text-muted);
        }

        /* ALERTS */
        .alert-box {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            border-radius: var(--radius-md);
            font-size: 0.88rem;
            font-weight: 500;
            margin-bottom: 20px;
        }

        .alert-success {
            background: var(--success-light);
            border: 1px solid #BBF7D0;
            color: #15803D;
        }

        .alert-error {
            background: var(--danger-light);
            border: 1px solid #FECACA;
            color: #991B1B;
        }

        .alert-close-btn {
            background: transparent;
            border: none;
            color: inherit;
            font-size: 1.1rem;
            cursor: pointer;
            padding: 0 4px;
            line-height: 1;
            opacity: 0.7;
        }

        .alert-close-btn:hover { opacity: 1; }

        /* TABS */
        .tabs-nav {
            display: flex;
            align-items: center;
            gap: 6px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 24px;
            overflow-x: auto;
        }

        .tab-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--text-muted);
            text-decoration: none;
            border-bottom: 2px solid transparent;
            margin-bottom: -1px;
            transition: color 0.15s ease, border-color 0.15s ease;
            white-space: nowrap;
        }

        .tab-btn:hover {
            color: var(--text-heading);
        }

        .tab-btn.is-active {
            color: var(--primary);
            border-bottom-color: var(--primary);
        }

        .tab-count {
            background: var(--bg-muted);
            color: var(--text-muted);
            padding: 2px 7px;
            border-radius: 12px;
            font-size: 0.72rem;
            font-weight: 600;
        }

        .tab-btn.is-active .tab-count {
            background: #DBEAFE;
            color: #1E40AF;
        }

        /* KPI CARDS */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .kpi-card {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 18px 20px;
            box-shadow: var(--shadow-card);
        }

        .kpi-label {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .kpi-value {
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--text-heading);
            letter-spacing: -0.02em;
            line-height: 1.2;
            margin-bottom: 6px;
        }

        .kpi-desc {
            font-size: 0.75rem;
            color: var(--text-subtle);
        }

        /* CONTENT CARDS & TOOLBARS */
        .content-card {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-card);
            overflow: hidden;
            margin-bottom: 24px;
        }

        .card-toolbar {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
            background: var(--bg-surface);
        }

        .toolbar-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-heading);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .toolbar-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        /* INPUTS & CONTROLS */
        .search-input-wrap {
            position: relative;
            display: inline-flex;
            align-items: center;
        }

        .search-input-wrap svg {
            position: absolute;
            left: 10px;
            color: var(--text-subtle);
            pointer-events: none;
        }

        .input-search {
            padding: 7px 12px 7px 32px;
            background: var(--bg-page);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: 0.84rem;
            color: var(--text-heading);
            outline: none;
            min-width: 220px;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .input-search:focus {
            border-color: var(--primary);
            background: #FFFFFF;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .select-filter {
            padding: 7px 12px;
            background: var(--bg-page);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: 0.84rem;
            color: var(--text-heading);
            outline: none;
            cursor: pointer;
        }

        .select-filter:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        /* BUTTONS */
        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--primary);
            color: #FFFFFF;
            border: 1px solid var(--primary);
            padding: 7px 14px;
            border-radius: var(--radius-sm);
            font-size: 0.84rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: background 0.15s ease;
        }

        .btn-primary:hover {
            background: var(--primary-hover);
        }

        .btn-secondary {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--bg-surface);
            color: var(--text-body);
            border: 1px solid var(--border);
            padding: 7px 14px;
            border-radius: var(--radius-sm);
            font-size: 0.84rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: background 0.15s ease;
        }

        .btn-secondary:hover {
            background: var(--bg-muted);
            color: var(--text-heading);
        }

        /* TABLES */
        .data-table-wrap {
            overflow-x: auto;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.86rem;
            text-align: left;
        }

        .data-table th {
            background: #F8FAFC;
            color: var(--text-muted);
            font-weight: 600;
            font-size: 0.74rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            padding: 11px 16px;
            border-bottom: 1px solid var(--border);
        }

        .data-table td {
            padding: 13px 16px;
            border-bottom: 1px solid var(--border-subtle);
            color: var(--text-body);
            vertical-align: middle;
        }

        .data-table tr:hover td {
            background: #F8FAFC;
        }

        .data-table tr:last-child td {
            border-bottom: none;
        }

        /* BADGES */
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 0.72rem;
            font-weight: 600;
        }

        .badge-supplier { background: #EFF6FF; color: #1E40AF; border: 1px solid #DBEAFE; }
        .badge-buyer { background: #F5F3FF; color: #6D28D9; border: 1px solid #EDE9FE; }
        .badge-both { background: #FFFBEB; color: #B45309; border: 1px solid #FEF3C7; }
        .badge-super { background: #FEF2F2; color: #991B1B; border: 1px solid #FEE2E2; }
        .badge-root { background: #F0FDF4; color: #166534; border: 1px solid #DCFCE7; }
        .badge-sub { background: #F1F5F9; color: #475569; border: 1px solid #E2E8F0; }

        /* ACTION BUTTONS */
        .actions-group {
            display: flex;
            align-items: center;
            gap: 6px;
            justify-content: flex-end;
        }

        .btn-table-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 5px 10px;
            border-radius: var(--radius-sm);
            font-size: 0.78rem;
            font-weight: 500;
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-body);
            cursor: pointer;
            transition: all 0.15s ease;
            text-decoration: none;
        }

        .btn-table-action:hover {
            background: var(--bg-muted);
            color: var(--text-heading);
            border-color: #CBD5E1;
        }

        .btn-table-action.danger:hover {
            background: var(--danger-light);
            color: var(--danger);
            border-color: #FECACA;
        }

        /* MODALS */
        .modal-backdrop-wrap {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(15, 23, 42, 0.45);
            backdrop-filter: blur(4px);
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.2s ease, visibility 0.2s ease;
        }

        .modal-backdrop-wrap.is-open {
            opacity: 1;
            visibility: visible;
        }

        .modal-panel {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            width: 100%;
            max-width: 580px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: var(--shadow-modal);
            transform: translateY(8px);
            transition: transform 0.2s ease;
        }

        .modal-backdrop-wrap.is-open .modal-panel {
            transform: translateY(0);
        }

        .modal-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .modal-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--text-heading);
        }

        .modal-close-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-size: 1.2rem;
            cursor: pointer;
            padding: 4px;
            line-height: 1;
        }

        .modal-close-btn:hover { color: var(--text-heading); }

        .modal-body {
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .modal-footer {
            padding: 14px 20px;
            border-top: 1px solid var(--border);
            background: var(--bg-page);
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
        }

        .form-field {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .form-field-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .form-label {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-heading);
        }

        .form-input, .form-select, .form-textarea {
            padding: 8px 12px;
            background: #FFFFFF;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: 0.86rem;
            color: var(--text-heading);
            outline: none;
            width: 100%;
            font-family: inherit;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .form-input:focus, .form-select:focus, .form-textarea:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .empty-state {
            padding: 40px 20px;
            text-align: center;
            color: var(--text-muted);
            font-size: 0.88rem;
        }
    </style>
</head>
<body>

    <!-- ÜST MENÜ BAR (HEADER) -->
    <header class="admin-header">
        <div class="header-container">
            <a class="brand-wrap" href="@Url.Action("Index", "SuperAdmin")">
                <div class="brand-icon">TP</div>
                <div class="brand-text">
                    <span class="brand-title">Tedarik Portalı</span>
                    <span class="brand-tag">Sistem Yönetim Paneli</span>
                </div>
            </a>

            <div class="header-actions">
                <span class="admin-badge">
                    <span class="admin-dot"></span>
                    Süper Admin
                </span>

                <span style="font-size: 0.84rem; color: var(--text-muted); font-weight: 500;">
                    @activeUser
                </span>

                <a asp-controller="Home" asp-action="Index" class="btn-link-site">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                    Siteye Dön
                </a>
            </div>
        </div>
    </header>

    <!-- ANA GÖVDE -->
    <main class="main-container">

        <!-- BAŞLIK & AÇIKLAMA -->
        <div class="page-header">
            <h1 class="page-title">Sistem Yönetimi</h1>
            <p class="page-subtitle">Platformdaki tüm kategorileri, firma hesaplarını ve sistem yapılandırmalarını bu ekrandan yönetebilirsiniz.</p>
        </div>

        <!-- BİLDİRİM VE UYARI MESAJLARI -->
        @if (TempData["AdminSuccess"] != null)
        {
            <div class="alert-box alert-success">
                <span>✓ @TempData["AdminSuccess"]</span>
                <button type="button" class="alert-close-btn" onclick="this.parentElement.remove()">✕</button>
            </div>
        }
        @if (TempData["AdminError"] != null)
        {
            <div class="alert-box alert-error">
                <span>⚠️ @TempData["AdminError"]</span>
                <button type="button" class="alert-close-btn" onclick="this.parentElement.remove()">✕</button>
            </div>
        }

        <!-- SEKME SEÇİCİ -->
        <nav class="tabs-nav" aria-label="Yönetim Sekmeleri">
            <a href="@Url.Action("Index", "SuperAdmin", new { tab = "overview" })" 
               class="tab-btn @(Model.ActiveTab == "overview" ? "is-active" : "")">
                Genel Bakış
            </a>

            <a href="@Url.Action("Index", "SuperAdmin", new { tab = "categories" })" 
               class="tab-btn @(Model.ActiveTab == "categories" ? "is-active" : "")">
                Kategoriler
                <span class="tab-count">@Model.Stats.TotalCategories</span>
            </a>

            <a href="@Url.Action("Index", "SuperAdmin", new { tab = "companies" })" 
               class="tab-btn @(Model.ActiveTab == "companies" ? "is-active" : "")">
                Firmalar & Hesaplar
                <span class="tab-count">@Model.Stats.TotalCompanies</span>
            </a>

            <a href="@Url.Action("Index", "SuperAdmin", new { tab = "settings" })" 
               class="tab-btn @(Model.ActiveTab == "settings" ? "is-active" : "")">
                Sistem Ayarları
            </a>
        </nav>

        <!-- ==================== SEKME 1: GENEL BAKIŞ ==================== -->
        @if (Model.ActiveTab == "overview")
        {
            <div class="kpi-grid">
                <div class="kpi-card">
                    <div class="kpi-label">Toplam Kayıtlı Firma</div>
                    <div class="kpi-value">@Model.Stats.TotalCompanies</div>
                    <div class="kpi-desc">
                        @Model.Stats.SupplierCount Tedarikçi · @Model.Stats.BuyerCount Alıcı · @Model.Stats.BothCount Her İkisi
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-label">Ürün Kategorileri</div>
                    <div class="kpi-value">@Model.Stats.TotalCategories</div>
                    <div class="kpi-desc">
                        @Model.Stats.RootCategoriesCount Ana Kategori · @Model.Stats.SubCategoriesCount Alt Kategori
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-label">Satın Alma Talepleri</div>
                    <div class="kpi-value">@Model.Stats.TotalRequests</div>
                    <div class="kpi-desc">
                        Tahmini Bütçe Hacmi: @Model.Stats.TotalEstimatedBudget.ToString("N0") ₺
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-label">İletilen Teklifler</div>
                    <div class="kpi-value">@Model.Stats.TotalOffers</div>
                    <div class="kpi-desc">
                        Toplam Teklif Değeri: @Model.Stats.TotalOfferedVolume.ToString("N0") ₺
                    </div>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 20px;">
                <div class="content-card" style="padding: 20px;">
                    <h3 style="font-size: 1rem; font-weight: 700; color: var(--text-heading); margin-bottom: 8px;">
                        Kategori Yönetimi
                    </h3>
                    <p style="font-size: 0.84rem; color: var(--text-muted); margin-bottom: 16px; line-height: 1.5;">
                        Platform genelinde alıcıların talep açarken ve tedarikçilerin teklif verirken kullandığı ana ve alt kategorileri yapılandırın.
                    </p>
                    <div style="display: flex; gap: 8px;">
                        <button type="button" class="btn-primary" onclick="openAddCategoryModal()">+ Yeni Kategori</button>
                        <a href="@Url.Action("Index", "SuperAdmin", new { tab = "categories" })" class="btn-secondary">Listeye Git</a>
                    </div>
                </div>

                <div class="content-card" style="padding: 20px;">
                    <h3 style="font-size: 1rem; font-weight: 700; color: var(--text-heading); margin-bottom: 8px;">
                        Firma & Hesap Yönetimi
                    </h3>
                    <p style="font-size: 0.84rem; color: var(--text-muted); margin-bottom: 16px; line-height: 1.5;">
                        Kayıtlı firmaların unvan, yetkili, e-posta, telefon ve rol türlerini (Alıcı, Tedarikçi, Her İkisi, Süper Admin) düzenleyin veya şifrelerini sıfırlayın.
                    </p>
                    <div>
                        <a href="@Url.Action("Index", "SuperAdmin", new { tab = "companies" })" class="btn-primary">Firmaları Yönet</a>
                    </div>
                </div>
            </div>
        }

        <!-- ==================== SEKME 2: KATEGORİLER ==================== -->
        @if (Model.ActiveTab == "categories")
        {
            <div class="content-card">
                <div class="card-toolbar">
                    <div class="toolbar-title">
                        Kategori Listesi
                        <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">(@Model.Categories.Count kayıt)</span>
                    </div>

                    <div class="toolbar-actions">
                        <div class="search-input-wrap">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            <input type="text" id="catSearchInput" class="input-search" placeholder="Kategori ara..." oninput="filterCategoriesTable()" />
                        </div>

                        <button type="button" class="btn-primary" onclick="openAddCategoryModal()">
                            + Yeni Kategori Ekle
                        </button>
                    </div>
                </div>

                <div class="data-table-wrap">
                    <table class="data-table" id="categoriesTable">
                        <thead>
                            <tr>
                                <th style="width: 70px;">ID</th>
                                <th>Kategori Adı</th>
                                <th>Tür</th>
                                <th>Üst Kategori</th>
                                <th>Alt Kategori</th>
                                <th>Bağlı Talep</th>
                                <th style="text-align: right; width: 140px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Categories.Any())
                            {
                                @foreach (var cat in Model.Categories)
                                {
                                    <tr class="cat-row" data-name="@cat.CategoryName.ToLowerInvariant()" data-parent="@((cat.ParentCategoryName ?? "").ToLowerInvariant())">
                                        <td style="color: var(--text-muted); font-weight: 500;">#@cat.CategoryID</td>
                                        <td>
                                            <strong style="color: var(--text-heading); font-weight: 600;">@cat.CategoryName</strong>
                                        </td>
                                        <td>
                                            @if (cat.IsRoot)
                                            {
                                                <span class="badge badge-root">Ana Kategori</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-sub">Alt Kategori</span>
                                            }
                                        </td>
                                        <td>
                                            @(cat.ParentCategoryName ?? "—")
                                        </td>
                                        <td>
                                            @(cat.SubCategoryCount > 0 ? $"{cat.SubCategoryCount} alt kategori" : "—")
                                        </td>
                                        <td>
                                            @(cat.LinkedRequestsCount > 0 ? $"{cat.LinkedRequestsCount} talep" : "—")
                                        </td>
                                        <td>
                                            <div class="actions-group">
                                                <button type="button" class="btn-table-action" onclick="openEditCategoryModal(@cat.CategoryID)">
                                                    Düzenle
                                                </button>
                                                <form asp-action="DeleteCategory" method="post" onsubmit="return confirm('\'@Html.Raw(cat.CategoryName)\' kategorisini silmek istediğinize emin misiniz?');" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="categoryId" value="@cat.CategoryID" />
                                                    <button type="submit" class="btn-table-action danger">
                                                        Sil
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="empty-state">Henüz kayıtlı bir kategori bulunmuyor.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ==================== SEKME 3: FİRMALAR & AYARLAR ==================== -->
        @if (Model.ActiveTab == "companies")
        {
            <div class="content-card">
                <div class="card-toolbar">
                    <div class="toolbar-title">
                        Firma Listesi
                        <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">(@Model.Companies.Count kayıt)</span>
                    </div>

                    <div class="toolbar-actions">
                        <div class="search-input-wrap">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            <input type="text" id="compSearchInput" class="input-search" placeholder="Firma adı, yetkili veya e-posta..." oninput="filterCompaniesTable()" />
                        </div>

                        <select id="compTypeFilter" class="select-filter" onchange="filterCompaniesTable()">
                            <option value="">Tüm Firma Türleri</option>
                            <option value="1">Tedarikçi Firma</option>
                            <option value="2">Alıcı / Müşteri</option>
                            <option value="3">Hem Alıcı Hem Tedarikçi</option>
                            <option value="4">Süper Admin</option>
                        </select>
                    </div>
                </div>

                <div class="data-table-wrap">
                    <table class="data-table" id="companiesTable">
                        <thead>
                            <tr>
                                <th style="width: 70px;">ID</th>
                                <th>Firma Adı & Yetkili</th>
                                <th>E-posta & Telefon</th>
                                <th>Vergi / TC</th>
                                <th>Firma Türü</th>
                                <th>Üyelik</th>
                                <th>Aktivite</th>
                                <th style="text-align: right; width: 170px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Companies.Any())
                            {
                                @foreach (var comp in Model.Companies)
                                {
                                    <tr class="comp-row" data-type="@(comp.CompanyTypeID ?? 0)" data-search="@comp.CompanyName.ToLowerInvariant() @comp.CompanyOfficial.ToLowerInvariant() @comp.CompanyMail.ToLowerInvariant() @(comp.TCNO ?? "")">
                                        <td style="color: var(--text-muted); font-weight: 500;">#@comp.CompanyID</td>
                                        <td>
                                            <div style="font-weight: 600; color: var(--text-heading);">@comp.CompanyName</div>
                                            <div style="font-size: 0.78rem; color: var(--text-muted);">@comp.CompanyOfficial</div>
                                        </td>
                                        <td>
                                            <div style="color: var(--text-heading);">@comp.CompanyMail</div>
                                            <div style="font-size: 0.78rem; color: var(--text-muted);">@(comp.CompanyPhone ?? "—")</div>
                                        </td>
                                        <td>
                                            <div style="font-family: monospace; font-size: 0.8rem; color: var(--text-heading);">@(comp.TCNO ?? "—")</div>
                                            <div style="font-size: 0.75rem; color: var(--text-muted);">@(comp.TaxOffice ?? "")</div>
                                        </td>
                                        <td>
                                            @if (comp.CompanyTypeID == 1)
                                            {
                                                <span class="badge badge-supplier">Tedarikçi</span>
                                            }
                                            else if (comp.CompanyTypeID == 2)
                                            {
                                                <span class="badge badge-buyer">Alıcı</span>
                                            }
                                            else if (comp.CompanyTypeID == 3)
                                            {
                                                <span class="badge badge-both">Alıcı & Tedarikçi</span>
                                            }
                                            else if (comp.CompanyTypeID == 4)
                                            {
                                                <span class="badge badge-super">Süper Admin</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-sub">@comp.CompanyTypeName</span>
                                            }
                                        </td>
                                        <td>
                                            <span style="font-size: 0.8rem; font-weight: 500;">@comp.MembershipTypeName</span>
                                        </td>
                                        <td>
                                            <span style="font-size: 0.78rem; color: var(--text-muted);">
                                                @comp.RequestCount Talep / @comp.OfferCount Teklif
                                            </span>
                                        </td>
                                        <td>
                                            <div class="actions-group">
                                                <button type="button" class="btn-table-action" onclick="openEditCompanyModal(@comp.CompanyID)" title="Firma Bilgilerini Düzenle">
                                                    Düzenle
                                                </button>
                                                <button type="button" class="btn-table-action" onclick="openResetPasswordModal(@comp.CompanyID, '@Html.Raw(comp.CompanyName)')" title="Şifre Sıfırla">
                                                    Şifre
                                                </button>
                                                <form asp-action="DeleteCompany" method="post" onsubmit="return confirm('\'@Html.Raw(comp.CompanyName)\' firmasını silmek istediğinize emin misiniz?');" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="companyId" value="@comp.CompanyID" />
                                                    <button type="submit" class="btn-table-action danger" title="Sil">
                                                        Sil
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="empty-state">Kayıtlı firma bulunamadı.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ==================== SEKME 4: SİSTEM AYARLARI ==================== -->
        @if (Model.ActiveTab == "settings")
        {
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 20px;">
                <div class="content-card" style="padding: 22px;">
                    <h3 style="font-size: 1rem; font-weight: 700; color: var(--text-heading); margin-bottom: 8px;">
                        Veritabanı Referans Tablolarını Eşitle
                    </h3>
                    <p style="font-size: 0.84rem; color: var(--text-muted); margin-bottom: 18px; line-height: 1.5;">
                        Firma türleri (Tedarikçi, Alıcı, Alıcı & Tedarikçi, Süper Admin), üyelik seviyeleri ve Türkiye 81 il/ilçe veritabanı tablolarını denetleyip eksik kayıtları otomatik oluşturur.
                    </p>
                    <form asp-action="SeedSystemDefaults" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-primary" onclick="return confirm('Varsayılan referans verileri senkronize edilsin mi?');">
                            Tabloları Senkronize Et
                        </button>
                    </form>
                </div>

                <div class="content-card" style="padding: 22px;">
                    <h3 style="font-size: 1rem; font-weight: 700; color: var(--text-heading); margin-bottom: 8px;">
                        Erişim ve Güvenlik
                    </h3>
                    <ul style="font-size: 0.84rem; color: var(--text-muted); line-height: 1.7; padding-left: 18px;">
                        <li>Bu sayfaya yalnızca <strong>Süper Admin (Firma Tipi = 4)</strong> yetkisine sahip hesaplar doğrudan <code>/SuperAdmin</code> veya <code>/Admin</code> URL'i üzerinden erişebilir.</li>
                        <li>Normal kullanıcı arayüzlerinde bu yönetim merkezine yönlendiren bir buton veya bağlantı yer almaz.</li>
                    </ul>
                </div>
            </div>
        }

    </main>

    <!-- ==================== MODAL: YENİ KATEGORİ EKLE ==================== -->
    <div id="addCategoryModal" class="modal-backdrop-wrap" aria-hidden="true">
        <div class="modal-panel">
            <div class="modal-header">
                <h3 class="modal-title">Yeni Kategori Ekle</h3>
                <button type="button" class="modal-close-btn" onclick="closeModal('addCategoryModal')">✕</button>
            </div>
            <form asp-action="CreateCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="form-field">
                        <label class="form-label" for="newCatName">Kategori Adı *</label>
                        <input type="text" id="newCatName" name="categoryName" class="form-input" placeholder="Örn: Elektrik & Otomasyon" required />
                    </div>

                    <div class="form-field">
                        <label class="form-label" for="newCatParent">Üst Kategori (İsteğe Bağlı)</label>
                        <select id="newCatParent" name="parentCategoryId" class="form-select">
                            <option value="">— Yok (Ana Kategori Olarak Ekle) —</option>
                            @foreach (var parent in Model.AvailableParentCategories)
                            {
                                <option value="@parent.CategoryID">@parent.CategoryName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="closeModal('addCategoryModal')">Vazgeç</button>
                    <button type="submit" class="btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ==================== MODAL: KATEGORİ DÜZENLE ==================== -->
    <div id="editCategoryModal" class="modal-backdrop-wrap" aria-hidden="true">
        <div class="modal-panel">
            <div class="modal-header">
                <h3 class="modal-title">Kategoriyi Düzenle</h3>
                <button type="button" class="modal-close-btn" onclick="closeModal('editCategoryModal')">✕</button>
            </div>
            <form asp-action="UpdateCategory" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editCatId" name="CategoryID" />
                <div class="modal-body">
                    <div class="form-field">
                        <label class="form-label" for="editCatName">Kategori Adı *</label>
                        <input type="text" id="editCatName" name="CategoryName" class="form-input" required />
                    </div>

                    <div class="form-field">
                        <label class="form-label" for="editCatParent">Üst Kategori</label>
                        <select id="editCatParent" name="ParentCategoryID" class="form-select">
                            <option value="">— Yok (Ana Kategori) —</option>
                            @foreach (var parent in Model.AvailableParentCategories)
                            {
                                <option value="@parent.CategoryID">@parent.CategoryName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="closeModal('editCategoryModal')">Vazgeç</button>
                    <button type="submit" class="btn-primary">Değişiklikleri Kaydet</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ==================== MODAL: FİRMA BİLGİLERİNİ DÜZENLE ==================== -->
    <div id="editCompanyModal" class="modal-backdrop-wrap" aria-hidden="true">
        <div class="modal-panel" style="max-width: 620px;">
            <div class="modal-header">
                <h3 class="modal-title">Firma Bilgilerini Düzenle</h3>
                <button type="button" class="modal-close-btn" onclick="closeModal('editCompanyModal')">✕</button>
            </div>
            <form asp-action="UpdateCompany" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editCompId" name="CompanyID" />
                <div class="modal-body">
                    <div class="form-field-grid">
                        <div class="form-field">
                            <label class="form-label" for="editCompName">Firma Adı / Unvanı *</label>
                            <input type="text" id="editCompName" name="CompanyName" class="form-input" required />
                        </div>
                        <div class="form-field">
                            <label class="form-label" for="editCompOfficial">Yetkili Kişi *</label>
                            <input type="text" id="editCompOfficial" name="CompanyOfficial" class="form-input" required />
                        </div>
                    </div>

                    <div class="form-field-grid">
                        <div class="form-field">
                            <label class="form-label" for="editCompMail">E-posta Adresi *</label>
                            <input type="email" id="editCompMail" name="CompanyMail" class="form-input" required />
                        </div>
                        <div class="form-field">
                            <label class="form-label" for="editCompPhone">Telefon</label>
                            <input type="text" id="editCompPhone" name="CompanyPhone" class="form-input" placeholder="05XXXXXXXXX" />
                        </div>
                    </div>

                    <div class="form-field-grid">
                        <div class="form-field">
                            <label class="form-label" for="editCompType">Firma Türü (Rol) *</label>
                            <select id="editCompType" name="CompanyTypeID" class="form-select">
                                @foreach (var ct in Model.AvailableCompanyTypes)
                                {
                                    <option value="@ct.CompanyTypeID">@ct.CompanyTypeName</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label" for="editCompMember">Üyelik Seviyesi *</label>
                            <select id="editCompMember" name="MembershipTypeID" class="form-select">
                                @foreach (var mt in Model.AvailableMembershipTypes)
                                {
                                    <option value="@mt.MembershipTypeID">@mt.MembershipTypeName</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-field-grid">
                        <div class="form-field">
                            <label class="form-label" for="editCompTc">T.C. / Vergi Kimlik No</label>
                            <input type="text" id="editCompTc" name="TCNO" class="form-input" />
                        </div>
                        <div class="form-field">
                            <label class="form-label" for="editCompTax">Vergi Dairesi</label>
                            <input type="text" id="editCompTax" name="TaxOffice" class="form-input" />
                        </div>
                    </div>

                    <div class="form-field">
                        <label class="form-label" for="editCompAddress">Adres</label>
                        <input type="text" id="editCompAddress" name="AddressText" class="form-input" placeholder="Açık adres bilgisi..." />
                    </div>

                    <div class="form-field">
                        <label class="form-label" for="editCompDetail">Firma Açıklama / Faaliyet Alanı</label>
                        <textarea id="editCompDetail" name="CompanyDetailText" class="form-textarea" rows="2" placeholder="Firma hakkında kısa not..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="closeModal('editCompanyModal')">Vazgeç</button>
                    <button type="submit" class="btn-primary">Güncelle</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ==================== MODAL: ŞİFRE SIFIRLA ==================== -->
    <div id="resetPasswordModal" class="modal-backdrop-wrap" aria-hidden="true">
        <div class="modal-panel" style="max-width: 440px;">
            <div class="modal-header">
                <h3 class="modal-title">Şifre Sıfırla</h3>
                <button type="button" class="modal-close-btn" onclick="closeModal('resetPasswordModal')">✕</button>
            </div>
            <form asp-action="ResetCompanyPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="resetCompId" name="CompanyID" />
                <div class="modal-body">
                    <p id="resetCompNameDisplay" style="font-size: 0.88rem; color: var(--text-heading); font-weight: 600;"></p>
                    <div class="form-field">
                        <label class="form-label" for="newPasswordInput">Yeni Şifre (En az 6 karakter) *</label>
                        <input type="password" id="newPasswordInput" name="NewPassword" class="form-input" placeholder="Yeni şifre giriniz..." required minlength="6" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="closeModal('resetPasswordModal')">Vazgeç</button>
                    <button type="submit" class="btn-primary">Şifreyi Kaydet</button>
                </div>
            </form>
        </div>
    </div>

    <!-- CLIENT JAVASCRIPT -->
    <script>
        function openModal(id) {
            var modal = document.getElementById(id);
            if (modal) {
                modal.classList.add('is-open');
                modal.setAttribute('aria-hidden', 'false');
            }
        }

        function closeModal(id) {
            var modal = document.getElementById(id);
            if (modal) {
                modal.classList.remove('is-open');
                modal.setAttribute('aria-hidden', 'true');
            }
        }

        function openAddCategoryModal() {
            document.getElementById('newCatName').value = '';
            document.getElementById('newCatParent').value = '';
            openModal('addCategoryModal');
        }

        async function openEditCategoryModal(catId) {
            try {
                var response = await fetch('/SuperAdmin/GetCategory/' + catId);
                var data = await response.json();
                if (data.success) {
                    document.getElementById('editCatId').value = data.categoryId;
                    document.getElementById('editCatName').value = data.categoryName;
                    document.getElementById('editCatParent').value = data.parentCategoryId || '';
                    openModal('editCategoryModal');
                } else {
                    alert('Kategori bilgisi alınamadı.');
                }
            } catch (err) {
                alert('Bağlantı hatası: ' + err.message);
            }
        }

        async function openEditCompanyModal(compId) {
            try {
                var response = await fetch('/SuperAdmin/GetCompany/' + compId);
                var data = await response.json();
                if (data.success) {
                    document.getElementById('editCompId').value = data.companyId;
                    document.getElementById('editCompName').value = data.companyName || '';
                    document.getElementById('editCompOfficial').value = data.companyOfficial || '';
                    document.getElementById('editCompMail').value = data.companyMail || '';
                    document.getElementById('editCompPhone').value = data.companyPhone || '';
                    document.getElementById('editCompType').value = data.companyTypeId || '1';
                    document.getElementById('editCompMember').value = data.membershipTypeId || '1';
                    document.getElementById('editCompTc').value = data.tcno || '';
                    document.getElementById('editCompTax').value = data.taxOffice || '';
                    document.getElementById('editCompAddress').value = data.addressText || '';
                    document.getElementById('editCompDetail').value = data.companyDetailText || '';
                    openModal('editCompanyModal');
                } else {
                    alert('Firma bilgisi alınamadı.');
                }
            } catch (err) {
                alert('Bağlantı hatası: ' + err.message);
            }
        }

        function openResetPasswordModal(compId, compName) {
            document.getElementById('resetCompId').value = compId;
            document.getElementById('resetCompNameDisplay').textContent = compName + ' firması için yeni şifre belirleyin:';
            document.getElementById('newPasswordInput').value = '';
            openModal('resetPasswordModal');
        }

        // Anlık Kategori Arama Filtresi
        function filterCategoriesTable() {
            var input = document.getElementById('catSearchInput');
            if (!input) return;
            var query = input.value.trim().toLowerCase();
            var rows = document.querySelectorAll('#categoriesTable .cat-row');
            rows.forEach(function(row) {
                var name = row.getAttribute('data-name') || '';
                var parent = row.getAttribute('data-parent') || '';
                if (name.indexOf(query) > -1 || parent.indexOf(query) > -1) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        // Anlık Firma Arama & Tür Filtresi
        function filterCompaniesTable() {
            var searchInput = document.getElementById('compSearchInput');
            var typeFilter = document.getElementById('compTypeFilter');
            var query = searchInput ? searchInput.value.trim().toLowerCase() : '';
            var typeVal = typeFilter ? typeFilter.value : '';

            var rows = document.querySelectorAll('#companiesTable .comp-row');
            rows.forEach(function(row) {
                var rowSearch = row.getAttribute('data-search') || '';
                var rowType = row.getAttribute('data-type') || '';

                var matchQuery = !query || rowSearch.indexOf(query) > -1;
                var matchType = !typeVal || rowType === typeVal;

                if (matchQuery && matchType) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        // ESC tuşu ile açık modalları kapat
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.modal-backdrop-wrap.is-open').forEach(function(m) {
                    m.classList.remove('is-open');
                });
            }
        });
    </script>
</body>
</html>
