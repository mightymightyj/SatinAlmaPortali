    <!-- CLIENT JAVASCRIPT -->
    <script>
        function openModal(id) {
            var modal = document.getElementById(id);
            if (modal) {
                modal.classList.add('is-open');
                modal.setAttribute('aria-hidden', 'false');
            }
        }

        function closeModal(id) {
            var modal = document.getElementById(id);
            if (modal) {
                modal.classList.remove('is-open');
                modal.setAttribute('aria-hidden', 'true');
            }
        }

        function openAddCategoryModal(parentCatId) {
            document.getElementById('newCatName').value = '';
            document.getElementById('newCatParent').value = parentCatId || '';
            openModal('addCategoryModal');
        }

        async function openEditCategoryModal(catId) {
            try {
                var response = await fetch('/SuperAdmin/GetCategory/' + catId);
                var data = await response.json();
                if (data.success) {
                    document.getElementById('editCatId').value = data.categoryId;
                    document.getElementById('editCatName').value = data.categoryName;
                    document.getElementById('editCatParent').value = data.parentCategoryId || '';
                    openModal('editCategoryModal');
                } else {
                    alert('Kategori bilgisi alınamadı.');
                }
            } catch (err) {
                alert('Bağlantı hatası: ' + err.message);
            }
        }

        async function openEditCompanyModal(compId) {
            try {
                var response = await fetch('/SuperAdmin/GetCompany/' + compId);
                var data = await response.json();
                if (data.success) {
                    document.getElementById('editCompId').value = data.companyId;
                    document.getElementById('editCompName').value = data.companyName || '';
                    document.getElementById('editCompOfficial').value = data.companyOfficial || '';
                    document.getElementById('editCompMail').value = data.companyMail || '';
                    document.getElementById('editCompPhone').value = data.companyPhone || '';
                    document.getElementById('editCompType').value = (data.companyTypeId === 4) ? '4' : '3';
                    document.getElementById('editCompMember').value = data.membershipTypeId || '1';
                    document.getElementById('editCompTc').value = data.tcno || '';
                    document.getElementById('editCompTax').value = data.taxOffice || '';
                    document.getElementById('editCompAddress').value = data.addressText || '';
                    document.getElementById('editCompDetail').value = data.companyDetailText || '';
                    openModal('editCompanyModal');
                } else {
                    alert('Firma bilgisi alınamadı.');
                }
            } catch (err) {
                alert('Bağlantı hatası: ' + err.message);
            }
        }

        function openResetPasswordModal(compId, compName) {
            document.getElementById('resetCompId').value = compId;
            document.getElementById('resetCompNameDisplay').textContent = compName + ' firması için yeni şifre belirleyin:';
            document.getElementById('newPasswordInput').value = '';
            openModal('resetPasswordModal');
        }

        // Kategori Dalı Aç / Kapat
        function toggleCategoryBranch(btn, targetId) {
            var target = document.getElementById(targetId);
            if (!target) return;
            if (target.classList.contains('is-hidden')) {
                target.classList.remove('is-hidden');
                btn.classList.remove('is-collapsed');
            } else {
                target.classList.add('is-hidden');
                btn.classList.add('is-collapsed');
            }
        }

        // Tüm Kategori Ağacını Aç
        function expandAllCategories() {
            document.querySelectorAll('.cat-children-wrap').forEach(function(el) {
                el.classList.remove('is-hidden');
            });
            document.querySelectorAll('.cat-toggle-btn').forEach(function(btn) {
                btn.classList.remove('is-collapsed');
            });
        }

        // Tüm Kategori Ağacını Kapat
        function collapseAllCategories() {
            document.querySelectorAll('.cat-children-wrap').forEach(function(el) {
                el.classList.add('is-hidden');
            });
            document.querySelectorAll('.cat-toggle-btn').forEach(function(btn) {
                btn.classList.add('is-collapsed');
            });
        }

        // Anlık Kategori Ağacı Arama Filtresi
        function filterCategoriesTree() {
            var input = document.getElementById('catSearchInput');
            if (!input) return;
            var query = input.value.trim().toLowerCase();
            var nodes = document.querySelectorAll('#categoryTreeList .cat-tree-node');

            if (!query) {
                nodes.forEach(function(n) {
                    n.style.display = '';
                });
                return;
            }

            // Arama yapıldığında tüm alt dalları aç
            expandAllCategories();

            nodes.forEach(function(node) {
                var catName = node.getAttribute('data-cat-name') || '';
                var matchesSelf = catName.indexOf(query) > -1;
                var hasMatchingDescendant = false;

                node.querySelectorAll('.cat-tree-node').forEach(function(child) {
                    var childName = child.getAttribute('data-cat-name') || '';
                    if (childName.indexOf(query) > -1) {
                        hasMatchingDescendant = true;
                    }
                });

                if (matchesSelf || hasMatchingDescendant) {
                    node.style.display = '';
                } else {
                    node.style.display = 'none';
                }
            });
        }

        // Anlık Firma Arama & Tür Filtresi
        function filterCompaniesTable() {
            var searchInput = document.getElementById('compSearchInput');
            var typeFilter = document.getElementById('compTypeFilter');
            var query = searchInput ? searchInput.value.trim().toLowerCase() : '';
            var typeVal = typeFilter ? typeFilter.value : '';

            var rows = document.querySelectorAll('#companiesTable .comp-row');
            rows.forEach(function(row) {
                var rowSearch = row.getAttribute('data-search') || '';
                var rowType = row.getAttribute('data-type') || '';

                var matchQuery = !query || rowSearch.indexOf(query) > -1;
                var matchType = true;
                if (typeVal === '4') {
                    matchType = (rowType === '4');
                } else if (typeVal === 'corporate') {
                    matchType = (rowType !== '4');
                }

                if (matchQuery && matchType) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
