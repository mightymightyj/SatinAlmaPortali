        // Genel Sipariş Durumu Güncelle AJAX
        async function handleUpdateOrderStatusSubmit(event) {
            if (event) { event.preventDefault(); event.stopPropagation(); }
            const form = event.target;
            const submitBtn = form.querySelector('button[type="submit"]');
            const origText = submitBtn ? submitBtn.innerHTML : 'Kaydet';
            if (submitBtn) { submitBtn.disabled = true; submitBtn.innerHTML = 'Kaydediliyor...'; }

            try {
                const orderId = document.getElementById('admOrdId').value;
                const orderStatus = document.getElementById('admOrdStatusSelect').value;
