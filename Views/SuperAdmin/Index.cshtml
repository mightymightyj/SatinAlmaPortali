                    showAdminToast('✓ ' + (result.message || 'Sistem verileri eşitlendi!'), 'success');
                } else {
                    showAdminToast('Hata: ' + (result.message || 'Senkronizasyon hatası.'), 'error');
                }
            } catch (err) {
                showAdminToast('Bağlantı hatası: ' + err.message, 'error');
            } finally {
                if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = origText; }
            }
        }

        // 12. Değerlendirme Türü Değiştiğinde Placeholder & Alan Ayarlama
        function handleReviewTypeChange(select) {
            const reviewerNameInput = document.getElementById('simRevReviewerName');
            const commentInput = document.getElementById('simRevText');
            if (select.value === 'BuyerToSeller') {
                if (reviewerNameInput) reviewerNameInput.placeholder = 'Örn: Atlas Endüstri A.Ş. (Doğrulanmış Alıcı)';
                if (commentInput) commentInput.placeholder = 'Örn: Siparişimiz tam zamanında teslim edildi. Ürün malzeme kalitesi ve teknik desteği kusursuz...';
            } else {
                if (reviewerNameInput) reviewerNameInput.placeholder = 'Örn: Mega Lojistik ve Ticaret A.Ş. (Onaylı Tedarikçi)';
                if (commentInput) commentInput.placeholder = 'Örn: Ödeme vadesinde eksiksiz yapıldı, mal kabul süreci son derece hızlı ve profesyoneldi...';
            }
        }

        function handleReviewerCompChange(select) {
            const selectedOpt = select.options[select.selectedIndex];
            const nameInput = document.getElementById('simRevReviewerName');
            if (nameInput && selectedOpt && selectedOpt.getAttribute('data-name')) {
                const compName = selectedOpt.getAttribute('data-name');
                const isBuyer = document.getElementById('simRevType')?.value === 'BuyerToSeller';
                nameInput.value = `${compName} (${isBuyer ? 'Doğrulanmış Alıcı' : 'Onaylı Tedarikçi'})`;
            }
        }

        // 13. Test Değerlendirmesi Ekle AJAX
        async function handleSimulateReviewSubmit(event) {
            if (event) { event.preventDefault(); event.stopPropagation(); }
            const form = event.target;
            const submitBtn = form.querySelector('button[type="submit"]');
