                                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
                                    <div>
                                        <strong style="color: #166534; font-size: 0.92rem;">📋 Talep Kalemleri & Teklif Birim Fiyatları</strong>
                                        <span id="simOfferItemsCountBadge" style="font-size: 0.75rem; color: #15803D; font-weight: 700; background: #DCFCE7; padding: 2px 8px; border-radius: 6px; margin-left: 6px;">0 Kalem</span>
                                    </div>
                                    <div style="display: flex; gap: 6px;">
                                        <button type="button" class="btn-quick-tpl" onclick="fillSimOfferPrices(0)" style="background: #FFFFFF; border: 1px solid #86EFAC; color: #166534; font-size: 0.75rem; padding: 4px 8px; border-radius: 6px; cursor: pointer; font-weight: 600;" title="Hedef Bütçe Birim Fiyatını Uygula">⚡ Hedef Fiyat</button>
                                        <button type="button" class="btn-quick-tpl" onclick="fillSimOfferPrices(5)" style="background: #FFFFFF; border: 1px solid #86EFAC; color: #166534; font-size: 0.75rem; padding: 4px 8px; border-radius: 6px; cursor: pointer; font-weight: 600;" title="Hedef Bütçeden %5 İndirimli">%5 İndirimli</button>
                                        <button type="button" class="btn-quick-tpl" onclick="fillSimOfferPrices(10)" style="background: #FFFFFF; border: 1px solid #86EFAC; color: #166534; font-size: 0.75rem; padding: 4px 8px; border-radius: 6px; cursor: pointer; font-weight: 600;" title="Hedef Bütçeden %10 İndirimli">%10 İndirimli</button>
                                    </div>
                                </div>

                                <div style="overflow-x: auto;">
                                    <table style="width: 100%; border-collapse: collapse; font-size: 0.83rem;" id="simOfferItemsTable">
                                        <thead>
                                            <tr style="background: #DCFCE7; color: #166534; border-bottom: 1.5px solid #86EFAC;">
                                                <th style="padding: 8px 10px; text-align: center; width: 35px;">#</th>
                                                <th style="padding: 8px 10px; text-align: left;">Talep Kalemi</th>
                                                <th style="padding: 8px 10px; text-align: center; width: 100px;">Miktar</th>
                                                <th style="padding: 8px 10px; text-align: right; width: 110px;">Hedef B. Fiyat</th>
                                                <th style="padding: 8px 10px; text-align: right; width: 140px;">Teklif B. Fiyat (₺) *</th>
                                                <th style="padding: 8px 10px; text-align: right; width: 130px;">Kalem Tutarı</th>
                                                <th style="padding: 8px 10px; text-align: left; width: 180px;">Tedarikçi Kalem Notu</th>
                                            </tr>
                                        </thead>
                                        <tbody id="simOfferItemsTbody">
                                            <!-- AJAX ile doldurulur -->
                                        </tbody>
                                        <tfoot>
                                            <tr style="background: #F0FDF4; border-top: 1.5px solid #86EFAC; font-weight: 700; color: #166534;">
                                                <td colspan="5" style="padding: 8px 10px; text-align: right;">HESAPLANAN GENEL TEKLİF TOPLAMI:</td>
                                                <td style="padding: 8px 10px; text-align: right; font-size: 0.95rem; color: #15803D;" id="simOfferCalculatedTotal">0,00 ₺</td>
                                                <td></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>

                            <div class="form-field-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
                                <div class="form-field">
                                    <label class="form-label" for="simOfferPrice">Toplam Teklif Tutarı (₺) *</label>
                                    <input type="number" step="0.01" id="simOfferPrice" name="OfferedPrice" class="form-input" placeholder="Örn: 18500.00" required />
                                </div>
                                <div class="form-field">
                                    <label class="form-label" for="simDeliveryDays">Teslim Süresi (İş Günü)</label>
                                    <input type="number" id="simDeliveryDays" name="DeliveryDays" class="form-input" min="1" value="7" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label" for="simValidityDays">Teklif Geçerlilik Süresi (Gün)</label>
                                    <input type="number" id="simValidityDays" name="ValidityDays" class="form-input" min="1" value="30" />
                                </div>
                            </div>

                            <div class="form-field">
                                <label class="form-label" for="simSupplierNotes">Açıklama / Tedarikçi Teklif Notları</label>
                                <textarea id="simSupplierNotes" name="SupplierNotes" class="form-textarea" rows="2" placeholder="Nakliye dahil / Stoktan hemen teslim ve ödeme koşulları..."></textarea>
                            </div>

                            <div style="margin-top: 4px;">
                                <button type="submit" class="btn-primary" style="width: 100%; justify-content: center; padding: 11px; background: #16A34A; border-color: #16A34A; font-size: 0.95rem;">
                                    💼 Seçilen Firma Adına Teklif Gönder
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

            </div>

            <!-- 1. CANLI VİTRİN & KATALOG SATIŞ İLANLARI TABLOSU -->
            <div class="content-card" style="margin-bottom: 24px;">
                <div class="card-toolbar">
                    <div class="toolbar-title">
                        🛒 Canlı Vitrin & Satış İlanları Listesi
                        <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">(@Model.RecentListings.Count ürün ilanı)</span>
                    </div>
                    <div class="toolbar-actions">
                        <a href="/#ihtiyaciniz-olan-urunler" target="_blank" class="btn-secondary" style="font-size: 0.8rem; text-decoration: none;">
                            ↗ Vitrini Yeni Sekmede Aç
                        </a>
                    </div>
                </div>

                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width: 80px;">Ürün No</th>
                                <th>Ürün Adı</th>
                                <th>Satıcı Firma / Marka</th>
                                <th>Kategori</th>
                                <th style="text-align: right;">Birim Fiyat</th>
                                <th style="text-align: right;">Stok</th>
                                <th style="text-align: center;">Durum</th>
                                <th style="text-align: right; width: 150px;">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentListings.Any())
                            {
                                @foreach (var item in Model.RecentListings)
                                {
                                    <tr id="listing-row-@item.ItemID">
                                        <td><strong style="color: var(--primary);">#ITEM-@item.ItemID</strong></td>
                                        <td>
                                            <div style="display: flex; align-items: center; gap: 8px;">
                                                @if (!string.IsNullOrWhiteSpace(item.ItemImage))
                                                {
                                                    <img src="@item.ItemImage" alt="@item.ItemName" style="width: 32px; height: 32px; border-radius: 6px; object-fit: cover; border: 1px solid #E2E8F0;" />
                                                }
                                                else
                                                {
                                                    <div style="width: 32px; height: 32px; border-radius: 6px; background: #F1F5F9; display: flex; align-items: center; justify-content: center; font-size: 0.85rem;">📦</div>
                                                }
                                                <strong style="color: var(--text-heading);">@item.ItemName</strong>
                                            </div>
                                        </td>
                                        <td><span class="badge badge-both">@item.Brand</span></td>
                                        <td>@item.CategoryName</td>
                                        <td style="text-align: right; font-weight: 700; color: var(--text-heading);">@item.UnitPrice.ToString("N0") ₺</td>
                                        <td style="text-align: right;">@item.Quantity Adet</td>
                                        <td style="text-align: center;">
                                            <span class="badge badge-root">Yayında</span>
                                        </td>
                                        <td style="text-align: right;">
                                            <div style="display: flex; gap: 6px; justify-content: flex-end;">
                                                <a href="/#ihtiyaciniz-olan-urunler" target="_blank" class="btn-table-action" title="Ana sayfada ürünü görüntüle">
                                                    Vitrin ↗
                                                </a>
                                                <button type="button" class="btn-table-action" style="color: #DC2626; border-color: #FCA5A5;" title="İlanı Sil" onclick="handleDeleteListing(@item.ItemID, '@Html.Raw(item.ItemName.Replace("'", "\\'"))', event)">
                                                    Sil
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="empty-state">Henüz eklenmiş bir ürün ilanı bulunmuyor. Yukarıdaki formdan ilk satış ilanını oluşturabilirsiniz.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 2. MEVCUT AÇIK TALEPLER TABLOSU (HIZLI SEÇİM) -->
            <div class="content-card">
                <div class="card-toolbar">
                    <div class="toolbar-title">
                        📋 Mevcut Satın Alma Talepleri ve Teklif Durumu
                        <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">(@Model.OpenRequests.Count talep)</span>
                    </div>
                </div>

                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width: 80px;">Talep No</th>
                                <th>Ürün / Hizmet Adı</th>
                                <th>Talep Sahibi (Alıcı)</th>
                                <th>Miktar</th>
                                <th>Tahmini Bütçe</th>
                                <th>Teklif Sayısı</th>
                                <th>Durum</th>
                                <th style="text-align: right; width: 140px;">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.OpenRequests.Any())
                            {
                                @foreach (var r in Model.OpenRequests)
                                {
                                    <tr>
                                        <td><strong style="color: var(--primary);">#REQ-@r.RequestID</strong></td>
                                        <td><strong style="color: var(--text-heading);">@r.ProductName</strong></td>
                                        <td>@r.BuyerInfo</td>
                                        <td>@r.Quantity Adet</td>
                                        <td>@(r.EstimatedBudget.HasValue ? $"{r.EstimatedBudget.Value:N0} ₺" : "—")</td>
                                        <td>
                                            <span class="badge @(r.OfferCount > 0 ? "badge-supplier" : "badge-sub")">
                                                @r.OfferCount Teklif
                                            </span>
                                        </td>
                                        <td>
                                            @if (r.Status == "Onaylandı" || r.Status == "Kabul Edildi")
                                            {
                                                <span class="badge badge-root">@r.Status</span>
                                            }
                                            else if (r.Status == "Reddedildi")
                                            {
                                                <span class="badge badge-super">@r.Status</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-both">@r.Status</span>
                                            }
                                        </td>
                                        <td style="text-align: right;">
                                            <button type="button" class="btn-table-action" onclick="selectRequestForOffer(@r.RequestID)" title="Bu talebe simülasyon formuyla teklif ver">
                                                Teklif Seç
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="empty-state">Henüz açık bir talep bulunmuyor. Yukarıdaki formdan ilk talebi oluşturabilirsiniz.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ==================== SEKME: 10★ DEĞERLENDİRMELER & İTİBAR TESTİ ==================== -->
        @if (Model.ActiveTab == "reviews")
        {
