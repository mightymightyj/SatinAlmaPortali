                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #16A34A;"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                            <span>Firma Adına Teklif Gönder</span>
                        </h3>
                        <span class="badge badge-supplier" style="background: #ECFDF5; color: #16A34A; border: 1px solid #A7F3D0;">Kalem Bazlı Teklif Simülatörü</span>
                    </div>

                    <form asp-action="SimulateCreateOffer" method="post" id="simOfferForm" onsubmit="handleSimOfferSubmit(event); return false;">
                        @Html.AntiForgeryToken()
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            
                            <div class="form-field-grid" style="grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));">
