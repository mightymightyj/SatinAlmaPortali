                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="form-field">
                                    <label class="form-label" for="simRevScore">Genel Puan: <strong id="simRevScoreDisplay" style="color: #D97706; font-size: 1rem;">★ 10.0 / 10</strong></label>
                                    <input type="range" id="simRevScore" name="ReviewScore" min="1.0" max="10.0" step="0.5" value="10.0" class="form-input" style="padding: 4px;" oninput="document.getElementById('simRevScoreDisplay').textContent = '★ ' + parseFloat(this.value).toFixed(1) + ' / 10'" />
                                </div>
                            </div>

                            <div class="form-field-grid" style="grid-template-columns: 1fr 1fr 1fr;">
                                <div class="form-field">
                                    <label class="form-label" for="simRevDelivery">Teslimat / Dakiklik (1-10)</label>
                                    <input type="number" id="simRevDelivery" name="DeliveryScore" min="1" max="10" step="0.5" value="10.0" class="form-input" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label" for="simRevQuality">Kalite / Güvenilirlik (1-10)</label>
