        // Satış ilanı için görsel yükleme ve Base64'e dönüştürme
        function handleListingImageUpload(input) {
            if (!input.files || !input.files[0]) return;
            var file = input.files[0];
            var reader = new FileReader();
            reader.onload = function(e) {
                var base64 = e.target.result;
                document.getElementById('simListingImageBase64').value = base64;
                var previewBox = document.getElementById('simImgPreviewBox');
                var previewImg = document.getElementById('simImgPreview');
                if (previewBox && previewImg) {
                    previewImg.src = base64;
                    previewBox.style.display = 'block';
                }
            };
            reader.readAsDataURL(file);
        }

