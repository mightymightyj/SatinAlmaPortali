@model satinalmaportali2.Models.SuperAdminDashboardViewModel
@{
    ViewData["Title"] = "Sistem Yönetim Paneli (Süper Admin)";
    Layout = null; // Bağımsız, sade ve modern kurumsal yönetim paneli
    var activeUser = User.Identity?.Name ?? "Yönetici";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tedarik Portalı</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        :root {
            --bg-page: #F8FAFC;
            --bg-surface: #FFFFFF;
            --bg-muted: #F1F5F9;
            --border: #E2E8F0;
            --border-subtle: #EDF2F7;
            --text-heading: #0F172A;
            --text-body: #334155;
            --text-muted: #64748B;
            --text-subtle: #94A3B8;
            --primary: #2563EB;
            --primary-hover: #1D4ED8;
            --primary-light: #EFF6FF;
            --success: #16A34A;
            --success-light: #F0FDF4;
            --warning: #D97706;
            --warning-light: #FFFBEB;
            --danger: #DC2626;
            --danger-light: #FEF2F2;
            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 14px;
            --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
            --shadow-card: 0 1px 3px rgba(0, 0, 0, 0.06), 0 1px 2px rgba(0, 0, 0, 0.04);
            --shadow-modal: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--bg-page);
            color: var(--text-body);
            line-height: 1.5;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            -webkit-font-smoothing: antialiased;
        }

        /* HEADER */
        .admin-header {
            background: var(--bg-surface);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .header-container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 0 24px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .brand-wrap {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: var(--text-heading);
        }

        .brand-icon {
            width: 36px;
            height: 36px;
            border-radius: var(--radius-md);
            background: #0F172A;
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.95rem;
        }

        .brand-text {
            display: flex;
            flex-direction: column;
        }

        .brand-title {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text-heading);
            letter-spacing: -0.01em;
        }

        .brand-tag {
            font-size: 0.72rem;
            color: var(--text-muted);
            font-weight: 500;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .admin-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #EFF6FF;
            color: #1E40AF;
            border: 1px solid #DBEAFE;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .admin-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #2563EB;
        }

        .btn-link-site {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 12px;
            border-radius: var(--radius-sm);
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-body);
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 500;
            transition: background 0.15s ease, border-color 0.15s ease;
        }

        .btn-link-site:hover {
            background: var(--bg-muted);
            border-color: #CBD5E1;
        }

        /* MAIN WRAPPER */
        .main-container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 28px 24px 48px;
            width: 100%;
            flex: 1;
        }

        /* PAGE HEADER */
        .page-header {
            margin-bottom: 24px;
        }

        .page-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-heading);
            letter-spacing: -0.02em;
            margin-bottom: 4px;
        }

        .page-subtitle {
            font-size: 0.88rem;
            color: var(--text-muted);
        }

        /* ALERTS */
        .alert-box {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            border-radius: var(--radius-md);
            font-size: 0.88rem;
            font-weight: 500;
            margin-bottom: 20px;
        }

        .alert-success {
            background: var(--success-light);
            border: 1px solid #BBF7D0;
            color: #15803D;
        }

        .alert-error {
            background: var(--danger-light);
            border: 1px solid #FECACA;
            color: #991B1B;
        }

        .alert-close-btn {
            background: transparent;
            border: none;
            color: inherit;
            font-size: 1.1rem;
            cursor: pointer;
            padding: 0 4px;
            line-height: 1;
            opacity: 0.7;
        }

        .alert-close-btn:hover { opacity: 1; }

        /* TABS */
        .tabs-nav {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 4px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 24px;
            padding-bottom: 4px;
        }

        .tab-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 13px;
            font-size: 0.83rem;
            font-weight: 600;
            color: var(--text-muted);
            text-decoration: none;
            border-bottom: 2px solid transparent;
            border-radius: 6px 6px 0 0;
            margin-bottom: -1px;
            transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
            white-space: nowrap;
        }

        .tab-btn:hover {
            color: var(--text-heading);
            background: #F1F5F9;
        }

        .tab-btn.is-active {
            color: var(--primary);
            border-bottom-color: var(--primary);
            background: #EFF6FF;
        }

        .tab-count {
            background: var(--bg-muted);
            color: var(--text-muted);
            padding: 2px 7px;
            border-radius: 12px;
            font-size: 0.72rem;
            font-weight: 600;
        }

        .tab-btn.is-active .tab-count {
            background: #DBEAFE;
            color: #1E40AF;
        }

        /* KPI CARDS */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .kpi-card {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 18px 20px;
            box-shadow: var(--shadow-card);
        }

        .kpi-label {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .kpi-value {
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--text-heading);
            letter-spacing: -0.02em;
            line-height: 1.2;
            margin-bottom: 6px;
        }

        .kpi-desc {
            font-size: 0.75rem;
            color: var(--text-subtle);
        }

        /* CONTENT CARDS & TOOLBARS */
        .content-card {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-card);
            overflow: hidden;
            margin-bottom: 24px;
        }

        .card-toolbar {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
            background: var(--bg-surface);
        }

        .toolbar-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-heading);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .toolbar-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        /* INPUTS & CONTROLS */
        .search-input-wrap {
            position: relative;
            display: inline-flex;
            align-items: center;
        }

        .search-input-wrap svg {
            position: absolute;
            left: 10px;
            color: var(--text-subtle);
            pointer-events: none;
        }

        .input-search {
            padding: 7px 12px 7px 32px;
            background: var(--bg-page);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: 0.84rem;
            color: var(--text-heading);
            outline: none;
            min-width: 220px;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .input-search:focus {
            border-color: var(--primary);
            background: #FFFFFF;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .select-filter {
            padding: 7px 12px;
            background: var(--bg-page);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: 0.84rem;
            color: var(--text-heading);
            outline: none;
            cursor: pointer;
        }

        .select-filter:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        /* BUTTONS */
        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--primary);
            color: #FFFFFF;
            border: 1px solid var(--primary);
            padding: 7px 14px;
            border-radius: var(--radius-sm);
            font-size: 0.84rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: background 0.15s ease;
        }

        .btn-primary:hover {
            background: var(--primary-hover);
        }

        .btn-secondary {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--bg-surface);
            color: var(--text-body);
            border: 1px solid var(--border);
            padding: 7px 14px;
            border-radius: var(--radius-sm);
            font-size: 0.84rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: background 0.15s ease;
        }

        .btn-secondary:hover {
            background: var(--bg-muted);
            color: var(--text-heading);
        }

        /* TABLES */
        .data-table-wrap {
            overflow-x: auto;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.86rem;
            text-align: left;
        }

        .data-table th {
            background: #F8FAFC;
            color: var(--text-muted);
            font-weight: 600;
            font-size: 0.74rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            padding: 11px 16px;
            border-bottom: 1px solid var(--border);
        }

        .data-table td {
            padding: 13px 16px;
            border-bottom: 1px solid var(--border-subtle);
            color: var(--text-body);
            vertical-align: middle;
        }

        .data-table tr:hover td {
            background: #F8FAFC;
        }

        .data-table tr:last-child td {
            border-bottom: none;
        }

        /* BADGES */
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 0.72rem;
            font-weight: 600;
        }

        .badge-supplier { background: #EFF6FF; color: #1E40AF; border: 1px solid #DBEAFE; }
        .badge-buyer { background: #F5F3FF; color: #6D28D9; border: 1px solid #EDE9FE; }
        .badge-both { background: #FFFBEB; color: #B45309; border: 1px solid #FEF3C7; }
        .badge-super { background: #FEF2F2; color: #991B1B; border: 1px solid #FEE2E2; }
        .badge-root { background: #F0FDF4; color: #166534; border: 1px solid #DCFCE7; }
        .badge-sub { background: #F1F5F9; color: #475569; border: 1px solid #E2E8F0; }
        .badge-free { background: #F8FAFC; color: #475569; border: 1px solid #CBD5E1; }
        .badge-pro { background: #EFF6FF; color: #1D4ED8; border: 1px solid #BFDBFE; font-weight: 700; }
        .badge-kurumsal { background: #F5F3FF; color: #6D28D9; border: 1px solid #DDD6FE; font-weight: 700; box-shadow: 0 1px 2px rgba(109, 40, 217, 0.08); }
        .badge-danger { background: #FEF2F2; color: #DC2626; border: 1px solid #FEE2E2; font-weight: 600; }
        .badge-warning { background: #FFFBEB; color: #B45309; border: 1px solid #FEF3C7; font-weight: 600; }
        .badge-purple { background: #F5F3FF; color: #6D28D9; border: 1px solid #DDD6FE; font-weight: 600; }
        .badge-info { background: #ECFEFF; color: #0E7490; border: 1px solid #CFFAFE; font-weight: 600; }
        .badge-gray { background: #F1F5F9; color: #475569; border: 1px solid #E2E8F0; font-weight: 500; }
        .badge-blue { background: #EFF6FF; color: #2563EB; border: 1px solid #DBEAFE; font-weight: 600; }
        .badge-success { background: #F0FDF4; color: #16A34A; border: 1px solid #DCFCE7; font-weight: 600; }

        .feedback-preview-box {
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-radius: var(--radius-sm);
            padding: 8px 12px;
            font-size: 0.81rem;
            color: #334155;
            line-height: 1.45;
            max-height: 52px;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            word-break: break-word;
            transition: all 0.15s ease;
            cursor: pointer;
        }

        .feedback-preview-box:hover {
            background: #F1F5F9;
            border-color: #CBD5E1;
            color: var(--text-heading);
            box-shadow: 0 1px 2px rgba(0,0,0,0.03);
        }

        /* ACTION BUTTONS */
        .actions-group {
            display: flex;
            align-items: center;
            gap: 6px;
            justify-content: flex-end;
        }

        .btn-table-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 5px 10px;
            border-radius: var(--radius-sm);
            font-size: 0.78rem;
            font-weight: 500;
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-body);
            cursor: pointer;
            transition: all 0.15s ease;
            text-decoration: none;
        }

        .btn-table-action:hover {
            background: var(--bg-muted);
            color: var(--text-heading);
            border-color: #CBD5E1;
        }

        .btn-table-action.danger:hover {
            background: var(--danger-light);
            color: var(--danger);
            border-color: #FECACA;
        }

        /* COMPACT HIERARCHICAL CATEGORY TREE STYLES */
        .cat-tree-node {
            margin-top: 3px;
            margin-bottom: 3px;
            position: relative;
        }

        .cat-node-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 6px 12px;
            background: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: var(--radius-sm);
            font-size: 0.84rem;
            transition: all 0.15s ease;
        }

        .cat-node-row:hover {
            background: #F8FAFC;
            border-color: #CBD5E1;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
        }

        .cat-node-row.is-root {
            background: #FFFFFF;
            border-left: 3px solid var(--primary);
            font-weight: 600;
        }

        .cat-node-left {
            display: flex;
            align-items: center;
            gap: 8px;
            flex: 1;
            min-width: 0;
        }

        .cat-toggle-btn {
            background: transparent;
            border: none;
            cursor: pointer;
            padding: 3px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #64748B;
            border-radius: 3px;
            line-height: 1;
        }

        .cat-toggle-btn:hover {
            background: #E2E8F0;
            color: var(--text-heading);
        }

        .cat-toggle-btn.is-collapsed .toggle-icon {
            transform: rotate(-90deg);
        }

        .toggle-icon {
            transition: transform 0.15s ease;
        }

        .cat-tree-bullet {
            color: #94A3B8;
            font-size: 0.85rem;
            width: 16px;
            text-align: center;
            display: inline-block;
        }

        .cat-node-icon {
            font-size: 0.95rem;
            line-height: 1;
        }

        .cat-node-title {
            color: var(--text-heading);
            font-weight: 600;
            font-size: 0.86rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .cat-node-id {
            font-size: 0.7rem;
            color: #94A3B8;
            background: #F1F5F9;
            padding: 1px 5px;
            border-radius: 3px;
            font-family: monospace;
            font-weight: 500;
        }

        .cat-node-count {
            font-size: 0.72rem;
            color: #065F46;
            background: #ECFDF5;
            border: 1px solid #D1FAE5;
            padding: 1px 6px;
            border-radius: 10px;
            font-weight: 600;
        }

        .cat-node-actions {
            display: flex;
            align-items: center;
            gap: 4px;
            opacity: 0.8;
            transition: opacity 0.15s ease;
        }

        .cat-node-row:hover .cat-node-actions {
            opacity: 1;
        }

        .btn-compact-add {
            display: inline-flex;
            align-items: center;
            padding: 2px 7px;
            font-size: 0.72rem;
            font-weight: 600;
            background: #EFF6FF;
            border: 1px solid #BFDBFE;
            color: #1D4ED8;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .btn-compact-add:hover {
            background: #DBEAFE;
            color: #1E40AF;
        }

        .btn-compact-action {
            display: inline-flex;
            align-items: center;
            padding: 2px 7px;
            font-size: 0.72rem;
            font-weight: 500;
            background: #FFFFFF;
            border: 1px solid var(--border);
            color: var(--text-body);
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .btn-compact-action:hover {
            background: var(--bg-muted);
            color: var(--text-heading);
            border-color: #CBD5E1;
        }

        .btn-compact-action.danger:hover {
            background: var(--danger-light);
            color: var(--danger);
            border-color: #FECACA;
        }

        .cat-children-wrap {
            border-left: 2px solid #E2E8F0;
            margin-left: 6px;
            padding-left: 2px;
            transition: all 0.2s ease;
        }

        .cat-children-wrap.is-hidden {
            display: none;
        }

        /* ICON SELECTOR & PICKER STYLES */
        .icon-selector-control {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 8px;
        }
        .icon-preview-box {
            width: 44px;
            height: 44px;
            border-radius: var(--radius-sm);
            background: #EFF6FF;
            border: 1px solid #BFDBFE;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            color: var(--primary);
            flex-shrink: 0;
            transition: all 0.2s ease;
        }
        .icon-picker-hints {
            margin-top: 8px;
        }
        .hint-label {
            display: block;
            font-size: 0.76rem;
            color: var(--text-muted);
            margin-bottom: 6px;
            font-weight: 500;
        }
        .icon-chips-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(42px, 1fr));
            gap: 6px;
            max-height: 220px;
            overflow-y: auto;
            padding: 8px;
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-radius: var(--radius-sm);
        }
        .icon-chips-grid::-webkit-scrollbar {
            width: 6px;
        }
        .icon-chips-grid::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 4px;
        }
        .icon-chip-btn {
            width: 100%;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #E2E8F0;
            background: #FFFFFF;
            border-radius: 6px;
            cursor: pointer;
            font-size: 1.05rem;
            color: #334155;
            transition: all 0.15s ease;
        }
        .icon-chip-btn:hover {
            background: #EFF6FF;
            border-color: #93C5FD;
            color: var(--primary);
            transform: translateY(-1px);
        }
        .icon-chip-btn.is-active {
            background: var(--primary);
            border-color: var(--primary);
            color: #FFFFFF;
        }

        /* MODALS */
        .modal-backdrop-wrap {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(15, 23, 42, 0.45);
            backdrop-filter: blur(4px);
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.2s ease, visibility 0.2s ease;
        }

        .modal-backdrop-wrap.is-open {
            opacity: 1;
            visibility: visible;
        }

        .modal-panel {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            width: 100%;
            max-width: 580px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: var(--shadow-modal);
            transform: translateY(8px);
            transition: transform 0.2s ease;
        }

        .modal-backdrop-wrap.is-open .modal-panel {
            transform: translateY(0);
        }

        .modal-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .modal-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--text-heading);
        }

        .modal-close-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-size: 1.2rem;
            cursor: pointer;
            padding: 4px;
            line-height: 1;
        }

        .modal-close-btn:hover { color: var(--text-heading); }

        .modal-body {
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .modal-footer {
            padding: 14px 20px;
            border-top: 1px solid var(--border);
            background: var(--bg-page);
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
        }

        .form-field {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .form-field-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .form-label {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-heading);
        }

        .form-input, .form-select, .form-textarea {
            padding: 8px 12px;
            background: #FFFFFF;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: 0.86rem;
            color: var(--text-heading);
            outline: none;
            width: 100%;
            font-family: inherit;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .form-input:focus, .form-select:focus, .form-textarea:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .empty-state {
            padding: 40px 20px;
            text-align: center;
            color: var(--text-muted);
            font-size: 0.88rem;
        }
    </style>
</head>
<body>

    <!-- ÜST MENÜ BAR (HEADER) -->
    <header class="admin-header">
        <div class="header-container">
            <a class="brand-wrap" href="@Url.Action("Index", "SuperAdmin")">
                <div class="brand-icon">TP</div>
                <div class="brand-text">
                    <span class="brand-title">Tedarik Portalı</span>
                    <span class="brand-tag">Sistem Yönetim Paneli</span>
                </div>
            </a>

            <div class="header-actions">
                <span class="admin-badge">
                    <span class="admin-dot"></span>
                    Süper Admin
                </span>

                <span style="font-size: 0.84rem; color: var(--text-muted); font-weight: 500;">
                    @activeUser
                </span>

                <a asp-controller="Home" asp-action="Index" class="btn-link-site">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                    Siteye Dön
                </a>
            </div>
        </div>
    </header>

    <!-- ANA GÖVDE -->
    <main class="main-container">

        <!-- BAŞLIK & AÇIKLAMA -->
        <div class="page-header">
            <h1 class="page-title">Sistem Yönetimi</h1>
            <p class="page-subtitle">Platformdaki tüm kategorileri, firma hesaplarını ve sistem yapılandırmalarını bu ekrandan yönetebilirsiniz.</p>
        </div>

        <!-- BİLDİRİM VE UYARI MESAJLARI -->
        @if (TempData["AdminSuccess"] != null)
        {
            <div class="alert-box alert-success">
                <span>@TempData["AdminSuccess"]</span>
                <button type="button" class="alert-close-btn" onclick="this.parentElement.remove()">&times;</button>
            </div>
        }
        @if (TempData["AdminError"] != null)
        {
            <div class="alert-box alert-error">
                <span>@TempData["AdminError"]</span>
                <button type="button" class="alert-close-btn" onclick="this.parentElement.remove()">&times;</button>
            </div>
        }

        <!-- SEKME SEÇİCİ -->
        <nav class="tabs-nav" aria-label="Yönetim Sekmeleri">
            <a href="@Url.Action("Index", "SuperAdmin", new { tab = "overview" })" 
               class="tab-btn @(Model.ActiveTab == "overview" ? "is-active" : "")">
                Genel Bakış
            </a>

            <a href="@Url.Action("Index", "SuperAdmin", new { tab = "categories" })" 
               class="tab-btn @(Model.ActiveTab == "categories" ? "is-active" : "")">
                Kategoriler
                <span class="tab-count">@Model.Stats.TotalCategories</span>
            </a>

            <a href="@Url.Action("Index", "SuperAdmin", new { tab = "companies" })" 
               class="tab-btn @(Model.ActiveTab == "companies" ? "is-active" : "")">
                Firmalar &amp; Hesaplar
                <span class="tab-count">@Model.Stats.TotalCompanies</span>
            </a>

            <a href="@Url.Action("Index", "SuperAdmin", new { tab = "orders" })" 
               class="tab-btn @(Model.ActiveTab == "orders" ? "is-active" : "")">
                Siparişler &amp; Sevkiyatlar
                <span class="tab-count" style="background: #EFF6FF; color: #1E40AF; font-weight: 700;">@Model.Stats.TotalOrders</span>
            </a>

            <a href="@Url.Action("Index", "SuperAdmin", new { tab = "reviews" })" 
               class="tab-btn @(Model.ActiveTab == "reviews" ? "is-active" : "")">
                Değerlendirmeler &amp; İtibar Testi
                <span class="tab-count" style="background: #FEF3C7; color: #B45309; font-weight: 700;">@Model.Stats.TotalReviews</span>
            </a>

            <a href="@Url.Action("Index", "SuperAdmin", new { tab = "simulation" })" 
               class="tab-btn @(Model.ActiveTab == "simulation" ? "is-active" : "")">
                Test &amp; Simülasyon
            </a>

            <a href="@Url.Action("Index", "SuperAdmin", new { tab = "settings" })" 
               class="tab-btn @(Model.ActiveTab == "settings" ? "is-active" : "")">
                Sistem Ayarları
            </a>

            <a href="@Url.Action("Index", "SuperAdmin", new { tab = "feedbacks" })" 
               class="tab-btn @(Model.ActiveTab == "feedbacks" ? "is-active" : "")">
                Geri Bildirimler &amp; Destek
                <span class="tab-count" style="background: #FEE2E2; color: #DC2626; font-weight: 700;">@Model.TotalFeedbacksCount</span>
            </a>
        </nav>

        <!-- ==================== SEKME 1: GENEL BAKIŞ ==================== -->
        @if (Model.ActiveTab == "overview")
        {
            <div class="kpi-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
                <div class="kpi-card">
                    <div class="kpi-label">Toplam Kayıtlı Firma</div>
                    <div class="kpi-value">@Model.Stats.TotalCompanies</div>
                    <div class="kpi-desc">
                        @Model.Stats.CorporateCompaniesCount Kurumsal Firma · @Model.Stats.SuperAdminCount Yönetici
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-label">Ürün Kategorileri</div>
                    <div class="kpi-value">@Model.Stats.TotalCategories</div>
                    <div class="kpi-desc">
                        @Model.Stats.RootCategoriesCount Ana · @Model.Stats.SubCategoriesCount Alt Kategori
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-label">Toplam Siparişler &amp; Hacim</div>
                    <div class="kpi-value" style="color: #2563EB;">@Model.Stats.TotalOrders <small style="font-size: 0.82rem; color: var(--text-muted); font-weight: 500;">adet</small></div>
                    <div class="kpi-desc">
                        Sipariş Cirosu: @Model.Stats.TotalOrderVolume.ToString("N0") ₺
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-label">Çoklu Tedarikçi &amp; Kalem Sevkiyatı</div>
                    <div class="kpi-value" style="color: #0D9488;">@Model.Stats.TotalOrderItemsCount <small style="font-size: 0.82rem; color: var(--text-muted); font-weight: 500;">kalem</small></div>
                    <div class="kpi-desc">
                        @Model.Stats.MultiSupplierOrdersCount Çoklu Tedarikçili Sipariş
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-label">10 Puanlık İtibar Skoru</div>
                    <div class="kpi-value" style="color: #D97706;">@Model.Stats.AveragePlatformScore.ToString("0.0") <small style="font-size: 0.9rem; color: var(--text-muted);">/ 10</small></div>
                    <div class="kpi-desc">
                        Toplam @Model.Stats.TotalReviews Doğrulanmış Değerlendirme
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-label">Satın Alma Talepleri</div>
                    <div class="kpi-value">@Model.Stats.TotalRequests</div>
                    <div class="kpi-desc">
                        Tahmini Bütçe: @Model.Stats.TotalEstimatedBudget.ToString("N0") ₺
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-label">İletilen Teklifler</div>
                    <div class="kpi-value">@Model.Stats.TotalOffers</div>
                    <div class="kpi-desc">
                        Teklif Hacmi: @Model.Stats.TotalOfferedVolume.ToString("N0") ₺
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-label">Vitrin Satış İlanları</div>
                    <div class="kpi-value">@Model.Stats.TotalListings</div>
                    <div class="kpi-desc">
                        Katalog Değeri: @Model.Stats.TotalListingValue.ToString("N0") ₺
                    </div>
                </div>
            </div>

            <!-- ==================== ÜYELİK SEVİYESİ DAĞILIMI (KOTALAR & GELİR) ==================== -->
            <div style="margin-bottom: 24px;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                    <div style="font-size: 0.92rem; font-weight: 700; color: var(--text-heading); display: flex; align-items: center; gap: 8px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--primary);">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                        </svg>
                        Üyelik Seviyesi Dağılımı &amp; Paket Satış Gelirleri
                    </div>
                    <a href="@Url.Action("Index", "SuperAdmin", new { tab = "companies" })" style="font-size: 0.78rem; font-weight: 600; color: var(--primary); text-decoration: none;">
                        Tüm Firmaları İncele &rarr;
                    </a>
                </div>

                <div class="kpi-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
                    <div class="kpi-card" style="border-left: 4px solid #94A3B8;">
                        <div class="kpi-label">Bedava Üyelik</div>
                        <div class="kpi-value" style="color: #475569;">@Model.Stats.BedavaMembersCount <small style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">firma</small></div>
                        <div class="kpi-desc">
                            Kota: <strong>10 Talep</strong> · <strong>10 Ürün</strong> · <strong>3 Resim</strong>
                        </div>
                    </div>

                    <div class="kpi-card" style="border-left: 4px solid #2563EB;">
                        <div class="kpi-label">Pro Üyelik</div>
                        <div class="kpi-value" style="color: #2563EB;">@Model.Stats.ProMembersCount <small style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">firma</small></div>
                        <div class="kpi-desc">
                            Kota: <strong>100 Talep</strong> · <strong>100 Ürün</strong> · <strong>20 Resim</strong> (990 ₺/Ay)
                        </div>
                    </div>

                    <div class="kpi-card" style="border-left: 4px solid #7C3AED;">
                        <div class="kpi-label">Kurumsal Üyelik</div>
                        <div class="kpi-value" style="color: #7C3AED;">@Model.Stats.KurumsalMembersCount <small style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">firma</small></div>
                        <div class="kpi-desc">
                            Kota: <strong>Sınırsız Talep</strong> · <strong>Sınırsız Ürün</strong> · <strong>Sınırsız Resim</strong> (2.990 ₺/Ay)
                        </div>
                    </div>

                    <div class="kpi-card" style="border-left: 4px solid #059669;">
                        <div class="kpi-label">Üyelik Satış Cirosu</div>
                        <div class="kpi-value" style="color: #059669;">@Model.Stats.TotalMembershipRevenue.ToString("N0") ₺</div>
                        <div class="kpi-desc">
                            Toplam @Model.Stats.TotalMembershipOrdersCount Dijital Üyelik Satışı
                        </div>
                    </div>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px;">
                <div class="content-card" style="padding: 20px;">
                    <h3 style="font-size: 1rem; font-weight: 700; color: var(--text-heading); margin-bottom: 8px;">
                        Kategori Yönetimi
                    </h3>
                    <p style="font-size: 0.84rem; color: var(--text-muted); margin-bottom: 16px; line-height: 1.5;">
                        Platform genelinde firmaların talep açarken ve teklif verirken kullandığı ana ve alt kategorileri yapılandırın.
                    </p>
                    <div style="display: flex; gap: 8px;">
                        <button type="button" class="btn-primary" onclick="openAddCategoryModal()">+ Yeni Kategori</button>
                        <a href="@Url.Action("Index", "SuperAdmin", new { tab = "categories" })" class="btn-secondary">Listeye Git</a>
                    </div>
                </div>

                <div class="content-card" style="padding: 20px;">
                    <h3 style="font-size: 1rem; font-weight: 700; color: var(--text-heading); margin-bottom: 8px;">
                        Sipariş &amp; Sevkiyat Yönetimi
                    </h3>
                    <p style="font-size: 0.84rem; color: var(--text-muted); margin-bottom: 16px; line-height: 1.5;">
                        Tüm alıcı siparişlerini, çoklu tedarikçi kalemlerini, kargo takip numaralarını ve sipariş durumlarını denetleyin.
                    </p>
                    <div>
                        <a href="@Url.Action("Index", "SuperAdmin", new { tab = "orders" })" class="btn-primary">Siparişleri İncele</a>
                    </div>
                </div>

                <div class="content-card" style="padding: 20px;">
                    <h3 style="font-size: 1rem; font-weight: 700; color: var(--text-heading); margin-bottom: 8px;">
                        Firma &amp; Hesap Yönetimi
                    </h3>
                    <p style="font-size: 0.84rem; color: var(--text-muted); margin-bottom: 16px; line-height: 1.5;">
                        Kayıtlı firmaların unvan, yetkili, e-posta, telefon, vergi ve üyelik bilgilerini yönetin veya şifrelerini sıfırlayın.
                    </p>
                    <div>
                        <a href="@Url.Action("Index", "SuperAdmin", new { tab = "companies" })" class="btn-primary">Firmaları Yönet</a>
                    </div>
                </div>

                <div class="content-card" style="padding: 20px;">
                    <h3 style="font-size: 1rem; font-weight: 700; color: var(--text-heading); margin-bottom: 8px;">
                        Geri Bildirimler &amp; Destek
                    </h3>
                    <p style="font-size: 0.84rem; color: var(--text-muted); margin-bottom: 16px; line-height: 1.5;">
                        Kullanıcılar ve kurumsal firmalar tarafından iletilen hata raporları, işlev önerileri ve destek taleplerini denetleyin.
                    </p>
                    <div>
                        <a href="@Url.Action("Index", "SuperAdmin", new { tab = "feedbacks" })" class="btn-primary">Bildirimleri İncele (@Model.TotalFeedbacksCount)</a>
                    </div>
                </div>
            </div>
        }

        <!-- ==================== SEKME 2: KATEGORİLER ==================== -->
        @if (Model.ActiveTab == "categories")
        {
            <div class="content-card">
                <div class="card-toolbar">
                    <div class="toolbar-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--primary);">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                        </svg>
                        Kategori & Alt Kategori Ağacı
                        <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">
                            (@Model.Stats.TotalCategories Toplam Kategori · @Model.Stats.RootCategoriesCount Ana · @Model.Stats.SubCategoriesCount Alt)
                        </span>
                    </div>

                    <div class="toolbar-actions">
                        <div class="search-input-wrap">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            <input type="text" id="catSearchInput" class="input-search" placeholder="Kategori ara..." oninput="filterCategoriesTree()" />
                        </div>

                        <button type="button" class="btn-compact-action" onclick="expandAllCategories()" style="font-size: 0.76rem; padding: 4px 9px;">
                            Tümünü Aç
                        </button>
                        <button type="button" class="btn-compact-action" onclick="collapseAllCategories()" style="font-size: 0.76rem; padding: 4px 9px;">
                            Tümünü Kapat
                        </button>
                        <button type="button" class="btn-primary" onclick="openAddCategoryModal()">
                            + Yeni Ana Kategori Ekle
                        </button>
                    </div>
                </div>

                <div class="cat-compact-tree-wrap" id="categoryTreeList" style="padding: 12px 16px;">
                    @if (Model.Categories.Any())
                    {
                        @foreach (var cat in Model.Categories)
                        {
                            <partial name="_CategoryTreeItem" model="(Node: cat, Level: 0)" />
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            Henüz kayıtlı bir kategori bulunmuyor. Yukarıdaki butona tıklayarak ilk ana kategoriyi ekleyebilirsiniz.
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ==================== SEKME 3: FİRMALAR & AYARLAR ==================== -->
        @if (Model.ActiveTab == "companies")
        {
            <div class="content-card">
                <div class="card-toolbar">
                    <div class="toolbar-title">
                        Firma Listesi
                        <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">(@Model.Companies.Count kayıt)</span>
                    </div>

                    <div class="toolbar-actions">
                        <div class="search-input-wrap">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            <input type="text" id="compSearchInput" class="input-search" placeholder="Firma adı, yetkili veya e-posta..." oninput="filterCompaniesTable()" />
                        </div>

                        <select id="compTypeFilter" class="select-filter" onchange="filterCompaniesTable()">
                            <option value="">Tüm Hesaplar</option>
                            <option value="corporate">Kurumsal Firmalar (Alıcı & Tedarikçi)</option>
                            <option value="4">Süper Adminler</option>
                        </select>

                        <select id="compMemberFilter" class="select-filter" onchange="filterCompaniesTable()">
                            <option value="">Tüm Üyelikler</option>
                            <option value="1">Bedava (10 Talep, 10 Ürün, 3 Resim)</option>
                            <option value="2">Pro (100 Talep, 100 Ürün, 20 Resim)</option>
                            <option value="3">Kurumsal (Sınırsız)</option>
                        </select>
                    </div>
                </div>

                <div class="data-table-wrap">
                    <table class="data-table" id="companiesTable">
                        <thead>
                            <tr>
                                <th style="width: 70px;">ID</th>
                                <th>Firma Adı & Yetkili</th>
                                <th>E-posta & Telefon</th>
                                <th>Vergi / TC</th>
                                <th>Hesap Türü</th>
                                <th>Üyelik &amp; Kotalar</th>
                                <th>Aktivite</th>
                                <th style="text-align: right; width: 170px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Companies.Any())
                            {
                                @foreach (var comp in Model.Companies)
                                {
                                    <tr class="comp-row" id="comp-row-@comp.CompanyID" data-type="@(comp.CompanyTypeID ?? 0)" data-member="@(comp.MembershipTypeID ?? 1)" data-search="@comp.CompanyName.ToLowerInvariant() @comp.CompanyOfficial.ToLowerInvariant() @comp.CompanyMail.ToLowerInvariant() @(comp.TCNO ?? "")">
                                        <td style="color: var(--text-muted); font-weight: 500;">#@comp.CompanyID</td>
                                        <td>
                                             <div style="font-weight: 600; color: var(--text-heading);" id="comp-name-@comp.CompanyID">@comp.CompanyName</div>
                                             <div style="font-size: 0.78rem; color: var(--text-muted);" id="comp-official-@comp.CompanyID">@comp.CompanyOfficial</div>
                                        </td>
                                        <td>
                                             <div style="color: var(--text-heading);" id="comp-mail-@comp.CompanyID">@comp.CompanyMail</div>
                                             <div style="font-size: 0.78rem; color: var(--text-muted);" id="comp-phone-@comp.CompanyID">@(comp.CompanyPhone ?? "—")</div>
                                        </td>
                                        <td>
                                             <div style="font-size: 0.82rem; color: var(--text-heading);">@(string.IsNullOrWhiteSpace(comp.TCNO) ? "—" : comp.TCNO)</div>
                                             <div style="font-size: 0.76rem; color: var(--text-muted);">@(string.IsNullOrWhiteSpace(comp.TaxOffice) ? "" : comp.TaxOffice)</div>
                                        </td>
                                        <td>
                                             @if (comp.CompanyTypeID == 4)
                                             {
                                                 <span class="badge badge-super">Süper Admin</span>
                                             }
                                             else
                                             {
                                                 <span class="badge badge-both">Kurumsal Firma</span>
                                             }
                                        </td>
                                        <td>
                                            <div style="display: flex; flex-direction: column; gap: 4px;">
                                                <div style="display: flex; align-items: center; gap: 6px;">
                                                    @if (comp.MembershipTypeID == 3)
                                                    {
                                                        <span class="badge badge-kurumsal" id="comp-mem-badge-@comp.CompanyID">👑 Kurumsal</span>
                                                    }
                                                    else if (comp.MembershipTypeID == 2)
                                                    {
                                                        <span class="badge badge-pro" id="comp-mem-badge-@comp.CompanyID">★ Pro</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-free" id="comp-mem-badge-@comp.CompanyID">Bedava</span>
                                                    }
                                                    <select class="form-select" style="padding: 2px 4px; font-size: 0.7rem; width: auto; height: 23px; border-radius: 4px;" onchange="handleQuickChangeMembership(@comp.CompanyID, this.value)" title="Hızlı Üyelik Seviyesi Değiştir">
                                                        <option value="1" selected="@(comp.MembershipTypeID == 1)">Bedava</option>
                                                        <option value="2" selected="@(comp.MembershipTypeID == 2)">Pro</option>
                                                        <option value="3" selected="@(comp.MembershipTypeID == 3)">Kurumsal</option>
                                                    </select>
                                                </div>
                                                <div style="font-size: 0.72rem; color: var(--text-muted); line-height: 1.3;" id="comp-mem-limits-@comp.CompanyID">
                                                    <span>Açık Talep: <strong>@comp.ActiveRequestCount</strong>/@(comp.MaxRequests == int.MaxValue ? "∞" : comp.MaxRequests.ToString())</span> · 
                                                    <span>Ürün: <strong>@comp.ListedProductCount</strong>/@(comp.MaxProducts == int.MaxValue ? "∞" : comp.MaxProducts.ToString())</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge badge-sub">
                                                @comp.RequestCount Talep / @comp.OfferCount Teklif
                                            </span>
                                        </td>
                                        <td>
                                            <div class="actions-group">
                                                <button type="button" class="btn-table-action" onclick="openEditCompanyModal(@comp.CompanyID)" title="Firma Bilgilerini Düzenle">
                                                    Düzenle
                                                </button>
                                                <button type="button" class="btn-table-action" onclick="openResetPasswordModal(@comp.CompanyID, '@Html.Raw(comp.CompanyName.Replace("'", "\\'"))')" title="Şifre Sıfırla">
                                                    Şifre
                                                </button>
                                                <button type="button" class="btn-table-action danger" title="Sil" onclick="handleDeleteCompany(@comp.CompanyID, '@Html.Raw(comp.CompanyName.Replace("'", "\\'"))', event)">
                                                    Sil
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="empty-state">Kayıtlı firma bulunamadı.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ==================== SEKME: SİPARİŞLER & SEVKİYATLAR ==================== -->
        @if (Model.ActiveTab == "orders")
        {
            <!-- KPI CARDS -->
            <div class="kpi-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-bottom: 24px;">
                <div class="kpi-card">
                    <div class="kpi-label">Toplam Sipariş</div>
                    <div class="kpi-value" style="color: #2563EB;">@Model.Stats.TotalOrders <small style="font-size: 0.8rem; color: var(--text-muted);">adet</small></div>
                    <div class="kpi-desc">Platform genelinde tamamlanan ve süren işlemler</div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-label">Toplam İşlem Hacmi</div>
                    <div class="kpi-value" style="color: #16A34A;">@Model.Stats.TotalOrderVolume.ToString("N2") ₺</div>
                    <div class="kpi-desc">B2B sipariş ciro toplamı</div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-label">Çoklu Tedarikçi Siparişleri</div>
                    <div class="kpi-value" style="color: #0D9488;">@Model.Stats.MultiSupplierOrdersCount <small style="font-size: 0.8rem; color: var(--text-muted);">sipariş</small></div>
                    <div class="kpi-desc">Birden fazla satıcı içeren siparişler</div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-label">Toplam Sevkiyat Kalemi</div>
                    <div class="kpi-value" style="color: #7C3AED;">@Model.Stats.TotalOrderItemsCount <small style="font-size: 0.8rem; color: var(--text-muted);">kalem</small></div>
                    <div class="kpi-desc">Kargo ve teslimat takip kalemleri</div>
                </div>
            </div>

            <!-- SİPARİŞ LİSTESİ TABLOSU -->
            <div class="content-card">
                <div class="card-toolbar">
                    <div class="toolbar-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--primary);">
                            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <path d="M16 10a4 4 0 0 1-8 0"></path>
                        </svg>
                        Sipariş Listesi &amp; Sevkiyat Takibi
                        <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">(@Model.Orders.Count sipariş listeleniyor)</span>
                    </div>

                    <div class="toolbar-actions">
                        <div class="search-input-wrap">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            <input type="text" id="orderSearchInput" class="input-search" placeholder="Sipariş no, alıcı, tedarikçi, kargo takip..." oninput="filterOrdersTable()" />
                        </div>

                        <select id="orderStatusFilter" class="select-filter" onchange="filterOrdersTable()">
                            <option value="">Tüm Siparişler</option>
                            <option value="membership">👑 Dijital Üyelik Satın Alımları</option>
                            <option value="Onaylandı">Onaylandı</option>
                            <option value="Hazırlanıyor">Hazırlanıyor</option>
                            <option value="Kargoda">Kargoda / Kargoya Verildi</option>
                            <option value="Teslim Edildi">Teslim Edildi / Tamamlandı</option>
                            <option value="İptal Edildi">İptal Edildi</option>
                        </select>
                    </div>
                </div>

                <div class="data-table-wrap">
                    <table class="data-table" id="ordersTable">
                        <thead>
                            <tr>
                                <th style="width: 120px;">Sipariş No</th>
                                <th>Alıcı Firma</th>
                                <th>Tedarikçi Firma(lar)</th>
                                <th style="text-align: center; width: 90px;">Kalem</th>
                                <th style="text-align: right; width: 120px;">Tutar</th>
                                <th>Kargo &amp; Takip / Teslimat</th>
                                <th style="text-align: center; width: 120px;">Durum</th>
                                <th>Tarih</th>
                                <th style="text-align: right; width: 140px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Orders.Any())
                            {
                                @foreach (var ord in Model.Orders)
                                {
                                    var isMulti = ord.SupplierCount > 1;
                                    var statusClass = ord.OrderStatus == "Teslim Edildi" || ord.OrderStatus == "Tamamlandı" ? "badge-root" :
                                                      ord.OrderStatus == "Kargoda" || ord.OrderStatus == "Kargoya Verildi" ? "badge-supplier" :
                                                      ord.OrderStatus == "İptal Edildi" ? "badge-super" : "badge-both";

                                    <tr class="order-row" id="order-row-@ord.OrderID" 
                                        data-search="@ord.OrderNumber.ToLowerInvariant() @ord.BuyerCompanyName.ToLowerInvariant() @(ord.SupplierCompanyName?.ToLowerInvariant() ?? "") @(ord.TrackingNumber?.ToLowerInvariant() ?? "")"
                                        data-status="@ord.OrderStatus"
                                        data-membership="@(ord.IsMembershipOrder ? "1" : "0")">
                                        <td>
                                            <strong style="color: var(--primary);">#@ord.OrderNumber</strong>
                                            @if (ord.IsMembershipOrder)
                                            {
                                                <div style="margin-top: 3px;">
                                                    <span class="badge" style="background: #EEF2FF; color: #4338CA; border: 1px solid #C7D2FE; font-size: 0.68rem; font-weight: 700;">👑 Dijital Üyelik</span>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <div style="font-weight: 600; color: var(--text-heading);">@ord.BuyerCompanyName</div>
                                            @if (!string.IsNullOrWhiteSpace(ord.BuyerOfficial))
                                            {
                                                <div style="font-size: 0.72rem; color: var(--text-muted);">@ord.BuyerOfficial</div>
                                            }
                                        </td>
                                        <td>
                                            @if (ord.IsMembershipOrder)
                                            {
                                                <div style="display: flex; align-items: center; gap: 6px;">
                                                    <span class="badge" style="background: #ECFDF5; color: #047857; border: 1px solid #A7F3D0; font-weight: 600;">
                                                        Sistem / Portal Hizmeti
                                                    </span>
                                                </div>
                                            }
                                            else if (isMulti)
                                            {
                                                <div style="display: flex; align-items: center; gap: 6px;">
                                                    <span class="badge" style="background: #FEF3C7; color: #B45309; border: 1px solid #FDE68A; font-weight: 700;">
                                                        @ord.SupplierCount Tedarikçi
                                                    </span>
                                                </div>
                                                <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 2px;">
                                                    @string.Join(", ", ord.Items.Select(i => i.SupplierCompanyName).Where(s => !string.IsNullOrEmpty(s)).Distinct().Take(2))
                                                    @(ord.SupplierCount > 2 ? "..." : "")
                                                </div>
                                            }
                                            else
                                            {
                                                <div style="font-weight: 500; color: var(--text-body);">
                                                    @(string.IsNullOrWhiteSpace(ord.SupplierCompanyName) ? "Tedarikçi" : ord.SupplierCompanyName)
                                                </div>
                                            }
                                        </td>
                                        <td style="text-align: center;">
                                            <span class="badge badge-sub">@ord.TotalItemCount Kalem</span>
                                        </td>
                                        <td style="text-align: right; font-weight: 700; color: var(--text-heading);">
                                            @ord.GrandTotal.ToString("N2") ₺
                                        </td>
                                        <td>
                                            @if (ord.IsMembershipOrder)
                                            {
                                                <span style="font-size: 0.76rem; color: #16A34A; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                                                    ⚡ Anında Dijital Aktivasyon
                                                </span>
                                                <div style="font-size: 0.7rem; color: var(--text-muted);">Adres &amp; Kargo Gerekmez</div>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(ord.TrackingNumber))
                                            {
                                                <div style="font-size: 0.78rem; font-weight: 600; color: #1E40AF;">
                                                    @(string.IsNullOrWhiteSpace(ord.ShippingCarrier) ? "Kargo" : ord.ShippingCarrier): @ord.TrackingNumber
                                                </div>
                                            }
                                            else
                                            {
                                                <span style="font-size: 0.75rem; color: var(--text-muted);">Takip No Girilmedi</span>
                                            }
                                        </td>
                                        <td style="text-align: center;">
                                            <span class="badge @statusClass">
                                                @ord.OrderStatus
                                            </span>
                                        </td>
                                        <td style="font-size: 0.76rem; color: var(--text-muted);">
                                            @ord.OrderDate.ToString("dd.MM.yyyy HH:mm")
                                        </td>
                                        <td style="text-align: right;">
                                            <div style="display: flex; gap: 6px; justify-content: flex-end;">
                                                <button type="button" class="btn-table-action" onclick="openAdminOrderModal(@ord.OrderID)" title="Sipariş Detayı ve Kalem Sevkiyatlarını Yönet">
                                                    Detay
                                                </button>
                                                @if (ord.OrderStatus != "İptal Edildi")
                                                {
                                                    <button type="button" class="btn-table-action danger" style="color: #DC2626; border-color: #FCA5A5;" onclick="handleCancelOrder(@ord.OrderID, event)" title="Siparişi İptal Et">
                                                        İptal
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="empty-state">Kayıtlı bir sipariş bulunamadı.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ==================== SEKME: TEST & SİMÜLASYON MERKEZİ ==================== -->
        @if (Model.ActiveTab == "simulation")
        {
            <div class="alert-box" style="background: #EFF6FF; border: 1px solid #BFDBFE; color: #1E40AF; margin-bottom: 24px;">
                <div>
                    <strong>Test ve Simülasyon Merkezi:</strong> Bu alandan farklı hesaplara tek tek giriş-çıkış yapmadan, seçtiğiniz herhangi bir <strong>firma adına satış ilanı açabilir</strong>, <strong>talep yayınlayabilir</strong> ve dilediğiniz <strong>firma adına teklif gönderebilirsiniz</strong>. Eklenen ilanlar doğrudan ana sayfa vitrininde ve katalogda anında listelenir.
                </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 28px; margin-bottom: 32px;">
                
                <!-- KART 1: FİRMA ADINA SATIŞ İLANI / ÜRÜN OLUŞTUR -->
                <div class="content-card" style="padding: 24px; border-top: 4px solid #2563EB;">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
                        <h3 style="font-size: 1.10rem; font-weight: 700; color: var(--text-heading); display: flex; align-items: center; gap: 8px;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #2563EB;"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                            <span>Firma Adına Satış İlanı Ver</span>
                        </h3>
                        <span class="badge badge-supplier" style="background: #EFF6FF; color: #2563EB; border: 1px solid #BFDBFE;">Vitrin Simülatörü</span>
                    </div>

                    <form asp-action="SimulateCreateListing" method="post" id="simListingForm" onsubmit="handleSimListingSubmit(event); return false;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ImageBase64" id="simListingImageBase64" />

                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <div class="form-field-grid" style="grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));">
                                <div class="form-field">
                                    <label class="form-label" for="simListingSupplier">Satıcı / Tedarikçi Firma *</label>
                                    <select id="simListingSupplier" name="SupplierCompanyID" class="form-select" required onchange="handleSimListingSupplierChange(this)">
                                        <option value="">— İlanı Verecek Firmayı Seçin —</option>
                                        @foreach (var comp in Model.Companies)
                                        {
                                            <option value="@comp.CompanyID" data-name="@comp.CompanyName">
                                                #@comp.CompanyID - @comp.CompanyName [Yetkili: @comp.CompanyOfficial]
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="form-field">
                                    <label class="form-label" for="simListingName">Ürün / İlan Adı *</label>
                                    <input type="text" id="simListingName" name="ItemName" class="form-input" placeholder="Örn: Endüstriyel Rulman 6204-2RS" required />
                                </div>
                            </div>

                            <div class="form-field-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
                                <div class="form-field">
                                    <label class="form-label" for="simListingPrice">Birim Satış Fiyatı (₺) *</label>
                                    <input type="number" step="0.01" min="0.01" id="simListingPrice" name="ItemPrice" class="form-input" placeholder="185.00" required />
                                </div>
                                <div class="form-field">
                                    <label class="form-label" for="simListingQty">Stok Adedi *</label>
                                    <input type="number" id="simListingQty" name="Quantity" class="form-input" min="1" value="250" required />
                                </div>
                                <div class="form-field">
                                    <label class="form-label" for="simListingCat">Kategori</label>
                                    <select id="simListingCat" name="CategoryID" class="form-select">
                                        <option value="">— Kategori Seçin —</option>
                                        @foreach (var cat in Model.AvailableParentCategories)
                                        {
                                            <option value="@cat.CategoryID">@cat.FormattedName</option>
                                        }
                                    </select>
                                </div>
                                <div class="form-field">
                                    <label class="form-label" for="simListingBrand">Marka / Etiket</label>
                                    <input type="text" id="simListingBrand" name="Brand" class="form-input" placeholder="Otomatik Firma Adı" />
                                </div>
                            </div>

                            <div class="form-field-grid" style="grid-template-columns: 2fr 1fr;">
                                <div class="form-field">
                                    <label class="form-label" for="simListingDesc">Ürün Açıklaması &amp; Şartlar</label>
                                    <textarea id="simListingDesc" name="ItemDescryption" class="form-textarea" rows="2" placeholder="Ürün özellikleri, malzeme kalitesi, toptan gönderim detayları..."></textarea>
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Ürün Görseli (İsteğe Bağlı)</label>
                                    <div style="display: flex; gap: 10px; align-items: center; margin-top: 4px;">
                                        <input type="file" accept="image/*" id="simListingFileInput" class="form-input" style="padding: 5px;" onchange="handleListingImageUpload(this)" />
                                        <div id="simImgPreviewBox" style="display: none; width: 44px; height: 44px; border-radius: 6px; overflow: hidden; border: 1px solid #CBD5E1; flex: none;">
                                            <img id="simImgPreview" src="" alt="Önizleme" style="width: 100%; height: 100%; object-fit: cover;" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div style="margin-top: 4px;">
                                <button type="submit" class="btn-primary" style="width: 100%; justify-content: center; padding: 11px; font-size: 0.95rem;">
                                    Seçilen Firma Adına Vitrine İlanı Ekle
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- KART 2: FİRMA ADINA TALEP OLUŞTUR (LİSTE TABANLI) -->
                <div class="content-card" style="padding: 24px; border-top: 4px solid #0284C7;">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
                        <h3 style="font-size: 1.10rem; font-weight: 700; color: var(--text-heading); display: flex; align-items: center; gap: 8px;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #0284C7;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                            <span>Firma Adına Talep Oluştur</span>
                        </h3>
                        <span class="badge badge-buyer" style="background: #E0F2FE; color: #0284C7; border: 1px solid #BAE6FD;">Çok Kalemli Talep Simülatörü</span>
                    </div>

                    <form asp-action="SimulateCreateRequest" method="post" id="simRequestForm" onsubmit="handleSimRequestSubmit(event); return false;">
                        @Html.AntiForgeryToken()
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            
                            <div class="form-field-grid" style="grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));">
                                <div class="form-field">
                                    <label class="form-label" for="simSenderComp">Talep Sahibi Firma *</label>
                                    <select id="simSenderComp" name="SenderCompanyID" class="form-select" required>
                                        <option value="">— Talep Açacak Firmayı Seçin —</option>
                                        @foreach (var comp in Model.Companies)
                                        {
                                            <option value="@comp.CompanyID">
                                                #@comp.CompanyID - @comp.CompanyName [Yetkili: @comp.CompanyOfficial]
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="form-field">
                                    <label class="form-label" for="simProdName">Talep Genel Başlığı / Proje Adı</label>
                                    <input type="text" id="simProdName" name="ProductName" class="form-input" placeholder="Örn: 2026 Q3 Fabrika Bakım Malzemeleri Alımı (Boş bırakılırsa kalemlerden türetilir)" />
                                </div>
                            </div>

                            <div class="form-field-grid" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
                                <div class="form-field">
                                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
                                        <label class="form-label" for="simReqType" style="margin-bottom: 0;">Talep Türü</label>
                                        <button type="button" id="btnToggleSimCustomReqType" onclick="toggleSimCustomRequestType()" style="background: transparent; border: none; font-size: 0.73rem; color: #0284C7; font-weight: 600; cursor: pointer; text-decoration: underline; padding: 0;">
                                            ✏️ Kendi Türünü Yaz
                                        </button>
                                    </div>
                                    <div id="simReqTypeSelectWrap">
                                        <select id="simReqType" name="RequestType" class="form-select" onchange="handleSimReqTypeSelect(this)">
                                            <optgroup label="Standart & Alım Türleri">
                                                <option value="Satın Alma" selected>Satın Alma (Doğrudan Temin)</option>
                                                <option value="Fiyat Araştırması (RFQ)">Fiyat Araştırması (RFQ / Teklif Toplama)</option>
                                                <option value="Açık İhale / Kapalı Zarf İhale">Açık İhale / Kapalı Zarf İhale</option>
                                            </optgroup>
                                            <optgroup label="Hammadde, Malzeme & İmalat">
                                                <option value="Hammadde & Yarı Mamul Tedariği">Hammadde & Yarı Mamul Tedariği</option>
                                                <option value="Fason Üretim & Talaşlı İmalat">Fason Üretim & Talaşlı İmalat</option>
                                                <option value="Sac İşleme, Lazer Kesim & Büküm">Sac İşleme, Lazer Kesim & Büküm</option>
                                                <option value="Plastik Enjeksiyon & Kalıp İmalatı">Plastik Enjeksiyon & Kalıp İmalatı</option>
                                                <option value="Kimyasal, Boya & Kaplama">Kimyasal, Boya & Kaplama</option>
                                                <option value="Döküm, Dövme & Metalurji">Döküm, Dövme & Metalurji</option>
                                                <option value="Tekstil, Kumaş & İş Kıyafetleri">Tekstil, Kumaş & İş Kıyafetleri</option>
                                                <option value="Gıda, İkram & Kurumsal Tüketim">Gıda, İkram & Kurumsal Tüketim</option>
                                            </optgroup>
                                            <optgroup label="Makine, Ekipman & Teknik Donanım">
                                                <option value="Makine & Endüstriyel Ekipman">Makine & Endüstriyel Ekipman</option>
                                                <option value="Yedek Parça & Sarf Malzeme">Yedek Parça & Sarf Malzeme</option>
                                                <option value="Otomasyon, Elektrik & Elektronik">Otomasyon, Elektrik & Elektronik</option>
                                                <option value="Hırdavat, Rulman & Bağlantı Elemanları">Hırdavat, Rulman & Bağlantı Elemanları</option>
                                                <option value="Hidrolik, Pnömatik & Vana Tesisatı">Hidrolik, Pnömatik & Vana Tesisatı</option>
                                            </optgroup>
                                            <optgroup label="Hizmet, Bakım, Lojistik & İnşaat">
                                                <option value="Hizmet Alımı & Taşeronluk">Hizmet Alımı & Taşeronluk</option>
                                                <option value="Bakım, Onarım & Teknik Servis">Bakım, Onarım & Teknik Servis</option>
