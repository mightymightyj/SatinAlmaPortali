        // --- TALEP SİMÜLASYONU KALEM YÖNETİMİ ---
        function addSimRequestItemRow(name = '', qty = 10, unit = 'Adet', price = null, desc = '') {
            const tbody = document.getElementById('simReqItemsTbody');
            if (!tbody) return;
            const rowCount = tbody.querySelectorAll('.sim-req-item-row').length + 1;
            const tr = document.createElement('tr');
            tr.className = 'sim-req-item-row';
            tr.innerHTML = `
                <td style="text-align: center; font-weight: 700; color: #64748B;">${rowCount}</td>
                <td><input type="text" class="sim-it-name form-input" style="padding: 5px 8px; font-size: 0.80rem;" placeholder="Örn: CNC Torna Parçası" value="${name}" required oninput="recalculateSimRequestTotals()" /></td>
                <td><input type="number" class="sim-it-qty form-input" style="padding: 5px 8px; font-size: 0.80rem; text-align: center;" min="1" value="${qty}" required oninput="recalculateSimRequestTotals()" /></td>
                <td>
                    <select class="sim-it-unit form-select" style="padding: 4px 6px; font-size: 0.78rem;">
                        <option value="Adet" ${unit === 'Adet' ? 'selected' : ''}>Adet</option>
                        <option value="Kg" ${unit === 'Kg' ? 'selected' : ''}>Kg</option>
                        <option value="Metre" ${unit === 'Metre' ? 'selected' : ''}>Metre</option>
                        <option value="Litre" ${unit === 'Litre' ? 'selected' : ''}>Litre</option>
                        <option value="Paket" ${unit === 'Paket' ? 'selected' : ''}>Paket</option>
                        <option value="Koli" ${unit === 'Koli' ? 'selected' : ''}>Koli</option>
                        <option value="Ton" ${unit === 'Ton' ? 'selected' : ''}>Ton</option>
                        <option value="Takım" ${unit === 'Takım' ? 'selected' : ''}>Takım</option>
                        <option value="Saat" ${unit === 'Saat' ? 'selected' : ''}>Saat</option>
                    </select>
                </td>
                <td><input type="number" step="0.01" class="sim-it-price form-input" style="padding: 5px 8px; font-size: 0.80rem; text-align: right;" placeholder="0,00" value="${price !== null ? price : ''}" oninput="recalculateSimRequestTotals()" /></td>
                <td><input type="text" class="sim-it-desc form-input" style="padding: 5px 8px; font-size: 0.80rem;" placeholder="Teknik şart / tolerans" value="${desc}" /></td>
                <td style="text-align: center;"><button type="button" onclick="removeSimRequestItemRow(this)" style="background: none; border: none; color: #EF4444; font-size: 1rem; cursor: pointer;" title="Kalemi Sil">×</button></td>
            `;
            tbody.appendChild(tr);
            reindexSimRequestRows();
