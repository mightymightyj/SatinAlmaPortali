@{
    ViewData["Title"] = "İletişim";
}

<!-- İLETİŞİM HERO SECTION -->
<section class="iletisim-hero">
    <div class="iletisim-hero-inner">
        <div class="iletisim-badge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span>İletişim</span>
        </div>
        <h1 class="iletisim-hero-title">Bize <span class="highlight-dot">Ulaşın</span></h1>
        <p class="iletisim-hero-desc">
            Sorularınız, önerileriniz veya iş birliği talepleriniz için ekibimizle iletişime geçin.
            Size en kısa sürede dönüş yapacağız.
        </p>
    </div>
</section>

<!-- İLETİŞİM FORM & BİLGİ SECTION -->
<section class="iletisim-section">
    <div class="iletisim-container">
        <div class="iletisim-grid">
            <!-- SOL: İletişim Formu -->
            <div class="iletisim-form-wrapper">
                <div class="iletisim-form-header">
                    <div class="section-icon-badge">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                    </div>
                    <h2>Mesaj Gönderin</h2>
                </div>
                <form class="iletisim-form">
                    <div class="iletisim-form-row">
                        <div class="iletisim-form-group">
                            <label for="adSoyad">Ad Soyad</label>
                            <input type="text" id="adSoyad" name="adSoyad" placeholder="Adınız ve soyadınız" required />
                        </div>
                        <div class="iletisim-form-group">
                            <label for="eposta">E-posta</label>
                            <input type="email" id="eposta" name="eposta" placeholder="ornek@sirket.com" required />
                        </div>
                    </div>
                    <div class="iletisim-form-row">
                        <div class="iletisim-form-group">
                            <label for="telefon">Telefon</label>
                            <input type="tel" id="telefon" name="telefon" placeholder="+90 (5XX) XXX XX XX" />
                        </div>
                        <div class="iletisim-form-group">
                            <label for="konu">Konu</label>
                            <select id="konu" name="konu" required>
                                <option value="" disabled selected>Bir konu seçiniz</option>
                                <option value="genel">Genel Bilgi</option>
                                <option value="destek">Teknik Destek</option>
                                <option value="satis">Satış & Fiyatlandırma</option>
                                <option value="isbirligi">İş Birliği Teklifi</option>
                                <option value="sikayet">Şikayet & Öneri</option>
                                <option value="diger">Diğer</option>
                            </select>
                        </div>
                    </div>
                    <div class="iletisim-form-group iletisim-form-group-full">
                        <label for="mesaj">Mesaj</label>
                        <textarea id="mesaj" name="mesaj" rows="6" placeholder="Mesajınızı buraya yazınız..." required></textarea>
                    </div>
                    <button type="submit" class="iletisim-submit-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="22" y1="2" x2="11" y2="13"></line>
                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                        </svg>
                        Mesajı Gönder
                    </button>
                </form>
            </div>

            <!-- SAĞ: İletişim Bilgileri -->
            <div class="iletisim-info-wrapper">
                <!-- Adres Kartı -->
                <div class="iletisim-info-card">
                    <div class="iletisim-info-icon iletisim-icon-blue">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                    </div>
                    <div class="iletisim-info-text">
                        <h4>Adres</h4>
                        <p>Maslak Mahallesi, Büyükdere Caddesi No:128<br/>Sarıyer, İstanbul 34398, Türkiye</p>
                    </div>
                </div>

                <!-- Telefon Kartı -->
                <div class="iletisim-info-card">
                    <div class="iletisim-info-icon iletisim-icon-green">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                    </div>
                    <div class="iletisim-info-text">
                        <h4>Telefon</h4>
                        <p>+90 (212) 555 00 00<br/>+90 (530) 555 00 00</p>
                    </div>
                </div>

                <!-- E-posta Kartı -->
                <div class="iletisim-info-card">
                    <div class="iletisim-info-icon iletisim-icon-purple">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                    </div>
                    <div class="iletisim-info-text">
                        <h4>E-posta</h4>
                        <p>info@tedarikportal.com<br/>destek@tedarikportal.com</p>
                    </div>
                </div>

                <!-- Çalışma Saatleri Kartı -->
                <div class="iletisim-info-card">
                    <div class="iletisim-info-icon iletisim-icon-orange">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                    <div class="iletisim-info-text">
                        <h4>Çalışma Saatleri</h4>
                        <p>Pazartesi - Cuma: 09:00 - 18:00<br/>Cumartesi: 10:00 - 14:00</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- HARİTA PLACEHOLDER SECTION -->
<section class="iletisim-section iletisim-section-alt">
    <div class="iletisim-container">
        <div class="iletisim-map-header">
            <div class="section-icon-badge">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                    <line x1="8" y1="2" x2="8" y2="18"></line>
                    <line x1="16" y1="6" x2="16" y2="22"></line>
                </svg>
            </div>
            <h2>Bizi Ziyaret Edin</h2>
        </div>
        <div class="iletisim-map-area">
            <div class="iletisim-map-pin">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>Tedarik Portalı Genel Merkez</span>
            </div>
            <div class="iletisim-map-grid-lines"></div>
        </div>
    </div>
</section>

<!-- SOSYAL MEDYA SECTION -->
<section class="iletisim-section">
    <div class="iletisim-container">
        <div class="iletisim-social-header">
            <h2>Sosyal Medyada Biz</h2>
            <p>Bizi sosyal medya hesaplarımızdan takip edin, güncel gelişmelerden haberdar olun.</p>
        </div>
        <div class="iletisim-social">
            <!-- LinkedIn -->
            <a href="#" class="iletisim-social-link iletisim-social-linkedin" title="LinkedIn">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                <span>LinkedIn</span>
            </a>
            <!-- Twitter/X -->
            <a href="#" class="iletisim-social-link iletisim-social-twitter" title="X (Twitter)">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
                <span>X (Twitter)</span>
            </a>
            <!-- Instagram -->
            <a href="#" class="iletisim-social-link iletisim-social-instagram" title="Instagram">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                </svg>
                <span>Instagram</span>
            </a>
            <!-- YouTube -->
            <a href="#" class="iletisim-social-link iletisim-social-youtube" title="YouTube">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
                <span>YouTube</span>
            </a>
        </div>
    </div>
</section>

<!-- İLETİŞİM CTA SECTION -->
<section class="iletisim-cta-section">
    <div class="iletisim-container">
        <div class="iletisim-cta-card">
            <div class="iletisim-cta-content">
                <h2>Hemen Başlayın</h2>
                <p>Tedarik süreçlerinizi dijitalleştirmek ve maliyetlerinizi optimize etmek için bugün ücretsiz hesap oluşturun.</p>
            </div>
            <a href="#" class="iletisim-cta-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14"></path>
                    <path d="M12 5l7 7-7 7"></path>
                </svg>
                Ücretsiz Kayıt Ol
            </a>
        </div>
    </div>
</section>
