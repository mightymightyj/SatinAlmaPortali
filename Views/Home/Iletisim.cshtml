@{
    ViewData["Title"] = "İletişim";
}

<!-- İLETİŞİM HERO SECTION -->
<section class="iletisim-hero">
    <div class="iletisim-hero-inner">
        <div class="iletisim-badge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span>İletişim</span>
        </div>
        <h1 class="iletisim-hero-title">Bize <span class="highlight-dot">Ulaşın</span></h1>
        <p class="iletisim-hero-desc">
            Sorularınız, önerileriniz veya iş birliği talepleriniz için ekibimizle iletişime geçin.
            Size en kısa sürede dönüş yapacağız.
        </p>
    </div>
</section>

<!-- İLETİŞİM FORM & BİLGİ SECTION -->
<section class="iletisim-section">
    <div class="iletisim-container">
        <div class="iletisim-grid">
            <!-- SOL: İletişim Formu -->
            <div class="iletisim-form-wrapper">
                <div class="iletisim-form-header">
                    <div class="section-icon-badge">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                    </div>
                    <h2>Mesaj Gönderin</h2>
                </div>

                @if (TempData["IletisimSuccess"] != null)
                {
                    <div class="profile-alert profile-alert-success" style="margin-bottom: 20px;">
                        <div class="alert-icon-box">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        </div>
                        <span>@TempData["IletisimSuccess"]</span>
                    </div>
                }

                @if (TempData["IletisimError"] != null)
                {
                    <div class="profile-alert profile-alert-error" style="margin-bottom: 20px;">
                        <div class="alert-icon-box">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                        </div>
                        <span>@TempData["IletisimError"]</span>
                    </div>
                }

                <form asp-controller="Home" asp-action="IletisimSubmit" method="post" class="iletisim-form">
                    @Html.AntiForgeryToken()
                    <div class="iletisim-form-row">
                        <div class="iletisim-form-group">
                            <label for="adSoyad">Ad Soyad</label>
                            <input type="text" id="adSoyad" name="adSoyad" placeholder="Adınız ve soyadınız" required />
                        </div>
                        <div class="iletisim-form-group">
                            <label for="eposta">E-posta</label>
                            <input type="email" id="eposta" name="eposta" placeholder="ornek@sirket.com" required />
                        </div>
                    </div>
                    <div class="iletisim-form-row">
                        <div class="iletisim-form-group">
                            <label for="telefon">Telefon</label>
                            <input type="tel" id="telefon" name="telefon" placeholder="0 (5XX) XXX XX XX" maxlength="17" autocomplete="tel" />
                        </div>
                        <div class="iletisim-form-group">
                            <label for="konu">Konu</label>
                            <select id="konu" name="konu" required>
                                <option value="" disabled selected>Bir konu seçiniz</option>
                                <option value="genel">Genel Bilgi</option>
                                <option value="destek">Teknik Destek</option>
                                <option value="satis">Satış & Fiyatlandırma</option>
                                <option value="isbirligi">İş Birliği Teklifi</option>
                                <option value="sikayet">Şikayet & Öneri</option>
                                <option value="diger">Diğer</option>
                            </select>
                        </div>
                    </div>
                    <div class="iletisim-form-group iletisim-form-group-full">
                        <label for="mesaj">Mesaj</label>
                        <textarea id="mesaj" name="mesaj" rows="6" placeholder="Mesajınızı buraya yazınız..." required></textarea>
                    </div>
                    <button type="submit" class="iletisim-submit-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="22" y1="2" x2="11" y2="13"></line>
                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                        </svg>
                        Mesajı Gönder
                    </button>
                </form>
            </div>

            <!-- SAĞ: İletişim Bilgileri -->
            <div class="iletisim-info-wrapper">
                <!-- Adres Kartı -->
                <div class="iletisim-info-card">
                    <div class="iletisim-info-icon iletisim-icon-blue">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                    </div>
                    <div class="iletisim-info-text">
                        <h4>Adres</h4>
                        <p>Maslak Mahallesi, Büyükdere Caddesi No:128<br/>Sarıyer, İstanbul 34398, Türkiye</p>
                    </div>
                </div>

                <!-- Telefon Kartı -->
                <div class="iletisim-info-card">
                    <div class="iletisim-info-icon iletisim-icon-green">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                    </div>
                    <div class="iletisim-info-text">
                        <h4>Telefon</h4>
                        <p>+90 (212) 555 00 00<br/>+90 (530) 555 00 00</p>
                    </div>
                </div>

                <!-- E-posta Kartı -->
                <div class="iletisim-info-card">
                    <div class="iletisim-info-icon iletisim-icon-purple">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                    </div>
                    <div class="iletisim-info-text">
                        <h4>E-posta</h4>
                        <p>info@tedarikportal.com<br/>destek@tedarikportal.com</p>
                    </div>
                </div>

                <!-- Çalışma Saatleri Kartı -->
                <div class="iletisim-info-card">
                    <div class="iletisim-info-icon iletisim-icon-orange">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                    <div class="iletisim-info-text">
                        <h4>Çalışma Saatleri</h4>
                        <p>Pazartesi - Cuma: 09:00 - 18:00<br/>Cumartesi: 10:00 - 14:00</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

