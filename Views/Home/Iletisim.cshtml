</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var phoneInput = document.getElementById("telefon");
            if (phoneInput) {
                phoneInput.addEventListener("input", function (e) {
                    var x = e.target.value.replace(/\D/g, ''); // Sadece rakamlar
                    
                    // En fazla 11 rakam (05XXXXXXXXX)
                    if (x.length > 11) {
                        x = x.substring(0, 11);
                    }

                    // Formatlama: 0 (5XX) XXX XX XX veya (5XX) XXX XX XX
                    if (x.startsWith("0")) {
                        if (x.length <= 1) {
                            e.target.value = x;
                        } else if (x.length <= 4) {
                            e.target.value = x.substring(0, 1) + " (" + x.substring(1);
                        } else if (x.length <= 7) {
                            e.target.value = x.substring(0, 1) + " (" + x.substring(1, 4) + ") " + x.substring(4);
                        } else if (x.length <= 9) {
                            e.target.value = x.substring(0, 1) + " (" + x.substring(1, 4) + ") " + x.substring(4, 7) + " " + x.substring(7);
                        } else {
                            e.target.value = x.substring(0, 1) + " (" + x.substring(1, 4) + ") " + x.substring(4, 7) + " " + x.substring(7, 9) + " " + x.substring(9, 11);
                        }
                    } else {
                        if (x.length === 0) {
                            e.target.value = "";
                        } else if (x.length <= 3) {
                            e.target.value = "(" + x;
                        } else if (x.length <= 6) {
                            e.target.value = "(" + x.substring(0, 3) + ") " + x.substring(3);
                        } else if (x.length <= 8) {
                            e.target.value = "(" + x.substring(0, 3) + ") " + x.substring(3, 6) + " " + x.substring(6);
                        } else {
                            e.target.value = "(" + x.substring(0, 3) + ") " + x.substring(3, 6) + " " + x.substring(6, 8) + " " + x.substring(8, 10);
                        }
                    }
                });

                phoneInput.addEventListener("keydown", function (e) {
                    if (!/[0-9]/.test(e.key) && 
                        !["Backspace", "Tab", "Delete", "ArrowLeft", "ArrowRight", "Home", "End"].includes(e.key) &&
                        !e.ctrlKey && !e.metaKey) {
                        e.preventDefault();
                    }
                });
            }
        });

        async function handleIletisimSubmit(event) {
            if (event) {
                if (typeof event.preventDefault === 'function') event.preventDefault();
                if (typeof event.stopPropagation === 'function') event.stopPropagation();
            }

            const form = event.target;
            const submitBtn = form.querySelector('.iletisim-submit-btn') || form.querySelector('button[type="submit"]');
            const originalText = submitBtn ? submitBtn.innerHTML : 'Mesajı Gönder';
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '⏳ Gönderiliyor...';
            }

            try {
                const formData = new FormData(form);
                const response = await fetch('/Home/IletisimSubmit', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    },
                    body: formData
                });

                const result = await response.json();
                if (result.success) {
                    form.reset();
                    if (typeof showRealtimeToast === 'function') {
                        showRealtimeToast('✓ ' + (result.message || 'Mesajınız başarıyla iletildi!'), 'success');
                    } else {
                        alert(result.message || 'Mesajınız başarıyla iletildi!');
                    }
                } else {
                    if (typeof showRealtimeToast === 'function') {
                        showRealtimeToast('Hata: ' + (result.message || 'Mesaj iletilemedi.'), 'error');
                    } else {
                        alert('Hata: ' + result.message);
                    }
                }
            } catch (err) {
                if (typeof showRealtimeToast === 'function') {
                    showRealtimeToast('Bağlantı hatası: ' + err.message, 'error');
                } else {
                    alert('Bağlantı hatası: ' + err.message);
                }
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            }
        }
    </script>
}