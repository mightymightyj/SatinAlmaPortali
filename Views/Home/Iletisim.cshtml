@{
    ViewData["Title"] = "İletişim";
}

@section Styles {
    <!-- Tailwind CSS (Play CDN) & Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e',
                            950: '#082f49',
                        }
                    }
                }
            }
        };
    </script>
    <style>
        html {
            scroll-behavior: smooth;
        }
    </style>
}

<div class="font-sans antialiased bg-slate-50 text-slate-800 selection:bg-blue-500 selection:text-white pb-20 sm:pb-24 lg:pb-12">

    <!-- ==================== BÖLÜM 1: HERO SECTION ==================== -->
    <section class="relative overflow-hidden bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 text-white pt-12 sm:pt-20 md:pt-24 pb-14 sm:pb-24 md:pb-28 px-4 sm:px-6 lg:px-8 border-b border-slate-800/80">
        <!-- Radial Glow Efekti -->
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(37,99,235,0.30),rgba(255,255,255,0))] pointer-events-none"></div>

        <div class="relative max-w-4xl mx-auto text-center">
            <!-- Rozet -->
            <div class="inline-flex items-center gap-2 px-3.5 sm:px-4 py-1.5 rounded-full text-xs font-semibold bg-blue-500/10 text-blue-400 border border-blue-500/20 mb-4 sm:mb-6 backdrop-blur-sm shadow-sm">
                <i class="fa-solid fa-headset text-blue-400 text-xs sm:text-sm"></i>
                <span>İletişim &amp; Müşteri Destek</span>
            </div>

            <!-- Ana Başlık -->
            <h1 class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.15]">
                Bizimle <br class="hidden sm:inline" />
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-sky-300 to-indigo-300">
                    İletişime Geçin
                </span>
            </h1>

            <!-- Açıklama Metni -->
            <p class="mt-4 sm:mt-6 text-sm sm:text-base md:text-lg text-slate-300 max-w-3xl mx-auto leading-relaxed font-normal">
                Sorularınız, kurumsal iş birliği önerileriniz veya teknik destek ihtiyaçlarınız için ekibimizle iletişime geçin. Talebiniz doğrultusunda en kısa sürede dönüş yapıyoruz.
            </p>

            <!-- Hızlı Gezinme Butonları -->
            <div class="mt-6 sm:mt-10 flex flex-wrap items-center justify-center gap-2 sm:gap-3">
                <a href="#form" class="inline-flex items-center gap-1.5 sm:gap-2 px-3.5 sm:px-5 py-2 sm:py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/30 transition-all hover:scale-[1.02]">
                    <i class="fa-solid fa-envelope text-[11px] sm:text-xs"></i>
                    <span>Mesaj Gönderin</span>
                </a>
                <a href="#bilgiler" class="inline-flex items-center gap-1.5 sm:gap-2 px-3.5 sm:px-5 py-2 sm:py-2.5 rounded-xl text-xs sm:text-sm font-medium bg-slate-800/80 hover:bg-slate-700/80 text-slate-200 border border-slate-700/80 hover:border-slate-600 transition-all hover:scale-[1.02]">
                    <i class="fa-solid fa-address-card text-[11px] sm:text-xs"></i>
                    <span>İletişim Bilgileri</span>
                </a>
                <a href="#harita" class="inline-flex items-center gap-1.5 sm:gap-2 px-3.5 sm:px-5 py-2 sm:py-2.5 rounded-xl text-xs sm:text-sm font-medium bg-slate-800/80 hover:bg-slate-700/80 text-slate-200 border border-slate-700/80 hover:border-slate-600 transition-all hover:scale-[1.02]">
                    <i class="fa-solid fa-map-location-dot text-[11px] sm:text-xs"></i>
                    <span>Konum &amp; Harita</span>
                </a>
                <a href="#sosyal" class="inline-flex items-center gap-1.5 sm:gap-2 px-3.5 sm:px-5 py-2 sm:py-2.5 rounded-xl text-xs sm:text-sm font-medium bg-slate-800/80 hover:bg-slate-700/80 text-slate-200 border border-slate-700/80 hover:border-slate-600 transition-all hover:scale-[1.02]">
                    <i class="fa-solid fa-share-nodes text-[11px] sm:text-xs"></i>
                    <span>Sosyal Ağlar</span>
                </a>
            </div>
        </div>
    </section>

    <!-- ==================== BÖLÜM 2: FORM & İLETİŞİM BİLGİLERİ ==================== -->
    <section id="form" class="py-10 sm:py-16 md:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
            
            <!-- SOL: İletişim Formu (7 Sütun) -->
            <div class="lg:col-span-7 bg-white rounded-2xl sm:rounded-3xl p-5 sm:p-8 md:p-12 border border-slate-200/90 shadow-sm hover:shadow-md transition-all">
                <div class="mb-6 sm:mb-8">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200 mb-2 sm:mb-3">
                        <i class="fa-solid fa-paper-plane text-blue-600 text-xs"></i>
                        <span>Doğrudan Mesaj</span>
                    </div>
                    <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">
                        Bize Mesaj Gönderin
                    </h2>
                    <p class="mt-2 text-xs sm:text-sm text-slate-500 font-normal">
                        Aşağıdaki formu doldurarak ilgili departmanımıza anında mesaj iletebilirsiniz.
                    </p>
                </div>

                @if (TempData["IletisimSuccess"] != null)
                {
                    <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium flex items-center gap-3">
                        <i class="fa-solid fa-circle-check text-emerald-600 text-lg shrink-0"></i>
                        <span>@TempData["IletisimSuccess"]</span>
                    </div>
                }

                @if (TempData["IletisimError"] != null)
                {
                    <div class="mb-6 p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-medium flex items-center gap-3">
                        <i class="fa-solid fa-circle-xmark text-rose-600 text-lg shrink-0"></i>
                        <span>@TempData["IletisimError"]</span>
                    </div>
                }

                <form asp-controller="Home" asp-action="IletisimSubmit" method="post" class="space-y-4 sm:space-y-5" onsubmit="handleIletisimSubmit(event); return false;">
                    @Html.AntiForgeryToken()
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
                        <div>
                            <label for="adSoyad" class="block text-xs font-bold text-slate-700 mb-1.5">Ad Soyad *</label>
                            <input type="text" id="adSoyad" name="adSoyad" placeholder="Adınız ve soyadınız" required class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none text-slate-900 text-sm transition-all placeholder:text-slate-400 bg-slate-50/50 focus:bg-white" />
                        </div>
                        <div>
                            <label for="eposta" class="block text-xs font-bold text-slate-700 mb-1.5">E-posta Adresi *</label>
                            <input type="email" id="eposta" name="eposta" placeholder="ornek@sirket.com" required class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none text-slate-900 text-sm transition-all placeholder:text-slate-400 bg-slate-50/50 focus:bg-white" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
                        <div>
                            <label for="telefon" class="block text-xs font-bold text-slate-700 mb-1.5">Telefon Numarası</label>
                            <input type="tel" id="telefon" name="telefon" placeholder="0 (5XX) XXX XX XX" maxlength="17" autocomplete="tel" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none text-slate-900 text-sm transition-all placeholder:text-slate-400 bg-slate-50/50 focus:bg-white" />
                        </div>
                        <div>
                            <label for="konu" class="block text-xs font-bold text-slate-700 mb-1.5">İletişim Konusu *</label>
                            <select id="konu" name="konu" required class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none text-slate-900 text-sm transition-all bg-slate-50/50 focus:bg-white">
                                <option value="" disabled selected>Bir konu seçiniz</option>
                                <option value="genel">Genel Bilgi</option>
                                <option value="destek">Teknik Destek</option>
                                <option value="satis">Satış &amp; Fiyatlandırma</option>
                                <option value="isbirligi">İş Birliği Teklifi</option>
                                <option value="sikayet">Şikayet &amp; Öneri</option>
                                <option value="diger">Diğer</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label for="mesaj" class="block text-xs font-bold text-slate-700 mb-1.5">Mesajınız *</label>
                        <textarea id="mesaj" name="mesaj" rows="5" placeholder="Talebinizi, sorunuzu veya önerinizi buraya yazınız..." required class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none text-slate-900 text-sm transition-all placeholder:text-slate-400 bg-slate-50/50 focus:bg-white resize-y"></textarea>
                    </div>

                    <div>
                        <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl text-sm font-bold bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/30 transition-all hover:scale-[1.02] cursor-pointer iletisim-submit-btn">
                            <i class="fa-solid fa-paper-plane text-xs"></i>
                            <span>Mesajı Gönder</span>
                        </button>
                    </div>
                </form>
            </div>

            <!-- SAĞ: İletişim Bilgileri (5 Sütun) -->
            <div id="bilgiler" class="lg:col-span-5 space-y-4 sm:space-y-5">
                
                <!-- Adres Kartı -->
                <div class="bg-white rounded-2xl sm:rounded-3xl p-5 sm:p-7 border border-slate-200/90 shadow-sm hover:shadow-md hover:border-blue-300 transition-all flex items-start gap-4 sm:gap-5">
                    <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center shrink-0 shadow-xs">
                        <i class="fa-solid fa-location-dot text-xl sm:text-2xl"></i>
                    </div>
                    <div>
                        <h4 class="text-sm sm:text-base font-bold text-slate-900 mb-1">Genel Merkez Adresi</h4>
                        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                            Maslak Mahallesi, Büyükdere Caddesi No:128<br />
                            Sarıyer, İstanbul 34398, Türkiye
                        </p>
                    </div>
                </div>

                <!-- Telefon Kartı -->
                <div class="bg-white rounded-2xl sm:rounded-3xl p-5 sm:p-7 border border-slate-200/90 shadow-sm hover:shadow-md hover:border-emerald-300 transition-all flex items-start gap-4 sm:gap-5">
                    <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-emerald-50 border border-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 shadow-xs">
                        <i class="fa-solid fa-phone-volume text-xl sm:text-2xl"></i>
                    </div>
                    <div>
                        <h4 class="text-sm sm:text-base font-bold text-slate-900 mb-1">Müşteri Hizmetleri</h4>
                        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                            <a href="tel:+902125550000" class="hover:text-blue-600 font-semibold text-slate-800">+90 (212) 555 00 00</a><br />
                            <a href="tel:+905305550000" class="hover:text-blue-600 text-slate-600">+90 (530) 555 00 00</a>
                        </p>
                    </div>
                </div>

                <!-- E-posta Kartı -->
                <div class="bg-white rounded-2xl sm:rounded-3xl p-5 sm:p-7 border border-slate-200/90 shadow-sm hover:shadow-md hover:border-purple-300 transition-all flex items-start gap-4 sm:gap-5">
                    <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-purple-50 border border-purple-100 text-purple-600 flex items-center justify-center shrink-0 shadow-xs">
                        <i class="fa-solid fa-envelope-open-text text-xl sm:text-2xl"></i>
                    </div>
                    <div>
                        <h4 class="text-sm sm:text-base font-bold text-slate-900 mb-1">E-posta Kanalları</h4>
                        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                            <a href="mailto:info@tedarikportal.com" class="hover:text-blue-600 font-semibold text-slate-800">info@tedarikportal.com</a><br />
                            <a href="mailto:destek@tedarikportal.com" class="hover:text-blue-600 text-slate-600">destek@tedarikportal.com</a>
                        </p>
                    </div>
                </div>

                <!-- Çalışma Saatleri Kartı -->
                <div class="bg-white rounded-2xl sm:rounded-3xl p-5 sm:p-7 border border-slate-200/90 shadow-sm hover:shadow-md hover:border-amber-300 transition-all flex items-start gap-4 sm:gap-5">
                    <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-amber-50 border border-amber-100 text-amber-600 flex items-center justify-center shrink-0 shadow-xs">
                        <i class="fa-solid fa-clock text-xl sm:text-2xl"></i>
                    </div>
                    <div>
                        <h4 class="text-sm sm:text-base font-bold text-slate-900 mb-1">Çalışma Saatleri</h4>
                        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                            <span class="font-medium text-slate-800">Pazartesi - Cuma:</span> 09:00 - 18:00<br />
                            <span class="font-medium text-slate-800">Cumartesi:</span> 10:00 - 14:00 (Nöbetçi Ekip)
                        </p>
                    </div>
                </div>

            </div>

        </div>
    </section>

    <!-- ==================== BÖLÜM 3: HARİTA & KONUM ==================== -->
    <section id="harita" class="py-12 sm:py-20 md:py-24 px-4 sm:px-6 lg:px-8 bg-slate-100/70 border-y border-slate-200/80">
        <div class="max-w-7xl mx-auto">
            <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200 mb-2 sm:mb-3">
                    <i class="fa-solid fa-map-pin text-indigo-600 text-xs"></i>
                    <span>Ofisimiz</span>
                </div>
                <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
                    Bizi Ziyaret Edin
                </h2>
                <p class="mt-3 sm:mt-4 text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed font-normal">
                    İstanbul'un finans ve teknoloji merkezi Maslak'taki merkez ofisimizde sizleri ağırlamaktan memnuniyet duyarız.
                </p>
            </div>

            <div class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 shadow-sm overflow-hidden p-4 sm:p-6 md:p-8">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 sm:pb-6 border-b border-slate-100 mb-4 sm:mb-6">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                            <i class="fa-solid fa-building text-base"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-slate-900 text-sm sm:text-base">Tedarik Portalı Genel Merkez</h4>
                            <p class="text-xs text-slate-500">Maslak Mah. Büyükdere Cad. No:128 Sarıyer / İstanbul</p>
                        </div>
                    </div>
                    <a href="https://maps.google.com" target="_blank" class="w-full sm:w-auto justify-center inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold text-blue-700 bg-blue-50 hover:bg-blue-600 hover:text-white transition-all shrink-0">
                        <span>Google Haritalar'da Aç</span>
                        <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                    </a>
                </div>

                <!-- Modern Stilize Harita Alanı -->
                <div class="relative h-64 sm:h-80 md:h-96 rounded-xl sm:rounded-2xl bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 overflow-hidden flex items-center justify-center border border-slate-800 shadow-inner group">
                    <!-- Izgara Çizgileri -->
                    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b_1px,transparent_1px),linear-gradient(to_bottom,#1e293b_1px,transparent_1px)] bg-[size:3rem_3rem] sm:bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)] opacity-40"></div>
                    
                    <!-- Parlama ve Radar Efekti -->
                    <div class="absolute w-56 sm:w-72 h-56 sm:h-72 rounded-full bg-blue-600/20 blur-2xl pointer-events-none"></div>

                    <!-- Merkez İğne (Pin) -->
                    <div class="relative z-10 text-center flex flex-col items-center px-4">
                        <div class="relative flex items-center justify-center mb-3">
                            <span class="animate-ping absolute inline-flex h-10 sm:h-12 w-10 sm:w-12 rounded-full bg-blue-400 opacity-75"></span>
                            <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-blue-600 text-white flex items-center justify-center text-xl sm:text-2xl shadow-xl shadow-blue-600/50 border-2 border-blue-300">
                                <i class="fa-solid fa-location-dot"></i>
                            </div>
                        </div>
                        <h4 class="text-white font-black text-base sm:text-lg tracking-wide">Tedarik Portalı Genel Merkez</h4>
                        <p class="text-slate-400 text-xs mt-1">41°06'35.2"N 29°01'18.8"E &bull; Maslak, İstanbul</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== BÖLÜM 4: SOSYAL MEDYADA BİZ ==================== -->
    <section id="sosyal" class="py-12 sm:py-20 md:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-sky-50 text-sky-700 border border-sky-200 mb-2 sm:mb-3">
                <i class="fa-solid fa-share-nodes text-sky-600 text-xs"></i>
                <span>Topluluk</span>
            </div>
            <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
                Sosyal Medyada Biz
            </h2>
            <p class="mt-3 sm:mt-4 text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed font-normal">
                Bizi sosyal medya hesaplarımızdan takip edin, en güncel bültenlerden, sektör analizlerinden ve duyurulardan haberdar olun.
            </p>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 lg:gap-6 max-w-5xl mx-auto">
            <!-- LinkedIn -->
            <a href="https://linkedin.com" target="_blank" class="bg-white rounded-xl sm:rounded-2xl p-4 sm:p-6 border border-slate-200/90 shadow-sm hover:shadow-xl hover:border-blue-500/40 transition-all flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-3 sm:gap-4 group">
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center text-xl sm:text-2xl group-hover:scale-110 transition-transform shrink-0">
                    <i class="fa-brands fa-linkedin-in"></i>
                </div>
                <div>
                    <h4 class="font-bold text-slate-900 text-xs sm:text-sm group-hover:text-blue-600 transition-colors">LinkedIn</h4>
                    <p class="text-[11px] sm:text-xs text-slate-500">Kurumsal Ağımız</p>
                </div>
            </a>

            <!-- X / Twitter -->
            <a href="https://twitter.com" target="_blank" class="bg-white rounded-xl sm:rounded-2xl p-4 sm:p-6 border border-slate-200/90 shadow-sm hover:shadow-xl hover:border-slate-400 transition-all flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-3 sm:gap-4 group">
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-slate-100 text-slate-900 flex items-center justify-center text-xl sm:text-2xl group-hover:scale-110 transition-transform shrink-0">
                    <i class="fa-brands fa-x-twitter"></i>
                </div>
                <div>
                    <h4 class="font-bold text-slate-900 text-xs sm:text-sm group-hover:text-slate-700 transition-colors">X (Twitter)</h4>
                    <p class="text-[11px] sm:text-xs text-slate-500">Güncel Duyurular</p>
                </div>
            </a>

            <!-- Instagram -->
            <a href="https://instagram.com" target="_blank" class="bg-white rounded-xl sm:rounded-2xl p-4 sm:p-6 border border-slate-200/90 shadow-sm hover:shadow-xl hover:border-pink-500/40 transition-all flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-3 sm:gap-4 group">
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-pink-50 text-pink-600 flex items-center justify-center text-xl sm:text-2xl group-hover:scale-110 transition-transform shrink-0">
                    <i class="fa-brands fa-instagram"></i>
                </div>
                <div>
                    <h4 class="font-bold text-slate-900 text-xs sm:text-sm group-hover:text-pink-600 transition-colors">Instagram</h4>
                    <p class="text-[11px] sm:text-xs text-slate-500">Kamera Arkası</p>
                </div>
            </a>

            <!-- YouTube -->
