@section Scripts {
    <script src="~/js/trendyol-vitrin.js" asp-append-version="true"></script>
    <script>
        function openMobileCategoryModal() {
            var modal = document.getElementById('mobileCategoryModal');
            if (!modal) {
                window.location.href = '/?openCategories=1';
                return;
            }
            modal.style.display = 'flex';
            modal.style.opacity = '1';
            modal.style.pointerEvents = 'auto';
            modal.classList.add('show', 'is-open');
            document.body.classList.add('mobile-nav-locked');

            var searchInput = document.getElementById('mobileCatModalSearchInput');
            if (searchInput) {
                searchInput.value = '';
                filterMobileModalCategories('');
            }
        }

        function closeMobileCategoryModal() {
            var modal = document.getElementById('mobileCategoryModal');
            if (modal) {
                modal.style.display = 'none';
                modal.style.opacity = '0';
                modal.style.pointerEvents = 'none';
                modal.classList.remove('show', 'is-open');
            }
            document.body.classList.remove('mobile-nav-locked');
        }

        function toggleMobileCatModalBranch(btn, branchId) {
            var branch = document.getElementById(branchId);
            if (!branch) return;
            var isHidden = branch.classList.contains('hidden');
            if (isHidden) {
                branch.classList.remove('hidden');
                if (btn) {
                    var svg = btn.querySelector('svg');
                    if (svg) svg.style.transform = 'rotate(180deg)';
                }
            } else {
                branch.classList.add('hidden');
                if (btn) {
                    var svg = btn.querySelector('svg');
                    if (svg) svg.style.transform = 'rotate(0deg)';
                }
            }
        }

        function selectMobileCatItem(catId, catName, catPath) {
            if (typeof selectVitrinCategory === 'function') {
                selectVitrinCategory(catId, catName, catPath);
            }
            closeMobileCategoryModal();
            var vitrin = document.getElementById('vitrinContainer');
            if (vitrin) {
                vitrin.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        function filterMobileModalCategories(query) {
            var q = (query || '').toLowerCase().trim();
            var items = document.querySelectorAll('#mobileCategoryModalList .mob-cat-item-wrap');
            if (!q) {
                items.forEach(function(item) {
                    item.style.display = '';
                });
                return;
            }

            items.forEach(function(item) {
                var name = (item.getAttribute('data-cat-name') || '').toLowerCase();
                var path = (item.getAttribute('data-cat-path') || '').toLowerCase();
                if (name.indexOf(q) !== -1 || path.indexOf(q) !== -1) {
                    item.style.display = '';
                    var parentBranch = item.closest('.mob-children-wrap');
                    while (parentBranch) {
                        parentBranch.classList.remove('hidden');
                        parentBranch = parentBranch.parentElement ? parentBranch.parentElement.closest('.mob-children-wrap') : null;
                    }
                } else {
                    var hasMatchingChild = item.querySelector('.mob-cat-item-wrap[data-cat-name*="' + q + '"]');
                    if (hasMatchingChild) {
                        item.style.display = '';
                    } else {
                        item.style.display = 'none';
                    }
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            try {
                var params = new URLSearchParams(window.location.search);
                if (params.get('openCategories') === '1') {
                    setTimeout(function() {
                        openMobileCategoryModal();
                    }, 250);
                }
            } catch (e) {}
        });
    </script>
}

