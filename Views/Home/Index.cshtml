                        </div>
                    </div>
                </div>

                <div>
                    <label class="flex justify-between items-center text-xs font-bold text-slate-700 mb-1" for="checkoutDeliveryAddress">
                        <span>Fabrika / Depo / Şantiye Açık Adresi *</span>
                        <span class="text-rose-500 font-semibold text-[10px]">Zorunlu</span>
                    </label>
                    <textarea id="checkoutDeliveryAddress" rows="2" class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-medium" placeholder="Fabrika No, Blok, Mal Kabul Girişi veya Şantiye Adresi..." required></textarea>
                </div>
            </div>

            <!-- Adım 3: Kurumsal Ödeme Yöntemi -->
            <div class="rounded-xl border border-slate-200 bg-slate-50/50 p-4 sm:p-5">
