                    <input type="text" id="checkoutBuyerCompany" class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-medium" placeholder="Örn: Aselsan A.Ş. / Ege Kimya San. Tic. Ltd. Şti." required />
