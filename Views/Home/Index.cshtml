@{
    ViewData["Title"] = "Ana Sayfa - B2B Kurumsal Tedarik Portalı";
}

@functions {
    public static Microsoft.AspNetCore.Html.IHtmlContent RenderSuperAdminTree(satinalmaportali2.Controllers.HierarchicalCategoryItem node, int level)
    {
        var hasChildren = node.Children != null && node.Children.Count > 0;
        var indent = level * 16;
        var icon = level == 0 ? "📁" : level == 1 ? "📂" : level == 2 ? "🏷️" : "🔹";
        var encodedName = System.Net.WebUtility.HtmlEncode(node.CategoryName ?? "");
        var encodedPath = System.Net.WebUtility.HtmlEncode(node.BreadcrumbPath ?? "");
        var safeJsName = (node.CategoryName ?? "").Replace("'", "\\'");
        var safeJsPath = (node.BreadcrumbPath ?? "").Replace("'", "\\'");

        var sb = new System.Text.StringBuilder();
        sb.Append($"<div class=\"cat-tree-node level-{Math.Min(level, 3)}\" data-cat-id=\"{node.CategoryID}\" data-cat-name=\"{encodedName.ToLowerInvariant()}\" data-cat-path=\"{encodedPath}\" style=\"margin-left: {indent}px;\">");
        sb.Append($"<div class=\"cat-node-row {(level == 0 ? "is-root" : "")}\" onclick=\"selectCatFromTree({node.CategoryID}, '{safeJsName}', '{safeJsPath}')\" title=\"'{encodedPath}' kategorisini seç\">");
        sb.Append("<div class=\"cat-node-left\">");

        if (hasChildren)
        {
            sb.Append($"<button type=\"button\" class=\"cat-toggle-btn\" onclick=\"event.stopPropagation(); toggleCatTreeBranch(this, 'picker-branch-{node.CategoryID}')\" title=\"Genişlet / Daralt\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" class=\"toggle-icon\"><polyline points=\"6 9 12 15 18 9\"></polyline></svg></button>");
        }
        else
        {
            sb.Append($"<span class=\"cat-tree-bullet\">{(level == 0 ? "📁" : "↳")}</span>");
        }

        sb.Append($"<span class=\"cat-node-icon\">{icon}</span>");
        sb.Append($"<span class=\"cat-node-title\">{encodedName}</span>");
        sb.Append($"<span class=\"cat-node-id\">#{node.CategoryID}</span>");

        if (hasChildren)
        {
            sb.Append($"<span class=\"cat-node-count\">{node.Children!.Count} alt</span>");
        }

        sb.Append("</div>");
        sb.Append($"<button type=\"button\" class=\"btn-compact-select\" onclick=\"event.stopPropagation(); selectCatFromTree({node.CategoryID}, '{safeJsName}', '{safeJsPath}')\">Seç</button>");
        sb.Append("</div>");

        if (hasChildren && node.Children != null)
        {
            sb.Append($"<div class=\"cat-children-wrap\" id=\"picker-branch-{node.CategoryID}\">");
            foreach (var child in node.Children)
            {
                sb.Append(RenderSuperAdminTree(child, level + 1).ToString());
            }
            sb.Append("</div>");
        }

        sb.Append("</div>");
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }
}

