                    <svg class="w-3.5 h-3.5 text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <polyline points="23 4 23 10 17 10"></polyline>
                        <polyline points="1 20 1 14 7 14"></polyline>
                        <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                    </svg>
                    <span>Farklı İlanlar</span>
                </button>

                <!-- Tedarikçi Olarak İlan Ver Butonu -->
                <button type="button" class="col-span-2 sm:col-span-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold shadow-sm shadow-emerald-600/20 transition-all hover:-translate-y-0.5 active:scale-95" onclick="openSellerOfferModal()" title="Kurumsal satıcı olarak ürünlerinizi listelemek için tıklayın">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="16"></line>
                        <line x1="8" y1="12" x2="16" y2="12"></line>
                    </svg>
                    <span>Tedarikçi Olarak İlan Ver</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ==================== B2B KURUMSAL KATEGORİ AĞACI VE VİTRİN KONTROLLERİ ==================== -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6 hidden md:block">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden" id="vitrinCategoryTreeBar">
            <!-- Kompakt Bar Başlığı / Tetikleyici -->
            <div class="p-4 sm:px-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 cursor-pointer hover:bg-slate-50/80 transition-colors select-none" onclick="toggleVitrinCatTreePanel()">
                <div class="flex items-center gap-3.5 min-w-0">
                    <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 border border-blue-100 flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                            <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                        </svg>
                    </div>
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="text-sm font-bold text-slate-900">Kategori Ağacı ile Filtrele</span>
                            <span id="vitrinActiveCatBadge" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-800 border border-blue-200">
                                <span id="vitrinActiveCatName">Tüm Kategoriler</span>
                            </span>
                        </div>
                        <div class="text-xs text-slate-500 mt-0.5 truncate" id="vitrinCatSummaryText">
                            Hiyerarşik kurumsal kategori sistemimizden seçim yaparak ürünleri anlık filtreleyin.
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
                    <button type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-200 transition-colors" id="btnClearVitrinCatFilter" style="display: none;" onclick="event.stopPropagation(); clearVitrinCategoryFilter();" title="Kategori Filtresini Temizle">
                        <span>✕</span>
                        <span>Temizle</span>
                    </button>
                    <button type="button" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 transition-all" id="btnToggleVitrinTree">
                        <span id="vitrinToggleText">Kategori Ağacını Aç</span>
                        <svg class="w-3.5 h-3.5 text-slate-500 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" id="vitrinTreeChevron">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Açılır / Kapanır Kategori Ağacı Gövdesi (Varsayılan olarak kapalı) -->
            <div class="border-t border-slate-200 p-4 sm:p-6 bg-slate-50/50" id="vitrinCatTreeCollapse" style="display: none;">
                <!-- Canlı Arama ve Hızlı Araçlar -->
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 mb-4">
                    <div class="relative flex-1 max-w-md bg-white border border-slate-200 rounded-xl shadow-sm focus-within:ring-2 focus-within:ring-blue-500/20 focus-within:border-blue-500 transition-all">
                        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input type="text" id="vitrinCatSearchInput" 
                               placeholder="Kategori veya alt dal ara (örn: Cıvata, Paslanmaz, PLC, Şalt...)" 
                               class="w-full pl-9 pr-8 py-2 text-xs bg-transparent outline-none text-slate-800 placeholder-slate-400 font-medium" 
                               oninput="filterVitrinTreeNodes(this.value)" />
                        <button type="button" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-xs text-slate-400 hover:text-slate-600 font-bold" onclick="document.getElementById('vitrinCatSearchInput').value=''; filterVitrinTreeNodes('');" title="Aramayı Temizle">✕</button>
                    </div>

                    <div class="flex items-center gap-2 shrink-0">
                        <button type="button" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 shadow-sm transition-all" onclick="expandAllVitrinTree()">
                            <svg class="w-3.5 h-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="7 13 12 18 17 13"></polyline><polyline points="7 6 12 11 17 6"></polyline></svg>
                            <span>Tümünü Aç</span>
                        </button>
                        <button type="button" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 shadow-sm transition-all" onclick="collapseAllVitrinTree()">
                            <svg class="w-3.5 h-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="17 11 12 6 7 11"></polyline><polyline points="17 18 12 13 7 18"></polyline></svg>
                            <span>Daralt</span>
                        </button>
                    </div>
                </div>

                <!-- Hiyerarşik Ağaç Listesi -->
                <div class="max-h-72 overflow-y-auto rounded-xl border border-slate-200 bg-white p-3 space-y-1" id="vitrinCategoryTreeList">
                    <!-- 'Tüm Kategoriler' Kök Düğümü -->
                    <div class="cat-tree-node level-0 is-all-node" data-cat-id="0" data-cat-name="tüm kategoriler" data-cat-path="">
                        <div class="cat-node-row is-root is-selected" id="vitrinNodeRow-0" onclick="selectVitrinCategory(0, 'Tüm Kategoriler', '')">
                            <div class="cat-node-left">
                                <span class="cat-tree-bullet">•</span>
                                <span class="cat-node-title font-bold text-blue-600">Tüm Kategoriler</span>
                            </div>
                        </div>
                    </div>

                    <!-- Veritabanından Gelen Hiyerarşik Kategori Ağacı -->
                    @if (ViewBag.CategoryTree != null && ((IEnumerable<satinalmaportali2.Controllers.HierarchicalCategoryItem>)ViewBag.CategoryTree).Any())
                    {
                        var rootCategories = (IEnumerable<satinalmaportali2.Controllers.HierarchicalCategoryItem>)ViewBag.CategoryTree;
                        foreach (var root in rootCategories)
                        {
                            @RenderVitrinCategoryTree(root, 0)
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Canlı Arama ve Sıralama Çubuğu -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6">
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
            <div class="relative flex-1 max-w-lg bg-white border border-slate-200 rounded-xl shadow-sm focus-within:ring-2 focus-within:ring-blue-500/20 focus-within:border-blue-500 transition-all">
                <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" id="vitrinSearchInput" 
                       placeholder="Ürün adı, marka, SKU veya firma ara..." 
                       class="w-full pl-10 pr-4 py-2.5 text-xs sm:text-sm bg-transparent outline-none text-slate-800 placeholder-slate-400 font-medium" />
            </div>

            <div class="flex items-center justify-between sm:justify-end gap-2.5 w-full sm:w-auto shrink-0">
                <span id="vitrinProductCount" class="inline-flex items-center px-3 py-2 rounded-xl text-xs font-bold bg-slate-100 text-slate-600 border border-slate-200 shadow-sm whitespace-nowrap">
                    Yükleniyor...
                </span>

                <select id="vitrinSortSelect" class="flex-1 sm:flex-none px-3 py-2 sm:px-3.5 rounded-xl text-xs font-bold bg-white border border-slate-200 text-slate-700 outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-sm transition-all cursor-pointer" title="Sıralama Seçeneği">
                    <option value="recommended">Öne Çıkanlar</option>
                    <option value="score">Tedarikçi Puanı (Yüksek)</option>
                    <option value="discount">En Yüksek İskonto</option>
                    <option value="price-asc">Fiyata Göre (Artan)</option>
                    <option value="price-desc">Fiyata Göre (Azalan)</option>
                </select>
            </div>
        </div>
    </div>

    <!-- 6 Sütun x 8 Satır Profesyonel B2B Ürün Matrisi (48 Ürün) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="b2b-product-grid" id="trendyolProductGrid">
            <!-- JavaScript (trendyol-vitrin.js) ile dinamik olarak doldurulacaktır -->
        </div>
    </div>
</section>

<!-- ==================== BÖLÜM 3: TAILWIND PLATFORM İSTATİSTİKLERİ ==================== -->
<section class="bg-slate-900 border-t border-slate-800 py-16 text-white relative overflow-hidden">
    <!-- Subtle glow background -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_0%,rgba(37,99,235,0.15),transparent)] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
        <div class="text-center max-w-2xl mx-auto mb-12">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-500/10 text-blue-400 border border-blue-500/20 mb-3 backdrop-blur-sm">
                <span>PLATFORM METRİKLERİ</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-white">
                Rakamlarla B2B Satınalma Ağı
            </h2>
            <p class="mt-2 text-sm text-slate-400 font-normal">
                Türkiye genelinde güvenilir ticaretin ve sanayi tedariğinin şeffaf göstergeleri.
            </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 lg:gap-6">

            <!-- Stat Card 1 -->
            <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 text-center backdrop-blur-sm hover:border-blue-500/40 hover:bg-slate-800 transition-all duration-200 group">
                <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-blue-500/10 text-blue-400 border border-blue-500/20 flex items-center justify-center group-hover:scale-110 group-hover:bg-blue-600 group-hover:text-white transition-all duration-200">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                    </svg>
                </div>
                <div class="text-3xl lg:text-4xl font-black tracking-tight text-white mb-1.5">@(ViewBag.TotalBuyers ?? 0)</div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Kayıtlı Alıcı Firma</div>
            </div>

            <!-- Stat Card 2 -->
            <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 text-center backdrop-blur-sm hover:border-emerald-500/40 hover:bg-slate-800 transition-all duration-200 group">
                <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center justify-center group-hover:scale-110 group-hover:bg-emerald-600 group-hover:text-white transition-all duration-200">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="8" y1="6" x2="21" y2="6"></line>
                        <line x1="8" y1="12" x2="21" y2="12"></line>
                        <line x1="8" y1="18" x2="21" y2="18"></line>
                        <line x1="3" y1="6" x2="3.01" y2="6"></line>
                        <line x1="3" y1="12" x2="3.01" y2="12"></line>
                        <line x1="3" y1="18" x2="3.01" y2="18"></line>
                    </svg>
                </div>
                <div class="text-3xl lg:text-4xl font-black tracking-tight text-white mb-1.5">@(ViewBag.TotalSuppliers ?? 0)</div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Onaylı Sanayi Tedarikçisi</div>
            </div>

            <!-- Stat Card 3 -->
            <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 text-center backdrop-blur-sm hover:border-amber-500/40 hover:bg-slate-800 transition-all duration-200 group">
                <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-amber-500/10 text-amber-400 border border-amber-500/20 flex items-center justify-center group-hover:scale-110 group-hover:bg-amber-600 group-hover:text-white transition-all duration-200">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                </div>
                <div class="text-3xl lg:text-4xl font-black tracking-tight text-white mb-1.5">@(ViewBag.OpenRequestsCount ?? 0)</div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Açık Satınalma İhalesi</div>
            </div>

            <!-- Stat Card 4 -->
            <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 text-center backdrop-blur-sm hover:border-purple-500/40 hover:bg-slate-800 transition-all duration-200 group">
                <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-purple-500/10 text-purple-400 border border-purple-500/20 flex items-center justify-center group-hover:scale-110 group-hover:bg-purple-600 group-hover:text-white transition-all duration-200">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                </div>
                <div class="text-3xl lg:text-4xl font-black tracking-tight text-white mb-1.5">@(ViewBag.CompletedOffersCount ?? 0)</div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Tamamlanan Kurumsal Teklif</div>
            </div>

            <!-- Stat Card 5 -->
            <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 text-center backdrop-blur-sm hover:border-sky-500/40 hover:bg-slate-800 transition-all duration-200 group col-span-2 sm:col-span-1 md:col-span-1">
                <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-sky-500/10 text-sky-400 border border-sky-500/20 flex items-center justify-center group-hover:scale-110 group-hover:bg-sky-600 group-hover:text-white transition-all duration-200">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                </div>
                <div class="text-3xl lg:text-4xl font-black tracking-tight text-white mb-1.5">@(ViewBag.TotalItemsCount ?? 0)</div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Endüstriyel Ürün Portföyü</div>
            </div>

        </div>
    </div>
</section>

<!-- ==================== MODAL 1: HIZLI ŞARTNAME VE TEKNİK DETAY MODALI ==================== -->
<div id="tyQuickViewModal" class="ty-modal-overlay" onclick="if(event.target===this)closeTyModal('tyQuickViewModal')">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-3xl overflow-hidden relative p-4 sm:p-8 animate-in fade-in zoom-in-95 duration-200 max-h-[92vh] overflow-y-auto">
        <button type="button" class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 text-2xl font-bold p-1 leading-none rounded-lg hover:bg-slate-100 transition-colors" onclick="closeTyModal('tyQuickViewModal')">&times;</button>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
            <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-6 flex items-center justify-center min-h-[260px]">
