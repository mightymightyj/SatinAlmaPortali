                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="16"></line>
                            <line x1="8" y1="12" x2="16" y2="12"></line>
                        </svg>
                        <span>Bu Ürünü Ben de Satmak İstiyorum</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== MODAL 2: RESMİ KURUMSAL TEKLİF (RFQ) TALEP FORMU ==================== -->
<div id="tyQuoteModal" class="ty-modal-overlay" onclick="if(event.target===this)closeTyModal('tyQuoteModal')">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-xl overflow-hidden relative p-4 sm:p-8 animate-in fade-in zoom-in-95 duration-200 max-h-[92vh] overflow-y-auto">
        <button type="button" class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 text-2xl font-bold p-1 leading-none rounded-lg hover:bg-slate-100 transition-colors" onclick="closeTyModal('tyQuoteModal')">&times;</button>
        
        <div class="mb-4">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200/80 mb-2">B2B RESMİ SATINALMA TEKLİFİ (RFQ)</span>
            <h3 class="text-xl font-black text-slate-900 tracking-tight">Kurumsal Fiyat &amp; Vade Teklifi İste</h3>
            <p class="text-xs text-slate-500 mt-1 font-normal">Doğrudan üreticiye resmi proforma ve şartname talebi oluşturun.</p>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 mb-5">
            <div class="text-sm font-bold text-slate-900" id="quoteModalProductTitle">Ürün Adı</div>
            <div class="text-xs text-slate-500 mt-0.5 font-mono" id="quoteModalProductSku">SKU: 0000</div>
            <div class="text-xs text-slate-700 mt-1.5 flex flex-wrap gap-x-2">
                <span>Tedarikçi: <strong id="quoteModalSellerName" class="text-blue-600">Firma Ünvanı</strong></span>
                <span>•</span>
                <span>Liste Fiyatı: <strong id="quoteModalUnitPrice" class="text-slate-900">0 ₺</strong></span>
            </div>
        </div>

        <form id="quoteRequestForm" onsubmit="event.preventDefault(); submitQuoteRequest(event); return false;" class="space-y-4">
            <input type="hidden" id="quoteModalHiddenProductId" />
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">Satınalma Yapan Firma Ünvanı *</label>
                    <input type="text" id="quoteBuyerCompany" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-medium" placeholder="Örn: Aselsan / Ege Kimya A.Ş." required />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">Vergi Kimlik No / Dairesi</label>
                    <input type="text" id="quoteBuyerTax" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-medium" placeholder="1234567890 / Kadıköy VD" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">Talep Edilen Miktar *</label>
                    <input type="number" id="quoteQuantity" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-bold text-slate-900" value="100" min="1" required />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">Hedef Birim Fiyat (₺/Adet - Opsiyonel)</label>
                    <input type="text" id="quoteTargetPrice" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-medium" placeholder="Hedef bütçeniz" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">Tercih Edilen Ödeme Koşulu</label>
                    <select id="quotePaymentTerms" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-medium cursor-pointer">
                        <option value="Peşin İskontolu">Peşin / Havale (Maksimum İskonto)</option>
                        <option value="30 Gün Vade">30 Gün Vadeli Kurumsal Çek</option>
                        <option value="60 Gün Vade">60 Gün Vadeli Kurumsal Çek</option>
                        <option value="DBS / Açık Hesap">DBS (Doğrudan Borçlandırma Sistemi)</option>
                        <option value="Akreditif / LC">Akreditifli Satınalma</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">Teslimat İli / Fabrika Lokasyonu</label>
                    <input type="text" id="quoteDeliveryCity" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-medium" placeholder="Örn: Kocaeli / Dilovası" />
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1.5">Teknik Şartname &amp; Talep Notu</label>
                <textarea id="quoteNotes" rows="2" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-medium" placeholder="Özel toleranslar, ambalaj tipi veya teknik şartname notlarınız..."></textarea>
            </div>

            <div>
                <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer select-none">
                    <input type="checkbox" id="quoteSampleCheck" class="w-4 h-4 rounded text-blue-600 border-slate-300 focus:ring-blue-500" />
                    <span>Toplu alım öncesi <strong>numune (sample)</strong> talep ediyorum.</span>
                </label>
            </div>

            <div class="flex items-center gap-3 pt-2">
                <button type="button" class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 hover:bg-slate-100 text-slate-700 text-xs font-bold transition-colors" onclick="closeTyModal('tyQuoteModal')">Vazgeç</button>
                <button type="submit" class="flex-[2] inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold shadow-md shadow-blue-600/20 transition-all hover:-translate-y-0.5 active:scale-95">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                    <span>Resmi RFQ Talebini İlet</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ==================== MODAL 3: TEDARİKÇİ OLARAK İLAN VERME / PAZARYERİ GİRİŞİ FORMU ==================== -->
<div id="tySellerOfferModal" class="ty-modal-overlay" onclick="if(event.target===this)closeTyModal('tySellerOfferModal')">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-xl overflow-hidden relative p-4 sm:p-8 animate-in fade-in zoom-in-95 duration-200 max-h-[92vh] overflow-y-auto">
        <button type="button" class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 text-2xl font-bold p-1 leading-none rounded-lg hover:bg-slate-100 transition-colors" onclick="closeTyModal('tySellerOfferModal')">&times;</button>
        
        <div class="mb-4">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 mb-2">KURUMSAL TEDARİKÇİ GİRİŞİ</span>
            <h3 class="text-xl font-black text-slate-900 tracking-tight">Tedarikçi Olarak Ürün / Fiyat Listele</h3>
            <p class="text-xs text-slate-500 mt-1 font-normal">Fabrika veya distribütör portföyünüzü binlerce kurumsal satınalma yöneticisine açın.</p>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-700 mb-4" id="sellerModalProductInfo">
            Yeni Kurumsal Ürün &amp; Toptan İlan
        </div>

        <form id="sellerOfferForm" onsubmit="event.preventDefault(); submitSellerOffer(event); return false;" class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1.5">Ürün İsmi / Başlığı *</label>
                <input type="text" id="sellerOfferProductName" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-medium" placeholder="Örn: DIN 933 A2 Paslanmaz Cıvata M8x30" required />
            </div>

            <div>
                <div class="flex justify-between items-center mb-1.5">
                    <label class="text-xs font-bold text-slate-700">Kategori Seçimi *</label>
                    <span class="text-[11px] text-slate-400 font-normal">(Ağaçtan tıklayarak seçiniz)</span>
                </div>

                <!-- Gizli Inputlar (Form Validasyonu & Gönderim İçin) -->
                <input type="hidden" id="sellerOfferCategory" name="CategoryName" />
                <input type="hidden" id="sellerOfferCategoryId" name="CategoryID" />

                <!-- Kategori Ağacı Seçici -->
                <div class="border border-slate-200 rounded-xl p-3 bg-slate-50/70">
                    <!-- Seçili Kategori Rozet Alanı -->
                    <div class="flex justify-between items-center mb-2.5">
                        <div id="catTreeSelectedDisplay" class="flex items-center gap-1.5 text-xs text-slate-500 font-medium truncate">
                            <span id="catTreeSelectedIcon"></span>
                            <span class="truncate" id="catTreeSelectedText">Lütfen aşağıdaki listeden bir kategori seçiniz...</span>
                        </div>
                        <button type="button" class="text-xs px-2 py-0.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 text-slate-600 font-semibold shrink-0 transition-colors" onclick="clearCatTreeSelection()" title="Seçimi Temizle">Temizle</button>
                    </div>

                    <!-- Canlı Arama -->
                    <div class="relative flex items-center mb-2">
                        <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <input type="text" id="catTreePickerSearch" placeholder="Kategori ara (örn: Paslanmaz, CNC, Boru...)" oninput="filterCatTreePicker(this.value)" class="w-full pl-8 pr-3 py-1.5 text-xs bg-white border border-slate-200 rounded-lg outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500/20 font-medium" />
                    </div>

                    <!-- Hiyerarşik Ağaç Listesi -->
                    <div class="max-h-48 overflow-y-auto border border-slate-200 rounded-lg p-2 bg-white space-y-1" id="catTreePickerList">
                        @if (ViewBag.CategoryTree != null && ((IEnumerable<satinalmaportali2.Controllers.HierarchicalCategoryItem>)ViewBag.CategoryTree).Any())
                        {
                            var rootCategories = (IEnumerable<satinalmaportali2.Controllers.HierarchicalCategoryItem>)ViewBag.CategoryTree;
                            foreach (var root in rootCategories)
                            {
                                @RenderSuperAdminTree(root, 0)
                            }
                        }
                        else
                        {
                            <div class="p-3 text-center text-slate-400 text-xs">
                                Kategori listesi yükleniyor...
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">Toptan Birim Fiyat (₺ + KDV) *</label>
                    <input type="number" id="sellerOfferPrice" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-bold text-slate-900" placeholder="Örn: 2450" required />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">Hazır Stok / Aylık Kapasite *</label>
                    <input type="text" id="sellerOfferStock" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-medium" placeholder="Örn: 2.500 Adet" required />
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1.5">Tedarik &amp; Sevkiyat Şartları</label>
                <textarea id="sellerOfferDesc" rows="2" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-medium" placeholder="Minimum sipariş (MOQ), termin süresi, teslimat yöntemleri..."></textarea>
            </div>

            <!-- Ürün Görselleri Yükleme (Cloudinary Çoklu Görsel) -->
            <div>
                <div class="flex justify-between items-center mb-1.5">
                    <label class="text-xs font-bold text-slate-700">Ürün Görselleri (Cloudinary)</label>
                    <span class="text-[11px] text-slate-400 font-normal">(Birden fazla ekleyebilir, ana resmi seçebilirsiniz)</span>
                </div>

                <div class="border-2 border-dashed border-slate-200 hover:border-blue-400 rounded-xl p-4 text-center bg-slate-50/50 hover:bg-blue-50/20 transition-all cursor-pointer" id="homeProductImageDropzone" onclick="document.getElementById('homeProductImageFileInput').click()">
                    <input type="file" id="homeProductImageFileInput" multiple accept="image/png,image/jpeg,image/webp,image/jpg" class="hidden" onchange="handleHomeProductImageFiles(this.files)" />
                    <svg class="w-6 h-6 text-blue-500 mx-auto mb-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                        <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                    <div class="text-xs font-bold text-slate-900">Görselleri Seçin veya Sürükleyin</div>
                    <div class="text-[11px] text-slate-500 mt-0.5">Cloudinary ile otomatik optimize edilir (Maks: 5MB)</div>
                </div>

                <div id="homeImageUploadProgress" class="hidden items-center gap-2 mt-2 p-2 rounded-lg bg-blue-50 border border-blue-100 text-xs text-blue-700">
                    <span class="inline-block w-3.5 h-3.5 border-2 border-blue-600 border-t-transparent rounded-full animate-spin"></span>
                    <span id="homeImageUploadProgressText">Görseller Cloudinary'ye yükleniyor...</span>
                </div>

                <div id="homeUploadedImagesGrid" class="grid grid-cols-4 sm:grid-cols-6 gap-2 mt-2.5"></div>
            </div>

            <div class="flex items-center gap-3 pt-2">
                <button type="button" class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 hover:bg-slate-100 text-slate-700 text-xs font-bold transition-colors" onclick="closeTyModal('tySellerOfferModal')">Vazgeç</button>
                <button type="submit" class="flex-[2] inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold shadow-md transition-all hover:-translate-y-0.5 active:scale-95">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Ürün İlanını Doğrulamaya Gönder</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ==================== MOBİL KATEGORİ SEÇİM MODALI (#mobileCategoryModal) ==================== -->
<div id="mobileCategoryModal" class="ty-modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.65); backdrop-filter: blur(4px); z-index: 100000; align-items: flex-end; justify-content: center; padding: 0;" onclick="if(event.target===this)closeMobileCategoryModal()">
    <div class="w-full sm:max-w-lg bg-white rounded-t-2xl sm:rounded-2xl shadow-2xl border border-slate-200 overflow-hidden flex flex-col max-h-[88vh] sm:max-h-[82vh] animate-in slide-in-from-bottom sm:zoom-in-95 duration-200">
        
        <!-- Modal Başlığı -->
        <div class="px-5 py-4 bg-slate-900 text-white flex items-center justify-between border-b border-slate-800 shrink-0">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-blue-500/20 text-blue-400 flex items-center justify-center">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                        <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                        <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                        <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                    </svg>
                </div>
                <div>
                    <h3 class="text-sm font-extrabold text-white">Kategori Seçimi</h3>
                    <p class="text-[11px] text-slate-400">Ürünleri kategoriye göre filtreleyin</p>
                </div>
            </div>
            <button type="button" onclick="closeMobileCategoryModal()" class="w-8 h-8 rounded-lg bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center text-lg font-bold transition-colors" aria-label="Kapat">&times;</button>
        </div>

        <!-- Arama ve Hızlı Filtre Barı -->
        <div class="p-3.5 bg-slate-50 border-b border-slate-200 shrink-0 space-y-2">
            <!-- Arama Kutusu -->
            <div class="relative bg-white border border-slate-200 rounded-xl shadow-sm focus-within:ring-2 focus-within:ring-blue-500/20 focus-within:border-blue-500 transition-all">
                <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" id="mobileCatModalSearchInput" 
                       placeholder="Kategori ara (örn: Cıvata, Paslanmaz, PLC...)" 
                       class="w-full pl-9 pr-8 py-2 text-xs bg-transparent outline-none text-slate-800 placeholder-slate-400 font-medium" 
                       oninput="filterMobileModalCategories(this.value)" />
                <button type="button" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-xs text-slate-400 hover:text-slate-600 font-bold" onclick="document.getElementById('mobileCatModalSearchInput').value=''; filterMobileModalCategories('');" title="Temizle">&times;</button>
            </div>

            <!-- "Tüm Kategoriler" Hızlı Seçim Butonu -->
            <button type="button" onclick="selectMobileCatItem(0, 'Tüm Kategoriler', '')" class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-blue-50 border border-blue-200 hover:bg-blue-100 text-blue-800 transition-all active:scale-[0.99]">
                <div class="flex items-center gap-2.5">
                    <span class="w-2 h-2 rounded-full bg-blue-600"></span>
                    <span class="text-xs font-bold">Tüm Kategoriler (Filtreyi Temizle)</span>
                </div>
                <svg class="w-4 h-4 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
            </button>
        </div>

        <!-- Kaydırılabilir Kategori Ağacı Listesi -->
        <div id="mobileCategoryModalList" class="flex-1 overflow-y-auto p-3 space-y-1 divide-y divide-slate-100">
            @if (ViewBag.CategoryTree != null && ((IEnumerable<satinalmaportali2.Controllers.HierarchicalCategoryItem>)ViewBag.CategoryTree).Any())
            {
                var rootCategories = (IEnumerable<satinalmaportali2.Controllers.HierarchicalCategoryItem>)ViewBag.CategoryTree;
                foreach (var root in rootCategories)
                {
                    @RenderMobileCategoryModalTree(root, 0)
                }
            }
        </div>
    </div>
</div>

<!-- ==================== B2B KURUMSAL SEPET ÇEKMECESİ (SLIDE-OVER DRAWER) ==================== -->
