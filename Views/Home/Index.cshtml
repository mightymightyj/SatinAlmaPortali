        </div>

        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 12px; margin-bottom: 14px; font-size: 0.82rem; color: #1e293b;" id="sellerModalProductInfo">
            Yeni Kurumsal Ürün & Toptan İlan
        </div>

        <form id="sellerOfferForm" onsubmit="event.preventDefault(); submitSellerOffer(event); return false;">
            <div style="margin-bottom: 12px;">
                <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #334155; margin-bottom: 4px;">Ürün İsmi / Başlığı *</label>
