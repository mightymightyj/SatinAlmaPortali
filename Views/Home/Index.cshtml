                            <span>Vergi Kimlik / TC No</span>
                            <span id="checkoutTaxCounter" class="text-[10px] text-slate-400 font-mono">0/11 Hane</span>
                        </label>
                        <input type="text" id="checkoutBuyerTaxNo" class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-mono font-bold" placeholder="10 haneli VKN veya 11 haneli TCKN" maxlength="11" inputmode="numeric" oninput="formatTaxNumberInput(this)" />
                    </div>
                    <div>
                        <label class="flex justify-between items-center text-xs font-bold text-slate-700 mb-1" for="checkoutBuyerTaxOffice">
                            <span>Vergi Dairesi</span>
                            <span class="text-[10px] text-slate-400">İsteğe Bağlı</span>
                        </label>
                        <input type="text" id="checkoutBuyerTaxOffice" class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all font-medium" placeholder="Örn: Kadıköy VD / Ostim VD" />
                    </div>
                </div>
            </div>

            <!-- Adım 2: Sevkiyat ve Fabrika Teslimat Adresi -->
            <div class="rounded-xl border border-slate-200 bg-slate-50/50 p-4 sm:p-5">
