                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                <span>Sepetim</span>
                <span id="vitrinCartBadge" style="background: #ef4444; color: #fff; font-size: 0.72rem; padding: 1px 7px; border-radius: 9999px; font-weight: 800;">0</span>
            </a>

            <!-- Farklı İlanlar Getir Butonu -->
            <button type="button" class="btn-b2b-shuffle" id="btnShuffleProducts" title="Yeni 48 farklı kurumsal ürün ve satıcı listele">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <polyline points="1 20 1 14 7 14"></polyline>
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                </svg>
                Farklı İlanları Getir
            </button>

            <!-- Tedarikçi Olarak İlan Ver Butonu -->
            <button type="button" class="btn-b2b-seller-cta" onclick="openSellerOfferModal()" title="Kurumsal satıcı olarak ürünlerinizi listelemek için tıklayın">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="16"></line>
                    <line x1="8" y1="12" x2="16" y2="12"></line>
                </svg>
                Tedarikçi Olarak İlan Ver
            </button>
        </div>
    </div>

    <!-- ==================== B2B KURUMSAL KATEGORİ AĞACI VE VİTRİN KONTROLLERİ ==================== -->
    <div class="b2b-vitrin-cat-bar" id="vitrinCategoryTreeBar">
        <!-- Kompakt Bar Başlığı / Tetikleyici -->
        <div class="b2b-cat-toggle-header" onclick="toggleVitrinCatTreePanel()">
            <div class="b2b-cat-toggle-left">
                <div class="b2b-cat-icon-badge">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                        <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                        <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                        <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                    </svg>
                </div>
                <div>
                    <div class="b2b-cat-toggle-title">
                        <span>Kategori Ağacı ile Filtrele</span>
                        <span id="vitrinActiveCatBadge" class="b2b-active-cat-pill is-all">
                            <span id="vitrinActiveCatName">Tüm Kategoriler</span>
                        </span>
                    </div>
                    <div class="b2b-cat-toggle-subtitle" id="vitrinCatSummaryText">
                        Hiyerarşik kurumsal kategori sistemimizden seçim yaparak ürünleri anlık filtreleyin.
                    </div>
                </div>
            </div>

            <div class="b2b-cat-toggle-right">
                <button type="button" class="b2b-btn-clear-cat-filter" id="btnClearVitrinCatFilter" style="display: none;" onclick="event.stopPropagation(); clearVitrinCategoryFilter();" title="Kategori Filtresini Temizle">
                    ✕ Temizle
                </button>
                <button type="button" class="b2b-btn-toggle-tree" id="btnToggleVitrinTree">
                    <span id="vitrinToggleText">Kategori Ağacını Aç</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="b2b-chevron-icon" id="vitrinTreeChevron">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Açılır / Kapanır Kategori Ağacı Gövdesi (Varsayılan olarak kapalı - yer kaplamaz) -->
        <div class="b2b-vitrin-tree-collapse" id="vitrinCatTreeCollapse" style="display: none;">
            <div class="b2b-vitrin-tree-inner">
                
                <!-- Canlı Arama ve Hızlı Araçlar -->
                <div class="b2b-tree-toolbar">
                    <div class="b2b-tree-search-wrap">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2.2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input type="text" id="vitrinCatSearchInput" placeholder="Kategori veya alt dal ara (örn: Cıvata, Paslanmaz, PLC, Şalt, Rulman...)" oninput="filterVitrinTreeNodes(this.value)" />
                        <button type="button" class="b2b-tree-search-clear" onclick="document.getElementById('vitrinCatSearchInput').value=''; filterVitrinTreeNodes('');" title="Aramayı Temizle">✕</button>
                    </div>

                    <div class="b2b-tree-action-btns">
                        <button type="button" class="b2b-tree-tool-btn" onclick="expandAllVitrinTree()">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="7 13 12 18 17 13"></polyline><polyline points="7 6 12 11 17 6"></polyline></svg>
                            Tümünü Aç
                        </button>
                        <button type="button" class="b2b-tree-tool-btn" onclick="collapseAllVitrinTree()">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="17 11 12 6 7 11"></polyline><polyline points="17 18 12 13 7 18"></polyline></svg>
                            Daralt
                        </button>
                    </div>
                </div>

                <!-- Hiyerarşik Ağaç Listesi -->
                <div class="b2b-tree-scrollbox" id="vitrinCategoryTreeList">
                    <!-- 'Tüm Kategoriler' Kök Düğümü -->
                    <div class="cat-tree-node level-0 is-all-node" data-cat-id="0" data-cat-name="tüm kategoriler" data-cat-path="">
                        <div class="cat-node-row is-root is-selected" id="vitrinNodeRow-0" onclick="selectVitrinCategory(0, 'Tüm Kategoriler', '')">
                            <div class="cat-node-left">
                                <span class="cat-tree-bullet">•</span>
                                <span class="cat-node-title" style="font-weight: 750; color: #0284c7;">Tüm Kategoriler</span>
                            </div>
                        </div>
                    </div>

                    <!-- Veritabanından Gelen Hiyerarşik Kategori Ağacı -->
                    @if (ViewBag.CategoryTree != null && ((IEnumerable<satinalmaportali2.Controllers.HierarchicalCategoryItem>)ViewBag.CategoryTree).Any())
                    {
                        var rootCategories = (IEnumerable<satinalmaportali2.Controllers.HierarchicalCategoryItem>)ViewBag.CategoryTree;
                        foreach (var root in rootCategories)
                        {
                            @RenderVitrinCategoryTree(root, 0)
                        }
                    }
                </div>

            </div>
        </div>
    </div>

    <!-- Canlı Arama ve Sıralama Çubuğu -->
    <div class="b2b-search-sort-bar" style="display: flex; gap: 12px; margin-bottom: 20px; align-items: center; justify-content: space-between; flex-wrap: wrap;">
        <div class="b2b-search-box" style="flex: 1; min-width: 280px;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="vitrinSearchInput" placeholder="Ürün, marka, SKU veya firma ara..." />
        </div>

        <div style="display: flex; align-items: center; gap: 10px;">
            <span id="vitrinProductCount" style="font-size: 0.82rem; font-weight: 700; color: #64748b; background: #f1f5f9; padding: 6px 12px; border-radius: 8px; border: 1px solid #e2e8f0;">
                Yükleniyor...
            </span>

            <select id="vitrinSortSelect" class="b2b-sort-select" title="Sıralama Seçeneği">
                <option value="recommended">Öne Çıkanlar</option>
                <option value="score">Tedarikçi Puanı (Yüksek)</option>
                <option value="discount">En Yüksek İskonto</option>
                <option value="price-asc">Fiyata Göre (Artan)</option>
                <option value="price-desc">Fiyata Göre (Azalan)</option>
            </select>
        </div>
    </div>

    <!-- 6 Sütun x 8 Satır Profesyonel B2B Ürün Matrisi (48 Ürün) -->
    <div class="b2b-product-grid" id="trendyolProductGrid">
        <!-- JavaScript (trendyol-vitrin.js) ile dinamik olarak doldurulacaktır -->
    </div>
</section>

<!-- SECTION 3: STATS METRIC CARDS -->
