@{
    ViewData["Title"] = "Ana Sayfa - B2B Kurumsal Tedarik Portalı";
}

@section Styles {
    <!-- Tailwind CSS (Play CDN) & Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e',
                            950: '#082f49',
                        }
                    }
                }
            }
        };
    </script>
    <style>
        /* Vitrin Kategori Ağacı Stilleri (Tailwind ile Uyumlu) */
        .cat-tree-node { position: relative; margin-top: 3px; margin-bottom: 3px; }
        .cat-node-row {
            display: flex; align-items: center; justify-content: space-between;
            padding: 6px 12px; background: #ffffff; border: 1px solid #e2e8f0;
            border-radius: 8px; font-size: 0.84rem; cursor: pointer;
            transition: all 0.15s ease;
        }
        .cat-node-row:hover { background: #f0f9ff; border-color: #38bdf8; }
        .cat-node-row.is-root { font-weight: 700; border-left: 3px solid #0284c7; }
        .cat-node-row.is-selected { background: #e0f2fe; border-color: #0284c7; color: #0369a1; font-weight: 700; }
        .cat-node-left { display: flex; align-items: center; gap: 8px; flex-wrap: nowrap; flex: 1; min-width: 0; }
        .cat-toggle-btn {
            background: transparent; border: none; cursor: pointer; padding: 2px 4px;
            display: inline-flex; align-items: center; justify-content: center;
            color: #64748b; border-radius: 4px; line-height: 1;
        }
        .cat-toggle-btn:hover { background: #e2e8f0; color: #0f172a; }
        .cat-toggle-btn.is-collapsed .toggle-icon { transform: rotate(-90deg); }
        .toggle-icon { transition: transform 0.15s ease; }
        .cat-tree-bullet { color: #94a3b8; font-size: 0.85rem; width: 14px; text-align: center; }
        .cat-node-title { color: #1e293b; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .cat-children-wrap.is-hidden { display: none !important; }

        /* Slide-over Drawer Animasyonu */
        @@keyframes slideDrawerLeft {
            from { transform: translateX(100%); }
            to { transform: translateX(0); }
        }

        /* Modal ve Overlay Stilleri */
        .ty-modal-overlay, .b2b-checkout-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(6px);
            z-index: 99999;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            overflow-y: auto;
        }
        .ty-modal-overlay.show, .ty-modal-overlay.is-open,
        .b2b-checkout-overlay.show, .b2b-checkout-overlay.is-open {
            display: flex !important;
        }

        /* Mobil Duyarlı Kurallar */
        @@media (max-width: 640px) {
            .cat-tree-node {
                margin-left: calc(var(--tree-level, 0) * 8px) !important;
            }
            .cat-node-row {
                padding: 6px 8px;
                font-size: 0.80rem;
            }
            .cat-node-title {
                font-size: 0.80rem;
            }
            .ty-modal-overlay, .b2b-checkout-overlay {
                padding: 0.5rem;
            }
        }
    </style>
}

@functions {
    public static Microsoft.AspNetCore.Html.IHtmlContent RenderVitrinCategoryTree(satinalmaportali2.Controllers.HierarchicalCategoryItem node, int level)
    {
        var hasChildren = node.Children != null && node.Children.Count > 0;
        var indent = level * 16;
        var encodedName = System.Net.WebUtility.HtmlEncode(node.CategoryName ?? "");
        var encodedPath = System.Net.WebUtility.HtmlEncode(node.BreadcrumbPath ?? "");
        var safeJsName = (node.CategoryName ?? "").Replace("'", "\\'");
        var safeJsPath = (node.BreadcrumbPath ?? "").Replace("'", "\\'");

        var sb = new System.Text.StringBuilder();
        sb.Append($"<div class=\"cat-tree-node level-{Math.Min(level, 3)}\" data-cat-id=\"{node.CategoryID}\" data-cat-name=\"{encodedName.ToLowerInvariant()}\" data-cat-path=\"{encodedPath}\" style=\"--tree-level: {level}; margin-left: {indent}px;\">");
        sb.Append($"<div class=\"cat-node-row {(level == 0 ? "is-root" : "")}\" id=\"vitrinNodeRow-{node.CategoryID}\" onclick=\"selectVitrinCategory({node.CategoryID}, '{safeJsName}', '{safeJsPath}')\" title=\"'{encodedPath}'\">");
        sb.Append("<div class=\"cat-node-left\">");

        if (hasChildren)
        {
            sb.Append($"<button type=\"button\" class=\"cat-toggle-btn\" onclick=\"event.stopPropagation(); toggleVitrinCatTreeBranch(this, 'vitrin-branch-{node.CategoryID}')\" title=\"Genişlet / Daralt\"><svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" class=\"toggle-icon\"><polyline points=\"6 9 12 15 18 9\"></polyline></svg></button>");
        }
        else
        {
            sb.Append("<span class=\"cat-tree-bullet\">•</span>");
        }

        sb.Append($"<span class=\"cat-node-title\">{encodedName}</span>");
        sb.Append("</div>");
        sb.Append("</div>");

        if (hasChildren && node.Children != null)
        {
            sb.Append($"<div class=\"cat-children-wrap\" id=\"vitrin-branch-{node.CategoryID}\">");
            foreach (var child in node.Children)
            {
                sb.Append(RenderVitrinCategoryTree(child, level + 1).ToString());
            }
            sb.Append("</div>");
        }

        sb.Append("</div>");
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }

    public static Microsoft.AspNetCore.Html.IHtmlContent RenderMobileCategoryModalTree(satinalmaportali2.Controllers.HierarchicalCategoryItem node, int level)
    {
        var hasChildren = node.Children != null && node.Children.Count > 0;
        var encodedName = System.Net.WebUtility.HtmlEncode(node.CategoryName ?? "");
        var encodedPath = System.Net.WebUtility.HtmlEncode(node.BreadcrumbPath ?? "");
        var safeJsName = (node.CategoryName ?? "").Replace("'", "\\'");
        var safeJsPath = (node.BreadcrumbPath ?? "").Replace("'", "\\'");
        var indentPadding = Math.Min(level, 4) * 12;

        var sb = new System.Text.StringBuilder();
        sb.Append($"<div class=\"mob-cat-item-wrap\" data-cat-id=\"{node.CategoryID}\" data-cat-name=\"{encodedName.ToLowerInvariant()}\" data-cat-path=\"{encodedPath.ToLowerInvariant()}\">");
        sb.Append($"<div class=\"mob-cat-row flex items-center justify-between py-2.5 px-3 rounded-xl hover:bg-slate-100 active:bg-blue-50 transition-colors cursor-pointer select-none\" style=\"padding-left: {indentPadding + 12}px;\" onclick=\"selectMobileCatItem({node.CategoryID}, '{safeJsName}', '{safeJsPath}')\">");
        
        sb.Append("<div class=\"flex items-center gap-2 min-w-0 flex-1\">");
        if (level == 0)
        {
            sb.Append("<span class=\"w-1.5 h-1.5 rounded-full bg-blue-600 shrink-0\"></span>");
            sb.Append($"<span class=\"text-xs font-bold text-slate-900 truncate\">{encodedName}</span>");
        }
        else
        {
            sb.Append("<span class=\"text-slate-300 text-xs shrink-0\">└</span>");
            sb.Append($"<span class=\"text-xs font-medium text-slate-700 truncate\">{encodedName}</span>");
        }
        sb.Append("</div>");

        if (hasChildren)
        {
            sb.Append($"<button type=\"button\" class=\"w-7 h-7 rounded-lg hover:bg-slate-200 flex items-center justify-center text-slate-400 hover:text-slate-700 shrink-0 transition-transform\" onclick=\"event.stopPropagation(); toggleMobileCatModalBranch(this, 'mob-branch-{node.CategoryID}')\" aria-label=\"Alt Kategoriler\"><svg class=\"w-3.5 h-3.5 transition-transform duration-200\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polyline points=\"6 9 12 15 18 9\"></polyline></svg></button>");
        }

        sb.Append("</div>");

        if (hasChildren && node.Children != null)
        {
            sb.Append($"<div class=\"mob-children-wrap hidden space-y-1\" id=\"mob-branch-{node.CategoryID}\">");
            foreach (var child in node.Children)
            {
                sb.Append(RenderMobileCategoryModalTree(child, level + 1).ToString());
            }
            sb.Append("</div>");
        }

        sb.Append("</div>");
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }

    public static Microsoft.AspNetCore.Html.IHtmlContent RenderSuperAdminTree(satinalmaportali2.Controllers.HierarchicalCategoryItem node, int level)
    {
        var hasChildren = node.Children != null && node.Children.Count > 0;
        var indent = level * 14;
        var encodedName = System.Net.WebUtility.HtmlEncode(node.CategoryName ?? "");
        var encodedPath = System.Net.WebUtility.HtmlEncode(node.BreadcrumbPath ?? "");
        var safeJsName = (node.CategoryName ?? "").Replace("'", "\\'");
        var safeJsPath = (node.BreadcrumbPath ?? "").Replace("'", "\\'");

        var sb = new System.Text.StringBuilder();
        sb.Append($"<div class=\"cat-tree-node level-{Math.Min(level, 3)}\" data-cat-id=\"{node.CategoryID}\" data-cat-name=\"{encodedName.ToLowerInvariant()}\" data-cat-path=\"{encodedPath}\" style=\"--tree-level: {level}; margin-left: {indent}px; margin-bottom: 2px;\">");
        sb.Append($"<div class=\"cat-node-row {(level == 0 ? "is-root" : "")}\" onclick=\"selectCatFromTree({node.CategoryID}, '{safeJsName}', '{safeJsPath}')\" title=\"'{encodedPath}'\">");
        sb.Append("<div class=\"cat-node-left\">");
        sb.Append("<span class=\"cat-tree-bullet\">•</span>");
        sb.Append($"<span class=\"cat-node-title\">{encodedName}</span>");
        sb.Append("</div>");
        sb.Append("</div>");

        if (hasChildren && node.Children != null)
        {
            sb.Append($"<div class=\"cat-children-wrap\" id=\"picker-branch-{node.CategoryID}\">");
            foreach (var child in node.Children)
            {
                sb.Append(RenderSuperAdminTree(child, level + 1).ToString());
            }
            sb.Append("</div>");
        }

        sb.Append("</div>");
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }
}

<!-- ==================== BÖLÜM 1: TAILWIND HERO HEADER ==================== -->
<section class="relative overflow-hidden bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 text-white pt-12 sm:pt-20 pb-20 sm:pb-28 px-4 sm:px-6 lg:px-8 border-b border-slate-800/80">
    <!-- Arka Plan Radial Glow Efekti -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(37,99,235,0.28),rgba(255,255,255,0))] pointer-events-none"></div>

    <div class="relative max-w-5xl mx-auto text-center">
        <!-- Kurumsal Rozet -->
        <div class="inline-flex items-center gap-2 px-3 sm:px-4 py-1.5 rounded-full text-[11px] sm:text-xs font-semibold bg-blue-500/10 text-blue-400 border border-blue-500/20 mb-4 sm:mb-6 backdrop-blur-sm shadow-sm max-w-full">
            <svg class="w-3.5 h-3.5 text-blue-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
            <span class="truncate">Türkiye'nin Güvenilir B2B Satınalma &amp; Tedarik Pazaryeri</span>
        </div>

        <!-- Ana Başlık -->
        <h1 class="text-2.5xl sm:text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.18] sm:leading-[1.12]">
            Endüstriyel Satınalmada <br class="hidden sm:inline" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-sky-300 to-indigo-300">
                Doğrudan Fabrikadan
            </span> Tedarik Ağı
