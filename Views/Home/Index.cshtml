                <!-- Gizli Inputlar (Form Validasyonu & Gönderim İçin) -->
                <input type="hidden" id="sellerOfferCategory" name="CategoryName" />
                <input type="hidden" id="sellerOfferCategoryId" name="CategoryID" />

                <!-- Kategori Ağacı Seçici (Ana Sayfa ile Birebir Aynı Sade Görünüm) -->
                <div class="b2b-cat-picker-container" style="border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px; background: #f8fafc;">
                    <!-- Seçili Kategori Rozet Alanı -->
                    <div class="b2b-cat-picker-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <div id="catTreeSelectedDisplay" class="b2b-cat-picker-selected is-empty" style="display: flex; align-items: center; gap: 6px; font-size: 0.84rem; color: #64748b;">
                            <span id="catTreeSelectedIcon"></span>
                            <span class="b2b-cat-selected-text" id="catTreeSelectedText">Lütfen aşağıdaki listeden bir kategori seçiniz...</span>
                        </div>
                        <button type="button" class="btn-tree-tool" onclick="clearCatTreeSelection()" style="font-size: 0.75rem; padding: 2px 8px; border-radius: 4px; border: 1px solid #cbd5e1; background: #ffffff; cursor: pointer;" title="Seçimi Temizle">Temizle</button>
                    </div>

                    <!-- Canlı Arama -->
                    <div class="b2b-cat-search-box" style="margin-bottom: 8px; position: relative; display: flex; align-items: center;">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" style="position: absolute; left: 10px;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <input type="text" id="catTreePickerSearch" placeholder="Kategori ara (örn: Paslanmaz, CNC, Boru...)" oninput="filterCatTreePicker(this.value)" style="width: 100%; padding: 6px 10px 6px 28px; font-size: 0.82rem; border: 1px solid #cbd5e1; border-radius: 6px; background: #ffffff;" />
                    </div>

                    <!-- Hiyerarşik Ağaç Listesi (Ana Sayfa ile Birebir Aynı Sade Stil) -->
                    <div class="b2b-tree-scrollbox" id="catTreePickerList" style="max-height: 200px; overflow-y: auto; border: 1px solid #e2e8f0; border-radius: 6px; padding: 6px; background: #ffffff;">
                        @if (ViewBag.CategoryTree != null && ((IEnumerable<satinalmaportali2.Controllers.HierarchicalCategoryItem>)ViewBag.CategoryTree).Any())
                        {
                            var rootCategories = (IEnumerable<satinalmaportali2.Controllers.HierarchicalCategoryItem>)ViewBag.CategoryTree;
                            foreach (var root in rootCategories)
                            {
                                @RenderSuperAdminTree(root, 0)
                            }
                        }
                        else
                        {
                            <div style="padding: 12px; text-align: center; color: #94a3b8; font-size: 0.8rem;">
                                Kategori listesi yükleniyor...
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
                <div>
                    <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #334155; margin-bottom: 4px;">Toptan Birim Fiyat (₺ + KDV) *</label>
                    <input type="number" id="sellerOfferPrice" class="form-control" placeholder="Örn: 2450" required style="border-radius: 6px; font-size: 0.85rem;" />
                </div>
                <div>
                    <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #334155; margin-bottom: 4px;">Hazır Stok / Aylık Kapasite *</label>
                    <input type="text" id="sellerOfferStock" class="form-control" placeholder="Örn: 2.500 Adet" required style="border-radius: 6px; font-size: 0.85rem;" />
                </div>
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #334155; margin-bottom: 4px;">Tedarik & Sevkiyat Şartları</label>
                <textarea id="sellerOfferDesc" class="form-control" rows="2" placeholder="Minimum sipariş (MOQ), termin süresi, teslimat yöntemleri..." style="border-radius: 6px; font-size: 0.82rem;"></textarea>
            </div>

            <div style="display: flex; gap: 10px;">
                <button type="button" class="btn-edit-cancel" style="flex: 1; border-radius: 6px;" onclick="closeTyModal('tySellerOfferModal')">Vazgeç</button>
                <button type="submit" class="btn-b2b-seller-cta" style="flex: 2; border-radius: 6px; padding: 11px 16px; font-size: 0.88rem; justify-content: center; background: #0f172a;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    Ürün İlanını Doğrulamaya Gönder
                </button>
            </div>
        </form>
    </div>
</div>

