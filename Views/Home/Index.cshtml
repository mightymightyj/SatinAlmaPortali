<!-- ==================== B2B KURUMSAL CHECKOUT / SATIN ALMA MODALI ==================== -->
<div id="b2bCheckoutModal" class="ty-modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.7); backdrop-filter: blur(4px); z-index: 99999; align-items: center; justify-content: center; padding: 20px;" onclick="if(event.target===this)closeCheckoutModal()">
    <div class="ty-modal-box" style="background: #ffffff; border-radius: 12px; width: 100%; max-width: 620px; max-height: 90vh; overflow-y: auto; padding: 24px; box-shadow: 0 25px 30px -5px rgba(0,0,0,0.3);">
        
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
            <div>
                <span class="b2b-section-tag" style="background: #f0fdf4; color: #166534; border-color: #bbf7d0;">B2B KURUMSAL CHECKOUT</span>
                <h3 style="font-size: 1.3rem; font-weight: 800; color: #0f172a; margin-top: 6px; margin-bottom: 4px;">Siparişi Onayla & Satın Al</h3>
                <p style="font-size: 0.82rem; color: #64748b; margin: 0;">Fatura, sevkiyat ve kurumsal ödeme bilgilerinizi tamamlayınız.</p>
            </div>
            <button type="button" class="ty-modal-close" onclick="closeCheckoutModal()" style="font-size: 1.4rem; cursor: pointer; border: none; background: transparent; color: #64748b;">&times;</button>
        </div>

        <form id="corporateCheckoutForm" onsubmit="submitCorporateOrder(event); return false;">
            
            <!-- Adım 1: Kurumsal Fatura Bilgileri -->
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px; margin-bottom: 14px;">
                <h4 style="font-size: 0.88rem; font-weight: 800; color: #0f172a; margin-bottom: 10px; display: flex; align-items: center; gap: 6px;">
                    <span>🏢</span> 1. Kurumsal Fatura Bilgileri
                </h4>
                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-size: 0.78rem; font-weight: 700; color: #334155; margin-bottom: 3px;">Satınalma Yapan Firma Ünvanı *</label>
                    <input type="text" id="checkoutBuyerCompany" class="form-control" placeholder="Örn: Aselsan / Ege Kimya A.Ş." required style="font-size: 0.85rem;" />
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                    <div>
                        <label style="display: block; font-size: 0.78rem; font-weight: 700; color: #334155; margin-bottom: 3px;">Vergi Kimlik No (VKN / TC)</label>
                        <input type="text" id="checkoutBuyerTaxNo" class="form-control" placeholder="1234567890" style="font-size: 0.85rem;" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 0.78rem; font-weight: 700; color: #334155; margin-bottom: 3px;">Vergi Dairesi</label>
                        <input type="text" id="checkoutBuyerTaxOffice" class="form-control" placeholder="Kadıköy VD" style="font-size: 0.85rem;" />
                    </div>
                </div>
            </div>

            <!-- Adım 2: Sevkiyat ve Fabrika Teslimat Adresi -->
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px; margin-bottom: 14px;">
                <h4 style="font-size: 0.88rem; font-weight: 800; color: #0f172a; margin-bottom: 10px; display: flex; align-items: center; gap: 6px;">
                    <span>📍</span> 2. Teslimat & Sevkiyat Adresi
                </h4>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px;">
                    <div>
                        <label style="display: block; font-size: 0.78rem; font-weight: 700; color: #334155; margin-bottom: 3px;">Teslimat İli / İlçe *</label>
                        <input type="text" id="checkoutDeliveryCity" class="form-control" placeholder="Örn: Kocaeli / Dilovası OSB" required style="font-size: 0.85rem;" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 0.78rem; font-weight: 700; color: #334155; margin-bottom: 3px;">Yetkili / Alıcı Telefonu</label>
                        <input type="text" id="checkoutReceiverPhone" class="form-control" placeholder="0532 XXX XX XX" style="font-size: 0.85rem;" />
                    </div>
                </div>
                <div>
                    <label style="display: block; font-size: 0.78rem; font-weight: 700; color: #334155; margin-bottom: 3px;">Fabrika / Depo Açık Adresi *</label>
                    <textarea id="checkoutDeliveryAddress" class="form-control" rows="2" placeholder="Fabrika No, Blok, Mal Kabul Kapısı veya Şantiye Adresi..." required style="font-size: 0.82rem;"></textarea>
                </div>
            </div>

            <!-- Adım 3: Kurumsal Ödeme Yöntemi -->
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px; margin-bottom: 14px;">
                <h4 style="font-size: 0.88rem; font-weight: 800; color: #0f172a; margin-bottom: 10px; display: flex; align-items: center; gap: 6px;">
                    <span>💳</span> 3. Kurumsal Ödeme Yöntemi
                </h4>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px;">
                    <label style="border: 1px solid #cbd5e1; border-radius: 6px; padding: 10px; display: flex; align-items: center; gap: 8px; cursor: pointer; background: #fff;">
                        <input type="radio" name="checkoutPaymentMethod" value="Kredi Kartı" checked onchange="togglePaymentFields(this.value)" />
                        <span style="font-size: 0.82rem; font-weight: 700;">💳 Kredi / Kurumsal Kart</span>
                    </label>
                    <label style="border: 1px solid #cbd5e1; border-radius: 6px; padding: 10px; display: flex; align-items: center; gap: 8px; cursor: pointer; background: #fff;">
                        <input type="radio" name="checkoutPaymentMethod" value="Havale / EFT" onchange="togglePaymentFields(this.value)" />
                        <span style="font-size: 0.82rem; font-weight: 700;">🏦 Kurumsal Havale / EFT</span>
                    </label>
                    <label style="border: 1px solid #cbd5e1; border-radius: 6px; padding: 10px; display: flex; align-items: center; gap: 8px; cursor: pointer; background: #fff;">
                        <input type="radio" name="checkoutPaymentMethod" value="Cari Hesap / Vadeli" onchange="togglePaymentFields(this.value)" />
                        <span style="font-size: 0.82rem; font-weight: 700;">📄 30/60 Gün Vadeli Çek</span>
                    </label>
                    <label style="border: 1px solid #cbd5e1; border-radius: 6px; padding: 10px; display: flex; align-items: center; gap: 8px; cursor: pointer; background: #fff;">
                        <input type="radio" name="checkoutPaymentMethod" value="DBS" onchange="togglePaymentFields(this.value)" />
                        <span style="font-size: 0.82rem; font-weight: 700;">🛡️ DBS (Doğrudan Borçl.)</span>
                    </label>
                </div>

                <!-- Kart Bilgileri Alanı (Simülasyon) -->
                <div id="paymentCreditCardFields" style="background: #fff; border: 1px solid #e2e8f0; border-radius: 6px; padding: 10px; margin-top: 8px;">
                    <div style="margin-bottom: 8px;">
                        <label style="font-size: 0.72rem; font-weight: 700; color: #64748b;">Kart Üzerindeki İsim</label>
                        <input type="text" class="form-control" placeholder="Ad Soyad veya Şirket Adı" style="font-size: 0.82rem;" />
                    </div>
                    <div style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 8px;">
                        <div>
                            <label style="font-size: 0.72rem; font-weight: 700; color: #64748b;">Kart Numarası</label>
                            <input type="text" class="form-control" placeholder="**** **** **** ****" style="font-size: 0.82rem;" />
                        </div>
                        <div>
                            <label style="font-size: 0.72rem; font-weight: 700; color: #64748b;">SKT</label>
                            <input type="text" class="form-control" placeholder="AA/YY" style="font-size: 0.82rem;" />
                        </div>
                        <div>
                            <label style="font-size: 0.72rem; font-weight: 700; color: #64748b;">CVV</label>
                            <input type="text" class="form-control" placeholder="***" style="font-size: 0.82rem;" />
                        </div>
                    </div>
                </div>

                <div id="paymentBankFields" style="display: none; font-size: 0.8rem; color: #0284c7; background: #e0f2fe; padding: 10px; border-radius: 6px; margin-top: 8px;">
                    ℹ️ Sipariş onayınız sonrası resmi <strong>Proforma Fatura</strong> ve şirket IBAN bilgilerimiz sistem ve e-posta ile iletilecektir.
                </div>
            </div>

            <!-- Sipariş Özeti ve Butonlar -->
            <div style="background: #0f172a; color: #fff; border-radius: 8px; padding: 14px 18px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <span style="font-size: 0.78rem; color: #94a3b8; display: block;">Ödenecek Toplam Tutar (KDV Dahil):</span>
                    <strong id="checkoutModalGrandTotalText" style="font-size: 1.3rem; color: #38bdf8;">0 ₺</strong>
                </div>
                <div style="font-size: 0.78rem; color: #94a3b8; text-align: right;">
                    <span id="checkoutModalItemCount">0 Kalem</span><br/>
                    🔒 256-Bit SSL Kurumsal Güvenlik
                </div>
            </div>

            <div style="display: flex; gap: 10px;">
                <button type="button" class="btn-cancel" style="flex: 1; border-radius: 8px;" onclick="closeCheckoutModal()">Vazgeç</button>
                <button type="submit" id="btnSubmitOrder" class="b2b-btn-submit-order">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>✓ Siparişi Onayla ve Satın Al</span>
                </button>
            </div>
        </form>
    </div>
</div>

