@{
    ViewData["Title"] = "Ana Sayfa - B2B Kurumsal Tedarik Portalı";
}

@functions {
    public static Microsoft.AspNetCore.Html.IHtmlContent RenderVitrinCategoryTree(satinalmaportali2.Controllers.HierarchicalCategoryItem node, int level)
    {
        var hasChildren = node.Children != null && node.Children.Count > 0;
        var indent = level * 18;
        var encodedName = System.Net.WebUtility.HtmlEncode(node.CategoryName ?? "");
        var encodedPath = System.Net.WebUtility.HtmlEncode(node.BreadcrumbPath ?? "");
        var safeJsName = (node.CategoryName ?? "").Replace("'", "\\'");
        var safeJsPath = (node.BreadcrumbPath ?? "").Replace("'", "\\'");

        var sb = new System.Text.StringBuilder();
        sb.Append($"<div class=\"cat-tree-node level-{Math.Min(level, 3)}\" data-cat-id=\"{node.CategoryID}\" data-cat-name=\"{encodedName.ToLowerInvariant()}\" data-cat-path=\"{encodedPath}\" style=\"margin-left: {indent}px;\">");
        sb.Append($"<div class=\"cat-node-row {(level == 0 ? "is-root" : "")}\" id=\"vitrinNodeRow-{node.CategoryID}\" onclick=\"selectVitrinCategory({node.CategoryID}, '{safeJsName}', '{safeJsPath}')\" title=\"'{encodedPath}'\">");
        sb.Append("<div class=\"cat-node-left\">");

        if (hasChildren)
        {
            sb.Append($"<button type=\"button\" class=\"cat-toggle-btn\" onclick=\"event.stopPropagation(); toggleVitrinCatTreeBranch(this, 'vitrin-branch-{node.CategoryID}')\" title=\"Genişlet / Daralt\"><svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" class=\"toggle-icon\"><polyline points=\"6 9 12 15 18 9\"></polyline></svg></button>");
        }
        else
        {
            sb.Append("<span class=\"cat-tree-bullet\">•</span>");
        }

        sb.Append($"<span class=\"cat-node-title\">{encodedName}</span>");
        sb.Append("</div>");
        sb.Append("</div>");

        if (hasChildren && node.Children != null)
        {
            sb.Append($"<div class=\"cat-children-wrap\" id=\"vitrin-branch-{node.CategoryID}\">");
            foreach (var child in node.Children)
            {
                sb.Append(RenderVitrinCategoryTree(child, level + 1).ToString());
            }
            sb.Append("</div>");
        }

        sb.Append("</div>");
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }

    public static Microsoft.AspNetCore.Html.IHtmlContent RenderSuperAdminTree(satinalmaportali2.Controllers.HierarchicalCategoryItem node, int level)
    {
        var hasChildren = node.Children != null && node.Children.Count > 0;
        var indent = level * 16;
        var encodedName = System.Net.WebUtility.HtmlEncode(node.CategoryName ?? "");
        var encodedPath = System.Net.WebUtility.HtmlEncode(node.BreadcrumbPath ?? "");
        var safeJsName = (node.CategoryName ?? "").Replace("'", "\\'");
        var safeJsPath = (node.BreadcrumbPath ?? "").Replace("'", "\\'");

        var sb = new System.Text.StringBuilder();
        sb.Append($"<div class=\"cat-tree-node level-{Math.Min(level, 3)}\" data-cat-id=\"{node.CategoryID}\" data-cat-name=\"{encodedName.ToLowerInvariant()}\" data-cat-path=\"{encodedPath}\" style=\"margin-left: {indent}px; margin-bottom: 2px;\">");
        sb.Append($"<div class=\"cat-node-row {(level == 0 ? "is-root" : "")}\" onclick=\"selectCatFromTree({node.CategoryID}, '{safeJsName}', '{safeJsPath}')\" title=\"'{encodedPath}'\">");
        sb.Append("<div class=\"cat-node-left\">");
        sb.Append("<span class=\"cat-tree-bullet\">•</span>");
        sb.Append($"<span class=\"cat-node-title\">{encodedName}</span>");
        sb.Append("</div>");
        sb.Append("</div>");

        if (hasChildren && node.Children != null)
        {
            sb.Append($"<div class=\"cat-children-wrap\" id=\"picker-branch-{node.CategoryID}\">");
            foreach (var child in node.Children)
            {
                sb.Append(RenderSuperAdminTree(child, level + 1).ToString());
            }
            sb.Append("</div>");
        }

        sb.Append("</div>");
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }
}

<!-- SECTION 1: TOP HERO HEADER AREA -->
<section class="blue-hero-container">
    <div class="hero-inner">
        <h1 class="hero-heading">Tedarik Portalı</h1>
        <p class="hero-subtext">
            Türkiye'nin 81 ilindeki kurumsal alıcıları ve doğrulanmış sanayi tedarikçilerini tek çatı altında buluşturan B2B satın alma & teklif pazaryeri.
        </p>

        <!-- Hero Action Controls -->
        <div class="hero-control-row">
            <a asp-controller="Dashboard" asp-action="Index" class="btn-create-pill">
                <span class="plus-symbol">+</span> Yeni Satınalma Talebi Aç
            </a>

            <div class="white-search-pill">
                <input type="text" id="heroSearchInput" placeholder="Endüstriyel ürün, malzeme, SKU veya tedarikçi ara..." onkeydown="if(event.key==='Enter'){ document.getElementById('vitrinSearchInput').value=this.value; document.getElementById('vitrinSearchInput').dispatchEvent(new Event('input')); document.getElementById('ihtiyaciniz-olan-urunler').scrollIntoView({behavior:'smooth'}); }" />
                <button class="blue-search-btn" title="Arama Yap" onclick="document.getElementById('vitrinSearchInput').value=document.getElementById('heroSearchInput').value; document.getElementById('vitrinSearchInput').dispatchEvent(new Event('input')); document.getElementById('ihtiyaciniz-olan-urunler').scrollIntoView({behavior:'smooth'});">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</section>

