@{
    ViewData["Title"] = "Ana Sayfa";
}

<!-- SECTION 1: TOP HERO HEADER AREA -->
<section class="blue-hero-container">
    <div class="hero-inner">
        <h1 class="hero-heading">Tedarik Portalı</h1>
        <p class="hero-subtext">
            Türkiye'nin 81 ilindeki alıcılara ve tedarikçilere tek platformdan ulaşın, satın alma ve satış teklifi süreçlerinizi dijital ortamda yönetin.
        </p>

        <!-- Hero Action Controls -->
        <div class="hero-control-row">
            <button class="btn-create-pill">
                <span class="plus-symbol">+</span> Yeni Talep Oluştur
            </button>

            <div class="white-search-pill">
                <input type="text" placeholder="Ürünler içerisinde ara..." />
                <button class="blue-search-btn" title="Arama Yap">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</section>

<!-- SECTION 2: DUAL COLUMN CARDS (YENİ ALIŞ & YENİ SATIŞ TALEPLERİ) -->
<section class="cards-grid-section">
    <div class="cards-grid-container">

        <!-- LEFT COLUMN: YENİ ALIŞ TALEPLERİ -->
        <div class="column-white-card min-h-300">
            <div class="col-head">
                <div class="col-head-title">
                    <span class="blue-accent-x">✕</span>
                    <h2>Yeni Alış Talepleri</h2>
                </div>
                <a href="#tum-alis" class="link-all">Tüm Talepler</a>
            </div>

            <!-- Empty Container Body -->
            <div class="cards-stack empty-container-area">
            </div>
        </div>

        <!-- RIGHT COLUMN: YENİ SATIŞ TALEPLERİ -->
        <div class="column-white-card min-h-300">
            <div class="col-head">
                <div class="col-head-title">
                    <span class="blue-accent-x">✕</span>
                    <h2>Yeni Satış Talepleri</h2>
                </div>
                <a href="#tum-satis" class="link-all">Tüm Talepler</a>
            </div>

            <!-- Empty Container Body -->
            <div class="cards-stack empty-container-area">
            </div>
        </div>

    </div>
</section>

<!-- SECTION 3: DUAL COLUMN CONTAINERS (YENİ ALICILAR & YENİ TEDARİKÇİLER) -->
<section class="cards-grid-section mt-4">
    <div class="cards-grid-container">

        <!-- LEFT COLUMN: YENİ ALICILAR -->
        <div class="column-white-card min-h-300">
            <div class="col-head">
                <div class="col-head-title">
                    <span class="blue-accent-x">✕</span>
                    <h2>Yeni Alıcılar</h2>
                </div>
            </div>

            <!-- Empty Container Body -->
            <div class="cards-stack empty-container-area">
            </div>
        </div>

        <!-- RIGHT COLUMN: YENİ TEDARİKÇİLER -->
        <div class="column-white-card min-h-300">
            <div class="col-head">
                <div class="col-head-title">
                    <span class="blue-accent-x">✕</span>
                    <h2>Yeni Tedarikçiler</h2>
                </div>
            </div>

            <!-- Empty Container Body -->
            <div class="cards-stack empty-container-area">
            </div>
        </div>

    </div>
</section>

<!-- SECTION 4: STATS METRIC CARDS (RIGHT ABOVE FOOTER) -->
<section class="stats-section mt-5">
    <div class="stats-container">
        <div class="stats-grid">

            <!-- Stat Card 1 -->
            <div class="metric-card">
                <div class="metric-icon-badge">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                    </svg>
                </div>
                <div class="metric-number">350+</div>
                <div class="metric-label">Kayıtlı Alıcı</div>
            </div>

            <!-- Stat Card 2 -->
            <div class="metric-card">
                <div class="metric-icon-badge">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="8" y1="6" x2="21" y2="6"></line>
                        <line x1="8" y1="12" x2="21" y2="12"></line>
                        <line x1="8" y1="18" x2="21" y2="18"></line>
                        <line x1="3" y1="6" x2="3.01" y2="6"></line>
                        <line x1="3" y1="12" x2="3.01" y2="12"></line>
                        <line x1="3" y1="18" x2="3.01" y2="18"></line>
                    </svg>
                </div>
                <div class="metric-number">250+</div>
                <div class="metric-label">Kayıtlı Tedarikçi</div>
            </div>

            <!-- Stat Card 3 -->
            <div class="metric-card">
                <div class="metric-icon-badge">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                </div>
                <div class="metric-number">400+</div>
                <div class="metric-label">Satın Alma Talebi</div>
            </div>

            <!-- Stat Card 4 -->
            <div class="metric-card">
                <div class="metric-icon-badge">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                </div>
                <div class="metric-number">300+</div>
                <div class="metric-label">Satış Talebi</div>
            </div>

            <!-- Stat Card 5 -->
            <div class="metric-card">
                <div class="metric-icon-badge">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                </div>
                <div class="metric-number">1M</div>
                <div class="metric-label">Hazır Ürün Portföyü</div>
            </div>

        </div>
    </div>
</section>
