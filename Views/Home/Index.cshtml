                        </div>
                        <div>
                            <label class="b2b-input-label" for="checkoutReceiverPhone">
                                <span>Yetkili / Alıcı Telefonu</span>
                                <span id="checkoutPhoneCounter" class="b2b-input-helper-badge">0/10 Hane</span>
                            </label>
                            <div class="b2b-phone-input-wrap">
                                <span class="b2b-phone-flag-prefix">🇹🇷 +90</span>
                                <input type="tel" id="checkoutReceiverPhone" class="b2b-phone-input-field" placeholder="5XX XXX XX XX" maxlength="10" inputmode="numeric" oninput="formatPhoneInput(this)" />
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="b2b-input-label" for="checkoutDeliveryAddress">
                            <span>Fabrika / Depo / Şantiye Açık Adresi *</span>
                            <span style="color: #ef4444; font-size: 0.70rem;">Zorunlu</span>
                        </label>
                        <textarea id="checkoutDeliveryAddress" class="b2b-custom-input" rows="2" style="height: auto; min-height: 56px; resize: vertical;" placeholder="Fabrika No, Blok, Mal Kabul Girişi veya Şantiye Adresi..." required></textarea>
                    </div>
                </div>

                <!-- Adım 3: Kurumsal Ödeme Yöntemi -->
                <div class="b2b-checkout-step">
                    <div class="b2b-step-header">
                        <h4 class="b2b-step-title">
                            <span class="b2b-step-num-badge">3</span>
                            <span>💳 Kurumsal Ödeme Yöntemi</span>
                        </h4>
                        <span class="b2b-input-helper-badge">Güvenli 3D & DBS Altyapı</span>
                    </div>

                    <div class="b2b-paymethods-grid">
                        <label class="b2b-paymethod-card is-selected" onclick="selectPaymentMethod('Kredi Kartı', this)">
                            <input type="radio" name="checkoutPaymentMethod" value="Kredi Kartı" checked onchange="togglePaymentFields(this.value)" />
                            <div class="b2b-paymethod-info">
                                <span class="b2b-paymethod-title">💳 Kredi / Şirket Kartı</span>
                                <span class="b2b-paymethod-desc">3D Secure ile Anında Onay</span>
                            </div>
                        </label>

                        <label class="b2b-paymethod-card" onclick="selectPaymentMethod('Havale / EFT', this)">
                            <input type="radio" name="checkoutPaymentMethod" value="Havale / EFT" onchange="togglePaymentFields(this.value)" />
                            <div class="b2b-paymethod-info">
                                <span class="b2b-paymethod-title">🏦 Kurumsal Havale / EFT</span>
                                <span class="b2b-paymethod-desc">Proforma Fatura ile Ödeme</span>
                            </div>
                        </label>

                        <label class="b2b-paymethod-card" onclick="selectPaymentMethod('Cari Hesap / Vadeli', this)">
                            <input type="radio" name="checkoutPaymentMethod" value="Cari Hesap / Vadeli" onchange="togglePaymentFields(this.value)" />
                            <div class="b2b-paymethod-info">
                                <span class="b2b-paymethod-title">📄 30/60 Gün Vadeli Çek</span>
                                <span class="b2b-paymethod-desc">Kurumsal Cari Sözleşme</span>
                            </div>
                        </label>

                        <label class="b2b-paymethod-card" onclick="selectPaymentMethod('DBS', this)">
                            <input type="radio" name="checkoutPaymentMethod" value="DBS" onchange="togglePaymentFields(this.value)" />
                            <div class="b2b-paymethod-info">
                                <span class="b2b-paymethod-title">🛡️ DBS (Doğrudan Borçl.)</span>
                                <span class="b2b-paymethod-desc">Banka Limit Garantili</span>
                            </div>
                        </label>
                    </div>

                    <!-- Kredi Kartı Alanı -->
                    <div id="paymentCreditCardFields" class="b2b-card-box">
                        <div class="b2b-card-visual-header">
                            <span style="font-size: 0.76rem; font-weight: 700; color: #475569;">Kart Bilgileri</span>
                            <span id="cardTypeBadge" class="b2b-card-type-badge">💳 3D SECURE &amp; İYZİCO HAVUZ</span>
                        </div>

                        <!-- iyzico Escrow Bilgilendirme Rozeti -->
                        <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 10px 12px; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                            <span style="font-size: 1.2rem;">🛡️</span>
                            <div style="font-size: 0.76rem; color: #166534; line-height: 1.35;">
                                <strong>B2B Güvenli Havuz (Escrow) Garantisi:</strong><br />
                                Ödemeniz satıcıya hemen aktarılmaz; ürün teslim edilip onaylayana kadar <strong>iyzico güvence havuzunda</strong> bloke edilir.
                            </div>
                        </div>

                        <div style="margin-bottom: 10px;">
                            <label class="b2b-input-label" style="margin-bottom: 3px;">Kart Üzerindeki İsim</label>
                            <input type="text" id="checkoutCardHolder" class="b2b-custom-input" placeholder="Ad Soyad veya Şirket Ünvanı" oninput="formatCardHolderInput(this)" style="text-transform: uppercase;" />
                        </div>

                        <div style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 10px;">
                            <div>
                                <label class="b2b-input-label" style="margin-bottom: 3px;">Kart Numarası (16 Hane)</label>
                                <input type="text" id="checkoutCardNumber" class="b2b-custom-input" placeholder="5528 7900 0000 0008" maxlength="19" inputmode="numeric" oninput="formatCardNumberInput(this)" style="font-family: monospace; font-weight: 700; letter-spacing: 0.06em;" />
                            </div>
                            <div>
                                <label class="b2b-input-label" style="margin-bottom: 3px;">SKT (AA/YY)</label>
                                <input type="text" id="checkoutCardExpiry" class="b2b-custom-input" placeholder="12/28" maxlength="5" inputmode="numeric" oninput="formatExpiryInput(this)" style="font-family: monospace; text-align: center;" />
                            </div>
                            <div>
                                <label class="b2b-input-label" style="margin-bottom: 3px;">CVV / CVC</label>
                                <input type="password" id="checkoutCardCvv" class="b2b-custom-input" placeholder="***" maxlength="3" inputmode="numeric" oninput="formatCvvInput(this)" style="font-family: monospace; text-align: center;" />
                            </div>
                        </div>
                    </div>

                    <!-- Havale/EFT Bilgilendirme Alanı -->
                    <div id="paymentBankFields" style="display: none; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; padding: 14px; margin-top: 10px;">
                        <div style="display: flex; gap: 10px; align-items: flex-start;">
                            <span style="font-size: 1.4rem;">🏦</span>
                            <div style="font-size: 0.82rem; color: #1e40af; line-height: 1.45;">
                                <strong style="color: #1e3a8a; display: block; margin-bottom: 4px;">Kurumsal Havale / EFT Talimatı</strong>
                                Sipariş onayınızın ardından resmi <strong>Proforma Fatura</strong> ve şirket banka IBAN hesaplarımız otomatik olarak sistem ve e-posta adresinize iletilecektir.
                            </div>
                        </div>
                    </div>

                    <!-- Vadeli Çek / DBS Bilgilendirme Alanı -->
                    <div id="paymentCheckFields" style="display: none; background: #fefce8; border: 1px solid #fef08a; border-radius: 10px; padding: 14px; margin-top: 10px;">
                        <div style="display: flex; gap: 10px; align-items: flex-start;">
                            <span style="font-size: 1.4rem;">📄</span>
                            <div style="font-size: 0.82rem; color: #854d0e; line-height: 1.45;">
                                <strong style="color: #713f12; display: block; margin-bottom: 4px;">Kurumsal Vadeli / DBS Süreci</strong>
                                Siparişiniz onaylandıktan sonra finans departmanımız firmanızın tanımlı kurumsal kredi/DBS limiti üzerinden cari işleminizi tamamlayacaktır.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sipariş Özeti ve Tutar Şeridi -->
                <div class="b2b-checkout-summary-box">
                    <div>
                        <span style="font-size: 0.78rem; color: #94a3b8; display: block;">Ödenecek Toplam Tutar (KDV Dahil):</span>
                        <strong id="checkoutModalGrandTotalText" class="b2b-checkout-summary-amount">0 ₺</strong>
                    </div>
                    <div style="text-align: right; font-size: 0.78rem; color: #94a3b8;">
                        <span id="checkoutModalItemCount" style="color: #ffffff; font-weight: 700;">0 Kalem</span><br />
                        <span style="color: #10b981; font-weight: 600;">🔒 256-Bit SSL &amp; 3D Secure</span>
                    </div>
                </div>

                <!-- Aksiyon Butonları -->
                <div class="b2b-checkout-actions">
                    <button type="button" class="b2b-btn-cancel-checkout" onclick="closeCheckoutModal()">Vazgeç</button>
                    <button type="submit" id="btnSubmitOrder" class="b2b-btn-confirm-checkout">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>✓ Siparişi Onayla ve Satın Al</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- ==================== SİPARİŞ BAŞARILI / ALINDI MODALI ==================== -->
<div id="b2bOrderSuccessModal" class="b2b-checkout-overlay" style="z-index: 999999;">
    <div class="b2b-success-dialog" role="dialog" aria-modal="true">
        <div class="b2b-success-icon-badge">✓</div>
        <span class="b2b-checkout-badge" style="background: #ecfdf5; color: #059669; border-color: #a7f3d0; margin-bottom: 8px;">SİPARİŞİNİZ ALINDI</span>
        <h3 class="b2b-success-title">Satın Alımınız Başarıyla Gerçekleşti!</h3>
        <p class="b2b-success-desc">
            Kurumsal siparişiniz satıcı tedarikçilere iletilmiş olup hazırlık ve faturalandırma aşamasına alınmıştır.
        </p>

        <div class="b2b-success-details-card">
            <div class="b2b-success-detail-row">
                <span>Sipariş Numarası:</span>
                <span class="b2b-order-code-badge" onclick="copyOrderNumber(this)" title="Kopyalamak için tıklayın">
                    <span id="successModalOrderNo">ORD-0000</span>
                    <span style="font-size: 0.72rem; color: #0369a1;">📋</span>
                </span>
            </div>
            <div class="b2b-success-detail-row">
                <span>Toplam Ödeme Tutarı:</span>
                <strong id="successModalTotal" style="font-size: 1.05rem; font-weight: 850; color: #059669;">0 ₺</strong>
            </div>
            <div class="b2b-success-detail-row">
                <span>Ödeme Yöntemi:</span>
                <span id="successModalPayMethod" style="font-weight: 700; color: #0f172a;">Kredi Kartı</span>
            </div>
            <div class="b2b-success-detail-row">
                <span>Sipariş Tarihi:</span>
                <span id="successModalDate" style="color: #64748b; font-size: 0.80rem;">Bugün</span>
            </div>
            <div class="b2b-success-detail-row" style="border-top: 1px dashed #cbd5e1; padding-top: 8px; margin-top: 2px;">
                <span>Tahmini Fabrika Sevkiyatı:</span>
                <span style="color: #0284c7; font-weight: 700;">🚚 1-3 İş Günü (Doğrudan Sevk)</span>
            </div>
        </div>

        <!-- Değerlendirme Aksiyon Alanı -->
        <div id="orderSuccessReviewActionWrap" style="margin-bottom: 12px; width: 100%;">
            <button type="button" id="btnSuccessReviewSingle" class="b2b-btn-success-primary" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); width: 100%; justify-content: center; padding: 11px 18px; font-weight: 800; display: none; margin-bottom: 8px; border: none; border-radius: 10px; color: #fff; cursor: pointer; box-shadow: 0 4px 14px rgba(245,158,11,0.35);" onclick="openSuccessSellerReviewModal()">
                ★ Satıcıyı Değerlendir
            </button>
            <a href="/Dashboard/Orders" id="btnSuccessReviewMultiple" class="b2b-btn-success-primary" style="background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); width: 100%; justify-content: center; padding: 11px 18px; font-weight: 800; display: none; margin-bottom: 8px; text-decoration: none; border-radius: 10px; color: #fff; text-align: center; box-shadow: 0 4px 14px rgba(37,99,235,0.35);">
                ★ Satıcıları Değerlendir (Siparişlerim) →
            </a>
        </div>

        <div class="b2b-success-actions-grid">
            <button type="button" class="b2b-btn-success-secondary" onclick="closeCheckoutModal(); window.location.href='/#ihtiyaciniz-olan-urunler';">
                🛍️ Alışverişe Devam Et
            </button>
            <a href="/Dashboard/Orders" class="b2b-btn-success-primary">
                📦 Siparişlerim →
            </a>
        </div>
    </div>
</div>

<!-- ==================== SİPARİŞ SONRASI SATICI DEĞERLENDİRME MODALI ==================== -->
<div id="orderSuccessRatingModal" class="ty-modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.7); backdrop-filter: blur(4px); z-index: 1000000; align-items: center; justify-content: center; padding: 20px;" onclick="if(event.target===this)closeSuccessSellerReviewModal()">
    <div class="ty-modal-box" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; width: 100%; max-width: 520px; padding: 26px; box-shadow: 0 25px 40px -5px rgba(0,0,0,0.3);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
            <div>
                <span class="status-badge" style="background: #eff6ff; color: #1d4ed8; font-size: 0.72rem; padding: 3px 8px; border-radius: 6px; font-weight: 800;">DOĞRULANMIŞ SATINALMA</span>
                <h3 id="successRateModalSellerTitle" style="font-size: 1.25rem; font-weight: 800; color: #0f172a; margin-top: 6px; margin-bottom: 2px;">Satıcıyı Değerlendir</h3>
                <small style="color: #64748b; font-size: 0.8rem;">Bu değerlendirme satıcının onaylı kurumsal profiline ve karne istatistiklerine yansıyacaktır.</small>
            </div>
            <button type="button" onclick="closeSuccessSellerReviewModal()" style="border: none; background: transparent; font-size: 1.3rem; cursor: pointer; color: #64748b;">&times;</button>
        </div>

        <form id="successRateModalForm" onsubmit="submitSuccessSellerReview(event)">
            <input type="hidden" id="successRateModalOrderID" />
            <input type="hidden" id="successRateModalSupplierCompanyID" />
            <input type="hidden" id="successRateModalSupplierName" />
            <input type="hidden" id="successRateModalScore" value="10" />

            <!-- 10 Yıldız Seçici -->
            <div style="text-align: center; margin-bottom: 16px; background: rgba(245,158,11,0.06); padding: 14px; border-radius: 12px; border: 1px solid rgba(245,158,11,0.18);">
                <label style="display: block; font-size: 0.84rem; font-weight: 750; color: #0f172a; margin-bottom: 6px;">Satıcı Genel Memnuniyet Puanı (10 Yıldız)</label>
                <div style="display: flex; justify-content: center; gap: 4px;" id="successStarPickerWrap">
                    @for (int i = 1; i <= 10; i++)
                    {
                        <button type="button" class="btn-star-pick-success" data-val="@i" onclick="pickSuccessScore(@i)" onmouseenter="previewSuccessScore(@i)" onmouseleave="restoreSuccessScore()" style="background: none; border: none; font-size: 1.8rem; color: #f59e0b; cursor: pointer; padding: 2px; transition: transform 0.15s;">★</button>
                    }
                </div>
                <div id="successScoreText" style="font-size: 1.05rem; font-weight: 800; color: #d97706; margin-top: 6px;">★ 10.0 / 10 - Mükemmel</div>
            </div>

            <!-- Alt Kriterler (10 Üzerinden) -->
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-bottom: 14px;">
                <div>
                    <label style="font-size: 0.74rem; font-weight: 700; color: #334155; display: block; margin-bottom: 4px;">🚚 Teslimat Hızı</label>
                    <input type="number" id="successRateDelivery" class="form-control" value="10" min="1" max="10" step="0.5" style="font-size: 0.85rem; padding: 6px 10px;" />
                </div>
                <div>
                    <label style="font-size: 0.74rem; font-weight: 700; color: #334155; display: block; margin-bottom: 4px;">📦 Ürün Kalitesi</label>
                    <input type="number" id="successRateQuality" class="form-control" value="10" min="1" max="10" step="0.5" style="font-size: 0.85rem; padding: 6px 10px;" />
                </div>
                <div>
                    <label style="font-size: 0.74rem; font-weight: 700; color: #334155; display: block; margin-bottom: 4px;">💬 İletişim / Süreç</label>
                    <input type="number" id="successRateComm" class="form-control" value="10" min="1" max="10" step="0.5" style="font-size: 0.85rem; padding: 6px 10px;" />
                </div>
            </div>

            <!-- Yorum -->
            <div class="form-group" style="margin-bottom: 18px;">
                <label style="font-size: 0.82rem; font-weight: 700; color: #334155; display: block; margin-bottom: 4px;">Yorumunuz (Opsiyonel)</label>
                <textarea id="successRateComment" class="form-control" rows="3" placeholder="Teslimat süreci, ambalaj ve şartnameye uygunluk nasıldı?" style="font-size: 0.85rem; border-radius: 8px;"></textarea>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button type="button" class="btn-cancel" onclick="closeSuccessSellerReviewModal()">Vazgeç</button>
                <button type="submit" id="btnSubmitSuccessReview" class="btn-primary" style="padding: 10px 20px; font-weight: 750; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border: none; border-radius: 8px; color: #fff; cursor: pointer;">
                    Değerlendir &amp; Gönder
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ==================== İYZİCO 3D SECURE MODALI ==================== -->
<div id="iyzico3DModal" class="b2b-checkout-overlay" style="display: none; z-index: 1000002;">
    <div style="background: #fff; border-radius: 16px; width: 100%; max-width: 680px; max-height: 90vh; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.35); display: flex; flex-direction: column;">
        <div style="padding: 16px 20px; background: #0f172a; color: #fff; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 1.2rem;">🔒</span>
                <strong style="font-size: 0.95rem;">Banka 3D Secure Doğrulama Ekranı</strong>
            </div>
            <button type="button" onclick="closeIyzico3DModal()" style="background: none; border: none; color: #94a3b8; font-size: 1.4rem; cursor: pointer;">&times;</button>
        </div>
        <div id="iyzico3DFrameContainer" style="flex: 1; min-height: 520px; width: 100%; position: relative; background: #f8fafc;">
            <!-- 3D Secure HTML form / iframe dinamik basılır -->
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/trendyol-vitrin.js" asp-append-version="true"></script>
}

