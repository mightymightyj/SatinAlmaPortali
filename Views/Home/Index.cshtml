            <div class="metric-card">
                <div class="metric-icon-badge">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                </div>
                <div class="metric-number">@(ViewBag.CompletedOffersCount ?? 0)</div>
                <div class="metric-label">Tamamlanan Kurumsal Teklif</div>
            </div>

            <!-- Stat Card 5 -->
            <div class="metric-card">
                <div class="metric-icon-badge">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                </div>
                <div class="metric-number">@(ViewBag.TotalItemsCount ?? 0)</div>
                <div class="metric-label">Endüstriyel Ürün Portföyü</div>
            </div>

        </div>
    </div>
</section>

<!-- MODAL 1: HIZLI ŞARTNAME VE TEKNİK DETAY MODALI -->
<div id="tyQuickViewModal" class="ty-modal-overlay" onclick="if(event.target===this)closeTyModal('tyQuickViewModal')">
    <div class="ty-modal-box">
        <button type="button" class="ty-modal-close" onclick="closeTyModal('tyQuickViewModal')">&times;</button>
        <div class="ty-qv-grid">
            <div class="ty-qv-img-box">
                <img id="qvModalImage" src="" alt="Ürün Görseli" />
            </div>
            <div class="ty-qv-details">
                <div class="ty-qv-header-tag" id="qvModalCategory">Endüstriyel Kategori</div>
                <h3 class="ty-qv-title" id="qvModalTitle">Ürün Teknik Başlığı</h3>
                
