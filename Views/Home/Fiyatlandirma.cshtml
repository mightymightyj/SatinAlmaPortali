                        <span>Planlara Geri Dön</span>
                        <i class="fa-solid fa-arrow-up text-xs"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>

</div>

<!-- ==================== ADRESSİZ ÜYELİK SATIN ALMA MODALI (TAILWIND) ==================== -->
<div id="membershipCheckoutModal" class="fixed inset-0 z-[100000] hidden items-center justify-center p-3 sm:p-4 bg-slate-950/70 backdrop-blur-sm" onclick="if(event.target===this)closeMembershipCheckoutModal()">
    <div class="bg-white rounded-2xl sm:rounded-3xl max-w-md w-full shadow-2xl border border-slate-200 overflow-hidden transform transition-all max-h-[92vh] flex flex-col">
        <!-- Modal Başlık -->
        <div class="p-4 sm:p-6 bg-slate-50 border-b border-slate-200 flex items-start justify-between shrink-0">
            <div>
                <span class="inline-block text-[10px] sm:text-[11px] font-extrabold uppercase tracking-wider bg-blue-100 text-blue-700 px-2.5 py-0.5 rounded-md mb-1 sm:mb-1.5">
                    Dijital Üyelik Paketi
                </span>
                <h3 id="memModalPlanTitle" class="text-lg sm:text-xl font-bold text-slate-900">Pro Üyelik Satın Al</h3>
                <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5 sm:mt-1">Adres gerekmeksizin kart bilgilerinizle anında plan yükseltin.</p>
            </div>
            <button type="button" class="w-8 h-8 rounded-full bg-slate-200/70 hover:bg-slate-300 text-slate-500 flex items-center justify-center text-lg leading-none transition-colors shrink-0" onclick="closeMembershipCheckoutModal()" title="Kapat">
                &times;
            </button>
        </div>

        <form id="membershipPurchaseForm" onsubmit="submitMembershipPurchase(event); return false;" class="flex-1 overflow-y-auto flex flex-col">
            <input type="hidden" id="memTargetTierId" value="2" />
            <input type="hidden" id="memPlanPrice" value="990" />

            <div class="p-4 sm:p-6 space-y-3.5 sm:space-y-4 flex-1">
                <!-- Paket Özet Şeridi -->
                <div class="p-3.5 sm:p-4 rounded-xl sm:rounded-2xl bg-slate-50 border border-slate-200">
                    <div class="flex justify-between items-center">
                        <div>
                            <span class="text-[11px] sm:text-xs text-slate-500 block">Seçilen Plan:</span>
                            <strong id="memSummaryPlanName" class="text-sm sm:text-base font-bold text-slate-900">Pro Plan</strong>
                        </div>
                        <div class="text-right">
                            <span class="text-[11px] sm:text-xs text-slate-500 block">Aylık Tutar:</span>
                            <strong id="memSummaryPlanPrice" class="text-base sm:text-lg font-black text-blue-600">990 ₺</strong>
                        </div>
                    </div>
                    <div id="memSummaryFeatures" class="mt-2.5 sm:mt-3 pt-2.5 sm:pt-3 border-t border-dashed border-slate-200 text-[11px] sm:text-xs text-slate-600">
                        ✓ 100 Aktif Talep &bull; 100 Ürün Satışı &bull; Ürün Başı 20 Resim
                    </div>
                </div>

                <!-- Bilgilendirme Notu: Adres Sorulmaz -->
                <div class="p-3 sm:p-3.5 rounded-xl bg-blue-50 border border-blue-200 flex items-start gap-2.5 sm:gap-3 text-xs text-blue-900">
                    <i class="fa-solid fa-circle-info text-blue-600 text-sm sm:text-base shrink-0 mt-0.5"></i>
                    <div>
                        <strong class="font-bold">Fiziksel Adres Bilgisi Gerekmez</strong><br />
                        Bu üyelik dijital lisans paketidir. Kargo, ambar veya adres doldurmanız gerekmez.
                    </div>
                </div>

                <!-- Kart Bilgileri Alanı -->
                <div class="space-y-3 pt-1">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1" for="memCardHolder">Kart Üzerindeki İsim *</label>
                        <input type="text" id="memCardHolder" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none text-slate-900 text-xs sm:text-sm uppercase placeholder:text-slate-400" placeholder="AD SOYAD VEYA ŞİRKET ÜNVANI" required />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1" for="memCardNumber">Kart Numarası (16 Hane) *</label>
                        <input type="text" id="memCardNumber" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none text-slate-900 text-xs sm:text-sm font-mono font-bold tracking-wider placeholder:text-slate-400" placeholder="5528 7900 0000 0008" maxlength="19" inputmode="numeric" oninput="formatCardNum(this)" required />
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1" for="memCardExpiry">Son Kullanma (AA/YY) *</label>
                            <input type="text" id="memCardExpiry" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none text-slate-900 text-xs sm:text-sm font-mono text-center placeholder:text-slate-400" placeholder="12/28" maxlength="5" inputmode="numeric" oninput="formatExp(this)" required />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1" for="memCardCvv">CVC / CVV (3 Hane) *</label>
                            <input type="password" id="memCardCvv" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none text-slate-900 text-xs sm:text-sm font-mono text-center placeholder:text-slate-400" placeholder="***" maxlength="3" inputmode="numeric" required />
                        </div>
                    </div>
                </div>
            </div>

            <div class="p-4 sm:p-6 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row items-stretch sm:items-center justify-end gap-2.5 sm:gap-3 shrink-0">
                <button type="button" class="w-full sm:w-auto px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold border border-slate-300 bg-white hover:bg-slate-100 text-slate-700 transition-colors" onclick="closeMembershipCheckoutModal()">
                    Vazgeç
                </button>
                <button type="submit" id="btnSubmitMembership" class="w-full sm:w-auto px-5 sm:px-6 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-blue-600 hover:bg-blue-500 text-white shadow-md shadow-blue-600/30 flex items-center justify-center gap-2 transition-all">
                    <span>✓</span> <span id="memBtnSubmitText">990 ₺ Ödemeyi Tamamla ve Yükselt</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openMembershipCheckoutModal(tierId, tierName, price) {
            document.getElementById('memTargetTierId').value = tierId;
            document.getElementById('memPlanPrice').value = price;
            document.getElementById('memModalPlanTitle').textContent = `${tierName} Üyelik Satın Al`;
            document.getElementById('memSummaryPlanName').textContent = `${tierName} Planı`;
            document.getElementById('memSummaryPlanPrice').textContent = `${price.toLocaleString('tr-TR')} ₺ / ay`;
            document.getElementById('memBtnSubmitText').textContent = `${price.toLocaleString('tr-TR')} ₺ Ödemeyi Tamamla ve Yükselt`;

            const feats = document.getElementById('memSummaryFeatures');
            if (tierId === 2) {
                feats.innerHTML = '✓ 100 Aktif Talep &bull; 100 Ürün Satışı &bull; Ürün Başı 20 Resim &bull; 7/24 Destek';
            } else if (tierId === 3) {
                feats.innerHTML = '✓ Sınırsız Talep &bull; Sınırsız Ürün Satışı &bull; Sınırsız Resim &bull; Onaylı Rozet';
            }

            const modal = document.getElementById('membershipCheckoutModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeMembershipCheckoutModal() {
            const modal = document.getElementById('membershipCheckoutModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function formatCardNum(input) {
            let val = input.value.replace(/\D/g, '').substring(0, 16);
            let parts = [];
            for (let i = 0; i < val.length; i += 4) {
                parts.push(val.substring(i, i + 4));
            }
            input.value = parts.join(' ');
        }

        function formatExp(input) {
            let val = input.value.replace(/\D/g, '').substring(0, 4);
            if (val.length >= 2) {
                input.value = val.substring(0, 2) + '/' + val.substring(2);
            } else {
                input.value = val;
            }
        }

        async function submitMembershipPurchase(e) {
            if (e) e.preventDefault();

            const tierId = parseInt(document.getElementById('memTargetTierId').value, 10);
            const cardHolder = (document.getElementById('memCardHolder').value || '').trim();
            const rawCardNo = (document.getElementById('memCardNumber').value || '').replace(/\D/g, '');
            const rawExp = (document.getElementById('memCardExpiry').value || '').trim();
            const cvv = (document.getElementById('memCardCvv').value || '').replace(/\D/g, '');

            if (!cardHolder) {
                alert('Lütfen kart üzerindeki isim alanını doldurunuz.');
                document.getElementById('memCardHolder').focus();
                return;
            }

            if (rawCardNo.length !== 16) {
                alert('Lütfen 16 haneli kart numaranızı eksiksiz giriniz.');
                document.getElementById('memCardNumber').focus();
                return;
            }

            if (rawExp.length < 5 || !rawExp.includes('/')) {
                alert('Lütfen Son Kullanma Tarihini AA/YY formatında giriniz (Örn: 12/28).');
                document.getElementById('memCardExpiry').focus();
                return;
            }

            if (cvv.length < 3) {
                alert('Lütfen 3 haneli CVV kodunu giriniz.');
                document.getElementById('memCardCvv').focus();
                return;
            }

            const expParts = rawExp.split('/');
            const month = expParts[0].trim();
            let year = expParts[1].trim();
            if (year.length === 2) year = '20' + year;

            const btn = document.getElementById('btnSubmitMembership');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span>⏳</span> İşlem Onaylanıyor...';

            try {
                const response = await fetch('/Payment/PurchaseMembership', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        targetMembershipTypeId: tierId,
                        cardInfo: {
                            cardHolderName: cardHolder,
                            cardNumber: rawCardNo,
                            expireMonth: month,
                            expireYear: year,
                            cvc: cvv
                        }
                    })
                });

                const data = await response.json();

                if (data.success) {
                    alert(data.message || 'Üyelik planınız başarıyla yükseltildi!');
                    closeMembershipCheckoutModal();
                    window.location.reload();
                } else {
                    if (data.requireLogin) {
                        alert(data.message);
                        window.location.href = '/Account/Login?returnUrl=/Home/Fiyatlandirma';
                    } else {
                        alert(data.message || 'Ödeme tamamlanamadı. Lütfen bilgilerinizi kontrol ediniz.');
                        btn.disabled = false;
                        btn.innerHTML = originalText;
                    }
                }
            } catch (err) {
                console.error(err);
                alert('Bağlantı hatası oluştu. Lütfen tekrar deneyiniz.');
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        }
    </script>
}