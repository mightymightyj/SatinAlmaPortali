@model satinalmaportali2.Models.PricingPageViewModel
@{
    ViewData["Title"] = "Üyelik Paketleri ve Fiyatlandırma";
    var currentTier = Model?.CurrentMembershipTypeId ?? 1;
}

<!-- HERO SECTION -->
<section class="fiyat-hero">
    <div class="fiyat-hero-inner">
        <div class="fiyat-badge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="1" x2="12" y2="23"></line>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
            <span>B2B Üyelik Seviyeleri</span>
        </div>
        <h1 class="fiyat-hero-title">İşletmenize Uygun <span class="highlight-dot">Üyelik Planları</span></h1>
        <p class="fiyat-hero-desc">
            Tedarik ve satış hacminize göre dilediğiniz üyelik planını seçin.
            Üyelik satın alımlarında fiziksel kargo veya <strong>adres bilgisi gerekmez</strong>; üyeliğiniz anında aktifleştirilir.
        </p>
        @if (Model != null && Model.IsAuthenticated)
        {
            <div style="display: inline-flex; align-items: center; gap: 8px; margin-top: 14px; background: rgba(2,132,199,0.12); border: 1px solid rgba(2,132,199,0.3); padding: 8px 18px; border-radius: 9999px; font-size: 0.88rem;">
                <span style="color: #0284c7; font-weight: 700;">🏢 @Model.CurrentCompanyName</span>
                <span style="color: #64748b;">— Aktif Planınız:</span>
                <strong style="color: #0f172a; background: #fff; padding: 2px 10px; border-radius: 9999px; border: 1px solid #cbd5e1;">@Model.CurrentMembershipTypeName</strong>
            </div>
        }
    </div>
</section>

<!-- FİYAT PLANLARI -->
<section class="fiyat-section">
    <div class="fiyat-container">
        <div class="fiyat-plans-grid">

            <!-- 1. BEDAVA PLAN -->
            <div class="fiyat-plan-card @(currentTier == 1 ? "current-tier-card" : "")">
                @if (currentTier == 1)
                {
                    <div class="fiyat-recommended-badge" style="background: #64748b; color: #fff;">Mevcut Planınız</div>
                }
                <div class="fiyat-plan-header">
                    <div class="fiyat-plan-icon fiyat-icon-starter">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                    </div>
                    <h3 class="fiyat-plan-name">Bedava</h3>
                    <p class="fiyat-plan-desc">Yeni başlayan işletmeler ve temel satın alma/satış operasyonları için.</p>
                </div>
                <div class="fiyat-price">
                    <span class="fiyat-currency">₺</span>
                    <span class="fiyat-amount">0</span>
                    <span class="fiyat-period">/ ay</span>
                </div>
                <ul class="fiyat-features">
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span><strong>Aynı anda 10 adet</strong> aktif talep</span>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span><strong>Aynı anda 10 adet</strong> ürün satışı</span>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>Her ürün için <strong>en fazla 3 resim</strong></span>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>Standart B2B tedarikçi vitrini</span>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>Teklif alma &amp; verme</span>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>E-posta desteği</span>
                    </li>
                </ul>

                @if (Model != null && Model.IsAuthenticated)
                {
                    if (currentTier == 1)
                    {
                        <button type="button" class="fiyat-cta-btn fiyat-cta-btn-outline" disabled style="opacity: 0.7; cursor: default;">
                            ✓ Aktif Planınız
                        </button>
                    }
                    else
                    {
                        <span class="fiyat-cta-btn fiyat-cta-btn-outline" style="opacity: 0.6; cursor: default; text-align: center;">
                            Temel Seviye
                        </span>
                    }
                }
                else
                {
                    <a href="/Account/Register" class="fiyat-cta-btn fiyat-cta-btn-outline">Ücretsiz Kayıt Ol</a>
                }
            </div>

            <!-- 2. PRO PLAN (ÖNERİLEN) -->
            <div class="fiyat-plan-card fiyat-recommended @(currentTier == 2 ? "current-tier-card" : "")">
                <div class="fiyat-recommended-badge">
                    @(currentTier == 2 ? "Mevcut Planınız" : "En Çok Tercih Edilen")
                </div>
                <div class="fiyat-plan-header">
                    <div class="fiyat-plan-icon fiyat-icon-pro">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                    </div>
                    <h3 class="fiyat-plan-name">Pro</h3>
                    <p class="fiyat-plan-desc">Büyüyen ve satış/tedarik hacmini hızlandırmak isteyen aktif firmalar için.</p>
                </div>
                <div class="fiyat-price">
                    <span class="fiyat-currency">₺</span>
                    <span class="fiyat-amount">990</span>
                    <span class="fiyat-period">/ ay</span>
                </div>
                <ul class="fiyat-features">
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span><strong>Aynı anda 100 adet</strong> aktif talep</span>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span><strong>Aynı anda 100 adet</strong> ürün satışı</span>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>Her ürün için <strong>20 resim hakkı</strong></span>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>B2B Vitrinde öne çıkarılan ürünler</span>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>Hızlı teklif verme &amp; anlık bildirimler</span>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>7/24 Öncelikli destek</span>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>Detaylı talep ve teklif analitiği</span>
                    </li>
                </ul>

                @if (Model != null && Model.IsAuthenticated)
                {
                    if (currentTier == 2)
                    {
                        <button type="button" class="fiyat-cta-btn fiyat-cta-btn-primary" disabled style="opacity: 0.8; cursor: default;">
                            ✓ Aktif Planınız
                        </button>
                    }
                    else
                    {
                        <button type="button" onclick="openMembershipCheckoutModal(2, 'Pro', 990)" class="fiyat-cta-btn fiyat-cta-btn-primary">
                            Pro Plana Geç →
                        </button>
                    }
                }
                else
                {
                    <a href="/Account/Login?returnUrl=/Home/Fiyatlandirma" class="fiyat-cta-btn fiyat-cta-btn-primary">Giriş Yap &amp; Satın Al</a>
                }
            </div>

            <!-- 3. KURUMSAL PLAN -->
            <div class="fiyat-plan-card @(currentTier == 3 ? "current-tier-card" : "")">
                @if (currentTier == 3)
                {
                    <div class="fiyat-recommended-badge" style="background: #0284c7; color: #fff;">Mevcut Planınız</div>
                }
                <div class="fiyat-plan-header">
                    <div class="fiyat-plan-icon fiyat-icon-enterprise">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                        </svg>
                    </div>
                    <h3 class="fiyat-plan-name">Kurumsal</h3>
                    <p class="fiyat-plan-desc">Büyük ölçekli üretici, distribütör ve yüksek hacimli kurumlar için tam güç.</p>
                </div>
                <div class="fiyat-price">
                    <span class="fiyat-currency">₺</span>
                    <span class="fiyat-amount">2.990</span>
                    <span class="fiyat-period">/ ay</span>
                </div>
                <ul class="fiyat-features">
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span><strong>Sınırsız</strong> talep oluşturma</span>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span><strong>Sınırsız</strong> ürün satışı ilanı</span>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>Her ürün için <strong>sınırsız resim</strong></span>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>🛡️ Onaylı Kurumsal Tedarikçi Rozeti</span>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>En üst sırada vitrin listelemesi</span>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>Özel B2B Müşteri Temsilcisi</span>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>SLA garantili 7/24 VIP destek</span>
                    </li>
                </ul>

                @if (Model != null && Model.IsAuthenticated)
                {
                    if (currentTier == 3)
                    {
                        <button type="button" class="fiyat-cta-btn fiyat-cta-btn-outline" disabled style="opacity: 0.8; cursor: default;">
                            ✓ Aktif Planınız
                        </button>
                    }
                    else
                    {
                        <button type="button" onclick="openMembershipCheckoutModal(3, 'Kurumsal', 2990)" class="fiyat-cta-btn fiyat-cta-btn-outline">
                            Kurumsal Plana Geç →
                        </button>
                    }
                }
                else
                {
                    <a href="/Account/Login?returnUrl=/Home/Fiyatlandirma" class="fiyat-cta-btn fiyat-cta-btn-outline">Giriş Yap &amp; Satın Al</a>
                }
            </div>

        </div>
    </div>
</section>

<!-- KARŞILAŞTIRMA TABLOSU -->
<section class="fiyat-section fiyat-section-alt">
    <div class="fiyat-container">
        <div class="blur-feature-card">
            <div class="blur-card-header">
                <div class="blur-icon-badge">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                </div>
                <div class="blur-card-title-group">
                    <span class="blur-card-tag">Limit &amp; Yetki Kıyaslaması</span>
                    <h2 class="blur-card-title">Üyelik Planı Karşılaştırması</h2>
                </div>
            </div>

            <div class="blur-card-content">
                <div class="fiyat-comparison-wrap">
                    <table class="fiyat-comparison-table">
                        <thead>
                            <tr>
                                <th class="fiyat-feature-col">Özellik / Yetki</th>
                                <th class="fiyat-plan-col">Bedava</th>
                                <th class="fiyat-plan-col fiyat-plan-col-highlight">Pro (Önerilen)</th>
                                <th class="fiyat-plan-col">Kurumsal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Aynı Anda Aktif Talep Limiti</td>
                                <td><strong>10 Adet</strong></td>
                                <td><strong>100 Adet</strong></td>
                                <td><span style="color: #16a34a; font-weight: 800;">Sınırsız</span></td>
                            </tr>
                            <tr>
                                <td>Aynı Anda Ürün Satış İlanı</td>
                                <td><strong>10 Adet</strong></td>
                                <td><strong>100 Adet</strong></td>
                                <td><span style="color: #16a34a; font-weight: 800;">Sınırsız</span></td>
                            </tr>
                            <tr>
                                <td>Ürün Başına Görsel Hakkı</td>
                                <td><strong>3 Resim</strong></td>
                                <td><strong>20 Resim</strong></td>
                                <td><span style="color: #16a34a; font-weight: 800;">Sınırsız</span></td>
                            </tr>
                            <tr>
                                <td>B2B Vitrinde Öne Çıkarılma</td>
                                <td>Standart</td>
                                <td>Öncelikli</td>
                                <td>En Üst Sıra</td>
                            </tr>
                            <tr>
                                <td>Teklif Karşılaştırma &amp; Değerlendirme</td>
                                <td>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                </td>
                                <td>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                </td>
                                <td>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                </td>
                            </tr>
                            <tr>
                                <td>Kurumsal Onaylı Tedarikçi Rozeti</td>
                                <td>—</td>
                                <td>—</td>
                                <td>
                                    <span style="color: #0284c7; font-weight: 700;">🛡️ Onaylı Rozet</span>
                                </td>
                            </tr>
                            <tr>
                                <td>Fiziksel Kargo / Adres Gereksinimi</td>
                                <td>Gerekmez (Dijital)</td>
                                <td>Gerekmez (Dijital)</td>
                                <td>Gerekmez (Dijital)</td>
                            </tr>
                            <tr>
                                <td>Destek Seviyesi</td>
                                <td>E-posta Desteği</td>
                                <td>7/24 Öncelikli Destek</td>
                                <td>Özel Temsilci &amp; SLA</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SSS -->
<section class="fiyat-section">
    <div class="fiyat-container">
        <div class="blur-feature-card">
            <div class="blur-card-header">
                <div class="blur-icon-badge">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                    </svg>
                </div>
                <div class="blur-card-title-group">
                    <span class="blur-card-tag">Yardım &amp; Destek</span>
                    <h2 class="blur-card-title">Sıkça Sorulan Sorular</h2>
                </div>
            </div>

            <div class="blur-card-content">
                <div class="fiyat-sss-list">
                    <details class="fiyat-sss-item">
                        <summary>
                            <span>Üyelik satın alırken adres girmem gerekir mi?</span>
                            <svg class="fiyat-sss-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </summary>
                        <div class="fiyat-sss-answer">
                            <p>
                                <strong>Hayır.</strong> Üyelik paketleri dijital abonelik statüsünde olduğu için kargo veya fiziksel adres bilgisi kesinlikle talep edilmez. Yalnızca kart bilgilerinizle ödemeyi tamamlayabilirsiniz; yeni planınız anında hesabınıza yansır.
                            </p>
                        </div>
                    </details>

                    <details class="fiyat-sss-item">
                        <summary>
                            <span>Talep ve ürün satışı sınırlarına ulaştığımda ne olur?</span>
                            <svg class="fiyat-sss-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </summary>
                        <div class="fiyat-sss-answer">
                            <p>
                                Bedava planda aynı anda 10 talep ve 10 ürün satışı, Pro planda ise 100 talep ve 100 ürün satış hakkınız vardır. Sınıra ulaştığınızda mevcut taleplerinizi tamamlayabilir veya doğrudan Pro / Kurumsal plana geçerek kapasitenizi anında artırabilirsiniz.
                            </p>
                        </div>
                    </details>

                    <details class="fiyat-sss-item">
                        <summary>
                            <span>Ürün başına görsel sınırı nasıl işler?</span>
                            <svg class="fiyat-sss-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </summary>
                        <div class="fiyat-sss-answer">
                            <p>
                                Bedava üyelikte her ürün ilanı için en fazla 3 görsel yüklenebilir. Pro üyeler ürün başına 20 görsel yükleyebilirken, Kurumsal üyelerimiz için herhangi bir görsel sınırı bulunmamaktadır.
                            </p>
                        </div>
                    </details>

                    <details class="fiyat-sss-item">
                        <summary>
                            <span>Ödeme yapıldıktan sonra üyeliğim ne zaman aktif olur?</span>
                            <svg class="fiyat-sss-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </summary>
                        <div class="fiyat-sss-answer">
                            <p>
                                Kart onayının hemen ardından sistem veritabanınız anlık olarak güncellenir ve yeni yetkileriniz sayfa yenilenmeden geçerli hale gelir.
                            </p>
                        </div>
                    </details>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==================== ADRESSİZ ÜYELİK SATIN ALMA MODALI ==================== -->
<div id="membershipCheckoutModal" class="mem-modal-overlay" style="display: none;" onclick="if(event.target===this)closeMembershipCheckoutModal()">
    <div class="mem-modal-dialog">
        <div class="mem-modal-header">
            <div>
                <span class="mem-badge-pill">DİJİTAL ÜYELİK PAKETİ</span>
                <h3 id="memModalPlanTitle" class="mem-modal-title">Pro Üyelik Satın Al</h3>
                <p class="mem-modal-subtitle">Adres gerekmeksizin doğrudan kart bilgilerinizle anında plan yükseltin.</p>
            </div>
            <button type="button" class="mem-close-btn" onclick="closeMembershipCheckoutModal()" title="Kapat">&times;</button>
        </div>

        <form id="membershipPurchaseForm" onsubmit="submitMembershipPurchase(event); return false;">
            <input type="hidden" id="memTargetTierId" value="2" />
            <input type="hidden" id="memPlanPrice" value="990" />

            <div class="mem-modal-body">
                <!-- Paket Özet Şeridi -->
                <div class="mem-plan-summary-card">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <span style="font-size: 0.76rem; color: #64748b; display: block;">Seçilen Plan:</span>
                            <strong id="memSummaryPlanName" style="font-size: 1.15rem; color: #0f172a;">Pro Plan</strong>
                        </div>
                        <div style="text-align: right;">
                            <span style="font-size: 0.76rem; color: #64748b; display: block;">Aylık Tutar:</span>
                            <strong id="memSummaryPlanPrice" style="font-size: 1.25rem; color: #0284c7; font-weight: 900;">990 ₺</strong>
                        </div>
                    </div>
                    <div id="memSummaryFeatures" style="margin-top: 8px; padding-top: 8px; border-top: 1px dashed #cbd5e1; font-size: 0.8rem; color: #475569;">
                        ✓ 100 Aktif Talep &bull; 100 Ürün Satışı &bull; Ürün Başı 20 Resim
                    </div>
                </div>

                <!-- Bilgilendirme Notu: Adres Sorulmaz -->
                <div class="mem-info-banner">
                    <span style="font-size: 1.2rem;">ℹ️</span>
                    <div>
                        <strong>Fiziksel Adres Bilgisi Gerekmez</strong><br />
                        Bu üyelik dijital lisans paketidir. Kargo, ambar veya açık adres doldurmanız gerekmez.
                    </div>
                </div>

                <!-- Kart Bilgileri Alanı -->
                <div class="mem-card-fields-wrap">
                    <div class="mem-field-group">
                        <label class="mem-label" for="memCardHolder">Kart Üzerindeki İsim *</label>
                        <input type="text" id="memCardHolder" class="mem-input" placeholder="AD SOYAD VEYA ŞİRKET ÜNVANI" required style="text-transform: uppercase;" />
                    </div>

                    <div class="mem-field-group">
                        <label class="mem-label" for="memCardNumber">Kart Numarası (16 Hane) *</label>
                        <input type="text" id="memCardNumber" class="mem-input" placeholder="5528 7900 0000 0008" maxlength="19" inputmode="numeric" oninput="formatCardNum(this)" required style="font-family: monospace; font-weight: 700; letter-spacing: 0.05em;" />
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <div class="mem-field-group">
                            <label class="mem-label" for="memCardExpiry">Son Kullanma (AA/YY) *</label>
                            <input type="text" id="memCardExpiry" class="mem-input" placeholder="12/28" maxlength="5" inputmode="numeric" oninput="formatExp(this)" required style="font-family: monospace; text-align: center;" />
                        </div>
                        <div class="mem-field-group">
                            <label class="mem-label" for="memCardCvv">CVC / CVV (3 Hane) *</label>
                            <input type="password" id="memCardCvv" class="mem-input" placeholder="***" maxlength="3" inputmode="numeric" required style="font-family: monospace; text-align: center;" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="mem-modal-footer">
                <button type="button" class="mem-btn-cancel" onclick="closeMembershipCheckoutModal()">Vazgeç</button>
                <button type="submit" id="btnSubmitMembership" class="mem-btn-confirm">
                    <span>✓</span> <span id="memBtnSubmitText">990 ₺ Ödemeyi Tamamla ve Yükselt</span>
                </button>
            </div>
        </form>
    </div>
</div>

