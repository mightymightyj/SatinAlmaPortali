@model satinalmaportali2.Models.PricingPageViewModel
@{
    ViewData["Title"] = "Üyelik Paketleri ve Fiyatlandırma";
    var currentTier = Model?.CurrentMembershipTypeId ?? 1;
}

@section Styles {
    <!-- Tailwind CSS (Play CDN) & Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e',
                            950: '#082f49',
                        }
                    }
                }
            }
        };
    </script>
    <style>
        html {
            scroll-behavior: smooth;
        }
    </style>
}

<div class="font-sans antialiased bg-slate-50 text-slate-800 selection:bg-blue-500 selection:text-white pb-20 sm:pb-24 lg:pb-12">

    <!-- ==================== BÖLÜM 1: HERO SECTION ==================== -->
    <section class="relative overflow-hidden bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 text-white pt-12 sm:pt-20 pb-16 sm:pb-28 px-4 sm:px-6 lg:px-8 border-b border-slate-800/80">
        <!-- Radial Glow Efekti -->
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(37,99,235,0.30),rgba(255,255,255,0))] pointer-events-none"></div>

        <div class="relative max-w-4xl mx-auto text-center">
            <!-- Rozet -->
            <div class="inline-flex items-center gap-2 px-3.5 sm:px-4 py-1.5 rounded-full text-xs font-semibold bg-blue-500/10 text-blue-400 border border-blue-500/20 mb-5 sm:mb-6 backdrop-blur-sm shadow-sm">
                <i class="fa-solid fa-tags text-blue-400 text-xs sm:text-sm"></i>
                <span>B2B Üyelik Seviyeleri</span>
            </div>

            <!-- Ana Başlık -->
            <h1 class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.18] sm:leading-[1.15]">
                İşletmenize Uygun <br class="hidden sm:inline" />
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-sky-300 to-indigo-300">
                    Üyelik Planları
                </span>
            </h1>

            <!-- Açıklama Metni -->
            <p class="mt-4 sm:mt-6 text-sm sm:text-base md:text-lg text-slate-300 max-w-3xl mx-auto leading-relaxed font-normal px-2">
                Tedarik ve satış hacminize göre dilediğiniz üyelik planını seçin. Üyelik satın alımlarında fiziksel kargo veya <strong>adres bilgisi gerekmez</strong>; üyeliğiniz anında aktifleştirilir.
            </p>

            @if (Model != null && Model.IsAuthenticated)
            {
                <div class="mt-5 sm:mt-6 inline-flex flex-wrap items-center justify-center gap-2 px-4 sm:px-5 py-2 rounded-full bg-blue-500/10 border border-blue-500/30 text-xs sm:text-sm backdrop-blur-sm shadow-sm">
                    <span class="text-blue-400 font-bold flex items-center gap-1.5">
                        <i class="fa-solid fa-building"></i>
                        @Model.CurrentCompanyName
                    </span>
                    <span class="text-slate-400">— Aktif Planınız:</span>
                    <span class="px-2.5 py-0.5 rounded-full bg-white text-slate-900 font-extrabold text-xs shadow-xs">
                        @Model.CurrentMembershipTypeName
                    </span>
                </div>
            }

            <!-- Hızlı Gezinme Butonları -->
            <div class="mt-6 sm:mt-10 flex flex-wrap items-center justify-center gap-2.5 sm:gap-3">
                <a href="#planlar" class="inline-flex items-center gap-1.5 sm:gap-2 px-4 sm:px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/30 transition-all hover:scale-[1.02]">
                    <i class="fa-solid fa-cubes text-xs"></i>
                    <span>Paketleri İncele</span>
                </a>
                <a href="#karsilastirma" class="inline-flex items-center gap-1.5 sm:gap-2 px-4 sm:px-5 py-2.5 rounded-xl text-xs sm:text-sm font-medium bg-slate-800/80 hover:bg-slate-700/80 text-slate-200 border border-slate-700/80 hover:border-slate-600 transition-all hover:scale-[1.02]">
                    <i class="fa-solid fa-scale-balanced text-xs"></i>
                    <span>Özellik Karşılaştırması</span>
                </a>
                <a href="#sss" class="inline-flex items-center gap-1.5 sm:gap-2 px-4 sm:px-5 py-2.5 rounded-xl text-xs sm:text-sm font-medium bg-slate-800/80 hover:bg-slate-700/80 text-slate-200 border border-slate-700/80 hover:border-slate-600 transition-all hover:scale-[1.02]">
                    <i class="fa-solid fa-circle-question text-xs"></i>
                    <span>S.S.S.</span>
                </a>
            </div>
        </div>
    </section>

    <!-- ==================== BÖLÜM 2: FİYAT PLANLARI ==================== -->
    <section id="planlar" class="py-12 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200 mb-3">
                <i class="fa-solid fa-layer-group text-blue-600 text-xs"></i>
                <span>Esnek Çözümler</span>
            </div>
            <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
                Her Ölçekten İşletmeye Uygun Seviyeler
            </h2>
            <p class="mt-3 sm:mt-4 text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed font-normal px-2">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. İhtiyacınıza en uygun paketi hemen seçin.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 items-stretch">

            <!-- 1. BEDAVA PLAN -->
            <div class="relative bg-white rounded-2xl sm:rounded-3xl p-6 sm:p-8 md:p-9 border @(currentTier == 1 ? "border-2 border-slate-600 shadow-lg" : "border-slate-200/90 shadow-sm") hover:shadow-xl hover:border-slate-300 transition-all duration-300 flex flex-col justify-between">
                @if (currentTier == 1)
                {
                    <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-slate-700 text-white text-xs font-bold tracking-wide uppercase shadow-sm">
                        Mevcut Planınız
                    </div>
                }
                <div>
                    <div class="flex items-center justify-between mb-6">
                        <div class="w-14 h-14 rounded-2xl bg-slate-100 flex items-center justify-center text-slate-700 shadow-xs">
                            <i class="fa-solid fa-shield-halved text-2xl"></i>
                        </div>
                        <span class="text-xs font-bold px-3 py-1 rounded-full bg-slate-100 text-slate-600">Başlangıç</span>
                    </div>

                    <h3 class="text-2xl font-bold text-slate-900 mb-2">Bedava</h3>
                    <p class="text-slate-500 text-sm leading-relaxed mb-6 font-normal">
                        Yeni başlayan işletmeler ve temel satın alma &amp; satış operasyonları için.
                    </p>

                    <div class="flex items-baseline gap-1 mb-8 pb-6 border-b border-slate-100">
                        <span class="text-4xl sm:text-5xl font-extrabold text-slate-900">₺0</span>
                        <span class="text-slate-500 text-sm font-medium">/ ay</span>
                    </div>

                    <ul class="space-y-3.5 text-sm text-slate-600 font-normal">
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-base shrink-0 mt-0.5"></i>
                            <span><strong class="font-bold text-slate-800">Aynı anda 10 adet</strong> aktif talep</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-base shrink-0 mt-0.5"></i>
                            <span><strong class="font-bold text-slate-800">Aynı anda 10 adet</strong> ürün satışı</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-base shrink-0 mt-0.5"></i>
                            <span>Her ürün için <strong class="font-bold text-slate-800">en fazla 3 resim</strong></span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-base shrink-0 mt-0.5"></i>
                            <span>Standart B2B tedarikçi vitrini</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-base shrink-0 mt-0.5"></i>
                            <span>Teklif alma &amp; verme imkanı</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-base shrink-0 mt-0.5"></i>
                            <span>Temel e-posta desteği</span>
                        </li>
                    </ul>
                </div>

                <div class="mt-8 pt-6 border-t border-slate-100">
                    @if (Model != null && Model.IsAuthenticated)
                    {
                        if (currentTier == 1)
                        {
                            <button type="button" class="w-full py-3.5 px-4 rounded-xl text-sm font-semibold bg-slate-100 text-slate-500 cursor-default" disabled>
                                ✓ Aktif Planınız
                            </button>
                        }
                        else
                        {
                            <span class="block w-full py-3.5 px-4 rounded-xl text-sm font-semibold bg-slate-100 text-slate-400 text-center cursor-default">
                                Temel Seviye
                            </span>
                        }
                    }
                    else
                    {
                        <a href="/Account/Register" class="block w-full py-3.5 px-4 rounded-xl text-sm font-semibold bg-slate-900 hover:bg-slate-800 text-white text-center transition-all shadow-sm hover:shadow">
                            Ücretsiz Kayıt Ol
                        </a>
                    }
                </div>
            </div>

            <!-- 2. PRO PLAN (ÖNERİLEN) -->
            <div class="relative bg-white rounded-3xl p-8 sm:p-9 border-2 @(currentTier == 2 ? "border-emerald-600 shadow-2xl" : "border-blue-600 shadow-xl shadow-blue-500/10") transition-all duration-300 flex flex-col justify-between lg:-translate-y-2">
                <!-- En Çok Tercih Edilen Rozeti -->
                <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-gradient-to-r from-blue-600 via-sky-600 to-indigo-600 text-white text-xs font-extrabold tracking-wide uppercase shadow-md flex items-center gap-1.5">
                    <i class="fa-solid fa-fire text-[11px]"></i>
                    <span>@(currentTier == 2 ? "Mevcut Planınız" : "En Çok Tercih Edilen")</span>
                </div>

                <div>
                    <div class="flex items-center justify-between mb-6">
                        <div class="w-14 h-14 rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 shadow-xs">
                            <i class="fa-solid fa-bolt-lightning text-2xl"></i>
                        </div>
                        <span class="text-xs font-bold px-3 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-200/60">Popüler</span>
                    </div>

                    <h3 class="text-2xl font-bold text-slate-900 mb-2">Pro</h3>
                    <p class="text-slate-500 text-sm leading-relaxed mb-6 font-normal">
                        Büyüyen ve satış &amp; tedarik hacmini hızlandırmak isteyen aktif firmalar için.
                    </p>

                    <div class="flex items-baseline gap-1 mb-8 pb-6 border-b border-slate-100">
                        <span class="text-4xl sm:text-5xl font-extrabold text-slate-900">₺990</span>
                        <span class="text-slate-500 text-sm font-medium">/ ay</span>
                    </div>

                    <ul class="space-y-3.5 text-sm text-slate-600 font-normal">
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-base shrink-0 mt-0.5"></i>
                            <span><strong class="font-bold text-slate-900">Aynı anda 100 adet</strong> aktif talep</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-base shrink-0 mt-0.5"></i>
                            <span><strong class="font-bold text-slate-900">Aynı anda 100 adet</strong> ürün satışı</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-base shrink-0 mt-0.5"></i>
                            <span>Her ürün için <strong class="font-bold text-slate-900">20 resim hakkı</strong></span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-base shrink-0 mt-0.5"></i>
                            <span>B2B Vitrinde öne çıkarılan ürünler</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-base shrink-0 mt-0.5"></i>
                            <span>Hızlı teklif verme &amp; anlık bildirimler</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-base shrink-0 mt-0.5"></i>
                            <span>7/24 Öncelikli müşteri desteği</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-base shrink-0 mt-0.5"></i>
                            <span>Detaylı talep ve teklif analitiği</span>
                        </li>
                    </ul>
                </div>

                <div class="mt-8 pt-6 border-t border-slate-100">
                    @if (Model != null && Model.IsAuthenticated)
                    {
                        if (currentTier == 2)
                        {
                            <button type="button" class="w-full py-3.5 px-4 rounded-xl text-sm font-semibold bg-blue-50 text-blue-700 border border-blue-200 cursor-default" disabled>
                                ✓ Aktif Planınız
                            </button>
                        }
                        else
                        {
                            <button type="button" onclick="openMembershipCheckoutModal(2, 'Pro', 990)" class="w-full py-3.5 px-4 rounded-xl text-sm font-bold bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/30 transition-all hover:scale-[1.02]">
                                Pro Plana Geç →
                            </button>
                        }
                    }
                    else
                    {
                        <a href="/Account/Login?returnUrl=/Home/Fiyatlandirma" class="block w-full py-3.5 px-4 rounded-xl text-sm font-bold bg-blue-600 hover:bg-blue-500 text-white text-center shadow-lg shadow-blue-600/30 transition-all hover:scale-[1.02]">
                            Giriş Yap &amp; Satın Al
                        </a>
                    }
                </div>
            </div>

            <!-- 3. KURUMSAL PLAN -->
            <div class="relative bg-white rounded-3xl p-8 sm:p-9 border @(currentTier == 3 ? "border-2 border-purple-600 shadow-lg" : "border-slate-200/90 shadow-sm") hover:shadow-xl hover:border-purple-300 transition-all duration-300 flex flex-col justify-between">
                @if (currentTier == 3)
                {
                    <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-purple-700 text-white text-xs font-bold tracking-wide uppercase shadow-sm">
                        Mevcut Planınız
                    </div>
                }
                <div>
                    <div class="flex items-center justify-between mb-6">
                        <div class="w-14 h-14 rounded-2xl bg-purple-50 border border-purple-100 flex items-center justify-center text-purple-600 shadow-xs">
                            <i class="fa-solid fa-crown text-2xl"></i>
                        </div>
                        <span class="text-xs font-bold px-3 py-1 rounded-full bg-purple-50 text-purple-700 border border-purple-200/60">Kurumsal VIP</span>
                    </div>

                    <h3 class="text-2xl font-bold text-slate-900 mb-2">Kurumsal</h3>
                    <p class="text-slate-500 text-sm leading-relaxed mb-6 font-normal">
                        Büyük ölçekli üretici, distribütör ve yüksek hacimli kurumlar için tam güç.
                    </p>

                    <div class="flex items-baseline gap-1 mb-8 pb-6 border-b border-slate-100">
                        <span class="text-4xl sm:text-5xl font-extrabold text-slate-900">₺2.990</span>
                        <span class="text-slate-500 text-sm font-medium">/ ay</span>
                    </div>

                    <ul class="space-y-3.5 text-sm text-slate-600 font-normal">
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-base shrink-0 mt-0.5"></i>
                            <span><strong class="font-bold text-slate-900">Sınırsız</strong> talep oluşturma</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-base shrink-0 mt-0.5"></i>
                            <span><strong class="font-bold text-slate-900">Sınırsız</strong> ürün satışı ilanı</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-base shrink-0 mt-0.5"></i>
                            <span>Her ürün için <strong class="font-bold text-slate-900">sınırsız resim</strong></span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-base shrink-0 mt-0.5"></i>
                            <span>🛡️ Onaylı Kurumsal Tedarikçi Rozeti</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-base shrink-0 mt-0.5"></i>
                            <span>En üst sırada vitrin listelemesi</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-base shrink-0 mt-0.5"></i>
                            <span>Özel B2B Müşteri Temsilcisi</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-base shrink-0 mt-0.5"></i>
                            <span>SLA garantili 7/24 VIP destek</span>
                        </li>
                    </ul>
                </div>

                <div class="mt-8 pt-6 border-t border-slate-100">
                    @if (Model != null && Model.IsAuthenticated)
                    {
                        if (currentTier == 3)
                        {
                            <button type="button" class="w-full py-3.5 px-4 rounded-xl text-sm font-semibold bg-purple-50 text-purple-700 border border-purple-200 cursor-default" disabled>
                                ✓ Aktif Planınız
                            </button>
                        }
                        else
                        {
                            <button type="button" onclick="openMembershipCheckoutModal(3, 'Kurumsal', 2990)" class="w-full py-3.5 px-4 rounded-xl text-sm font-bold bg-slate-900 hover:bg-slate-800 text-white shadow-md transition-all hover:scale-[1.02]">
                                Kurumsal Plana Geç →
                            </button>
                        }
                    }
                    else
                    {
                        <a href="/Account/Login?returnUrl=/Home/Fiyatlandirma" class="block w-full py-3.5 px-4 rounded-xl text-sm font-bold bg-slate-900 hover:bg-slate-800 text-white text-center shadow-md transition-all hover:scale-[1.02]">
                            Giriş Yap &amp; Satın Al
                        </a>
                    }
                </div>
            </div>

        </div>
    </section>

    <!-- ==================== BÖLÜM 3: KARŞILAŞTIRMA TABLOSU ==================== -->
    <section id="karsilastirma" class="py-12 sm:py-20 px-4 sm:px-6 lg:px-8 bg-slate-100/70 border-y border-slate-200/80">
        <div class="max-w-7xl mx-auto">
            <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200 mb-3">
                    <i class="fa-solid fa-table-list text-indigo-600 text-xs"></i>
                    <span>Limit &amp; Yetki Kıyaslaması</span>
                </div>
                <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
                    Üyelik Planı Karşılaştırması
                </h2>
                <p class="mt-3 sm:mt-4 text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed font-normal px-2">
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Paketlerin tüm detaylarını tek ekranda inceleyin.
                </p>
            </div>

        <!-- ==================== MOBİL GÖRÜNÜM: KARŞILAŞTIRMA KARTLARI (< md) ==================== -->
        <div class="block md:hidden space-y-3 max-w-xl mx-auto">
            <!-- Kriter 1 -->
            <div class="p-4 rounded-2xl bg-white border border-slate-200/90 shadow-sm">
                <div class="flex items-center gap-2 mb-3 pb-2 border-b border-slate-100">
                    <span class="w-1.5 h-4 rounded-full bg-blue-600 shrink-0"></span>
                    <h4 class="text-sm font-bold text-slate-900">Aynı Anda Aktif Talep Limiti</h4>
                </div>
                <div class="grid grid-cols-3 gap-2 text-center">
                    <div class="p-2 rounded-xl bg-slate-50 border border-slate-100 flex flex-col justify-between">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Bedava</span>
                        <span class="text-xs font-bold text-slate-700 mt-1">10 Adet</span>
                    </div>
                    <div class="p-2 rounded-xl bg-blue-50/80 border border-blue-200 flex flex-col justify-between shadow-xs">
                        <span class="text-[10px] font-extrabold uppercase tracking-wider text-blue-700">Pro</span>
                        <span class="text-xs font-black text-blue-950 mt-1">100 Adet</span>
                    </div>
                    <div class="p-2 rounded-xl bg-purple-50/80 border border-purple-200 flex flex-col justify-between">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-purple-700">Kurumsal</span>
                        <span class="text-xs font-black text-emerald-600 mt-1">Sınırsız</span>
                    </div>
                </div>
            </div>

            <!-- Kriter 2 -->
            <div class="p-4 rounded-2xl bg-white border border-slate-200/90 shadow-sm">
                <div class="flex items-center gap-2 mb-3 pb-2 border-b border-slate-100">
                    <span class="w-1.5 h-4 rounded-full bg-blue-600 shrink-0"></span>
