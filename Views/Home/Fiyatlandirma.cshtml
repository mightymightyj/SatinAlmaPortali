@{
    ViewData["Title"] = "Fiyatlandırma";
}

<!-- HERO SECTION -->
<section class="fiyat-hero">
    <div class="fiyat-hero-inner">
        <div class="fiyat-badge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="1" x2="12" y2="23"></line>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
            <span>Fiyatlandırma</span>
        </div>
        <h1 class="fiyat-hero-title">Fiyatlandırma <span class="highlight-dot">Planları</span></h1>
        <p class="fiyat-hero-desc">
            İşletmenizin büyüklüğüne ve ihtiyaçlarına uygun esnek fiyatlandırma seçenekleri.
            Tüm planlar 14 gün ücretsiz deneme ile başlar, kredi kartı gerekmez.
        </p>
    </div>
</section>

<!-- FİYAT PLANLARI -->
<section class="fiyat-section">
    <div class="fiyat-container">
        <div class="fiyat-plans-grid">

            <!-- Başlangıç -->
            <div class="fiyat-plan-card">
                <div class="fiyat-plan-header">
                    <div class="fiyat-plan-icon fiyat-icon-starter">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                    </div>
                    <h3 class="fiyat-plan-name">Başlangıç</h3>
                    <p class="fiyat-plan-desc">Küçük işletmeler ve yeni başlayanlar için temel satın alma araçları.</p>
                </div>
                <div class="fiyat-price">
                    <span class="fiyat-currency">₺</span>
                    <span class="fiyat-amount">499</span>
                    <span class="fiyat-period">/ ay</span>
                </div>
                <ul class="fiyat-features">
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>Aylık 50 talep oluşturma</span>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>Temel tedarikçi arama</span>
