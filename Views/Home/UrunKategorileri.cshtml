@section Scripts {
    <script>
        /**
         * Canlı Kategori ve Alt Dallarda Dinamik Arama Motoru
         */
        function handleCategorySearch(val) {
            var q = (val || '').toLowerCase().trim();
            var clearBtn = document.getElementById('btnClearCatSearch');
            var feedback = document.getElementById('searchMatchFeedback');
            var emptyMsg = document.getElementById('noSearchResultsMsg');

            if (clearBtn) {
                if (q) {
                    clearBtn.classList.remove('hidden');
                    clearBtn.classList.add('inline-flex');
                } else {
                    clearBtn.classList.add('hidden');
                    clearBtn.classList.remove('inline-flex');
                }
            }

            var rootBlocks = document.querySelectorAll('.kategori-root-block');
            var totalMatchingItems = 0;
            var visibleRoots = 0;

            rootBlocks.forEach(function (rootBlock) {
                var rootName = rootBlock.getAttribute('data-root-name') || '';
                var rootMatches = q && rootName.indexOf(q) !== -1;

                var subCards = rootBlock.querySelectorAll('.sub-kategori-card');
                var anySubVisibleInRoot = false;

                subCards.forEach(function (card) {
                    var subName = card.getAttribute('data-sub-name') || '';
                    var subMatches = q && subName.indexOf(q) !== -1;

                    var nodeItems = card.querySelectorAll('.dir-node-item');
                    var anyNodeMatches = false;

                    nodeItems.forEach(function (node) {
                        var nodeName = node.getAttribute('data-cat-name') || '';
                        var link = node.querySelector('.dir-node-link');
                        if (!q) {
                            if (link) link.classList.remove('is-highlighted');
                            node.style.display = '';
                        } else if (nodeName.indexOf(q) !== -1) {
                            anyNodeMatches = true;
                            if (link) link.classList.add('is-highlighted');
                            node.style.display = '';
                            totalMatchingItems++;
                        } else {
                            if (link) link.classList.remove('is-highlighted');
                            node.style.display = subMatches ? '' : 'none';
                        }
                    });

                    if (!q || rootMatches || subMatches || anyNodeMatches) {
                        card.style.display = '';
                        anySubVisibleInRoot = true;
                        if (q && (subMatches || rootMatches)) totalMatchingItems++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                if (!q || rootMatches || anySubVisibleInRoot) {
                    rootBlock.style.display = '';
                    visibleRoots++;
                } else {
                    rootBlock.style.display = 'none';
                }
            });

            if (feedback) {
                if (q) {
                    feedback.classList.remove('hidden');
                    feedback.innerHTML = `"${q}" araması için <strong>${totalMatchingItems}</strong> kategori ve alt dal eşleşti.`;
                } else {
                    feedback.classList.add('hidden');
                }
            }

            if (emptyMsg) {
                if (q && visibleRoots === 0) {
                    emptyMsg.classList.remove('hidden');
                } else {
                    emptyMsg.classList.add('hidden');
                }
            }
        }

        function clearCategorySearch() {
            var input = document.getElementById('kategoriSearchInput');
            if (input) {
                input.value = '';
                handleCategorySearch('');
                input.focus();
            }
        }
    </script>
}