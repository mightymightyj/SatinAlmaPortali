@model satinalmaportali2.Models.UrunKategorileriViewModel
@{
    ViewData["Title"] = "Sanayi & Kurumsal Ürün Kategorileri";
}

@section Styles {
    <!-- Tailwind CSS (Play CDN) & Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e',
                            950: '#082f49',
                        }
                    }
                }
            }
        };
    </script>
    <style>
        html {
            scroll-behavior: smooth;
        }

        /* Özel İnce Kaydırma Çubuğu */
        .custom-tree-scroll::-webkit-scrollbar {
            width: 4px;
        }
        .custom-tree-scroll::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-tree-scroll::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .custom-tree-scroll::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* Canlı Arama Vurgusu */
        .dir-node-link.is-highlighted {
            background-color: #fef08a !important;
            color: #854d0e !important;
            font-weight: 700 !important;
            box-shadow: 0 0 0 2px rgba(234, 179, 8, 0.4);
        }

        /* Scrollbar gizleme yardımcısı (yatay sekmeler için) */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
}

<!-- ==================== BÖLÜM 1: TAILWIND HERO HEADER ==================== -->
<section class="relative overflow-hidden bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 text-white pt-8 sm:pt-14 md:pt-16 pb-8 sm:pb-12 px-4 sm:px-6 lg:px-8 border-b border-slate-800/80 font-sans">
    <!-- Arka Plan Radial Glow Efekti -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(37,99,235,0.28),rgba(255,255,255,0))] pointer-events-none"></div>

    <div class="relative max-w-5xl mx-auto text-center">
        <!-- Kurumsal Rozet -->
        <div class="inline-flex items-center gap-2 px-3 sm:px-4 py-1 sm:py-1.5 rounded-full text-[11px] sm:text-xs font-semibold bg-blue-500/10 text-blue-400 border border-blue-500/20 mb-3 sm:mb-5 backdrop-blur-sm shadow-sm max-w-full">
            <svg class="w-3.5 h-3.5 text-blue-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                <rect x="3" y="14" width="7" height="7" rx="1"></rect>
            </svg>
            <span class="truncate">B2B Kurumsal Ürün Kataloğu &amp; Sanayi Ağacı</span>
        </div>

        <!-- Ana Başlık -->
        <h1 class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.18] sm:leading-[1.12]">
            Tüm Sanayi &amp; <br class="hidden sm:inline" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-sky-300 to-indigo-300">
                Ürün Kategorileri
            </span>
        </h1>

        <!-- Açıklama Metni -->
        <p class="mt-2.5 sm:mt-4 text-xs sm:text-base lg:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed font-normal px-2">
            Veritabanımızda kayıtlı @Model.TotalRootCategories ana sanayi kolu ve @Model.TotalCategories kurumsal alt kategorisinde doğrudan üretici, ana distribütör ve onaylı kurumsal tedarikçilere ulaşın.
        </p>

        <!-- Canlı Arama Çubuğu -->
        <div class="mt-5 sm:mt-7 max-w-2xl mx-auto">
            <div class="relative flex items-center w-full bg-slate-800/90 border border-slate-700/80 rounded-xl sm:rounded-2xl p-1.5 sm:p-2 shadow-inner backdrop-blur-sm focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500/20 transition-all">
                <div class="pl-3 sm:pl-3.5 text-slate-400">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </div>
                <input type="text" id="kategoriSearchInput" 
                       placeholder="Kategori, alt ürün grubu veya anahtar kelime ara..." 
                       class="w-full bg-transparent px-2.5 sm:px-3 py-1.5 sm:py-2 text-xs sm:text-sm text-white placeholder-slate-400 outline-none font-medium" 
                       oninput="handleCategorySearch(this.value)" autocomplete="off" />
                
                <button type="button" id="btnClearCatSearch" 
                       class="hidden inline-flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-300 hover:text-white shrink-0 transition-colors mr-1" 
                       onclick="clearCategorySearch()" title="Aramayı Temizle">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            <div id="searchMatchFeedback" class="mt-2 text-xs text-sky-400 font-medium hidden"></div>
        </div>

        <!-- Kök Kategoriler Hızlı Erişim Gezinme Çubuğu -->
        @if (Model.RootCategories.Any())
        {
            <div class="mt-5 sm:mt-8 pt-4 sm:pt-6 border-t border-slate-800/60 max-w-4xl mx-auto">
                <div class="flex items-center justify-center gap-2 mb-2 sm:mb-3 text-slate-400 text-xs font-semibold">
                    <svg class="w-3.5 h-3.5 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                    <span>Hızlı Sektör Atlama:</span>
                </div>
                <div class="flex items-center gap-2 overflow-x-auto no-scrollbar sm:flex-wrap sm:justify-center py-1.5 -mx-4 px-4 sm:mx-0 sm:px-0 scroll-smooth">
                    @foreach (var root in Model.RootCategories)
                    {
                        <a href="#root-cat-@root.CategoryID" 
                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700/70 hover:border-blue-500/60 text-slate-300 hover:text-white text-xs font-medium transition-all shadow-xs shrink-0 active:scale-95">
                            <i class="@(root.Icon ?? "fa-solid fa-folder") text-blue-400 text-xs shrink-0"></i>
                            <span class="whitespace-nowrap">@root.CategoryName</span>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</section>

<!-- ==================== BÖLÜM 2: GERÇEK VERİTABANI İSTATİSTİK ŞERİDİ ==================== -->
<section class="relative bg-slate-50/70 pb-8 sm:pb-14 font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-8">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-4">
            
            <!-- İstatistik Kartı 1 -->
            <div class="bg-white rounded-xl sm:rounded-2xl p-3 sm:p-5 border border-slate-200/90 shadow-sm hover:shadow-md transition-all duration-200 flex items-center gap-3 sm:gap-4 group">
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-blue-50 text-blue-600 border border-blue-100 flex items-center justify-center shrink-0 group-hover:scale-105 group-hover:bg-blue-600 group-hover:text-white transition-all duration-200">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                        <polyline points="2 17 12 22 22 17"></polyline>
                        <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                </div>
                <div class="min-w-0 flex-1">
                    <span class="block text-base sm:text-2xl font-black text-slate-900 leading-tight">@Model.TotalRootCategories</span>
                    <span class="block text-[11px] sm:text-xs font-semibold text-slate-500 leading-snug">Ana Sanayi</span>
                </div>
            </div>

            <!-- İstatistik Kartı 2 -->
            <div class="bg-white rounded-xl sm:rounded-2xl p-3 sm:p-5 border border-slate-200/90 shadow-sm hover:shadow-md transition-all duration-200 flex items-center gap-3 sm:gap-4 group">
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-100 flex items-center justify-center shrink-0 group-hover:scale-105 group-hover:bg-emerald-600 group-hover:text-white transition-all duration-200">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                    </svg>
                </div>
                <div class="min-w-0 flex-1">
                    <span class="block text-base sm:text-2xl font-black text-slate-900 leading-tight">@Model.TotalCategories</span>
                    <span class="block text-[11px] sm:text-xs font-semibold text-slate-500 leading-snug">Kategori</span>
                </div>
            </div>

            <!-- İstatistik Kartı 3 -->
            <div class="bg-white rounded-xl sm:rounded-2xl p-3 sm:p-5 border border-slate-200/90 shadow-sm hover:shadow-md transition-all duration-200 flex items-center gap-3 sm:gap-4 group">
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-indigo-50 text-indigo-600 border border-indigo-100 flex items-center justify-center shrink-0 group-hover:scale-105 group-hover:bg-indigo-600 group-hover:text-white transition-all duration-200">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                    </svg>
                </div>
                <div class="min-w-0 flex-1">
                    <span class="block text-base sm:text-2xl font-black text-slate-900 leading-tight">@Model.TotalProducts</span>
                    <span class="block text-[11px] sm:text-xs font-semibold text-slate-500 leading-snug">Ürün İlanı</span>
                </div>
            </div>

            <!-- İstatistik Kartı 4 -->
            <div class="bg-white rounded-xl sm:rounded-2xl p-3 sm:p-5 border border-slate-200/90 shadow-sm hover:shadow-md transition-all duration-200 flex items-center gap-3 sm:gap-4 group">
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-amber-50 text-amber-600 border border-amber-100 flex items-center justify-center shrink-0 group-hover:scale-105 group-hover:bg-amber-600 group-hover:text-white transition-all duration-200">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        <polyline points="9 12 11 14 15 10"></polyline>
                    </svg>
                </div>
                <div class="min-w-0 flex-1">
                    <span class="block text-base sm:text-2xl font-black text-slate-900 leading-tight">@(Model.TotalSuppliers)+</span>
                    <span class="block text-[11px] sm:text-xs font-semibold text-slate-500 leading-snug">B2B Tedarikçi</span>
                </div>
            </div>

        </div>
    </div>

    <!-- ==================== BÖLÜM 3: KÖK KATEGORİLER & HİYERARŞİK LİSTE ==================== -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10">
        
        <!-- Bölüm Başlığı -->
        <div class="flex items-center justify-between mb-6 sm:mb-8 pb-3.5 border-b border-slate-200">
            <div>
                <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-blue-600 mb-1">
                    <span class="w-2 h-2 rounded-full bg-blue-600"></span>
                    <span>Sektörel Dizin</span>
                </div>
                <h2 class="text-xl sm:text-3xl font-black text-slate-900 tracking-tight">Sanayi Kolları ve Hiyerarşik Ürün Ağacı</h2>
                <p class="text-xs sm:text-sm text-slate-500 mt-1">Ana sanayi kolları ve alt ürün gruplarını kolayca inceleyin, vitrinde tek tıkla filtreleyin.</p>
            </div>
        </div>

        <!-- Arama Sonucu Bulunamadı Uyarısı -->
        <div id="noSearchResultsMsg" class="hidden bg-white rounded-2xl p-6 sm:p-10 text-center border border-slate-200 shadow-sm max-w-lg mx-auto my-8">
            <div class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-500 border border-amber-200 flex items-center justify-center text-2xl mx-auto mb-3">
                🔍
            </div>
            <h3 class="text-base sm:text-lg font-bold text-slate-900">Aramanızla Eşleşen Kategori Bulunamadı</h3>
            <p class="text-xs sm:text-sm text-slate-500 mt-1 mb-4">Farklı bir anahtar kelime deneyebilir veya arama filtresini sıfırlayabilirsiniz.</p>
            <button type="button" class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs transition-colors shadow-sm" onclick="clearCategorySearch()">
                Tüm Kategorileri Göster
            </button>
        </div>

        <!-- Kök Kategoriler Listesi -->
        <div class="space-y-6 sm:space-y-8" id="kategoriRootsContainer">
            @foreach (var root in Model.RootCategories)
            {
                <div class="kategori-root-block bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 shadow-sm hover:shadow-md transition-all overflow-hidden scroll-mt-20 sm:scroll-mt-24" 
                     id="root-cat-@root.CategoryID" 
                     data-root-id="@root.CategoryID" 
                     data-root-name="@root.CategoryName.ToLowerInvariant()">
                    
                    <!-- KÖK KATEGORİ BAŞLIK ÇUBUĞU -->
                    <div class="p-4 sm:p-6 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3.5 sm:gap-4 bg-gradient-to-r from-slate-50/90 via-white to-blue-50/30">
                        <div class="flex items-center gap-3 sm:gap-4 min-w-0 flex-1">
                            <!-- Simge Rozeti (Font Awesome) -->
                            <div class="w-11 h-11 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-600 text-white shadow-md shadow-blue-500/20 flex items-center justify-center text-lg sm:text-2xl shrink-0">
                                <i class="@(root.Icon ?? "fa-solid fa-folder-tree")"></i>
                            </div>

                            <!-- Bilgi ve Rozetler -->
                            <div class="min-w-0 flex-1">
                                @if (root.ProductCount > 0)
                                {
                                    <div class="flex items-center gap-2 flex-wrap mb-0.5">
                                        <span class="px-2 py-0.5 rounded-full text-[10px] sm:text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200/80">
                                            @root.ProductCount Ürün Yayında
                                        </span>
                                    </div>
                                }
                                <h3 class="text-base sm:text-xl md:text-2xl font-black text-slate-900 tracking-tight leading-snug break-words">
                                    @root.CategoryName
                                </h3>
                            </div>
                        </div>

                        <!-- Bu Sektördeki Ürünleri Gör CTA Butonu -->
                        <div class="shrink-0 flex items-center">
                            <a href="/Home/Index?catId=@root.CategoryID" 
                               class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs sm:text-sm shadow-md shadow-blue-600/20 hover:-translate-y-0.5 transition-all whitespace-nowrap"
                               title="@root.CategoryName sektöründeki ürünleri incele">
                                <span>Bu Sektördeki Ürünleri Gör</span>
                                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <polyline points="9 18 15 12 9 6"></polyline>
                                </svg>
                            </a>
                        </div>
                    </div>

                    <!-- ALT KATEGORİLER IZGARASI & DİZİN AĞACI -->
                    @if (root.Children.Any())
                    {
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-4 lg:gap-5 p-3.5 sm:p-5 lg:p-6 bg-slate-50/50">
                            @foreach (var sub in root.Children)
                            {
                                <div class="sub-kategori-card bg-white rounded-xl sm:rounded-2xl p-3.5 sm:p-4 border border-slate-200/90 shadow-xs hover:border-blue-300 hover:shadow-md transition-all flex flex-col justify-between group/sub" 
                                     data-sub-id="@sub.CategoryID" 
                                     data-sub-name="@sub.CategoryName.ToLowerInvariant()">
                                    
                                    <!-- Kart Başlığı -->
                                    <div>
                                        <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-slate-100">
                                            <a href="/Home/Index?catId=@sub.CategoryID" 
                                               class="text-xs sm:text-sm font-bold text-slate-900 group-hover/sub:text-blue-600 transition-colors flex items-center gap-2 min-w-0 flex-1" 
                                               title="@sub.CategoryName ürünlerini incele">
                                                <span class="w-2 h-2 rounded-full bg-blue-500 shrink-0"></span>
                                                <span class="leading-snug break-words">@sub.CategoryName</span>
                                            </a>
                                            @if (sub.ProductCount > 0)
                                            {
                                                <span class="px-1.5 sm:px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 shrink-0">
                                                    @sub.ProductCount
                                                </span>
                                            }
                                        </div>

                                        <!-- Hiyerarşik Alt Dallar (Ağaç Görünümü - Doğal Yükseklik, Scroll Trap Yok) -->
                                        @if (sub.Children != null && sub.Children.Any())
                                        {
                                            <div class="my-1.5 space-y-0.5">
                                                <partial name="_CategoryDirectoryBranch" model="(Node: sub, Level: 1)" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-[11px] text-slate-400 italic py-2 text-center bg-slate-50/80 rounded-lg my-1.5">
                                                Doğrudan bu kategori seviyesinde listelenmektedir.
                                            </div>
                                        }
                                    </div>

                                    <!-- Kart Altı Vitrin Aç Butonu -->
                                    <div class="pt-2.5 mt-2.5 border-t border-dashed border-slate-200/80 flex items-center justify-between">
                                        <span class="text-[11px] font-medium text-slate-400">Tüm ürünler</span>
                                        <a href="/Home/Index?catId=@sub.CategoryID" 
                                           class="inline-flex items-center gap-1 text-xs font-bold text-blue-600 group-hover/sub:text-blue-700 hover:underline">
                                            <span>Vitrinde Aç</span>
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                                <polyline points="12 5 19 12 12 19"></polyline>
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-5 sm:p-6 text-center text-xs text-slate-400 italic">
                            Bu kök kategori altında henüz kayıtlı alt kategori bulunmamaktadır.
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

<!-- ==================== BÖLÜM 4: NEDEN TEDARİK PORTALI? (B2B DEĞERLERİ) ==================== -->
<section class="bg-white py-10 sm:py-16 lg:py-20 border-t border-slate-200/80 font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-12">
            <div class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-blue-600 mb-2">
                <span class="w-2 h-2 rounded-full bg-blue-600"></span>
                <span>Kurumsal Avantajlar</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Neden Tedarik Portalı?</h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-2">Türkiye sanayisinin kurumsal tedarik ve doğrudan fabrika satış platformu.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
            <div class="bg-slate-50/70 rounded-2xl p-5 sm:p-7 border border-slate-200/80 hover:shadow-md transition-all">
                <div class="w-12 h-12 rounded-xl bg-blue-600 text-white flex items-center justify-center mb-5 shadow-sm shadow-blue-600/30">
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                </div>
                <h4 class="text-base sm:text-lg font-bold text-slate-900 mb-2">Doğrulanmış B2B Tedarikçileri</h4>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                    Platformumuzdaki satıcılar vergi levhası, ticaret sicil gazetesi ve kurumsal belgeleriyle ön onaydan geçer. Aracıları devreden çıkarıp doğrudan ana üreticilerle çalışın.
                </p>
            </div>

