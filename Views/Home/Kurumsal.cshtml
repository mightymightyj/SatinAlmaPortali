<!-- KURUMSAL HERO SECTION -->
<section class="kurumsal-hero">
    <div class="kurumsal-hero-inner">
        <div class="kurumsal-badge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span>Kurumsal</span>
        </div>
        <h1 class="kurumsal-hero-title">Tedarik Portalı <span class="highlight-dot">Hakkında</span></h1>
        <p class="kurumsal-hero-desc">
            Türkiye'nin lider B2B satın alma platformu olarak, alıcılar ve tedarikçiler arasında güvenilir bir köprü kuruyoruz.
            Dijital dönüşümle tedarik süreçlerinizi hızlandırıyor, maliyetlerinizi düşürüyoruz.
        </p>
    </div>
</section>

