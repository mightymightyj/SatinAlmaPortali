                                            <td class="py-3 px-4 sm:px-6 font-bold text-slate-600 bg-slate-50/70 w-1/3 sm:w-1/4">@spec.Key</td>
                                            <td class="py-3 px-4 sm:px-6 font-semibold text-slate-900">@spec.Value</td>
                                        </tr>
