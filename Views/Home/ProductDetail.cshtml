@model satinalmaportali2.Models.ProductDetailPageViewModel
@{
    ViewData["Title"] = $"{Model.Title} - Tedarik Portalı";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <!-- Tailwind CSS (Play CDN) & Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e',
                            950: '#082f49',
                        }
                    }
                }
            }
        };
    </script>
    <style>
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .b2b-thumb-btn.is-active {
            border-color: #2563eb !important;
            box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.35) !important;
        }
    </style>
}

<!-- ==================== BÖLÜM 1: KOYU BREADCRUMB & HERO BANNER ==================== -->
<section class="relative overflow-hidden bg-gradient-to-r from-slate-950 via-slate-900 to-slate-950 text-white py-4 sm:py-5 px-4 sm:px-6 lg:px-8 border-b border-slate-800/80 font-sans">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(37,99,235,0.20),rgba(255,255,255,0))] pointer-events-none"></div>
    <div class="relative max-w-7xl mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-1.5 sm:gap-2 text-xs text-slate-400 overflow-x-auto no-scrollbar py-0.5" aria-label="breadcrumb">
            <a href="/" class="text-blue-400 hover:text-blue-300 transition-colors inline-flex items-center gap-1 shrink-0 font-medium">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                <span>Anasayfa</span>
            </a>
            <span class="text-slate-600">/</span>
            <a href="/#ihtiyaciniz-olan-urunler" class="text-slate-300 hover:text-white transition-colors shrink-0 font-medium">
                B2B Vitrin
            </a>
            @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
            {
                <span class="text-slate-600">/</span>
                <span class="text-blue-300 font-semibold shrink-0">@Model.CategoryName</span>
            }
            <span class="text-slate-600">/</span>
            <span class="text-slate-200 font-bold truncate max-w-[200px] sm:max-w-[320px]">@Model.Title</span>
        </nav>

        <!-- Vitrine Dön Butonu -->
        <div class="shrink-0 flex items-center gap-2">
            <a href="/#ihtiyaciniz-olan-urunler" 
               class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-800/90 hover:bg-slate-700/90 border border-slate-700/80 text-slate-200 hover:text-white text-xs font-semibold transition-all active:scale-95 shadow-xs">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Vitrine Dön</span>
            </a>
        </div>
    </div>
</section>

<!-- ==================== BÖLÜM 2: ÜRÜN DETAYI ANA KART ==================== -->
<div class="bg-slate-50/70 py-6 sm:py-10 pb-24 sm:pb-28 lg:pb-16 font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Ana Kart Grid -->
        <div class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 shadow-sm p-4 sm:p-7 lg:p-8 grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-10">
            
            <!-- SOL KOLON: GÖRSEL GALERİ & THUMBNAILS (5 Sütun) -->
            <div class="lg:col-span-5 xl:col-span-5 flex flex-col gap-3.5">
                <div class="relative w-full aspect-square max-h-[460px] rounded-2xl bg-slate-50/90 border border-slate-200/80 overflow-hidden flex items-center justify-center p-4 group" id="pdpImageBox">
                    
                    <!-- Slayt Görselleri -->
                    @for (int i = 0; i < Model.Images.Count; i++)
                    {
                        var img = Model.Images[i];
                        <div class="pdp-slide-item @(i == 0 ? "active" : "") w-full h-full items-center justify-center transition-all duration-300" id="pdpSlide-@i" style="display: @(i == 0 ? "flex" : "none");">
                            <img src="@img.ImageUrl" alt="@Model.Title - Görsel @(i+1)" class="max-w-full max-h-full object-contain transition-transform duration-300 group-hover:scale-105" />
                        </div>
                    }

                    <!-- Stok Durumu Rozeti -->
                    @if (Model.IsOutOfStock)
                    {
                        <div class="absolute top-3 left-3 z-10 bg-rose-600 text-white text-[10px] sm:text-xs font-black uppercase tracking-wider px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-lg sm:rounded-xl shadow-md shadow-rose-600/30">
                            Tükendi (Stokta Yok)
                        </div>
                    }
                    else
                    {
                        <div class="absolute top-3 left-3 z-10 bg-emerald-600 text-white text-[10px] sm:text-xs font-bold px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-lg sm:rounded-xl shadow-md shadow-emerald-600/30 flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                            <span>@Model.StockQuantity Adet Hazır Stok</span>
                        </div>
                    }

                    <!-- Ana Görsel Rozeti -->
                    @if (Model.Images.Any(x => x.IsMain))
                    {
                        <div class="absolute top-3 right-3 z-10 bg-slate-900/80 backdrop-blur-sm text-white text-[11px] font-semibold px-2.5 py-1 rounded-lg border border-slate-700/70 items-center gap-1 shadow-sm" id="pdpMainBadge" style="display: @(Model.Images[0].IsMain ? "inline-flex" : "none");">
                            <svg class="w-3 h-3 text-amber-400 fill-amber-400" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                            <span>Ana Görsel</span>
                        </div>
                    }

                    <!-- Carousel Butonları (Birden fazla görsel varsa) -->
                    @if (Model.Images.Count > 1)
                    {
                        <button type="button" 
                                class="absolute left-2.5 sm:left-3 top-1/2 -translate-y-1/2 w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-white/90 hover:bg-white text-slate-800 shadow-md border border-slate-200/80 flex items-center justify-center transition-all hover:scale-105 active:scale-95 z-10" 
                                onclick="changePdpSlide(-1)" title="Önceki Görsel" aria-label="Önceki">
                            <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polyline points="15 18 9 12 15 6"></polyline>
                            </svg>
                        </button>
                        <button type="button" 
                                class="absolute right-2.5 sm:right-3 top-1/2 -translate-y-1/2 w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-white/90 hover:bg-white text-slate-800 shadow-md border border-slate-200/80 flex items-center justify-center transition-all hover:scale-105 active:scale-95 z-10" 
                                onclick="changePdpSlide(1)" title="Sonraki Görsel" aria-label="Sonraki">
                            <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </button>
                        <div class="absolute bottom-3 right-3 z-10 bg-slate-900/75 backdrop-blur-sm text-white text-[11px] font-bold px-2.5 py-1 rounded-lg border border-slate-800 shadow-sm" id="pdpCounter">
                            1 / @Model.Images.Count
                        </div>
                    }
                </div>

                <!-- Küçük Resimler (Thumbnails) -->
                @if (Model.Images.Count > 1)
                {
                    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1 scroll-smooth" id="pdpThumbnailsStrip">
                        @for (int i = 0; i < Model.Images.Count; i++)
                        {
                            var img = Model.Images[i];
                            <button type="button" 
                                    class="b2b-thumb-btn @(i == 0 ? "is-active" : "") relative w-14 h-14 sm:w-16 sm:h-16 rounded-xl bg-slate-50 border-2 border-slate-200 hover:border-blue-400 p-1 shrink-0 overflow-hidden transition-all duration-150 active:scale-95" 
                                    id="pdpThumb-@i" 
                                    onclick="goToPdpSlide(@i)" 
                                    title="@(img.IsMain ? "Ana Görsel - " : "")Görsel @(i+1)">
                                <img src="@img.ImageUrl" alt="Küçük resim @(i+1)" class="w-full h-full object-contain" />
                                @if (img.IsMain)
                                {
                                    <span class="absolute bottom-0.5 right-0.5 bg-blue-600 text-white text-[8px] font-bold px-1 rounded">Ana</span>
                                }
                            </button>
                        }
                    </div>
                }
            </div>

            <!-- SAĞ KOLON: ÜRÜN BİLGİLERİ, TEDARİKÇİ, FİYAT & SATIN ALMA (7 Sütun) -->
            <div class="lg:col-span-7 xl:col-span-7 flex flex-col justify-between">
                <div>
                    <!-- SKU & Kategori Rozetleri -->
                    <div class="flex flex-wrap items-center gap-2 mb-2.5">
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-mono font-bold bg-slate-100 text-slate-600 border border-slate-200/80">
                            SKU: @Model.Sku
                        </span>
                        @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
                        {
                            <a href="/#ihtiyaciniz-olan-urunler" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold bg-blue-50 text-blue-700 hover:bg-blue-100 border border-blue-200/70 transition-colors">
                                <svg class="w-3 h-3 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                                    <line x1="7" y1="7" x2="7.01" y2="7"></line>
                                </svg>
                                <span>@Model.CategoryName</span>
                            </a>
                        }
                    </div>

                    <!-- Ürün Başlığı -->
                    <h1 class="text-xl sm:text-2xl lg:text-3xl font-black text-slate-900 tracking-tight leading-snug mb-3">
                        @Model.Title
                    </h1>

                    <!-- Tedarikçi Firma Kartı -->
                    <div class="p-3.5 sm:p-4 rounded-2xl bg-slate-50/90 border border-slate-200/90 flex items-center justify-between gap-3 mb-5 hover:bg-slate-50 transition-all">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-slate-950 via-slate-900 to-slate-800 text-white font-black flex items-center justify-center text-lg shrink-0 shadow-sm shadow-slate-900/20">
                                @(string.IsNullOrWhiteSpace(Model.SupplierCompanyName) ? "T" : Model.SupplierCompanyName.Substring(0, 1).ToUpper())
                            </div>
                            <div class="min-w-0">
                                <div class="font-bold text-sm sm:text-base text-slate-900 truncate">
                                    @Model.SupplierCompanyName
                                </div>
                                <div class="text-xs text-slate-500 flex items-center gap-1.5 mt-0.5 truncate">
                                    <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                        <circle cx="12" cy="10" r="3"></circle>
                                    </svg>
                                    <span>@Model.SupplierLocation</span>
                                    @if (!string.IsNullOrWhiteSpace(Model.SupplierOfficial))
                                    {
                                        <span class="text-slate-400">•</span>
                                        <span class="truncate">Yetkili: @Model.SupplierOfficial</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="shrink-0">
                            <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200/80 px-2.5 py-1 rounded-full shadow-2xs">
                                <svg class="w-3 h-3 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                <span class="hidden sm:inline">Doğrulanmış</span> Üretici
                            </span>
                        </div>
                    </div>

                    <!-- Fiyat ve KDV Kutusu -->
                    <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-br from-slate-50 via-blue-50/20 to-slate-50 border border-slate-200/90 mb-5">
                        <div class="flex items-baseline gap-2 mb-1">
                            <span class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight">
                                @Model.UnitPrice.ToString("N2") ₺
                            </span>
                            <span class="text-xs sm:text-sm font-semibold text-slate-500">
                                + %20 KDV
                            </span>
                        </div>
                        <div class="text-xs sm:text-sm font-bold text-emerald-600 flex items-center gap-1.5">
                            <svg class="w-4 h-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>KDV Dahil Toplam: <strong>@Model.GrandTotal.ToString("N2") ₺</strong> / Adet</span>
                        </div>
                    </div>
                </div>

                <!-- Satın Alma & Adet Seçici Bölümü -->
                <div>
                    @if (Model.IsOwner)
                    {
                        <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-xs sm:text-sm font-medium flex items-start gap-3 mb-4">
                            <svg class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            </svg>
                            <div>
                                Bu ürün firmanıza aittir. İlanınızı <a href="/Dashboard/SupplierOrders" class="font-bold text-amber-800 underline hover:text-amber-950">Satıcı Paneli</a> üzerinden yönetebilirsiniz.
                            </div>
                        </div>
                    }
                    else if (Model.IsOutOfStock)
                    {
                        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs sm:text-sm font-semibold mb-3">
                            Bu ürünün stoğu tükenmiştir. Tedarikçi yeni stok eklediğinde sipariş oluşturabilirsiniz.
                        </div>
                        <button type="button" disabled class="w-full py-3.5 sm:py-4 px-6 rounded-xl bg-slate-200 text-slate-500 font-bold text-sm sm:text-base cursor-not-allowed">
                            Ürün Tükendi
                        </button>
                    }
                    else
                    {
                        <!-- Adet Seçici -->
                        <div class="flex items-center gap-3 mb-4">
                            <label class="text-xs sm:text-sm font-bold text-slate-800">Adet:</label>
                            <div class="inline-flex items-center border border-slate-300 rounded-xl bg-white shadow-xs overflow-hidden">
                                <button type="button" onclick="adjustDetailQty(-1)" class="w-9 h-9 sm:w-10 sm:h-10 bg-slate-50 hover:bg-slate-100 text-slate-800 font-bold text-base sm:text-lg flex items-center justify-center transition-colors active:scale-95" aria-label="Azalt">-</button>
                                <input id="detailQuantityInput" type="number" value="1" min="1" max="@Model.StockQuantity" class="w-12 sm:w-14 text-center font-black text-slate-900 border-none outline-none text-sm sm:text-base" onchange="validateDetailQty(this)" />
                                <button type="button" onclick="adjustDetailQty(1)" class="w-9 h-9 sm:w-10 sm:h-10 bg-slate-50 hover:bg-slate-100 text-slate-800 font-bold text-base sm:text-lg flex items-center justify-center transition-colors active:scale-95" aria-label="Arttır">+</button>
                            </div>
                            <span class="text-xs text-slate-500">(Maks: <strong class="text-slate-800">@Model.StockQuantity</strong> adet)</span>
                        </div>

                        <!-- Aksiyon Butonları -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <!-- Hemen Al -->
                            <button type="button" onclick="buyNowFromDetail(@Model.ItemID)" class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 rounded-xl bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-500 hover:to-blue-600 text-white font-bold text-sm sm:text-base shadow-lg shadow-blue-600/30 hover:-translate-y-0.5 active:translate-y-0 transition-all">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                                </svg>
                                <span>Hemen Al</span>
                            </button>

                            <!-- Sepete Ekle -->
                            <button type="button" onclick="addToCartFromDetail(@Model.ItemID, '@Html.Raw(Model.Title.Replace("'", "\\'"))', @Model.UnitPrice, '@Html.Raw(Model.Brand.Replace("'", "\\'"))', '@Model.ImageUrl', @Model.StockQuantity)" class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm sm:text-base shadow-md shadow-slate-900/20 hover:-translate-y-0.5 active:translate-y-0 transition-all">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                                <span>Sepete Ekle</span>
                            </button>
                        </div>
                    }

                    <!-- B2B Güvence Şeritleri -->
                    <div class="grid grid-cols-3 gap-2 pt-4 sm:pt-5 mt-4 sm:mt-5 border-t border-dashed border-slate-200 text-center">
                        <div class="p-2 rounded-xl bg-slate-50/70 border border-slate-100 flex flex-col items-center">
                            <svg class="w-4 h-4 text-blue-600 mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                            </svg>
                            <span class="text-[10px] sm:text-[11px] font-bold text-slate-700">Resmi E-Fatura</span>
                        </div>
                        <div class="p-2 rounded-xl bg-slate-50/70 border border-slate-100 flex flex-col items-center">
                            <svg class="w-4 h-4 text-emerald-600 mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            </svg>
                            <span class="text-[10px] sm:text-[11px] font-bold text-slate-700">iyzico Havuz</span>
                        </div>
                        <div class="p-2 rounded-xl bg-slate-50/70 border border-slate-100 flex flex-col items-center">
                            <svg class="w-4 h-4 text-indigo-600 mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="1" y="3" width="15" height="13"></rect>
                                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                <circle cx="18.5" cy="18.5" r="2.5"></circle>
                            </svg>
                            <span class="text-[10px] sm:text-[11px] font-bold text-slate-700">Fabrikadan Sevk</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- ==================== BÖLÜM 3: BİLGİ SEKMELERİ ==================== -->
        <div class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 shadow-sm overflow-hidden mt-6 sm:mt-8">
            <!-- Sekme Başlıkları -->
            <div class="flex items-center border-b border-slate-200 bg-slate-50/70 overflow-x-auto no-scrollbar px-3 sm:px-6">
                <button type="button" 
                        class="detail-tab-btn active py-3.5 sm:py-4 px-4 sm:px-6 text-xs sm:text-sm font-bold border-b-2 border-blue-600 text-blue-600 flex items-center gap-2 transition-colors whitespace-nowrap" 
                        onclick="switchDetailTab('specsTab', this)">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                        <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                    </svg>
                    <span>Teknik Özellikler</span>
                </button>
                <button type="button" 
                        class="detail-tab-btn py-3.5 sm:py-4 px-4 sm:px-6 text-xs sm:text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center gap-2 transition-colors whitespace-nowrap" 
                        onclick="switchDetailTab('descTab', this)">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                    </svg>
                    <span>Ürün Açıklaması</span>
                </button>
                <button type="button" 
                        class="detail-tab-btn py-3.5 sm:py-4 px-4 sm:px-6 text-xs sm:text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center gap-2 transition-colors whitespace-nowrap" 
                        onclick="switchDetailTab('guaranteeTab', this)">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
