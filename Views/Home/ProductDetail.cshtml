@model satinalmaportali2.Models.ProductDetailPageViewModel
@{
    ViewData["Title"] = $"{Model.Title} - Tedarik Portalı";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<style>
    .b2b-detail-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 20px rgba(0,0,0,0.04);
        padding: 32px;
        display: grid;
        grid-template-columns: 480px 1fr;
        gap: 40px;
        margin-bottom: 32px;
    }
    .b2b-detail-image-box {
        width: 100%;
        height: 480px;
        border-radius: 14px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }
    .b2b-detail-actions-grid {
        display: grid;
        grid-template-columns: 1.3fr 1fr;
        gap: 12px;
    }
    .b2b-related-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }
    @@media (max-width: 1024px) {
        .b2b-detail-card {
            grid-template-columns: 1fr;
            gap: 24px;
            padding: 24px;
        }
        .b2b-detail-image-box {
            height: 380px;
        }
        .b2b-related-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
    @@media (max-width: 640px) {
        .b2b-product-detail-container {
            padding: 0 10px !important;
            margin: 12px auto 40px !important;
        }
        .b2b-detail-card {
            padding: 16px;
            border-radius: 12px;
        }
        .b2b-detail-image-box {
            height: 280px;
            border-radius: 10px;
        }
        .b2b-detail-actions-grid {
            grid-template-columns: 1fr;
        }
        .b2b-related-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }
    }
</style>

<div class="b2b-product-detail-container" style="max-width: 1240px; margin: 24px auto 60px; padding: 0 16px;">
    <!-- SADE BREADCRUMB -->
    <nav class="b2b-detail-breadcrumb" aria-label="breadcrumb" style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem; color: #64748b; margin-bottom: 20px;">
        <a href="/" style="color: #2563eb; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            Anasayfa
        </a>
        <span>/</span>
        <a href="/#vitrinContainer" style="color: #2563eb; text-decoration: none; font-weight: 600;">Ürünler</a>
        <span>/</span>
        <span style="color: #0f172a; font-weight: 700;">@Model.Title</span>
    </nav>

    <!-- ANA ÜRÜN KARTI (RESPONSIVE GRID) -->
    <div class="b2b-detail-card">
        
        <!-- SOL KOLON: GÖRSEL CAROUSEL & THUMBNAILS -->
        <div class="b2b-detail-media-col">
            <div class="b2b-detail-carousel-wrapper">
                <div class="b2b-detail-image-box" id="pdpImageBox">
                    
                    @for (int i = 0; i < Model.Images.Count; i++)
                    {
                        var img = Model.Images[i];
                        <div class="b2b-pdp-slide @(i == 0 ? "active" : "")" id="pdpSlide-@i" style="display: @(i == 0 ? "flex" : "none"); width: 100%; height: 100%; align-items: center; justify-content: center;">
                            <img src="@img.ImageUrl" alt="@Model.Title - Görsel @(i+1)" style="max-width: 95%; max-height: 95%; object-fit: contain; transition: transform 0.3s ease;" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'" />
                        </div>
                    }

                    @if (Model.Images.Count > 1)
                    {
                        <button type="button" class="b2b-pdp-nav-btn b2b-pdp-prev" onclick="changePdpSlide(-1)" title="Önceki Görsel" aria-label="Önceki">‹</button>
                        <button type="button" class="b2b-pdp-nav-btn b2b-pdp-next" onclick="changePdpSlide(1)" title="Sonraki Görsel" aria-label="Sonraki">›</button>
                        <div class="b2b-pdp-counter" id="pdpCounter">1 / @Model.Images.Count</div>
                    }

                    @if (Model.Images.Any(x => x.IsMain))
                    {
                        <div class="b2b-pdp-main-badge" id="pdpMainBadge" style="display: @(Model.Images[0].IsMain ? "flex" : "none");">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                            <span>Ana Görsel</span>
                        </div>
                    }
                    
                    @if (Model.IsOutOfStock)
                    {
                        <div style="position: absolute; top: 16px; left: 16px; background: #ef4444; color: #ffffff; padding: 6px 14px; border-radius: 8px; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.35); z-index: 5;">
                            Tükendi (Stokta Yok)
                        </div>
                    }
                    else
                    {
                        <div style="position: absolute; top: 16px; left: 16px; background: #10b981; color: #ffffff; padding: 6px 14px; border-radius: 8px; font-size: 0.8rem; font-weight: 800; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3); z-index: 5;">
                            <span>●</span> @Model.StockQuantity Adet Hazır Stok
                        </div>
                    }
                </div>

                @if (Model.Images.Count > 1)
                {
                    <div class="b2b-detail-thumbnails-strip" id="pdpThumbnailsStrip">
                        @for (int i = 0; i < Model.Images.Count; i++)
                        {
                            var img = Model.Images[i];
                            <button type="button" class="b2b-thumb-btn @(i == 0 ? "is-active" : "")" id="pdpThumb-@i" onclick="goToPdpSlide(@i)" title="@(img.IsMain ? "Ana Görsel - " : "")Görsel @(i+1)">
                                <img src="@img.ImageUrl" alt="Küçük resim @(i+1)" />
                                @if (img.IsMain)
                                {
                                    <span class="b2b-thumb-main-indicator" title="Ana Resim">Ana</span>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- SAĞ KOLON: ÜRÜN BİLGİLERİ, TEDARİKÇİ, FİYAT & SATIN ALMA -->
        <div class="b2b-detail-info-col" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <!-- SKU & KATEGORİ -->
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                    <span style="background: #f1f5f9; color: #475569; padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; font-family: monospace;">
                        SKU: @Model.Sku
                    </span>
                    <span style="color: #64748b; font-size: 0.8rem; font-weight: 600;">
                        Kategori: <strong style="color: #0f172a;">@Model.CategoryName</strong>
                    </span>
                </div>

                <!-- ÜRÜN BAŞLIĞI -->
                <h1 style="font-size: 1.75rem; font-weight: 800; color: #0f172a; margin: 0 0 16px; line-height: 1.3;">
                    @Model.Title
                </h1>

                <!-- GERÇEK TEDARİKÇİ KARTI (SAHTE PUAN/YILDIZ YOK) -->
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px 18px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 42px; height: 42px; border-radius: 10px; background: #0f172a; color: #ffffff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.1rem;">
                            @(string.IsNullOrWhiteSpace(Model.SupplierCompanyName) ? "T" : Model.SupplierCompanyName.Substring(0, 1).ToUpper())
                        </div>
                        <div>
                            <div style="font-weight: 800; color: #0f172a; font-size: 0.95rem;">
                                @Model.SupplierCompanyName
                            </div>
                            <div style="font-size: 0.78rem; color: #64748b; margin-top: 2px; display: flex; align-items: center; gap: 4px;">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                <span>@Model.SupplierLocation</span>
                                @if (!string.IsNullOrWhiteSpace(Model.SupplierOfficial))
                                {
                                    <span> • Yetkili: @Model.SupplierOfficial</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FİYAT KUTUSU -->
                <div style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 14px; padding: 18px 20px; margin-bottom: 20px;">
                    <div style="display: flex; align-items: baseline; gap: 10px; margin-bottom: 4px;">
                        <span style="font-size: 2.1rem; font-weight: 900; color: #0f172a;">
                            @Model.UnitPrice.ToString("N2") ₺
                        </span>
                        <span style="font-size: 0.9rem; color: #64748b; font-weight: 600;">+ %20 KDV</span>
                    </div>
                    <div style="font-size: 0.88rem; color: #059669; font-weight: 700;">
                        KDV Dahil Toplam: @Model.GrandTotal.ToString("N2") ₺ / Adet
                    </div>
                </div>
            </div>

            <!-- ADET SEÇİMİ VE AKSİYONLAR -->
            <div>
                @if (Model.IsOwner)
                {
                    <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 12px; padding: 16px; margin-bottom: 16px; color: #92400e; font-size: 0.88rem; font-weight: 600; display: flex; align-items: center; gap: 10px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                        <span>Bu ürün firmanıza aittir. İlanınızı <a href="/Dashboard/SupplierOrders" style="color: #b45309; text-decoration: underline; font-weight: 800;">Satıcı Paneli</a> üzerinden yönetebilirsiniz.</span>
                    </div>
                }
                else if (Model.IsOutOfStock)
                {
                    <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 12px; padding: 14px; margin-bottom: 16px; color: #b91c1c; font-size: 0.88rem; font-weight: 600;">
                        Bu ürünün stoğu tükenmiştir. Tedarikçi stok eklediğinde tekrar sipariş verebilirsiniz.
                    </div>
                    <button type="button" disabled style="background: #cbd5e1; color: #64748b; border: none; padding: 15px; border-radius: 12px; font-weight: 800; font-size: 1rem; width: 100%; cursor: not-allowed;">
                        Ürün Tükendi
                    </button>
                }
                else
                {
                    <!-- ADET SEÇİCİ (+ / -) -->
                    <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 18px;">
                        <label style="font-weight: 700; color: #0f172a; font-size: 0.9rem;">Adet:</label>
                        <div style="display: inline-flex; align-items: center; border: 1px solid #cbd5e1; border-radius: 10px; overflow: hidden; background: #ffffff;">
                            <button type="button" onclick="adjustDetailQty(-1)" style="border: none; background: #f8fafc; padding: 9px 15px; font-size: 1.1rem; font-weight: 800; color: #0f172a; cursor: pointer;">-</button>
                            <input id="detailQuantityInput" type="number" value="1" min="1" max="@Model.StockQuantity" style="width: 60px; text-align: center; border: none; font-size: 1rem; font-weight: 800; color: #0f172a; outline: none;" onchange="validateDetailQty(this)" />
                            <button type="button" onclick="adjustDetailQty(1)" style="border: none; background: #f8fafc; padding: 9px 15px; font-size: 1.1rem; font-weight: 800; color: #0f172a; cursor: pointer;">+</button>
                        </div>
                        <span style="font-size: 0.8rem; color: #64748b;">(Maks: <strong>@Model.StockQuantity</strong> adet)</span>
                    </div>

                    <!-- AKSİYON BUTONLARI (RESPONSIVE GRID) -->
                    <div class="b2b-detail-actions-grid">
                        <!-- HEMEN AL -->
                        <button type="button" onclick="buyNowFromDetail(@Model.ItemID)" style="background: linear-gradient(135deg, #2563eb, #1d4ed8); color: #ffffff; border: none; padding: 15px 20px; border-radius: 12px; font-weight: 800; font-size: 1rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                            <span>Hemen Al</span>
                        </button>

                        <!-- SEPETE EKLE -->
                        <button type="button" onclick="addToCartFromDetail(@Model.ItemID, '@Html.Raw(Model.Title.Replace("'", "\\'"))', @Model.UnitPrice, '@Html.Raw(Model.Brand.Replace("'", "\\'"))', '@Model.ImageUrl', @Model.StockQuantity)" style="background: #ffffff; color: #0f172a; border: 2px solid #0f172a; padding: 15px 20px; border-radius: 12px; font-weight: 800; font-size: 0.95rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                            <span>Sepete Ekle</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- DETAY BİLGİ SEKMELERİ (YALNIZCA GERÇEK SEKMELER) -->
    <div class="b2b-detail-tabs-wrapper" style="background: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04); overflow: hidden; margin-bottom: 36px;">
        <!-- SEKME BUTONLARI -->
        <div style="display: flex; border-bottom: 1px solid #e2e8f0; background: #f8fafc; overflow-x: auto;">
            <button type="button" class="detail-tab-btn active" onclick="switchDetailTab('specsTab', this)" style="padding: 15px 24px; font-weight: 800; font-size: 0.92rem; border: none; background: transparent; cursor: pointer; border-bottom: 3px solid #2563eb; color: #2563eb; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
                <span>Teknik Özellikler</span>
            </button>
            <button type="button" class="detail-tab-btn" onclick="switchDetailTab('descTab', this)" style="padding: 15px 24px; font-weight: 700; font-size: 0.92rem; border: none; background: transparent; cursor: pointer; border-bottom: 3px solid transparent; color: #64748b; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                <span>Ürün Açıklaması</span>
            </button>
        </div>

        <!-- SEKME İÇERİKLERİ -->
        <div style="padding: 28px 32px;">
            <!-- 1. TEKNİK ÖZELLİKLER -->
            <div id="specsTab" class="detail-tab-pane" style="display: block;">
                @if (Model.Specifications != null && Model.Specifications.Any())
                {
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
                        <tbody>
                            @foreach (var spec in Model.Specifications)
                            {
                                <tr style="border-bottom: 1px solid #f1f5f9;">
                                    <td style="padding: 11px 16px; width: 30%; font-weight: 700; color: #475569; background: #f8fafc;">@spec.Key</td>
                                    <td style="padding: 11px 16px; color: #0f172a; font-weight: 600;">@spec.Value</td>
                                </tr>
                            }
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 11px 16px; width: 30%; font-weight: 700; color: #475569; background: #f8fafc;">Stok Miktarı</td>
                                <td style="padding: 11px 16px; color: #059669; font-weight: 700;">@Model.StockQuantity Adet</td>
                            </tr>
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 11px 16px; width: 30%; font-weight: 700; color: #475569; background: #f8fafc;">Tedarikçi Firma</td>
                                <td style="padding: 11px 16px; color: #0f172a; font-weight: 600;">@Model.SupplierCompanyName (@Model.SupplierLocation)</td>
                            </tr>
                        </tbody>
                    </table>
                }
                else
                {
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
                        <tbody>
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 11px 16px; width: 30%; font-weight: 700; color: #475569; background: #f8fafc;">Stok Kodu / SKU</td>
                                <td style="padding: 11px 16px; color: #0f172a; font-weight: 600;">@Model.Sku</td>
                            </tr>
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 11px 16px; width: 30%; font-weight: 700; color: #475569; background: #f8fafc;">Kategori</td>
                                <td style="padding: 11px 16px; color: #0f172a; font-weight: 600;">@Model.CategoryName</td>
                            </tr>
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 11px 16px; width: 30%; font-weight: 700; color: #475569; background: #f8fafc;">Stok Durumu</td>
                                <td style="padding: 11px 16px; color: #059669; font-weight: 700;">@Model.StockQuantity Adet</td>
                            </tr>
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 11px 16px; width: 30%; font-weight: 700; color: #475569; background: #f8fafc;">Tedarikçi Firma</td>
                                <td style="padding: 11px 16px; color: #0f172a; font-weight: 600;">@Model.SupplierCompanyName (@Model.SupplierLocation)</td>
                            </tr>
                        </tbody>
                    </table>
                }
            </div>

            <!-- 2. ÜRÜN AÇIKLAMASI -->
            <div id="descTab" class="detail-tab-pane" style="display: none;">
                <p style="font-size: 0.93rem; line-height: 1.8; color: #334155; margin: 0; white-space: pre-line;">
                    @Model.Description
                </p>
            </div>
        </div>
    </div>

    <!-- BENZER / İLGİLİ ÜRÜNLER (GERÇEK VERİTABANI ÜRÜNLERİ) -->
    @if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
    {
        <div class="b2b-related-products-section" style="margin-top: 36px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
                <h2 style="font-size: 1.25rem; font-weight: 800; color: #0f172a; margin: 0;">
                    Diğer İlgili Ürünler
                </h2>
                <a href="/#vitrinContainer" style="color: #2563eb; text-decoration: none; font-weight: 700; font-size: 0.85rem;">
                    Vitrini Gör →
                </a>
            </div>

            <div class="b2b-related-grid">
                @foreach (var rel in Model.RelatedProducts)
                {
                    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.15s, box-shadow 0.15s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 20px rgba(0,0,0,0.06)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                        <a href="/Product/@rel.ItemID" style="text-decoration: none; color: inherit; display: block;">
                            <div style="height: 140px; background: #f8fafc; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 10px; overflow: hidden;">
                                <img src="@rel.ImageUrl" alt="@rel.Title" style="max-height: 85%; max-width: 85%; object-fit: contain;" />
                            </div>
                            <div style="font-size: 0.72rem; color: #64748b; font-weight: 700; margin-bottom: 2px;">@rel.Brand</div>
                            <div style="font-size: 0.85rem; font-weight: 800; color: #0f172a; line-height: 1.3; height: 36px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; margin-bottom: 8px;">
                                @rel.Title
                            </div>
                        </a>
                        <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 8px; border-top: 1px dashed #e2e8f0;">
                            <div>
                                <div style="font-size: 1rem; font-weight: 900; color: #0f172a;">@rel.UnitPrice.ToString("N2") ₺</div>
                                <div style="font-size: 0.68rem; color: #64748b;">+ %20 KDV</div>
                            </div>
                            <a href="/Product/@rel.ItemID" style="background: #eff6ff; color: #2563eb; border-radius: 6px; padding: 5px 10px; font-weight: 700; font-size: 0.78rem; text-decoration: none;">
                                İncele →
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- =========================================================================
     3D SECURE DOĞRULAMA MODALI (#iyzico3DModal)
     ========================================================================= -->
<div id="iyzico3DModal" class="ty-modal-overlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(15,23,42,0.75); backdrop-filter:blur(4px); z-index:2147483647; align-items:center; justify-content:center; padding:16px;">
    <div class="ty-modal-card" style="background:#ffffff; width:100%; max-width:560px; border-radius:16px; box-shadow:0 25px 60px rgba(0,0,0,0.3); overflow:hidden; display:flex; flex-direction:column; max-height:90vh;">
        <div style="padding:16px 20px; background:#0f172a; color:#ffffff; display:flex; align-items:center; justify-content:space-between;">
            <div style="display:flex; align-items:center; gap:10px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                <span style="font-weight:800; font-size:1rem; color:#ffffff;">3D Secure Banka Doğrulaması</span>
            </div>
            <button type="button" onclick="closeIyzico3DModal()" style="background:transparent; border:none; color:#ffffff; font-size:1.4rem; cursor:pointer;">&times;</button>
        </div>
        <div style="flex:1; min-height:450px; background:#f8fafc;">
            <iframe id="iyzico3DIframe" name="iyzico3DIframe" style="width:100%; height:450px; border:none; display:block;" allow="payment; usb; clipboard-write"></iframe>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/trendyol-vitrin.js" asp-append-version="true"></script>
    <script>
        // PDP Görsel Carousel Kontrolleri
        const pdpImagesCount = @Model.Images.Count;
        const pdpImagesMeta = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Images.Select(img => new { isMain = img.IsMain })));
        let currentPdpIndex = 0;

        function goToPdpSlide(index) {
            if (pdpImagesCount <= 1) return;
            if (index < 0) index = pdpImagesCount - 1;
            if (index >= pdpImagesCount) index = 0;
            currentPdpIndex = index;

            for (let i = 0; i < pdpImagesCount; i++) {
                const slide = document.getElementById('pdpSlide-' + i);
                const thumb = document.getElementById('pdpThumb-' + i);
                if (slide) {
                    if (i === index) {
                        slide.style.display = 'flex';
                        slide.classList.add('active');
                    } else {
                        slide.style.display = 'none';
                        slide.classList.remove('active');
                    }
                }
                if (thumb) {
                    if (i === index) {
                        thumb.classList.add('is-active');
                        try {
                            thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                        } catch(e) {}
                    } else {
                        thumb.classList.remove('is-active');
                    }
                }
            }

            const counter = document.getElementById('pdpCounter');
            if (counter) {
                counter.textContent = `${index + 1} / ${pdpImagesCount}`;
            }

            const mainBadge = document.getElementById('pdpMainBadge');
            if (mainBadge && pdpImagesMeta && pdpImagesMeta[index]) {
                mainBadge.style.display = pdpImagesMeta[index].isMain ? 'flex' : 'none';
            }
        }

        function changePdpSlide(delta) {
            goToPdpSlide(currentPdpIndex + delta);
        }

        // Klavye ok tuşları ile gezinti
        document.addEventListener('keydown', (e) => {
            if (pdpImagesCount <= 1) return;
            if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;
            if (e.key === 'ArrowLeft') changePdpSlide(-1);
            if (e.key === 'ArrowRight') changePdpSlide(1);
        });

        // Dokunmatik kaydırma (Swipe)
        (function setupPdpTouchSwipe() {
            const box = document.getElementById('pdpImageBox');
            if (!box || pdpImagesCount <= 1) return;
            let touchStartX = 0;
            let touchEndX = 0;
            box.addEventListener('touchstart', (e) => {
                touchStartX = e.changedTouches[0].screenX;
            }, { passive: true });
            box.addEventListener('touchend', (e) => {
                touchEndX = e.changedTouches[0].screenX;
                const diff = touchEndX - touchStartX;
                if (Math.abs(diff) > 45) {
                    if (diff > 0) changePdpSlide(-1);
                    else changePdpSlide(1);
                }
            }, { passive: true });
        })();

        // Sekme Değiştirici
        function switchDetailTab(tabId, btn) {
            document.querySelectorAll('.detail-tab-pane').forEach(p => p.style.display = 'none');
            document.querySelectorAll('.detail-tab-btn').forEach(b => {
                b.style.borderBottomColor = 'transparent';
                b.style.color = '#64748b';
                b.style.fontWeight = '700';
            });

            const target = document.getElementById(tabId);
            if (target) target.style.display = 'block';

            btn.style.borderBottomColor = '#2563eb';
            btn.style.color = '#2563eb';
            btn.style.fontWeight = '800';
        }

        // Adet Arttır / Azalt
        function adjustDetailQty(delta) {
            const input = document.getElementById('detailQuantityInput');
            if (!input) return;
            let val = parseInt(input.value) || 1;
            val += delta;
            const max = parseInt(input.getAttribute('max')) || 9999;
            if (val < 1) val = 1;
            if (val > max) {
                val = max;
                if (typeof showB2BToast === 'function') {
                    showB2BToast(`Mevcut stok sınırına (${max} adet) ulaştınız.`, 'warning');
                }
            }
            input.value = val;
        }

        function validateDetailQty(input) {
            let val = parseInt(input.value) || 1;
            const max = parseInt(input.getAttribute('max')) || 9999;
            if (val < 1) val = 1;
            if (val > max) {
                val = max;
                if (typeof showB2BToast === 'function') {
                    showB2BToast(`Mevcut stok sınırına (${max} adet) ulaştınız.`, 'warning');
                }
            }
            input.value = val;
        }

        // Sepete Ekle
        function addToCartFromDetail(itemId, title, price, brand, image, maxStock) {
            const qtyInput = document.getElementById('detailQuantityInput');
            const qty = qtyInput ? (parseInt(qtyInput.value) || 1) : 1;

            if (maxStock <= 0) {
                if (typeof showB2BToast === 'function') showB2BToast("Bu ürünün stoğu tükenmiştir.", "danger");
                return;
            }

            let cart = [];
            try {
                const stored = localStorage.getItem('b2b_portal_cart');
                cart = stored ? JSON.parse(stored) : [];
            } catch(e) { cart = []; }

            const existingIndex = cart.findIndex(c => c.id === itemId);
            let currentInCart = existingIndex > -1 ? cart[existingIndex].quantity : 0;

            if (currentInCart + qty > maxStock) {
                if (typeof showB2BToast === 'function') {
                    showB2BToast(`Yetersiz stok! En fazla ${maxStock} adet alabilirsiniz (Sepetinizde zaten ${currentInCart} adet var).`, "danger");
                }
                return;
            }

            if (existingIndex > -1) {
                cart[existingIndex].quantity += qty;
            } else {
                cart.push({
                    id: itemId,
                    title: title,
                    price: price,
                    quantity: qty,
                    brand: brand,
                    image: image
                });
            }

            try {
                localStorage.setItem('b2b_portal_cart', JSON.stringify(cart));
            } catch(e) {}

            fetch('/Cart/AddToCart', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ itemID: itemId, quantity: qty })
            }).catch(() => {});

            const totalCount = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);
            const badge = document.getElementById('navCartBadge');
            if (badge) badge.textContent = totalCount;
            const bottomBadge = document.getElementById('bottomNavCartBadge');
            if (bottomBadge) {
                bottomBadge.textContent = totalCount;
                bottomBadge.style.display = totalCount > 0 ? 'inline-block' : 'none';
            }

            if (typeof showB2BToast === 'function') {
                showB2BToast(`${qty} adet "${title}" sepetinize eklendi!`, "success");
            }
        }

        // Hemen Al
        function buyNowFromDetail(itemId) {
            const qtyInput = document.getElementById('detailQuantityInput');
            const qty = qtyInput ? (parseInt(qtyInput.value) || 1) : 1;

            if (typeof directBuy === 'function') {
                directBuy(itemId, qty);
            } else {
                window.location.href = '/Cart/Index';
            }
        }
    </script>
}
