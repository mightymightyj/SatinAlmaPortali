                                }
                                <tr class="hover:bg-slate-50/60 transition-colors">
                                    <td class="py-3 px-4 sm:px-6 font-bold text-slate-600 bg-slate-50/70 w-1/3 sm:w-1/4">Stok Kodu (SKU)</td>
                                    <td class="py-3 px-4 sm:px-6 font-mono font-bold text-slate-900">@Model.Sku</td>
                                </tr>
                                <tr class="hover:bg-slate-50/60 transition-colors">
                                    <td class="py-3 px-4 sm:px-6 font-bold text-slate-600 bg-slate-50/70 w-1/3 sm:w-1/4">Kategori</td>
                                    <td class="py-3 px-4 sm:px-6 font-semibold text-slate-900">@Model.CategoryName</td>
                                </tr>
                                <tr class="hover:bg-slate-50/60 transition-colors">
                                    <td class="py-3 px-4 sm:px-6 font-bold text-slate-600 bg-slate-50/70 w-1/3 sm:w-1/4">Hazır Stok Miktarı</td>
                                    <td class="py-3 px-4 sm:px-6 font-bold text-emerald-600">@Model.StockQuantity Adet</td>
                                </tr>
                                <tr class="hover:bg-slate-50/60 transition-colors">
                                    <td class="py-3 px-4 sm:px-6 font-bold text-slate-600 bg-slate-50/70 w-1/3 sm:w-1/4">Tedarikçi Firma</td>
                                    <td class="py-3 px-4 sm:px-6 font-semibold text-slate-900">@Model.SupplierCompanyName (@Model.SupplierLocation)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 2. Ürün Açıklaması -->
                <div id="descTab" class="detail-tab-pane hidden">
                    <p class="text-xs sm:text-sm text-slate-700 leading-relaxed whitespace-pre-line font-normal">
                        @Model.Description
                    </p>
                </div>

                <!-- 3. Kurumsal Güvence -->
                <div id="guaranteeTab" class="detail-tab-pane hidden">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="p-4 sm:p-5 rounded-2xl bg-slate-50/80 border border-slate-200/80">
                            <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center font-bold mb-3">
                                01
                            </div>
                            <h4 class="text-sm font-bold text-slate-900 mb-1.5">Resmi B2B Faturası</h4>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                Siparişiniz onaylandıktan sonra satıcı tarafından kurumsal e-arşiv veya e-fatura kesilir ve muhasebe sisteminize gönderilir.
                            </p>
                        </div>
                        <div class="p-4 sm:p-5 rounded-2xl bg-slate-50/80 border border-slate-200/80">
                            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold mb-3">
                                02
                            </div>
                            <h4 class="text-sm font-bold text-slate-900 mb-1.5">iyzico Escrow Koruması</h4>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                Ödemeniz güvenli havuz hesabında bloke edilir. Ürün fabrikadan sevk edilip tarafınızca teslim alınana dek satıcıya aktarılmaz.
                            </p>
                        </div>
                        <div class="p-4 sm:p-5 rounded-2xl bg-slate-50/80 border border-slate-200/80">
                            <div class="w-10 h-10 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold mb-3">
                                03
                            </div>
                            <h4 class="text-sm font-bold text-slate-900 mb-1.5">Doğrudan Fabrika Teslimi</h4>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                Aracı komisyonu olmadan onaylı üreticinin deposundan paletli, sandıklı veya ambarlı kurumsal nakliye güvencesiyle sevk edilir.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ==================== BÖLÜM 4: İLGİLİ ÜRÜNLER ==================== -->
        @if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
        {
            <div class="mt-8 sm:mt-12">
                <div class="flex items-center justify-between mb-4 sm:mb-6">
                    <div>
                        <div class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-blue-600 mb-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                            <span>Katalog</span>
                        </div>
                        <h2 class="text-lg sm:text-2xl font-black text-slate-900 tracking-tight">
                            Diğer İlgili Ürünler
                        </h2>
                    </div>
                    <a href="/#ihtiyaciniz-olan-urunler" class="inline-flex items-center gap-1 text-xs sm:text-sm font-bold text-blue-600 hover:text-blue-700 hover:underline">
                        <span>Tüm Vitrini Gör</span>
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-5">
                    @foreach (var rel in Model.RelatedProducts)
                    {
                        <div class="group bg-white rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md hover:border-blue-500/40 p-3 sm:p-4 flex flex-col justify-between transition-all duration-200">
                            <a href="/Product/@rel.ItemID" class="block">
                                <div class="relative w-full aspect-square rounded-xl bg-slate-50/90 border border-slate-100 overflow-hidden flex items-center justify-center p-3 mb-3 group-hover:bg-slate-50 transition-colors">
                                    <img src="@rel.ImageUrl" alt="@rel.Title" class="max-w-full max-h-full object-contain transition-transform duration-200 group-hover:scale-105" />
                                </div>
                                <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1 truncate">
                                    @rel.Brand
                                </div>
                                <h3 class="text-xs sm:text-sm font-bold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-2 leading-snug min-h-[36px] mb-3">
                                    @rel.Title
                                </h3>
                            </a>
                            <div class="pt-2.5 border-t border-dashed border-slate-200 flex items-center justify-between gap-2">
                                <div>
                                    <div class="text-sm sm:text-base font-black text-slate-900">
                                        @rel.UnitPrice.ToString("N2") ₺
                                    </div>
                                    <div class="text-[10px] text-slate-400 font-medium">+ %20 KDV</div>
                                </div>
                                <a href="/Product/@rel.ItemID" class="inline-flex items-center justify-center px-2.5 sm:px-3 py-1.5 rounded-lg bg-blue-50 hover:bg-blue-600 text-blue-600 hover:text-white text-xs font-bold transition-all shadow-xs shrink-0">
