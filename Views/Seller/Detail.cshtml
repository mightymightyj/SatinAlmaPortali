@model satinalmaportali2.Models.SellerProfileViewModel
@{
    ViewData["Title"] = $"{Model.CompanyName} - Satıcı Profili & 10 Yıldızlı Değerlendirmeleri";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var initials = "TF";
    if (!string.IsNullOrEmpty(Model.CompanyName))
    {
        var words = Model.CompanyName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = words.Length >= 2
            ? $"{words[0][0]}{words[1][0]}".ToUpper()
            : Model.CompanyName.Substring(0, Math.Min(2, Model.CompanyName.Length)).ToUpper();
    }
}

<style>
    /* =========================================================
       SATICI SAYFASI & 10 YILDIZ DEĞERLENDİRME SİSTEMİ STİLLERİ
       ========================================================= */
    :root {
        --seller-star-gold: #f59e0b;
        --seller-star-bg: #e2e8f0;
        --seller-accent: #2563eb;
        --seller-card-bg: #ffffff;
        --seller-border: #e2e8f0;
        --seller-text: #0f172a;
        --seller-muted: #64748b;
    }

    [data-theme="dark"] {
        --seller-card-bg: #1e293b;
        --seller-border: #334155;
        --seller-text: #f8fafc;
        --seller-muted: #94a3b8;
    }

    .seller-page-wrapper {
        max-width: 1240px;
        margin: 0 auto;
        padding: 32px 20px 64px 20px;
        font-family: inherit;
    }

    /* Breadcrumbs */
    .seller-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        color: var(--seller-muted);
        margin-bottom: 24px;
    }
    .seller-breadcrumb a {
        color: var(--seller-muted);
        text-decoration: none;
        transition: color 0.2s;
    }
    .seller-breadcrumb a:hover {
        color: var(--seller-accent);
    }

    /* Satıcı Hero Kartı */
    .seller-hero-card {
        background: var(--seller-card-bg);
        border: 1px solid var(--seller-border);
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
        margin-bottom: 28px;
        display: flex;
        flex-wrap: wrap;
        gap: 28px;
        align-items: center;
        justify-content: space-between;
    }

    .seller-identity {
        display: flex;
        gap: 20px;
        align-items: center;
    }

    .seller-avatar-large {
        width: 88px;
        height: 88px;
        border-radius: 20px;
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        color: #ffffff;
        font-size: 2rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 16px -4px rgba(37, 99, 235, 0.3);
        flex-shrink: 0;
    }

    .seller-hero-details h1 {
        font-size: 1.65rem;
        font-weight: 800;
        color: var(--seller-text);
        margin: 0 0 8px 0;
        line-height: 1.25;
    }

    .seller-badges-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    .seller-badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 700;
    }
    .badge-verified {
        background: rgba(16, 185, 129, 0.1);
        color: #059669;
        border: 1px solid rgba(16, 185, 129, 0.25);
    }
    .badge-tier {
        background: rgba(37, 99, 235, 0.1);
        color: #2563eb;
        border: 1px solid rgba(37, 99, 235, 0.25);
    }
    .badge-location {
        background: rgba(100, 116, 139, 0.1);
        color: var(--seller-muted);
        border: 1px solid var(--seller-border);
    }

    .seller-hero-actions {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 10px;
    }

    .btn-rate-seller-hero {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: #ffffff;
        border: none;
        padding: 12px 24px;
        border-radius: 10px;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 14px rgba(245, 158, 11, 0.35);
        transition: all 0.2s;
    }
    .btn-rate-seller-hero:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(245, 158, 11, 0.45);
    }

    .verified-purchase-hint {
        font-size: 0.8rem;
        color: var(--seller-muted);
        display: flex;
        align-items: center;
        gap: 5px;
    }

    /* =========================================================
       10 YILDIZ DEĞERLENDİRME KARNESİ KARTI
       ========================================================= */
    .rating-scorecard-card {
        background: var(--seller-card-bg);
        border: 1px solid var(--seller-border);
        border-radius: 16px;
        padding: 32px;
        margin-bottom: 36px;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
    }

    .rating-scorecard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        padding-bottom: 18px;
        border-bottom: 1px solid var(--seller-border);
    }

    .rating-scorecard-header h2 {
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--seller-text);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .rating-scorecard-grid {
        display: grid;
        grid-template-columns: 320px 1fr 300px;
        gap: 32px;
        align-items: center;
    }

    @@media (max-width: 992px) {
        .rating-scorecard-grid {
            grid-template-columns: 1fr;
            gap: 24px;
        }
    }

    /* Sol Kısım: Büyük 10 Yıldız Skoru */
    .overall-score-box {
        text-align: center;
        padding: 24px 20px;
        background: rgba(245, 158, 11, 0.06);
        border: 1px solid rgba(245, 158, 11, 0.25);
        border-radius: 14px;
    }

    .big-score-number {
        font-size: 3.5rem;
        font-weight: 900;
        color: #d97706;
        line-height: 1;
        margin-bottom: 6px;
        letter-spacing: -1px;
    }

    .big-score-denominator {
        font-size: 1.2rem;
        color: var(--seller-muted);
        font-weight: 600;
    }

    /* 10 Yıldızlı Yıldız Gösterimi */
    .ten-stars-wrap {
        display: inline-flex;
        gap: 3px;
        margin: 10px 0;
    }
    .ten-star-item {
        font-size: 1.1rem;
        color: var(--seller-star-gold);
    }
    .ten-star-item.empty {
        color: var(--seller-star-bg);
    }

    .score-total-reviews {
        font-size: 0.85rem;
        color: var(--seller-muted);
        font-weight: 600;
    }

    /* Orta Kısım: 10'dan 1'e Yıldız Dağılım Çubukları */
    .star-bars-container {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .star-bar-row {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.82rem;
    }

    .star-bar-label {
        width: 60px;
        font-weight: 700;
        color: var(--seller-text);
        text-align: right;
    }

    .star-bar-track {
        flex: 1;
        height: 8px;
        background: var(--seller-border);
        border-radius: 999px;
        overflow: hidden;
        position: relative;
    }

    .star-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #f59e0b 0%, #fbbf24 100%);
        border-radius: 999px;
        transition: width 0.4s ease;
    }

    .star-bar-pct {
        width: 45px;
        font-size: 0.78rem;
        color: var(--seller-muted);
        font-weight: 600;
    }

    /* Sağ Kısım: 3 Alt Metrik Kutuları (Teslimat, Kalite, İletişim) */
    .sub-metrics-column {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .metric-card {
        background: var(--seller-card-bg);
        border: 1px solid var(--seller-border);
        border-radius: 10px;
        padding: 12px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .metric-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .metric-icon {
        font-size: 1.25rem;
    }
    .metric-title {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--seller-text);
    }
    .metric-score {
        font-size: 1.15rem;
        font-weight: 800;
        color: #d97706;
    }

    /* =========================================================
       DEĞERLENDİRMELER VE YORUM LİSTESİ
       ========================================================= */
    .seller-section-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }
    .seller-section-head h2 {
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--seller-text);
        margin: 0;
    }

    .reviews-filter-pills {
        display: flex;
        gap: 6px;
    }
    .btn-filter-pill {
        background: var(--seller-card-bg);
        border: 1px solid var(--seller-border);
        border-radius: 8px;
        padding: 6px 14px;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--seller-muted);
        cursor: pointer;
        transition: all 0.2s;
    }
    .btn-filter-pill.active, .btn-filter-pill:hover {
        background: var(--seller-accent);
        color: #ffffff;
        border-color: var(--seller-accent);
    }

    .review-card-item {
        background: var(--seller-card-bg);
        border: 1px solid var(--seller-border);
        border-radius: 12px;
        padding: 20px 24px;
        margin-bottom: 16px;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .review-card-item:hover {
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.04);
        transform: translateY(-1px);
    }

    .review-item-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 12px;
    }

    .reviewer-identity {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .reviewer-avatar {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: #0f172a;
        color: #fff;
        font-size: 0.95rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .reviewer-name {
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--seller-text);
    }

    .verified-purchase-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: #059669;
        background: #ecfdf5;
        border: 1px solid rgba(16, 185, 129, 0.2);
        padding: 2px 8px;
        border-radius: 6px;
        font-size: 0.72rem;
        font-weight: 700;
        margin-left: 8px;
    }

    .review-score-badge {
        background: rgba(245, 158, 11, 0.12);
        border: 1px solid rgba(245, 158, 11, 0.3);
        color: #d97706;
        padding: 4px 12px;
        border-radius: 8px;
        font-size: 0.92rem;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .review-text-body {
        font-size: 0.9rem;
        color: var(--seller-text);
        line-height: 1.6;
        margin-bottom: 12px;
    }

    .review-item-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.78rem;
        color: var(--seller-muted);
        padding-top: 10px;
        border-top: 1px solid rgba(0, 0, 0, 0.04);
    }

    /* Ürün Kartları Kataloğu */
    .seller-products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }
    .seller-product-card {
        background: var(--seller-card-bg);
        border: 1px solid var(--seller-border);
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
        display: flex;
        flex-direction: column;
    }
    .seller-product-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    }
    .product-img-box {
        height: 160px;
        overflow: hidden;
        position: relative;
    }
    .product-img-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .product-body {
        padding: 16px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    .product-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--seller-text);
        margin-bottom: 8px;
        line-height: 1.35;
    }
    .product-price {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--seller-accent);
        margin-top: auto;
    }

    /* =========================================================
       10 YILDIZ DEĞERLENDİRME MODAL STİLLERİ
       ========================================================= */
    .star-rating-selector {
        display: flex;
        gap: 6px;
        justify-content: center;
        margin: 16px 0;
    }
    .star-btn-pick {
        background: none;
        border: none;
        font-size: 1.8rem;
        color: #cbd5e1;
        cursor: pointer;
        transition: color 0.15s, transform 0.15s;
        padding: 2px;
    }
    .star-btn-pick.active, .star-btn-pick.hovered {
        color: #f59e0b;
        transform: scale(1.15);
    }
    .star-score-readout {
        text-align: center;
        font-size: 1.1rem;
        font-weight: 800;
        color: #d97706;
        margin-bottom: 12px;
    }
</style>

<div class="seller-page-wrapper">
    <!-- Breadcrumb -->
    <nav class="seller-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Anasayfa</a>
        <span>/</span>
        <a href="/#b2b-vitrin">Tedarikçiler</a>
        <span>/</span>
        <span style="color: var(--seller-text); font-weight: 600;">@Model.CompanyName</span>
    </nav>

    <!-- Satıcı Hero Kartı -->
    <div class="seller-hero-card">
        <div class="seller-identity">
            @if (!string.IsNullOrWhiteSpace(Model.CompanyLogo))
            {
                <img src="@Model.CompanyLogo" alt="@Model.CompanyName" class="seller-avatar-large" style="object-fit: cover;" />
            }
            else
            {
                <div class="seller-avatar-large">@initials</div>
            }
            <div class="seller-hero-details">
                <h1>@Model.CompanyName</h1>
                <div class="seller-badges-row">
                    <span class="seller-badge-pill badge-verified">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        Onaylı B2B Tedarikçi
                    </span>
                    <span class="seller-badge-pill badge-tier">🛡️ @Model.MembershipTypeName</span>
                    <span class="seller-badge-pill badge-location">📍 @Model.CityName, @Model.DistrictName</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.CompanyDetailText))
                {
                    <p style="font-size: 0.85rem; color: var(--seller-muted); margin: 10px 0 0 0; max-width: 600px;">
                        @Model.CompanyDetailText
                    </p>
                }
            </div>
        </div>

        <div class="seller-hero-actions">
            @if (Model.HasUserPurchasedFromSeller && Model.EligibleOrderID.HasValue)
            {
                <button type="button" class="btn-rate-seller-hero" onclick="openDirectReviewModal(@Model.EligibleOrderID.Value, this.getAttribute('data-seller-name'))" data-seller-name="@Model.CompanyName">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                    Satıcıyı Değerlendir
                </button>
                <div class="verified-purchase-hint">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    Bu satıcıdan doğrulanmış siparişiniz var
                </div>
            }
            else
            {
                <div style="background: rgba(0,0,0,0.03); border: 1px dashed var(--seller-border); padding: 10px 16px; border-radius: 10px; text-align: right;">
                    <div style="font-size: 0.82rem; font-weight: 700; color: var(--seller-text);">🛡️ Doğrulanmış Satın Alım Sistemi</div>
                    <div style="font-size: 0.75rem; color: var(--seller-muted);">Yalnızca bu satıcıdan ürün teslim alan kurumsal alıcılar değerlendirme yapabilir.</div>
                </div>
            }
        </div>
    </div>

    <!-- ==================== 10 YILDIZ DEĞERLENDİRME KARNESİ ==================== -->
    <div class="rating-scorecard-card">
        <div class="rating-scorecard-header">
            <h2>
                <span>★</span>
                Satıcı Değerlendirme Karnesi (10 Yıldız Üzerinden)
            </h2>
            <span style="font-size: 0.85rem; color: var(--seller-muted); font-weight: 600;">
                Toplam @Model.TotalReviews Doğrulanmış Değerlendirme
            </span>
        </div>

        <div class="rating-scorecard-grid">
            <!-- Sol: Büyük Skor -->
            <div class="overall-score-box">
                <div class="big-score-number">
                    @Model.OverallScore.ToString("0.0")
                    <span class="big-score-denominator">/ 10</span>
                </div>
                <div class="ten-stars-wrap">
                    @for (int i = 1; i <= 10; i++)
                    {
                        var isFilled = i <= Math.Round(Model.OverallScore);
                        <span class="ten-star-item @(isFilled ? "" : "empty")">★</span>
                    }
                </div>
                <div style="font-weight: 800; font-size: 1.05rem; color: var(--seller-text); margin-bottom: 4px;">
                    @(Model.OverallScore >= 9.0 ? "Mükemmel Satıcı" : (Model.OverallScore >= 7.5 ? "Çok İyi / Güvenilir" : "İyi"))
                </div>
                <div class="score-total-reviews">
                    %100 Doğrulanmış Satın Alım İncelemeleri
                </div>
            </div>

            <!-- Orta: 10-1 Yıldız Dağılım Çubukları -->
            <div class="star-bars-container">
                @for (int star = 10; star >= 1; star--)
                {
                    var count = Model.StarCounts.ContainsKey(star) ? Model.StarCounts[star] : 0;
                    var pct = Model.StarPercentages.ContainsKey(star) ? Model.StarPercentages[star] : 0.0;
                    <div class="star-bar-row">
                        <span class="star-bar-label">@star Yıldız</span>
                        <div class="star-bar-track">
                            <div class="star-bar-fill" style="width: @pct%;"></div>
                        </div>
                        <span class="star-bar-pct">@pct%</span>
                    </div>
                }
            </div>

            <!-- Sağ: 3 Alt Metrik (10 Üzerinden) -->
            <div class="sub-metrics-column">
                <div class="metric-card">
                    <div class="metric-info">
                        <span class="metric-icon">🚚</span>
                        <span class="metric-title">Teslimat Hızı</span>
                    </div>
                    <span class="metric-score">@Model.DeliveryScoreAvg.ToString("0.0") <small style="font-size: 0.75rem; color: var(--seller-muted);">/10</small></span>
                </div>

                <div class="metric-card">
                    <div class="metric-info">
                        <span class="metric-icon">📦</span>
                        <span class="metric-title">Ürün Kalitesi & Tolerans</span>
                    </div>
                    <span class="metric-score">@Model.QualityScoreAvg.ToString("0.0") <small style="font-size: 0.75rem; color: var(--seller-muted);">/10</small></span>
                </div>

                <div class="metric-card">
                    <div class="metric-info">
                        <span class="metric-icon">💬</span>
                        <span class="metric-title">İletişim & Çözüm</span>
                    </div>
                    <span class="metric-score">@Model.CommunicationScoreAvg.ToString("0.0") <small style="font-size: 0.75rem; color: var(--seller-muted);">/10</small></span>
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== DOĞRULANMIŞ YORUMLAR AKIŞI ==================== -->
    <div style="margin-bottom: 40px;">
        <div class="seller-section-head">
            <h2>Doğrulanmış Alıcı Değerlendirmeleri (@Model.Reviews.Count)</h2>
            <div class="reviews-filter-pills">
                <button type="button" class="btn-filter-pill active" onclick="filterReviewsByStar('all', this)">Tümü</button>
                <button type="button" class="btn-filter-pill" onclick="filterReviewsByStar(10, this)">10 Yıldız</button>
                <button type="button" class="btn-filter-pill" onclick="filterReviewsByStar(9, this)">9 Yıldız</button>
                <button type="button" class="btn-filter-pill" onclick="filterReviewsByStar(8, this)">8 Yıldız</button>
            </div>
        </div>

        @if (!Model.Reviews.Any())
        {
            <div style="background: var(--seller-card-bg); border: 1px solid var(--seller-border); border-radius: 12px; padding: 48px; text-align: center; color: var(--seller-muted);">
                <div style="font-size: 2.5rem; margin-bottom: 12px;">★</div>
                <h3 style="color: var(--seller-text); margin-bottom: 6px;">Henüz yazılı bir değerlendirme bulunmuyor</h3>
                <p style="font-size: 0.88rem;">Bu satıcıdan verilen siparişler teslim alındıktan sonra kurumsal alıcıların değerlendirmeleri burada listelenecektir.</p>
            </div>
        }
        else
        {
            <div id="sellerReviewsFeed">
                @foreach (var r in Model.Reviews)
                {
                    int starInt = (int)Math.Clamp(Math.Round(r.ReviewScore), 1, 10);
                    <div class="review-card-item" data-star="@starInt">
                        <div class="review-item-header">
                            <div class="reviewer-identity">
                                <div class="reviewer-avatar">@r.ReviewerInitials</div>
                                <div>
                                    <div style="display: flex; align-items: center;">
                                        <span class="reviewer-name">@r.ReviewerName</span>
                                        @if (r.IsVerifiedPurchase)
                                        {
                                            <span class="verified-purchase-badge" title="Bu alıcı ürünü sistem üzerinden satın alıp teslim almıştır.">
                                                ✓ Doğrulanmış Satın Alım
                                            </span>
                                        }
                                    </div>
                                    <div style="font-size: 0.75rem; color: var(--seller-muted); margin-top: 2px;">
                                        📅 @r.ReviewDate.ToString("dd MMMM yyyy")
                                    </div>
                                </div>
                            </div>

                            <div class="review-score-badge">
                                <span>★</span>
                                <span>@r.ReviewScore.ToString("0.0") / 10</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(r.ReviewText))
                        {
                            <div class="review-text-body">
                                "@r.ReviewText"
                            </div>
                        }

                        <div class="review-item-footer">
                            <div>
                                @if (!string.IsNullOrWhiteSpace(r.ProductName))
                                {
                                    <span>📦 <strong>Satın Alınan Ürün:</strong> @r.ProductName</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(r.OrderNumber))
                                {
                                    <span>🛒 <strong>Sipariş No:</strong> @r.OrderNumber</span>
                                }
                            </div>
                            <div style="display: flex; gap: 12px;">
                                @if (r.DeliveryScore.HasValue)
                                {
                                    <span>Hız: <strong>@(r.DeliveryScore.Value.ToString("0.0")) / 10</strong></span>
                                }
                                @if (r.QualityScore.HasValue)
                                {
                                    <span>Kalite: <strong>@(r.QualityScore.Value.ToString("0.0")) / 10</strong></span>
                                }
                                @if (r.CommunicationScore.HasValue)
                                {
                                    <span>İletişim: <strong>@(r.CommunicationScore.Value.ToString("0.0")) / 10</strong></span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- ==================== SATICININ ÜRÜNLERİ ==================== -->
    @if (Model.Products.Any())
    {
        <div>
            <div class="seller-section-head">
                <h2>Satıcının Vitrindeki Ürünleri (@Model.Products.Count)</h2>
                <a href="/#b2b-vitrin" style="font-size: 0.88rem; font-weight: 700; color: var(--seller-accent); text-decoration: none;">Tüm Vitrini Gör →</a>
            </div>

            <div class="seller-products-grid">
                @foreach (var p in Model.Products)
                {
                    <div class="seller-product-card">
                        <div class="product-img-box">
                            <img src="@p.ImageUrl" alt="@p.ItemName" />
                        </div>
                        <div class="product-body">
                            <div style="font-size: 0.72rem; color: var(--seller-muted); font-weight: 600; text-transform: uppercase;">@p.CategoryName</div>
                            <h3 class="product-title">@p.ItemName</h3>
                            <div style="font-size: 0.75rem; color: var(--seller-muted); margin-bottom: 12px;">Stok Kodu: @p.Sku</div>
                            <div style="display: flex; justify-content: space-between; align-items: flex-end;">
                                <div class="product-price">@p.UnitPrice.ToString("N0") ₺</div>
                                <a href="/#b2b-vitrin" class="btn-primary" style="padding: 6px 12px; font-size: 0.78rem; text-decoration: none; border-radius: 6px;">İncele</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- ==================== 10 YILDIZ DEĞERLENDİRME MODALI (AJAX) ==================== -->
<div id="sellerDetailReviewModal" class="ty-modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.65); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;" onclick="if(event.target===this)closeReviewModal()">
    <div class="ty-modal-box" style="background: var(--seller-card-bg, #ffffff); border: 1px solid var(--seller-border, #e2e8f0); border-radius: 16px; width: 100%; max-width: 540px; padding: 28px; box-shadow: 0 25px 35px -5px rgba(0,0,0,0.25);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
            <div>
                <span class="seller-badge-pill badge-verified" style="font-size: 0.72rem; padding: 2px 8px;">DOĞRULANMIŞ SATIN ALIM</span>
                <h3 id="reviewModalTitle" style="font-size: 1.25rem; font-weight: 800; color: var(--seller-text, #0f172a); margin-top: 6px; margin-bottom: 4px;">Satıcıyı Değerlendir</h3>
            </div>
            <button type="button" onclick="closeReviewModal()" style="border: none; background: transparent; font-size: 1.3rem; cursor: pointer; color: var(--seller-muted);">&times;</button>
        </div>

        <form id="directReviewForm" onsubmit="handleDirectReviewSubmit(event)">
            <input type="hidden" id="directReviewOrderID" />
            <input type="hidden" id="directReviewScore" value="10" />

            <!-- 10 Yıldız Seçim Alanı -->
            <div style="text-align: center; margin-bottom: 16px;">
                <label style="display: block; font-size: 0.85rem; font-weight: 700; color: var(--seller-text);">10 Yıldız Üzerinden Genel Deneyiminiz</label>
                <div class="star-rating-selector" id="starPickerContainer">
                    @for (int i = 1; i <= 10; i++)
                    {
                        <button type="button" class="star-btn-pick active" data-val="@i" onclick="setStarRating(@i)" onmouseenter="previewStarRating(@i)" onmouseleave="resetPreviewStarRating()">★</button>
                    }
                </div>
                <div class="star-score-readout" id="starScoreLabel">★ 10.0 / 10 - Mükemmel</div>
            </div>

            <!-- 3 Alt Metrik (10 Üzerinden) -->
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-bottom: 16px;">
                <div>
                    <label style="font-size: 0.75rem; font-weight: 700; display: block; margin-bottom: 4px;">🚚 Teslimat (1-10)</label>
                    <input type="number" id="reviewDeliveryScore" class="form-control" value="10" min="1" max="10" step="0.5" style="font-size: 0.85rem; padding: 6px 10px;" />
                </div>
                <div>
                    <label style="font-size: 0.75rem; font-weight: 700; display: block; margin-bottom: 4px;">📦 Kalite (1-10)</label>
                    <input type="number" id="reviewQualityScore" class="form-control" value="10" min="1" max="10" step="0.5" style="font-size: 0.85rem; padding: 6px 10px;" />
                </div>
                <div>
                    <label style="font-size: 0.75rem; font-weight: 700; display: block; margin-bottom: 4px;">💬 İletişim (1-10)</label>
                    <input type="number" id="reviewCommScore" class="form-control" value="10" min="1" max="10" step="0.5" style="font-size: 0.85rem; padding: 6px 10px;" />
                </div>
            </div>

            <!-- Yorum Metni -->
            <div style="margin-bottom: 20px;">
                <label style="font-size: 0.82rem; font-weight: 700; display: block; margin-bottom: 6px;">Deneyiminiz &amp; Yorumunuz</label>
                <textarea id="reviewTextComment" class="form-control" rows="3" placeholder="Teslimat hızı, ürün şartname uygunluğu ve satıcının yaklaşımı nasıldı?" style="font-size: 0.85rem;"></textarea>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button type="button" class="btn-cancel" onclick="closeReviewModal()">Vazgeç</button>
                <button type="submit" class="btn-primary" style="padding: 10px 20px; font-weight: 700;">Değerlendirmeyi Yayınla</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let selectedStars = 10;

        function setStarRating(val) {
            selectedStars = val;
            document.getElementById('directReviewScore').value = val;
            updateStarUI(val);
        }

        function previewStarRating(val) {
            updateStarUI(val);
        }

        function resetPreviewStarRating() {
            updateStarUI(selectedStars);
        }

        function updateStarUI(val) {
            const buttons = document.querySelectorAll('#starPickerContainer .star-btn-pick');
            buttons.forEach(btn => {
                const bVal = parseInt(btn.getAttribute('data-val'));
                if (bVal <= val) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });

            const labels = {
                1: "★ 1.0 / 10 - Çok Zayıf",
                2: "★ 2.0 / 10 - Yetersiz",
                3: "★ 3.0 / 10 - Zayıf",
                4: "★ 4.0 / 10 - Geliştirilmeli",
                5: "★ 5.0 / 10 - Orta Seviye",
                6: "★ 6.0 / 10 - Ortalama",
                7: "★ 7.0 / 10 - Başarılı",
                8: "★ 8.0 / 10 - İyi",
                9: "★ 9.0 / 10 - Çok İyi",
                10: "★ 10.0 / 10 - Mükemmel"
            };
            const lbl = document.getElementById('starScoreLabel');
            if (lbl) lbl.textContent = labels[val] || `★ ${val} / 10`;
        }

        function openDirectReviewModal(orderId, sellerName) {
            const modal = document.getElementById('sellerDetailReviewModal');
            if (!modal) return;
            document.getElementById('directReviewOrderID').value = orderId;
            document.getElementById('reviewModalTitle').textContent = (sellerName && sellerName.trim() !== '' ? sellerName.trim() + " - " : "") + "Satıcıyı Değerlendir";
            setStarRating(10);
            modal.style.setProperty('display', 'flex', 'important');
            modal.style.setProperty('opacity', '1', 'important');
            modal.style.setProperty('pointer-events', 'auto', 'important');
            modal.classList.add('show');
        }

        function closeReviewModal() {
            const modal = document.getElementById('sellerDetailReviewModal');
            if (modal) {
                modal.style.setProperty('display', 'none', 'important');
                modal.style.setProperty('opacity', '0', 'important');
                modal.style.setProperty('pointer-events', 'none', 'important');
                modal.classList.remove('show');
            }
        }

        async function handleDirectReviewSubmit(e) {
            e.preventDefault();
            const orderId = parseInt(document.getElementById('directReviewOrderID').value);
            const score = parseFloat(document.getElementById('directReviewScore').value);
            const delivery = parseFloat(document.getElementById('reviewDeliveryScore').value);
            const quality = parseFloat(document.getElementById('reviewQualityScore').value);
            const comm = parseFloat(document.getElementById('reviewCommScore').value);
            const comment = document.getElementById('reviewTextComment').value;

            try {
                const response = await fetch('/Review/SubmitBuyerReview', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        orderID: orderId,
                        targetSupplierCompanyID: @Model.CompanyID,
                        targetSupplierCompanyName: '@Html.Raw(Model.CompanyName.Replace("'", "\\'"))',
                        reviewScore: score,
                        deliveryScore: delivery,
                        qualityScore: quality,
                        communicationScore: comm,
                        reviewText: comment
                    })
                });

                const result = await response.json();
                if (result.success) {
                    alert(result.message);
                    location.reload();
                } else {
                    alert(result.message);
                }
            } catch (err) {
                alert('Değerlendirme kaydedilirken hata oluştu: ' + err);
            }
        }

        function filterReviewsByStar(starVal, btn) {
            document.querySelectorAll('.reviews-filter-pills .btn-filter-pill').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const items = document.querySelectorAll('#sellerReviewsFeed .review-card-item');
            items.forEach(item => {
                if (starVal === 'all') {
                    item.style.display = 'block';
                } else {
                    const itemStar = parseInt(item.getAttribute('data-star'));
                    if (itemStar === parseInt(starVal)) {
                        item.style.display = 'block';
                    } else {
                        item.style.display = 'none';
                    }
                }
            });
        }
    </script>
}
