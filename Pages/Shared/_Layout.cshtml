<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tedarik Portalı</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/satinalma.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/favicon.png" />
</head>
<body>
    <div class="portal-blue-app">
        <!-- Top Navigation Header -->
        <header class="blue-top-header">
            <div class="header-container">
                <!-- Brand Logo -->
                <a class="brand-logo" href="~/">
                    <span class="logo-badge">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                            <polyline points="2 17 12 22 22 17"></polyline>
                            <polyline points="2 12 12 17 22 12"></polyline>
                        </svg>
                    </span>
                    <span class="logo-title">tedarik<span class="logo-blue-dot">.portal</span></span>
                </a>

                <!-- Navigation Links -->
                <nav class="center-nav">
                    <a href="#kurumsal" class="nav-link">Kurumsal</a>
                    <a href="#kategoriler" class="nav-link">Ürün Kategorileri</a>
                    <a href="#neden-portal" class="nav-link">Neden Portal?</a>
                    <a href="#fiyatlandirma" class="nav-link">Fiyatlandırma</a>
                    <a href="#medya" class="nav-link">Medya & Duyurular</a>
                    <a href="#iletisim" class="nav-link">İletişim</a>
                </nav>

                <!-- Header Right Actions -->
                <div class="right-actions">
                    <a href="#portal" class="btn-royal-pill">
                        Tedarik Portalı
                    </a>

                    <div class="lang-pill">
                        <span class="flag">🇹🇷</span>
                        <span class="code">TR</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M6 9l6 6 6-6"/>
                        </svg>
                    </div>

                    <button class="profile-avatar-btn" title="Hesabım">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </button>
                </div>
            </div>
        </header>

        <!-- Main Content Shell -->
        <main class="blue-portal-body">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="blue-footer">
            <div class="footer-container">
                <div class="footer-left">
                    <div class="brand-logo mb-2">
                        <span class="logo-badge">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                            </svg>
                        </span>
                        <span class="logo-title text-white">tedarik<span class="logo-blue-dot">.portal</span></span>
                    </div>
                    <p class="footer-text">
                        Türkiye’nin 81 ilindeki kurumsal alıcılar ve doğrulanmış tedarikçileri tek çatı altında toplayan B2B satın alma portalı.
                    </p>
                </div>
                <div class="footer-right">
                    <a href="#">Kullanım Koşulları</a>
                    <a href="#">Gizlilik Sözleşmesi</a>
                    <a href="#">KVKK Aydınlatma</a>
                    <a href="#">Bize Ulaşın</a>
                </div>
            </div>
        </footer>
    </div>
</body>
</html>
